// The virtual chip: a machine that exists only in benchtop. Two M0+ cores share 1 MB of RAM from
// address 0, a debug console on the host's terminal, and a small SIO after the RP2040's for talking
// to each other. It has no pins; the board `virt` is this chip and nothing beside it.

chip {
  name    = "virt"
  summary = "two Cortex-M0+ cores, 1 MB of RAM, a console and an SIO"
  cores   = [cortex-m0plus, cortex-m0plus]

  peripherals {
    ram     { peripheral = ram, at = 0x00000000, size = 1M }
    console { peripheral = debug-console, at = 0x40000000, irq = 0 }
    sio     { peripheral = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
