// `virt`'s RAM, console and SIO with two Cortex-M33s, ARMv8-M Mainline: the integer Thumb-2
// instruction set, IT blocks, exclusives, the stack limits, BASEPRI and FAULTMASK; no FPU, DSP,
// Security Extension or MPU.

chip {
  name    = "virt33"
  summary = "two Cortex-M33 cores, 1 MB of RAM, a console and an SIO"
  cores   = [cortex-m33, cortex-m33]

  peripherals {
    ram     { peripheral = ram, at = 0x00000000, size = 1M }
    console { peripheral = debug-console, at = 0x40000000, irq = 0 }
    sio     { peripheral = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
