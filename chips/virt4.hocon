// `virt`'s RAM, console and SIO with two Cortex-M4s: the integer Thumb-2 instruction set with the DSP
// extension; no floating point or MPU.

chip {
  name    = "virt4"
  summary = "two Cortex-M4 cores, 1 MB of RAM, a console and an SIO"
  cores   = [cortex-m4, cortex-m4]

  peripherals {
    ram     { peripheral = ram, at = 0x00000000, size = 1M }
    console { peripheral = debug-console, at = 0x40000000, irq = 0 }
    sio     { peripheral = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
