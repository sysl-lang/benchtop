import sysl.raw.ptr_cast

import firmware.*

// A chain of three WS2812s on GP0 of a virtual board (testdata/ws2812-machine.hocon), bit-banged from the
// panel GPIO at the board's 12 MHz: each bit a high and a low, a 0's high a single store long and a 1's
// eight reads longer, well past the 0.6 µs the LED samples at. The chain is sent red, green and blue at a
// quarter of full, then the line is left low, which latches it.

@export("vectors")
@section(".rodata.vectors")
val vectors = vector_table[32](&__stack_top, &start)

struct Gpio
    out: volatile u32
    input: volatile u32
    oe: volatile u32

// The 24 bits of `grb`, green first, most significant first.
send(gpio: *Gpio, grb: u32)
    for i in 0..<24
        gpio.out = 1
        if (grb >> u32(23 - i)) & 1 != 0
            for _ in 0..<8 do val ignored = gpio.input
        gpio.out = 0

@export("start")
start() -> never
    initialize_memory()
    val gpio: *Gpio = ptr_cast(usize(0x50000000))
    gpio.out = 0
    gpio.oe = 1
    val frame: [3]u32 = [0x004000, 0x400000, 0x000040]
    for word in frame do send(gpio, word)
    loop
        val ignored = gpio.input
