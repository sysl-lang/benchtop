import sh.sysl.rp2040rom as rom

// The routines of benchtop's own RP2040 boot ROM, exported under `ours_` names for the cross-check
// firmware: the soft float and double tables in the ROM's layout, and the bit and memory functions.

// The comparison that answers in the flags is not cross-checked; the entry answers 0.
private no_flags32(a: u32, b: u32) -> i32 = 0
private no_flags64(a: u64, b: u64) -> i32 = 0

@export("ours_sf_table")
val OURS_SF = rom.soft_float(&no_flags32)

@export("ours_sd_table")
val OURS_SD = rom.soft_double(&no_flags64)

@export("ours_popcount32")
popcount32(x: u32) -> u32 = rom.popcount32(x)
@export("ours_reverse32")
reverse32(x: u32) -> u32 = rom.reverse32(x)
@export("ours_clz32")
clz32(x: u32) -> u32 = rom.clz32(x)
@export("ours_ctz32")
ctz32(x: u32) -> u32 = rom.ctz32(x)
@export("ours_memset")
memset(p: *u8, c: u8, n: usize) -> *u8 = rom.memset(p, c, n)
@export("ours_memset4")
memset4(p: *u8, c: u8, n: usize) -> *u8 = rom.memset4(p, c, n)
@export("ours_memcpy")
memcpy(d: *u8, s: *u8, n: usize) -> *u8 = rom.memcpy(d, s, n)
@export("ours_memcpy44")
memcpy44(d: *u8, s: *u8, n: usize) -> *u8 = rom.memcpy44(d, s, n)
