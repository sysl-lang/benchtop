// benchtop's own RP2040 boot ROM's routines, compiled for the Cortex-M0+ into the cross-check firmware
// (`../rom_crosscheck.c`), which calls them beside the chip's own ROM. `../../CMakeLists.txt` builds it
// with `sysl build-c`.

package {
  name    = "rom-crosscheck-ours"
  version = "0.0.0"
  sysl    = "0.8.7"
}

dependencies {
  rp2040rom { path = "../../../../sh/sysl/benchtop/chip/rom/rp2040" }
}
