// ISA profiles are core names, just like cortex-m33. This chip is for description checking;
// the RISC-V bench currently runs raw images directly, without a board or device model.
chip {
  name = riscv-example
  cores = [rv32i, { core = rv32imc }]
  peripherals {
    ram { peripheral = ram, at = 0x20000000, size = 520K }
  }
}
