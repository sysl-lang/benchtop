;
; benchtop's own: two programs on the RP2350's PIO version 1 additions alone, for
; sh/sysl/benchtop/chip/pio_tests.sysl.
;
.pio_version 1

; On PIO0: each word from the system goes, inverted, into RX FIFO entry Y and, bit-reversed, into
; entry 3, for the processor to read through RXF0_PUTGET0..3; then, once the pin after the JMP pin is
; high, every OUT pin becomes an output and PIO1 is told through IRQ flag 2.
.program table
.fifo txput
.wrap_target
    pull block
    mov isr, ~osr
    mov rxfifo[y], isr
    mov isr, ::osr
    mov rxfifo[3], isr
    wait 1 jmppin + 1
    mov pindirs, ~null
    irq set 2
.wrap

; On PIO1: waits for PIO0's flag 2 (its previous block's), which it clears, raises its pin, and raises
; flag 3 of PIO2 (its next block's).
.program follower
    wait 1 irq prev 2
    set pins, 1
    irq next set 3
