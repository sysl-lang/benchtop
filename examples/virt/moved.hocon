// The virtual board with its console moved to 0x50000000 and IRQ 7: run irq-moved.elf on it, as
// `benchtop run --board examples/virt/moved.hocon examples/virt/irq-moved.elf`. Its devices are
// wherever the chip puts them, and a program built for one place finds nothing at the other.

board {
  name = "virt, console moved"

  chip {
    name  = "virt, console moved"
    cores = [cortex-m0plus, cortex-m0plus]

    peripherals {
      ram     { peripheral = ram, at = 0x00000000, size = 1M }
      console { peripheral = debug-console, at = 0x50000000, irq = 7 }
      sio     { peripheral = virt-sio, at = 0xD0000000, irq = 1 }
    }
  }
}
