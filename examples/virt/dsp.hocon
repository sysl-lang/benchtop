// cortical run --board examples/virt/dsp.hocon examples/virt/dsp.elf
board {
  name = "M4 integer DSP"
  cores = [
    { core = cortex-m4, dsp = true }
    { core = cortex-m4, dsp = true }
  ]
  parts {
    ram { part = ram, at = 0, size = 1M }
    console { part = debug-console, at = 0x40000000, irq = 0 }
    sio { part = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
