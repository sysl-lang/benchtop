// Defaults are the integer subset. Only the priority widths differ between these two M7s.
// cortical run --board examples/virt/core-options.hocon examples/virt/dual-m7.elf
board {
  name = "M7 cores with different NVIC priority widths"
  cores = [
    { core = cortex-m7, nvic_priority_bits = 3 }
    { core = cortex-m7, nvic_priority_bits = 8 }
  ]
  parts {
    ram { part = ram, at = 0, size = 1M }
    console { part = debug-console, at = 0x40000000, irq = 0 }
    sio { part = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
