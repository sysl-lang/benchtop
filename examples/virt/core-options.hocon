// Defaults are the integer subset. Only the priority widths differ between these two M7s.
// benchtop run --board examples/virt/core-options.hocon examples/virt/dual-m7.elf
board {
  name = "M7 cores with different NVIC priority widths"
  chip {
    name = "two M7s"
    cores = [
      { core = cortex-m7, nvic_priority_bits = 3 }
      { core = cortex-m7, nvic_priority_bits = 8 }
    ]
    peripherals {
      ram { peripheral = ram, at = 0, size = 1M }
      console { peripheral = debug-console, at = 0x40000000, irq = 0 }
      sio { peripheral = virt-sio, at = 0xD0000000, irq = 1 }
    }
  }
}
