module firmware

// What every bare-metal example shares: the linker-provided symbols, the start-up copy of `.data` and
// clear of `.bss`, and the Cortex-M vector table. An example compiles against this directory with
// `--lib ../shared`.

import sysl.raw.ptr_cast

extern __stack_top: u8
extern __data_start: u8
extern __data_end: u8
extern __data_load: u8
extern __bss_start: u8
extern __bss_end: u8

struct StartupByte
    value: volatile u8

/** Copy the initialised data to RAM and clear the zero-initialised data. Reset handlers call it
 * before they touch any global.
 */
initialize_memory()
    val source: *StartupByte = ptr_cast(usize(&__data_load))
    val data: *StartupByte = ptr_cast(usize(&__data_start))
    val zero: *StartupByte = ptr_cast(usize(&__bss_start))
    for i in 0..<(usize(&__data_end) - usize(&__data_start)) do data[i].value = source[i].value
    for i in 0..<(usize(&__bss_end) - usize(&__bss_start)) do zero[i].value = 0

/** An interrupt handler's entry in a vector table. */
type Handler = *extern() -> unit

/** A Cortex-M vector table: the initial stack pointer, the reset handler, the 14 other core
 * exceptions, and `N` external interrupt slots. A slot with no handler holds zero.
 */
struct VectorTable[const N: usize]
    stack: *u8
    reset: *extern() -> never
    core: [14]Handler
    irq: [N]Handler

@assert(offsetof(VectorTable[1], reset) == 4, "the reset vector is the second word")
@assert(offsetof(VectorTable[1], irq) == 64, "interrupt 0 is the 17th word")

/** The table whose initial stack is `stack`, whose reset handler is `reset`, and whose interrupt
 * number `irq` is `handler` for each `(irq, handler)` pair in `handlers`. Interrupt numbers are
 * the vendor's (the table's slot minus 16), so `(57, &dma_interrupt)` fills slot 73.
 */
vector_table[const N: usize](stack: *u8, reset: *extern() -> never, handlers: []const (usize, Handler) = []) -> VectorTable[N]
    var table = VectorTable[N](stack, reset, [null; 14], [null; N])
    for handler in handlers do table.irq[handler.0] = handler.1
    table
