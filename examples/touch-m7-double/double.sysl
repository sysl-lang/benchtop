// The busy firmware's double-precision kernel, for the Cortex-M7 alone. The M7's FPv5 holds doubles;
// the M4 beside it has single precision only, so the rest of the firmware (which both cores run) is
// built for that, and this file is built on its own for `thumbv7em-freestanding-dp` and linked in.
// It keeps its state here and hands back only an integer, so no double crosses into M4-built code.

import sysl.math.Float

var spin_x = 0.6
var spin_y = 0.8
var settle: f32 = 0.25

/** One round: 256 steps of a slowly decaying rotation renormalised back onto the unit circle (double
 * multiply-adds, a square root and two divides), with a single-precision average trailing it. Answers
 * the average in thousandths, which stays between 0 and 1000.
 */
@export("busy_double_round")
busy_double_round() -> u32
    var x = spin_x
    var y = spin_y
    var z = settle
    for _ in 0..<256
        val nx = x * 0.9921875 - y * 0.125
        val ny = y * 0.9921875 + x * 0.125
        val r = (nx * nx + ny * ny).sqrt()
        x = nx / r
        y = ny / r
        z = z * 0.96875 + f32(x * x) * 0.03125
    spin_x = x
    spin_y = y
    settle = z
    u32(z * 1000.0)
