import sysl.raw.ptr_cast

import firmware.*

struct Word
    value: volatile u32
struct Half
    value: volatile u16

const DMA2_STREAM1_IRQ: usize = 57

// The vector table is ordinary firmware data. Only DMA2 stream 1 is enabled.
@export("vectors")
@section(".rodata.vectors")
val vectors = vector_table[240](&__stack_top, &start, [(DMA2_STREAM1_IRQ, &dma_interrupt)])

@export("dma_probe_status")
var status: Word
@export("dma_probe_irq_count")
var irq_count: Word
@export("dma_probe_active")
var active: Word
@export("dma_probe_samples")
var samples: [16]u16
var complete: Word

reg(address: u32) -> *Word = ptr_cast(usize(address))

@export("DMA2_Stream1_IRQHandler")
dma_interrupt()
    val flags = reg(0x40020400).value
    active.value = reg(0xe000e304).value // NVIC IABR1, IRQ57 is bit25.
    irq_count.value += 1
    reg(0x40020408).value = flags & (0x3d << 6)
    if flags & (1 << 9) != 0 then status.value = 2
    if flags & (1 << 11) != 0 then complete.value = 1

@export("start")
start() -> never
    // All writable state is explicitly initialized before use; no allocator.
    status.value = 0
    irq_count.value = 0
    active.value = 0
    complete.value = 0
    for i in 0..<16 do samples[i] = u16(0x8000 + i * 128)
    // SAI1 A, 16-bit data in two 32-bit slots at 48kHz. The board supplies
    // a 12.288MHz kernel clock until RCC audio PLL emulation is implemented.
    reg(0x4001580c).value = 63 | (31 << 8) | (1 << 16)
    reg(0x40015810).value = (3 << 16) | (1 << 8) | (2 << 6)
    reg(0x40015808).value = 4 // FIFO threshold full.
    reg(0x40015804).value = (4 << 5) | (1 << 20)
    reg(0x40020824).value = 87 // DMAMUX1 channel9 -> SAI1 A.
    reg(0x4002042c).value = 16
    reg(0x40020430).value = 0x40015820
    reg(0x40020434).value = u32(usize(&samples[0]))
    reg(0xe000e104).value = 1 << 25 // Enable actual DMA2 stream1 IRQ57.
    reg(0x40020428).value = 1 | 4 | 16 | (1 << 6) | (1 << 10) | (1 << 11) | (1 << 13)
    reg(0x40015804).value = (4 << 5) | (1 << 20) | (1 << 16) | (1 << 17)
    while complete.value == 0 && status.value == 0
        asm
            [thumb] "wfi"
            [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"
    while reg(0x40015818).value & (7 << 16) != 0 do ()
    val errors = reg(0x40015818).value & 1
    reg(0x40015804).value = (4 << 5) | (1 << 20)
    if status.value == 0 then status.value = if errors == 0 then 1 else 3
    loop
        asm
            [thumb] "wfi"
            [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"
