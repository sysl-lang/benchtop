import sysl.raw.ptr_cast

extern __stack_top: u8

// Linker-provided load and runtime addresses; startup runs before using any globals.
extern __data_start: u8
extern __data_end: u8
extern __data_load: u8
extern __bss_start: u8
extern __bss_end: u8

struct StartupByte
    value: volatile u8

initialize_memory()
    val source: *StartupByte = ptr_cast(usize(&__data_load))
    val data: *StartupByte = ptr_cast(usize(&__data_start))
    val zero: *StartupByte = ptr_cast(usize(&__bss_start))
    for i in 0..<(usize(&__data_end) - usize(&__data_start)) do data[i].value = source[i].value
    for i in 0..<(usize(&__bss_end) - usize(&__bss_start)) do zero[i].value = 0


struct Vectors
    stack: *u8
    reset: *extern() -> never
    reserved: [46]u32

@export("vectors")
@section(".rodata.vectors")
val vectors: Vectors = Vectors(&__stack_top, &start, [0; 46])

struct Gpio
    out: volatile u32
    input: volatile u32
    oe: volatile u32

struct Audio
    ctrl: volatile u32
    status: volatile u32
    tx: volatile u32
    rx: volatile u32
    rate: volatile u32
    tx_space: volatile u32
    rx_count: volatile u32
    peak: volatile u32

// One 480Hz cycle at 48kHz; samples are signed 24-bit PCM stored in flash.
val sine: [100]int = [0, 131681, 262843, 392967, 521540, 648055, 772013, 892923, 1010310, 1123710, 1232674, 1336774, 1435599, 1528757, 1615883, 1696631, 1770683, 1837747, 1897559, 1949882, 1994509, 2031265, 2060005, 2080614, 2093013, 2097151, 2093013, 2080614, 2060005, 2031265, 1994509, 1949882, 1897559, 1837747, 1770683, 1696631, 1615883, 1528757, 1435599, 1336774, 1232674, 1123710, 1010310, 892923, 772013, 648055, 521540, 392967, 262843, 131681, 0, -131681, -262843, -392967, -521540, -648055, -772013, -892923, -1010310, -1123710, -1232674, -1336774, -1435599, -1528757, -1615883, -1696631, -1770683, -1837747, -1897559, -1949882, -1994509, -2031265, -2060005, -2080614, -2093013, -2097151, -2093013, -2080614, -2060005, -2031265, -1994509, -1949882, -1897559, -1837747, -1770683, -1696631, -1615883, -1528757, -1435599, -1336774, -1232674, -1123710, -1010310, -892923, -772013, -648055, -521540, -392967, -262843, -131681]

@export("start")
start() -> never
    initialize_memory()
    val gpio: *Gpio = ptr_cast(usize(0x50000000))
    val audio: *Audio = ptr_cast(usize(0x50000400))
    gpio.oe = 61 // GP0, GP2..5 are the firmware microphone meter.
    audio.ctrl = 3 // TX and RX enabled; fixed 48kHz, 24-bit samples in 32-bit words.
    var phase = 0
    var peak: u32 = 0
    var count: u32 = 0
    loop
        if (audio.status & 1) != 0
            val sample = if (gpio.input & 2) == 0 then sine[phase] else 0
            audio.tx = u32(sample) << 8
            phase += 1
            if phase == 100 then phase = 0 // Avoid software division in the audio hot path.
        if (audio.status & 2) != 0
            val sample = int(audio.rx) >> 8
            val magnitude = u32(if sample < 0 then -sample else sample)
            if magnitude > peak then peak = magnitude
            count += 1
            if count == 480
                var level: u32 = 0
                val pins: [5]u32 = [0,2,3,4,5]
                for i in 0..<5
                    if peak > (16384u32 << i * 2) then level |= 1u32 << pins[i]
                gpio.out = level
                peak = peak >> 1
                count = 0
