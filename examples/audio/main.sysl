import sysl.raw.ptr_cast

extern __stack_top: u8

// Linker-provided load and runtime addresses; startup runs before using any globals.
extern __data_start: u8
extern __data_end: u8
extern __data_load: u8
extern __bss_start: u8
extern __bss_end: u8

struct StartupByte
    value: volatile u8

initialize_memory()
    val source: *StartupByte = ptr_cast(usize(&__data_load))
    val data: *StartupByte = ptr_cast(usize(&__data_start))
    val zero: *StartupByte = ptr_cast(usize(&__bss_start))
    for i in 0..<(usize(&__data_end) - usize(&__data_start)) do data[i].value = source[i].value
    for i in 0..<(usize(&__bss_end) - usize(&__bss_start)) do zero[i].value = 0


struct Vectors
    stack: *u8
    reset: *extern() -> never
    reserved: [46]u32

@export("vectors")
@section(".rodata.vectors")
val vectors: Vectors = Vectors(&__stack_top, &start, [0; 46])

struct Gpio
    out: volatile u32
    input: volatile u32
    oe: volatile u32

struct Audio
    ctrl: volatile u32
    status: volatile u32
    tx: volatile u32
    rx: volatile u32
    rate: volatile u32
    tx_space: volatile u32
    rx_count: volatile u32
    peak: volatile u32

@export("start")
start() -> never
    initialize_memory()
    val gpio: *Gpio = ptr_cast(usize(0x50000000))
    val audio: *Audio = ptr_cast(usize(0x50000400))
    gpio.oe = 61 // GP0, GP2..5 are the firmware microphone meter.
    audio.ctrl = 3 // TX and RX enabled; fixed 48kHz, 24-bit samples in 32-bit words.
    var phase: int = 0
    var peak: u32 = 0
    var count: u32 = 0
    loop
        if (audio.status & 1) != 0
            val triangle = if phase < 50 then phase - 25 else 75 - phase
            val sample = if (gpio.input & 2) == 0 then triangle * 83886 else 0
            audio.tx = u32(sample) << 8
            phase = (phase + 1) % 100 // 480Hz triangular PCM waveform.
        if (audio.status & 2) != 0
            val sample = int(audio.rx) >> 8
            val magnitude = u32(if sample < 0 then -sample else sample)
            if magnitude > peak then peak = magnitude
            count += 1
            if count == 480
                var level: u32 = 0
                val pins: [5]u32 = [0,2,3,4,5]
                for i in 0..<5
                    if peak > (16384u32 << u32(i * 2)) then level |= 1u32 << pins[i]
                gpio.out = level
                peak = peak >> 1
                count = 0
