#if feature_storage
import sh.sysl.sd as sd
import sh.sysl.fat as fat

var storage_previous: u32 = 0
var storage_cycles: u64 = 0
var storage_sector: [512]u8
// Mounted once at startup. Both sit at fixed addresses: a `FileAt` holds the volume's address, and a
// WAV reader or writer holds the `FileAt`'s. Playback and recording take turns with the one file.
var storage_volume: fat.Volume[StorageCard]
var storage_file: fat.FileAt[StorageCard]
storage_config() -> sd.Settings = sd.settings(transfer_hz = 25000000)
@export("storage_status")
var storage_status: Word

storage_now() -> u64
    val now = word(0xe000e018).value
    storage_cycles += u64((storage_previous - now) & 0xffffff)
    storage_previous = now
    storage_cycles / 240

storage_initialize()
    storage_previous = word(0xe000e018).value
    storage_cycles = 0
    if !storage_pin_setup()
        storage_status.value = 3
        return
    storage_status.value = 3
    if storage_card.initialize().is_err() then return
    storage_volume = fat.mount(&storage_card,storage_sector[..]) match
        Ok(v) -> v
        Err(_) -> return
    storage_status.value = storage_load_settings() match
        Ok(status) -> status
        Err(_) -> 3

// Read the complete, bounded file before applying either value. A malformed
// settings file leaves both defaults intact and may be replaced with SAVE SD.
storage_load_settings() -> Result[u32,fat.VolumeError]
    var file = storage_volume.open("SETTINGS.TXT") match
        Ok(f) -> f
        Err(fat.VolumeError.NotFound) -> return Ok(1)
        Err(e) -> return Err(e)
    if file.size != 20 then return Ok(4)
    var bytes: [20]u8 = [0;20]
    if storage_volume.read(&file,bytes[..])? != bytes.len then return Err(fat.VolumeError.ChainTooShort)
    val pattern = "feedback=00\nwet=000\n"
    for i in 0..<20
        if i == 9 || i == 10 || i == 16 || i == 17 || i == 18
            if bytes[i] < 48 || bytes[i] > 57 then return Ok(4)
        elif bytes[i] != pattern[i] then return Ok(4)
    val feedback = int(bytes[9] - 48) * 10 + int(bytes[10] - 48)
    val wet = int(bytes[16] - 48) * 100 + int(bytes[17] - 48) * 10 + int(bytes[18] - 48)
    if feedback > 85 || wet > 100 then return Ok(4)
    delay_ui_feedback = feedback
    delay_ui_wet = wet
    Ok(5)

storage_write_settings() -> Result[unit,fat.VolumeError]
    var file = storage_volume.open("SETTINGS.TXT") match
        Ok(f) -> f
        Err(fat.VolumeError.NotFound) -> storage_volume.create("SETTINGS.TXT")?
        Err(e) -> return Err(e)
    var bytes: [23]u8 = [0;23]
    val prefix = "feedback=00\nwet=000\n"
    for i in 0..<prefix.len do bytes[i] = prefix[i]
    bytes[9] = u8(delay_ui_feedback / 10) + 48
    bytes[10] = u8(delay_ui_feedback % 10) + 48
    bytes[16] = u8(delay_ui_wet / 100) + 48
    bytes[17] = u8((delay_ui_wet / 10) % 10) + 48
    bytes[18] = u8(delay_ui_wet % 10) + 48
    val written = storage_volume.write(&file,bytes[..<prefix.len])?
    // A short count means the rest did not land; the settings are not saved either way.
    if written != prefix.len then return Err(fat.VolumeError.Device(fat.DeviceError.Io(0)))
    storage_volume.truncate(&file,u32(written))?
    storage_volume.flush()
storage_save()
    if storage_status.value == 3 || record_status.value == 1 || record_status.value == 2 || play_busy() then return
    record_status.value = 0
    play_status.value = 0
    storage_status.value = if storage_write_settings().is_ok() then 2 else 3
#endif
