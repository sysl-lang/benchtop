#if feature_audio
import sh.sysl.stm32h747.sai1
import sh.sysl.stm32h747.dma2
import sh.sysl.stm32h747.dmamux1
import sh.sysl.stm32h747.i2c4

// M7 audio is independent of the M4 UI: a circular SAI DMA buffer, refilled
// on half/full IRQs, with single-precision interpolation and a click-free ramp.

// DMA2 stream 1 carries SAI1 block A out (transmit); stream 4 carries block B in (capture).
const TX_FLAGS: u32 = dma2.BASE + dma2.LISR_OFFSET
const TX_FLAGS_CLEAR: u32 = dma2.BASE + dma2.LIFCR_OFFSET
const TX_CONTROL: u32 = dma2.BASE + dma2.S1CR_OFFSET
const TX_REMAINING: u32 = dma2.BASE + dma2.S1NDTR_OFFSET
const TX_PERIPHERAL: u32 = dma2.BASE + dma2.S1PAR_OFFSET
const TX_MEMORY: u32 = dma2.BASE + dma2.S1M0AR_OFFSET
const RX_FLAGS: u32 = dma2.BASE + dma2.HISR_OFFSET
const RX_CONTROL: u32 = dma2.BASE + dma2.S4CR_OFFSET
const RX_REMAINING: u32 = dma2.BASE + dma2.S4NDTR_OFFSET
const RX_PERIPHERAL: u32 = dma2.BASE + dma2.S4PAR_OFFSET
const RX_MEMORY: u32 = dma2.BASE + dma2.S4M0AR_OFFSET
// DMAMUX1 channels 9 and 12 are DMA2 streams 1 and 4; the request ids are SAI1 A and SAI1 B.
const TX_REQUEST: u32 = dmamux1.BASE + dmamux1.DMAMUX1_C9CR_OFFSET
const RX_REQUEST: u32 = dmamux1.BASE + dmamux1.DMAMUX1_C12CR_OFFSET
const SAI_A_DATA: u32 = sai1.BASE + sai1.SAI_ADR_OFFSET
const SAI_B_DATA: u32 = sai1.BASE + sai1.SAI_BDR_OFFSET

// Cortex-M system registers.
const SCB_CPACR: u32 = 0xe000ed88
const NVIC_ISER1: u32 = 0xe000e104
const SYSTICK_CONTROL: u32 = 0xe000e010
const SYSTICK_RELOAD: u32 = 0xe000e014
const SYSTICK_VALUE: u32 = 0xe000e018
// Enable the counter on the processor clock, with no interrupt.
const SYSTICK_FREE_RUNNING: u32 = 5

// DMA stream flags: one group of six bits per stream, half transfer at 4, transfer complete at 5.
const DMA_ALL_FLAGS: u32 = 0x3d
const DMA_ERROR_FLAG: u32 = 8
const DMA_HALF_FLAG: u32 = 16
const DMA_FULL_FLAG: u32 = 32
const DMA_BOTH_FLAGS: u32 = DMA_HALF_FLAG | DMA_FULL_FLAG
// Stream 1's flags sit at bit 6 of the low flag register.
const TX_FLAG_SHIFT: u32 = 6

// DMA stream control: enable, the three interrupt enables, and a circular transfer of 16-bit
// samples with memory increment.
const DMA_ENABLE: u32 = dma2.S1CR_EN_MASK
const DMA_INTERRUPTS: u32 = dma2.S1CR_TCIE_MASK | dma2.S1CR_HTIE_MASK | dma2.S1CR_TEIE_MASK
const DMA_MEMORY_TO_PERIPHERAL: u32 = 1 << 6
const DMA_STREAM_SETTINGS: u32 = dma2.S1CR_CIRC_MASK | dma2.S1CR_MINC_MASK | (1 << 11) | (1 << 13)
const DMAMUX_SAI1_A: u32 = 87
const DMAMUX_SAI1_B: u32 = 88
// NVIC interrupt-set-enable bits (IRQ 57 and 60, in the second enable register).
const ENABLE_DMA2_STREAM1_IRQ: u32 = 1 << 25
const ENABLE_DMA2_STREAM4_IRQ: u32 = 1 << 28

// SAI frame: four 32-bit TDM slots, frame-sync one slot wide, asserted a bit before the first.
const FRAME_LENGTH: u32 = 127
const FRAME_SYNC_LENGTH: u32 = 63 << sai1.SAI_AFRCR_FSALL_SHIFT
const FRAME_SYNC_OFFSET: u32 = sai1.SAI_AFRCR_FSOFF_MASK
const FRAME_SYNC_PRE: u32 = sai1.SAI_AFRCR_FSDEF_MASK
// Block A is the master transmitter (16-bit data, no master-clock divider); block B a slave
// receiver synchronous with A.
const SAI_A_CONFIGURATION: u32 = (4 << sai1.SAI_ACR1_DS_SHIFT) | (1 << sai1.SAI_ACR1_MCKDIV_SHIFT) | (1 << 27)
const SAI_B_CONFIGURATION: u32 = (4 << sai1.SAI_BCR1_DS_SHIFT) | 3 | (1 << sai1.SAI_BCR1_SYNCEN_SHIFT)
const SAI_ENABLE: u32 = sai1.SAI_ACR1_SAIXEN_MASK | sai1.SAI_ACR1_DMAEN_MASK

struct AudioControl
    sequence: volatile u32
    enabled: volatile u32
    level: volatile u32
    note: volatile u32
    feedback: volatile u32
    wet: volatile u32

@export("audio_control")
var audio_control = AudioControl(0,0,50,0,35,35)
@export("audio_errors")
var audio_errors: Word
@export("audio_irqs")
var audio_irqs: Word
@export("audio_deadline_misses")
var audio_deadline_misses: Word
@export("audio_ready")
var audio_ready: Word
var audio_buffer: [512]u16

// The oscillator, its click-free gain ramp and the microphone path's filter and meter.
struct Synth
    phase: u32
    step: u32
    envelope: f32
    target: f32
    effect: u32
    filter: f32
    peak: f32

var synth = Synth(0,39370534,0.0,0.0,0,0.0,0.0)
@export("audio_input_level")
var audio_input_level: Word
@export("audio_capture_irqs")
var audio_capture_irqs: Word
struct AudioSample
    value: volatile u16
var audio_capture_buffer: [512]AudioSample

// One cycle of cos(2 * pi * i / 256), interpolated by fractional phase rather than rounding to
// table entries. This is firmware data, not samples synthesized by the host. It is written out as
// decimal literals, to ten places, because the tests compare the samples the guest produces
// bit for bit and a table computed by the firmware's libm could differ in the last bit.
val audio_wave: [256]f32 = [
    0.0000000000,0.0245412285,0.0490676743,0.0735645636,0.0980171403,0.1224106752,0.1467304745,0.1709618888,
    0.1950903220,0.2191012402,0.2429801799,0.2667127575,0.2902846773,0.3136817404,0.3368898534,0.3598950365,
    0.3826834324,0.4052413140,0.4275550934,0.4496113297,0.4713967368,0.4928981922,0.5141027442,0.5349976199,
    0.5555702330,0.5758081914,0.5956993045,0.6152315906,0.6343932842,0.6531728430,0.6715589548,0.6895405447,
    0.7071067812,0.7242470830,0.7409511254,0.7572088465,0.7730104534,0.7883464276,0.8032075315,0.8175848132,
    0.8314696123,0.8448535652,0.8577286100,0.8700869911,0.8819212643,0.8932243012,0.9039892931,0.9142097557,
    0.9238795325,0.9329927988,0.9415440652,0.9495281806,0.9569403357,0.9637760658,0.9700312532,0.9757021300,
    0.9807852804,0.9852776424,0.9891765100,0.9924795346,0.9951847267,0.9972904567,0.9987954562,0.9996988187,
    1.0000000000,0.9996988187,0.9987954562,0.9972904567,0.9951847267,0.9924795346,0.9891765100,0.9852776424,
    0.9807852804,0.9757021300,0.9700312532,0.9637760658,0.9569403357,0.9495281806,0.9415440652,0.9329927988,
    0.9238795325,0.9142097557,0.9039892931,0.8932243012,0.8819212643,0.8700869911,0.8577286100,0.8448535652,
    0.8314696123,0.8175848132,0.8032075315,0.7883464276,0.7730104534,0.7572088465,0.7409511254,0.7242470830,
    0.7071067812,0.6895405447,0.6715589548,0.6531728430,0.6343932842,0.6152315906,0.5956993045,0.5758081914,
    0.5555702330,0.5349976199,0.5141027442,0.4928981922,0.4713967368,0.4496113297,0.4275550934,0.4052413140,
    0.3826834324,0.3598950365,0.3368898534,0.3136817404,0.2902846773,0.2667127575,0.2429801799,0.2191012402,
    0.1950903220,0.1709618888,0.1467304745,0.1224106752,0.0980171403,0.0735645636,0.0490676743,0.0245412285,
    0.0000000000,-0.0245412285,-0.0490676743,-0.0735645636,-0.0980171403,-0.1224106752,-0.1467304745,-0.1709618888,
    -0.1950903220,-0.2191012402,-0.2429801799,-0.2667127575,-0.2902846773,-0.3136817404,-0.3368898534,-0.3598950365,
    -0.3826834324,-0.4052413140,-0.4275550934,-0.4496113297,-0.4713967368,-0.4928981922,-0.5141027442,-0.5349976199,
    -0.5555702330,-0.5758081914,-0.5956993045,-0.6152315906,-0.6343932842,-0.6531728430,-0.6715589548,-0.6895405447,
    -0.7071067812,-0.7242470830,-0.7409511254,-0.7572088465,-0.7730104534,-0.7883464276,-0.8032075315,-0.8175848132,
    -0.8314696123,-0.8448535652,-0.8577286100,-0.8700869911,-0.8819212643,-0.8932243012,-0.9039892931,-0.9142097557,
    -0.9238795325,-0.9329927988,-0.9415440652,-0.9495281806,-0.9569403357,-0.9637760658,-0.9700312532,-0.9757021300,
    -0.9807852804,-0.9852776424,-0.9891765100,-0.9924795346,-0.9951847267,-0.9972904567,-0.9987954562,-0.9996988187,
    -1.0000000000,-0.9996988187,-0.9987954562,-0.9972904567,-0.9951847267,-0.9924795346,-0.9891765100,-0.9852776424,
    -0.9807852804,-0.9757021300,-0.9700312532,-0.9637760658,-0.9569403357,-0.9495281806,-0.9415440652,-0.9329927988,
    -0.9238795325,-0.9142097557,-0.9039892931,-0.8932243012,-0.8819212643,-0.8700869911,-0.8577286100,-0.8448535652,
    -0.8314696123,-0.8175848132,-0.8032075315,-0.7883464276,-0.7730104534,-0.7572088465,-0.7409511254,-0.7242470830,
    -0.7071067812,-0.6895405447,-0.6715589548,-0.6531728430,-0.6343932842,-0.6152315906,-0.5956993045,-0.5758081914,
    -0.5555702330,-0.5349976199,-0.5141027442,-0.4928981922,-0.4713967368,-0.4496113297,-0.4275550934,-0.4052413140,
    -0.3826834324,-0.3598950365,-0.3368898534,-0.3136817404,-0.2902846773,-0.2667127575,-0.2429801799,-0.2191012402,
    -0.1950903220,-0.1709618888,-0.1467304745,-0.1224106752,-0.0980171403,-0.0735645636,-0.0490676743,-0.0245412285,
]

// The phase step per sample of note n is the frequency (440 + 110 * n) Hz, as a share of the 48 kHz
// sample rate in 32-bit phase units: round(frequency * 2^32 / 48000).
val audio_steps: [10]u32 = [39370534,49213167,59055800,68898434,78741067,88583700,98426334,108268967,118111601,127954234]

audio_barrier()
    asm
        [thumb]
            "dmb"
            clobbers "memory"
        [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"

audio_publish_controls(enabled: bool, level: int, note: int)
    audio_control.sequence += 1
    audio_barrier()
    audio_control.enabled = if enabled then 1 else 0
    audio_control.level = u32(level)
    audio_control.note = u32(note)
    audio_barrier()
    audio_control.sequence += 1

audio_controls()
    val before = audio_control.sequence
    if before & 1 != 0 then return
    audio_barrier()
    val enabled = audio_control.enabled
    val level = audio_control.level
    val note = audio_control.note
#if feature_delay
    val feedback = audio_control.feedback
    val wet = audio_control.wet
#endif
    audio_barrier()
    if before != audio_control.sequence then return
#if feature_delay
    synth.target = if enabled != 0 then 1.0 else 0.0
    delay.feedback_target = f32(if feedback > 85 then 85 else feedback) * 0.01
    delay.wet_target = f32(if wet > 100 then 100 else wet) * 0.01
#else
#if feature_microphone
    synth.target = if enabled != 0 then f32(if level > 100 then 100 else level) * 0.02 else 0.0
    synth.effect = if note > 2 then 2 else note
#else
    synth.target = if enabled != 0 then f32(if level > 100 then 100 else level) * 0.0035 else 0.0
#endif
#endif
    synth.step = audio_steps[usize(if note > 9 then 9 else note)]

audio_fill(first: usize, last: usize)
    audio_controls()
#if feature_delay
    delay.output_peak *= 0.95
    if delay.output_peak < 0.00001 then delay.output_peak = 0.0
#endif
    var i = first
    var peak: f32 = 0.0
    while i < last
        synth.envelope += (synth.target - synth.envelope) * 0.002
        if synth.target == 0.0 && synth.envelope < 0.0000001 then synth.envelope = 0.0
#if feature_microphone
        // The just-completed RX half is stable until DMA wraps around.
        val left = int(u32(audio_capture_buffer[i].value) << 16) >> 16
        val right = int(u32(audio_capture_buffer[i + 1].value) << 16) >> 16
        val input = f32(left + right) / 65536.0
        val magnitude = if input < 0.0 then -input else input
        if magnitude > peak then peak = magnitude
#if feature_delay
        val stereo = delay_frame(f32(left) / 32768.0,f32(right) / 32768.0)
        val output_peak = if stereo[0] < 0.0 then -stereo[0] else stereo[0]
        val output_right = if stereo[1] < 0.0 then -stereo[1] else stereo[1]
        if output_peak > delay.output_peak then delay.output_peak = output_peak
        if output_right > delay.output_peak then delay.output_peak = output_right
        val value = u16(int(stereo[0] * 32767.0))
        val value_right = u16(int(stereo[1] * 32767.0))
#else
#if feature_busy
        val wave = busy_filter(input)
#else
        // One-pole low-pass at roughly 1 kHz; subtract for the high-pass mode.
        synth.filter += (input - synth.filter) * 0.122694
        if input == 0.0 && synth.filter > -0.00000001 && synth.filter < 0.00000001 then synth.filter = 0.0
        val wave = if synth.effect == 1 then synth.filter elif synth.effect == 2 then input - synth.filter else input
#endif
        val amplified = wave * synth.envelope
        val limited = if amplified < -0.95 then -0.95 elif amplified > 0.95 then 0.95 else amplified
        val value = u16(int(limited * 32767.0))
#endif
#else
        val index = usize(synth.phase >> 24)
        val fraction = f32(synth.phase & 0xffffff) / 16777216.0
        val wave = audio_wave[index] + (audio_wave[(index + 1) & 255] - audio_wave[index]) * fraction
        val value = u16(int(wave * synth.envelope * 32767.0))
#endif
        audio_buffer[i] = value
#if feature_delay
        audio_buffer[i + 1] = value_right
#else
        audio_buffer[i + 1] = value
#endif
        synth.phase += synth.step
        i += 2
#if feature_storage
    play_audio_half(first,last)
    record_audio_half(first,last)
#endif
#if feature_microphone
    synth.peak *= 0.95
    if synth.peak < 0.00001 then synth.peak = 0.0
    if peak > synth.peak then synth.peak = peak
    audio_input_level.value = u32(synth.peak * 100.0)
#if feature_delay
    audio_output_level.value = u32(delay.output_peak * 100.0)
#endif
#endif

@export("audio_dma_interrupt")
audio_interrupt()
    val flags = word(TX_FLAGS).value
    word(TX_FLAGS_CLEAR).value = flags & (DMA_ALL_FLAGS << TX_FLAG_SHIFT)
    audio_irqs.value += 1
    if flags & (DMA_ERROR_FLAG << TX_FLAG_SHIFT) != 0 then audio_errors.value += 1
#if !feature_microphone
    // Each half must be ready before DMA starts consuming it again.
    if flags & (DMA_BOTH_FLAGS << TX_FLAG_SHIFT) == (DMA_BOTH_FLAGS << TX_FLAG_SHIFT) then audio_deadline_misses.value += 1
    if flags & (DMA_HALF_FLAG << TX_FLAG_SHIFT) != 0
        audio_fill(0,256)
        if word(TX_REMAINING).value > 256 then audio_deadline_misses.value += 1
    if flags & (DMA_FULL_FLAG << TX_FLAG_SHIFT) != 0
        audio_fill(256,512)
        if word(TX_REMAINING).value <= 256 then audio_deadline_misses.value += 1
#endif

audio_refill(first: usize, last: usize)
#if feature_delay || feature_busy
    val before = word(SYSTICK_VALUE).value
#endif
    audio_fill(first,last)
#if feature_delay || feature_busy
    val used = (before - word(SYSTICK_VALUE).value) & 0xffffff
    audio_dsp_cycles.value = used
    if used > audio_dsp_peak_cycles.value then audio_dsp_peak_cycles.value = used
#endif

audio_capture_interrupt()
#if feature_microphone
    val flags = word(RX_FLAGS).value
    word(dma2.BASE + dma2.HIFCR_OFFSET).value = flags & DMA_ALL_FLAGS
    audio_capture_irqs.value += 1
    if flags & DMA_ERROR_FLAG != 0 then audio_errors.value += 1
    if flags & DMA_BOTH_FLAGS == DMA_BOTH_FLAGS then audio_deadline_misses.value += 1
    if flags & DMA_HALF_FLAG != 0
        audio_refill(0,256)
        if word(RX_REMAINING).value > 256 || word(TX_REMAINING).value > 256 then audio_deadline_misses.value += 1
    if flags & DMA_FULL_FLAG != 0
        audio_refill(256,512)
        if word(RX_REMAINING).value <= 256 || word(TX_REMAINING).value <= 256 then audio_deadline_misses.value += 1
#else
    ()
#endif

audio_i2c_byte(value: u32) -> bool
    while word(i2c4.BASE + i2c4.ISR_OFFSET).value & i2c4.ISR_TXIS_MASK == 0
        if word(i2c4.BASE + i2c4.ISR_OFFSET).value & i2c4.ISR_NACKF_MASK != 0 then return false
    word(i2c4.BASE + i2c4.TXDR_OFFSET).value = value & 255
    true

audio_codec_write(register: u32, value: u32) -> bool
    // WM8994 at 7-bit address 0x1a: a four-byte write, started now and stopped automatically.
    word(i2c4.BASE + i2c4.CR2_OFFSET).value = (0x1a << 1) | (4 << 16) | i2c4.CR2_START_MASK | i2c4.CR2_AUTOEND_MASK
    if !audio_i2c_byte(register >> 8) || !audio_i2c_byte(register) || !audio_i2c_byte(value >> 8) || !audio_i2c_byte(value) then return false
    while word(i2c4.BASE + i2c4.ISR_OFFSET).value & 32 == 0
        if word(i2c4.BASE + i2c4.ISR_OFFSET).value & i2c4.ISR_NACKF_MASK != 0 then return false
    word(i2c4.BASE + i2c4.ICR_OFFSET).value = i2c4.ICR_STOPCF_MASK
    true

audio_initialize()
    word(SCB_CPACR).value = 0x00f00000
    asm
        [thumb]
            "dsb"
            "isb"
            clobbers "memory"
        [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"
    word(i2c4.BASE + i2c4.TIMINGR_OFFSET).value = 0x10c0ecff
    word(i2c4.BASE + i2c4.CR1_OFFSET).value = i2c4.CR1_PE_MASK
    // DAC2, AIF1 timeslot1, the actual WM8994 speaker path on Discovery.
    val configuration: [15][2]u32 = [[0,0],[1,0x3003],[3,0x300],[5,0xc0c],[0x200,1],[0x208,0xa],[0x210,0x83],[0x300,0x10],[0x302,0],[0x604,2],[0x605,2],[0x36,0x300],[0x612,0x1c0],[0x613,0x1c0],[0x422,0x10]]
    for item in configuration
        if !audio_codec_write(item[0],item[1]) then audio_errors.value += 1
    if !audio_codec_write(0x26,0x179) || !audio_codec_write(0x27,0x179) then audio_errors.value += 1
#if feature_microphone
    val capture_configuration: [6][2]u32 = [[4,0x30c],[0x606,2],[0x607,2],[0x400,0x1c0],[0x401,0x1c0],[0x410,0]]
    for item in capture_configuration
        if !audio_codec_write(item[0],item[1]) then audio_errors.value += 1
#endif
#if feature_busy
    busy_initialize()
#endif
#if feature_delay
    // DAC1 -> HPOUT1. Speaker hardware remains attached but powered down.
    val headphones: [17][2]u32 = [[1,0x303],[3,0x30],[5,0x303],[0x601,1],[0x602,1],[0x2d,1],[0x2e,1],[0x610,0x1c0],[0x611,0x1c0],[0x402,0x1c0],[0x403,0x1c0],[0x1c,0x179],[0x1d,0x179],[0x4c,0x9f25],[0x54,0x33],[0x60,0xee],[0x420,0x10]]
    for item in headphones
        if !audio_codec_write(item[0],item[1]) then audio_errors.value += 1
    delay_initialize()
#endif
    audio_fill(0,512)
    // Four 32-bit TDM slots; only speaker slots1 and3 consume FIFO words.
    word(sai1.BASE + sai1.SAI_AFRCR_OFFSET).value = FRAME_LENGTH | FRAME_SYNC_LENGTH | FRAME_SYNC_OFFSET | FRAME_SYNC_PRE
#if feature_delay
    word(sai1.BASE + sai1.SAI_ASLOTR_OFFSET).value = (5 << 16) | (3 << 8) | (2 << 6)
#else
    word(sai1.BASE + sai1.SAI_ASLOTR_OFFSET).value = (10 << 16) | (3 << 8) | (2 << 6)
#endif
    word(sai1.BASE + sai1.SAI_ACR2_OFFSET).value = 4
    word(sai1.BASE + sai1.SAI_ACR1_OFFSET).value = SAI_A_CONFIGURATION
    word(TX_REQUEST).value = DMAMUX_SAI1_A
    word(TX_REMAINING).value = 512
    word(TX_PERIPHERAL).value = SAI_A_DATA
    word(TX_MEMORY).value = u32(usize(&audio_buffer[0]))
    word(NVIC_ISER1).value = ENABLE_DMA2_STREAM1_IRQ
#if feature_microphone
    // SAI B follows A's four-slot clock; ADC1 occupies slots0/2.
    word(sai1.BASE + sai1.SAI_BFRCR_OFFSET).value = FRAME_LENGTH | FRAME_SYNC_LENGTH | FRAME_SYNC_OFFSET | FRAME_SYNC_PRE
    word(sai1.BASE + sai1.SAI_BSLOTR_OFFSET).value = (5 << 16) | (3 << 8) | (2 << 6)
    word(sai1.BASE + sai1.SAI_BCR2_OFFSET).value = 0
    word(sai1.BASE + sai1.SAI_BCR1_OFFSET).value = SAI_B_CONFIGURATION
    word(RX_REQUEST).value = DMAMUX_SAI1_B
    word(RX_REMAINING).value = 512
    word(RX_PERIPHERAL).value = SAI_B_DATA
    word(RX_MEMORY).value = u32(usize(&audio_capture_buffer[0]))
    word(NVIC_ISER1).value = ENABLE_DMA2_STREAM4_IRQ
    word(RX_CONTROL).value = DMA_ENABLE | DMA_INTERRUPTS | DMA_STREAM_SETTINGS
    // RX IRQ refills the matching TX half after it has become free. TX DMA's
    // FIFO prefetch makes its half-transfer happen slightly before RX's.
    val tx_interrupts: u32 = dma2.S1CR_TEIE_MASK
#else
    val tx_interrupts: u32 = DMA_INTERRUPTS
#endif
    word(TX_CONTROL).value = DMA_ENABLE | tx_interrupts | DMA_MEMORY_TO_PERIPHERAL | DMA_STREAM_SETTINGS
    audio_ready.value = 1

audio_start()
#if feature_microphone
    word(sai1.BASE + sai1.SAI_BCR1_OFFSET).value = SAI_B_CONFIGURATION | SAI_ENABLE
#endif
    word(sai1.BASE + sai1.SAI_ACR1_OFFSET).value = SAI_A_CONFIGURATION | SAI_ENABLE
#endif
