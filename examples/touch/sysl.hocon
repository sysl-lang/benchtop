package { name = "benchtop-touch-firmware", version = "0.0.0", sysl = "0.6.2" }
capabilities { heap = true, libc = true }
allocator { alloc = malloc, free = free }
features { gpio_spi = [], full_redraw = [], h7_cores = [], dsi = [], audio = [], microphone = [], delay = [], storage = [sd, spi, fat, wav], sdmmc = [] }
dependencies {
  wav { git = "github.com/sysl-lang/wav", rev = "fd4a8daf904e0ead0fc5a540a7ce836a7805f8f2", optional = true }
  spi { git = "github.com/sysl-lang/spi", rev = "7852bfa1f2e7a23e3cbbe650ba179632ab9caa2d", optional = true }
  sd { git = "github.com/sysl-lang/sd", rev = "86b0d3d3ed43e14cf41acd309b6eafb743396994", features = [fat], optional = true }
  fat { git = "github.com/sysl-lang/fat", version = "0.1.1", optional = true }
  imui { git = "github.com/sysl-lang/imui", version = "0.3.0", features = [plutovg] }
}
