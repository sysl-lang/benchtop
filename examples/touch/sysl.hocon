package { name = "benchtop-touch-firmware", version = "0.0.0", sysl = "0.8.4" }
capabilities { heap = true, libc = true }
allocator { alloc = malloc, free = free }
features { joystick = [], gpio_spi = [], full_redraw = [], h7_cores = [], dsi = [stm32h747], audio = [stm32h747], microphone = [], delay = [], busy = [], storage = [sd, spi, fat, wav, stm32h747], sdmmc = [] }
dependencies {
  wav { git = "github.com/sysl-lang/wav", version = "0.1.0", optional = true }
  spi { git = "github.com/sysl-lang/spi", version = "0.2.1", optional = true }
  sd { git = "github.com/sysl-lang/sd", version = "0.2.3", features = [fat], optional = true }
  fat { git = "github.com/sysl-lang/fat", version = "0.4.2", optional = true }
  imui { git = "github.com/sysl-lang/imui", version = "0.3.0", features = [plutovg] }
  stm32h747 { git = "github.com/sysl-lang/stm32h747", version = "0.1.1", optional = true }
}
