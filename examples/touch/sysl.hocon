package { name = "benchtop-touch-firmware", version = "0.0.0", sysl = "0.7.7" }
capabilities { heap = true, libc = true }
allocator { alloc = malloc, free = free }
features { joystick = [], gpio_spi = [], full_redraw = [], h7_cores = [], dsi = [], audio = [], microphone = [], delay = [], storage = [sd, spi, fat, wav], sdmmc = [] }
dependencies {
  wav { git = "github.com/sysl-lang/wav", version = "0.1.0", optional = true }
  spi { git = "github.com/sysl-lang/spi", version = "0.2.0", optional = true }
  sd { git = "github.com/sysl-lang/sd", version = "0.2.3", features = [fat], optional = true }
  fat { git = "github.com/sysl-lang/fat", version = "0.4.0", optional = true }
  imui { git = "github.com/sysl-lang/imui", version = "0.3.0", features = [plutovg] }
}
