#if feature_storage && feature_sdmmc
import sysl.raw.ptr_cast
import sh.sysl.sd as sd
import sh.sysl.sd.native as card_spi

struct SdmmcHost
    base: u32
    rate: u32
struct StorageClock
end StorageClock
type StorageCard = card_spi.Card[SdmmcHost,StorageClock]
var storage_card = card_spi.card(SdmmcHost(0x52007000,400000),StorageClock(),storage_config())
// Word-aligned AXI SRAM bounce buffer. Cache maintenance is unnecessary with
// this startup's caches disabled; a physical cached build must maintain it.
var sdmmc_dma: [1024]Word
struct SdByte
    value: volatile u8

sdmmc_command(base: u32, index: u8, arg: u32, response: card_spi.Response, transfer: bool = false) -> Result[[4]u32,sd.Error]
    word(base + 0x38).value = 0x1fe00fff
    word(base + 8).value = arg
    val mode: u32 = response match
        card_spi.Response.Empty -> 0
        card_spi.Response.R1 -> 1
        card_spi.Response.R3 -> 2
        card_spi.Response.R2 -> 3
    word(base + 12).value = u32(index) | (mode << 8) | 4096 | (if transfer then 64u32 else 0) | (if index == 12 then 128u32 else 0)
    val start = storage_now()
    for i in 0..<1000000
        val flags = word(base + 0x34).value
        if flags & 4 != 0 then return Err(sd.Error.Timeout(sd.Phase.Response))
        if flags & 1 != 0 && response != card_spi.Response.R3 then return Err(sd.Error.Host(sd.HostError.CommandCrc))
        if flags & (if mode == 0 then 128u32 else 65u32) != 0
            return Ok([word(base + 0x14).value,word(base + 0x18).value,word(base + 0x1c).value,word(base + 0x20).value])
        if storage_now() - start >= 100000 then return Err(sd.Error.Timeout(sd.Phase.Response))
    Err(sd.Error.Timeout(sd.Phase.Response))

sdmmc_cleanup(base: u32)
    val active = word(base + 0x34).value & (1 << 12) != 0
    if active then word(base).value = 0
    word(base + 0x50).value = 0
    word(base + 0x2c).value = 0
    if active then word(base).value = 3

sdmmc_transfer(base: u32, rate: u32, index: u8, arg: u32, count: usize, reading: bool, timeout_us: u32) -> Result[u32,sd.Error]
    word(base + 0x2c).value = 0
    word(base + 0x38).value = 0x1fe00fff
    val clocks = (u64(rate) * u64(timeout_us) + 999999) / 1000000
    word(base + 0x24).value = if clocks > 0xffffffff then 0xffffffffu32 else u32(clocks)
    word(base + 0x28).value = u32(count)
    word(base + 0x2c).value = (if count == 8 then 3u32 else 9u32) << 4 | (if reading then 2u32 else 0)
    val double = count > 512
    val half = count / 2
    word(base + 0x54).value = if double then u32(half) else 0
    word(base + 0x58).value = u32(usize(&sdmmc_dma[0]))
    word(base + 0x5c).value = if double then u32(usize(&sdmmc_dma[0]) + half) else 0
    word(base + 0x50).value = if double then 3 else 1
    audio_barrier()
    val result = sdmmc_command(base,index,arg,card_spi.Response.R1,true)
    if result.is_err()
        sdmmc_cleanup(base)
        return Err(result.unwrap_err())
    val r1 = result.unwrap()[0]
    // A card refuses a data command in that command's own R1 (WP_VIOLATION, OUT_OF_RANGE are
    // response-type bits), and then never enters the data state. The R1 is answered at once, and
    // the card reports it as an error, instead of the refusal surfacing as a data timeout.
    if card_spi.card_status_error(r1) is Some(_)
        sdmmc_cleanup(base)
        return Ok(r1)
    val start = storage_now()
    val blocks = if count < 512 then 1usize else count / 512
    for i in 0..<(1000000 * blocks)
        val flags = word(base + 0x34).value
        if flags & 0x0800003a != 0
            sdmmc_cleanup(base)
            return Err(if flags & 8 != 0 then sd.Error.Timeout(sd.Phase.ReadToken) elif flags & 2 != 0 then sd.Error.Host(sd.HostError.DataCrc) else sd.Error.Host(sd.HostError.Io))
        if flags & 256 != 0
            audio_barrier()
            sdmmc_cleanup(base)
            return Ok(r1)
        if storage_now() - start >= u64(timeout_us) * u64(blocks) then break
    sdmmc_cleanup(base)
    Err(sd.Error.Timeout(sd.Phase.ReadToken))

impl card_spi.Host for SdmmcHost
    override max_blocks(self) -> usize = 8
    configure(*self, hz: u32, width: card_spi.BusWidth) -> Result[unit,sd.Error]
        if hz == 0 then return Err(sd.Error.InvalidSettings)
        val divider = (60000000u32 + hz * 2 - 1) / (hz * 2)
        if divider == 0 || divider > 1023 then return Err(sd.Error.InvalidSettings)
        word(self.base + 4).value = divider | (if width == card_spi.BusWidth.Four then 0x4000u32 else 0)
        word(self.base).value = 3
        self.rate = 60000000 / (divider * 2)
        Ok(())
    command(*self, index: u8, arg: u32, response: card_spi.Response) -> Result[[4]u32,sd.Error] = sdmmc_command(self.base,index,arg,response)
    read_data(*self, index: u8, arg: u32, out: []u8, timeout_us: u32) -> Result[u32,sd.Error]
        if out.len != 8 && (out.len == 0 || out.len % 512 != 0 || out.len > 4096) then return Err(sd.Error.BadLength)
        val r1 = sdmmc_transfer(self.base,self.rate,index,arg,out.len,true,timeout_us)?
        if card_spi.card_status_error(r1) is Some(_) then return Ok(r1)
        val bytes: *SdByte = ptr_cast(usize(&sdmmc_dma[0]))
        for i in 0..<out.len do out[i] = bytes[i].value
        Ok(r1)
    write_data(*self, index: u8, arg: u32, input: []const u8, timeout_us: u32) -> Result[u32,sd.Error]
        if input.len == 0 || input.len % 512 != 0 || input.len > 4096 then return Err(sd.Error.BadLength)
        val bytes: *SdByte = ptr_cast(usize(&sdmmc_dma[0]))
        for i in 0..<input.len do bytes[i].value = input[i]
        audio_barrier()
        sdmmc_transfer(self.base,self.rate,index,arg,input.len,false,timeout_us)
impl sd.Clock for StorageClock
    now_us(self) -> u64 = storage_now()
    delay_us(*self, micros: u32)
        val start = storage_now()
        while storage_now() - start < u64(micros) do ()

storage_pin_setup() -> bool
    // SDMMC1 AF12: PC8..12 data/clock and PD2 CMD. PI8 active-low detect.
    word(0x58020800).value = (word(0x58020800).value & ~0x03ff0000u32) | 0x02aa0000
    word(0x58020824).value = (word(0x58020824).value & ~0x000fffffu32) | 0x000ccccc
    word(0x58020808).value = word(0x58020808).value | 0x03ff0000
    word(0x5802080c).value = (word(0x5802080c).value & ~0x03ff0000u32) | 0x00550000
    word(0x58020c00).value = (word(0x58020c00).value & ~(3u32 << 4)) | (2 << 4)
    word(0x58020c20).value = (word(0x58020c20).value & ~(15u32 << 8)) | (12 << 8)
    word(0x58020c08).value = word(0x58020c08).value | (3 << 4)
    word(0x58020c0c).value = (word(0x58020c0c).value & ~(3u32 << 4)) | (1 << 4)
    word(0x58022000).value = word(0x58022000).value & ~(3u32 << 16)
    word(0x5802200c).value = (word(0x5802200c).value & ~(3u32 << 16)) | (1 << 16)
    word(0x58022010).value & (1 << 8) == 0
#endif
