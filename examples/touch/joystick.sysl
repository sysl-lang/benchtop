#if feature_joystick
import sysl.raw.ptr_cast
import sh.sysl.plutovg as vg
import sh.sysl.imui.Rect
// The stick is external analogue hardware: only ADC register reads reach the app.
struct StickPosition
    x: volatile u32
    y: volatile u32

@export("joystick_position")
var joystick_position = StickPosition(120,120)

joystick_adc(channel: u32) -> u32
    val select: *Word = ptr_cast(usize(0x50000104))
    val control: *Word = ptr_cast(usize(0x50000100))
    val status: *Word = ptr_cast(usize(0x50000108))
    val result: *Word = ptr_cast(usize(0x5000010c))
    select.value = channel
    control.value = 3
    while status.value & 2 == 0 do ()
    result.value

joystick_demo(gpio: *Gpio) -> never
    val surface = vg.for_data(pixels[..],240,240,960).unwrap()
    val canvas = vg.canvas(surface).unwrap()
    var old_x = -1
    var old_y = -1
    loop
        val x = 20 + int(joystick_adc(0) * 200 / 4095)
        val y = 20 + int(joystick_adc(1) * 200 / 4095)
        if x == old_x && y == old_y then continue
        canvas.rgb(0.025,0.055,0.085)
        canvas.rect(0.0,0.0,240.0,240.0)
        canvas.fill()
        canvas.rgb(0.10,0.17,0.22)
        canvas.rect(119.0,0.0,2.0,240.0)
        canvas.rect(0.0,119.0,240.0,2.0)
        canvas.fill()
        canvas.rgb(0.38,0.90,0.71)
        canvas.circle(f32(x),f32(y),14.0)
        canvas.fill()
        val first = old_x < 0
        val left = if first then 0 elif x < old_x then x - 16 else old_x - 16
        val top = if first then 0 elif y < old_y then y - 16 else old_y - 16
        val right = if first then 240 elif x > old_x then x + 16 else old_x + 16
        val bottom = if first then 240 elif y > old_y then y + 16 else old_y + 16
        flush(gpio,first,Rect(left,top,right - left,bottom - top))
        joystick_position.x = u32(x)
        joystick_position.y = u32(y)
        frames += 1
        old_x = x
        old_y = y
#endif
