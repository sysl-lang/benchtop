import sysl.raw.ptr_cast
import sh.sysl.imui.*
import sh.sysl.imui.plutovg.{PlutoPainter, painter}
import sh.sysl.plutovg as vg

extern __stack_top: u8

// Linker-provided load and runtime addresses; startup runs before using any globals.
extern __data_start: u8
extern __data_end: u8
extern __data_load: u8
extern __bss_start: u8
extern __bss_end: u8

struct StartupByte
    value: volatile u8

initialize_memory()
    val source: *StartupByte = ptr_cast(usize(&__data_load))
    val data: *StartupByte = ptr_cast(usize(&__data_start))
    val zero: *StartupByte = ptr_cast(usize(&__bss_start))
    for i in 0..<(usize(&__data_end) - usize(&__data_start)) do data[i].value = source[i].value
    for i in 0..<(usize(&__bss_end) - usize(&__bss_start)) do zero[i].value = 0


struct Vectors
    stack: *u8
    reset: *extern() -> never
    reserved: [46]u32

@export("vectors")
@section(".rodata.vectors")
val vectors: Vectors = Vectors(
#if feature_h7_cores
    &__m7_stack_top,
#else
    &__stack_top,
#endif
#if feature_h7_cores
    &m7_start,
#else
    &start,
#endif
    [0; 46])

#if feature_h7_cores
extern __m7_stack_top: u8

@export("m4_vectors")
@section(".rodata.m4_vectors")
val m4_vectors: Vectors = Vectors(&__stack_top, &start, [0;46])

// Test harness: real RCC_GCR CM4 boot request, with BCM4 disabled in option
// bytes. Display transport remains the existing virtual SPI/I2C test rig.
@export("m7_start")
m7_start() -> never
#if !feature_h7_cores
    initialize_memory()
#endif
    val gcr: *Word = ptr_cast(usize(0x580244a0))
    gcr.value = gcr.value | 8
    loop
        asm
            [thumb]
                "nop"
            [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"
#endif

struct Gpio
    out: volatile u32
    input: volatile u32
    oe: volatile u32

struct Word
    value: volatile u32

struct I2c
    address: volatile u32
    data: volatile u32
    command: volatile u32
    status: volatile u32

struct AppState
    count: int
    enabled: bool
    level: int

@export("touch_app")
var app = AppState(0, true, 50)
var pixels: [230400]u8
var previous: [57600]u16
var commands_a: [64]Cmd
var commands_b: [64]Cmd
@export("touch_frames")
var frames: u32 = 0

struct Profile
    render: u32
    flush: u32
    spi: u32
    bytes: u32
    pixels: u32

@export("touch_profile")
var profile = Profile(0,0,0,0,0)

ticks() -> u32
    val counter: *Word = ptr_cast(usize(0xE000E018))
    counter.value

elapsed(before: u32) -> u32 = (before - ticks()) & 0xFFFFFF


// PL022 register layout; the board chooses the peripheral base and SPI pins.
struct Spi
    cr0: volatile u32
    cr1: volatile u32
    data: volatile u32
    status: volatile u32
    prescale: volatile u32
    mask: volatile u32
    raw: volatile u32
    masked: volatile u32
    clear: volatile u32

spi_bus() -> *Spi = ptr_cast(usize(0x50001000))

// Keep the original transport as a buildable firmware feature.
// Ordinary mode-0 SPI: SCK GP0, MOSI GP1, CS GP2, DC GP3, RESET GP4.
gpio_spi(gpio: *Gpio, byte: u32, data: bool)
    val base = (gpio.out & 32) | 16 | (if data then 8 else 0)
    gpio.out = base
    for bit in 0..<8
        val value = base | (if (byte & (128u32 >> u32(bit))) != 0 then 2 else 0)
        gpio.out = value
        gpio.out = value | 1
        gpio.out = value
    gpio.out = base | 4


spi_byte(bus: *Spi, byte: u32)
    while (bus.status & 2) == 0
        if (bus.status & 4) != 0 then val ignored = bus.data
    bus.data = byte

spi_finish(gpio: *Gpio)
    val bus = spi_bus()
    while (bus.status & 16) != 0 do ()
    while (bus.status & 4) != 0 do val ignored = bus.data
    bus.clear = 1
    gpio.out = (gpio.out & 32) | 16 | 4 | 8

spi(gpio: *Gpio, byte: u32, data: bool)
#if feature_gpio_spi
    gpio_spi(gpio,byte,data)
#else
    gpio.out = (gpio.out & 32) | 16 | (if data then 8 else 0)
    spi_byte(spi_bus(),byte)
    spi_finish(gpio)
#endif

window(gpio: *Gpio, x: int, y: int, last: int)
    spi(gpio, 0x2A, false)
    spi(gpio, 0, true)
    spi(gpio, u32(x), true)
    spi(gpio, 0, true)
    spi(gpio, u32(last), true)
    spi(gpio, 0x2B, false)
    spi(gpio, 0, true)
    spi(gpio, u32(y), true)
    spi(gpio, 0, true)
    spi(gpio, u32(y), true)
    spi(gpio, 0x2C, false)

@inline
pixel565(at: int) -> u16
    val blue = u32(pixels[at * 4])
    val green = u32(pixels[at * 4 + 1])
    val red = u32(pixels[at * 4 + 2])
    u16(((red & 248) << 8) | ((green & 252) << 3) | (blue >> 3))

// Only changed pixel runs go over SPI; idle UI frames transmit nothing.
flush(gpio: *Gpio, first_frame: bool, only: Rect)
    for y in only.y..<only.bottom()
        var x = only.x
        while x < only.right()
            val index = y * 240 + x
            if !first_frame && pixel565(index) == previous[index]
                x += 1
                continue
            val first = x
            while x < only.right() && (first_frame || pixel565(y * 240 + x) != previous[y * 240 + x]) do x += 1
            val started = ticks()
            window(gpio, first, y, x - 1)
            profile.bytes += 11 + u32(x - first) * 2
            profile.pixels += u32(x - first)
#if !feature_gpio_spi
            gpio.out = (gpio.out & 32) | 16 | 8
#endif
            for col in first..<x
                val at = y * 240 + col
                val color = u32(pixel565(at))
#if feature_gpio_spi
                spi(gpio, color >> 8, true)
                spi(gpio, color & 255, true)
#else
                spi_byte(spi_bus(), color >> 8)
                spi_byte(spi_bus(), color & 255)
#endif
                previous[at] = u16(color)
#if !feature_gpio_spi
            spi_finish(gpio)
#endif
            profile.spi += elapsed(started)

begin(bus: *I2c, register: u32)
    bus.address = 0x5D
    bus.command = 1
    bus.data = register >> 8
    bus.command = 4
    bus.data = register & 255
    bus.command = 4

// Real GT911 protocol: 16-bit register pointer, status plus 8-byte contact,
// then acknowledge the report by writing zero to status 0x814e.
poll_touch(bus: *I2c, last: Input) -> Option[Input]
    begin(bus, 0x814E)
    if (bus.status & 2) != 0
        bus.command = 8
        return None
    bus.command = 3
    bus.command = 2
    val status = bus.data
    if (status & 128) == 0
        bus.command = 8
        return None
    var bytes: [8]u32 = [0;8]
    if (status & 15) != 0
        for i in 0..<8
            bus.command = 2
            bytes[i] = bus.data
    bus.command = 8
    begin(bus, 0x814E)
    bus.data = 0
    bus.command = 4
    bus.command = 8
    if (status & 15) == 0 then return Some(pointer(last.x, last.y, false))
    Some(pointer(int(bytes[1] | (bytes[2] << 8)), int(bytes[3] | (bytes[4] << 8)), true))

frame[P: Painter](ui: *Ui, painter: *P)
    var th = dark()
    th.radius = 8
    painter.fill_rect(Rect(0, 0, 240, 240), th.bg)
    label(painter, th, Rect(12, 4, 216, 28), "TOUCH SETTINGS", 0)
    if accent_button(ui, painter, th, Rect(12, 40, 216, 44), "ADD ONE")
        app.count += 1
        if app.count == 10 then app.count = 0
    val counts: [10]string = ["COUNT 0","COUNT 1","COUNT 2","COUNT 3","COUNT 4","COUNT 5","COUNT 6","COUNT 7","COUNT 8","COUNT 9"]
    label(painter, th, Rect(12, 88, 216, 16), counts[app.count], 0)
    toggle(ui, painter, th, Rect(12, 108, 216, 36), "POWER", &app.enabled)
    label(painter, th, Rect(12, 146, 216, 16), "BRIGHTNESS", -1)
    slider(ui, painter, th, Rect(12, 164, 216, 36), &app.level, 0, 100)
    progress(painter, th, Rect(12, 208, 216, 16), app.level, 100)

// Record interaction once, then draw only changed horizontal bands. The command
// buffers alternate, so the previous frame remains immutable during comparison.
draw_frame(ui: *Ui, painter: *PlutoPainter, gpio: *Gpio, input: Input,
           current: []Cmd, old: []const Cmd, first: bool) -> usize
    profile = Profile(0,0,0,0,0)
    var started = ticks()
    var rec = recorder(painter, current)
    ui.begin(input)
    frame(ui, &rec)
    ui.finish()
    assert(!rec.overflowed, "UI command buffer capacity")
    val screen = Rect(0,0,240,240)
#if feature_full_redraw
    val mask = all_bands(30)
#else
    val mask = if first then all_bands(30) else damage(old, rec.recorded(), screen, 30)
#endif
    profile.render = elapsed(started)
    gpio.out = (gpio.out & ~32u32) | (if app.enabled then 32 else 0)
    var next = next_band(mask, 30, screen, 0)
    while next.is_some()
        val band = next.unwrap()
        started = ticks()
        replay(rec.recorded(), painter, band.rect)
        profile.render += elapsed(started)
        started = ticks()
        flush(gpio, first, band.rect)
        profile.flush += elapsed(started)
        next = next_band(mask, 30, screen, band.next)
    frames += 1
    rec.n

@export("start")
start() -> never
#if !feature_h7_cores
    initialize_memory()
#endif
    val cpacr: *Word = ptr_cast(usize(0xE000ED88))
    cpacr.value = 0x00F00000 // Enable CP10/CP11 before using the core FPU.
    asm
        [thumb]
            "dsb"
            "isb"
            clobbers "memory"
        [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"
    val gpio: *Gpio = ptr_cast(usize(0x50000000))
    val bus: *I2c = ptr_cast(usize(0x50000300))
    gpio.out = 4
    gpio.oe = 63
#if !feature_gpio_spi
    val serial = spi_bus()
    serial.cr1 = 0
    serial.cr0 = 7 // Motorola mode 0, 8-bit words.
    serial.prescale = 4 // 37.5 MHz at the board's 150 MHz clock.
    serial.mask = 0
    serial.cr1 = 2
#endif
    gpio.out = 4 | 16
    spi(gpio, 0x11, false) // Sleep out.
    spi(gpio, 0x3A, false)
    spi(gpio, 0x55, true) // RGB565.
    spi(gpio, 0x29, false) // Display on.
    val systick: *Gpio = ptr_cast(usize(0xE000E010))
    systick.input = 0xFFFFFF
    systick.oe = 0
    systick.out = 5
    val surface = vg.for_data(pixels[..], 240, 240, 240 * 4).unwrap()
    val canvas = vg.canvas(surface).unwrap()
    val font = vg.font_from_data(embed("assets/ABeeZee-Regular.ttf")).unwrap()
    var painter = sh.sysl.imui.plutovg.painter(canvas, font, 14.0)
    var ui = sh.sysl.imui.ui()
    var input = no_input()
    var count = draw_frame(&ui, &painter, gpio, input, commands_a[..], [], true)
    var previous_a = true
    loop
        poll_touch(bus, input) match
            Some(next) ->
                input = next
                if previous_a
                    count = draw_frame(&ui, &painter, gpio, input, commands_b[..], commands_a[..<count], false)
                else
                    count = draw_frame(&ui, &painter, gpio, input, commands_a[..], commands_b[..<count], false)
                previous_a = !previous_a
            None -> ()
