import sysl.raw.ptr_cast
import sh.sysl.imui.*
import sh.sysl.imui.plutovg.{PlutoPainter, painter}
import sh.sysl.plutovg as vg
#if feature_dsi
import sh.sysl.stm32h747.dsihost as dsi
import sh.sysl.stm32h747.i2c4
#endif

import firmware.*

// The STM32H7 interrupt numbers of the DMA streams that serve the SAI.
const DMA2_STREAM1_IRQ: usize = 57
const DMA2_STREAM4_IRQ: usize = 60

#if feature_audio
@export("vectors")
@section(".rodata.vectors")
val vectors = vector_table[240](&__m7_stack_top, &m7_start, [(DMA2_STREAM1_IRQ, &audio_interrupt), (DMA2_STREAM4_IRQ, &audio_capture_interrupt)])
#else
#if feature_h7_cores
@export("vectors")
@section(".rodata.vectors")
val vectors = vector_table[32](&__m7_stack_top, &m7_start)
#else
@export("vectors")
@section(".rodata.vectors")
val vectors = vector_table[32](&__stack_top, &start)
#endif
#endif

#if feature_h7_cores
extern __m7_stack_top: u8

@export("m4_vectors")
@section(".rodata.m4_vectors")
val m4_vectors = vector_table[32](&__stack_top, &start)

// Test harness: real RCC_GCR CM4 boot request, with BCM4 disabled in option
// bytes. Display transport remains the existing virtual SPI/I2C test rig.
@export("m7_start")
m7_start() -> never
    initialize_memory()
#if feature_audio
    audio_initialize()
#endif
    val gcr: *Word = ptr_cast(usize(0x580244a0))
    gcr.value = gcr.value | 8
#if feature_audio
    audio_start()
#if feature_busy
    busy_run()
#endif
    loop
        asm
            [thumb] "wfi"
            [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"
#else
    loop
        asm
            [thumb]
                "nop"
            [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"
#endif
#endif

struct Gpio
    out: volatile u32
    input: volatile u32
    oe: volatile u32

struct Word
    value: volatile u32

struct I2c
    address: volatile u32
    data: volatile u32
    command: volatile u32
    status: volatile u32

// The application's state, one exported symbol per field so a test reads each by name.
@export("touch_count")
var touch_count: int = 0
@export("touch_enabled")
#if feature_audio
var touch_enabled: bool = false
#else
var touch_enabled: bool = true
#endif
@export("touch_level")
var touch_level: int = 50
var pixels: [230400]u8
var previous: [57600]u16
var commands_a: [64]Cmd
var commands_b: [64]Cmd
@export("touch_frames")
var frames: u32 = 0
#if feature_microphone
var audio_meter_display: u32 = 0
#endif

struct Profile
    render: u32
    flush: u32
    spi: u32
    bytes: u32
    pixels: u32

@export("touch_profile")
var profile = Profile(0,0,0,0,0)

ticks() -> u32
    val counter: *Word = ptr_cast(usize(0xE000E018))
    counter.value

elapsed(before: u32) -> u32 = (before - ticks()) & 0xFFFFFF


// PL022 register layout; the board chooses the peripheral base and SPI pins.
struct Spi
    cr0: volatile u32
    cr1: volatile u32
    data: volatile u32
    status: volatile u32
    prescale: volatile u32
    mask: volatile u32
    raw: volatile u32
    masked: volatile u32
    clear: volatile u32

spi_bus() -> *Spi = ptr_cast(usize(0x50001000))

#if feature_dsi
// STM32 DSI host command-mode registers, with 500 Mbit/s on each of two lanes.
word(at: u32) -> *Word = ptr_cast(usize(at))

// A DSI host register by its offset.
dsi_register(offset: u32) -> *Word = word(dsi.BASE + offset)

// The DCS data types a generic packet header carries, and the DCS commands the panel is given.
const DSI_SHORT_WRITE: u32 = 0x05
const DSI_SHORT_WRITE_PARAMETER: u32 = 0x15
const DSI_LONG_WRITE: u32 = 0x39
const DCS_EXIT_SLEEP: u32 = 0x11
const DCS_DISPLAY_ON: u32 = 0x29
const DCS_SET_COLUMN: u32 = 0x2a
const DCS_SET_PAGE: u32 = 0x2b
const DCS_WRITE_MEMORY: u32 = 0x2c
const DCS_WRITE_MEMORY_CONTINUE: u32 = 0x3c
const DCS_SET_PIXEL_FORMAT: u32 = 0x3a

dsi_wait()
    while dsi_register(dsi.DSI_GPSR_OFFSET).value & dsi.DSI_GPSR_CMDFE_MASK == 0 do ()

dsi_short(command: u32, parameter: u32 = 0, has_parameter: bool = false)
    dsi_wait()
    val data_type = if has_parameter then DSI_SHORT_WRITE_PARAMETER else DSI_SHORT_WRITE
    dsi_register(dsi.DSI_GHCR_OFFSET).value = data_type | (command << dsi.DSI_GHCR_WCLSB_SHIFT) | (parameter << dsi.DSI_GHCR_WCMSB_SHIFT)
    dsi_wait()

// Send a long write whose payload is already in the payload FIFO: `count` bytes of it.
dsi_long_write(count: u32)
    dsi_register(dsi.DSI_GHCR_OFFSET).value = DSI_LONG_WRITE | (count << dsi.DSI_GHCR_WCLSB_SHIFT)

dsi_window(left: int, top: int, right: int, bottom: int)
    dsi_wait()
    dsi_register(dsi.DSI_GPDR_OFFSET).value = DCS_SET_COLUMN | (u32(left >> 8) << 8) | (u32(left & 255) << 16) | (u32(right >> 8) << 24)
    dsi_register(dsi.DSI_GPDR_OFFSET).value = u32(right & 255)
    dsi_long_write(5)
    dsi_wait()
    dsi_register(dsi.DSI_GPDR_OFFSET).value = DCS_SET_PAGE | (u32(top >> 8) << 8) | (u32(top & 255) << 16) | (u32(bottom >> 8) << 24)
    dsi_register(dsi.DSI_GPDR_OFFSET).value = u32(bottom & 255)
    dsi_long_write(5)
    dsi_wait()

dsi_pixels(command: u32, first: int, count: int, blank: bool = false)
    dsi_wait()
    var packed = command
    var shift: u32 = 8
    for i in 0..<count
        val color = if blank then 0u32 else u32(pixel565(first + i))
        for byte in [color >> 8,color & 255]
            packed |= byte << shift
            shift += 8
            if shift == 32
                dsi_register(dsi.DSI_GPDR_OFFSET).value = packed
                packed = 0
                shift = 0
    if shift != 0 then dsi_register(dsi.DSI_GPDR_OFFSET).value = packed
    dsi_long_write(u32(1 + count * 2))
    dsi_wait()

dsi_initialize()
    dsi_register(dsi.DSI_WRPCR_OFFSET).value = dsi.DSI_WRPCR_REGEN_MASK
    while dsi_register(dsi.DSI_WISR_OFFSET).value & dsi.DSI_WISR_RRS_MASK == 0 do ()
    // 25 MHz / 5 * 100 = 500 MHz.
    dsi_register(dsi.DSI_WRPCR_OFFSET).value = dsi.DSI_WRPCR_REGEN_MASK | dsi.DSI_WRPCR_PLLEN_MASK | (100 << dsi.DSI_WRPCR_NDIV_SHIFT) | (5 << dsi.DSI_WRPCR_IDF_SHIFT)
    val pll_ready = dsi.DSI_WISR_RRS_MASK | dsi.DSI_WISR_PLLLS_MASK
    while dsi_register(dsi.DSI_WISR_OFFSET).value & pll_ready != pll_ready do ()
    dsi_register(dsi.DSI_PCTLR_OFFSET).value = dsi.DSI_PCTLR_DEN_MASK | dsi.DSI_PCTLR_CKE_MASK
    dsi_register(dsi.DSI_PCONFR_OFFSET).value = 1 // One data lane.
    dsi_register(dsi.DSI_MCR_OFFSET).value = dsi.DSI_MCR_CMDM_MASK
    dsi_register(dsi.DSI_CCR_OFFSET).value = 4 << dsi.DSI_CCR_TXECKDIV_SHIFT
    dsi_register(dsi.DSI_WCFGR_OFFSET).value = dsi.DSI_WCFGR_DSIM_MASK
    dsi_register(dsi.DSI_WCR_OFFSET).value = dsi.DSI_WCR_DSIEN_MASK
    dsi_register(dsi.DSI_CR_OFFSET).value = dsi.DSI_CR_EN_MASK
    dsi_short(DCS_EXIT_SLEEP)
    dsi_short(DCS_SET_PIXEL_FORMAT, 0x55, true)
    // Initialize the complete physical glass, not just the UI's 240x240 region.
    dsi_window(0, 0, 799, 479)
    for i in 0..<1500 do dsi_pixels(if i == 0 then DCS_WRITE_MEMORY else DCS_WRITE_MEMORY_CONTINUE, 0, 256, true)
    dsi_short(DCS_DISPLAY_ON)

// I2C4 polling using STM32 v2 flags and one-byte FT6206 register addresses.
ft_read(register: u32, bytes: []u32)
    val status = i2c4.BASE + i2c4.ISR_OFFSET
    val control = i2c4.BASE + i2c4.CR2_OFFSET
    word(i2c4.BASE + i2c4.ICR_OFFSET).value = i2c4.ICR_NACKCF_MASK | i2c4.ICR_STOPCF_MASK
    word(control).value = 0x54 | (1 << 16) | i2c4.CR2_START_MASK
    while word(status).value & i2c4.ISR_TXIS_MASK == 0 do ()
    word(i2c4.BASE + i2c4.TXDR_OFFSET).value = register
    while word(status).value & i2c4.ISR_TC_MASK == 0 do ()
    word(control).value = 0x54 | (u32(bytes.len) << 16) | i2c4.CR2_RD_WRN_MASK | i2c4.CR2_START_MASK | i2c4.CR2_AUTOEND_MASK
    for i in 0..<bytes.len
        while word(status).value & i2c4.ISR_RXNE_MASK == 0 do ()
        bytes[i] = word(i2c4.BASE + i2c4.RXDR_OFFSET).value

poll_focal(last: Input) -> Option[Input]
    var report: [7]u32 = [0;7]
    ft_read(2,report[..])
    val down = report[0] & 15 != 0
    val x = int(((report[1] & 15) << 8) | report[2]) - 280
    val y = int(((report[3] & 15) << 8) | report[4]) - 120
    if down == last.down && (!down || (x == last.x && y == last.y)) then return None
    Some(pointer(if down then x else last.x,if down then y else last.y,down))
#endif

// Keep the original transport as a buildable firmware feature.
// Ordinary mode-0 SPI: SCK GP0, MOSI GP1, CS GP2, DC GP3, RESET GP4.
gpio_spi(gpio: *Gpio, byte: u32, data: bool)
    val base = (gpio.out & 32) | 16 | (if data then 8 else 0)
    gpio.out = base
    for bit in 0..<8
        val value = base | (if (byte & (128u32 >> bit)) != 0 then 2 else 0)
        gpio.out = value
        gpio.out = value | 1
        gpio.out = value
    gpio.out = base | 4


spi_byte(bus: *Spi, byte: u32)
    while (bus.status & 2) == 0
        if (bus.status & 4) != 0 then val ignored = bus.data
    bus.data = byte

spi_finish(gpio: *Gpio)
    val bus = spi_bus()
    while (bus.status & 16) != 0 do ()
    while (bus.status & 4) != 0 do val ignored = bus.data
    bus.clear = 1
    gpio.out = (gpio.out & 32) | 16 | 4 | 8

spi(gpio: *Gpio, byte: u32, data: bool)
#if feature_gpio_spi
    gpio_spi(gpio,byte,data)
#else
    gpio.out = (gpio.out & 32) | 16 | (if data then 8 else 0)
    spi_byte(spi_bus(),byte)
    spi_finish(gpio)
#endif

window(gpio: *Gpio, x: int, y: int, last: int)
    spi(gpio, 0x2A, false)
    spi(gpio, 0, true)
    spi(gpio, u32(x), true)
    spi(gpio, 0, true)
    spi(gpio, u32(last), true)
    spi(gpio, 0x2B, false)
    spi(gpio, 0, true)
    spi(gpio, u32(y), true)
    spi(gpio, 0, true)
    spi(gpio, u32(y), true)
    spi(gpio, 0x2C, false)

@inline
pixel565(at: int) -> u16
    val blue = u32(pixels[at * 4])
    val green = u32(pixels[at * 4 + 1])
    val red = u32(pixels[at * 4 + 2])
    u16(((red & 248) << 8) | ((green & 252) << 3) | (blue >> 3))

// Only changed pixel runs go over SPI; idle UI frames transmit nothing.
flush(gpio: *Gpio, first_frame: bool, only: Rect)
#if feature_dsi
    for y in only.y..<only.bottom()
        var x = only.x
        while x < only.right()
            if !first_frame && pixel565(y * 240 + x) == previous[y * 240 + x]
                x += 1
                continue
            val first = x
            while x < only.right() && (first_frame || pixel565(y * 240 + x) != previous[y * 240 + x]) do x += 1
            dsi_window(first + 280,y + 120,x - 1 + 280,y + 120)
            dsi_pixels(0x2c,y * 240 + first,x - first)
            for i in first..<x do previous[y * 240 + i] = pixel565(y * 240 + i)
#else
    for y in only.y..<only.bottom()
        var x = only.x
        while x < only.right()
            val index = y * 240 + x
            if !first_frame && pixel565(index) == previous[index]
                x += 1
                continue
            val first = x
            while x < only.right() && (first_frame || pixel565(y * 240 + x) != previous[y * 240 + x]) do x += 1
            val started = ticks()
            window(gpio, first, y, x - 1)
            profile.bytes += 11 + u32(x - first) * 2
            profile.pixels += u32(x - first)
#if !feature_gpio_spi
            gpio.out = (gpio.out & 32) | 16 | 8
#endif
            for col in first..<x
                val at = y * 240 + col
                val color = u32(pixel565(at))
#if feature_gpio_spi
                spi(gpio, color >> 8, true)
                spi(gpio, color & 255, true)
#else
                spi_byte(spi_bus(), color >> 8)
                spi_byte(spi_bus(), color & 255)
#endif
                previous[at] = u16(color)
#if !feature_gpio_spi
            spi_finish(gpio)
#endif
            profile.spi += elapsed(started)

#endif

begin(bus: *I2c, register: u32)
    bus.address = 0x5D
    bus.command = 1
    bus.data = register >> 8
    bus.command = 4
    bus.data = register & 255
    bus.command = 4

// Real GT911 protocol: 16-bit register pointer, status plus 8-byte contact,
// then acknowledge the report by writing zero to status 0x814e.
poll_touch(bus: *I2c, last: Input) -> Option[Input]
    begin(bus, 0x814E)
    if (bus.status & 2) != 0
        bus.command = 8
        return None
    bus.command = 3
    bus.command = 2
    val status = bus.data
    if (status & 128) == 0
        bus.command = 8
        return None
    var bytes: [8]u32 = [0;8]
    if (status & 15) != 0
        for i in 0..<8
            bus.command = 2
            bytes[i] = bus.data
    bus.command = 8
    begin(bus, 0x814E)
    bus.data = 0
    bus.command = 4
    bus.command = 8
    if (status & 15) == 0 then return Some(pointer(last.x, last.y, false))
    Some(pointer(int(bytes[1] | (bytes[2] << 8)), int(bytes[3] | (bytes[4] << 8)), true))

frame[P: Painter](ui: *Ui, painter: *P)
    var th = dark()
    th.radius = 8
    painter.fill_rect(Rect(0, 0, 240, 240), th.bg)
#if feature_delay
    delay_ui(ui,painter,th)
    return
#endif
#if feature_audio
#if feature_microphone
    label(painter, th, Rect(12, 4, 216, 28), "MICROPHONE", 0)
#else
    label(painter, th, Rect(12, 4, 216, 28), "AUDIO SETTINGS", 0)
#endif
#else
    label(painter, th, Rect(12, 4, 216, 28), "TOUCH SETTINGS", 0)
#endif
#if feature_audio
#if feature_microphone
    val button_text = "CHANGE EFFECT"
#else
    val button_text = "CHANGE TONE"
#endif
#else
    val button_text = "ADD ONE"
#endif
    if accent_button(ui, painter, th, Rect(12, 40, 216, 44), button_text)
        touch_count += 1
#if feature_microphone
        if touch_count == 3 then touch_count = 0
#else
        if touch_count == 10 then touch_count = 0
#endif
#if feature_audio
#if feature_microphone
    val counts: [3]string = ["DRY","LOW PASS","HIGH PASS"]
#else
    val counts: [10]string = ["440 HZ","550 HZ","660 HZ","770 HZ","880 HZ","990 HZ","1100 HZ","1210 HZ","1320 HZ","1430 HZ"]
#endif
#else
    val counts: [10]string = ["COUNT 0","COUNT 1","COUNT 2","COUNT 3","COUNT 4","COUNT 5","COUNT 6","COUNT 7","COUNT 8","COUNT 9"]
#endif
    label(painter, th, Rect(12, 88, 216, 16), counts[touch_count], 0)
#if feature_audio
#if feature_microphone
    toggle(ui, painter, th, Rect(12, 108, 216, 36), "MONITOR", &touch_enabled)
#else
    toggle(ui, painter, th, Rect(12, 108, 216, 36), "TONE", &touch_enabled)
#endif
    label(painter, th, Rect(12, 146, 216, 16), "VOLUME", -1)
#else
    toggle(ui, painter, th, Rect(12, 108, 216, 36), "POWER", &touch_enabled)
    label(painter, th, Rect(12, 146, 216, 16), "BRIGHTNESS", -1)
#endif
    slider(ui, painter, th, Rect(12, 164, 216, 36), &touch_level, 0, 100)
#if feature_microphone
    progress(painter, th, Rect(12, 208, 216, 16), int(audio_meter_display), 100)
    label(painter, th, Rect(12, 225, 216, 14), "INPUT LEVEL", 0)
#else
    progress(painter, th, Rect(12, 208, 216, 16), touch_level, 100)
#endif
#if feature_audio
    audio_publish_controls(touch_enabled, touch_level, touch_count)
#endif

// Record interaction once, then draw only changed horizontal bands. The command
// buffers alternate, so the previous frame remains immutable during comparison.
draw_frame(ui: *Ui, painter: *PlutoPainter, gpio: *Gpio, input: Input,
           current: []Cmd, old: []const Cmd, first: bool) -> usize
    profile = Profile(0,0,0,0,0)
    var started = ticks()
    var rec = recorder(painter, current)
    ui.begin(input)
    frame(ui, &rec)
    ui.finish()
    assert(!rec.overflowed, "UI command buffer capacity")
    val screen = Rect(0,0,240,240)
#if feature_full_redraw
    val mask = all_bands(30)
#else
    val mask = if first then all_bands(30) else damage(old, rec.recorded(), screen, 30)
#endif
    profile.render = elapsed(started)
#if !feature_dsi
    gpio.out = (gpio.out & ~32u32) | (if touch_enabled then 32 else 0)
#endif
    var next = next_band(mask, 30, screen, 0)
    while next.is_some()
        val band = next.unwrap()
        started = ticks()
        replay(rec.recorded(), painter, band.rect)
        profile.render += elapsed(started)
        started = ticks()
        flush(gpio, first, band.rect)
        profile.flush += elapsed(started)
        next = next_band(mask, 30, screen, band.next)
    frames += 1
    rec.n

@export("start")
start() -> never
#if !feature_h7_cores
    initialize_memory()
#endif
    val cpacr: *Word = ptr_cast(usize(0xE000ED88))
    cpacr.value = 0x00F00000 // Enable CP10/CP11 before using the core FPU.
    asm
        [thumb]
            "dsb"
            "isb"
            clobbers "memory"
        [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"
#if feature_dsi
    val gpio: *Gpio = ptr_cast(usize(0)) // Unused by the DSI transport.
    val bus: *I2c = ptr_cast(usize(0)) // FT6206 uses real I2C4 registers below.
    dsi_initialize()
    word(i2c4.BASE + i2c4.TIMINGR_OFFSET).value = 0x10c0ecff
    word(i2c4.BASE + i2c4.CR1_OFFSET).value = i2c4.CR1_PE_MASK
#else
    val gpio: *Gpio = ptr_cast(usize(0x50000000))
    val bus: *I2c = ptr_cast(usize(0x50000300))
    gpio.out = 4
    gpio.oe = 63
#if !feature_gpio_spi
    val serial = spi_bus()
    serial.cr1 = 0
    serial.cr0 = 7 // Motorola mode 0, 8-bit words.
#if feature_h7_cores
    serial.prescale = 16 // 30 MHz from the shared 480 MHz test timebase.
#else
    serial.prescale = 4 // 37.5 MHz at the board's 150 MHz clock.
#endif
    serial.mask = 0
    serial.cr1 = 2
#endif
    gpio.out = 4 | 16
    spi(gpio, 0x11, false) // Sleep out.
    spi(gpio, 0x3A, false)
    spi(gpio, 0x55, true) // RGB565.
    spi(gpio, 0x29, false) // Display on.
#endif
    val systick: *Gpio = ptr_cast(usize(0xE000E010))
    systick.input = 0xFFFFFF
    systick.oe = 0
    systick.out = 5
#if feature_storage
    storage_initialize()
#endif
#if feature_joystick
    joystick_demo(gpio)
#endif
    val surface = vg.for_data(pixels[..], 240, 240, 240 * 4).unwrap()
    val canvas = vg.canvas(surface).unwrap()
    val font = vg.font_from_data(embed("assets/ABeeZee-Regular.ttf")).unwrap()
    var painter = sh.sysl.imui.plutovg.painter(canvas, font, 14.0)
    var ui = sh.sysl.imui.ui()
    var input = no_input()
    var count = draw_frame(&ui, &painter, gpio, input, commands_a[..], [], true)
    var previous_a = true
#if feature_microphone
    var meter_at = ticks()
#endif
    loop
#if feature_storage
        storage_now()
#endif
        var redraw = false
#if feature_storage
        val previous_record_status = record_status.value
        val previous_play_status = play_status.value
        record_poll()
        play_poll()
        if previous_record_status != record_status.value || previous_play_status != play_status.value then redraw = true
#endif
#if feature_dsi
        poll_focal(input) match
#else
        poll_touch(bus, input) match
#endif
            Some(next) ->
                input = next
                redraw = true
            None -> ()
#if feature_microphone
        // M4 polls live telemetry at 60 Hz, independently of touch changes.
        // Damage replay redraws only the meter when everything else is idle.
        if elapsed(meter_at) >= 4000000
            meter_at = ticks()
            val level = audio_input_level.value
            if level != audio_meter_display
                audio_meter_display = level
                redraw = true
#if feature_delay
            val output = audio_output_level.value
            val cpu = (audio_dsp_peak_cycles.value * 100 + 1279999) / 1280000
            if output != delay.meter_output || cpu != delay.meter_cpu
                delay.meter_output = output
                delay.meter_cpu = cpu
                redraw = true
#endif
#endif
        if redraw
            if previous_a
                count = draw_frame(&ui, &painter, gpio, input, commands_b[..], commands_a[..<count], false)
            else
                count = draw_frame(&ui, &painter, gpio, input, commands_a[..], commands_b[..<count], false)
            previous_a = !previous_a
