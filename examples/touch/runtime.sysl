import sysl.raw.ptr_cast

// Newlib supplies the C allocator used by both sysl reference objects and PlutoVG.
// Its arena is bounded MCU RAM, not a host allocation or an emulation shortcut.
var heap: [16384]u64
@export("touch_heap_used")
var heap_break: usize = 0

@export("_sbrk")
heap_grow(increment: int) -> *u8
    val before = heap_break
    val next = long(before) + long(increment)
    if next < 0 || next > 131072 then return ptr_cast(usize(0xFFFFFFFFu32))
    heap_break = usize(next)
    ptr_cast(usize(&heap[0]) + before)

@export("__assert_func")
c_assert(file: *u8, line: int, function: *u8, expression: *u8) -> never
    loop
        asm
            [thumb] "bkpt #0"
            [aarch64, x86_64, riscv64, riscv32, wasm32, craft] unavailable "Cortex-M firmware"

// This firmware has no file descriptors or process environment. Newlib's
// optional diagnostic paths fail explicitly rather than accessing the host.
@export("_write")
c_write(fd: int, bytes: *u8, length: int) -> int = -1
@export("_read")
c_read(fd: int, bytes: *u8, length: int) -> int = -1
@export("_close")
c_close(fd: int) -> int = -1
@export("_lseek")
c_seek(fd: int, offset: int, origin: int) -> int = -1
@export("_fstat")
c_stat(fd: int, info: *u8) -> int = -1
@export("_isatty")
c_isatty(fd: int) -> int = 0
@export("_kill")
c_kill(pid: int, signal: int) -> int = -1
@export("_getpid")
c_pid() -> int = 1
@export("_exit")
c_exit(status: int) -> never = c_assert(null, status, null, null)
