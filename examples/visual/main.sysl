import sysl.raw.ptr_cast

import firmware.*

// Static Cortex-M reset vectors, placed by the linker at address zero.
@export("vectors")
@section(".rodata.vectors")
val vectors = vector_table[32](&__stack_top, &start)

@assert(sizeof(VectorTable[32]) == 192, "48 vector words")

struct Gpio
    out: volatile u32
    input: volatile u32
    oe: volatile u32

struct Adc
    ctrl: volatile u32
    channel: volatile u32
    status: volatile u32
    result: volatile u32

struct Pwm
    ctrl: volatile u32
    period: volatile u32
    high: volatile u32

// This is the virtual MCU's I2C adapter. Device transactions use the ordinary DS3231 protocol.
struct I2c
    address: volatile u32
    data: volatile u32
    command: volatile u32
    status: volatile u32

rtc_begin(bus: *I2c, pointer: u32) -> bool
    bus.address = 0x68
    bus.command = 1
    if (bus.status & 2) != 0 then return false
    bus.data = pointer
    bus.command = 4
    (bus.status & 2) == 0

rtc_clock(bus: *I2c) -> Option[[3]u8]
    if !rtc_begin(bus, 0)
        bus.command = 8
        return None
    bus.command = 3 // Repeated START with read address: the RTC snapshots time here.
    var time: [3]u8 = [0; 3]
    for i in 0..<3
        bus.command = 2
        if (bus.status & 2) != 0
            bus.command = 8
            return None
        time[i] = u8(bus.data)
    bus.command = 8
    Some(time)

// A demonstration setting, sent by firmware just as a hardware driver would send it.
rtc_set_example(bus: *I2c)
    if !rtc_begin(bus, 0)
        bus.command = 8
        return
    val date: [7]u8 = [0x56,0x34,0x12,4,1,1,0x26] // 2026-01-01 12:34:56, weekday numbering chosen by firmware.
    for byte in date
        bus.data = u32(byte)
        bus.command = 4
    bus.command = 8
    if rtc_begin(bus, 15)
        bus.data = 8 // Clear OSF/alarm flags; retain the 32kHz enable setting.
        bus.command = 4
    bus.command = 8

// Conventional a,b,c,d,e,f,g segment bits, compatible with a common-cathode display.
segments(digit: u32) -> u32 = digit match
    0 -> 0x3F
    1 -> 0x06
    2 -> 0x5B
    3 -> 0x4F
    4 -> 0x66
    5 -> 0x6D
    6 -> 0x7D
    7 -> 0x07
    8 -> 0x7F
    9 -> 0x6F
    _ -> 0

// HD44780 write bus: RS=GP3, E=GP4, RW tied low, D4..D7=GP22..GP25.
const LCD_MASK: u32 = (3 << 3) | (15 << 22)

struct LcdTask
    stage: u32
    wait: u32
    character: usize
    clock: [12]u8
    last_time: u32

lcd_nibble(gpio: *Gpio, value: u32, data: bool)
    val pins = (gpio.out & ~LCD_MASK) | ((value & 15) << 22) | (if data then 1 << 3 else 0)
    gpio.out = pins
    // Volatile reads retain setup and enable-pulse spacing when optimized.
    for i in 0..<8 do val ignored = gpio.input
    gpio.out = pins | (1 << 4)
    for i in 0..<8 do val ignored = gpio.input
    gpio.out = pins

lcd_byte(gpio: *Gpio, value: u32, data: bool)
    lcd_nibble(gpio, value >> 4, data)
    lcd_nibble(gpio, value, data)

// Cooperative delays leave ADC sampling, digit scanning and buttons running.
// On a hardware port, calibrate these loop delays for that MCU's clock or use its timer.
lcd_tick(gpio: *Gpio, task: *LcdTask, bus: *I2c)
    if task.wait > 0
        task.wait -= 1
        return
    val stage = task.stage
    task.stage += 1
    task.wait = 100
    stage match
        0 ->
            lcd_nibble(gpio, 3, false)
            task.wait = 1000
        1 | 2 -> lcd_nibble(gpio, 3, false)
        3 -> lcd_nibble(gpio, 2, false)
        4 -> lcd_byte(gpio, 0x28, false) // Four bits, two lines, 5x8 font.
        5 -> lcd_byte(gpio, 0x08, false) // Display off while clearing.
        6 ->
            lcd_byte(gpio, 0x01, false)
            task.wait = 1000
        7 -> lcd_byte(gpio, 0x06, false) // Increment address, no display shift.
        8 -> lcd_byte(gpio, 0x0C, false) // Display on, cursor off.
        9 -> lcd_byte(gpio, 0x80, false) // First character of first row.
        10 ->
            val message = "Hello from Benchtop!".bytes
            lcd_byte(gpio, u32(message[task.character]), true)
            task.character += 1
            if task.character < message.len then task.stage = 10
        11 ->
            task.stage = 11
            task.wait = 1000
            val time = rtc_clock(bus) match
                Some(value) -> value
                None -> return
            val packed = u32(time[0]) | (u32(time[1]) << 8) | (u32(time[2]) << 16)
            if packed == task.last_time then return
            task.last_time = packed
            var hour = u32(time[2] & 63)
            if (time[2] & 64) != 0
                var n = u32((time[2] & 16) >> 4) * 10 + u32(time[2] & 15)
                if n == 12 then n = 0
                if (time[2] & 32) != 0 then n += 12
                hour = if n >= 20 then 0x20 + n - 20 elif n >= 10 then 0x10 + n - 10 else n
            task.clock = [82,84,67,32,u8(48 + (hour >> 4)),u8(48 + (hour & 15)),58,
                u8(48 + (u32(time[1]) >> 4)),u8(48 + (u32(time[1]) & 15)),58,
                u8(48 + (u32(time[0]) >> 4)),u8(48 + (u32(time[0]) & 15))]
            task.character = 0
            task.wait = 0
            task.stage = 12
        12 -> lcd_byte(gpio, 0xC0, false)
        13 ->
            lcd_byte(gpio, u32(task.clock[task.character]), true)
            task.character += 1
            task.stage = if task.character == task.clock.len then 11 else 13
        _ -> ()

// SSD1306 four-wire SPI: SCK=GP6, MOSI=GP7, CS=GP27, DC=GP28, RESET=GP29.
const OLED_MASK: u32 = (3 << 6) | (7 << 27)

struct OledTask
    stage: u32
    wait: u32
    index: usize
    reading: u32

// Both serial displays share mode-0 clock/data; each byte selects exactly one device.
spi_byte(gpio: *Gpio, byte: u32, data: bool, cs: u32, dc: u32)
    val base = (gpio.out & ~((3u32 << 6) | cs | dc)) | (if data then dc else 0)
    gpio.out = base
    for bit in 0..<8
        val pins = base | (if (byte & (128u32 >> bit)) != 0 then 1 << 7 else 0)
        gpio.out = pins
        gpio.out = pins | (1 << 6)
        gpio.out = pins
    gpio.out = base | cs

oled_byte(gpio: *Gpio, byte: u32, data: bool) = spi_byte(gpio, byte, data, 1u32 << 27, 1u32 << 28)

// A framebuffer byte in SSD1306 page layout, generated entirely by guest software.
oled_pixels(index: usize, reading: u32) -> u32
    val page = u32(index >> 7)
    val x = u32(index & 127)
    if page == 1 && x >= 52 && x < 76
        val title: [24]u8 = [127,8,20,34,65,0,127,4,8,16,127,0,62,65,65,65,62,0,127,73,73,73,54,0]
        return u32(title[usize(x - 52)]) // KNOB
    val length = (reading * 112 + 2048) >> 12
    var byte: u32 = 0
    for bit in 0..<8
        val y = page * 8 + u32(bit)
        val outline = ((x == 4 || x == 123) && y >= 25 && y <= 50) || ((y == 25 || y == 50) && x >= 4 && x <= 123)
        val fill = y >= 29 && y <= 46 && x >= 8 && x < 8 + length
        val ticks = y >= 54 && y <= 57 && (x == 8 || x == 36 || x == 64 || x == 92 || x == 119)
        if outline || fill || ticks then byte |= 1u32 << bit
    byte

oled_tick(gpio: *Gpio, task: *OledTask, reading: u32)
    if task.wait > 0
        task.wait -= 1
        return
    task.stage match
        0 ->
            gpio.out = gpio.out | (1 << 29) | (1 << 27)
            task.stage = 1
            task.wait = 16
        1 ->
            val setup: [25]u8 = [0xAE,0xD5,0x80,0xA8,0x3F,0xD3,0,0x40,0x8D,0x14,0x20,0,0xA0,0xC0,0xDA,0x12,0x81,0xCF,0xD9,0xF1,0xDB,0x40,0xA4,0xA6,0xAF]
            oled_byte(gpio, u32(setup[task.index]), false)
            task.index += 1
            if task.index == setup.len
                task.index = 0
                task.stage = 2
        2 ->
            val window: [6]u8 = [0x21,0,127,0x22,0,7]
            oled_byte(gpio, u32(window[task.index]), false)
            task.index += 1
            if task.index == window.len
                task.index = 0
                task.reading = reading
                task.stage = 3
        3 ->
            oled_byte(gpio, oled_pixels(task.index, task.reading), true)
            task.index += 1
            if task.index == 1024 then task.stage = 4
        _ -> if reading != task.reading
            task.index = 0
            task.stage = 2

// ST7789 shares SCK/MOSI/RESET with the OLED, with CS=GP30 and DC=GP31.
const TFT_MASK: u32 = (1u32 << 30) | (1u32 << 31)

struct TftTask
    stage: u32
    wait: u32
    index: usize
    x: u32
    y: u32
    reading: u32
    partial: bool

tft_byte(gpio: *Gpio, byte: u32, data: bool) = spi_byte(gpio, byte, data, 1u32 << 30, 1u32 << 31)

// RGB565: the host only sees these bytes through the controller's RAM-write command.
tft_color(x: u32, y: u32, reading: u32) -> u32
    if x == 7 || x == 232 || y == 7 || y == 232 then return 0x39E7
    if x >= 24 && x < 216 && y >= 26 && y < 54
        val logo: [48]u8 = [127,73,73,73,54,0,127,73,73,73,65,0,127,4,8,16,127,0,62,65,65,65,34,0,
            127,8,8,8,127,0,1,1,127,1,1,0,62,65,65,65,62,0,127,9,9,9,6,0]
        if (u32(logo[usize((x - 24) >> 2)]) & (1u32 << ((y - 26) >> 2))) != 0 then return 0x7FF6
    if y >= 78 && y <= 109 && x >= 16 && x <= 223
        return if x < 51 then 0xF800 elif x < 86 then 0xFFE0 elif x < 121 then 0x07E0 elif x < 156 then 0x07FF elif x < 191 then 0x001F else 0xF81F
    val length = (reading * 200 + 2048) >> 12
    if ((x == 16 || x == 223) && y >= 145 && y <= 177) || ((y == 145 || y == 177) && x >= 16 && x <= 223) then return 0xFFFF
    if y >= 149 && y <= 173 && x >= 20 && x < 20 + length
        return if x < 86 then 0xF800 elif x < 154 then 0xFFE0 else 0x07E0
    if y >= 198 && y <= 215 && x >= 16 + length && x < 24 + length then return 0x07FF
    if y >= 206 && y <= 208 && x >= 20 && x <= 219 then return 0x39E7
    0x0843

tft_tick(gpio: *Gpio, task: *TftTask, reading: u32)
    if task.wait > 0
        task.wait -= 1
        return
    task.stage match
        0 ->
            tft_byte(gpio, 0x01, false)
            task.wait = 1600
            task.stage = 1
        1 ->
            tft_byte(gpio, 0x11, false) // Sleep out, with cooperative delay before display setup.
            task.wait = 16000
            task.stage = 2
        2 ->
            val setup: [6]u16 = [0x3A,0x155,0x36,0x100,0x20,0x29]
            val item = u32(setup[task.index])
            tft_byte(gpio, item & 255, (item & 256) != 0)
            task.index += 1
            if task.index == setup.len
                task.index = 0
                task.stage = 3
        3 ->
            // Refresh only the gauge region after the first complete frame.
            val left: u32 = if task.partial then 16 else 0
            val right: u32 = if task.partial then 223 else 239
            val top: u32 = if task.partial then 145 else 0
            val bottom: u32 = if task.partial then 215 else 239
            val window: [11]u32 = [0x2A,0x100,0x100 | left,0x100,0x100 | right,0x2B,0x100,0x100 | top,0x100,0x100 | bottom,0x2C]
            val item = window[task.index]
            tft_byte(gpio, item & 255, (item & 256) != 0)
            task.index += 1
            if task.index == window.len
                task.index = 0
                task.x = left
                task.y = top
                task.reading = reading
                task.stage = 4
        4 ->
            // Small batches keep the other parts serviced throughout a full-screen update.
            for pixel in 0..<4
                val color = tft_color(task.x, task.y, task.reading)
                tft_byte(gpio, color >> 8, true)
                tft_byte(gpio, color & 255, true)
                task.x += 1
                if task.x > (if task.partial then 223 else 239)
                    task.x = if task.partial then 16 else 0
                    task.y += 1
                    if task.y > (if task.partial then 215 else 239)
                        task.stage = 5
                        return
        _ -> if reading != task.reading
            task.partial = true
            task.index = 0
            task.stage = 3

@export("start")
start() -> never
    initialize_memory()
    val gpio: *Gpio = ptr_cast(usize(0x50000000))
    val adc: *Adc = ptr_cast(usize(0x50000100))
    val pwm: *Pwm = ptr_cast(usize(0x50000200))
    val i2c: *I2c = ptr_cast(usize(0x50000300))
    var set_time_held = false
    var sound_period: u32 = 0
    var sound_enabled = false
    // Cathode commons are active low. Set them inactive before enabling output drivers.
    val commons_off: u32 = 0xF << 18
    gpio.out = commons_off | (1u32 << 27) | (1u32 << 30)
    gpio.oe = 7 | (0xFFF << 10) | LCD_MASK | OLED_MASK | TFT_MASK
    var lcd_task = LcdTask(0, 2000, 0, [32; 12], 0xFFFFFFFF)
    var oled_task = OledTask(0, 16, 0, 0)
    var tft_task = TftTask(0, 32, 0, 0, 0, 0, false)
    var count: u32 = 0
    var heartbeat: u32 = 0
    var previous: u32 = 0xFFFFFFFF
    var thousands: u32 = 0
    var hundreds: u32 = 0
    var tens: u32 = 0
    var units: u32 = 0
    var scan: u32 = 0
    adc.channel = 0
    loop
        count += 1
        if count == 8000
            count = 0
            heartbeat ^= 1
        val leds = heartbeat | (((~gpio.input >> 8) & 3) << 1)
        adc.ctrl = 3 // Enable and start. Input is latched here by the peripheral.
        while (adc.status & 1) != 0 do ()
        val reading = adc.result
        val period = 3000 + ((4095 - reading) << 2)
        if period != sound_period
            pwm.period = period
            pwm.high = period >> 1
            sound_period = period
        val enabled = (gpio.input & (1 << 8)) == 0
        if enabled != sound_enabled
            pwm.ctrl = if enabled then 1 else 0
            sound_enabled = enabled
        val set_time = (gpio.input & (1 << 9)) == 0
        if set_time && !set_time_held then rtc_set_example(i2c)
        set_time_held = set_time
        if reading != previous
            var remaining = reading
            thousands = 0
            while remaining >= 1000
                remaining -= 1000
                thousands += 1
            hundreds = 0
            while remaining >= 100
                remaining -= 100
                hundreds += 1
            tens = 0
            while remaining >= 10
                remaining -= 10
                tens += 1
            units = remaining
            previous = reading
        val numeral = if scan == 0 then thousands elif scan == 1 then hundreds elif scan == 2 then tens else units
        val pattern = segments(numeral) << 10
        lcd_tick(gpio, &lcd_task, i2c)
        oled_tick(gpio, &oled_task, reading)
        tft_tick(gpio, &tft_task, reading)
        val display_lines = gpio.out & (LCD_MASK | OLED_MASK | TFT_MASK)
        // Blank every common before changing shared segment lines, then select one digit.
        gpio.out = display_lines | leds | commons_off
        gpio.out = display_lines | leds | commons_off | pattern
        gpio.out = display_lines | leds | (commons_off & ~(1u32 << (18 + scan))) | pattern
        scan += 1
        if scan == 4 then scan = 0
