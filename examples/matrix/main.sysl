import sysl.raw.ptr_cast

extern __stack_top: u8

// Linker-provided load and runtime addresses; startup runs before using any globals.
extern __data_start: u8
extern __data_end: u8
extern __data_load: u8
extern __bss_start: u8
extern __bss_end: u8

struct StartupByte
    value: volatile u8

initialize_memory()
    val source: *StartupByte = ptr_cast(usize(&__data_load))
    val data: *StartupByte = ptr_cast(usize(&__data_start))
    val zero: *StartupByte = ptr_cast(usize(&__bss_start))
    for i in 0..<(usize(&__data_end) - usize(&__data_start)) do data[i].value = source[i].value
    for i in 0..<(usize(&__bss_end) - usize(&__bss_start)) do zero[i].value = 0


struct Vectors
    stack: *u8
    reset: *extern() -> never
    reserved: [46]u32

@export("vectors")
@section(".rodata.vectors")
val vectors: Vectors = Vectors(&__stack_top, &start, [0; 46])

struct Gpio
    out: volatile u32
    input: volatile u32
    oe: volatile u32

@export("matrix_heart")
var heart: [5]u32 = [10, 31, 31, 14, 4]
@export("matrix_boot_count")
var boot_count: u32 = 0

// Rows GP0..4 source current; columns GP5..9 sink it, as on micro:bit V2.
// Blank all rows before changing columns to avoid ghosting.
@export("start")
start() -> never
    initialize_memory()
    val gpio: *Gpio = ptr_cast(usize(0x50000000))
    gpio.out = 31 << 5
    gpio.oe = 1023
    var frame: u32 = boot_count
    boot_count += 1
    loop
        val duty = 25 + ((frame >> 5) & 3) * 25
        for row in 0..<5
            gpio.out = 31 << 5
            val pattern = if (frame & 128) == 0 then heart[row] else (1u32 << u32(row))
            gpio.out = ((31 ^ pattern) << 5) | (1u32 << u32(row))
            var wait: u32 = 0
            while wait < 100
                // Volatile reads retain this simple refresh delay in optimized firmware.
                if wait == duty then gpio.out = 31 << 5
                val pins = gpio.input
                wait += 1 + (pins & 0)
        frame += 1
