// benchtop: a microcontroller board emulator.
//
//     benchtop run [--board <name | file.hocon>] [--window] [--deterministic] <image.elf | image.bin>
//         Boot the image on the board `--board` names, the virtual board `virt` where none is named,
//         its console on this terminal, a keystroke at a time. Ctrl-] ends benchtop whatever the
//         guest is doing. The exit status is the guest's, written to the console's EXIT register.
//         Each launched guest core runs on its own host thread. Use `--deterministic` for
//         reproducible core turns on one host thread.
//
//     benchtop check [--mcu] <name | file.hocon>
//         Read a chip, board or product description and hold it to the library: print every mistake,
//         with its line and column, and exit 1; or print what it is. A name is a board's, or with
//         `--mcu` a chip's.
//
//     A name with a `/` in it, or ending in `.hocon`, is a file; any other is a description built
//     into benchtop: the boards `virt`, `virt33`, `pico`, `pico2w`, `pico-breadboard-kit`, ..., and
//     the chips `virt`, `virt33`, `rp2040`, `rp2350`, ....
//
//     benchtop bench-board [--board <name | file.hocon>] <image.elf> [turns | threads]
//         Run an image on a runnable board, `virt` where none is named, to its exit, three rounds with
//         the cores taking turns on one thread and three with a thread each, and report the
//         instructions both cores retired and their speed together. Naming one way runs only that one.
//
//     benchtop realtime [--board <name | file.hocon>] [--seconds N] [--warmup N] [--unpaced] [--set <symbol>=<value>] <image.elf>
//         Run an image on the board's CPU workers as the desktop runs it, with no window, the board
//         `stm32h747-disco` where none is named, playing the desktop's part in its audio, touch and
//         display. After `--warmup` guest seconds (1), measure `--seconds` more (10) and report, per
//         core, guest time over host time (1.0 is real time), the guest MHz and MIPS it sustained,
//         how busy its worker was and so the MHz its worker could sustain; and the DSI worker's and
//         the display copy's share of host time. Exit 1 where a core falls below real time.
//         `--unpaced` runs as fast as the host can instead, for the headroom. `--set` writes a word
//         at an ELF symbol before the cores start, as a debugger would (the busy firmware's kernel).
//
//     benchtop bench [--core <core>] [--timing unit|estimated] <image.bin> [expected result] [match | threaded]
//         Run a raw image from address 0 on one core, an M0+ where none is named, under both
//         executors, three rounds each, and report each one's speed. Naming one executor runs only
//         that one, so a process-wide counter (`time -l`'s cycles and instructions) measures it alone.

import sh.sysl.benchtop.v6m.{cycles as memory_cycles,configure_instruction_timing,Cpu, Kind, Memory, Stop, memory, model_named, reset, run_match, run_threaded}
import sh.sysl.benchtop.virt.{Machine, board_named, boot, capture, core0, core1, described_error, image_of, listen, machine, open_console, output, run_board, set_threads, stop_message, type_in}
import sh.sysl.benchtop.{built_in_shelf, library, listing, load, open_chip, open_description, summary}
import sysl.raw.str_cast
import sh.sysl.parsing.Span
import sysl.fs.read_bytes
import sysl.text.{parse_int, parse_long, Search}
import sysl.time.monotonic
import sysl.tty.raw
import sh.sysl.benchtop.riscv as rv
import sh.sysl.benchtop.chip as chip
import sh.sysl.benchtop.ui as ui
import sh.sysl.benchtop.host as host
import sh.sysl.benchtop.realtime as rt

const QUANTUM: u64 = 1000000

// The core `benchtop bench` runs bare, on a memory of its own and with no board around it.
var cpu: Cpu
var riscv_ram: [1048576]u8
var riscv_records: [524289]rv.Insn
var riscv_lines: [16384]u8

usage()
    print("usage: benchtop demo [--headless] [--frames N] [--screenshot out.png]")
    print("       benchtop view <board | file.hocon> [--frames N] [--screenshot out.png]")
    print("       benchtop render <board | file.hocon> <out.png>")
    print("       benchtop run [--board <name | file.hocon>] [--window] [--deterministic] <image.elf | image.bin>")
    print("       run --window: [--watch] [--build <program>] [--build-arg <arg>] [--watch-source <file>] [--instruments <file.hocon>]")
    print("       benchtop check [--mcu] <name | file.hocon>")
    print("       benchtop bench [--core <core>] [--timing unit|estimated] <image.bin> [expected result] [match | threaded]")
    print("       benchtop bench-board [--board <name | file.hocon>] <image.elf> [turns | threads]")
    print("       benchtop realtime [--board <name | file.hocon>] [--seconds N] [--warmup N] [--unpaced] [--set <symbol>=<value>] <image.elf>")
    exit(2)

die(why: string) -> never
    eprints(s"benchtop: $why\n")
    exit(1)

read_or_die(file: string) -> []u8 = read_bytes(file) match
    Ok(b) -> b
    Err(e) -> die(s"cannot read $file: $e")

main(args: []string)
    if args.len >= 2 && (args[1] == "demo" || args[1] == "view" || args[1] == "render")
        ui.command(args) match
            Ok(code) -> exit(code)
            Err(why) -> die(why)
    if args.len < 3 then usage()

    args[1] match
        "run" -> run_command(args)
        "bench" -> bench(args)
        "bench-board" -> bench_board(args)
        "realtime" -> realtime_command(args)
        "check" ->
            if args[2] == "--mcu" then
                if args.len < 4 then usage()

                check_description(args[3], true)
            else
                check_description(args[2], false)
        _ -> usage()

// ---------------------------------------------------------------------------------------------------
// check

check_description(which: string, chip: bool)
    val opened = if chip then open_chip(built_in_shelf(), which, "", Span(0, 0)) else open_description(built_in_shelf(), which, "", Span(0, 0))
    val src = opened match
        Ok(s) -> s
        Err(d) ->
            eprints(described_error(d))
            exit(1)

    val reg = library()
    val got = load(src, reg)

    if got.report.has_errors() then
        eprints(got.report.render(src))
        exit(1)

    prints(summary(got.description, reg))

// ---------------------------------------------------------------------------------------------------
// run

// `benchtop run`'s options, then the image.
run_command(args: []string)
    var which = "virt"
    var parallel = true
    var window = false
    var headless = false
    var frames: u64 = 0
    var screenshot = ""
    var develop = host.config()
    var instrument_file = ""
    var i = 2

    while i < args.len - 1
        args[i] match
            "--watch" ->
                develop.watch = true
                i += 1
            "--build" | "--build-arg" | "--watch-source" ->
                if i + 1 >= args.len - 1 then usage()
                if args[i] == "--build" then develop.program = args[i + 1]
                elif args[i] == "--build-arg" then develop.args.push(args[i + 1])
                else develop.sources.push(args[i + 1])
                i += 2
            "--instruments" ->
                if i + 1 >= args.len - 1 then usage()
                instrument_file = args[i + 1]
                i += 2
            "--window" ->
                window = true
                i += 1
            "--headless" ->
                headless = true
                i += 1
            "--frames" | "--screenshot" ->
                if i + 1 >= args.len - 1 then usage()
                if args[i] == "--frames"
                    frames = ui.frame_count(args[i + 1]) match
                        Ok(n) -> n
                        Err(why) -> die(why)
                else screenshot = args[i + 1]
                i += 2
            "--board" ->
                if i + 1 >= args.len - 1 then usage()
                which = args[i + 1]
                i += 2
            "--deterministic" ->
                parallel = false
                i += 1
            "--threads" ->
                parallel = true
                i += 1
            _ -> usage()

    if i != args.len - 1 then usage()

    if window
        ui.launch(which, args[i], ui.launch_options(frames = frames, screenshot = screenshot, headless = headless, develop = develop, instrument_file = instrument_file, deterministic = !parallel)) match
            Ok(code) -> exit(code)
            Err(why) -> die(why)
    if !instrument_file.is_empty() then die("--instruments requires --window")
    if host.enabled(develop) then die("--watch, --build and --watch-source require --window")
    if headless || frames != 0 || !screenshot.is_empty() then die("--headless, --frames and --screenshot require --window")
    run(which, args[i], parallel)

// Run `file` on the board `which` names, each core on a thread of its own where `parallel` says so.
// A board of RISC-V cores runs on the RP2350 chip layer, both harts on this thread.
run(which: string, file: string, parallel: bool)
    chip.riscv_named(which) match
        Some(Ok(map)) -> run_riscv(map, file)
        Some(Err(why)) ->
            eprints(why)
            exit(1)
        None -> ()
    chip.arm_named(which) match
        Some(Ok(map)) -> run_arm(map, file)
        Some(Err(why)) ->
            eprints(why)
            exit(1)
        None -> ()
    val board = machine()
    val m = &*board
    board_named(m, which) match
        Ok(_) -> ()
        Err(why) ->
            eprints(why)
            exit(1)

    val image = image_of(m, read_or_die(file)) match
        Ok(b) -> b
        Err(why) -> die(s"$file: $why")

    open_console(m)
    boot(m, image.view())
    if parallel then set_threads(m)
    raw()

    if !listen(m) then die("cannot start the console's input thread")

    val core = run_board(m)

    core.stop match
        Exit -> exit(int(core.exit_code))
        Running -> ()
        Breakpoint | Reset -> eprints(s"\r\nbenchtop: ${stop_message(core)}\r\n")
        _ ->
            eprints(s"\r\nbenchtop: ${stop_message(core)}\r\n")
            exit(3)

// Write the guest's console text from index `shown` on to stdout and flush it, so it reaches a pipe
// or file as promptly as a terminal. Until `last`, only up to the final newline goes out: a line is
// the unit, and the unfinished one waits for its end. Returns how much of `text` has been written.
show_console(text: []u8, shown: usize, last: bool) -> usize
    var upto = text.len
    if !last
        upto = shown
        for i in shown..<text.len do if text[i] == 10 then upto = i + 1
    if upto > shown
        putbytes(text[shown..<upto])
        flush()
    upto

// Run the ELF `file` on an RP2350's Hazard3 cores with `map`'s SRAM, UART0 on stdout, until a hart
// EBREAKs (exit 0), faults (exit 3) or both sleep with nothing to wake them (exit 4).
run_riscv(map: chip.SramMap, file: string) -> never
    val b = chip.riscv_board(map)
    b.boot(read_or_die(file)) match
        Ok(_) -> ()
        Err(why) -> die(s"$file: $why")
    var shown: usize = 0
    loop
        val end = b.run(QUANTUM)
        shown = show_console(b.console.view(), shown, end != chip.RunEnd.Budget)
        end match
            Budget -> ()
            Breakpoint -> exit(0)
            Fault -> die(if b.refused.is_empty() then "a hart stopped on a fault" else b.refused)
            Asleep ->
                eprints("benchtop: both harts sleep, and nothing on the chip will wake them\n")
                exit(4)

// Run the ELF `file` on an RP2350's Cortex-M33 cores with `map`'s SRAM, UART0 on stdout, until a core
// executes BKPT (exit 0), faults (exit 3) or both sleep with nothing to wake them (exit 4).
run_arm(map: chip.SramMap, file: string) -> never
    val b = chip.arm_board(map)
    b.boot(read_or_die(file)) match
        Ok(_) -> ()
        Err(why) -> die(s"$file: $why")
    var shown: usize = 0
    loop
        val end = b.run(QUANTUM)
        shown = show_console(b.console.view(), shown, end != chip.RunEnd.Budget)
        end match
            Budget -> ()
            Breakpoint -> exit(0)
            Fault -> die(if b.refused.is_empty() then s"a core stopped: ${arm_stop(&*b)}" else b.refused)
            Asleep ->
                eprints("benchtop: both cores sleep, and nothing on the chip will wake them\n")
                exit(4)

// How the core that stopped an Arm RP2350 run stopped, as `stop_message` says it.
arm_stop(b: *chip.ArmBoard) -> string
    for k in 0..<2 do if b.cores[k].stop != Stop.Running then return s"core $k: ${stop_message(&b.cores[k])}"
    "no core stopped"

// ---------------------------------------------------------------------------------------------------
// bench

// Run the guest to its breakpoint with `exec` on a core of `kind` over `mem`, and answer the
// microseconds it took.
measure(mem: &sync Memory, image: []u8, kind: Kind, exec: *extern(*Cpu) -> unit, estimated: bool = false) -> long
    cpu.kind = kind
    reset(&cpu, mem, image, 0)
    configure_instruction_timing(&cpu,estimated)

    val start = monotonic()

    while cpu.stop == Stop.Running
        cpu.limit = memory_cycles(&cpu) + QUANTUM
        exec(&cpu)

    (monotonic() - start).us

report(name: string, us: long, expected: u32) -> bool
    val mips = real(cpu.retired) / real(us)
    val ok = cpu.stop == Stop.Breakpoint && cpu.r[0] == expected

    print(s"$name: ${cpu.retired} instructions in $us us, $mips MIPS, ${memory_cycles(&cpu)} cycles, r0 = ${cpu.r[0]}, ${cpu.stop}")

    if !ok then print(s"  FAILED: expected r0 = $expected at a breakpoint, stopped at ${cpu.stop_at}")

    ok

bench(args: []string)
    var kind = Kind.V6m
    var at = 2

    if args[2] == "--core"
        if args.len < 5 then usage()
        rv.model_named(args[3]) match
            Some(model) ->
                bench_riscv(args, model)
                return
            None -> ()
        kind = model_named(args[3]) match
            Some(m) -> m.kind
            None -> die(s"`${args[3]}` is no core benchtop has: ${listing(library().core_names())}")
        at = 4

    var estimated = false
    if args[at] == "--timing"
        if args.len <= at + 2 then usage()
        if args[at + 1] != "unit" && args[at + 1] != "estimated" then die("timing must be unit or estimated")
        estimated = args[at + 1] == "estimated"
        at += 2

    val image = read_or_die(args[at])
    val expected: u32 = if args.len > at + 1 then u32(parse_int(args[at + 1]).unwrap_or(0)) else 0
    val only = if args.len > at + 2 then args[at + 2] else ""
    val mem = memory()
    var good = true

    for round in 0..<3
        if only != "threaded"
            good = report("match   ", measure(mem, image, kind, &run_match, estimated), expected) && good
        if only != "match"
            good = report("threaded", measure(mem, image, kind, &run_threaded, estimated), expected) && good

    if !good then exit(1)

// Run `image` on the virtual board to its exit, the cores on threads of their own where `parallel`
// says so, and report both cores' instructions and their speed together. Answers whether the guest
// exited 0.
board_round(m: *Machine, name: string, image: []const u8, parallel: bool) -> bool
    open_console(m)
    capture(m)
    type_in(m, [])
    val first = core0(m)
    boot(m, image)
    if parallel then set_threads(m)

    val start = monotonic()
    val stopped = run_board(m)
    val us = (monotonic() - start).us
    val both = first.retired + core1(m).retired
    val mips = real(both) / real(us)
    val ok = stopped.stop == Stop.Exit && stopped.exit_code == 0

    print(s"$name: ${first.retired} + ${core1(m).retired} instructions in $us us, $mips MIPS, ${stopped.stop} ${stopped.exit_code}")

    if !ok then print(s"  FAILED: ${stop_message(stopped)}\n  ${str_cast(output(m).view())}")

    ok

bench_board(args: []string)
    var which = "virt"
    var at = 2

    if args[2] == "--board"
        if args.len < 5 then usage()
        which = args[3]
        at = 4

    val board = machine()
    val m = &*board
    board_named(m, which) match
        Ok(_) -> ()
        Err(why) -> die(why)

    val image = image_of(m, read_or_die(args[at])) match
        Ok(b) -> b
        Err(why) -> die(s"${args[at]}: $why")

    val only = if args.len > at + 1 then args[at + 1] else ""
    var good = true

    for round in 0..<3
        if only != "threads" then good = board_round(m, "turns  ", image.view(), false) && good
        if only != "turns" then good = board_round(m, "threads", image.view(), true) && good

    if !good then exit(1)

// ---------------------------------------------------------------------------------------------------
// realtime

// `benchtop realtime`'s options, then the image; one run, reported per core and per host thread.
realtime_command(args: []string)
    var which = "stm32h747-disco"
    var o = rt.options()
    var i = 2
    while i < args.len - 1
        args[i] match
            "--board" | "--seconds" | "--warmup" ->
                if i + 1 >= args.len - 1 then usage()
                val value = args[i + 1]
                if args[i] == "--board" then which = value
                else
                    val n = parse_long(value) match
                        Ok(n) if n >= 0 && n <= 3600 -> u64(n)
                        _ -> die(s"${args[i]} needs a whole number of seconds up to 3600")
                    if args[i] == "--seconds" then o.seconds = n else o.warmup = n
                i += 2
            "--unpaced" ->
                o.paced = false
                i += 1
            "--set" ->
                if i + 1 >= args.len - 1 then usage()
                val setting = args[i + 1]
                val equals = setting.index_of("=") match
                    Some(at) if at > 0 -> at
                    _ -> die("--set needs <symbol>=<value>")
                val value = parse_long(setting[equals + 1..]) match
                    Ok(n) if n >= 0 && n <= 0xffffffff -> u32(n)
                    _ -> die("--set needs a value from 0 to 4294967295")
                o.poke = Some(rt.Poke(setting[..<equals], value))
                i += 2
            _ -> usage()
    if i != args.len - 1 then usage()
    val board = machine()
    val r = rt.run(&*board, which, read_or_die(args[i]), o) match
        Ok(r) -> r
        Err(why) -> die(s"${args[i]}: $why")
    val wall = real(r.wall_us) / 1000000.0
    val share = (us: u64) -> 100.0 * real(us) / real(r.wall_us)
    print(f"realtime: $which ${args[i]}, ${if r.paced then "paced" else "unpaced"}, ${wall}%.3f s of host time")
    var real_time = true
    for k in 0..<2
        if k == 1 && !r.launched
            print("  core 1: not launched")
            continue
        val c = r.cores[k]
        val mhz = r.mhz(k)
        val rated = real(r.hz / r.divisors[k]) / 1000000.0
        print(f"  core $k: ${r.speed(k)}%.3f x real time (${mhz}%.1f of ${rated}%.0f MHz), ${real(c.retired) / real(r.wall_us)}%.1f MIPS, worker busy ${100.0 * r.busy(k)}%.1f % (could sustain ${r.capacity_mhz(k)}%.0f MHz), late ${c.late_us} us")
        if r.speed(k) < 0.99 then real_time = false
    print(f"  dsi worker: ${r.dsi_packets} packets, busy ${share(r.dsi_busy_us)}%.1f %")
    print(f"  audio: ${real(r.sound_frames) / wall}%.0f frames/s out over ${r.channels} channel(s), ${real(r.mic_frames) / wall}%.0f frames/s into the microphone")
    print(f"  display: ${r.display_reads} copies out, busy ${share(r.display_read_us)}%.1f %")
    print(f"  process: ${real(r.process_cpu_us) / real(r.wall_us)}%.2f host cores busy")
    print(if real_time then "  REAL TIME" else "  BELOW REAL TIME")
    if !real_time then exit(1)

// RISC-V profiles share one core. This raw-image bench starts at zero and checks a0 at EBREAK,
// through the decode cache, or with `interpret` after the expected value, through the reference
// interpreter. It deliberately does not pretend to boot an RP2350 or use ARM reset vectors.
bench_riscv(args: []string, model: rv.Model)
    if !rv.implemented(model) then die(s"not all extensions of `${model.name}` are emulated yet (${model.isa})")
    if args.len > 7 || (args.len == 7 && args[6] != "interpret") then die("the RISC-V executor is threaded, or `interpret` after the expected value")
    val threaded = args.len < 7
    val image = read_or_die(args[4])
    if image.len > riscv_ram.len then die("larger than the bench's 1 MB of RAM")
    val expected: u32 = if args.len > 5 then expected_u32(args[5]) else 0
    var core: rv.Cpu
    var good = true
    for round in 0..<3
        for i in 0..<riscv_ram.len do riscv_ram[i] = 0
        for i in 0..<image.len do riscv_ram[i] = image[i]
        rv.reset(&core, model, rv.BARE, riscv_ram, 0, 0)
        if threaded && core.dec == null then assert(rv.use_code_cache(&core, riscv_records, riscv_lines))
        core.halt_breakpoint = true
        core.halt_faults = true
        val start = monotonic()
        while core.stop == rv.Stop.Budget
            if threaded then rv.run_threaded(&core, QUANTUM) else rv.run(&core, QUANTUM)
        val us = (monotonic() - start).us
        val mips = if us == 0 then 0.0 else real(core.retired) / real(us)
        print(s"${model.name}: ${core.retired} instructions in $us us, $mips MIPS, a0 = ${core.r[10]}, ${core.stop}")
        if core.stop != rv.Stop.Breakpoint || core.r[10] != expected
            print(s"  FAILED: expected a0 = $expected at EBREAK; pc = ${core.pc}, address = ${core.stop_at}")
            good = false
    if !good then exit(1)

expected_u32(text: string) -> u32
    val value = parse_long(text) match
        Ok(n) -> n
        Err(_) -> die(s"expected register value is not an integer: $text")
    if value < -2147483648 || value > 4294967295 then die(s"expected register value is outside 32 bits: $text")
    u32(value)
