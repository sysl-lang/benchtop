// cortical: a Cortex-M board emulator.
//
//     cortical run [--board <name | file.hocon>] [--threads] <image.elf | image.bin>
//         Boot the image on the board `--board` names, the virtual board `virt` where none is named,
//         its console on this terminal, a keystroke at a time. Ctrl-] ends cortical whatever the
//         guest is doing. The exit status is the guest's, written to the console's EXIT register.
//         The two cores take turns on one thread, so a run is the same every time; `--threads`
//         gives each core a thread of its own once core 1 is launched, which is faster where both
//         are busy and is not reproducible.
//
//     cortical check <name | file.hocon>
//         Read a board or product description and hold it to the part library: print every mistake,
//         with its line and column, and exit 1; or print what it is.
//
//     A name with a `/` in it, or ending in `.hocon`, is a file; any other is a description built
//     into cortical: `virt`, `pico`, `pico2w`, `pico-breadboard-kit`.
//
//     cortical bench-board <image.elf> [turns | threads]
//         Run an image on the virtual board to its exit, three rounds with the cores taking turns on
//         one thread and three with a thread each, and report the instructions both cores retired and
//         their speed together. Naming one way runs only that one.
//
//     cortical bench [--core <core>] <image.bin> [expected r0] [match | threaded]
//         Run a raw image from address 0 under both executors, three rounds each, and report each
//         one's speed. Naming one executor runs only that one, so a process-wide counter (`time -l`'s
//         cycles and instructions) measures it alone.

import sh.sysl.cortical.v6m.{Cpu, Kind, Stop, reset, run_match, run_threaded}
import sh.sysl.cortical.virt.{board_named, boot, capture, core1, described_error, image_of, listen, open_console, output, run_board, set_threads, stop_message, type_in}
import sh.sysl.cortical.{built_in_shelf, library, load, open_description, summary}
import sh.sysl.parsing.Span
import sysl.fs.read_bytes
import sysl.text.parse_int
import sysl.time.monotonic
import sysl.tty.raw

const QUANTUM: u64 = 1000000

var cpu: Cpu

usage()
    print("usage: cortical run [--board <name | file.hocon>] [--threads] <image.elf | image.bin>")
    print("       cortical check <name | file.hocon>")
    print("       cortical bench [--core <core>] <image.bin> [expected r0] [match | threaded]")
    print("       cortical bench-board <image.elf> [turns | threads]")
    exit(2)

die(why: string) -> never
    eprints(s"cortical: $why\n")
    exit(1)

read_or_die(file: string) -> []u8 = read_bytes(file) match
    Ok(b) -> b
    Err(e) -> die(s"cannot read $file: $e")

main(args: []string)
    if args.len < 3 then usage()

    args[1] match
        "run" -> run_command(args)
        "bench" -> bench(args)
        "bench-board" -> bench_board(args)
        "check" -> check_description(args[2])
        _ -> usage()

// ---------------------------------------------------------------------------------------------------
// check

check_description(which: string)
    val src = open_description(built_in_shelf(), which, "", Span(0, 0)) match
        Ok(s) -> s
        Err(d) ->
            eprints(described_error(d))
            exit(1)

    val reg = library()
    val got = load(src, reg)

    if got.report.has_errors() then
        eprints(got.report.render(src))
        exit(1)

    prints(summary(got.description, reg))

// ---------------------------------------------------------------------------------------------------
// run

// `cortical run`'s options, then the image.
run_command(args: []string)
    var which = "virt"
    var parallel = false
    var i = 2

    while i < args.len - 1
        args[i] match
            "--board" ->
                if i + 1 >= args.len - 1 then usage()
                which = args[i + 1]
                i += 2
            "--threads" ->
                parallel = true
                i += 1
            _ -> usage()

    if i != args.len - 1 then usage()

    run(which, args[i], parallel)

// Run `file` on the board `which` names, each core on a thread of its own where `parallel` says so.
run(which: string, file: string, parallel: bool)
    board_named(which) match
        Ok(_) -> ()
        Err(why) ->
            eprints(why)
            exit(1)

    val image = image_of(read_or_die(file)) match
        Ok(b) -> b
        Err(why) -> die(s"$file: $why")

    open_console()
    boot(&cpu, image.view())
    if parallel then set_threads()
    raw()

    if !listen() then die("cannot start the console's input thread")

    val core = run_board(&cpu)

    core.stop match
        Exit -> exit(int(core.exit_code))
        Budget -> ()
        Breakpoint | Reset -> eprints(s"\r\ncortical: ${stop_message(core)}\r\n")
        _ ->
            eprints(s"\r\ncortical: ${stop_message(core)}\r\n")
            exit(3)

// ---------------------------------------------------------------------------------------------------
// bench

// Run the guest to its breakpoint with `exec` on a core of `kind`, and answer the microseconds it
// took.
measure(image: []u8, kind: Kind, exec: *extern(*Cpu) -> unit) -> long
    cpu.kind = kind
    reset(&cpu, image, 0)

    val start = monotonic()

    while cpu.stop == Stop.Budget
        cpu.limit = cpu.retired + QUANTUM
        exec(&cpu)

    (monotonic() - start).us

report(name: string, us: long, expected: u32) -> bool
    val mips = real(cpu.retired) / real(us)
    val ok = cpu.stop == Stop.Breakpoint && cpu.r[0] == expected

    print(s"$name: ${cpu.retired} instructions in $us us, $mips MIPS, r0 = ${cpu.r[0]}, ${cpu.stop}")

    if !ok then print(s"  FAILED: expected r0 = $expected at a breakpoint, stopped at ${cpu.stop_at}")

    ok

bench(args: []string)
    var kind = Kind.V6m
    var at = 2

    if args[2] == "--core"
        if args.len < 5 then usage()
        kind = args[3] match
            "cortex-m0plus" -> Kind.V6m
            "cortex-m33" -> Kind.V8mMain
            _ -> die(s"`${args[3]}` is no core cortical has: cortex-m0plus or cortex-m33")
        at = 4

    val image = read_or_die(args[at])
    val expected: u32 = if args.len > at + 1 then u32(parse_int(args[at + 1]).unwrap_or(0)) else 0
    val only = if args.len > at + 2 then args[at + 2] else ""
    var good = true

    for round in 0..<3
        if only != "threaded"
            good = report("match   ", measure(image, kind, &run_match), expected) && good
        if only != "match"
            good = report("threaded", measure(image, kind, &run_threaded), expected) && good

    if !good then exit(1)

// Run `image` on the virtual board to its exit, the cores on threads of their own where `parallel`
// says so, and report both cores' instructions and their speed together. Answers whether the guest
// exited 0.
board_round(name: string, image: []const u8, parallel: bool) -> bool
    open_console()
    capture()
    type_in([])
    boot(&cpu, image)
    if parallel then set_threads()

    val start = monotonic()
    val stopped = run_board(&cpu)
    val us = (monotonic() - start).us
    val both = cpu.retired + core1().retired
    val mips = real(both) / real(us)
    val ok = stopped.stop == Stop.Exit && stopped.exit_code == 0

    print(s"$name: ${cpu.retired} + ${core1().retired} instructions in $us us, $mips MIPS, ${stopped.stop} ${stopped.exit_code}")

    if !ok then print(s"  FAILED: ${stop_message(stopped)}\n  ${str_cast(output())}")

    ok

bench_board(args: []string)
    board_named("virt") match
        Ok(_) -> ()
        Err(why) -> die(why)

    val image = image_of(read_or_die(args[2])) match
        Ok(b) -> b
        Err(why) -> die(s"${args[2]}: $why")

    val only = if args.len > 3 then args[3] else ""
    var good = true

    for round in 0..<3
        if only != "threads" then good = board_round("turns  ", image.view(), false) && good
        if only != "turns" then good = board_round("threads", image.view(), true) && good

    if !good then exit(1)
