// benchtop: a microcontroller board emulator.
//
//     benchtop run [--board <name | file.hocon>] [--window] [--deterministic] [--usb console|pty|off] [--boot debugger|rom] [--gdb [port]] [--sd <card.img | none>] [--semihosting] [--serial uart0|uart1=file:<path>] [--report-masking <file> [--masking-sites] [--masking-ranks <n>]] [--report <file.json>] [--explain-faults] [--trace-ring <n>] <image.elf | image.bin>
//         Boot the image on the board `--board` names, the virtual board `virt` where none is named,
//         its console on this terminal, a keystroke at a time. Ctrl-] ends benchtop whatever the
//         guest is doing. The exit status is the guest's, written to the console's EXIT register.
//         Each launched guest core runs on its own host thread. Use `--deterministic` for
//         reproducible core turns on one host thread; `--seed n` varies their lengths and order by n,
//         the same n giving the same run, and `--late-systick`, `--bunch-systick`, `--late-irq` and
//         `--strex-fail` inject faults (README). On a Pico 2 (an RP2350's Cortex-M33 cores)
//         benchtop's USB host is plugged in: a `stdio_usb` program's serial port prints beside UART0
//         (`--usb console`, the default), or is a pseudo-terminal whose name is printed on stderr, for
//         `screen` or `picocom` (`--usb pty`); `--usb off` leaves the USB socket empty. `--gdb`
//         serves gdb's remote protocol instead, one port per core from `port` (3333), and holds the
//         board at reset until a gdb resumes it (docs/gdb.md). `--report-masking` writes each Cortex-M
//         core's masked intervals and interrupt latencies to `file` when the run ends, however it
//         ends: on a virtual board, a Pico or a Pico 2, scripted or not; `--window`, `--gdb` and the
//         Hazard3 harts refuse it (README.md, "The masking report"). `--masking-sites` adds a table of
//         every masking site (each distinct pair of the instruction that masked and the one that
//         unmasked: its longest interval and count, named by symbol); `--masking-ranks n` lists the
//         n longest intervals, 1 to 4096, instead of 8. `--report` writes the exit
//         report to `file.json` as the run ends, however it ends (a file it cannot write fails the
//         run, status 1): one JSON object saying how it ended (`exit`: exit,
//         expect_met, timeout, fault_lockup, fault, breakpoint, asleep, budget, reset or error), the
//         status, the board's clock and each core's pc, symbol, state and registers, on every board
//         and its Cortex-M cores or Hazard3 harts, scripted or not; `--window` and `--gdb` refuse it
//         (README.md, "The exit report"). A Cortex-M core's faults are recorded as they are taken —
//         the status registers in words, the stacked frame, PC and LR by symbol, a best-effort
//         backtrace — and where the run ends on one (a fault benchtop stops on, a lockup, or a core
//         still in its fault handler) the fault is explained on stderr, and in the report's `fault`.
//         `--explain-faults` explains every fault as it is taken, recovered from or not;
//         `--trace-ring n` keeps each core's last n instructions (up to 4096) for the explanation, on
//         the slower `match` executor. `--window`, `--gdb` and the Hazard3 harts refuse both
//         (README.md, "Fault explanations").
//
//     benchtop check [--mcu] <name | file.hocon>
//         Read a chip, board or product description and hold it to the library: print every mistake,
//         with its line and column, and exit 1; or print what it is. A name is a board's, or with
//         `--mcu` a chip's.
//
//     A name with a `/` in it, or ending in `.hocon`, is a file; any other is a description built
//     into benchtop: the boards `virt`, `virt33`, `pico`, `pico2w`, `pico-breadboard-kit`, ..., and
//     the chips `virt`, `virt33`, `rp2040`, `rp2350`, ....
//
//     benchtop bench-board [--board <name | file.hocon>] [--report-masking <file>] <image.elf> [turns | threads]
//         Run an image on a runnable board, `virt` where none is named, to its exit, three rounds with
//         the cores taking turns on one thread and three with a thread each, and report the
//         instructions both cores retired and their speed together. Naming one way runs only that one.
//         `--report-masking` records the masking report in every round and writes the last one's.
//
//     benchtop realtime [--board <name | file.hocon>] [--seconds N] [--warmup N] [--unpaced | --window] [--set <symbol>=<value>] <image.elf>
//         Run an image on the board's CPU workers as the desktop runs it, with no window, the board
//         `stm32h747-disco` where none is named, playing the desktop's part in its audio, touch and
//         display. After `--warmup` guest seconds (1), measure `--seconds` more (10) and report, per
//         core, guest time over host time (1.0 is real time), the guest MHz and MIPS it sustained,
//         how busy its worker was and so the MHz its worker could sustain; and the DSI worker's and
//         the display copy's share of host time. Exit 1 where a core falls below real time.
//         `--unpaced` runs as fast as the host can instead, for the headroom. `--set` writes a word
//         at an ELF symbol before the cores start, as a debugger would (the busy firmware's kernel).
//         `--window` opens the desktop's own window instead, paced, plays and paints in it, prints the
//         same report over the same guest seconds (its display line counts paints, not copies) and
//         closes the window by itself; it needs a desktop session, and refuses `--unpaced` and `--set`.
//
//     benchtop bench [--core <core>] [--timing unit|estimated] <image.bin> [expected result] [match | threaded]
//         Run a raw image from address 0 on one core, an M0+ where none is named, under both
//         executors, three rounds each, and report each one's speed. Naming one executor runs only
//         that one, so a process-wide counter (`time -l`'s cycles and instructions) measures it alone.

import sh.sysl.benchtop.v6m.{MaskingOptions, masking_defaults, masking_ranks, cycles as memory_cycles,configure_instruction_timing,Cpu, ExplainOptions, FAULT_OPTIONS, Faults, Kind, Memory, Stop, SymbolTable, explain_defaults, explain_in_raw_mode, image_symbols, memory, model_named, no_faults, reset, run_match, run_threaded, symbol_table, take_explain, take_fault}
import sh.sysl.benchtop.virt.{Machine, SdChoice, board_named, board_named_sd, sd_choice, boot, capture, core0, core1, described_error, explore, image_of, listen, machine, machine_guest, open_console, output, run_board, set_threads, stop_message, type_in, record_board_masking, board_masking_text, MASKING_CORTEX_ONLY, EXPLAIN_CORTEX_ONLY, ExitKind, ExitReport, exit_report, exit_report_json, explain_board_faults, machine_faults, stop_kind, with_machine}
import sysl.buf.buf
import sh.sysl.benchtop.{built_in_shelf, library, listing, load, open_chip, open_description, summary}
import sysl.raw.str_cast
import sh.sysl.parsing.Span
import sysl.fs.{read_bytes, write_text}
import sysl.text.{parse_int, parse_long, replace_all, Search}
import sysl.time.monotonic
import sysl.tty.raw
import sh.sysl.benchtop.riscv as rv
import sh.sysl.benchtop.chip as chip
import sh.sysl.benchtop.ui as ui
import sh.sysl.benchtop.host as host
import sh.sysl.benchtop.realtime as rt
import sh.sysl.benchtop.gdb as gdb
import sh.sysl.benchtop.script as script

const QUANTUM: u64 = 1000000

// The core `benchtop bench` runs bare, on a memory of its own and with no board around it.
var cpu: Cpu
var riscv_ram: [1048576]u8
var riscv_records: [524289]rv.Insn
var riscv_lines: [16384]u8

usage()
    print("usage: benchtop demo [--headless] [--frames N] [--screenshot out.png]")
    print("       benchtop view <board | file.hocon> [--frames N] [--screenshot out.png]")
    print("       benchtop render <board | file.hocon> <out.png>")
    print("       benchtop run [--board <name | file.hocon>] [--window] [--deterministic] [--threads] [--usb console|pty|off] [--boot debugger|rom] [--gdb [port]] [--sd <card.img | none>] [--semihosting] [--serial uart0|uart1=file:<path>] [--report-masking <file> [--masking-sites] [--masking-ranks <n>]] [--report <file.json>] [--explain-faults] [--trace-ring <n>] <image.elf | image.bin>")
    print("       run --window: [--watch] [--build <program>] [--build-arg <arg>] [--watch-source <file>] [--instruments <file.hocon>] [--headless] [--frames N] [--screenshot out.png]")
    print(s"       run, scripted: ${script.OPTIONS}")
    print(s"       run, varied: $FAULT_OPTIONS")
    print("       benchtop check [--mcu] <name | file.hocon>")
    print("       benchtop bench [--core <core>] [--timing unit|estimated] <image.bin> [expected result] [match | threaded]")
    print("       benchtop bench-board [--board <name | file.hocon>] [--report-masking <file>] <image.elf> [turns | threads]")
    print("       benchtop realtime [--board <name | file.hocon>] [--seconds N] [--warmup N] [--unpaced | --window] [--set <symbol>=<value>] <image.elf>")
    exit(2)

die(why: string) -> never
    report_end(exit_report(ExitKind.Error, 1, why))
    eprints(s"benchtop: $why\n")
    exit(1)

// End the run on a description's refusal, `why` as it renders itself, on lines of its own: status 1,
// and an `error` report holding its first line.
refuse(why: string) -> never
    val b = why.bytes
    var n: usize = 0
    while n < b.len && b[n] != 10 do n += 1
    val first = why[..<n]
    report_end(exit_report(ExitKind.Error, 1, if first.starts_with("benchtop: ") then first[10..] else first))
    eprints(why)
    exit(1)

// The exit report's file (`benchtop run --report`), empty for none, and the image whose symbols name
// the cores' pcs in it. A run names the file once its options are accepted; from then on, however the
// run ends, its report is written there: by the run's own end, or as an `error` by `die`.
var report_file = ""
var report_image = ""

// Write `r` to the exit report's file, where one is named, and forget the file, so that a report is
// written once. A file that cannot be written ends the run with status 1.
report_end(r: ExitReport)
    if report_file.is_empty() then return
    val f = report_file
    report_file = ""
    val symbols = read_bytes(report_image) match
        Ok(b) -> image_symbols(b.view())
        Err(_) -> buf()
    write_text(f, exit_report_json(&r, symbols.view())) match
        Ok(_) -> ()
        Err(e) -> die(if r.message.is_empty() then s"cannot write $f: $e" else s"cannot write $f: $e (the run: ${r.message})")

read_or_die(file: string) -> []u8 = read_bytes(file) match
    Ok(b) -> b
    Err(e) -> die(s"cannot read $file: $e")

main(args: []string)
    if args.len >= 2 && (args[1] == "demo" || args[1] == "view" || args[1] == "render")
        ui.command(args) match
            Ok(code) -> exit(code)
            Err(why) -> die(why)
    if args.len < 3 then usage()

    args[1] match
        "run" -> run_command(args)
        "bench" -> bench(args)
        "bench-board" -> bench_board(args)
        "realtime" -> realtime_command(args)
        "check" ->
            if args[2] == "--mcu" then
                if args.len < 4 then usage()

                check_description(args[3], true)
            else
                check_description(args[2], false)
        _ -> usage()

// ---------------------------------------------------------------------------------------------------
// check

check_description(which: string, chip: bool)
    val opened = if chip then open_chip(built_in_shelf(), which, "", Span(0, 0)) else open_description(built_in_shelf(), which, "", Span(0, 0))
    val src = opened match
        Ok(s) -> s
        Err(d) ->
            eprints(described_error(d))
            exit(1)

    val reg = library()
    val got = load(src, reg)

    if got.report.has_errors() then
        eprints(got.report.render(src))
        exit(1)

    prints(summary(got.description, reg))

// ---------------------------------------------------------------------------------------------------
// run

// `benchtop run`'s options, then the image.
run_command(args: []string)
    var which = "virt"
    var parallel = true
    var window = false
    var headless = false
    var frames: u64 = 0
    var screenshot = ""
    var develop = host.config()
    var instrument_file = ""
    var usb = UsbMode.Console
    var usb_named = false
    var gdb_port = 0
    var sd = SdChoice.Described
    var sd_named = false
    var rom_boot = false
    var arm = chip.arm_options()
    var threads_named = false
    var faults = no_faults()
    var masking_file = ""
    var masking = masking_defaults()
    var ranks_named = false
    var report = ""
    var explain = explain_defaults()
    var steps = script.script()
    var i = 2

    while i < args.len - 1
        args[i] match
            "--watch" ->
                develop.watch = true
                i += 1
            "--build" | "--build-arg" | "--watch-source" ->
                if i + 1 >= args.len - 1 then usage()
                if args[i] == "--build" then develop.program = args[i + 1]
                elif args[i] == "--build-arg" then develop.args.push(args[i + 1])
                else develop.sources.push(args[i + 1])
                i += 2
            "--instruments" ->
                if i + 1 >= args.len - 1 then usage()
                instrument_file = args[i + 1]
                i += 2
            "--window" ->
                window = true
                i += 1
            "--headless" ->
                headless = true
                i += 1
            "--frames" | "--screenshot" ->
                if i + 1 >= args.len - 1 then usage()
                if args[i] == "--frames"
                    frames = ui.frame_count(args[i + 1]) match
                        Ok(n) -> n
                        Err(why) -> die(why)
                else screenshot = args[i + 1]
                i += 2
            "--board" ->
                if i + 1 >= args.len - 1 then usage()
                which = args[i + 1]
                i += 2
            "--deterministic" ->
                parallel = false
                i += 1
            "--usb" ->
                if i + 1 >= args.len - 1 then usage()
                usb = args[i + 1] match
                    "console" -> UsbMode.Console
                    "pty" -> UsbMode.Pty
                    "off" -> UsbMode.Off
                    _ -> die(s"--usb takes console, pty or off, not ${args[i + 1]}")
                usb_named = true
                i += 2
            "--sd" ->
                if i + 1 >= args.len - 1 then usage()
                sd = sd_choice(args[i + 1])
                sd_named = true
                i += 2
            "--boot" ->
                if i + 1 >= args.len - 1 then usage()
                rom_boot = args[i + 1] match
                    "rom" -> true
                    "debugger" -> false
                    _ -> die(s"--boot takes rom or debugger, not ${args[i + 1]}")
                i += 2
            "--threads" ->
                parallel = true
                threads_named = true
                i += 1
            "--report-masking" ->
                if i + 1 >= args.len - 1 then usage()
                masking_file = args[i + 1]
                i += 2
            "--masking-sites" ->
                masking.sites = true
                i += 1
            "--masking-ranks" ->
                if i + 1 >= args.len - 1 then usage()
                masking_ranks(args[i + 1]) match
                    Ok(n) -> masking.ranks = n
                    Err(why) -> die(why)
                ranks_named = true
                i += 2
            "--report" ->
                if i + 1 >= args.len - 1 then usage()
                report = args[i + 1]
                i += 2
            "--semihosting" ->
                arm.semihosting = true
                i += 1
            "--serial" ->
                if i + 1 >= args.len - 1 then usage()
                chip.take_serial(&arm, args[i + 1]) match
                    Ok(_) -> ()
                    Err(why) -> die(why)
                i += 2
            "--gdb" ->
                gdb_port = GDB_PORT
                i += 1
                if i < args.len - 1 && is_port(args[i])
                    gdb_port = parse_int(args[i]).unwrap()
                    i += 1
            _ -> take_fault(&faults, args, i, args.len - 1) match
                Some(Ok(next)) -> i = next
                Some(Err(why)) -> die(why)
                None -> take_explain(&explain, args, i, args.len - 1) match
                    Some(Ok(next)) -> i = next
                    Some(Err(why)) -> die(why)
                    None -> script.take(&steps, args, i, args.len - 1) match
                        Some(Ok(next)) -> i = next
                        Some(Err(why)) -> die(why)
                        None -> usage()

    if i != args.len - 1 then usage()
    // A seed is a run that can be repeated: the cores take turns on one thread.
    if faults.seeded
        if threads_named then die("--seed is for cores taking turns on one thread: two threads cannot be repeated")
        parallel = false

    if !masking_file.is_empty() && (window || gdb_port != 0) then die("--report-masking is for a run without --window or --gdb")
    if (masking.sites || ranks_named) && masking_file.is_empty() then die("--masking-sites and --masking-ranks are options of --report-masking")
    if !report.is_empty() && window then die("--report is for a run without --window")
    if !report.is_empty() && gdb_port != 0 then die("--report is for a run without --gdb")
    if explain.named() && (window || gdb_port != 0) then die("--explain-faults and --trace-ring are for a run without --window or --gdb")

    if steps.active()
        if window then die("--expect, --type, --press, --timeout and --quiet are for a run without --window")
        if gdb_port != 0 then die("--expect, --type, --press, --timeout and --quiet are for a run without --gdb")
        if usb == UsbMode.Pty then die("--usb pty is for a run without a script: a scripted run types into the console")
        val outcome = script.run(which, args[i], steps, script.Setup(usb != UsbMode.Off, usb_named, sd, sd_named, rom_boot, arm), faults, masking_file, report, explain, masking)
        eprints(s"benchtop: ${outcome.why}\n")
        if !outcome.explanation.is_empty() then eprints(s"benchtop: ${outcome.explanation}")
        exit(outcome.status)

    if window && arm.named() then die("--semihosting and --serial are for a run without --window")
    if window && gdb_port != 0 then die("--gdb is for a run without --window")
    if faults.any() && (window || gdb_port != 0) then die("--seed and the fault options are for a run without --window or --gdb")
    if gdb_port != 0 && usb == UsbMode.Pty then die("--usb pty is for a run without --gdb")
    if window
        val m33 = chip.arm_named(which).is_some()
        val rp = m33 || chip.pico_named(which).is_some() || chip.riscv_named(which).is_some()
        if usb_named && !m33 then die(if rp then "--usb is for a board of an RP2350's Cortex-M33 cores" else "--usb is for a run without --window, or an RP2350 board's window")
        if usb == UsbMode.Pty then die("--usb pty is for a run without --window: the window's Guest tab is the board's serial port")
        if rp && sd_named then die("--sd is for a board with a microSD socket")
        ui.launch(which, args[i], ui.launch_options(frames = frames, screenshot = screenshot, headless = headless, develop = develop, instrument_file = instrument_file, deterministic = !parallel, sd = sd, usb = usb != UsbMode.Off, rom_boot = rom_boot)) match
            Ok(code) -> exit(code)
            Err(why) -> die(why)
    if !instrument_file.is_empty() then die("--instruments requires --window")
    if host.enabled(develop) then die("--watch, --build and --watch-source require --window")
    if headless || frames != 0 || !screenshot.is_empty() then die("--headless, --frames and --screenshot require --window")
    report_file = report
    report_image = args[i]
    run(which, args[i], parallel, usb, usb_named, gdb_port, sd, sd_named, rom_boot, arm, faults, masking_file, masking, explain)

// The port gdb connects to for core 0 where `--gdb` names none, OpenOCD's.
const GDB_PORT = 3333

// Whether `arg` is a TCP port number, which `--gdb` may take before the image.
is_port(arg: string) -> bool = parse_int(arg) match
    Ok(n) -> n > 0 && n < 65535
    Err(_) -> false

// Where `benchtop run` sends a USB device's serial port (`--usb`).
enum UsbMode
    // benchtop's host enumerates the device and its CDC output joins the console on stdout.
    Console
    // The same, through a pseudo-terminal whose name is printed on stderr.
    Pty
    // No host on the bus.
    Off

// Run `file` on the board `which` names, each core on a thread of its own where `parallel` says so.
// A board of RISC-V cores runs on the RP2350 chip layer, both harts on this thread. `usb` is for an Arm
// RP2350 board; naming it (`usb_named`) for another is refused. `rom_boot` boots an Arm RP2350 board's
// core 0 from reset through the boot ROM (`--boot rom`), and is refused for any other board. `arm` is
// `--semihosting` and `--serial`, and `faults` varies the run (`--seed` and the fault options), both on
// a board of Cortex-M cores. A `masking_file` not empty receives the masking report when the run ends.
// The cores' faults are recorded and explained as `explain` asks (v6m/explain.sysl).
run(which: string, file: string, parallel: bool, usb: UsbMode, usb_named: bool, gdb_port: int, sd: SdChoice, sd_named: bool, rom_boot: bool, arm: chip.ArmOptions, faults: Faults, masking_file: string, masking: MaskingOptions, explain: ExplainOptions)
    // The image's symbols, which name the addresses an explanation gives, alive for the whole run.
    val table: &SymbolTable = read_bytes(file) match
        Ok(b) -> symbol_table(b.view())
        Err(_) -> symbol_table([][..])
    chip.riscv_named(which) match
        Some(Ok(map)) ->
            if explain.named() then die(EXPLAIN_CORTEX_ONLY)
            if arm.named() then die(chip.SEMIHOST_ARM_ONLY)
            if usb_named then die("--usb is for a board of an RP2350's Cortex-M33 cores")
            if sd_named then die("--sd is for a board with a microSD socket")
            if gdb_port != 0 then die("--gdb is for a board of Cortex-M cores: the Hazard3 harts have no breakpoints or step for it yet")
            if rom_boot then die(chip.BOOT_ROM_ARM_ONLY)
            if faults.any() then die("--seed and the fault options are for a board of Cortex-M cores")
            if !masking_file.is_empty() then die(MASKING_CORTEX_ONLY)
            run_riscv(map, file, rp_parts_named(which))
        Some(Err(why)) -> refuse(why)
        None -> ()
    chip.arm_named(which) match
        Some(Ok(map)) ->
            if sd_named then die("--sd is for a board with a microSD socket")
            if gdb_port != 0 then serve_rp(which, file, usb != UsbMode.Off, gdb_port, rom_boot, arm)
            val b = chip.arm_board(map)
            b.rom_boot = rom_boot
            b.apply_options(arm)
            run_arm(b, file, usb, rp_parts_named(which), faults, masking_file, masking, explain, table)
        Some(Err(why)) -> refuse(why)
        None -> ()
    chip.pico_named(which) match
        Some(Ok(map)) ->
            if usb_named then die("--usb is for a board of an RP2350's Cortex-M33 cores: the RP2040's USB controller is not on its chip yet")
            if sd_named then die("--sd is for a board with a microSD socket")
            if rom_boot then die(chip.BOOT_ROM_ARM_ONLY)
            if gdb_port != 0 then serve_rp(which, file, false, gdb_port, false, arm)
            val b = chip.pico_board(map)
            b.apply_options(arm)
            run_arm(b, file, UsbMode.Off, rp_parts_named(which), faults, masking_file, masking, explain, table)
        Some(Err(why)) -> refuse(why)
        None -> ()
    if usb_named then die("--usb is for a board of an RP2350's Cortex-M33 cores")
    if rom_boot then die(script.BOOT_ROM_RP2350)
    if arm.named() then die(chip.SEMIHOST_ARM_ONLY)
    val board = machine()
    val m = &*board
    board_named_sd(m, which, sd) match
        Ok(_) -> ()
        Err(why) -> refuse(why)

    val image = image_of(m, read_or_die(file)) match
        Ok(b) -> b
        Err(why) -> die(s"$file: $why")

    open_console(m)
    boot(m, image.view())
    if faults.any() then explore(m, faults)
    if !masking_file.is_empty() then record_board_masking(m, masking.with_table(table))
    explain_board_faults(m, explain, table)
    // The console is in raw mode from here, so a fault explained as it is taken ends its lines so.
    explain_in_raw_mode(&m.cores[0])
    explain_in_raw_mode(&m.cores[1])
    // Under gdb the cores take turns on this thread, which serves gdb between them.
    if parallel && gdb_port == 0 then set_threads(m)
    raw()

    if !listen(m) then die("cannot start the console's input thread")

    if gdb_port != 0
        exit(gdb.serve(machine_guest(board, 0), gdb_port))

    val core = run_board(m)

    if !masking_file.is_empty() then write_masking(m, masking_file)
    if !report_file.is_empty()
        val (status, why) = core.stop match
            Exit -> (int(core.exit_code), "")
            Running -> (0, "")
            Breakpoint | Reset -> (0, stop_message(core))
            _ -> (3, stop_message(core))
        var r = with_machine(exit_report(stop_kind(core), status, why), m)
        if core.stop == Stop.Exit then r.exit_status = long(core.exit_code)
        report_end(r)

    var faults_seen = machine_faults(m)
    val explained = faults_seen.text(table.names.view())
    if !explained.is_empty() then eprints(s"\r\nbenchtop: ${replace_all(explained, "\n", "\r\n")}")

    core.stop match
        Exit -> exit(int(core.exit_code))
        Running -> ()
        Breakpoint | Reset -> eprints(s"\r\nbenchtop: ${stop_message(core)}\r\n")
        _ ->
            eprints(s"\r\nbenchtop: ${stop_message(core)}\r\n")
            exit(3)

// The parts of the RP board `which` names, which its plan has passed.
rp_parts_named(which: string) -> chip.RpParts = chip.rp_parts(chip.described(which).unwrap().0)

// Write the guest's console text from index `shown` on to stdout, a line at a time (`host.show_console`),
// flushing each time. Returns how much of `text` has been written.
show_console(text: []const u8, shown: usize, last: bool) -> usize =
    host.show_console(text, shown, last, b -> putbytes(b), () -> flush())

// Run the ELF `file` on an RP2350's Hazard3 cores with `map`'s SRAM, UART0 on stdout, until a hart
// EBREAKs (exit 0), faults (exit 3) or both sleep with nothing to wake them (exit 4).
run_riscv(map: chip.SramMap, file: string, parts: chip.RpParts) -> never
    val b = chip.riscv_board(map)
    b.boot(read_or_die(file)) match
        Ok(_) -> ()
        Err(why) -> die(s"$file: $why")
    var ps = parts
    chip.apply_parts(&ps, &b.chip)
    var shown: usize = 0
    loop
        val end = b.run(QUANTUM)
        // At a breakpoint the chip runs on, as under a debugger, until UART0 has sent what it holds.
        if end == chip.RunEnd.Breakpoint && !b.finish_sending()
            if !report_file.is_empty() then report_end(b.end_report(chip.RunEnd.Fault, 1, b.refused))
            die(b.refused)
        shown = show_console(b.console.view(), shown, end != chip.RunEnd.Budget)
        if end == chip.RunEnd.Budget then continue
        val why = end match
            Fault -> if b.refused.is_empty() then "a hart stopped on a fault" else b.refused
            Asleep -> "both harts sleep, and nothing on the chip will wake them"
            _ -> ""
        val status = end match
            Breakpoint | Exit | Budget -> 0
            Fault -> 1
            Asleep -> 4
        if !report_file.is_empty() then report_end(b.end_report(end, status, why))
        if !why.is_empty() then eprints(s"benchtop: $why\n")
        exit(status)

// Serve gdb on `port` and on for the RP board `which`, an RP2350 on its Cortex-M33 cores (benchtop's USB
// host on its bus where `usb` says so) or an RP2040, running the image `file`; its UART0, and its USB
// serial port, on stdout. The board runs on this thread between gdb's packets.
serve_rp(which: string, file: string, usb: bool, port: int, rom_boot: bool, arm: chip.ArmOptions) -> never
    val g = chip.rp_guest(which, usb, rom_boot, arm).unwrap().unwrap()
    val image = g.checked(read_or_die(file)) match
        Ok(b) -> b
        Err(why) -> die(s"$file: $why")
    g.restart(image.view()) match
        Ok(_) -> ()
        Err(why) -> die(s"$file: $why")
    exit(gdb.serve(g, port))

// Run the image `file` on board `b`, an RP2350 on its Cortex-M33 cores or an RP2040 on its Cortex-M0+
// cores, UART0 on stdout, until a core executes BKPT (exit 0), faults (exit 3) or both sleep with
// nothing to wake them (exit 4). Unless `usb` is Off (always, on the RP2040), benchtop's USB host is on
// the bus, and a CDC ACM device's serial port goes to stdout beside UART0, a line at a time, or to a
// pseudo-terminal whose name goes to stderr. A `masking_file` not empty receives both cores' masking
// report as the run ends, whichever way it ends.
run_arm[C: chip.ArmChip + chip.PartPins](b: &chip.ArmBoard[C], file: string, usb: UsbMode, parts: chip.RpParts, faults: Faults, masking_file: string, masking: MaskingOptions, explain: ExplainOptions, table: &SymbolTable) -> never
    b.boot(read_or_die(file)) match
        Ok(_) -> ()
        Err(why) -> die(s"$file: $why")
    if faults.any() then b.explore(faults)
    if !masking_file.is_empty() then b.record_masking(masking.with_table(table))
    b.record_faults(explain, table)
    // The board's parts at rest: a potentiometer's level on its ADC input, the buttons let go.
    var ps = parts
    chip.apply_parts(&ps, &b.chip)
    var pty: Option[host.Pty] = None
    if usb != UsbMode.Off
        b.attach_usb_host(true)
        if usb == UsbMode.Pty
            val p = host.open_pty() match
                Ok(p) -> p
                Err(why) -> die(why)
            eprints(s"benchtop: the board's USB serial port is ${p.name}\n")
            pty = Some(p)
    var shown: usize = 0
    loop
        val end = b.run(QUANTUM)
        if end != chip.RunEnd.Budget && !masking_file.is_empty() then write_report(masking_file, b.masking_text())
        // At a breakpoint the chip runs on, as under a debugger, until UART0 has sent what it holds.
        if (end == chip.RunEnd.Breakpoint || end == chip.RunEnd.Exit) && !b.finish_sending()
            if !report_file.is_empty() then report_end(b.end_report(chip.RunEnd.Fault, 1, b.refused))
            die(b.refused)
        shown = show_console(b.console.view(), shown, end != chip.RunEnd.Budget)
        val h = &b.usb_host
        pty match
            Some(p) ->
                var port = p
                port.exchange(h) match
                    Ok(_) -> ()
                    Err(why) -> die(s"${port.name}: $why")
            None -> h.consume(show_console(h.received.view(), 0, end != chip.RunEnd.Budget))
        h.take_note() match
            Some(n) -> eprints(s"benchtop: $n\n")
            None -> ()
        if end == chip.RunEnd.Budget then continue
        val why = end match
            Fault -> if b.refused.is_empty() then s"a core stopped: ${arm_stop(&*b)}" else b.refused
            Asleep -> asleep_why(&*b)
            _ -> ""
        val status = end match
            Breakpoint | Budget -> 0
            Exit -> int(b.exit_status)
            Fault -> 1
            Asleep -> 4
        if !report_file.is_empty() then report_end(b.end_report(end, status, why))
        if !why.is_empty() then eprints(s"benchtop: $why\n")
        var faults_seen = b.faults()
        val explained = faults_seen.text(table.names.view())
        if !explained.is_empty() then eprints(s"benchtop: $explained")
        exit(status)

// Why an Arm RP run ends asleep.
asleep_why[C: chip.ArmChip](b: *chip.ArmBoard[C]) -> string
    if const C.rp2350()
        if b.chip.swcore_off then return "POWMAN has powered the switched core down, and nothing on the chip will power it up"
    "both cores sleep, and nothing on the chip will wake them"

// How the core that stopped an Arm run stopped, as `stop_message` says it.
arm_stop[C: chip.ArmChip](b: *chip.ArmBoard[C]) -> string
    for k in 0..<2 do if b.cores[k].stop != Stop.Running then return s"core $k: ${stop_message(&b.cores[k])}"
    "no core stopped"

// ---------------------------------------------------------------------------------------------------
// bench

// Run the guest to its breakpoint with `exec` on a core of `kind` over `mem`, and answer the
// microseconds it took.
measure(mem: &sync Memory, image: []u8, kind: Kind, exec: *extern(*Cpu) -> unit, estimated: bool = false) -> long
    cpu.kind = kind
    reset(&cpu, mem, image, 0)
    configure_instruction_timing(&cpu,estimated)

    val start = monotonic()

    while cpu.stop == Stop.Running
        cpu.limit = memory_cycles(&cpu) + QUANTUM
        exec(&cpu)

    (monotonic() - start).us

report(name: string, us: long, expected: u32) -> bool
    val mips = real(cpu.retired) / real(us)
    val ok = cpu.stop == Stop.Breakpoint && cpu.r[0] == expected

    print(s"$name: ${cpu.retired} instructions in $us us, $mips MIPS, ${memory_cycles(&cpu)} cycles, r0 = ${cpu.r[0]}, ${cpu.stop}")

    if !ok then print(s"  FAILED: expected r0 = $expected at a breakpoint, stopped at ${cpu.stop_at}")

    ok

bench(args: []string)
    var kind = Kind.V6m
    var at = 2

    if args[2] == "--core"
        if args.len < 5 then usage()
        rv.model_named(args[3]) match
            Some(model) ->
                bench_riscv(args, model)
                return
            None -> ()
        kind = model_named(args[3]) match
            Some(m) -> m.kind
            None -> die(s"`${args[3]}` is no core benchtop has: ${listing(library().core_names())}")
        at = 4

    var estimated = false
    if args[at] == "--timing"
        if args.len <= at + 2 then usage()
        if args[at + 1] != "unit" && args[at + 1] != "estimated" then die("timing must be unit or estimated")
        estimated = args[at + 1] == "estimated"
        at += 2

    val image = read_or_die(args[at])
    val expected: u32 = if args.len > at + 1 then u32(parse_int(args[at + 1]).unwrap_or(0)) else 0
    val only = if args.len > at + 2 then args[at + 2] else ""
    val mem = memory()
    var good = true

    for round in 0..<3
        if only != "threaded"
            good = report("match   ", measure(mem, image, kind, &run_match, estimated), expected) && good
        if only != "match"
            good = report("threaded", measure(mem, image, kind, &run_threaded, estimated), expected) && good

    if !good then exit(1)

// Run `image` on the virtual board to its exit, the cores on threads of their own where `parallel`
// says so, and report both cores' instructions and their speed together. Answers whether the guest
// exited 0. Where `masking` says so, the round records the masking report afresh.
board_round(m: *Machine, name: string, image: []const u8, parallel: bool, masking: bool) -> bool
    open_console(m)
    capture(m)
    type_in(m, [])
    val first = core0(m)
    boot(m, image)
    if masking then record_board_masking(m)
    if parallel then set_threads(m)

    val start = monotonic()
    val stopped = run_board(m)
    val us = (monotonic() - start).us
    val both = first.retired + core1(m).retired
    val mips = real(both) / real(us)
    val ok = stopped.stop == Stop.Exit && stopped.exit_code == 0

    print(s"$name: ${first.retired} + ${core1(m).retired} instructions in $us us, $mips MIPS, ${stopped.stop} ${stopped.exit_code}")

    if !ok then print(s"  FAILED: ${stop_message(stopped)}\n  ${str_cast(output(m).view())}")

    ok

bench_board(args: []string)
    var which = "virt"
    var masking_file = ""
    var at = 2

    while at < args.len && (args[at] == "--board" || args[at] == "--report-masking")
        if at + 2 >= args.len then usage()
        if args[at] == "--board" then which = args[at + 1] else masking_file = args[at + 1]
        at += 2
    if at >= args.len then usage()

    val board = machine()
    val m = &*board
    board_named(m, which) match
        Ok(_) -> ()
        Err(why) -> die(why)

    val image = image_of(m, read_or_die(args[at])) match
        Ok(b) -> b
        Err(why) -> die(s"${args[at]}: $why")

    val only = if args.len > at + 1 then args[at + 1] else ""
    var good = true

    val masking = !masking_file.is_empty()

    for round in 0..<3
        if only != "threads" then good = board_round(m, "turns  ", image.view(), false, masking) && good
        if only != "turns" then good = board_round(m, "threads", image.view(), true, masking) && good

    if masking then write_masking(m, masking_file)
    if !good then exit(1)

// Write the masking report of `m`'s cores to `file`.
write_masking(m: *Machine, file: string) = write_report(file, board_masking_text(m))

// Write `text` to `file`, or end benchtop saying why it cannot.
write_report(file: string, text: string)
    write_text(file, text) match
        Ok(_) -> ()
        Err(e) -> die(s"cannot write $file: $e")

// ---------------------------------------------------------------------------------------------------
// realtime

// `benchtop realtime`'s options, then the image; one run, reported per core and per host thread.
realtime_command(args: []string)
    var which = "stm32h747-disco"
    var o = rt.options()
    var window = false
    var i = 2
    while i < args.len - 1
        args[i] match
            "--board" | "--seconds" | "--warmup" ->
                if i + 1 >= args.len - 1 then usage()
                val value = args[i + 1]
                if args[i] == "--board" then which = value
                else
                    val n = parse_long(value) match
                        Ok(n) if n >= 0 && n <= 3600 -> u64(n)
                        _ -> die(s"${args[i]} needs a whole number of seconds up to 3600")
                    if args[i] == "--seconds" then o.seconds = n else o.warmup = n
                i += 2
            "--unpaced" ->
                o.paced = false
                i += 1
            "--window" ->
                window = true
                i += 1
            "--set" ->
                if i + 1 >= args.len - 1 then usage()
                val setting = args[i + 1]
                val equals = setting.index_of("=") match
                    Some(at) if at > 0 -> at
                    _ -> die("--set needs <symbol>=<value>")
                val value = parse_long(setting[equals + 1..]) match
                    Ok(n) if n >= 0 && n <= 0xffffffff -> u32(n)
                    _ -> die("--set needs a value from 0 to 4294967295")
                o.poke = Some(rt.Poke(setting[..<equals], value))
                i += 2
            _ -> usage()
    if i != args.len - 1 then usage()
    if window
        if !o.paced then die("--window runs paced, as the desktop does; --unpaced is for a run without it")
        if o.poke.is_some() then die("--set is for a run without --window")
        val meter = rt.meter(o)
        ui.launch(which, args[i], ui.launch_options(meter = Some(meter))) match
            Ok(_) -> ()
            Err(why) -> die(s"${args[i]}: $why")
        val r = meter.result match
            Some(r) -> r
            None -> die("the window closed before the measured seconds ended")
        val out = rt.report(r, which, args[i], "in a window")
        print(out.text)
        if !out.real_time then exit(1)
        return
    val board = machine()
    val r = rt.run(&*board, which, read_or_die(args[i]), o) match
        Ok(r) -> r
        Err(why) -> die(s"${args[i]}: $why")
    val out = rt.report(r, which, args[i])
    print(out.text)
    if !out.real_time then exit(1)

// RISC-V profiles share one core. This raw-image bench starts at zero and checks a0 at EBREAK,
// through the decode cache, or with `interpret` after the expected value, through the reference
// interpreter. It deliberately does not pretend to boot an RP2350 or use ARM reset vectors.
bench_riscv(args: []string, model: rv.Model)
    if !rv.implemented(model) then die(s"not all extensions of `${model.name}` are emulated yet (${model.isa})")
    if args.len > 7 || (args.len == 7 && args[6] != "interpret") then die("the RISC-V executor is threaded, or `interpret` after the expected value")
    val threaded = args.len < 7
    val image = read_or_die(args[4])
    if image.len > riscv_ram.len then die("larger than the bench's 1 MB of RAM")
    val expected: u32 = if args.len > 5 then expected_u32(args[5]) else 0
    var core: rv.Cpu
    var good = true
    for round in 0..<3
        for i in 0..<riscv_ram.len do riscv_ram[i] = 0
        for i in 0..<image.len do riscv_ram[i] = image[i]
        rv.reset(&core, model, rv.BARE, riscv_ram, 0, 0)
        if threaded && core.dec == null then assert(rv.use_code_cache(&core, riscv_records, riscv_lines))
        core.halt_breakpoint = true
        core.halt_faults = true
        val start = monotonic()
        while core.stop == rv.Stop.Budget
            if threaded then rv.run_threaded(&core, QUANTUM) else rv.run(&core, QUANTUM)
        val us = (monotonic() - start).us
        val mips = if us == 0 then 0.0 else real(core.retired) / real(us)
        print(s"${model.name}: ${core.retired} instructions in $us us, $mips MIPS, a0 = ${core.r[10]}, ${core.stop}")
        if core.stop != rv.Stop.Breakpoint || core.r[10] != expected
            print(s"  FAILED: expected a0 = $expected at EBREAK; pc = ${core.pc}, address = ${core.stop_at}")
            good = false
    if !good then exit(1)

expected_u32(text: string) -> u32
    val value = parse_long(text) match
        Ok(n) -> n
        Err(_) -> die(s"expected register value is not an integer: $text")
    if value < -2147483648 || value > 4294967295 then die(s"expected register value is outside 32 bits: $text")
    u32(value)
