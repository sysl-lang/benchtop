// benchtop: a microcontroller board emulator.
//
//     benchtop run [--board <name | file.hocon>] [--threads | --window] <image.elf | image.bin>
//         Boot the image on the board `--board` names, the virtual board `virt` where none is named,
//         its console on this terminal, a keystroke at a time. Ctrl-] ends benchtop whatever the
//         guest is doing. The exit status is the guest's, written to the console's EXIT register.
//         The two cores take turns on one thread, so a run is the same every time; `--threads`
//         gives each core a thread of its own once core 1 is launched, which is faster where both
//         are busy and is not reproducible.
//
//     benchtop check [--chip] <name | file.hocon>
//         Read a chip, board or product description and hold it to the library: print every mistake,
//         with its line and column, and exit 1; or print what it is. A name is a board's, or with
//         `--chip` a chip's.
//
//     A name with a `/` in it, or ending in `.hocon`, is a file; any other is a description built
//     into benchtop: the boards `virt`, `virt33`, `pico`, `pico2w`, `pico-breadboard-kit`, ..., and
//     the chips `virt`, `virt33`, `rp2040`, `rp2350`, ....
//
//     benchtop bench-board [--board <name | file.hocon>] <image.elf> [turns | threads]
//         Run an image on a runnable board, `virt` where none is named, to its exit, three rounds with
//         the cores taking turns on one thread and three with a thread each, and report the
//         instructions both cores retired and their speed together. Naming one way runs only that one.
//
//     benchtop bench [--core <core>] <image.bin> [expected result] [match | threaded]
//         Run a raw image from address 0 on one core, an M0+ where none is named, under both
//         executors, three rounds each, and report each one's speed. Naming one executor runs only
//         that one, so a process-wide counter (`time -l`'s cycles and instructions) measures it alone.

import sh.sysl.benchtop.v6m.{Cpu, Kind, Stop, model_named, reset, run_match, run_threaded}
import sh.sysl.benchtop.virt.{board_named, boot, capture, core1, described_error, image_of, listen, open_console, output, run_board, set_threads, stop_message, type_in}
import sh.sysl.benchtop.{built_in_shelf, library, listing, load, open_chip, open_description, summary}
import sysl.raw.str_cast
import sh.sysl.parsing.Span
import sysl.fs.read_bytes
import sysl.text.{parse_int, parse_long}
import sysl.time.monotonic
import sysl.tty.raw
import sh.sysl.benchtop.riscv as rv
import sh.sysl.benchtop.ui as ui
import sh.sysl.benchtop.host as host

const QUANTUM: u64 = 1000000

var cpu: Cpu
var riscv_ram: [1048576]u8

usage()
    print("usage: benchtop demo [--headless] [--frames N] [--screenshot out.png]")
    print("       benchtop view <board | file.hocon> [--frames N] [--screenshot out.png]")
    print("       benchtop render <board | file.hocon> <out.png>")
    print("       benchtop run [--board <name | file.hocon>] [--threads | --window] <image.elf | image.bin>")
    print("       run --window: [--watch] [--build <program>] [--build-arg <arg>] [--watch-source <file>] [--instruments <file.hocon>]")
    print("       benchtop check [--chip] <name | file.hocon>")
    print("       benchtop bench [--core <core>] <image.bin> [expected result] [match | threaded]")
    print("       benchtop bench-board [--board <name | file.hocon>] <image.elf> [turns | threads]")
    exit(2)

die(why: string) -> never
    eprints(s"benchtop: $why\n")
    exit(1)

read_or_die(file: string) -> []u8 = read_bytes(file) match
    Ok(b) -> b
    Err(e) -> die(s"cannot read $file: $e")

main(args: []string)
    if args.len >= 2 && (args[1] == "demo" || args[1] == "view" || args[1] == "render")
        ui.command(args) match
            Ok(code) -> exit(code)
            Err(why) -> die(why)
    if args.len < 3 then usage()

    args[1] match
        "run" -> run_command(args)
        "bench" -> bench(args)
        "bench-board" -> bench_board(args)
        "check" ->
            if args[2] == "--chip" then
                if args.len < 4 then usage()

                check_description(args[3], true)
            else
                check_description(args[2], false)
        _ -> usage()

// ---------------------------------------------------------------------------------------------------
// check

check_description(which: string, chip: bool)
    val opened = if chip then open_chip(built_in_shelf(), which, "", Span(0, 0)) else open_description(built_in_shelf(), which, "", Span(0, 0))
    val src = opened match
        Ok(s) -> s
        Err(d) ->
            eprints(described_error(d))
            exit(1)

    val reg = library()
    val got = load(src, reg)

    if got.report.has_errors() then
        eprints(got.report.render(src))
        exit(1)

    prints(summary(got.description, reg))

// ---------------------------------------------------------------------------------------------------
// run

// `benchtop run`'s options, then the image.
run_command(args: []string)
    var which = "virt"
    var parallel = false
    var window = false
    var headless = false
    var frames: u64 = 0
    var screenshot = ""
    var develop = host.config()
    var instrument_file = ""
    var i = 2

    while i < args.len - 1
        args[i] match
            "--watch" ->
                develop.watch = true
                i += 1
            "--build" | "--build-arg" | "--watch-source" ->
                if i + 1 >= args.len - 1 then usage()
                if args[i] == "--build" then develop.program = args[i + 1]
                elif args[i] == "--build-arg" then develop.args.push(args[i + 1])
                else develop.sources.push(args[i + 1])
                i += 2
            "--instruments" ->
                if i + 1 >= args.len - 1 then usage()
                instrument_file = args[i + 1]
                i += 2
            "--window" ->
                window = true
                i += 1
            "--headless" ->
                headless = true
                i += 1
            "--frames" | "--screenshot" ->
                if i + 1 >= args.len - 1 then usage()
                if args[i] == "--frames"
                    frames = ui.frame_count(args[i + 1]) match
                        Ok(n) -> n
                        Err(why) -> die(why)
                else screenshot = args[i + 1]
                i += 2
            "--board" ->
                if i + 1 >= args.len - 1 then usage()
                which = args[i + 1]
                i += 2
            "--threads" ->
                parallel = true
                i += 1
            _ -> usage()

    if i != args.len - 1 then usage()

    if window
        if parallel then die("--window uses deterministic core turns; omit --threads")
        ui.launch(which, args[i], false, frames, screenshot, headless, develop, instrument_file) match
            Ok(code) -> exit(code)
            Err(why) -> die(why)
    if !instrument_file.is_empty() then die("--instruments requires --window")
    if host.enabled(develop) then die("--watch, --build and --watch-source require --window")
    if headless || frames != 0 || !screenshot.is_empty() then die("--headless, --frames and --screenshot require --window")
    run(which, args[i], parallel)

// Run `file` on the board `which` names, each core on a thread of its own where `parallel` says so.
run(which: string, file: string, parallel: bool)
    board_named(which) match
        Ok(_) -> ()
        Err(why) ->
            eprints(why)
            exit(1)

    val image = image_of(read_or_die(file)) match
        Ok(b) -> b
        Err(why) -> die(s"$file: $why")

    open_console()
    boot(&cpu, image.view())
    if parallel then set_threads()
    raw()

    if !listen() then die("cannot start the console's input thread")

    val core = run_board(&cpu)

    core.stop match
        Exit -> exit(int(core.exit_code))
        Budget -> ()
        Breakpoint | Reset -> eprints(s"\r\nbenchtop: ${stop_message(core)}\r\n")
        _ ->
            eprints(s"\r\nbenchtop: ${stop_message(core)}\r\n")
            exit(3)

// ---------------------------------------------------------------------------------------------------
// bench

// Run the guest to its breakpoint with `exec` on a core of `kind`, and answer the microseconds it
// took.
measure(image: []u8, kind: Kind, exec: *extern(*Cpu) -> unit) -> long
    cpu.kind = kind
    reset(&cpu, image, 0)

    val start = monotonic()

    while cpu.stop == Stop.Budget
        cpu.limit = cpu.retired + QUANTUM
        exec(&cpu)

    (monotonic() - start).us

report(name: string, us: long, expected: u32) -> bool
    val mips = real(cpu.retired) / real(us)
    val ok = cpu.stop == Stop.Breakpoint && cpu.r[0] == expected

    print(s"$name: ${cpu.retired} instructions in $us us, $mips MIPS, r0 = ${cpu.r[0]}, ${cpu.stop}")

    if !ok then print(s"  FAILED: expected r0 = $expected at a breakpoint, stopped at ${cpu.stop_at}")

    ok

bench(args: []string)
    var kind = Kind.V6m
    var at = 2

    if args[2] == "--core"
        if args.len < 5 then usage()
        rv.model_named(args[3]) match
            Some(model) ->
                bench_riscv(args, model)
                return
            None -> ()
        kind = model_named(args[3]) match
            Some(m) -> m.kind
            None -> die(s"`${args[3]}` is no core benchtop has: ${listing(library().core_names())}")
        at = 4

    val image = read_or_die(args[at])
    val expected: u32 = if args.len > at + 1 then u32(parse_int(args[at + 1]).unwrap_or(0)) else 0
    val only = if args.len > at + 2 then args[at + 2] else ""
    var good = true

    for round in 0..<3
        if only != "threaded"
            good = report("match   ", measure(image, kind, &run_match), expected) && good
        if only != "match"
            good = report("threaded", measure(image, kind, &run_threaded), expected) && good

    if !good then exit(1)

// Run `image` on the virtual board to its exit, the cores on threads of their own where `parallel`
// says so, and report both cores' instructions and their speed together. Answers whether the guest
// exited 0.
board_round(name: string, image: []const u8, parallel: bool) -> bool
    open_console()
    capture()
    type_in([])
    boot(&cpu, image)
    if parallel then set_threads()

    val start = monotonic()
    val stopped = run_board(&cpu)
    val us = (monotonic() - start).us
    val both = cpu.retired + core1().retired
    val mips = real(both) / real(us)
    val ok = stopped.stop == Stop.Exit && stopped.exit_code == 0

    print(s"$name: ${cpu.retired} + ${core1().retired} instructions in $us us, $mips MIPS, ${stopped.stop} ${stopped.exit_code}")

    if !ok then print(s"  FAILED: ${stop_message(stopped)}\n  ${str_cast(output())}")

    ok

bench_board(args: []string)
    var which = "virt"
    var at = 2

    if args[2] == "--board"
        if args.len < 5 then usage()
        which = args[3]
        at = 4

    board_named(which) match
        Ok(_) -> ()
        Err(why) -> die(why)

    val image = image_of(read_or_die(args[at])) match
        Ok(b) -> b
        Err(why) -> die(s"${args[at]}: $why")

    val only = if args.len > at + 1 then args[at + 1] else ""
    var good = true

    for round in 0..<3
        if only != "threads" then good = board_round("turns  ", image.view(), false) && good
        if only != "turns" then good = board_round("threads", image.view(), true) && good

    if !good then exit(1)

// RISC-V profiles share one interpreter. This raw-image bench starts at zero and checks a0
// at EBREAK. It deliberately does not pretend to boot an RP2350 or use ARM reset vectors.
bench_riscv(args: []string, model: rv.Model)
    if !rv.implemented(model) then die(s"not all extensions of `${model.name}` are emulated yet (${model.isa})")
    if args.len > 6 then die("RISC-V profiles use one shared executor; no executor selector is accepted")
    val image = read_or_die(args[4])
    if image.len > riscv_ram.len then die("larger than the bench's 1 MB of RAM")
    val expected: u32 = if args.len > 5 then expected_u32(args[5]) else 0
    var core: rv.Cpu
    var good = true
    for round in 0..<3
        for i in 0..<riscv_ram.len do riscv_ram[i] = 0
        for i in 0..<image.len do riscv_ram[i] = image[i]
        rv.reset(&core, model, riscv_ram, 0, 0)
        core.halt_breakpoint = true
        core.halt_faults = true
        val start = monotonic()
        while core.stop == rv.Stop.Budget
            rv.run(&core, QUANTUM)
        val us = (monotonic() - start).us
        val mips = if us == 0 then 0.0 else real(core.retired) / real(us)
        print(s"${model.name}: ${core.retired} instructions in $us us, $mips MIPS, a0 = ${core.r[10]}, ${core.stop}")
        if core.stop != rv.Stop.Breakpoint || core.r[10] != expected
            print(s"  FAILED: expected a0 = $expected at EBREAK; pc = ${core.pc}, address = ${core.stop_at}")
            good = false
    if !good then exit(1)

expected_u32(text: string) -> u32
    val value = parse_long(text) match
        Ok(n) -> n
        Err(_) -> die(s"expected register value is not an integer: $text")
    if value < -2147483648 || value > 4294967295 then die(s"expected register value is outside 32 bits: $text")
    u32(value)
