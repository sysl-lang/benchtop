module sh.sysl.cortical

import sh.sysl.hocon.{Kind, Value, object_of, render}
import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}
import sysl.text.{StrBuilder, str_builder}

// A checked description, shown: as a summary for a person (`cortical check`), and as a file again.
//
// **`description_text` writes the model back as HOCON**, which is the model's own idea of sameness:
// two descriptions are the same when they are written identically. Spans, comments and the order a
// part's settings were written in are not part of a board; a part's `at`, `size` and `irq` keep the
// text they were written in (`0x40000000`, `1M`), since a reader of the file chose it. A product is
// written as its boards are named and overridden, not as the boards they name.

/** What `cortical check` prints for a description that checks clean: the board or the product, then
 * each part on a line with what it is, where it sits or what it is wired to, and whether cortical
 * emulates it.
 */
summary(d: Description, reg: Registry) -> string
    var out = str_builder()

    if d.form == ProductForm then
        val p = d.product
        val name = if p.name.is_empty() then "the product" else p.name

        out.push(s"$name: a product of ${counted(p.boards.len(), "board")}\n")

        var width = 0

        for i in p.boards
            if i.name.bytes.len > width then width = i.name.bytes.len

        for i in p.boards
            out.push(s"  board ${padded(i.name, width)}  ${i.of}: ${board_line(i.board, reg)}\n")

        part_lines(&out, p.parts, p.buses, reg)
        view_lines(&out, p.view, p.keys.len(), p.pointers.len())
    else
        val b = d.board
        val name = if b.name.is_empty() then "the board" else b.name

        out.push(s"$name: ${board_line(b, reg)}\n")
        part_lines(&out, b.parts, b.buses, reg)

        if !b.exposed_pins.is_empty() || !b.exposed_buses.is_empty() then
            var pins: Buf[int] = buf()
            var names: Buf[string] = buf()

            for e in b.exposed_pins do pins.push(e.pin)
            for e in b.exposed_buses do names.push(e.name)

            val both = if pins.is_empty() || names.is_empty() then "" else "; "

            out.push(s"  exposes ${if pins.is_empty() then "" else pin_ranges(pins)}$both${joined(names, ", ")}\n")

        view_lines(&out, b.view, b.keys.len(), b.pointers.len())
    end if

    out.finish()
end summary

// What a board is built around: `the rp2040 (…)`, or its cores.
private board_line(b: Board, reg: Registry) -> string
    if b.chip.is_empty() then return core_listing(b.cores)

    val about = reg.chip(b.chip) match
        Some(c) -> s" (${c.summary})"
        None -> ""

    s"the ${b.chip}$about"
end board_line

private part_lines(out: *StrBuilder, parts: Buf[Part], buses: Buf[Bus], reg: Registry)
    var width = 0
    var kinds = 0

    for p in parts
        if p.name.bytes.len > width then width = p.name.bytes.len
        if p.kind.bytes.len > kinds then kinds = p.kind.bytes.len

    for p in parts
        out.push(s"  ${padded(p.name, width)}  ${padded(p.kind, kinds)}  ${part_line(parts, p, reg)}\n")

    for bus in buses
        var sigs: Buf[string] = buf()

        for s in bus.signals do sigs.push(s"${s.name} = ${pin_name(s.pin)}")

        val name = if bus.board.is_empty() then bus.name else s"${bus.board}.${bus.name}"

        out.push(s"  bus $name: ${joined(sigs, ", ")}\n")
end part_lines

private view_lines(out: *StrBuilder, view: View, keys: usize, pointers: usize)
    if view.width > 0 || !view.elements.is_empty() then
        out.push(s"  view ${view.width} x ${view.height}, ${counted(view.elements.len(), "element")}\n")

    if keys > 0 || pointers > 0 then
        out.push(s"  input: ${counted(keys, "key")}, ${counted(pointers, "pointer binding")}\n")

// One part's line: its place on the bus or its wires, its parameters, and a word where it is not
// emulated.
private part_line(parts: Buf[Part], p: Part, reg: Registry) -> string
    var bits: Buf[string] = buf()

    p.at match
        Some(a) ->
            val size: long = p.size match
                Some(s) -> s.n
                None -> reg.part(p.kind) match
                    Some(spec) -> spec.window match
                        Some(w) -> w.size
                        None -> 0
                    None -> 0

            bits.push(if size > 0 then f"0x${a.n}%08x to 0x${a.n + size - 1}%08x" else f"at 0x${a.n}%08x")
        None -> ()

    p.irq match
        Some(q) -> bits.push(s"IRQ ${q.n}")
        None -> ()

    for w in p.wires do bits.push(s"${w.port} = ${target_text(w.to)}")
    for q in p.params do bits.push(s"${q.name} = ${setting_text(q.value)}")

    var line = joined(bits, ", ")

    reg.part(p.kind) match
        Some(spec) ->
            if !spec.modelled then
                line = s"$line (not modelled)"
            else
                for w in p.wires
                    w.to match
                        Port(other, _) ->
                            part_named(parts, other) match
                                Some(o) ->
                                    reg.part(o.kind) match
                                        Some(os) ->
                                            if !os.modelled then line = s"$line (driven through `$other`, which is not modelled)"
                                        None -> ()
                                None -> ()
                        _ -> ()
        None -> ()

    line
end part_line

// `two cortex-m0plus cores`, `a cortex-m0plus core`, `a cortex-m33 and a cortex-m0plus`.
private core_listing(cores: Buf[Core]) -> string
    if cores.is_empty() then return "no cores"

    var same = true

    for c in cores
        if c.name != cores.at(0).name then same = false

    val first = cores.at(0).name

    if same then
        return if cores.len() == 1 then s"${article_of(first)} $first core" else s"${number_word(cores.len())} $first cores"

    var names: Buf[string] = buf()

    for c in cores do names.push(c.name)

    s"cores ${joined(names, ", ")}"
end core_listing

private number_word(n: usize) -> string = n match
    2 -> "two"
    3 -> "three"
    4 -> "four"
    _ -> str(n)

private counted(n: usize, what: string) -> string = if n == 1 then s"1 $what" else s"$n ${what}s"

private padded(s: string, width: usize) -> string
    var out = str_builder()

    out.push(s)

    for i in s.bytes.len..<width do out.push(" ")

    out.finish()

private joined(xs: Buf[string], sep: string) -> string
    var out = str_builder()

    for i in 0..<xs.len()
        if i > 0 then out.push(sep)

        out.push(xs.at(i))

    out.finish()

// -- the description as a file ---------------------------------------------------------------------

/** The description as a file. Reading the text back and writing it again gives the same text. */
description_text(d: Description) -> string
    var top: Buf[(string, Value)] = buf()

    if d.form == ProductForm then
        top.push(("product", product_value(d.product)))
    elif !d.named.is_empty() then
        top.push(("board", reference(d.named)))
    else
        top.push(("board", board_value(d.board)))

    render(object_of(top))
end description_text

// A board named by another: a word for one built in, a quoted string for a file's path.
private reference(r: string) -> Value = if is_path(r) then str_value(r) else word(r)

private board_value(b: Board) -> Value
    var fs: Buf[(string, Value)] = buf()

    if !b.name.is_empty() then fs.push(("name", str_value(b.name)))
    if !b.chip.is_empty() then fs.push(("chip", word(b.chip)))

    if !b.cores.is_empty() then
        var cores: Buf[Value] = buf()

        for c in b.cores do cores.push(word(c.name))

        fs.push(("cores", value(Arr(cores))))

    if !b.parts.is_empty() then fs.push(("parts", parts_value(b.parts)))
    if !b.buses.is_empty() then fs.push(("buses", buses_value(b.buses)))

    if !b.exposed_pins.is_empty() || !b.exposed_buses.is_empty() then
        var ex: Buf[(string, Value)] = buf()

        if !b.exposed_pins.is_empty() then
            var pins: Buf[Value] = buf()

            for e in b.exposed_pins do pins.push(word(e.name))

            ex.push(("pins", value(Arr(pins))))

        if !b.exposed_buses.is_empty() then
            var buses: Buf[Value] = buf()

            for e in b.exposed_buses do buses.push(word(e.name))

            ex.push(("buses", value(Arr(buses))))

        fs.push(("exposes", object_of(ex)))
    end if

    face(&fs, b.view, b.keys, b.pointers)
    object_of(fs)
end board_value

private product_value(p: Product) -> Value
    var fs: Buf[(string, Value)] = buf()

    if !p.name.is_empty() then fs.push(("name", str_value(p.name)))

    var boards: Buf[(string, Value)] = buf()

    for i in p.boards
        var is: Buf[(string, Value)] = buf()

        is.push(("board", reference(i.of)))

        if !i.overrides.is_empty() then
            // Overrides of one part are written together, in the order the parts were first named.
            var parts: Buf[(string, Value)] = buf()
            var done: Buf[string] = buf()

            for o in i.overrides
                var seen = false

                for d in done
                    if d == o.part then seen = true

                if seen then continue

                done.push(o.part)

                var ps: Buf[(string, Value)] = buf()

                for q in i.overrides
                    if q.part == o.part then ps.push((q.param.name, setting_value(q.param.value)))

                parts.push((o.part, object_of(ps)))
            end for

            is.push(("parts", object_of(parts)))
        end if

        boards.push((i.name, object_of(is)))
    end for

    fs.push(("boards", object_of(boards)))

    if !p.parts.is_empty() then fs.push(("parts", parts_value(p.parts)))

    if !p.buses.is_empty() then
        // Each board's buses under the board's name, the boards in the order they first appear.
        var by_board: Buf[(string, Value)] = buf()
        var done: Buf[string] = buf()

        for bus in p.buses
            var seen = false

            for d in done
                if d == bus.board then seen = true

            if seen then continue

            done.push(bus.board)

            var its: Buf[Bus] = buf()

            for other in p.buses
                if other.board == bus.board then its.push(other)

            by_board.push((bus.board, buses_value(its)))
        end for

        fs.push(("buses", object_of(by_board)))
    end if

    face(&fs, p.view, p.keys, p.pointers)
    object_of(fs)
end product_value

private parts_value(ps: Buf[Part]) -> Value
    var parts: Buf[(string, Value)] = buf()

    for p in ps
        var fs: Buf[(string, Value)] = buf()

        fs.push(("part", word(p.kind)))
        amount_field(&fs, "at", p.at)
        amount_field(&fs, "size", p.size)
        amount_field(&fs, "irq", p.irq)

        for q in p.params do fs.push((q.name, setting_value(q.value)))

        if !p.wires.is_empty() then
            var ws: Buf[(string, Value)] = buf()

            for w in p.wires do ws.push((w.port, word(target_text(w.to))))

            fs.push(("wire", object_of(ws)))

        parts.push((p.name, object_of(fs)))
    end for

    object_of(parts)
end parts_value

private buses_value(bs: Buf[Bus]) -> Value
    var buses: Buf[(string, Value)] = buf()

    for bus in bs
        var sigs: Buf[(string, Value)] = buf()

        for s in bus.signals do sigs.push((s.name, word(pin_name(s.pin))))

        buses.push((bus.name, object_of(sigs)))

    object_of(buses)

// A board's or a product's view and input.
private face(fs: *Buf[(string, Value)], view: View, keys: Buf[KeyBinding], pointers: Buf[PointerBinding])
    if view.width > 0 || !view.elements.is_empty() then fs.push(("view", view_value(view)))

    if keys.is_empty() && pointers.is_empty() then return

    var input: Buf[(string, Value)] = buf()

    if !keys.is_empty() then
        var ks: Buf[(string, Value)] = buf()

        for k in keys
            ks.push((k.key, word(if k.control.is_empty() then k.part else s"${k.part}.${k.control}")))

        input.push(("keys", object_of(ks)))

    if !pointers.is_empty() then
        var ps: Buf[(string, Value)] = buf()

        for q in pointers do ps.push((q.element, word(q.part)))

        input.push(("pointer", object_of(ps)))

    fs.push(("input", object_of(input)))
end face

private view_value(view: View) -> Value
    var fs: Buf[(string, Value)] = buf()

    fs.push(("size", pair_value(view.width, view.height)))
    if !view.background.is_empty() then fs.push(("background", word(view.background)))

    var els: Buf[(string, Value)] = buf()

    for e in view.elements
        var es: Buf[(string, Value)] = buf()

        e.shows match
            ShowPart(name) -> es.push(("show", word(name)))
            Caption(t) -> es.push(("text", str_value(t)))
            Fill(c) -> es.push(("box", str_value(c)))

        es.push(("at", pair_value(e.x, e.y)))
        if e.has_size && !e.natural then es.push(("size", pair_value(e.w, e.h)))
        if !e.label.is_empty() then es.push(("label", str_value(e.label)))

        if !e.look.is_empty() then
            var look: Buf[(string, Value)] = buf()

            for q in e.look do look.push((q.name, setting_value(q.value)))

            es.push(("look", object_of(look)))

        els.push((e.name, object_of(es)))
    end for

    if !els.is_empty() then fs.push(("elements", object_of(els)))

    object_of(fs)
end view_value

private amount_field(fs: *Buf[(string, Value)], key: string, a: Option[Amount])
    a match
        Some(x) ->
            val text = if x.written.is_empty() then str(x.n) else x.written

            fs.push((key, if text == str(x.n) then value(Int(x.n, text)) else word(text)))
        None -> ()

private setting_value(s: Setting) -> Value = s match
    Whole(n) -> value(Int(n, ""))
    Number(x) -> value(Real(x, ""))
    Text(t) -> word(t)
    Flag(on) -> value(Bool(on))

private pair_value(a: int, b: int) -> Value
    var xs: Buf[Value] = buf()

    xs.push(value(Int(long(a), "")))
    xs.push(value(Int(long(b), "")))
    value(Arr(xs))

private value(k: Kind) -> Value = Value(Span(0, 0), k)
private word(s: string) -> Value = value(Word(s))
private str_value(s: string) -> Value = value(Str(s))
