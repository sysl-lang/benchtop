module sh.sysl.cortical.v6m
@tests

// DSP instruction cases always run through both decoders/executors, including disabled features.
private execute_dsp(kind: Kind, enabled: bool, code: []const u16, regs: []const u32, apsr: u32) -> Cpu
    var first: Cpu
    var second: Cpu
    for exec in [&run_match, &run_threaded]
        second.kind = kind
        prepare(&second, code, regs, apsr >> 28, [])
        second.dsp = enabled
        second.q = (apsr >> 27) & 1
        second.ge = if enabled then (apsr >> 16) & 15 else 0
        finish(&second, exec)
        if exec == &run_match
            first = second
        else
            for r in 0..<16 do assert(first.r[r] == second.r[r], s"DSP executors agree on r$r")
            assert(first.ge == second.ge && first.q == second.q && flags(&first) == flags(&second), "DSP flags agree")
            assert(first.stop == second.stop && first.pc == second.pc && first.retired == second.retired, "DSP stop agrees")
    end for
    second
end execute_dsp

@test("DSP packed arithmetic updates GE independently of NZCVQ; saturation and halving preserve GE and Q")
dsp_parallel_edges()
    // SADD8: negative, zero, positive, and signed overflow interpreted at the widened precision.
    var c = execute_dsp(Kind.V7em, true, [0xFA81, 0xF002], [0, 0x7FFF8000, 0x0101FF00], 0xB80F0000)
    assert(c.r[0] == 0x80007F00 && c.ge == 0xD && c.q == 1 && flags(&c) == 11, "signed GE uses widened sums")
    // UADD16 carries set both GE bits for their halfword.
    c = execute_dsp(Kind.V7em, true, [0xFA91, 0xF042], [0, 0xFFFF0001, 0x0001FFFF], 0)
    assert(c.r[0] == 0 && c.ge == 15 && c.q == 0, "unsigned carries")
    c = execute_dsp(Kind.V7em, true, [0xFAD1, 0xF042], [0, 0x00000001, 0x00010001], 0)
    assert(c.r[0] == 0xFFFF0000 && c.ge == 3, "no borrow includes equality")
    c = execute_dsp(Kind.V7em, true, [0xFA81, 0xF012], [0, 0x7F807F80, 0x01FF01FF], 0x000A0000)
    assert(c.r[0] == 0x7F807F80 && c.ge == 10 && c.q == 0, "packed saturation does not set Q")
    c = execute_dsp(Kind.V7em, true, [0xFAC1, 0xF062], [0, 0, 0x01010101], 0x08050000)
    assert(c.r[0] == 0xFFFFFFFF && c.ge == 5 && c.q == 1, "unsigned halving subtract retains the extended borrow bit")
end dsp_parallel_edges

@test("Q arithmetic saturates both stages and Q stays sticky; SSAT16/USAT16 cover zero and maximal widths")
dsp_saturation_edges()
    // QDADD r0,r1,r2: the doubled second operand saturates before adding -1.
    var c = execute_dsp(Kind.V7em, true, [0xFA82, 0xF091], [0, 0xFFFFFFFF, 0x40000000], 0x30090000)
    assert(c.r[0] == 0x7FFFFFFE && c.q == 1 && c.ge == 9 && flags(&c) == 3, "double saturates separately")
    c = execute_dsp(Kind.V7em, true, [0xFA82, 0xF081], [0, 1, 2], 0x08000000)
    assert(c.r[0] == 3 && c.q == 1, "Q sticky without overflow")
    c = execute_dsp(Kind.V7em, true, [0xF321, 0x0000], [0, 0x80007FFF], 0)
    assert(c.r[0] == 0xFFFF0000 && c.q == 1, "signed one-bit limits")
    c = execute_dsp(Kind.V7em, true, [0xF321, 0x000F], [0, 0x80007FFF], 0)
    assert(c.r[0] == 0x80007FFF && c.q == 0, "signed full halfword")
    c = execute_dsp(Kind.V7em, true, [0xF3A1, 0x0000], [0, 0xFFFF7FFF], 0)
    assert(c.r[0] == 0 && c.q == 1, "unsigned zero-width saturation")
    c = execute_dsp(Kind.V7em, true, [0xF3A1, 0x000F], [0, 0xFFFF7FFF], 0)
    assert(c.r[0] == 0x00007FFF && c.q == 1, "unsigned negative lane clamps to zero")
end dsp_saturation_edges

@test("GE writes and reads select bytes; APSR masks preserve independent flag groups")
dsp_apsr_masks()
    // MSR APSR_g,r3; SEL r0,r1,r2; MRS r4,APSR. NZCVQ unaffected by a GE-only write.
    var c = execute_dsp(Kind.V7em, true, [0xF383, 0x8400, 0xFAA1, 0xF082, 0xF3EF, 0x8400], [0, 0x11223344, 0xAABBCCDD, 0x00050000], 0xB80A0000)
    assert(c.r[0] == 0xAA22CC44 && c.r[4] == 0xB8050000, "GE-only write and SEL")
    c = execute_dsp(Kind.V7em, true, [0xF383, 0x8800], [0, 0, 0, 0], 0xB80A0000)
    assert(c.ge == 10 && c.q == 0 && flags(&c) == 0, "NZCVQ-only write leaves GE")
    c = execute_dsp(Kind.V7em, true, [0xF383, 0x8C00], [0, 0, 0, 0x480F0000], 0)
    assert(c.ge == 15 && c.q == 1 && flags(&c) == 4, "combined write")
    c = execute_dsp(Kind.V7em, false, [0xF383, 0x8400, 0xF3EF, 0x8400], [0, 0, 0, 0x000F0000], 0)
    assert(c.ge == 0 && c.r[4] == 0, "GE read as zero and writes ignored without DSP")
end dsp_apsr_masks

@test("DSP instructions obey IT predicates, overlap operands, preserve Q in long multiplies and wrap 64-bit accumulators")
dsp_control_edges()
    var c = execute_dsp(Kind.V7em, true, [0xBF08, 0xFA81, 0xF002], [99, 1, 2], 0)
    assert(c.r[0] == 99 && c.retired == 2 && c.ge == 0, "failed condition skips DSP")
    c = execute_dsp(Kind.V7em, false, [0xBF08, 0xFA81, 0xF002], [99, 1, 2], 0)
    assert(c.r[0] == 99 && c.stop == Stop.Breakpoint && c.retired == 2, "failed condition skips disabled DSP")
    c = execute_dsp(Kind.V7em, true, [0xBF08, 0xFA81, 0xF102], [0, 1, 2], 0x40000000)
    assert(c.r[1] == 3 && c.ge == 15 && flags(&c) == 4, "passed condition and destination overlap")
    // SMLALD r0,r3,r1,r2 with all-one accumulator wraps to zero.
    c = execute_dsp(Kind.V7em, true, [0xFBC1, 0x03C2], [0xFFFFFFFF, 1, 1, 0xFFFFFFFF], 0x08090000)
    assert(c.r[0] == 0 && c.r[3] == 0 && c.q == 1 && c.ge == 9, "64-bit wrap leaves flags")
    // SMUAD has the one non-accumulating dual product overflow: (-32768)^2 twice.
    c = execute_dsp(Kind.V7em, true, [0xFB21, 0xF002], [0, 0x80008000, 0x80008000], 0)
    assert(c.r[0] == 0x80000000 && c.q == 1, "dual product Q overflow")
end dsp_control_edges

@test("exceptions stack and restore GE independently of handler arithmetic")
dsp_exception_ge()
    for exec in [&run_match, &run_threaded]
        var c: Cpu
        c.kind = Kind.V7em
        // SVC; MRS r0,APSR. Handler: MSR APSR_g,r3; BX LR.
        machine(&c, [0xDF00, 0xF3EF, 0x8000], [0, 0, 0, 0x000A0000], 0, [[SVCALL, 0x100]], &nothing)
        store16(&c, 0x100, 0xF383)
        store16(&c, 0x102, 0x8400)
        store16(&c, 0x104, 0x4770)
        c.dsp = true
        c.ge = 5
        finish(&c, exec)
        assert(c.stop == Stop.Breakpoint && c.ge == 5 && c.r[0] == 0x00050000, "return restores stacked GE")
        assert(load32(&c, 0x1FFC) & 0x000F0000 == 0x00050000, "GE stored in xPSR frame")
    end for
end dsp_exception_ge

