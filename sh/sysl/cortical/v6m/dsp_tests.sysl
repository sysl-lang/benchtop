@test("every DSP encoding rejects disabled extensions and incapable models without retiring or changing flags")
dsp_gating()
    for model in MODELS
        for code in dsp_encodings
            var c = execute_dsp(model.kind, false, code, [99, 1, 2, 3], 0xB8000000)
            assert(c.stop == Stop.Undefined && c.pc == 0 && c.retired == 0 && c.r[0] == 99 && c.q == 1 && flags(&c) == 11, "disabled DSP")
            if !model.dsp
                c = execute_dsp(model.kind, true, code, [99, 1, 2, 3], 0xB80A0000)
                assert(c.stop == Stop.Undefined && c.retired == 0 && c.r[0] == 99 && c.ge == 10, "model has no DSP")
    end for
end dsp_gating

@test("DSP rejects SP/PC destinations and SP sources, reserved saturation widths and overlapping long destinations")
dsp_invalid_encodings()
    for code in dsp_encodings
        for destination in [u16(13), u16(15)]
            val invalid: [2]u16 = [code[0], (code[1] & 0xF0FF) | (destination << 8)]
            var c = execute_dsp(Kind.V7em, true, invalid, [99, 1, 2, 3], 0x080A0000)
            assert(c.stop == Stop.Undefined && c.retired == 0 && c.r[0] == 99 && c.ge == 10 && c.q == 1, "bad destination")
        // Saturation encodes its immediate where the other families encode Rm.
        if code[0] & 0xFF00 != 0xF300
            for source in [u16(13), u16(15)]
                val invalid: [2]u16 = [code[0], (code[1] & 0xFFF0) | source]
                var c = execute_dsp(Kind.V7em, true, invalid, [99, 1, 2, 3], 0)
                assert(c.stop == Stop.Undefined && c.retired == 0 && c.r[0] == 99, "bad Rm source")
        val invalid: [2]u16 = [(code[0] & 0xFFF0) | 13, code[1]]
        var c = execute_dsp(Kind.V7em, true, invalid, [99, 1, 2, 3], 0)
        assert(c.stop == Stop.Undefined && c.retired == 0, "SP source")
    end for
    val invalid: [8][2]u16 = [[0xF321, 0x0010], [0xF3A1, 0x001F], [0xFA91, 0xF032], [0xFA91, 0xF072],
        [0xFBC1, 0x00C2], [0xFBE1, 0x0062], [0xFB61, 0xF002], [0xFB11, 0xD002]]
    for code in invalid
        var c = execute_dsp(Kind.V7em, true, code, [99, 1, 2, 3], 0)
        assert(c.stop == Stop.Undefined && c.retired == 0 && c.r[0] == 99, "reserved encoding")
end dsp_invalid_encodings

@test("a cached DSP instruction cannot bypass another core's disabled extension in either execution engine")
dsp_shared_decode()
    for first_exec in [&run_match, &run_threaded]
        for second_exec in [&run_match, &run_threaded]
            var first: Cpu
            var second: Cpu
            first.kind = Kind.V7em
            prepare(&first, [0xFA81, 0xF002], [99, 1, 2], 0, [])
            first.dsp = true
            finish(&first, first_exec)
            assert(first.r[0] == 3 && first.stop == Stop.Breakpoint, "enabled core populates decode cache")
            second.kind = Kind.V7em
            clear(&second, 0)
            second.r[0] = 99
            second.r[1] = 1
            second.r[2] = 2
            finish(&second, second_exec)
            assert(second.r[0] == 99 && second.ge == 0 && second.stop == Stop.Undefined && second.retired == 0, "disabled core uses same cached record safely")
    end for
end dsp_shared_decode
