module sh.sysl.cortical.v6m
@tests

// Independent condition oracle: NZCV is a nibble. No use of the interpreter's holds().
private select_condition(nzcv: u32, condition: u32) -> bool
    val n = nzcv & 8 != 0
    val z = nzcv & 4 != 0
    val c = nzcv & 2 != 0
    val v = nzcv & 1 != 0

    condition match
        0 -> z
        1 -> !z
        2 -> c
        3 -> !c
        4 -> n
        5 -> !n
        6 -> v
        7 -> !v
        8 -> c && !z
        9 -> !c || z
        10 -> n == v
        11 -> n != v
        12 -> !z && n == v
        13 -> z || n != v
        _ -> true
end select_condition

private select_want(operation: u32, nzcv: u32, condition: u32, left: u32, right: u32) -> u32
    if select_condition(nzcv, condition) then return left
    operation match
        1 -> right + 1
        2 -> ~right
        3 -> 0 - right
        _ -> right

@test("CSEL/CSINC/CSINV/CSNEG cover all conditions and representable flag states on M52/M55/M85 under both executors")
v81_select_conditions()
    for kind in [Kind.M52, Kind.M55, Kind.M85]
        for operation in 0u32..3
            for condition in 0u32..13
                for nzcv in 0u32..11
                    val code: [2]u16 = [0xEA51, u16(0x8002 | (operation << 12) | (condition << 4))]
                    var c = execute_thumb2(kind, code, [99, 0x12345678, 0x80000000], nzcv, [])
                    assert(c.stop == Stop.Breakpoint && c.retired == 1 && c.r[0] == select_want(operation, nzcv, condition, 0x12345678, 0x80000000), "select result")
                    assert(flags(&c) == nzcv && c.r[1] == 0x12345678 && c.r[2] == 0x80000000, "flags and sources unchanged")
end v81_select_conditions

@test("conditional selects wrap at word boundaries, permit overlapping registers, use ZR instead of PC and preserve Q")
v81_select_boundaries()
    val values: [5]u32 = [0, 1, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF]
    for operation in 0u32..3
        for left in values
            for right in values
                for nzcv in [u32(0), u32(4)]
                    for dest in [u16(1), u16(2)]
                        val code: [2]u16 = [0xEA51, u16(0x8002 | (operation << 12) | (u32(dest) << 8))]
                        var c = execute_thumb2(Kind.M55, code, [0, left, right], nzcv, [])
                        assert(c.stop == Stop.Breakpoint && c.r[dest] == select_want(operation, nzcv, 0, left, right), "overlap and wrapping")
    end for

    for operation in 0u32..3
        val code: [2]u16 = [0xEA5F, u16(0x800F | (operation << 12))]
        var c = execute_thumb2(Kind.M55, code, [], 0, [])
        assert(c.stop == Stop.Breakpoint && c.r[0] == select_want(operation, 0, 0, 0, 0), "ZR aliases including CSET/CSETM")
    end for

    // MSR APSR_nzcvq, r3; CSNEG r0, r1, r2, EQ. Q must stay set even on the negation path.
    var c = execute_thumb2(Kind.M55, [0xF383, 0x8800, 0xEA51, 0xB002], [99, 7, 1, 0x08000000], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 0xFFFFFFFF && c.q == 1 && flags(&c) == 0, "Q unchanged")
    c = execute_thumb2(Kind.M55, [0xEA59, 0x880A], [0, 0, 0, 0, 0, 0, 0, 0, 0, 42, 99], 4, [])
    assert(c.stop == Stop.Breakpoint && c.r[8] == 42, "high registers")
end v81_select_boundaries

@test("conditional selects reject SP operands, PC destinations, AL/NV, IT blocks and every older architecture")
v81_select_rejected()
    val bad: [6][2]u16 = [[0xEA51, 0x8D02], [0xEA51, 0x8F02], [0xEA5D, 0x8002], [0xEA51, 0x800D], [0xEA51, 0x80E2], [0xEA51, 0x80F2]]
    for kind in [Kind.M52, Kind.M55, Kind.M85]
        for code in bad
            var c = execute_thumb2(kind, code, [99, 7, 9], 0, [])
            assert(c.stop == Stop.Undefined && c.retired == 0 && c.r[0] == 99, "reserved operand or condition")
        var c = execute_thumb2(kind, [0xBF08, 0xEA51, 0x8002], [99, 7, 9], 4, [])
        assert(c.stop == Stop.Undefined && c.retired == 1 && c.r[0] == 99, "not allowed inside IT")
    end for

    for model in MODELS
        if is_v81m(model.kind) then continue
        for operation in 0u32..3
            var c = execute_thumb2(model.kind, [0xEA51, u16(0x8002 | (operation << 12))], [99, 7, 9], 4, [])
            assert(c.stop == Stop.Undefined && c.retired == 0 && c.r[0] == 99, "not reinterpreted as an older shifted-register instruction")
end v81_select_rejected

@test("unimplemented low-overhead loops, long shifts, MVE and floating point stop explicitly on all models")
v81_unimplemented_extensions()
    // GNU assembler encodings for DLS, LE, WLS, LSLL, LSRL, ASRL, VADD.I32 and VADD.F32.
    val code: [8][2]u16 = [[0xF040, 0xE001], [0xF00F, 0xC005], [0xF040, 0xC00B],
        [0xEA50, 0x014F], [0xEA50, 0x015F], [0xEA50, 0x016F], [0xEF22, 0x0844], [0xEE30, 0x0A81]]
    for model in MODELS
        for instruction in code
            var c = execute_thumb2(model.kind, instruction, [99, 7, 9], 0, [])
            assert(c.stop == Stop.Undefined && c.retired == 0 && c.r[0] == 99, "unsupported extension must not execute")
end v81_unimplemented_extensions
