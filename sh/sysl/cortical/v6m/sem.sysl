module sh.sysl.cortical.v6m

// What each straight-line instruction does, written once. Both executors call these; they differ
// only in how they reach the next record. Each is inlined into its caller, so the threaded handler
// for `ANDS` is the body below and a jump.
//
// An instruction that reaches memory also takes `n`, the count of instructions retired before it,
// which is the time its access happens at: the system timer's registers answer by it (except.sysl).

@inline
reg(cpu: *Cpu, n: u4) -> u32 = cpu.r[n]

@inline
put(cpu: *Cpu, n: u4, x: u32)
    cpu.r[n] = x

@inline
x_lsl_imm(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, lsl_reg(cpu, reg(cpu, i.b), i.imm)))

@inline
x_lsr_imm(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, lsr_reg(cpu, reg(cpu, i.b), i.imm)))

@inline
x_asr_imm(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, asr_reg(cpu, reg(cpu, i.b), i.imm)))

// Record `res` as the N and Z result, and answer it.
@inline
nz_of(cpu: *Cpu, res: u32) -> u32
    cpu.nz = res
    res

@inline
x_adds_reg(cpu: *Cpu, i: *Insn) = put(cpu, i.a, add_flags(cpu, reg(cpu, i.b), reg(cpu, i.c), 0))

@inline
x_subs_reg(cpu: *Cpu, i: *Insn) = put(cpu, i.a, sub_flags(cpu, reg(cpu, i.b), reg(cpu, i.c), 1))

@inline
x_adds_imm(cpu: *Cpu, i: *Insn) = put(cpu, i.a, add_flags(cpu, reg(cpu, i.b), i.imm, 0))

@inline
x_subs_imm(cpu: *Cpu, i: *Insn) = put(cpu, i.a, sub_flags(cpu, reg(cpu, i.b), i.imm, 1))

@inline
x_movs_reg(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, reg(cpu, i.b)))

@inline
x_movs_imm(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, i.imm))

@inline
x_cmp_imm(cpu: *Cpu, i: *Insn)
    sub_flags(cpu, reg(cpu, i.a), i.imm, 1)

@inline
x_ands(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, reg(cpu, i.a) & reg(cpu, i.b)))

@inline
x_eors(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, reg(cpu, i.a) ^ reg(cpu, i.b)))

@inline
x_orrs(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, reg(cpu, i.a) | reg(cpu, i.b)))

@inline
x_bics(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, reg(cpu, i.a) & ~reg(cpu, i.b)))

@inline
x_mvns(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, ~reg(cpu, i.b)))

@inline
x_muls(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, reg(cpu, i.a) * reg(cpu, i.b)))

@inline
x_lsls_reg(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, lsl_reg(cpu, reg(cpu, i.a), reg(cpu, i.b))))

@inline
x_lsrs_reg(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, lsr_reg(cpu, reg(cpu, i.a), reg(cpu, i.b))))

@inline
x_asrs_reg(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, asr_reg(cpu, reg(cpu, i.a), reg(cpu, i.b))))

@inline
x_rors(cpu: *Cpu, i: *Insn) = put(cpu, i.a, nz_of(cpu, ror_reg(cpu, reg(cpu, i.a), reg(cpu, i.b))))

@inline
x_adcs(cpu: *Cpu, i: *Insn) = put(cpu, i.a, add_flags(cpu, reg(cpu, i.a), reg(cpu, i.b), cpu.c))

@inline
x_sbcs(cpu: *Cpu, i: *Insn) = put(cpu, i.a, sub_flags(cpu, reg(cpu, i.a), reg(cpu, i.b), cpu.c))

@inline
x_negs(cpu: *Cpu, i: *Insn) = put(cpu, i.a, sub_flags(cpu, 0, reg(cpu, i.b), 1))

@inline
x_tst(cpu: *Cpu, i: *Insn)
    cpu.nz = reg(cpu, i.a) & reg(cpu, i.b)

@inline
x_cmp_reg(cpu: *Cpu, i: *Insn)
    sub_flags(cpu, reg(cpu, i.a), reg(cpu, i.b), 1)

@inline
x_cmn(cpu: *Cpu, i: *Insn)
    add_flags(cpu, reg(cpu, i.a), reg(cpu, i.b), 0)

@inline
x_add_hi(cpu: *Cpu, i: *Insn) = put(cpu, i.a, reg(cpu, i.a) + reg(cpu, i.b))

@inline
x_mov_hi(cpu: *Cpu, i: *Insn) = put(cpu, i.a, reg(cpu, i.b))

@inline
x_add_imm(cpu: *Cpu, i: *Insn) = put(cpu, i.a, reg(cpu, i.b) + i.imm)

@inline
x_load_const(cpu: *Cpu, i: *Insn) = put(cpu, i.a, i.imm)

@inline
x_ldr_lit(cpu: *Cpu, i: *Insn, n: u64) = put(cpu, i.a, read32(cpu, i.imm, n))

@inline
ea_reg(cpu: *Cpu, i: *Insn) -> u32 = reg(cpu, i.b) + reg(cpu, i.c)

@inline
ea_imm(cpu: *Cpu, i: *Insn) -> u32 = reg(cpu, i.b) + i.imm

@inline
x_str_reg(cpu: *Cpu, i: *Insn, n: u64) = write32(cpu, ea_reg(cpu, i), reg(cpu, i.a), n)

@inline
x_strh_reg(cpu: *Cpu, i: *Insn, n: u64) = write16(cpu, ea_reg(cpu, i), reg(cpu, i.a), n)

@inline
x_strb_reg(cpu: *Cpu, i: *Insn, n: u64) = write8(cpu, ea_reg(cpu, i), reg(cpu, i.a), n)

@inline
x_ldrsb_reg(cpu: *Cpu, i: *Insn, n: u64) = put(cpu, i.a, sext(read8(cpu, ea_reg(cpu, i), n), 8))

@inline
x_ldr_reg(cpu: *Cpu, i: *Insn, n: u64) = put(cpu, i.a, read32(cpu, ea_reg(cpu, i), n))

@inline
x_ldrh_reg(cpu: *Cpu, i: *Insn, n: u64) = put(cpu, i.a, read16(cpu, ea_reg(cpu, i), n))

@inline
x_ldrb_reg(cpu: *Cpu, i: *Insn, n: u64) = put(cpu, i.a, read8(cpu, ea_reg(cpu, i), n))

@inline
x_ldrsh_reg(cpu: *Cpu, i: *Insn, n: u64) = put(cpu, i.a, sext(read16(cpu, ea_reg(cpu, i), n), 16))

@inline
x_str_imm(cpu: *Cpu, i: *Insn, n: u64) = write32(cpu, ea_imm(cpu, i), reg(cpu, i.a), n)

@inline
x_ldr_imm(cpu: *Cpu, i: *Insn, n: u64) = put(cpu, i.a, read32(cpu, ea_imm(cpu, i), n))

@inline
x_strb_imm(cpu: *Cpu, i: *Insn, n: u64) = write8(cpu, ea_imm(cpu, i), reg(cpu, i.a), n)

@inline
x_ldrb_imm(cpu: *Cpu, i: *Insn, n: u64) = put(cpu, i.a, read8(cpu, ea_imm(cpu, i), n))

@inline
x_strh_imm(cpu: *Cpu, i: *Insn, n: u64) = write16(cpu, ea_imm(cpu, i), reg(cpu, i.a), n)

@inline
x_ldrh_imm(cpu: *Cpu, i: *Insn, n: u64) = put(cpu, i.a, read16(cpu, ea_imm(cpu, i), n))

@inline
x_sxth(cpu: *Cpu, i: *Insn) = put(cpu, i.a, sext(reg(cpu, i.b), 16))

@inline
x_sxtb(cpu: *Cpu, i: *Insn) = put(cpu, i.a, sext(reg(cpu, i.b), 8))

@inline
x_uxth(cpu: *Cpu, i: *Insn) = put(cpu, i.a, reg(cpu, i.b) & 0xFFFF)

@inline
x_uxtb(cpu: *Cpu, i: *Insn) = put(cpu, i.a, reg(cpu, i.b) & 0xFF)

@inline
x_rev(cpu: *Cpu, i: *Insn)
    val x = reg(cpu, i.b)

    put(cpu, i.a, (x >> 24) | ((x >> 8) & 0xFF00) | ((x << 8) & 0xFF0000) | (x << 24))

@inline
x_rev16(cpu: *Cpu, i: *Insn)
    val x = reg(cpu, i.b)

    put(cpu, i.a, ((x >> 8) & 0x00FF00FF) | ((x << 8) & 0xFF00FF00))

@inline
x_revsh(cpu: *Cpu, i: *Insn)
    val x = reg(cpu, i.b)

    put(cpu, i.a, sext(((x >> 8) & 0xFF) | ((x & 0xFF) << 8), 16))

// The registers named by `list`, lowest first, to and from consecutive words from `at`.
@inline
count(list: u32) -> u32
    var n: u32 = 0
    var l = list

    while l != 0
        n += l & 1
        l >>= 1

    n

x_push(cpu: *Cpu, i: *Insn, n: u64)
    var at = cpu.r[13] - 4 * count(i.imm)

    cpu.r[13] = at

    for k in 0..<15
        if (i.imm >> k) & 1 != 0
            write32(cpu, at, cpu.r[k], n)
            at += 4

x_pop(cpu: *Cpu, i: *Insn, n: u64)
    var at = cpu.r[13]

    for k in 0..<8
        if (i.imm >> k) & 1 != 0
            cpu.r[k] = read32(cpu, at, n)
            at += 4

    cpu.r[13] = at

x_stm(cpu: *Cpu, i: *Insn, n: u64)
    var at = reg(cpu, i.a)

    for k in 0..<8
        if (i.imm >> k) & 1 != 0
            write32(cpu, at, cpu.r[k], n)
            at += 4

    put(cpu, i.a, at)

x_ldm(cpu: *Cpu, i: *Insn, n: u64)
    var at = reg(cpu, i.a)

    for k in 0..<8
        if (i.imm >> k) & 1 != 0
            cpu.r[k] = read32(cpu, at, n)
            at += 4

    if (i.imm >> i.a) & 1 == 0 then put(cpu, i.a, at)
