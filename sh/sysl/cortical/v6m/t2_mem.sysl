module sh.sysl.cortical.v6m
@tests

// The ARMv8-M Mainline loads and stores, exclusives and branches, against the ARMv8-M ARM's pseudocode
// for each, under both executors (`execute8`, t2_insns.sysl).

// The machine `execute8` answers after `code` from `regs` and `mem`, stopped at its breakpoint.
ran8(code: []const u16, regs: []const u32, mem: [][2]u32) -> Cpu
    val c = execute8(code, regs, 0, mem)

    assert(c.stop == Stop.Breakpoint, s"stopped at ${c.stop}, 0x${c.stop_at}")
    c

// Whether register `r` of `c` holds `want`, saying what it holds where it does not.
holds_reg(c: *Cpu, r: u4, want: u32) -> bool
    if c.r[r] == want then return true

    print(f"r$r = 0x${c.r[r]}%08x, not 0x$want%08x")
    false

// Whether the word at `a` holds `want`.
holds_word(c: *Cpu, a: u32, want: u32) -> bool
    if load32(c, a) == want then return true

    print(f"[0x$a%x] = 0x${load32(c, a)}%08x, not 0x$want%08x")
    false

// The bytes at 0x1000 are 80 7F 81 80, and the next words 0x11111111, 0x22222222, 0x33333333.
val bytes: [][2]u32 = [[0x1000, 0x80817F80], [0x1004, 0x11111111], [0x1008, 0x22222222], [0x100C, 0x33333333]]

@test("LDR with a 12-bit offset, a negative 8-bit one, and pre- and post-indexed writeback")
t2m_ldr()
    // ldr.w r0, [r1, #4092]
    var c = ran8([0xF8D1, 0x0FFC], [0, 0x1000], [[0x1FFC, 0xCAFEF00D]])
    assert(holds_reg(&c, 0, 0xCAFEF00D), "imm12")
    // ldr r0, [r1, #-255]
    c = ran8([0xF851, 0x0CFF], [0, 0x1103], bytes)
    assert(holds_reg(&c, 0, 0x11111111) && holds_reg(&c, 1, 0x1103), "negative imm8, no writeback")
    // ldr r0, [r1, #-4]!
    c = ran8([0xF851, 0x0D04], [0, 0x1008], bytes)
    assert(holds_reg(&c, 0, 0x11111111) && holds_reg(&c, 1, 0x1004), "pre-indexed")
    // ldr r0, [r1], #4
    c = ran8([0xF851, 0x0B04], [0, 0x1004], bytes)
    assert(holds_reg(&c, 0, 0x11111111) && holds_reg(&c, 1, 0x1008), "post-indexed")
    // ldrt r0, [r1, #4]: unprivileged, the same access here
    c = ran8([0xF851, 0x0E04], [0, 0x1000], bytes)
    assert(holds_reg(&c, 0, 0x11111111), "LDRT")

@test("the byte and halfword loads zero- or sign-extend, with every addressing")
t2m_ldr_narrow()
    // ldrb.w r0, [r1, #1]; ldrsb.w r0, [r1, #1]
    var c = ran8([0xF891, 0x0001], [0, 0x1000], bytes)
    assert(holds_reg(&c, 0, 0x7F), "LDRB")
    c = ran8([0xF991, 0x0001], [0, 0x1000], bytes)
    assert(holds_reg(&c, 0, 0x7F), "LDRSB positive")
    // ldrsb r0, [r1, #-1]
    c = ran8([0xF911, 0x0C01], [0, 0x1001], bytes)
    assert(holds_reg(&c, 0, 0xFFFFFF80), "LDRSB negative")
    // ldrh.w r0, [r1, #2]; ldrsh.w r0, [r1, #2]
    c = ran8([0xF8B1, 0x0002], [0, 0x1000], bytes)
    assert(holds_reg(&c, 0, 0x8081), "LDRH")
    c = ran8([0xF9B1, 0x0002], [0, 0x1000], bytes)
    assert(holds_reg(&c, 0, 0xFFFF8081), "LDRSH")
    // ldrsh r0, [r1], #-2
    c = ran8([0xF931, 0x0902], [0, 0x1002], bytes)
    assert(holds_reg(&c, 0, 0xFFFF8081) && holds_reg(&c, 1, 0x1000), "LDRSH post-indexed")
    // ldr.w r0, [r1, r2, lsl #2]; ldrsb.w r0, [r1, r2]
    c = ran8([0xF851, 0x0022], [0, 0x1000, 3], bytes)
    assert(holds_reg(&c, 0, 0x33333333), "register LSL #2")
    c = ran8([0xF911, 0x0002], [0, 0x1000, 3], bytes)
    assert(holds_reg(&c, 0, 0xFFFFFF80), "LDRSB register")

@test("the stores write their width at the address their addressing gives, and write back")
t2m_str()
    val x: u32 = 0x11223344
    // str.w r0, [r1, #8]
    var c = ran8([0xF8C1, 0x0008], [x, 0x1000], [])
    assert(holds_word(&c, 0x1008, x), "STR")
    // strb.w r0, [r1, #3]
    c = ran8([0xF881, 0x0003], [x, 0x1000], [])
    assert(holds_word(&c, 0x1000, 0x44000000), "STRB")
    // strh.w r0, [r1, #-2]
    c = ran8([0xF821, 0x0C02], [x, 0x1006], [])
    assert(holds_word(&c, 0x1004, 0x3344) && holds_reg(&c, 1, 0x1006), "STRH negative")
    // str r0, [r1, #-4]!
    c = ran8([0xF841, 0x0D04], [x, 0x1010], [])
    assert(holds_word(&c, 0x100C, x) && holds_reg(&c, 1, 0x100C), "STR pre-indexed")
    // strb r0, [r1], #1
    c = ran8([0xF801, 0x0B01], [x, 0x1000], [])
    assert(holds_word(&c, 0x1000, 0x44) && holds_reg(&c, 1, 0x1001), "STRB post-indexed")
    // strh.w r0, [r1, r2, lsl #1]
    c = ran8([0xF821, 0x0012], [x, 0x1000, 2], [])
    assert(holds_word(&c, 0x1004, 0x3344), "STRH register")
    // strbt r0, [r1, #4]
    c = ran8([0xF801, 0x0E04], [x, 0x1000], [])
    assert(holds_word(&c, 0x1004, 0x44), "STRBT")
    // str r0, [sp, #-4]!: a push of one register
    c = ran8([0xF84D, 0x0D04], [x], [])
    assert(holds_word(&c, 0x1FFC, x) && holds_reg(&c, 13, 0x1FFC), "single push")

@test("the literal loads read from the instruction's word-aligned address plus 4, either way")
t2m_literal()
    // ldr.w r0, [pc, #16]
    var c = ran8([0xF8DF, 0x0010], [], [[0x14, 0xDEADBEEF]])
    assert(holds_reg(&c, 0, 0xDEADBEEF), "LDR")
    // ldrsh.w r2, [pc, #8]
    c = ran8([0xF9BF, 0x2008], [], [[0xC, 0x8001]])
    assert(holds_reg(&c, 2, 0xFFFF8001), "LDRSH")
    // ldrb.w r1, [pc, #12]
    c = ran8([0xF89F, 0x100C], [], [[0x10, 0x1FF]])
    assert(holds_reg(&c, 1, 0xFF), "LDRB")
    // ldrd r4, r5, [pc, #4]
    c = ran8([0xE9DF, 0x4501], [], [[8, 1], [0xC, 2]])
    assert(holds_reg(&c, 4, 1) && holds_reg(&c, 5, 2), "LDRD")
    // ldr.w r6, [pc, #-4]: the instruction's own word
    c = ran8([0xF85F, 0x6004], [], [])
    assert(holds_reg(&c, 6, 0x6004F85F), "LDR backwards")

@test("LDRD and STRD: offset, post-indexed and pre-indexed")
t2m_dual()
    // ldrd r0, r2, [r1, #8]
    var c = ran8([0xE9D1, 0x0202], [0, 0x1000], bytes)
    assert(holds_reg(&c, 0, 0x22222222) && holds_reg(&c, 2, 0x33333333) && holds_reg(&c, 1, 0x1000), "offset")
    // ldrd r0, r2, [r1], #-8
    c = ran8([0xE871, 0x0202], [0, 0x1008], bytes)
    assert(holds_reg(&c, 0, 0x22222222) && holds_reg(&c, 2, 0x33333333) && holds_reg(&c, 1, 0x1000), "post-indexed")
    // strd r0, r2, [r1, #-8]!
    c = ran8([0xE961, 0x0202], [5, 0x1010, 6], [])
    assert(holds_word(&c, 0x1008, 5) && holds_word(&c, 0x100C, 6) && holds_reg(&c, 1, 0x1008), "pre-indexed")

@test("LDM and STM, increment-after and decrement-before, with and without writeback")
t2m_multiple()
    // ldmia.w r1!, {r2, r3, r4}
    var c = ran8([0xE8B1, 0x001C], [0, 0x1000], bytes)
    assert(holds_reg(&c, 2, 0x80817F80) && holds_reg(&c, 4, 0x22222222) && holds_reg(&c, 1, 0x100C), "LDMIA!")
    // ldmdb r1!, {r2, r3}
    c = ran8([0xE931, 0x000C], [0, 0x1010], bytes)
    assert(holds_reg(&c, 2, 0x22222222) && holds_reg(&c, 3, 0x33333333) && holds_reg(&c, 1, 0x1008), "LDMDB!")
    // stmia.w r1!, {r2, r4}
    c = ran8([0xE8A1, 0x0014], [0, 0x1000, 7, 0, 9], [])
    assert(holds_word(&c, 0x1000, 7) && holds_word(&c, 0x1004, 9) && holds_reg(&c, 1, 0x1008), "STMIA!")
    // stmdb r1, {r2, r3}: no writeback
    c = ran8([0xE901, 0x000C], [0, 0x1010, 7, 8], [])
    assert(holds_word(&c, 0x1008, 7) && holds_word(&c, 0x100C, 8) && holds_reg(&c, 1, 0x1010), "STMDB")
    // push.w {r4, r8, lr}, then pop.w {r4, r8, lr} with them cleared between
    c = ran8([0xE92D, 0x4110], [0, 0, 0, 0, 4, 0, 0, 0, 8, 0, 0, 0, 0, 0x2000, 14], [])
    assert(holds_word(&c, 0x1FF4, 4) && holds_word(&c, 0x1FF8, 8) && holds_word(&c, 0x1FFC, 14) && holds_reg(&c, 13, 0x1FF4), "PUSH.W")
    c = ran8([0xE8BD, 0x4110], [], [[0x2000, 4], [0x2004, 8], [0x2008, 14]])
    assert(holds_reg(&c, 4, 4) && holds_reg(&c, 8, 8) && holds_reg(&c, 14, 14) && holds_reg(&c, 13, 0x200C), "POP.W")

@test("POP.W {.., pc} and LDR PC, [SP], #4 branch to the word they load")
t2m_load_pc()
    // pop.w {r4, pc}, to a breakpoint at 0x40
    var c = execute8([0xE8BD, 0x8010], [], 0, [[0x2000, 5], [0x2004, 0x41], [0x40, 0xBE00BE00]])
    assert(c.stop == Stop.Breakpoint && c.stop_at == 0x40 && c.retired == 1, "POP.W {pc}")
    assert(holds_reg(&c, 4, 5) && holds_reg(&c, 13, 0x2008), "and its registers")
    // ldr.w pc, [sp], #4
    c = execute8([0xF85D, 0xFB04], [], 0, [[0x2000, 0x41], [0x40, 0xBE00BE00]])
    assert(c.stop == Stop.Breakpoint && c.stop_at == 0x40 && holds_reg(&c, 13, 0x2004), "LDR PC")

// ---------------------------------------------------------------------------------------------------
// Exclusives (t2sem.sysl has the monitor's rule).

// ldrex r0, [r1]; adds r0, #1; <between>; strex r2, r0, [r1]
exclusive(between: u16, regs: []const u32) -> Cpu
    ran8([0xE851, 0x0F00, 0x3001, between, 0xE841, 0x0200], regs, [[0x1000, 41]])

@test("STREX succeeds after LDREX of the same address, and writes 0 to its status")
t2m_exclusive()
    var c = exclusive(0xBF00, [0, 0x1000, 9])

    assert(holds_reg(&c, 2, 0) && holds_word(&c, 0x1000, 42) && !c.excl, "succeeded, and the monitor is clear")

@test("STREX fails, storing nothing, without LDREX, after CLREX, after a store of another value, and at another address")
t2m_exclusive_fails()
    // strex r2, r0, [r1] alone
    var c = ran8([0xE841, 0x0200], [7, 0x1000, 9], [[0x1000, 41]])
    assert(holds_reg(&c, 2, 1) && holds_word(&c, 0x1000, 41), "no LDREX")
    // ldrex; clrex; strex
    c = ran8([0xE851, 0x0F00, 0xF3BF, 0x8F2F, 0xE841, 0x0200], [7, 0x1000, 9], [[0x1000, 41]])
    assert(holds_reg(&c, 2, 1) && holds_word(&c, 0x1000, 41), "CLREX")
    // str r3, [r1] between, of another value
    c = exclusive(0x600B, [0, 0x1000, 9, 99])
    assert(holds_reg(&c, 2, 1) && holds_word(&c, 0x1000, 99), "a store between")
    // ldrex r0, [r1]; strex r2, r0, [r1, #4]
    c = ran8([0xE851, 0x0F00, 0xE841, 0x0201], [0, 0x1000, 9], [[0x1000, 41]])
    assert(holds_reg(&c, 2, 1) && holds_word(&c, 0x1004, 0), "another address")

@test("a store of the very value LDREX read does not break the monitor (the ABA case DESIGN §2.8 documents)")
t2m_exclusive_same_value()
    // str r3, [r1] between, r3 = 41, the value there
    var c = exclusive(0x600B, [0, 0x1000, 9, 41])

    assert(holds_reg(&c, 2, 0) && holds_word(&c, 0x1000, 42), "succeeded")

@test("the byte and halfword exclusives check the size, and LDAEX/STLEX pair as LDREX/STREX do")
t2m_exclusive_sizes()
    // ldrexb r0, [r1]; strexb r2, r0, [r1]
    var c = ran8([0xE8D1, 0x0F4F, 0x3001, 0xE8C1, 0x0F42], [0, 0x1000, 9], [[0x1000, 0x1FF]])
    assert(holds_reg(&c, 0, 0x100) && holds_reg(&c, 2, 0) && holds_word(&c, 0x1000, 0x100), "LDREXB/STREXB")
    // ldrexh r0, [r1]; strexh r2, r0, [r1]
    c = ran8([0xE8D1, 0x0F5F, 0x3001, 0xE8C1, 0x0F52], [0, 0x1000, 9], [[0x1000, 0x1FFFF]])
    assert(holds_reg(&c, 2, 0) && holds_word(&c, 0x1000, 0x10000), "LDREXH/STREXH")
    // ldrexb r0, [r1]; strexh r2, r0, [r1]: the sizes differ
    c = ran8([0xE8D1, 0x0F4F, 0xE8C1, 0x0F52], [0, 0x1000, 9], [[0x1000, 0x1FF]])
    assert(holds_reg(&c, 2, 1) && holds_word(&c, 0x1000, 0x1FF), "a size mismatch fails")
    // ldaex r0, [r1]; adds r0, #1; stlex r2, r0, [r1]
    c = ran8([0xE8D1, 0x0FEF, 0x3001, 0xE8C1, 0x0FE2], [0, 0x1000, 9], [[0x1000, 41]])
    assert(holds_reg(&c, 2, 0) && holds_word(&c, 0x1000, 42), "LDAEX/STLEX")
    // lda r0, [r1]; stlb r0, [r3]
    c = ran8([0xE8D1, 0x0FAF, 0xE8C3, 0x0F8F], [0, 0x1000, 0, 0x1004], [[0x1000, 0x1234]])
    assert(holds_reg(&c, 0, 0x1234) && holds_word(&c, 0x1004, 0x34), "LDA/STLB")

// A stop on the instruction at 0 with nothing retired, `r0` still 99 and the word at 0x1000 still 41.
private faulted(c: *Cpu, why: Stop) -> bool
    c.stop == why && c.stop_at == 0 && c.pc == 0 && c.retired == 0 && c.r[0] == 99 && load32(c, 0x1000) == 41

@test("an unaligned exclusive or ordered access stops at Fault on the instruction, loading and storing nothing")
t2m_exclusive_unaligned()
    // ldrex, lda (words) at each misalignment; ldrexh, ldah (halfwords) at the odd ones; all r0, [r1]
    val loads: [10][3]u32 = [
        [0xE851, 0x0F00, 0x1001], [0xE851, 0x0F00, 0x1002], [0xE851, 0x0F00, 0x1003],
        [0xE8D1, 0x0FAF, 0x1001], [0xE8D1, 0x0FAF, 0x1002], [0xE8D1, 0x0FAF, 0x1003],
        [0xE8D1, 0x0F5F, 0x1001], [0xE8D1, 0x0F5F, 0x1003],
        [0xE8D1, 0x0F9F, 0x1001], [0xE8D1, 0x0F9F, 0x1003],
    ]

    for l in loads
        var c = execute8([u16(l[0]), u16(l[1])], [99, l[2]], 0, [[0x1000, 41]])
        assert(faulted(&c, Stop.Fault) && !c.excl, f"0x${l[0]}%04x 0x${l[1]}%04x at 0x${l[2]}%x")

    // strex r2, r0, [r1]; stl r0, [r1]; stlh r0, [r1]: at 0x1001, with r2 left as it was
    val stores: [3][2]u16 = [[0xE841, 0x0200], [0xE8C1, 0x0FAF], [0xE8C1, 0x0F9F]]

    for code in stores
        var c = execute8(code, [99, 0x1001, 9], 0, [[0x1000, 41]])
        assert(faulted(&c, Stop.Fault) && c.r[2] == 9, f"0x${code[0]}%04x 0x${code[1]}%04x")
    // The byte forms have no alignment to break: ldrexb r0, [r1] at an odd address.
    val c = execute8([0xE8D1, 0x0F4F], [99, 0x1001], 0, [[0x1000, 0x2A00]])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 0x2A && c.excl, "LDREXB")

@test("an unaligned access that runs past the RAM's last byte stops on the instruction, and one inside the RAM does not")
t2m_unaligned_at_the_end()
    val last = RAM_BYTES - 4
    // ldr.w and str.w (words) 1 to 3 bytes before the end; ldrh.w and strh.w (halfwords) 1 byte
    // before it; all r0, [r1]
    val cases: [8][2]u32 = [
        [0xF8D1, 3], [0xF8D1, 2], [0xF8D1, 1], [0xF8C1, 3], [0xF8C1, 2], [0xF8C1, 1],
        [0xF8B1, 1], [0xF8A1, 1],
    ]

    for k in cases
        val at = RAM_BYTES - k[1]
        var c = execute8([u16(k[0]), 0x0000], [99, at], 0, [[last, 0x11223344]])
        assert(c.stop == Stop.Unmapped && c.pc == 0 && c.retired == 0 && c.r[0] == 99, f"0x${k[0]}%04x at 0x$at%x")
        assert(load32(&c, last) == 0x11223344, "the RAM's last word unchanged")

    // A word across a page boundary inside the RAM, from 0xEFFFE, is one host access.
    var c = ran8([0xF8D1, 0x0000], [99, 0xEFFFE], [[0xEFFFC, 0x44332211], [0xF0000, 0x88776655]])
    assert(holds_reg(&c, 0, 0x66554433), "across a page")
    c = ran8([0xF8D1, 0x0000], [99, last], [[last, 0x11223344]])
    assert(holds_reg(&c, 0, 0x11223344), "the last word itself")
    // An M0+ word load at the very end stops the same way.
    c = execute_thumb2(Kind.V6m, [0x6808], [99, RAM_BYTES - 2], 0, [])
    assert(c.stop == Stop.Unmapped && c.retired == 0 && c.r[0] == 99, "M0+")

// ---------------------------------------------------------------------------------------------------
// Branches.

@test("B<cond>.W: forward taken and not, and backward round a loop")
t2m_bcond_w()
    // cmp r0, #0; beq.w 0x200; movs r1, #1; bkpt — and at 0x200: movs r1, #2; bkpt
    val code: []const u16 = [0x2800, 0xF000, 0x80FD, 0x2101, 0xBE00]
    val far: [][2]u32 = [[0x200, 0xBE002102]]
    var c = execute8(code, [0], 0, far)
    assert(c.r[1] == 2 && c.stop_at == 0x202 && c.retired == 3, "taken")
    c = execute8(code, [1], 0, far)
    assert(c.r[1] == 1 && c.stop_at == 8 && c.retired == 3, "not taken")
    // subs r0, #1; bne.w back to it
    c = execute8([0x3801, 0xF47F, 0xAFFD], [3], 0, [])
    assert(c.r[0] == 0 && c.stop_at == 6 && c.retired == 6, "a loop")

@test("B.W reaches past the 16-bit range; CBZ and CBNZ branch on zero and non-zero")
t2m_branches()
    // b.w 0x100, where movs r1, #3; bkpt
    var c = execute8([0xF000, 0xB87E], [], 0, [[0x100, 0xBE002103]])
    assert(c.r[1] == 3 && c.stop_at == 0x102 && c.retired == 2, "B.W")
    // cbz r0, +0 (to the bkpt after movs r1, #1)
    c = execute8([0xB100, 0x2101, 0xBE00], [0], 0, [])
    assert(c.r[1] == 0 && c.stop_at == 4 && c.retired == 1, "CBZ taken")
    c = execute8([0xB100, 0x2101, 0xBE00], [5], 0, [])
    assert(c.r[1] == 1 && c.stop_at == 4 && c.retired == 2, "CBZ not taken")
    // cbnz r0, +0
    c = execute8([0xB900, 0x2101, 0xBE00], [5], 0, [])
    assert(c.r[1] == 0 && c.retired == 1, "CBNZ taken")
    c = execute8([0xB900, 0x2101, 0xBE00], [0], 0, [])
    assert(c.r[1] == 1 && c.retired == 2, "CBNZ not taken")

@test("TBB and TBH branch forward by twice the entry, TBH's index scaled by 2, from the PC or a register")
t2m_table()
    // tbb [pc, r0]; a table of 2, 3; nop; bkpt #1 at 8; bkpt #2 at 10
    val tbb: []const u16 = [0xE8DF, 0xF000, 0x0302, 0xBF00, 0xBE01, 0xBE02]
    assert(execute8(tbb, [0], 0, []).stop_at == 8, "TBB entry 0")
    assert(execute8(tbb, [1], 0, []).stop_at == 10, "TBB entry 1")
    // tbh [pc, r0, lsl #1]; a table of 2, 3; bkpt #1 at 8; bkpt #2 at 10
    val tbh: []const u16 = [0xE8DF, 0xF010, 2, 3, 0xBE01, 0xBE02]
    assert(execute8(tbh, [0], 0, []).stop_at == 8, "TBH entry 0")
    assert(execute8(tbh, [1], 0, []).stop_at == 10, "TBH entry 1")
    // tbb [r1, r0]: the table in data
    var c = execute8([0xE8D1, 0xF000, 0xBE01, 0xBE02], [1, 0x1000], 0, [[0x1000, 0x0100]])
    assert(c.stop_at == 6 && c.retired == 1, "TBB from a register")

// `cmp.w r0, #imm` (`cmp`, its two halfwords), then `B<cond>` over a `MOVS r2, #1` to a `MOVS r2, #2`,
// on an M33: both executors take the branch exactly when the comparison holds, and retire three.
wide_branches_as_compared(cmp: [2]u16, cond: u32, a: u32, b: u32) -> bool
    val code: []const u16 = [cmp[0], cmp[1], u16(0xD001 | (cond << 8)), 0x2201, 0xBE00, 0x2202, 0xBE00]
    val want: u32 = if compare_holds(cond, a, b) then 2 else 1
    var cpu: Cpu

    cpu.kind = Kind.V8mMain

    for exec in [&run_match, &run_threaded]
        program(&cpu, exec, code, a, 0, 1000)

        if cpu.stop != Stop.Breakpoint || cpu.r[2] != want || cpu.retired != 3 then return false

    true

@test("a 32-bit CMP fused with the 16-bit B<cond> after it branches exactly when the comparison holds")
t2m_fused_wide()
    val values: []u32 = [0, 1, 2, 0x7FFFFFFF, 0x80000000, 0x80000001, 0xFF00FF00, 0xFFFFFFFF]

    for cond in 0u32..<14
        for a in values
            // cmp.w r0, #0x80000000; cmp.w r0, #1; cmp.w r0, #0xFF00FF00
            assert(wide_branches_as_compared([0xF1B0, 0x4F00], cond, a, 0x80000000), s"#0x80000000, condition $cond, $a")
            assert(wide_branches_as_compared([0xF1B0, 0x0F01], cond, a, 1), s"#1, condition $cond, $a")
            assert(wide_branches_as_compared([0xF1B0, 0x2FFF], cond, a, 0xFF00FF00), s"#0xFF00FF00, condition $cond, $a")

@test("a fused 32-bit CMP and branch: every budget stops both executors at the same place, and a branch to the branch half runs it alone")
t2m_fused_wide_budget()
    var cpu: Cpu

    cpu.kind = Kind.V8mMain

    // adds r0, #1; cmp.w r0, #1000; bne back
    for exec in [&run_match, &run_threaded]
        for quantum in [1u64, 2, 7, 1000]
            program(&cpu, exec, [0x3001, 0xF5B0, 0x7F7A, 0xD1FB, 0xBE00], 0, 0, quantum)
            assert(cpu.stop == Stop.Breakpoint && cpu.r[0] == 1000 && cpu.retired == 3000, s"quantum $quantum: ${cpu.stop} ${cpu.r[0]} ${cpu.retired} ${cpu.pc}")

    // movs r2, #0; cmp.w r0, #0; beq 14; adds r2, #1; subs r0, #1; b 6 (to the beq); bkpt
    for exec in [&run_match, &run_threaded]
        program(&cpu, exec, [0x2200, 0xF1B0, 0x0F00, 0xD002, 0x3201, 0x3801, 0xE7FB, 0xBE00], 3, 0, 1000)
        assert(cpu.stop == Stop.Breakpoint && cpu.r[2] == 3, "into the branch half")

@test("a store over the branch of a fused 32-bit CMP decodes the pair again")
t2m_fused_wide_rewritten()
    var cpu: Cpu

    cpu.kind = Kind.V8mMain

    // cmp.w r0, #0; beq over movs r2, #1 to movs r2, #2
    for exec in [&run_match, &run_threaded]
        program(&cpu, exec, [0xF1B0, 0x0F00, 0xD001, 0x2201, 0xBE00, 0x2202, 0xBE00], 0, 0, 1000)
        assert(cpu.r[2] == 2, "BEQ taken")

        // The same records again, the branch now BNE.
        store16(&cpu, 4, 0xD101)
        cpu.r[2] = 0
        cpu.pc = 0
        cpu.retired = 0
        cpu.stop = Stop.Budget

        while cpu.stop == Stop.Budget
            cpu.limit = cpu.retired + 1000
            exec(&cpu)

        assert(cpu.stop == Stop.Breakpoint && cpu.r[2] == 1 && cpu.retired == 3, "BNE not taken, and the pair no longer fused")
