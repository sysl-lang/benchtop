// ---------------------------------------------------------------------------------------------------
// Branches. `POP {pc}` and `BX` are the two that return from an exception, in `branch_to`'s slow path.

h_pop_pc(cpu: *Cpu, ip: *Insn, n: u64)
    x_pop(cpu, ip, n)

    val target = read32(cpu, cpu.r[13], n)

    cpu.r[13] += 4

    become jump(cpu, branch_to(cpu, target, ip, n), n + 1)

h_mov_pc(cpu: *Cpu, ip: *Insn, n: u64)
    become jump(cpu, insn_at(cpu, cpu.r[ip.b] & ~1), n + 1)

h_bx(cpu: *Cpu, ip: *Insn, n: u64)
    become jump(cpu, branch_to(cpu, cpu.r[ip.b], ip, n), n + 1)

h_blx(cpu: *Cpu, ip: *Insn, n: u64)
    val to = insn_at(cpu, cpu.r[ip.b] & ~1)

    cpu.r[14] = (addr_of(cpu, ip) + 2) | 1

    become jump(cpu, to, n + 1)

h_b(cpu: *Cpu, ip: *Insn, n: u64)
    become jump(cpu, target_of(ip), n + 1)

h_bl(cpu: *Cpu, ip: *Insn, n: u64)
    cpu.r[14] = (addr_of(cpu, ip) + 4) | 1

    become jump(cpu, target_of(ip), n + 1)

// A conditional branch, with its condition a value parameter: each of the fourteen is its own handler
// with the test compiled in.
h_bcond[const K: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, K) then become jump(cpu, target_of(ip), n + 1)
    become next(cpu, &ip[1], n + 1)

// A compare and the conditional branch after it, as `fuse` pairs them: the flags are set exactly as
// the compare sets them, the target is the branch record's, and the pair retires two instructions.
h_cmp_imm_bcond[const K: u32](cpu: *Cpu, ip: *Insn, n: u64)
    x_cmp_imm(cpu, ip)
    if holds(cpu, K) then become jump(cpu, target_of(&ip[1]), n + 2)
    become next(cpu, &ip[2], n + 2)

h_cmp_reg_bcond[const K: u32](cpu: *Cpu, ip: *Insn, n: u64)
    x_cmp_reg(cpu, ip)
    if holds(cpu, K) then become jump(cpu, target_of(&ip[1]), n + 2)
    become next(cpu, &ip[2], n + 2)

// The fused handler for a compare `op` followed by a branch on `cond`.
fused_handler_of(op: Op, cond: u32) -> Handler
    if op == Op.CmpImm
        return cond match
            0 -> &h_cmp_imm_bcond[0]
            1 -> &h_cmp_imm_bcond[1]
            2 -> &h_cmp_imm_bcond[2]
            3 -> &h_cmp_imm_bcond[3]
            4 -> &h_cmp_imm_bcond[4]
            5 -> &h_cmp_imm_bcond[5]
            6 -> &h_cmp_imm_bcond[6]
            7 -> &h_cmp_imm_bcond[7]
            8 -> &h_cmp_imm_bcond[8]
            9 -> &h_cmp_imm_bcond[9]
            10 -> &h_cmp_imm_bcond[10]
            11 -> &h_cmp_imm_bcond[11]
            12 -> &h_cmp_imm_bcond[12]
            _ -> &h_cmp_imm_bcond[13]

    cond match
        0 -> &h_cmp_reg_bcond[0]
        1 -> &h_cmp_reg_bcond[1]
        2 -> &h_cmp_reg_bcond[2]
        3 -> &h_cmp_reg_bcond[3]
        4 -> &h_cmp_reg_bcond[4]
        5 -> &h_cmp_reg_bcond[5]
        6 -> &h_cmp_reg_bcond[6]
        7 -> &h_cmp_reg_bcond[7]
        8 -> &h_cmp_reg_bcond[8]
        9 -> &h_cmp_reg_bcond[9]
        10 -> &h_cmp_reg_bcond[10]
        11 -> &h_cmp_reg_bcond[11]
        12 -> &h_cmp_reg_bcond[12]
        _ -> &h_cmp_reg_bcond[13]

// The handler for each case.
handler_of(op: Op) -> Handler = op match
    Undecoded -> &h_decode
    Undefined -> &h_undefined
    Outside -> &h_outside
    Bkpt -> &h_bkpt
    Nop -> &h_nop
    Barrier -> &h_barrier
    Svc -> &h_svc
    Cps -> &h_cps
    Mrs -> &h_mrs
    Msr -> &h_msr
    Wfi -> &h_wfi
    LslImm -> &h_lsl_imm
    LsrImm -> &h_lsr_imm
    AsrImm -> &h_asr_imm
    AddsReg -> &h_adds_reg
    SubsReg -> &h_subs_reg
    AddsImm -> &h_adds_imm
    SubsImm -> &h_subs_imm
    MovsReg -> &h_movs_reg
    MovsImm -> &h_movs_imm
    CmpImm -> &h_cmp_imm
    Ands -> &h_ands
    Eors -> &h_eors
    LslsReg -> &h_lsls_reg
    LsrsReg -> &h_lsrs_reg
    AsrsReg -> &h_asrs_reg
    Adcs -> &h_adcs
    Sbcs -> &h_sbcs
    Rors -> &h_rors
    Tst -> &h_tst
    Negs -> &h_negs
    CmpReg -> &h_cmp_reg
    Cmn -> &h_cmn
    Orrs -> &h_orrs
    Muls -> &h_muls
    Bics -> &h_bics
    Mvns -> &h_mvns
    AddHi -> &h_add_hi
    MovHi -> &h_mov_hi
    AddImm -> &h_add_imm
    LoadConst -> &h_load_const
    LdrLit -> &h_ldr_lit
    MovPc -> &h_mov_pc
    Bx -> &h_bx
    Blx -> &h_blx
    B -> &h_b
    Bl -> &h_bl
    Beq -> &h_bcond[0]
    Bne -> &h_bcond[1]
    Bcs -> &h_bcond[2]
    Bcc -> &h_bcond[3]
    Bmi -> &h_bcond[4]
    Bpl -> &h_bcond[5]
    Bvs -> &h_bcond[6]
    Bvc -> &h_bcond[7]
    Bhi -> &h_bcond[8]
    Bls -> &h_bcond[9]
    Bge -> &h_bcond[10]
    Blt -> &h_bcond[11]
    Bgt -> &h_bcond[12]
    Ble -> &h_bcond[13]
    StrReg -> &h_str_reg
    StrhReg -> &h_strh_reg
    StrbReg -> &h_strb_reg
    LdrsbReg -> &h_ldrsb_reg
    LdrReg -> &h_ldr_reg
    LdrhReg -> &h_ldrh_reg
    LdrbReg -> &h_ldrb_reg
    LdrshReg -> &h_ldrsh_reg
    StrImm -> &h_str_imm
    LdrImm -> &h_ldr_imm
    StrbImm -> &h_strb_imm
    LdrbImm -> &h_ldrb_imm
    StrhImm -> &h_strh_imm
    LdrhImm -> &h_ldrh_imm
    Sxth -> &h_sxth
    Sxtb -> &h_sxtb
    Uxth -> &h_uxth
    Uxtb -> &h_uxtb
    Rev -> &h_rev
    Rev16 -> &h_rev16
    Revsh -> &h_revsh
    Push -> &h_push
    Pop -> &h_pop
    PopPc -> &h_pop_pc
    Stm -> &h_stm
    Ldm -> &h_ldm
