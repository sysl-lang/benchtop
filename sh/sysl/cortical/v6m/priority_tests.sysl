module sh.sysl.cortical.v6m
@tests

@test("every configurable priority width masks NVIC, system priorities and BASEPRI under both executors")
priority_widths()
    for kind in [Kind.V7em, Kind.V7emM7, Kind.V8mMain]
        for bits in 3u32..8
            for exec in [&run_match, &run_threaded]
                var c: Cpu
                c.kind = kind
                // MSR BASEPRI, r0; MRS r1, BASEPRI.
                prepare(&c, [0xF380, 0x8811, 0xF3EF, 0x8111], [0xFF], 0, [])
                c.priority_bits = bits
                val mask = (0xFF << (8 - bits)) & 0xFF
                store32(&c, NVIC_IPR, 0xFFFFFFFF)
                store32(&c, SCB_SHPR3, 0xFFFFFFFF)
                store32(&c, SCB_SHPR1, 0xFFFFFFFF)
                finish(&c, exec)
                assert(c.stop == Stop.Breakpoint && c.r[1] == mask && c.basepri == mask, "BASEPRI")
                assert(load32(&c, NVIC_IPR) == mask * 0x01010101, "NVIC")
                assert(load32(&c, SCB_SHPR3) == (mask << 16) | (mask << 24), "PendSV and SysTick")
                assert(load32(&c, SCB_SHPR1) == mask * 0x00010101, "fault priorities")
end priority_widths
