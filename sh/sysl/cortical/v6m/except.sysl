module sh.sysl.cortical.v6m

// The ARMv6-M exception model (ARMv6-M ARM, DDI0419, chapter B1): the two stack pointers, handler
// and thread mode, PRIMASK, the system instructions, exception entry and return, and the system
// control space's NVIC, SCB and SysTick.
//
// **Exceptions are taken between runs, never inside a handler.** An executor checks nothing per
// instruction; a run comes back at its first taken branch past `limit`, and `begin_run` — the first
// thing every run does — takes the exception that should run. So whatever can make one ready cuts
// `limit` to 0: a write to the system control space, `CPSIE`, `MSR`, an exception return with
// another one still pending. `DSB`, `ISB`, `DMB`, `CPS`, `MSR` and `WFI` check the budget as a taken
// branch does, so a change just before one of them is acted on there, which is where the
// architecture asks software to put a barrier anyway. A device's interrupt is raised by the board
// between runs. `SVC` is the exception the instruction itself takes, at once.
//
// **The clock is the instruction count.** SysTick counts down once per instruction retired, plus
// the time a `WFI` skips; it is worked out when read rather than decremented, and `begin_run` cuts
// the budget at its next expiry. Its exception is therefore taken at the first taken branch at or
// past the expiry: in a loop of branches, exactly RELOAD + 1 instructions after the store that
// started it.
//
// What is not modelled: lockup (an exception that cannot be taken stops the core at `Fault`), the
// MPU, HardFault for an undefined instruction or a bad access (the core stops at `Undefined` or
// `Unmapped` instead), and an access off the RAM while stacking or unstacking, which stops at
// `Unmapped` like any other.

// The system control space: SysTick, the NVIC and the SCB, all word registers.
const SCS: u32 = 0xE000E000
const SCS_END: u32 = 0xE000F000

const SYST_CSR: u32 = 0xE000E010
const SYST_RVR: u32 = 0xE000E014
const SYST_CVR: u32 = 0xE000E018
const SYST_CALIB: u32 = 0xE000E01C
const NVIC_ISER: u32 = 0xE000E100
const NVIC_ICER: u32 = 0xE000E180
const NVIC_ISPR: u32 = 0xE000E200
const NVIC_ICPR: u32 = 0xE000E280
const NVIC_IPR: u32 = 0xE000E400
const SCB_CPUID: u32 = 0xE000ED00
const SCB_ICSR: u32 = 0xE000ED04
const SCB_VTOR: u32 = 0xE000ED08
const SCB_AIRCR: u32 = 0xE000ED0C
const SCB_SHPR2: u32 = 0xE000ED1C
const SCB_SHPR3: u32 = 0xE000ED20

// Exception numbers.
const NMI: u32 = 2
const HARD_FAULT: u32 = 3
const SVCALL: u32 = 11
const PENDSV: u32 = 14
const SYSTICK: u32 = 15
const IRQ0: u32 = 16

// The system exceptions, which have no enable bit.
const SYSTEM_EXCEPTIONS: u64 = (1 << NMI) | (1 << HARD_FAULT) | (1 << SVCALL) | (1 << PENDSV) | (1 << SYSTICK)

// The execution priority with nothing active and nothing masked: below every priority there is.
const BASE_PRIORITY: int = 256

// SysTick's CSR bits.
const TICK_ENABLE: u32 = 1
const TICK_INT: u32 = 2
const TICK_RUNNING: u32 = 3

// A clock reading that never comes.
const NEVER: u64 = 0xFFFFFFFFFFFFFFFF

// The exception state as a reset leaves it: thread mode on the main stack, nothing pending, active or
// enabled, every priority 0, SysTick stopped at 0, and the vector table at 0.
clear_exceptions(cpu: *Cpu)
    cpu.sp_other = 0
    cpu.control = 0
    cpu.ipsr = 0
    cpu.primask = 0
    cpu.vtor = 0
    cpu.pending = 0
    cpu.active = 0
    cpu.enabled = 0
    for e in 0..<cpu.prio.len do cpu.prio[e] = 0
    cpu.sleeping = false
    cpu.slept = 0
    cpu.tick_ctrl = 0
    cpu.tick_flag = false
    cpu.tick_reload = 0
    cpu.tick_value = 0
    cpu.tick_zero = NEVER
    cpu.tick_last = NEVER

// ---------------------------------------------------------------------------------------------------
// Runs.

// What every run does before its first instruction: wake from a `WFI` or stop at `Asleep`, bring
// SysTick up to the clock, take the exception that should run, and cut the budget at SysTick's next
// expiry. Answers whether to run at all.
begin_run(cpu: *Cpu) -> bool
    if cpu.stop != Stop.Budget then return false

    if !wake(cpu)
        halt(cpu, Stop.Asleep, cpu.pc)
        return false

    tick(cpu, clock(cpu, cpu.retired))
    take_pending(cpu)

    if cpu.stop != Stop.Budget then return false

    if cpu.tick_ctrl == TICK_RUNNING && cpu.tick_zero != NEVER
        val due = cpu.tick_zero - cpu.slept

        if due < cpu.limit then cpu.limit = due

    true

// The clock at `n` instructions retired.
@inline
clock(cpu: *Cpu, n: u64) -> u64 = n + cpu.slept

// Make the run come back at its next taken branch, so the next one's `begin_run` looks again.
@inline
recheck(cpu: *Cpu)
    if cpu.pending != 0 then cpu.limit = 0

// Raise IRQ `irq`, from a device: it is pending until it is taken or cleared.
raise(cpu: *Cpu, irq: u32)
    cpu.pending |= u64(1) << (IRQ0 + irq)

// A sleeping core wakes when an exception is pending that would preempt if PRIMASK were clear; one
// that is masked wakes it without being taken. When nothing pending would, but SysTick's will, the
// clock skips to its expiry. Answers whether the core is awake.
wake(cpu: *Cpu) -> bool
    if !cpu.sleeping then return true

    val now = clock(cpu, cpu.retired)

    tick(cpu, now)

    val e = best_pending(cpu)

    if e < 0 || priority(cpu, u32(e)) >= running_priority(cpu, false)
        if cpu.tick_ctrl != TICK_RUNNING || cpu.tick_zero == NEVER || !could_wake(cpu, SYSTICK)
            return false

        cpu.slept += cpu.tick_zero - now
        tick(cpu, cpu.tick_zero)

    cpu.sleeping = false
    true

// Whether exception `e`, were it pending, would wake a sleeping core.
could_wake(cpu: *Cpu, e: u32) -> bool
    eligible(cpu, e) && priority(cpu, e) < running_priority(cpu, false)

// ---------------------------------------------------------------------------------------------------
// Priorities.

// Exception `e`'s priority: NMI and HardFault are fixed above every other.
priority(cpu: *Cpu, e: u32) -> int
    if e == NMI then return -2
    if e == HARD_FAULT then return -1

    int(cpu.prio[e])

// The priority the core runs at: the highest of the active exceptions', raised to 0 by PRIMASK when
// `masked`.
running_priority(cpu: *Cpu, masked: bool) -> int
    var p = BASE_PRIORITY
    var rest = cpu.active
    var e: u32 = 0

    while rest != 0
        if rest & 1 != 0 && priority(cpu, e) < p then p = priority(cpu, e)
        rest >>= 1
        e += 1

    if masked && cpu.primask != 0 && p > 0 then 0 else p

// Whether exception `e` is enabled: an IRQ has its bit in the NVIC, a system exception always is.
eligible(cpu: *Cpu, e: u32) -> bool
    if e >= IRQ0 then return (cpu.enabled >> (e - IRQ0)) & 1 != 0

    (SYSTEM_EXCEPTIONS >> e) & 1 != 0

// The pending, enabled exception of highest priority, the lowest number among equals; -1 for none.
best_pending(cpu: *Cpu) -> int
    var best = -1
    var rest = cpu.pending & (SYSTEM_EXCEPTIONS | (u64(cpu.enabled) << IRQ0))
    var e: u32 = 0

    while rest != 0
        if rest & 1 != 0 && (best < 0 || priority(cpu, e) < priority(cpu, u32(best))) then best = int(e)
        rest >>= 1
        e += 1

    best

// Take the best pending exception if it preempts what is running.
take_pending(cpu: *Cpu)
    val e = best_pending(cpu)

    if e >= 0 && priority(cpu, u32(e)) < running_priority(cpu, true)
        enter(cpu, u32(e), cpu.pc, cpu.retired)

// ---------------------------------------------------------------------------------------------------
// Entry and return.

// Whether thread mode is running on the process stack, which is then `r[13]`.
@inline
on_process_stack(cpu: *Cpu) -> bool = cpu.ipsr == 0 && cpu.control & 2 != 0

main_sp(cpu: *Cpu) -> u32 = if on_process_stack(cpu) then cpu.sp_other else cpu.r[13]

process_sp(cpu: *Cpu) -> u32 = if on_process_stack(cpu) then cpu.r[13] else cpu.sp_other

// APSR's flags, the T bit and IPSR: the xPSR an exception stacks.
xpsr(cpu: *Cpu) -> u32
    val z: u32 = if flag_z(cpu) then 1 else 0

    (flag_n(cpu) << 31) | (z << 30) | (cpu.c << 29) | (flag_v(cpu) << 28) | (1 << 24) | cpu.ipsr

// The flags from bits 31–28 of `psr`. N and Z both set, which no instruction produces, is kept as Z
// alone: the flags are one word whose sign is N and whose zeroness is Z.
set_apsr(cpu: *Cpu, psr: u32)
    cpu.nz = if (psr >> 30) & 1 != 0 then 0 else if psr >> 31 != 0 then 0x80000000 else 1
    cpu.c = (psr >> 29) & 1
    cpu.va = 0
    cpu.vb = 0
    cpu.vr = ((psr >> 28) & 1) << 31

// Take exception `e`, to come back to `ret`, at `n` instructions retired: stack eight words on the
// stack in use, aligned to 8 with bit 9 of the stacked xPSR saying whether a word was skipped, set LR
// to the EXC_RETURN for where it came from, switch to handler mode on the main stack, and go to the
// handler the vector table names.
enter(cpu: *Cpu, e: u32, ret: u32, n: u64)
    val sp = cpu.r[13]
    val frame = (sp - 0x20) & ~4
    val words: [8]u32 = [cpu.r[0], cpu.r[1], cpu.r[2], cpu.r[3], cpu.r[12], cpu.r[14], ret, xpsr(cpu) | (((sp >> 2) & 1) << 9)]

    for k in 0..<8 do write32(cpu, frame + u32(k) * 4, words[k], n)

    cpu.r[14] = if cpu.ipsr != 0 then 0xFFFFFFF1 else if cpu.control & 2 != 0 then 0xFFFFFFFD else 0xFFFFFFF9

    if on_process_stack(cpu)
        cpu.r[13] = cpu.sp_other
        cpu.sp_other = frame
    else
        cpu.r[13] = frame

    cpu.ipsr = e
    cpu.control &= ~2
    cpu.active |= u64(1) << e
    cpu.pending &= ~(u64(1) << e)

    val at = cpu.vtor + e * 4
    val vector = read32(cpu, at, n)

    cpu.pc = vector & ~1
    if vector & 1 == 0 then halt(cpu, Stop.Fault, at)

// The record a `BX` or `POP {pc}` at `from` goes to with `v` off the RAM: in handler mode, an
// EXC_RETURN value returns from the exception; anything else stops the core at `Unmapped`.
exception_return(cpu: *Cpu, v: u32, from: u32, n: u64) -> *Insn
    if cpu.ipsr == 0 || v >> 4 != 0x0FFFFFFF then return insn_at(cpu, v & ~1)

    val kind = v & 0xF

    if kind != 0x1 && kind != 0x9 && kind != 0xD then return fault_at(cpu, from)

    val to_process = kind == 0xD
    val frame = if to_process then cpu.sp_other else cpu.r[13]
    val psr = read32(cpu, frame + 28, n)
    val ipsr = psr & 0x3F

    // Back to handler mode with no exception, or to thread mode with one: the M0+ would fault.
    if (kind == 0x1) != (ipsr != 0) then return fault_at(cpu, from)

    for k in 0..<4 do cpu.r[k] = read32(cpu, frame + u32(k) * 4, n)
    cpu.r[12] = read32(cpu, frame + 16, n)
    cpu.r[14] = read32(cpu, frame + 20, n)

    val pc = read32(cpu, frame + 24, n)
    val sp = (frame + 0x20) | (((psr >> 9) & 1) << 2)

    cpu.active &= ~(u64(1) << cpu.ipsr)
    cpu.ipsr = ipsr
    set_apsr(cpu, psr)

    if to_process
        cpu.control |= 2
        cpu.sp_other = cpu.r[13]
        cpu.r[13] = sp
    else
        cpu.control &= ~2
        cpu.r[13] = sp

    recheck(cpu)
    insn_at(cpu, pc & ~1)

// Stop at `Fault` on the instruction at `from`, answering its record.
fault_at(cpu: *Cpu, from: u32) -> *Insn
    halt(cpu, Stop.Fault, from)
    &cpu.dec[from >> 1]

// The record a `BX` or `POP {pc}` at `ip` goes to, given the value `v` it puts in the PC. A value in
// the RAM is the common case, and its record is one shift away.
@inline
branch_to(cpu: *Cpu, v: u32, ip: *Insn, n: u64) -> *Insn
    if v < RAM_BYTES then return &cpu.dec[v >> 1]

    exception_return(cpu, v, addr_of(cpu, ip), n)

// ---------------------------------------------------------------------------------------------------
// The system instructions. Each answers the record to go to next.

// `SVC` at `ip`: SVCall, or HardFault where SVCall cannot preempt (PRIMASK set, or a handler at its
// priority or above running), or a stop where HardFault cannot either.
svc(cpu: *Cpu, ip: *Insn, n: u64) -> *Insn
    val from = addr_of(cpu, ip)
    val running = running_priority(cpu, true)
    val e = if priority(cpu, SVCALL) < running then SVCALL else HARD_FAULT

    if priority(cpu, e) >= running then return fault_at(cpu, from)

    enter(cpu, e, from + 2, n)
    insn_at(cpu, cpu.pc)

// `CPSID i` (imm 1) or `CPSIE i` (imm 0).
cps(cpu: *Cpu, ip: *Insn)
    cpu.primask = ip.imm
    recheck(cpu)

// `MRS`: a PSR view, a stack pointer, PRIMASK or CONTROL. A PSR view has IPSR when SYSm's bit 0 is
// set and APSR when its bit 2 is clear; EPSR reads as 0.
mrs(cpu: *Cpu, ip: *Insn)
    val sysm = ip.imm

    cpu.r[ip.a] = sysm match
        8 -> main_sp(cpu)
        9 -> process_sp(cpu)
        16 -> cpu.primask
        20 -> cpu.control
        _ ->
            val ipsr = if sysm & 1 != 0 then cpu.ipsr else 0
            val apsr = if sysm & 4 == 0 then xpsr(cpu) & 0xF0000000 else 0

            ipsr | apsr

// `MSR`: APSR's flags through a view that has APSR, a stack pointer, PRIMASK or CONTROL. IPSR and
// EPSR ignore writes, and so does CONTROL.SPSEL in handler mode.
msr(cpu: *Cpu, ip: *Insn)
    val x = cpu.r[ip.b]

    ip.imm match
        8 ->
            if on_process_stack(cpu) then cpu.sp_other = x & ~3 else cpu.r[13] = x & ~3
        9 ->
            if on_process_stack(cpu) then cpu.r[13] = x & ~3 else cpu.sp_other = x & ~3
        16 -> cpu.primask = x & 1
        20 ->
            if cpu.ipsr != 0
                cpu.control = (cpu.control & 2) | (x & 1)
            else
                val was = on_process_stack(cpu)

                cpu.control = x & 3

                if on_process_stack(cpu) != was
                    val sp = cpu.r[13]

                    cpu.r[13] = cpu.sp_other
                    cpu.sp_other = sp
        _ ->
            if ip.imm & 4 == 0 then set_apsr(cpu, x)

    recheck(cpu)

// `WFI`: sleep, to be woken (or stopped at `Asleep`) by the next run's `begin_run`.
wfi(cpu: *Cpu)
    cpu.sleeping = true
    cpu.limit = 0

// ---------------------------------------------------------------------------------------------------
// SysTick. While it runs, it counts down once per clock; it reads 0 at `tick_last`, and next reaches
// 0 at `tick_zero`, after which it reloads on the following clock, so it is 0 every RELOAD + 1.

// Bring SysTick up to `now`: each time it reached 0 since it was last brought up sets COUNTFLAG and,
// with TICKINT, makes SysTick pending. Counting down to 0 with a reload of 0 leaves it at 0.
tick(cpu: *Cpu, now: u64)
    if cpu.tick_ctrl & TICK_ENABLE == 0 || now < cpu.tick_zero then return

    cpu.tick_flag = true
    if cpu.tick_ctrl & TICK_INT != 0 then cpu.pending |= u64(1) << SYSTICK

    if cpu.tick_reload == 0
        cpu.tick_last = cpu.tick_zero
        cpu.tick_zero = NEVER
        return

    val period = u64(cpu.tick_reload) + 1

    cpu.tick_last = cpu.tick_zero + (now - cpu.tick_zero) / period * period
    cpu.tick_zero = cpu.tick_last + period

// The current value at `now`, SysTick having been brought up to it.
tick_now(cpu: *Cpu, now: u64) -> u32
    if cpu.tick_ctrl & TICK_ENABLE == 0 then return cpu.tick_value
    if cpu.tick_zero == NEVER || now == cpu.tick_last then return 0

    u32(cpu.tick_zero - now)

// Set SysTick counting from `tick_value` at `now`: a value of 0 reloads on the next clock.
tick_start(cpu: *Cpu, now: u64)
    if cpu.tick_value != 0
        cpu.tick_zero = now + u64(cpu.tick_value)
        cpu.tick_last = NEVER
    else
        cpu.tick_zero = if cpu.tick_reload == 0 then NEVER else now + 1 + u64(cpu.tick_reload)
        cpu.tick_last = now

// ---------------------------------------------------------------------------------------------------
// The system control space. Every register is a word; any other width, and any address in the space
// that is not a register here, stops the core at `Unmapped` as an access where nothing is would.

scs_read(cpu: *Cpu, a: u32, width: u32, n: u64) -> u32
    if width != 4 || a & 3 != 0
        halt(cpu, Stop.Unmapped, a)
        return 0

    val now = clock(cpu, n)

    tick(cpu, now)

    if a >= NVIC_IPR && a < NVIC_IPR + 32
        val first = IRQ0 + (a - NVIC_IPR)

        return u32(cpu.prio[first]) | u32(cpu.prio[first + 1]) << 8 | u32(cpu.prio[first + 2]) << 16 | u32(cpu.prio[first + 3]) << 24

    a match
        SYST_CSR ->
            val flag: u32 = if cpu.tick_flag then 1 << 16 else 0

            cpu.tick_flag = false
            // CLKSOURCE reads 1: SysTick counts the processor's clock.
            cpu.tick_ctrl | 4 | flag
        SYST_RVR -> cpu.tick_reload
        SYST_CVR -> tick_now(cpu, now)
        // No reference clock, and no calibration value.
        SYST_CALIB -> 0xC0000000
        NVIC_ISER | NVIC_ICER -> cpu.enabled
        NVIC_ISPR | NVIC_ICPR -> u32(cpu.pending >> IRQ0)
        // The Cortex-M0+, r0p1.
        SCB_CPUID -> 0x410CC601
        SCB_ICSR ->
            val best = best_pending(cpu)
            val vectpending: u32 = if best < 0 then 0 else u32(best)
            val irq: u32 = if cpu.pending >> IRQ0 != 0 then 1 << 22 else 0

            (bit_of(cpu.pending, NMI) << 31) | (bit_of(cpu.pending, PENDSV) << 28) | (bit_of(cpu.pending, SYSTICK) << 26) | irq | (vectpending << 12) | cpu.ipsr
        SCB_VTOR -> cpu.vtor
        // VECTKEYSTAT, little-endian.
        SCB_AIRCR -> 0xFA050000
        SCB_SHPR2 -> u32(cpu.prio[SVCALL]) << 24
        SCB_SHPR3 -> u32(cpu.prio[PENDSV]) << 16 | u32(cpu.prio[SYSTICK]) << 24
        _ ->
            halt(cpu, Stop.Unmapped, a)
            0

scs_write(cpu: *Cpu, a: u32, width: u32, x: u32, n: u64)
    if width != 4 || a & 3 != 0
        halt(cpu, Stop.Unmapped, a)
        return

    val now = clock(cpu, n)

    tick(cpu, now)
    // Whatever changes here, the run comes back at its next taken branch to look at it.
    cpu.limit = 0

    if a >= NVIC_IPR && a < NVIC_IPR + 32
        val first = IRQ0 + (a - NVIC_IPR)

        for k in 0u32..<4 do cpu.prio[first + k] = u8((x >> (k * 8)) & 0xC0)
        return

    a match
        SYST_CSR ->
            cpu.tick_value = tick_now(cpu, now)
            cpu.tick_ctrl = x & TICK_RUNNING
            if cpu.tick_ctrl & TICK_ENABLE != 0 then tick_start(cpu, now)
        SYST_RVR ->
            cpu.tick_value = tick_now(cpu, now)
            cpu.tick_reload = x & 0xFFFFFF
            if cpu.tick_ctrl & TICK_ENABLE != 0 then tick_start(cpu, now)
        // Any write clears the count and COUNTFLAG, and raises nothing.
        SYST_CVR ->
            cpu.tick_value = 0
            cpu.tick_flag = false
            if cpu.tick_ctrl & TICK_ENABLE != 0 then tick_start(cpu, now)
        NVIC_ISER -> cpu.enabled |= x
        NVIC_ICER -> cpu.enabled &= ~x
        NVIC_ISPR -> cpu.pending |= u64(x) << IRQ0
        NVIC_ICPR -> cpu.pending &= ~(u64(x) << IRQ0)
        SCB_ICSR ->
            if (x >> 31) & 1 != 0 then cpu.pending |= u64(1) << NMI
            if (x >> 28) & 1 != 0 then cpu.pending |= u64(1) << PENDSV
            if (x >> 27) & 1 != 0 then cpu.pending &= ~(u64(1) << PENDSV)
            if (x >> 26) & 1 != 0 then cpu.pending |= u64(1) << SYSTICK
            if (x >> 25) & 1 != 0 then cpu.pending &= ~(u64(1) << SYSTICK)
        SCB_VTOR -> cpu.vtor = x & ~0xFF
        // SYSRESETREQ, under the key: the board decides what a reset is.
        SCB_AIRCR ->
            if x >> 16 == 0x05FA && x & 4 != 0 then halt(cpu, Stop.Reset, a)
        SCB_SHPR2 -> cpu.prio[SVCALL] = u8((x >> 24) & 0xC0)
        SCB_SHPR3 ->
            cpu.prio[PENDSV] = u8((x >> 16) & 0xC0)
            cpu.prio[SYSTICK] = u8((x >> 24) & 0xC0)
        // CPUID is read-only.
        SCB_CPUID -> ()
        _ -> halt(cpu, Stop.Unmapped, a)

@inline
bit_of(x: u64, k: u32) -> u32 = u32((x >> k) & 1)
