module sh.sysl.cortical.v6m

import sysl.fenv.{RoundingMode, set_rounding, set_flush_to_zero, set_default_nan, clear_flags}
import sysl.fenv.flags as host_fenv_flags

// The floating-point extension: FPv4-SP on the Cortex-M4, FPv5 on the M7 (single or double precision)
// and on the ARMv8-M Mainline cores (single), as the board gives each core one (`fpu`).
//
// **The arithmetic is the host's, under the guest's FPSCR.** The host is an Arm too, so an operation
// rounded in the guest's mode, with its flush-to-zero and default-NaN, answers what the guest's unit
// would, NaNs and flags included. Every function here that computes with a float is `@strict_fp`, so
// each operation runs where it is written, under the floating-point environment then in force, and
// raises its flags there. A run puts the core's FPSCR controls on the host's environment before its
// first instruction and gathers the flags the host raised into `cpu.fpscr` after its last
// (`fp_begin`, `fp_end`), so two cores taking turns on one thread each see their own; `VMSR` and
// `VMRS` do the same in the middle of a run. A flag the host does not raise for the guest's reason —
// a conversion's invalid and inexact, `VCMPE`'s invalid on a quiet NaN — is worked out here and
// set in `cpu.fpscr` directly.
//
// **Still undefined**: `VCVTB` and `VCVTT` (half precision), and `VRINTN` and `VCVTN` (ties to even
// whatever the mode), until the compiler offers what each needs; and FPSCR.IDC, the input-denormal
// flag, is never set.

extern "llvm.sqrt" sqrt32(x: f32) -> f32
extern "llvm.sqrt" sqrt64(x: f64) -> f64
extern "llvm.fma" fma32(a: f32, b: f32, c: f32) -> f32
extern "llvm.fma" fma64(a: f64, b: f64, c: f64) -> f64
extern "llvm.trunc" trunc32(x: f32) -> f32
extern "llvm.trunc" trunc64(x: f64) -> f64
extern "llvm.floor" floor32(x: f32) -> f32
extern "llvm.floor" floor64(x: f64) -> f64
extern "llvm.ceil" ceil32(x: f32) -> f32
extern "llvm.ceil" ceil64(x: f64) -> f64
extern "llvm.round" round32(x: f32) -> f32
extern "llvm.round" round64(x: f64) -> f64
extern "llvm.nearbyint" nearbyint32(x: f32) -> f32
extern "llvm.nearbyint" nearbyint64(x: f64) -> f64
extern "llvm.rint" rint32(x: f32) -> f32
extern "llvm.rint" rint64(x: f64) -> f64
extern "llvm.maxnum" maxnum32(a: f32, b: f32) -> f32
extern "llvm.maxnum" maxnum64(a: f64, b: f64) -> f64
extern "llvm.minnum" minnum32(a: f32, b: f32) -> f32
extern "llvm.minnum" minnum64(a: f64, b: f64) -> f64

// FPCCR's reset: ASPEN and LSPEN, so the extension's state is preserved on exception entry.
const FPCCR_RESET: u32 = 0xC0000000
const FPCCR_ASPEN: u32 = 0x80000000
// FPSCR's bits an M-profile unit has: N, Z, C, V, AHP, DN, FZ, RMode, IDC and the five flags.
const FPSCR_WRITABLE: u32 = 0xF7C0009F
const FPSCR_CONTROLS: u32 = 0x07C00000
const FP_IOC: u32 = 1
const FP_DZC: u32 = 2
const FP_OFC: u32 = 4
const FP_UFC: u32 = 8
const FP_IXC: u32 = 16

const FP_NONE: u32 = 0
const FP_SINGLE: u32 = 1
const FP_DOUBLE: u32 = 2

// The extension's registers in the system control space.
const FP_FPCCR: u32 = 0xE000EF34
const FP_FPCAR: u32 = 0xE000EF38
const FP_FPDSCR: u32 = 0xE000EF3C
const FP_MVFR0: u32 = 0xE000EF40
const FP_MVFR1: u32 = 0xE000EF44
const FP_MVFR2: u32 = 0xE000EF48

// The operations of `Op.FpData`. A record holds Sd (or Dd) in `imm` bits 0–4, Sn in 5–9, Sm in
// 10–14, the operation in 15–20, double precision in bit 21, and what the operation needs besides
// in bits 22–31 (`fp_extra`).
const FP_ADD: u32 = 0
const FP_SUB: u32 = 1
const FP_MUL: u32 = 2
const FP_NMUL: u32 = 3
const FP_MLA: u32 = 4
const FP_MLS: u32 = 5
const FP_NMLA: u32 = 6
const FP_NMLS: u32 = 7
const FP_DIV: u32 = 8
const FP_FMA: u32 = 9
const FP_FMS: u32 = 10
const FP_FNMA: u32 = 11
const FP_FNMS: u32 = 12
const FP_MOV: u32 = 13
const FP_ABS: u32 = 14
const FP_NEG: u32 = 15
const FP_SQRT: u32 = 16
// extra: the 8-bit immediate.
const FP_MOVI: u32 = 17
// extra: bit 0 `VCMPE`, bit 1 against zero.
const FP_CMP: u32 = 18
// extra: bit 0 a signed source. Sm holds the integer.
const FP_FROM_INT: u32 = 19
// extra: the rounding (`ROUND_*`) in bits 0–2, bit 3 a signed result. Sd receives the integer.
const FP_TO_INT: u32 = 20
// extra: fraction bits in 0–5, bit 6 unsigned, bit 7 a 32-bit integer (else 16). Sd is both.
const FP_FROM_FIXED: u32 = 21
const FP_TO_FIXED: u32 = 22
// To the other precision: Sm to Dd in the single record, Dm to Sd in the double one.
const FP_CVT: u32 = 23
// extra: the rounding.
const FP_RINT: u32 = 24
// extra: the condition, 0 EQ, 1 VS, 2 GE, 3 GT.
const FP_SEL: u32 = 25
const FP_MAXNM: u32 = 26
const FP_MINNM: u32 = 27

// How a result is rounded to an integer: toward zero, in FPSCR's mode, in FPSCR's mode raising
// inexact (`VRINTX`), to nearest with ties away, toward +∞, toward −∞.
const ROUND_ZERO: u32 = 0
const ROUND_MODE: u32 = 1
const ROUND_EXACT: u32 = 2
const ROUND_AWAY: u32 = 3
const ROUND_UP: u32 = 4
const ROUND_DOWN: u32 = 5

// The kinds of `Op.FpMove`, in `imm` bits 0–2, with the S register in bits 3–7; `a` is Rt, `b` Rt2.
const MOVE_TO_S: u32 = 0
const MOVE_FROM_S: u32 = 1
const MOVE_VMSR: u32 = 2
const MOVE_VMRS: u32 = 3
const MOVE_VMRS_APSR: u32 = 4
const MOVE_TO_PAIR: u32 = 5
const MOVE_FROM_PAIR: u32 = 6

@inline
fp_dest(i: *Insn) -> u32 = i.imm & 31

@inline
fp_n(i: *Insn) -> u32 = (i.imm >> 5) & 31

@inline
fp_m(i: *Insn) -> u32 = (i.imm >> 10) & 31

@inline
fp_op(i: *Insn) -> u32 = (i.imm >> 15) & 63

@inline
fp_is_double(i: *Insn) -> u32 = (i.imm >> 21) & 1

@inline
fp_extra(i: *Insn) -> u32 = i.imm >> 22

// ---------------------------------------------------------------------------------------------------
// Registers.

@inline
sget(cpu: *Cpu, k: u32) -> f32 = f32.from_bits(cpu.s[k])

@inline
sset(cpu: *Cpu, k: u32, x: f32)
    cpu.s[k] = x.bits()

@inline
dbits(cpu: *Cpu, k: u32) -> u64 = u64(cpu.s[2 * k]) | (u64(cpu.s[2 * k + 1]) << 32)

@inline
dset_bits(cpu: *Cpu, k: u32, x: u64)
    cpu.s[2 * k] = u32(x)
    cpu.s[2 * k + 1] = u32(x >> 32)

@inline
dget(cpu: *Cpu, k: u32) -> f64 = f64.from_bits(dbits(cpu, k))

@inline
dset(cpu: *Cpu, k: u32, x: f64) = dset_bits(cpu, k, x.bits())

// ---------------------------------------------------------------------------------------------------
// The environment.

// The flags the host has raised since they were last cleared, as FPSCR's bits.
host_flags() -> u32
    val f = host_fenv_flags()
    var bits: u32 = 0

    if f.invalid then bits |= FP_IOC
    if f.divide_by_zero then bits |= FP_DZC
    if f.overflow then bits |= FP_OFC
    if f.underflow then bits |= FP_UFC
    if f.inexact then bits |= FP_IXC
    bits

// Put FPSCR `x`'s rounding mode, flush-to-zero and default-NaN on the host, its flags cleared.
private host_controls(x: u32)
    set_rounding((x >> 22) & 3 match
        0 -> RoundingMode.NearestEven
        1 -> RoundingMode.Upward
        2 -> RoundingMode.Downward
        _ -> RoundingMode.TowardZero)
    set_flush_to_zero((x >> 24) & 1 != 0)
    set_default_nan((x >> 25) & 1 != 0)
    clear_flags()

// Before a run's first instruction, on a core with the extension.
fp_begin(cpu: *Cpu) = host_controls(cpu.fpscr)

// After its last: the flags gathered, and the host's environment its own again.
fp_end(cpu: *Cpu)
    cpu.fpscr |= host_flags()
    host_controls(0)

// FPSCR as the guest reads it now.
fpscr_now(cpu: *Cpu) -> u32 = cpu.fpscr | host_flags()

// A new FPSCR, from `VMSR` or an exception return.
fpscr_set(cpu: *Cpu, x: u32)
    cpu.fpscr = x & FPSCR_WRITABLE
    host_controls(cpu.fpscr)

// ---------------------------------------------------------------------------------------------------
// Access: CPACR.CP10 (CP11 must agree) gives the extension to privileged code (1) or to all (3); with
// no access, an instruction of the extension is the UsageFault NOCP, which cortical does not take, so
// the core stops at `Fault` on it. Where FPCCR.ASPEN says the state is to be preserved and
// CONTROL.FPCA is clear, the instruction creates a new context: FPCA is set, and FPSCR takes its
// controls from FPDSCR. Until CPACR, CONTROL, FPCCR or the mode changes, the next instructions skip
// the check (`fp_ready`).

@inline
fp_ok(cpu: *Cpu, i: *Insn) -> bool = cpu.fp_ready || fp_admit(cpu, i)

@cold
@noinline
fp_admit(cpu: *Cpu, i: *Insn) -> bool
    val cp10 = (cpu.cpacr >> 20) & 3
    val privileged = cpu.ipsr != 0 || cpu.control & 1 == 0

    if cp10 == 0 || cp10 == 2 || (cp10 == 1 && !privileged)
        halt(cpu, Stop.Fault, addr_of(cpu, i))
        return false

    if cpu.fpccr & FPCCR_ASPEN != 0 && cpu.control & 4 == 0
        cpu.control |= 4
        fpscr_set(cpu, (fpscr_now(cpu) & ~FPSCR_CONTROLS) | cpu.fpdscr)

    cpu.fp_ready = true
    true

// The feature registers, MVFR0–2: what each unit implements.
fp_feature(cpu: *Cpu, k: u32) -> u32
    val v5 = cpu.kind != Kind.V7em
    val dp = cpu.fpu == FP_DOUBLE

    k match
        0 -> if dp then 0x10110221 else 0x10110021
        1 -> if v5 then 0x12000011 else 0x11000011
        _ -> if v5 then 0x00000040 else 0

// ---------------------------------------------------------------------------------------------------
// Decoding. `hw1` is 1110 110x (loads, stores and 64-bit transfers), 1110 1110 (data processing and
// 32-bit transfers) or 1111 1110 (FPv5's unconditional instructions), and `hw2` names coprocessor 10
// or 11 (bits 11–9 101); anything else here is undefined, as is all of it on a core with no unit.

@inline
private fbit(x: u32, lo: u32, n: u32) -> u32 = (x >> lo) & ((1 << n) - 1)

// Whether the core has FPv5's additions: every unit here but the M4's FPv4.
@inline
fpv5(cpu: *Cpu) -> bool = cpu.kind != Kind.V7em

decode_fp(cpu: *Cpu, pc: u32, hw1: u32, hw2: u32, into: *Insn, it: u32) -> Op
    if cpu.fpu == FP_NONE || hw2 & 0x0E00 != 0x0A00 then return Op.Undefined

    val top = hw1 >> 8

    if top == 0xEC || top == 0xED then return fp_memory(cpu, pc, hw1, hw2, into)
    if top == 0xEE then return if hw2 & 0x10 != 0 then fp_transfer(hw1, hw2, into) else fp_data(cpu, hw1, hw2, into)
    if top == 0xFE && fpv5(cpu) && it == 0 then return fp_v5(cpu, hw1, hw2, into)

    Op.Undefined

// The S register of a 4-bit field and a 1-bit one: the four bits are its top.
@inline
private sreg(four: u32, one: u32) -> u32 = (four << 1) | one

// The D register: the bit is its top, and a unit with 16 D registers has no D16–D31.
@inline
private dreg(four: u32, one: u32) -> u32 = (one << 4) | four

private fp_record(into: *Insn, op: u32, dbl: u32, d: u32, n: u32, m: u32, extra: u32) -> Op
    into.imm = d | (n << 5) | (m << 10) | (op << 15) | (dbl << 21) | (extra << 22)
    Op.FpData

// Data processing: hw1 1110 1110 p D q r Vn, hw2 Vd 101 sz N o M 0 Vm, the operation p:q:r and o.
private fp_data(cpu: *Cpu, hw1: u32, hw2: u32, into: *Insn) -> Op
    val dbl = fbit(hw2, 8, 1)
    val opc1 = (fbit(hw1, 7, 1) << 2) | fbit(hw1, 4, 2)
    val o = fbit(hw2, 6, 1)
    val vd = fbit(hw2, 12, 4)
    val vn = fbit(hw1, 0, 4)
    val vm = fbit(hw2, 0, 4)
    val dd = fbit(hw1, 6, 1)
    val nn = fbit(hw2, 7, 1)
    val mm = fbit(hw2, 5, 1)
    val d = if dbl == 1 then dreg(vd, dd) else sreg(vd, dd)
    val n = if dbl == 1 then dreg(vn, nn) else sreg(vn, nn)
    val m = if dbl == 1 then dreg(vm, mm) else sreg(vm, mm)

    if opc1 == 7 then return fp_other(cpu, hw1, hw2, into)
    if dbl == 1 && (cpu.fpu != FP_DOUBLE || d > 15 || n > 15 || m > 15) then return Op.Undefined

    val op = opc1 match
        0 -> if o == 0 then FP_MLA else FP_MLS
        1 -> if o == 1 then FP_NMLA else FP_NMLS
        2 -> if o == 1 then FP_NMUL else FP_MUL
        3 -> if o == 0 then FP_ADD else FP_SUB
        4 -> if o == 0 then FP_DIV else 99
        5 -> if o == 1 then FP_FNMA else FP_FNMS
        _ -> if o == 0 then FP_FMA else FP_FMS

    if op == 99 then return Op.Undefined

    fp_record(into, op, dbl, d, n, m, 0)
end fp_data

// The rest of data processing (p:q:r 111): the immediate move, the one-operand operations, the
// compares and the conversions, told apart by Vn (opc2) and hw2's bits 7–6 (opc3).
private fp_other(cpu: *Cpu, hw1: u32, hw2: u32, into: *Insn) -> Op
    val dbl = fbit(hw2, 8, 1)
    val opc2 = fbit(hw1, 0, 4)
    val opc3 = fbit(hw2, 6, 2)
    val vd = fbit(hw2, 12, 4)
    val vm = fbit(hw2, 0, 4)
    val dd = fbit(hw1, 6, 1)
    val mm = fbit(hw2, 5, 1)
    val sd = sreg(vd, dd)
    val sm = sreg(vm, mm)
    val ddr = dreg(vd, dd)
    val dmr = dreg(vm, mm)
    val d = if dbl == 1 then ddr else sd
    val m = if dbl == 1 then dmr else sm
    val v5 = fpv5(cpu)

    // Where both registers are of the record's precision: a D register past D15 is absent.
    val same = dbl == 0 || (ddr <= 15 && dmr <= 15)

    if dbl == 1 && cpu.fpu != FP_DOUBLE then return Op.Undefined

    if opc3 & 1 == 0
        // VMOV (immediate): hw2's bits 7–4 are 0.
        if fbit(hw2, 4, 4) != 0 || (dbl == 1 && ddr > 15) then return Op.Undefined
        return fp_record(into, FP_MOVI, dbl, d, 0, 0, (opc2 << 4) | vm)

    opc2 match
        0 ->
            if !same then return Op.Undefined
            fp_record(into, if opc3 == 1 then FP_MOV else FP_ABS, dbl, d, 0, m, 0)
        1 ->
            if !same then return Op.Undefined
            fp_record(into, if opc3 == 1 then FP_NEG else FP_SQRT, dbl, d, 0, m, 0)
        4 ->
            if !same then return Op.Undefined
            fp_record(into, FP_CMP, dbl, d, 0, m, opc3 >> 1)
        5 ->
            if vm != 0 || mm != 0 || !same then return Op.Undefined
            fp_record(into, FP_CMP, dbl, d, 0, 0, (opc3 >> 1) | 2)
        6 ->
            if !v5 || !same then return Op.Undefined
            fp_record(into, FP_RINT, dbl, d, 0, m, if opc3 == 3 then ROUND_ZERO else ROUND_MODE)
        7 ->
            if opc3 == 1
                if !v5 || !same then return Op.Undefined
                return fp_record(into, FP_RINT, dbl, d, 0, m, ROUND_EXACT)
            // VCVT between the precisions: the destination is the other one's register.
            if cpu.fpu != FP_DOUBLE then return Op.Undefined
            if dbl == 0
                if ddr > 15 then return Op.Undefined
                return fp_record(into, FP_CVT, 0, ddr, 0, sm, 0)
            if dmr > 15 then return Op.Undefined
            fp_record(into, FP_CVT, 1, sd, 0, dmr, 0)
        8 ->
            // VCVT to a float from the integer in Sm.
            if dbl == 1 && ddr > 15 then return Op.Undefined
            fp_record(into, FP_FROM_INT, dbl, d, 0, sm, opc3 >> 1)
        10 | 11 | 14 | 15 -> fp_fixed(dbl, opc2, hw2, d, into)
        12 | 13 ->
            // VCVT to an integer in Sd: toward zero, or VCVTR in FPSCR's mode.
            if dbl == 1 && dmr > 15 then return Op.Undefined
            val rounding = if opc3 == 3 then ROUND_ZERO else ROUND_MODE
            fp_record(into, FP_TO_INT, dbl, sd, 0, m, rounding | ((opc2 & 1) << 3))
        _ -> Op.Undefined
end fp_other

// VCVT between a float and a fixed-point number, in place in Sd or Dd: opc2 1x1U, bit 2 the
// direction (1 to fixed), U unsigned; hw2's bit 7 a 32-bit integer, and imm4:i the integer's width
// less the fraction bits.
private fp_fixed(dbl: u32, opc2: u32, hw2: u32, d: u32, into: *Insn) -> Op
    if dbl == 1 && d > 15 then return Op.Undefined

    val wide = fbit(hw2, 7, 1)
    val size: u32 = if wide == 1 then 32 else 16
    val imm = (fbit(hw2, 0, 4) << 1) | fbit(hw2, 5, 1)

    // A 16-bit integer with more fraction bits than it has bits is UNPREDICTABLE.
    if imm > size then return Op.Undefined

    val extra = (size - imm) | ((opc2 & 1) << 6) | (wide << 7)
    val op = if opc2 & 4 != 0 then FP_TO_FIXED else FP_FROM_FIXED

    fp_record(into, op, dbl, d, 0, 0, extra)

// FPv5's unconditional encodings: VSEL, VMAXNM and VMINNM, VRINTA/N/P/M and VCVTA/N/P/M.
private fp_v5(cpu: *Cpu, hw1: u32, hw2: u32, into: *Insn) -> Op
    val dbl = fbit(hw2, 8, 1)
    val vd = fbit(hw2, 12, 4)
    val vn = fbit(hw1, 0, 4)
    val vm = fbit(hw2, 0, 4)
    val dd = fbit(hw1, 6, 1)
    val nn = fbit(hw2, 7, 1)
    val mm = fbit(hw2, 5, 1)
    val d = if dbl == 1 then dreg(vd, dd) else sreg(vd, dd)
    val n = if dbl == 1 then dreg(vn, nn) else sreg(vn, nn)
    val m = if dbl == 1 then dreg(vm, mm) else sreg(vm, mm)

    if dbl == 1 && (cpu.fpu != FP_DOUBLE || m > 15) then return Op.Undefined
    // Every one but VCVT writes a register of the record's precision.
    if dbl == 1 && d > 15 && hw1 & 0xFFBC != 0xFEBC then return Op.Undefined

    if hw1 & 0x80 == 0
        // VSEL: hw2's bits 6 and 4 are 0.
        if hw2 & 0x50 != 0 || (dbl == 1 && n > 15) then return Op.Undefined
        return fp_record(into, FP_SEL, dbl, d, n, m, fbit(hw1, 4, 2))

    if fbit(hw1, 4, 2) == 0
        if hw2 & 0x10 != 0 || (dbl == 1 && n > 15) then return Op.Undefined
        return fp_record(into, if fbit(hw2, 6, 1) == 0 then FP_MAXNM else FP_MINNM, dbl, d, n, m, 0)

    val rm = fbit(hw1, 0, 2)
    // Ties to even regardless of FPSCR is not yet expressible: VRINTN and VCVTN are undefined.
    val rounding = rm match
        0 -> ROUND_AWAY
        2 -> ROUND_UP
        3 -> ROUND_DOWN
        _ -> 99

    if rounding == 99 then return Op.Undefined

    if hw1 & 0xFFBC == 0xFEB8 && fbit(hw2, 6, 2) == 1 then return fp_record(into, FP_RINT, dbl, d, 0, m, rounding)

    if hw1 & 0xFFBC == 0xFEBC && fbit(hw2, 6, 1) == 1
        // VCVTA/P/M: to an integer in Sd, hw2's bit 7 signed.
        val sd = sreg(vd, dd)
        return fp_record(into, FP_TO_INT, dbl, sd, 0, m, rounding | (fbit(hw2, 7, 1) << 3))

    Op.Undefined
end fp_v5

// The 32-bit transfers: VMOV between a core register and an S register or a D register's half, and
// VMRS and VMSR of FPSCR.
private fp_transfer(hw1: u32, hw2: u32, into: *Insn) -> Op
    val rt = fbit(hw2, 12, 4)
    val low = hw2 & 0x0FFF

    if hw1 == 0xEEE1 && low == 0x0A10
        if rt == 13 || rt == 15 then return Op.Undefined
        return fp_move(into, MOVE_VMSR, 0, rt, 0)

    if hw1 == 0xEEF1 && low == 0x0A10
        if rt == 13 then return Op.Undefined
        return fp_move(into, if rt == 15 then MOVE_VMRS_APSR else MOVE_VMRS, 0, rt, 0)

    if rt == 13 || rt == 15 then return Op.Undefined

    val from = fbit(hw1, 4, 1) == 1

    // VMOV between Rt and Sn: hw1 1110 1110 000 op Vn, hw2 Rt 1010 N 001 0000.
    if hw1 & 0xFFE0 == 0xEE00 && hw2 & 0x0F7F == 0x0A10
        val s = sreg(fbit(hw1, 0, 4), fbit(hw2, 7, 1))
        return fp_move(into, if from then MOVE_FROM_S else MOVE_TO_S, s, rt, 0)

    // VMOV between Rt and Dd[x]: hw1 1110 1110 000 x op Vd, hw2 Rt 1011 D 001 0000.
    if hw1 & 0xFFC0 == 0xEE00 && hw2 & 0x0F7F == 0x0B10
        val dd = dreg(fbit(hw1, 0, 4), fbit(hw2, 7, 1))
        if dd > 15 then return Op.Undefined
        return fp_move(into, if from then MOVE_FROM_S else MOVE_TO_S, 2 * dd + fbit(hw1, 5, 1), rt, 0)

    Op.Undefined

private fp_move(into: *Insn, kind: u32, s: u32, rt: u32, rt2: u32) -> Op
    into.a = u4(rt)
    into.b = u4(rt2)
    into.imm = kind | (s << 3)
    Op.FpMove

// Loads, stores and the 64-bit transfers: hw1 1110 110 P U D W L Rn, hw2 Vd 101 sz imm8.
private fp_memory(cpu: *Cpu, pc: u32, hw1: u32, hw2: u32, into: *Insn) -> Op
    val p = fbit(hw1, 8, 1)
    val u = fbit(hw1, 7, 1)
    val dd = fbit(hw1, 6, 1)
    val w = fbit(hw1, 5, 1)
    val load = fbit(hw1, 4, 1)
    val rn = hw1 & 0xF
    val dbl = fbit(hw2, 8, 1)
    val vd = fbit(hw2, 12, 4)
    val imm8 = hw2 & 0xFF
    val d = if dbl == 1 then dreg(vd, dd) else sreg(vd, dd)

    if p == 0 && u == 0
        if w == 0 && dd == 1 then return fp_pair(hw1, hw2, into)
        return Op.Undefined

    if dbl == 1 && d > 15 then return Op.Undefined

    if p == 1 && w == 0
        // VLDR and VSTR, a word offset either way; VLDR from the PC is from a literal, whose address
        // is known now.
        if rn == 15
            if load == 0 then return Op.Undefined
            val base = (pc + 4) & ~3
            into.imm = if u == 1 then base + imm8 * 4 else base - imm8 * 4
            into.a = u4(d & 15)
            into.c = u4((d >> 4) | (dbl << 1))
            return Op.FpLdrLit
        into.a = u4(rn)
        into.imm = d | (dbl << 5) | (load << 6) | (u << 7) | ((imm8 * 4) << 8)
        return Op.FpLdr

    // VLDM and VSTM: increment after (P 0, U 1), or decrement before with writeback (P 1, U 0, W 1).
    if p == 1 && (u == 1 || w == 0) then return Op.Undefined
    if rn == 15 then return Op.Undefined

    val count = if dbl == 1 then imm8 / 2 else imm8
    val limit: u32 = if dbl == 1 then 16 else 32

    if count == 0 || d + count > limit || (dbl == 1 && imm8 & 1 != 0) then return Op.Undefined

    into.b = u4(rn)
    into.imm = d | (count << 5) | (dbl << 11) | (load << 12) | (p << 13) | (w << 14)
    Op.FpMulti
end fp_memory

// VMOV between two core registers and two S registers (Sm, Sm+1) or a D register: hw1 1110 1100 010
// op Rt2, hw2 Rt 101 sz 00 M 1 Vm.
private fp_pair(hw1: u32, hw2: u32, into: *Insn) -> Op
    val rt = fbit(hw2, 12, 4)
    val rt2 = hw1 & 0xF
    val from = fbit(hw1, 4, 1) == 1
    val dbl = fbit(hw2, 8, 1)

    if hw2 & 0xD0 != 0x10 then return Op.Undefined
    if rt == 13 || rt == 15 || rt2 == 13 || rt2 == 15 || (from && rt == rt2) then return Op.Undefined

    val s = if dbl == 1 then 2 * dreg(fbit(hw2, 0, 4), fbit(hw2, 5, 1)) else sreg(fbit(hw2, 0, 4), fbit(hw2, 5, 1))

    if s > 30 then return Op.Undefined

    fp_move(into, if from then MOVE_FROM_PAIR else MOVE_TO_PAIR, s, rt, rt2)

// ---------------------------------------------------------------------------------------------------
// Transfers and memory. These compute nothing with a float, so they need no strictness.

x_fp_move(cpu: *Cpu, i: *Insn)
    val s = (i.imm >> 3) & 31

    (i.imm & 7) match
        MOVE_TO_S -> cpu.s[s] = reg(cpu, i.a)
        MOVE_FROM_S -> put(cpu, i.a, cpu.s[s])
        MOVE_VMSR -> fpscr_set(cpu, reg(cpu, i.a))
        MOVE_VMRS -> put(cpu, i.a, fpscr_now(cpu))
        MOVE_VMRS_APSR -> set_apsr(cpu, (fpscr_now(cpu) & 0xF0000000) | (cpu.q << 27))
        MOVE_TO_PAIR ->
            cpu.s[s] = reg(cpu, i.a)
            cpu.s[s + 1] = reg(cpu, i.b)
        _ ->
            put(cpu, i.a, cpu.s[s])
            put(cpu, i.b, cpu.s[s + 1])

// `count` words from or to S`first` upward, at `at`. An address not a word's is the UsageFault
// UNALIGNED these instructions always raise, which stops the core on the instruction.
private fp_words(cpu: *Cpu, i: *Insn, at: u32, first: u32, count: u32, load: bool, n: u64) -> bool
    if at & 3 != 0 then return unaligned(cpu, i)

    for k in 0..<count
        if load
            if !fp_load_word(cpu, at + k * 4, first + k, n) then return false
        else if !store(cpu, at + k * 4, cpu.s[first + k], 4, n)
            return false

    true

@inline
private fp_load_word(cpu: *Cpu, a: u32, k: u32, n: u64) -> bool
    var x: u32 = 0

    if !load(cpu, a, 4, n, &x) then return false

    cpu.s[k] = x
    true

// VLDR and VSTR.
x_fp_ldr(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val dbl = (i.imm >> 5) & 1
    val d = i.imm & 31
    val offset = i.imm >> 8
    val base = reg(cpu, i.a)
    val at = if (i.imm >> 7) & 1 != 0 then base + offset else base - offset
    val first = if dbl == 1 then 2 * d else d

    fp_words(cpu, i, at, first, dbl + 1, (i.imm >> 6) & 1 != 0, n)

// VLDR from a literal.
x_fp_ldr_lit(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val dbl = (u32(i.c) >> 1) & 1
    val d = u32(i.a) | ((u32(i.c) & 1) << 4)
    val first = if dbl == 1 then 2 * d else d

    fp_words(cpu, i, i.imm, first, dbl + 1, true, n)

// VLDM, VSTM, VPUSH and VPOP. A partial transfer leaves the base as it was.
x_fp_multi(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val d = i.imm & 31
    val count = (i.imm >> 5) & 63
    val dbl = (i.imm >> 11) & 1
    val load = (i.imm >> 12) & 1 != 0
    val before = (i.imm >> 13) & 1 != 0
    val back = (i.imm >> 14) & 1 != 0
    val words = if dbl == 1 then 2 * count else count
    val base = reg(cpu, i.b)
    val start = if before then base - words * 4 else base
    val moved = if before then base - words * 4 else base + words * 4

    if back && before && i.b == 13 && breaks_limit(cpu, i, moved) then return false
    if !fp_words(cpu, i, start, if dbl == 1 then 2 * d else d, words, load, n) then return false
    if back then put(cpu, i.b, moved)
    true
