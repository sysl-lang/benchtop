module sh.sysl.cortical.v6m

// The threaded executor's handlers for ARMv8-M Mainline (threaded.sysl has the chain). A 32-bit
// instruction's handler goes on to the record two after its own. A family of operations has a handler
// per operation, made from one generic body with the operation a constant, and the decoder gives each
// record its operation's (`handler_for`); each family also has a handler that reads the operation
// from the record, which `handler_of` answers for the case alone.

// The handler a decoded record runs, the one made for its operation where its case is a family.
handler_for(ip: *Insn) -> Handler = ip.op match
    DpImm -> dp_imm_handler(imm_op(u32(ip.c)))
    LogicImm -> logic_handler(logic_op(u32(ip.c) & 7), false)
    LogicImmC -> logic_handler(logic_op(u32(ip.c) & 7), true)
    DpReg -> dp_reg_handler(ip.imm >> 12, ip.imm & 0x1FF)
    BitOp -> bit_handler(u32(ip.c))
    Extend -> extend_handler(u32(ip.c))
    LdImm -> ld_imm_handler(u32(ip.c))
    LdReg -> ld_reg_handler(ip.imm >> 8)
    LdWb -> ld_wb_handler(u32(ip.c) & 7)
    BcondW -> bcond_w_handler(u32(ip.c))
    FpData -> fp_handler(ip)
    _ -> handler_of(ip.op)

// ---------------------------------------------------------------------------------------------------
// IT blocks.

h_it(cpu: *Cpu, ip: *Insn, n: u64)
    cpu.it = ip.imm
    become next(cpu, &ip[1], n + 1)

// An instruction of an IT block, on condition `K`, `L` records long. ITSTATE steps on whether it runs
// or not. Run, it is its own handler; skipped, it retires as a NOP. Reached with ITSTATE 0 — by a
// branch into the block, which is UNPREDICTABLE — it runs unconditionally, as the `match` executor
// does (thumb2.sysl).
h_pred[const K: u32, const L: u32](cpu: *Cpu, ip: *Insn, n: u64)
    val st = cpu.it

    cpu.it = it_advance(st)

    if st == 0 || holds(cpu, K)
        val f = handler_for(ip)

        become f(cpu, ip, n)

    become next(cpu, &ip[L], n + 1)

// The handler of an instruction in an IT block on condition `cond`, `len` records long.
pred_handler(cond: u32, len: u32) -> Handler
    if len == 1
        return cond match
            0 -> &h_pred[0, 1]
            1 -> &h_pred[1, 1]
            2 -> &h_pred[2, 1]
            3 -> &h_pred[3, 1]
            4 -> &h_pred[4, 1]
            5 -> &h_pred[5, 1]
            6 -> &h_pred[6, 1]
            7 -> &h_pred[7, 1]
            8 -> &h_pred[8, 1]
            9 -> &h_pred[9, 1]
            10 -> &h_pred[10, 1]
            11 -> &h_pred[11, 1]
            12 -> &h_pred[12, 1]
            13 -> &h_pred[13, 1]
            _ -> &h_pred[14, 1]

    cond match
        0 -> &h_pred[0, 2]
        1 -> &h_pred[1, 2]
        2 -> &h_pred[2, 2]
        3 -> &h_pred[3, 2]
        4 -> &h_pred[4, 2]
        5 -> &h_pred[5, 2]
        6 -> &h_pred[6, 2]
        7 -> &h_pred[7, 2]
        8 -> &h_pred[8, 2]
        9 -> &h_pred[9, 2]
        10 -> &h_pred[10, 2]
        11 -> &h_pred[11, 2]
        12 -> &h_pred[12, 2]
        13 -> &h_pred[13, 2]
        _ -> &h_pred[14, 2]

// ---------------------------------------------------------------------------------------------------
// 16-bit.

h_cbz(cpu: *Cpu, ip: *Insn, n: u64)
    if cpu.r[ip.a] == 0 then become jump(cpu, target_of(ip), n + 1)
    become next(cpu, &ip[1], n + 1)

h_cbnz(cpu: *Cpu, ip: *Insn, n: u64)
    if cpu.r[ip.a] != 0 then become jump(cpu, target_of(ip), n + 1)
    become next(cpu, &ip[1], n + 1)

h_it_alu(cpu: *Cpu, ip: *Insn, n: u64)
    x_it_alu(cpu, ip)
    become next(cpu, &ip[1], n + 1)

h_push_l(cpu: *Cpu, ip: *Insn, n: u64)
    if x_push_l(cpu, ip, n) then become next(cpu, &ip[1], n + 1)
    stop_access(cpu, ip, n)

h_sp_imm(cpu: *Cpu, ip: *Insn, n: u64)
    if x_sp_imm(cpu, ip) then become next(cpu, &ip[1], n + 1)
    stop_access(cpu, ip, n)

h_sp_reg(cpu: *Cpu, ip: *Insn, n: u64)
    if x_sp_reg(cpu, ip) then become next(cpu, &ip[1], n + 1)
    stop_access(cpu, ip, n)

h_cps8(cpu: *Cpu, ip: *Insn, n: u64)
    cps8(cpu, ip)
    become jump(cpu, &ip[1], n + 1)

// ---------------------------------------------------------------------------------------------------
// Data processing.

h_dp_imm[const OP: u32](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, OP, ip.a, reg(cpu, ip.b), ip.imm)
    become next(cpu, &ip[2], n + 1)

// A 32-bit `CMP` with an immediate and the 16-bit `B<cond>` after it, as `fuse_wide` pairs them: the
// flags as the compare sets them, the target the branch record's, two instructions retired.
h_cmp_w_bcond[const K: u32](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, DP_CMP, ip.a, reg(cpu, ip.b), ip.imm)
    if holds(cpu, K) then become jump(cpu, target_of(&ip[2]), n + 2)
    become next(cpu, &ip[3], n + 2)

cmp_w_bcond_handler(cond: u32) -> Handler = cond match
    0 -> &h_cmp_w_bcond[0]
    1 -> &h_cmp_w_bcond[1]
    2 -> &h_cmp_w_bcond[2]
    3 -> &h_cmp_w_bcond[3]
    4 -> &h_cmp_w_bcond[4]
    5 -> &h_cmp_w_bcond[5]
    6 -> &h_cmp_w_bcond[6]
    7 -> &h_cmp_w_bcond[7]
    8 -> &h_cmp_w_bcond[8]
    9 -> &h_cmp_w_bcond[9]
    10 -> &h_cmp_w_bcond[10]
    11 -> &h_cmp_w_bcond[11]
    12 -> &h_cmp_w_bcond[12]
    _ -> &h_cmp_w_bcond[13]

h_dp_imm_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_dp_imm(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_logic_imm[const OP: u32](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, OP, ip.a, reg(cpu, ip.b), ip.imm)
    become next(cpu, &ip[2], n + 1)

h_logic_imm_c[const OP: u32](cpu: *Cpu, ip: *Insn, n: u64)
    cpu.c = (u32(ip.c) >> 3) & 1
    alu(cpu, OP, ip.a, reg(cpu, ip.b), ip.imm)
    become next(cpu, &ip[2], n + 1)

h_logic_imm_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_logic_imm(cpu, ip, false)
    become next(cpu, &ip[2], n + 1)

h_logic_imm_c_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_logic_imm(cpu, ip, true)
    become next(cpu, &ip[2], n + 1)

// With Rm shifted; and `h_dp_reg0`, for the most common shift, none (LSL #0).
// With Rm shifted by an immediate of kind `K`: the shift's amount is the record's, its kind compiled
// in, so the handler holds the one shift and no test of which.
h_dp_reg[const OP: u32, const K: u32](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, OP, ip.a, reg(cpu, ip.b), shift_c(cpu, reg(cpu, ip.c), K, ip.imm & 63, sets_carry(OP)))
    become next(cpu, &ip[2], n + 1)

h_dp_reg0[const OP: u32](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, OP, ip.a, reg(cpu, ip.b), reg(cpu, ip.c))
    become next(cpu, &ip[2], n + 1)

h_dp_reg_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_dp_reg(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_shift_reg(cpu: *Cpu, ip: *Insn, n: u64)
    x_shift_reg(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_sp_imm_w(cpu: *Cpu, ip: *Insn, n: u64)
    if x_sp_imm(cpu, ip) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_sp_reg_w(cpu: *Cpu, ip: *Insn, n: u64)
    if x_sp_reg_w(cpu, ip) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_movt(cpu: *Cpu, ip: *Insn, n: u64)
    x_movt(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_bfi(cpu: *Cpu, ip: *Insn, n: u64)
    x_bfi(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_bfc(cpu: *Cpu, ip: *Insn, n: u64)
    x_bfc(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_ubfx(cpu: *Cpu, ip: *Insn, n: u64)
    x_ubfx(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_sbfx(cpu: *Cpu, ip: *Insn, n: u64)
    x_sbfx(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_bit_op[const W: u32](cpu: *Cpu, ip: *Insn, n: u64)
    x_bit_op(cpu, ip, W)
    become next(cpu, &ip[2], n + 1)

h_bit_op_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_bit_op(cpu, ip, u32(ip.c))
    become next(cpu, &ip[2], n + 1)

h_extend[const W: u32](cpu: *Cpu, ip: *Insn, n: u64)
    x_extend(cpu, ip, W)
    become next(cpu, &ip[2], n + 1)

h_extend_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_extend(cpu, ip, u32(ip.c))
    become next(cpu, &ip[2], n + 1)

h_mul_w(cpu: *Cpu, ip: *Insn, n: u64)
    x_mul_w(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_mla(cpu: *Cpu, ip: *Insn, n: u64)
    x_mla(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_mls(cpu: *Cpu, ip: *Insn, n: u64)
    x_mls(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_umull(cpu: *Cpu, ip: *Insn, n: u64)
    x_umull(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_smull(cpu: *Cpu, ip: *Insn, n: u64)
    x_smull(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_umlal(cpu: *Cpu, ip: *Insn, n: u64)
    x_umlal(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_smlal(cpu: *Cpu, ip: *Insn, n: u64)
    x_smlal(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_udiv(cpu: *Cpu, ip: *Insn, n: u64)
    if x_udiv(cpu, ip) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_sdiv(cpu: *Cpu, ip: *Insn, n: u64)
    if x_sdiv(cpu, ip) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ssat(cpu: *Cpu, ip: *Insn, n: u64)
    x_ssat(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_usat(cpu: *Cpu, ip: *Insn, n: u64)
    x_usat(cpu, ip)
    become next(cpu, &ip[2], n + 1)

// ---------------------------------------------------------------------------------------------------
// Loads and stores.

h_ld_imm[const X: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_imm(cpu, ip, X, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ld_imm_any(cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_imm(cpu, ip, u32(ip.c), n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ld_wb[const X: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_wb(cpu, ip, X, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ld_wb_any(cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_wb(cpu, ip, u32(ip.c) & 7, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ld_reg[const X: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_reg(cpu, ip, X, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ld_reg_any(cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_reg(cpu, ip, ip.imm >> 8, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ld_lit(cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_lit(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ldrd(cpu: *Cpu, ip: *Insn, n: u64)
    if x_ldrd(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_strd(cpu: *Cpu, ip: *Insn, n: u64)
    if x_strd(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ldrd_lit(cpu: *Cpu, ip: *Insn, n: u64)
    if x_ldrd_lit(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ldm_w(cpu: *Cpu, ip: *Insn, n: u64)
    if x_ldm_w(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_stm_w(cpu: *Cpu, ip: *Insn, n: u64)
    if x_stm_w(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_ldrex(cpu: *Cpu, ip: *Insn, n: u64)
    if x_ldrex(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_strex(cpu: *Cpu, ip: *Insn, n: u64)
    if x_strex(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_clrex(cpu: *Cpu, ip: *Insn, n: u64)
    x_clrex(cpu)
    become next(cpu, &ip[2], n + 1)

h_lda(cpu: *Cpu, ip: *Insn, n: u64)
    if x_lda(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

h_stl(cpu: *Cpu, ip: *Insn, n: u64)
    if x_stl(cpu, ip, n) then become next(cpu, &ip[2], n + 1)
    stop_access(cpu, ip, n)

// ---------------------------------------------------------------------------------------------------
// Branches. `LDR PC` and an `LDM` with the PC return from an exception as `POP {pc}` does.

h_ld_pc(cpu: *Cpu, ip: *Insn, n: u64)
    x_ld_pc(cpu, ip, n) match
        Some(target) -> become jump(cpu, branch_to(cpu, target, ip, n), n + 1)
        None -> stop_access(cpu, ip, n)

h_ldm_pc(cpu: *Cpu, ip: *Insn, n: u64)
    x_ldm_pc(cpu, ip, n) match
        Some(target) -> become jump(cpu, branch_to(cpu, target, ip, n), n + 1)
        None -> stop_access(cpu, ip, n)

// `TBB` and `TBH`: forward by twice the table's entry from the instruction's address plus 4.
h_tbb(cpu: *Cpu, ip: *Insn, n: u64)
    x_table(cpu, ip, 1, n) match
        Some(to) -> become jump(cpu, insn_at(cpu, to), n + 1)
        None -> stop_access(cpu, ip, n)

h_tbh(cpu: *Cpu, ip: *Insn, n: u64)
    x_table(cpu, ip, 2, n) match
        Some(to) -> become jump(cpu, insn_at(cpu, to), n + 1)
        None -> stop_access(cpu, ip, n)

h_bcond_w[const K: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, K) then become jump(cpu, target_of(ip), n + 1)
    become next(cpu, &ip[2], n + 1)

h_bcond_w_any(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, u32(ip.c)) then become jump(cpu, target_of(ip), n + 1)
    become next(cpu, &ip[2], n + 1)

h_leave_w(cpu: *Cpu, ip: *Insn, n: u64)
    if !holds(cpu, u32(ip.c)) then become next(cpu, &ip[2], n + 1)
    leave(cpu, ip, n)

// ---------------------------------------------------------------------------------------------------
// System. As on ARMv6-M, an instruction that may change what can interrupt checks the budget as a
// taken branch does.

h_mrs8(cpu: *Cpu, ip: *Insn, n: u64)
    mrs8(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_msr8(cpu: *Cpu, ip: *Insn, n: u64)
    msr8(cpu, ip)
    become jump(cpu, &ip[2], n + 1)

h_nop_w(cpu: *Cpu, ip: *Insn, n: u64)
    become next(cpu, &ip[2], n + 1)

h_wfi_w(cpu: *Cpu, ip: *Insn, n: u64)
    wfi(cpu)
    become jump(cpu, &ip[2], n + 1)

// ---------------------------------------------------------------------------------------------------
// The handler made for each operation of a family.

private dp_imm_handler(op: u32) -> Handler = op match
    0 -> &h_dp_imm[0]
    4 -> &h_dp_imm[4]
    8 -> &h_dp_imm[8]
    10 -> &h_dp_imm[10]
    11 -> &h_dp_imm[11]
    12 -> &h_dp_imm[12]
    13 -> &h_dp_imm[13]
    17 -> &h_dp_imm[17]
    18 -> &h_dp_imm[18]
    19 -> &h_dp_imm[19]
    20 -> &h_dp_imm[20]
    26 -> &h_dp_imm[26]
    27 -> &h_dp_imm[27]
    _ -> &h_dp_imm_any

private logic_handler(op: u32, carry: bool) -> Handler
    if carry
        return op match
            1 -> &h_logic_imm_c[1]
            5 -> &h_logic_imm_c[5]
            9 -> &h_logic_imm_c[9]
            21 -> &h_logic_imm_c[21]
            24 -> &h_logic_imm_c[24]
            25 -> &h_logic_imm_c[25]
            _ -> &h_logic_imm_c_any

    op match
        1 -> &h_logic_imm[1]
        5 -> &h_logic_imm[5]
        9 -> &h_logic_imm[9]
        21 -> &h_logic_imm[21]
        24 -> &h_logic_imm[24]
        25 -> &h_logic_imm[25]
        _ -> &h_logic_imm_any

private dp_reg_handler(op: u32, shift: u32) -> Handler
    if shift == 0
        return op match
            0 -> &h_dp_reg0[0]
            1 -> &h_dp_reg0[1]
            2 -> &h_dp_reg0[2]
            3 -> &h_dp_reg0[3]
            4 -> &h_dp_reg0[4]
            5 -> &h_dp_reg0[5]
            6 -> &h_dp_reg0[6]
            7 -> &h_dp_reg0[7]
            8 -> &h_dp_reg0[8]
            9 -> &h_dp_reg0[9]
            10 -> &h_dp_reg0[10]
            11 -> &h_dp_reg0[11]
            12 -> &h_dp_reg0[12]
            13 -> &h_dp_reg0[13]
            14 -> &h_dp_reg0[14]
            15 -> &h_dp_reg0[15]
            16 -> &h_dp_reg0[16]
            17 -> &h_dp_reg0[17]
            18 -> &h_dp_reg0[18]
            19 -> &h_dp_reg0[19]
            20 -> &h_dp_reg0[20]
            21 -> &h_dp_reg0[21]
            22 -> &h_dp_reg0[22]
            23 -> &h_dp_reg0[23]
            24 -> &h_dp_reg0[24]
            25 -> &h_dp_reg0[25]
            26 -> &h_dp_reg0[26]
            27 -> &h_dp_reg0[27]
            _ -> &h_dp_reg_any

    (shift >> 6) match
        0 -> shifted[0](op)
        1 -> shifted[1](op)
        2 -> shifted[2](op)
        3 -> shifted[3](op)
        _ -> shifted[4](op)

// The handler for operation `op` with a shift of kind `K`.
private shifted[const K: u32](op: u32) -> Handler = op match
    0 -> &h_dp_reg[0, K]
    1 -> &h_dp_reg[1, K]
    2 -> &h_dp_reg[2, K]
    3 -> &h_dp_reg[3, K]
    4 -> &h_dp_reg[4, K]
    5 -> &h_dp_reg[5, K]
    6 -> &h_dp_reg[6, K]
    7 -> &h_dp_reg[7, K]
    8 -> &h_dp_reg[8, K]
    9 -> &h_dp_reg[9, K]
    10 -> &h_dp_reg[10, K]
    11 -> &h_dp_reg[11, K]
    12 -> &h_dp_reg[12, K]
    13 -> &h_dp_reg[13, K]
    14 -> &h_dp_reg[14, K]
    15 -> &h_dp_reg[15, K]
    16 -> &h_dp_reg[16, K]
    17 -> &h_dp_reg[17, K]
    18 -> &h_dp_reg[18, K]
    19 -> &h_dp_reg[19, K]
    20 -> &h_dp_reg[20, K]
    21 -> &h_dp_reg[21, K]
    22 -> &h_dp_reg[22, K]
    23 -> &h_dp_reg[23, K]
    24 -> &h_dp_reg[24, K]
    25 -> &h_dp_reg[25, K]
    26 -> &h_dp_reg[26, K]
    27 -> &h_dp_reg[27, K]
    _ -> &h_dp_reg_any

private bit_handler(w: u32) -> Handler = w match
    0 -> &h_bit_op[0]
    1 -> &h_bit_op[1]
    2 -> &h_bit_op[2]
    3 -> &h_bit_op[3]
    4 -> &h_bit_op[4]
    _ -> &h_bit_op_any

private extend_handler(w: u32) -> Handler = w match
    0 -> &h_extend[0]
    1 -> &h_extend[1]
    2 -> &h_extend[2]
    3 -> &h_extend[3]
    _ -> &h_extend_any

private ld_imm_handler(x: u32) -> Handler = x match
    0 -> &h_ld_imm[0]
    1 -> &h_ld_imm[1]
    2 -> &h_ld_imm[2]
    3 -> &h_ld_imm[3]
    4 -> &h_ld_imm[4]
    5 -> &h_ld_imm[5]
    6 -> &h_ld_imm[6]
    7 -> &h_ld_imm[7]
    _ -> &h_ld_imm_any

private ld_wb_handler(x: u32) -> Handler = x match
    0 -> &h_ld_wb[0]
    1 -> &h_ld_wb[1]
    2 -> &h_ld_wb[2]
    3 -> &h_ld_wb[3]
    4 -> &h_ld_wb[4]
    5 -> &h_ld_wb[5]
    6 -> &h_ld_wb[6]
    7 -> &h_ld_wb[7]
    _ -> &h_ld_wb_any

private ld_reg_handler(x: u32) -> Handler = x match
    0 -> &h_ld_reg[0]
    1 -> &h_ld_reg[1]
    2 -> &h_ld_reg[2]
    3 -> &h_ld_reg[3]
    4 -> &h_ld_reg[4]
    5 -> &h_ld_reg[5]
    6 -> &h_ld_reg[6]
    7 -> &h_ld_reg[7]
    _ -> &h_ld_reg_any

private bcond_w_handler(k: u32) -> Handler = k match
    0 -> &h_bcond_w[0]
    1 -> &h_bcond_w[1]
    2 -> &h_bcond_w[2]
    3 -> &h_bcond_w[3]
    4 -> &h_bcond_w[4]
    5 -> &h_bcond_w[5]
    6 -> &h_bcond_w[6]
    7 -> &h_bcond_w[7]
    8 -> &h_bcond_w[8]
    9 -> &h_bcond_w[9]
    10 -> &h_bcond_w[10]
    11 -> &h_bcond_w[11]
    12 -> &h_bcond_w[12]
    13 -> &h_bcond_w[13]
    _ -> &h_bcond_w_any

h_csel(cpu: *Cpu, ip: *Insn, n: u64)
    x_csel(cpu, ip)
    become next(cpu, &ip[2], n + 1)

// Shared decoded records may run on cores with different extension choices.
h_dsp(cpu: *Cpu, ip: *Insn, n: u64)
    if !cpu.dsp then return stop_here(cpu, ip, n, Stop.Undefined)
    x_dsp(cpu, ip)
    become next(cpu, &ip[2], n + 1)
