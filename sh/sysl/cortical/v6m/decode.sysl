module sh.sysl.cortical.v6m

// The ARMv6-M decoder: every 16-bit encoding, and the 32-bit `BL`, `MRS`, `MSR` and barriers. It
// reads the halfwords at a guest address and fills a record; every operand extraction, every
// immediate scaling and every PC-relative address is done here, once, so an executor only reads
// fields.
//
// An encoding that writes the PC through a general data-processing form decodes as `Undefined`.

enum Op: u8
    Undecoded = 0
    Undefined
    // The record past the end of RAM: control has left it.
    Outside
    Bkpt
    // `NOP`, `YIELD`, `WFE` and `SEV`: the event register is not modelled, so a `WFE` never waits.
    Nop
    // `DSB`, `DMB` and `ISB`: nothing to order on one core, but each is a point where the budget is
    // checked, so a change to the exception state made just before one is acted on there.
    Barrier
    // The system instructions, each also a point where the budget is checked. `SVC`: imm = its
    // number. `CPS`: imm = 1 for `CPSID i`, 0 for `CPSIE i`. `MRS`: a = rd, imm = SYSm. `MSR`:
    // b = rn, imm = SYSm.
    Svc
    Cps
    Mrs
    Msr
    Wfi
    // Shifts by an immediate: a = rd, b = rm, imm = amount (1..32).
    LslImm
    LsrImm
    AsrImm
    // a = rd, b = rn, c = rm
    AddsReg
    SubsReg
    // a = rd, b = rn, imm
    AddsImm
    SubsImm
    // a = rd, b = rm: `LSL #0`, which sets N and Z and leaves C.
    MovsReg
    // a = rd, imm
    MovsImm
    // a = rn, imm
    CmpImm
    // Data processing, a = rdn, b = rm.
    Ands
    Eors
    LslsReg
    LsrsReg
    AsrsReg
    Adcs
    Sbcs
    Rors
    Tst
    Negs
    CmpReg
    Cmn
    Orrs
    Muls
    Bics
    Mvns
    // Flag-free forms on any register: a = rd, b = rm (or rn), imm.
    AddHi
    MovHi
    AddImm
    // A constant into a = rd: the PC read as an operand, `ADR`.
    LoadConst
    // A load from a constant address: `LDR (literal)`.
    LdrLit
    // Branches: imm = target.
    MovPc
    Bx
    Blx
    B
    Bl
    Beq
    Bne
    Bcs
    Bcc
    Bmi
    Bpl
    Bvs
    Bvc
    Bhi
    Bls
    Bge
    Blt
    Bgt
    Ble
    // Loads and stores with a register offset: a = rt, b = rn, c = rm.
    StrReg
    StrhReg
    StrbReg
    LdrsbReg
    LdrReg
    LdrhReg
    LdrbReg
    LdrshReg
    // With an immediate offset, already scaled: a = rt, b = rn, imm.
    StrImm
    LdrImm
    StrbImm
    LdrbImm
    StrhImm
    LdrhImm
    // Extends and byte reversals: a = rd, b = rm.
    Sxth
    Sxtb
    Uxth
    Uxtb
    Rev
    Rev16
    Revsh
    // Multiple: imm = the register list.
    Push
    Pop
    PopPc
    // a = rn, imm = the register list.
    Stm
    Ldm

@inline
bits(x: u32, lo: u32, n: u32) -> u32 = (x >> lo) & ((1 << n) - 1)

// Sign-extend the low `n` bits of `x`.
@inline
sext(x: u32, n: u32) -> u32 = u32(i32(x << (32 - n)) >> (32 - n))

// A direct branch's target, as `target_of` reads it: the signed count of records from the branch's
// own, so taking the branch is one add to the record pointer.
// A target outside RAM is the record that stands for everywhere else.
@inline
records_to(pc: u32, target: u32) -> u32
    val to = if target < RAM_BYTES then target else RAM_BYTES

    u32(i32(to - pc) >> 1)

// Decode the instruction at guest address `pc` into `into`.
decode(cpu: *Cpu, pc: u32, into: *Insn)
    into.a = 0
    into.b = 0
    into.c = 0
    into.imm = 0

    if pc >= RAM_BYTES
        into.op = Op.Outside
        into.h = handler_of(into.op)
        return

    val hw = load16(cpu, pc)

    into.op = decode16(cpu, pc, hw, into)
    into.h = handler_of(into.op)

    if into.op == Op.CmpImm || into.op == Op.CmpReg then fuse(cpu, pc, into)

// A compare followed by a conditional branch, the way nearly every loop ends, runs as one handler in
// the threaded executor: the branch is decoded into the next record as usual, so a jump straight to
// it still finds it, and the compare's record takes the condition in `c` and a handler that does
// both. The `match` executor ignores `h` and runs the two records one after the other.
private fuse(cpu: *Cpu, pc: u32, into: *Insn)
    // Looking past the end of mapped memory would be an access the guest never made.
    if page_of(cpu, pc + 2) == 0 then return

    val next = load16(cpu, pc + 2)
    val cond = bits(next, 8, 4)

    if next >> 12 != 0b1101 || cond >= 14 then return

    decode(cpu, pc + 2, &into[1])
    into.c = u4(cond)
    into.h = fused_handler_of(into.op, cond)

private set(into: *Insn, a: u32, b: u32, c: u32, imm: u32)
    into.a = u4(a)
    into.b = u4(b)
    into.c = u4(c)
    into.imm = imm

private decode16(cpu: *Cpu, pc: u32, hw: u32, into: *Insn) -> Op
    val lo3 = bits(hw, 0, 3)
    val mid3 = bits(hw, 3, 3)
    val top = bits(hw, 11, 5)

    if hw >> 13 == 0
        // Shift (immediate), add, subtract, move, compare.
        val imm5 = bits(hw, 6, 5)

        return top match
            0 ->
                if imm5 == 0
                    set(into, lo3, mid3, 0, 0)
                    return Op.MovsReg
                set(into, lo3, mid3, 0, imm5)
                Op.LslImm
            1 ->
                set(into, lo3, mid3, 0, if imm5 == 0 then 32 else imm5)
                Op.LsrImm
            2 ->
                set(into, lo3, mid3, 0, if imm5 == 0 then 32 else imm5)
                Op.AsrImm
            _ ->
                // 00011 o i: add/sub, register or 3-bit immediate.
                val rm = bits(hw, 6, 3)

                bits(hw, 9, 2) match
                    0 ->
                        set(into, lo3, mid3, rm, 0)
                        Op.AddsReg
                    1 ->
                        set(into, lo3, mid3, rm, 0)
                        Op.SubsReg
                    2 ->
                        set(into, lo3, mid3, 0, rm)
                        Op.AddsImm
                    _ ->
                        set(into, lo3, mid3, 0, rm)
                        Op.SubsImm

    if hw >> 13 == 1
        val rd = bits(hw, 8, 3)
        val imm8 = hw & 0xFF

        return bits(hw, 11, 2) match
            0 ->
                set(into, rd, 0, 0, imm8)
                Op.MovsImm
            1 ->
                set(into, rd, 0, 0, imm8)
                Op.CmpImm
            2 ->
                set(into, rd, rd, 0, imm8)
                Op.AddsImm
            _ ->
                set(into, rd, rd, 0, imm8)
                Op.SubsImm

    if hw >> 10 == 0b010000
        set(into, lo3, mid3, 0, 0)

        return bits(hw, 6, 4) match
            0 -> Op.Ands
            1 -> Op.Eors
            2 -> Op.LslsReg
            3 -> Op.LsrsReg
            4 -> Op.AsrsReg
            5 -> Op.Adcs
            6 -> Op.Sbcs
            7 -> Op.Rors
            8 -> Op.Tst
            9 -> Op.Negs
            10 -> Op.CmpReg
            11 -> Op.Cmn
            12 -> Op.Orrs
            13 -> Op.Muls
            14 -> Op.Bics
            _ -> Op.Mvns

    if hw >> 10 == 0b010001
        // Special data processing and branch exchange; the registers reach r8–r15.
        val rd = lo3 | (bits(hw, 7, 1) << 3)
        val rm = bits(hw, 3, 4)

        return bits(hw, 8, 2) match
            0 ->
                if rd == 15 then return Op.Undefined
                // `ADD Rdn, PC` reads the PC, which is a constant here: the address plus 4.
                if rm == 15
                    set(into, rd, rd, 0, pc + 4)
                    return Op.AddImm
                set(into, rd, rm, 0, 0)
                Op.AddHi
            1 ->
                if rm == 15 then return Op.Undefined
                set(into, rd, rm, 0, 0)
                Op.CmpReg
            2 ->
                if rd == 15
                    set(into, 0, rm, 0, 0)
                    return Op.MovPc
                if rm == 15
                    set(into, rd, 0, 0, pc + 4)
                    return Op.LoadConst
                set(into, rd, rm, 0, 0)
                Op.MovHi
            _ ->
                set(into, 0, rm, 0, 0)
                if bits(hw, 7, 1) == 0 then Op.Bx else Op.Blx

    if hw >> 11 == 0b01001
        set(into, bits(hw, 8, 3), 0, 0, ((pc + 4) & ~3) + ((hw & 0xFF) << 2))
        return Op.LdrLit

    if hw >> 12 == 0b0101
        set(into, lo3, mid3, bits(hw, 6, 3), 0)

        return bits(hw, 9, 3) match
            0 -> Op.StrReg
            1 -> Op.StrhReg
            2 -> Op.StrbReg
            3 -> Op.LdrsbReg
            4 -> Op.LdrReg
            5 -> Op.LdrhReg
            6 -> Op.LdrbReg
            _ -> Op.LdrshReg

    val load = bits(hw, 11, 1) == 1
    val imm5 = bits(hw, 6, 5)

    if hw >> 12 == 0b0110
        set(into, lo3, mid3, 0, imm5 << 2)
        return if load then Op.LdrImm else Op.StrImm

    if hw >> 12 == 0b0111
        set(into, lo3, mid3, 0, imm5)
        return if load then Op.LdrbImm else Op.StrbImm

    if hw >> 12 == 0b1000
        set(into, lo3, mid3, 0, imm5 << 1)
        return if load then Op.LdrhImm else Op.StrhImm

    if hw >> 12 == 0b1001
        set(into, bits(hw, 8, 3), 13, 0, (hw & 0xFF) << 2)
        return if load then Op.LdrImm else Op.StrImm

    if hw >> 11 == 0b10100
        set(into, bits(hw, 8, 3), 0, 0, ((pc + 4) & ~3) + ((hw & 0xFF) << 2))
        return Op.LoadConst

    if hw >> 11 == 0b10101
        set(into, bits(hw, 8, 3), 13, 0, (hw & 0xFF) << 2)
        return Op.AddImm

    if hw >> 12 == 0b1011
        return decode_misc(hw, into)

    if hw >> 11 == 0b11000
        set(into, bits(hw, 8, 3), 0, 0, hw & 0xFF)
        return Op.Stm

    if hw >> 11 == 0b11001
        set(into, bits(hw, 8, 3), 0, 0, hw & 0xFF)
        return Op.Ldm

    if hw >> 12 == 0b1101
        val cond = bits(hw, 8, 4)

        if cond == 15
            set(into, 0, 0, 0, hw & 0xFF)
            return Op.Svc

        if cond == 14 then return Op.Undefined

        set(into, 0, 0, 0, records_to(pc, pc + 4 + sext((hw & 0xFF) << 1, 9)))

        return cond match
            0 -> Op.Beq
            1 -> Op.Bne
            2 -> Op.Bcs
            3 -> Op.Bcc
            4 -> Op.Bmi
            5 -> Op.Bpl
            6 -> Op.Bvs
            7 -> Op.Bvc
            8 -> Op.Bhi
            9 -> Op.Bls
            10 -> Op.Bge
            11 -> Op.Blt
            12 -> Op.Bgt
            _ -> Op.Ble

    if hw >> 11 == 0b11100
        set(into, 0, 0, 0, records_to(pc, pc + 4 + sext((hw & 0x7FF) << 1, 12)))
        return Op.B

    if hw >> 11 == 0b11110
        return decode32(cpu, pc, hw, load16(cpu, pc + 2), into)

    Op.Undefined

private decode_misc(hw: u32, into: *Insn) -> Op
    val rd = bits(hw, 0, 3)
    val rm = bits(hw, 3, 3)

    if hw >> 8 == 0b10110000
        val imm = (hw & 0x7F) << 2

        set(into, 13, 13, 0, if bits(hw, 7, 1) == 0 then imm else 0 - imm)
        return Op.AddImm

    if hw >> 8 == 0b10110010
        set(into, rd, rm, 0, 0)

        return bits(hw, 6, 2) match
            0 -> Op.Sxth
            1 -> Op.Sxtb
            2 -> Op.Uxth
            _ -> Op.Uxtb

    if hw >> 9 == 0b1011010
        set(into, 0, 0, 0, (hw & 0xFF) | (bits(hw, 8, 1) << 14))
        return Op.Push

    if hw >> 9 == 0b1011110
        set(into, 0, 0, 0, hw & 0xFF)
        return if bits(hw, 8, 1) == 1 then Op.PopPc else Op.Pop

    if hw >> 8 == 0b10111010
        set(into, rd, rm, 0, 0)

        return bits(hw, 6, 2) match
            0 -> Op.Rev
            1 -> Op.Rev16
            3 -> Op.Revsh
            _ -> Op.Undefined

    if hw >> 8 == 0b10111110
        set(into, 0, 0, 0, hw & 0xFF)
        return Op.Bkpt

    if hw == 0xBF30 then return Op.Wfi

    if hw >> 8 == 0b10111111 then return Op.Nop

    if hw >> 5 == 0b10110110011
        set(into, 0, 0, 0, bits(hw, 4, 1))
        return Op.Cps

    Op.Undefined

private decode32(cpu: *Cpu, pc: u32, hw1: u32, hw2: u32, into: *Insn) -> Op
    if hw2 >> 14 == 0b11 && bits(hw2, 12, 1) == 1
        // BL: S:I1:I2:imm10:imm11:0, with I1 = ~(J1 ^ S) and I2 = ~(J2 ^ S).
        val s = bits(hw1, 10, 1)
        val i1 = ~(bits(hw2, 13, 1) ^ s) & 1
        val i2 = ~(bits(hw2, 11, 1) ^ s) & 1
        val off = (s << 24) | (i1 << 23) | (i2 << 22) | ((hw1 & 0x3FF) << 12) | ((hw2 & 0x7FF) << 1)

        set(into, 0, 0, 0, records_to(pc, pc + 4 + sext(off, 25)))
        return Op.Bl

    if hw1 == 0xF3BF && hw2 >> 8 == 0x8F then return Op.Barrier

    // MRS and MSR name a special register by SYSm; one this core lacks, or SP or PC as the general
    // register, is UNPREDICTABLE, and refused.
    val sysm = hw2 & 0xFF

    if hw1 == 0xF3EF && hw2 >> 12 == 0b1000 && special(sysm)
        val rd = bits(hw2, 8, 4)

        if rd >= 13 then return Op.Undefined

        set(into, rd, 0, 0, sysm)
        return Op.Mrs

    if hw1 >> 4 == 0xF38 && hw2 >> 8 == 0x88 && special(sysm)
        val rn = hw1 & 0xF

        if rn >= 13 then return Op.Undefined

        set(into, 0, rn, 0, sysm)
        return Op.Msr

    Op.Undefined

// The special registers ARMv6-M has: the PSR views (0–3, 5–7), MSP, PSP, PRIMASK and CONTROL.
private special(sysm: u32) -> bool = sysm <= 3 || (sysm >= 5 && sysm <= 9) || sysm == 16 || sysm == 20
