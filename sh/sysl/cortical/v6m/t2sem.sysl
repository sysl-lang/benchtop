module sh.sysl.cortical.v6m

import sysl.sync.*

// What each ARMv8-M Mainline instruction does, written once, as sem.sysl does for ARMv6-M (ARMv8-M
// ARM, DDI0553, the instruction descriptions' pseudocode). Both executors call these. A family of
// operations shares one function taking the operation: the threaded executor calls it with a
// constant, so each handler is one operation's code alone, and the `match` executor with the record's
// field.

// The data-processing operations, as `DpReg` keeps them and the immediate forms are mapped to. Each
// flag-setting one is its plain one plus 1.
const DP_AND: u32 = 0
const DP_ANDS: u32 = 1
const DP_BIC: u32 = 2
const DP_BICS: u32 = 3
const DP_ORR: u32 = 4
const DP_ORRS: u32 = 5
const DP_ORN: u32 = 6
const DP_ORNS: u32 = 7
const DP_EOR: u32 = 8
const DP_EORS: u32 = 9
const DP_ADD: u32 = 10
const DP_ADDS: u32 = 11
const DP_ADC: u32 = 12
const DP_ADCS: u32 = 13
const DP_SBC: u32 = 14
const DP_SBCS: u32 = 15
const DP_SUB: u32 = 16
const DP_SUBS: u32 = 17
const DP_RSB: u32 = 18
const DP_RSBS: u32 = 19
const DP_MOV: u32 = 20
const DP_MOVS: u32 = 21
const DP_MVN: u32 = 22
const DP_MVNS: u32 = 23
const DP_TST: u32 = 24
const DP_TEQ: u32 = 25
const DP_CMP: u32 = 26
const DP_CMN: u32 = 27

// The kinds of shift: by an immediate, `DecodeImmShift`'s; by a register, the first four.
const SH_LSL: u32 = 0
const SH_LSR: u32 = 1
const SH_ASR: u32 = 2
const SH_ROR: u32 = 3
const SH_RRX: u32 = 4

// `DpImm`'s operations. A `BIC`, `ORN` or `MVN` immediate is its complement under `AND`, `ORR` or
// `MOV`, an `SBC` is an `ADC` of the complement, and a `SUB` an `ADD` of the negation, so none has a
// case of its own.
const IMM_AND: u32 = 0
const IMM_ORR: u32 = 1
const IMM_EOR: u32 = 2
const IMM_ADD: u32 = 3
const IMM_ADC: u32 = 4
const IMM_RSB: u32 = 5
const IMM_MOV: u32 = 6
const IMM_ADDS: u32 = 7
const IMM_ADCS: u32 = 8
const IMM_SUBS: u32 = 9
const IMM_RSBS: u32 = 10
const IMM_CMP: u32 = 11
const IMM_CMN: u32 = 12

// `LogicImm`'s: the flag-setting logical operations, whose C is the immediate's own carry-out.
const LOGIC_AND: u32 = 0
const LOGIC_ORR: u32 = 1
const LOGIC_EOR: u32 = 2
const LOGIC_MOV: u32 = 3
const LOGIC_TST: u32 = 4
const LOGIC_TEQ: u32 = 5

// The transfers of one register, for the loads and stores.
const XFER_LDR: u32 = 0
const XFER_LDRB: u32 = 1
const XFER_LDRH: u32 = 2
const XFER_LDRSB: u32 = 3
const XFER_LDRSH: u32 = 4
const XFER_STR: u32 = 5
const XFER_STRB: u32 = 6
const XFER_STRH: u32 = 7

// `LDR PC`'s addressing.
const PC_OFFSET: u32 = 0
const PC_PRE: u32 = 1
const PC_POST: u32 = 2
const PC_LITERAL: u32 = 3
const PC_REG: u32 = 4

// The exclusives' sizes.
const EX_WORD: u32 = 0
const EX_BYTE: u32 = 1
const EX_HALF: u32 = 2

// The 16-bit data-processing operations inside an IT block, where none sets a flag.
const ALU16_LSL: u32 = 0
const ALU16_LSR: u32 = 1
const ALU16_ASR: u32 = 2
const ALU16_ADD: u32 = 3
const ALU16_SUB: u32 = 4
const ALU16_AND: u32 = 5
const ALU16_EOR: u32 = 6
const ALU16_LSLR: u32 = 7
const ALU16_LSRR: u32 = 8
const ALU16_ASRR: u32 = 9
const ALU16_ADC: u32 = 10
const ALU16_SBC: u32 = 11
const ALU16_RORR: u32 = 12
const ALU16_NEG: u32 = 13
const ALU16_ORR: u32 = 14
const ALU16_MUL: u32 = 15
const ALU16_BIC: u32 = 16
const ALU16_MVN: u32 = 17

// ---------------------------------------------------------------------------------------------------
// IT blocks.

// ITSTATE after the instruction it governs: the mask moves up a place, and the block ends when only
// its terminating 1 would be left (`ITAdvance`).
@inline
it_advance(st: u32) -> u32 = if st & 7 == 0 then 0 else (st & 0xE0) | ((st << 1) & 0x1F)

// ---------------------------------------------------------------------------------------------------
// Shifts.

// `x` shifted by `n` as `Shift_C` does, the kind being `kind`: C is set to the carry out where
// `setc` says so, which only the flag-setting logical operations ask for; an LSL by 0 leaves it.
// The amounts are the decoded ones: LSL 0–31, LSR and ASR 1–32, ROR 1–31, RRX 1.
@inline
shift_c(cpu: *Cpu, x: u32, kind: u32, n: u32, setc: bool) -> u32
    if kind == SH_LSL
        if n == 0 then return x
        if setc then cpu.c = (x >> (32 - n)) & 1
        return x << n

    if kind == SH_LSR
        if setc then cpu.c = (x >> (n - 1)) & 1
        return if n == 32 then 0 else x >> n

    if kind == SH_ASR
        if setc then cpu.c = u32(i32(x) >> (n - 1)) & 1
        return u32(i32(x) >> (if n == 32 then 31 else n))

    if kind == SH_ROR
        val r = (x >> n) | (x << (32 - n))

        if setc then cpu.c = r >> 31
        return r

    val r = (cpu.c << 31) | (x >> 1)

    if setc then cpu.c = x & 1
    r

// `x` shifted by the bottom byte of `by`, as a shift by a register computes it, without the carry.
shift_by(x: u32, kind: u32, by: u32) -> u32
    val n = by & 0xFF

    if kind == SH_ROR
        val k = n & 31

        return if k == 0 then x else (x >> k) | (x << (32 - k))

    if n == 0 then return x

    if kind == SH_LSL then return if n >= 32 then 0 else x << n
    if kind == SH_LSR then return if n >= 32 then 0 else x >> n

    u32(i32(x) >> (if n >= 32 then 31 else n))

// Whether operation `op` sets C from its shifted operand: the flag-setting logical ones.
@inline
sets_carry(op: u32) -> bool = op == DP_ANDS || op == DP_BICS || op == DP_ORRS || op == DP_ORNS || op == DP_EORS || op == DP_MOVS || op == DP_MVNS || op == DP_TST || op == DP_TEQ

// ---------------------------------------------------------------------------------------------------
// Data processing.

// Operation `op` on `a` (the first operand, Rn) and `x` (the second, shifted or immediate), into
// `rd` where it writes one.
@inline
alu(cpu: *Cpu, op: u32, rd: u4, a: u32, x: u32)
    op match
        DP_AND -> put(cpu, rd, a & x)
        DP_ANDS -> put(cpu, rd, nz_of(cpu, a & x))
        DP_BIC -> put(cpu, rd, a & ~x)
        DP_BICS -> put(cpu, rd, nz_of(cpu, a & ~x))
        DP_ORR -> put(cpu, rd, a | x)
        DP_ORRS -> put(cpu, rd, nz_of(cpu, a | x))
        DP_ORN -> put(cpu, rd, a | ~x)
        DP_ORNS -> put(cpu, rd, nz_of(cpu, a | ~x))
        DP_EOR -> put(cpu, rd, a ^ x)
        DP_EORS -> put(cpu, rd, nz_of(cpu, a ^ x))
        DP_ADD -> put(cpu, rd, a + x)
        DP_ADDS -> put(cpu, rd, add_flags(cpu, a, x, 0))
        DP_ADC -> put(cpu, rd, a + x + cpu.c)
        DP_ADCS -> put(cpu, rd, add_flags(cpu, a, x, cpu.c))
        DP_SBC -> put(cpu, rd, a + ~x + cpu.c)
        DP_SBCS -> put(cpu, rd, sub_flags(cpu, a, x, cpu.c))
        DP_SUB -> put(cpu, rd, a - x)
        DP_SUBS -> put(cpu, rd, sub_flags(cpu, a, x, 1))
        DP_RSB -> put(cpu, rd, x - a)
        DP_RSBS -> put(cpu, rd, sub_flags(cpu, x, a, 1))
        DP_MOV -> put(cpu, rd, x)
        DP_MOVS -> put(cpu, rd, nz_of(cpu, x))
        DP_MVN -> put(cpu, rd, ~x)
        DP_MVNS -> put(cpu, rd, nz_of(cpu, ~x))
        DP_TST -> cpu.nz = a & x
        DP_TEQ -> cpu.nz = a ^ x
        DP_CMP -> set_cmp(cpu, a, x)
        _ -> set_cmn(cpu, a, x)

@inline
private set_cmp(cpu: *Cpu, a: u32, x: u32)
    sub_flags(cpu, a, x, 1)

@inline
private set_cmn(cpu: *Cpu, a: u32, x: u32)
    add_flags(cpu, a, x, 0)

// The data-processing operation an immediate form's case stands for.
@inline
imm_op(c: u32) -> u32 = c match
    0 -> DP_AND
    1 -> DP_ORR
    2 -> DP_EOR
    3 -> DP_ADD
    4 -> DP_ADC
    5 -> DP_RSB
    6 -> DP_MOV
    7 -> DP_ADDS
    8 -> DP_ADCS
    9 -> DP_SUBS
    10 -> DP_RSBS
    11 -> DP_CMP
    _ -> DP_CMN

@inline
logic_op(c: u32) -> u32 = c match
    0 -> DP_ANDS
    1 -> DP_ORRS
    2 -> DP_EORS
    3 -> DP_MOVS
    4 -> DP_TST
    _ -> DP_TEQ

// The second operand of a `DpReg`: Rm, shifted as the record says.
@inline
dp_operand(cpu: *Cpu, i: *Insn, setc: bool) -> u32 = shift_c(cpu, reg(cpu, i.c), (i.imm >> 6) & 7, i.imm & 63, setc)

@inline
x_dp_reg(cpu: *Cpu, i: *Insn)
    val op = i.imm >> 12

    alu(cpu, op, i.a, reg(cpu, i.b), dp_operand(cpu, i, sets_carry(op)))

@inline
x_dp_imm(cpu: *Cpu, i: *Insn) = alu(cpu, imm_op(u32(i.c)), i.a, reg(cpu, i.b), i.imm)

// A flag-setting logical operation on an immediate: with `carry`, C is first set to the immediate's
// carry-out (`c`'s bit 3), which no logical operation reads.
@inline
x_logic_imm(cpu: *Cpu, i: *Insn, carry: bool)
    if carry then cpu.c = (u32(i.c) >> 3) & 1
    alu(cpu, logic_op(u32(i.c) & 7), i.a, reg(cpu, i.b), i.imm)

x_shift_reg(cpu: *Cpu, i: *Insn)
    val x = reg(cpu, i.b)
    val by = reg(cpu, i.c)
    val kind = i.imm & 3

    if i.imm & 16 == 0
        put(cpu, i.a, shift_by(x, kind, by))
        return

    val r = kind match
        0 -> lsl_reg(cpu, x, by)
        1 -> lsr_reg(cpu, x, by)
        2 -> asr_reg(cpu, x, by)
        _ -> ror_reg(cpu, x, by)

    put(cpu, i.a, nz_of(cpu, r))

// A 16-bit data-processing instruction inside an IT block: the same value outside one would give,
// and no flag written.
x_it_alu(cpu: *Cpu, i: *Insn)
    val x = reg(cpu, i.a)
    val y = reg(cpu, i.b)
    val k = i.imm >> 8

    val r = i.imm & 0xFF match
        0 -> y << k
        1 -> if k == 32 then 0 else y >> k
        2 -> u32(i32(y) >> (if k == 32 then 31 else k))
        3 -> y + reg(cpu, i.c)
        4 -> y - reg(cpu, i.c)
        5 -> x & y
        6 -> x ^ y
        7 -> shift_by(x, SH_LSL, y)
        8 -> shift_by(x, SH_LSR, y)
        9 -> shift_by(x, SH_ASR, y)
        10 -> x + y + cpu.c
        11 -> x + ~y + cpu.c
        12 -> shift_by(x, SH_ROR, y)
        13 -> 0 - y
        14 -> x | y
        15 -> x * y
        16 -> x & ~y
        _ -> ~y

    put(cpu, i.a, r)

@inline
x_movt(cpu: *Cpu, i: *Insn) = put(cpu, i.a, (reg(cpu, i.a) & 0xFFFF) | (i.imm << 16))

// `w` ones, 0 to 32 of them.
@inline
ones(w: u32) -> u32 = if w >= 32 then 0xFFFFFFFF else (1 << w) - 1

@inline
x_bfi(cpu: *Cpu, i: *Insn)
    val lsb = i.imm & 31
    val mask = ones(i.imm >> 8) << lsb

    put(cpu, i.a, (reg(cpu, i.a) & ~mask) | ((reg(cpu, i.b) << lsb) & mask))

@inline
x_bfc(cpu: *Cpu, i: *Insn) = put(cpu, i.a, reg(cpu, i.a) & ~(ones(i.imm >> 8) << (i.imm & 31)))

@inline
x_ubfx(cpu: *Cpu, i: *Insn) = put(cpu, i.a, (reg(cpu, i.b) >> (i.imm & 31)) & ones(i.imm >> 8))

@inline
x_sbfx(cpu: *Cpu, i: *Insn) = put(cpu, i.a, sext((reg(cpu, i.b) >> (i.imm & 31)) & ones(i.imm >> 8), i.imm >> 8))

// The number of 0 bits above the highest 1.
clz(x: u32) -> u32
    if x == 0 then return 32

    var n: u32 = 0
    var v = x

    if v & 0xFFFF0000 == 0
        n += 16
        v <<= 16
    if v & 0xFF000000 == 0
        n += 8
        v <<= 8
    if v & 0xF0000000 == 0
        n += 4
        v <<= 4
    if v & 0xC0000000 == 0
        n += 2
        v <<= 2
    if v & 0x80000000 == 0 then n += 1

    n

// The bits in the other order.
rbit(x: u32) -> u32
    var v = x

    v = ((v >> 1) & 0x55555555) | ((v & 0x55555555) << 1)
    v = ((v >> 2) & 0x33333333) | ((v & 0x33333333) << 2)
    v = ((v >> 4) & 0x0F0F0F0F) | ((v & 0x0F0F0F0F) << 4)
    v = ((v >> 8) & 0x00FF00FF) | ((v & 0x00FF00FF) << 8)
    (v >> 16) | (v << 16)

@inline
x_bit_op(cpu: *Cpu, i: *Insn, op: u32)
    val x = reg(cpu, i.b)

    put(cpu, i.a, op match
        0 -> clz(x)
        1 -> rbit(x)
        2 -> (x >> 24) | ((x >> 8) & 0xFF00) | ((x << 8) & 0xFF0000) | (x << 24)
        3 -> ((x >> 8) & 0x00FF00FF) | ((x << 8) & 0xFF00FF00)
        _ -> sext(((x >> 8) & 0xFF) | ((x & 0xFF) << 8), 16))

@inline
x_extend(cpu: *Cpu, i: *Insn, op: u32)
    val v = reg(cpu, i.b)
    val r = i.imm
    val x = if r == 0 then v else (v >> r) | (v << (32 - r))

    put(cpu, i.a, op match
        0 -> sext(x & 0xFFFF, 16)
        1 -> x & 0xFFFF
        2 -> sext(x & 0xFF, 8)
        _ -> x & 0xFF)

// ---------------------------------------------------------------------------------------------------
// Multiplies, divides, saturation.

@inline
x_mul_w(cpu: *Cpu, i: *Insn) = put(cpu, i.a, reg(cpu, i.b) * reg(cpu, i.c))

@inline
x_mla(cpu: *Cpu, i: *Insn) = put(cpu, i.a, reg(cpu, i.b) * reg(cpu, i.c) + reg(cpu, u4(i.imm)))

@inline
x_mls(cpu: *Cpu, i: *Insn) = put(cpu, i.a, reg(cpu, u4(i.imm)) - reg(cpu, i.b) * reg(cpu, i.c))

// The 64-bit result of a long multiply into RdLo (`a`) and RdHi (`imm`).
@inline
put_long(cpu: *Cpu, i: *Insn, x: u64)
    put(cpu, i.a, u32(x))
    put(cpu, u4(i.imm), u32(x >> 32))

// RdHi:RdLo, the accumulator of `UMLAL` and `SMLAL`.
@inline
long_acc(cpu: *Cpu, i: *Insn) -> u64 = (u64(reg(cpu, u4(i.imm))) << 32) | u64(reg(cpu, i.a))

@inline
signed_product(cpu: *Cpu, i: *Insn) -> u64 = u64(i64(i32(reg(cpu, i.b))) * i64(i32(reg(cpu, i.c))))

@inline
x_umull(cpu: *Cpu, i: *Insn) = put_long(cpu, i, u64(reg(cpu, i.b)) * u64(reg(cpu, i.c)))

@inline
x_smull(cpu: *Cpu, i: *Insn) = put_long(cpu, i, signed_product(cpu, i))

@inline
x_umlal(cpu: *Cpu, i: *Insn) = put_long(cpu, i, u64(reg(cpu, i.b)) * u64(reg(cpu, i.c)) + long_acc(cpu, i))

@inline
x_smlal(cpu: *Cpu, i: *Insn) = put_long(cpu, i, signed_product(cpu, i) + long_acc(cpu, i))

// CCR.DIV_0_TRP: a division by 0 is a UsageFault rather than a quotient of 0.
const CCR_DIV_0_TRP: u32 = 1 << 4

// A division by 0: 0, or, where CCR traps it, the UsageFault cortical does not take, which stops the
// core on the instruction. Answers whether the division went ahead.
@cold
divided_by_zero(cpu: *Cpu, i: *Insn) -> bool
    if cpu.ccr & CCR_DIV_0_TRP != 0
        halt(cpu, Stop.Fault, addr_of(cpu, i))
        return false

    put(cpu, i.a, 0)
    true

@inline
x_udiv(cpu: *Cpu, i: *Insn) -> bool
    val d = reg(cpu, i.c)

    if d == 0 then return divided_by_zero(cpu, i)

    put(cpu, i.a, reg(cpu, i.b) / d)
    true

// The quotient rounds towards zero, and the one quotient too large, 0x80000000 / -1, is 0x80000000.
@inline
x_sdiv(cpu: *Cpu, i: *Insn) -> bool
    val d = reg(cpu, i.c)
    val x = reg(cpu, i.b)

    if d == 0 then return divided_by_zero(cpu, i)

    if x == 0x80000000 && d == 0xFFFFFFFF
        put(cpu, i.a, x)
        return true

    put(cpu, i.a, u32(i32(x) / i32(d)))
    true

// The operand of `SSAT` and `USAT`: Rn shifted left or arithmetically right.
@inline
sat_operand(cpu: *Cpu, i: *Insn) -> i64
    val kind = (i.imm >> 8) & 0xFF
    val n = i.imm >> 16

    i64(i32(shift_c(cpu, reg(cpu, i.b), kind, n, false)))

// Signed saturation to `imm & 0xFF` bits, 1–32; Q is set where the value had to be clamped.
x_ssat(cpu: *Cpu, i: *Insn)
    val x = sat_operand(cpu, i)
    val bits = i64(i.imm & 0xFF)
    val hi = (i64(1) << (bits - 1)) - 1
    val lo = -(i64(1) << (bits - 1))
    var r = x

    if x > hi
        r = hi
        cpu.q = 1
    else if x < lo
        r = lo
        cpu.q = 1

    put(cpu, i.a, u32(r))

// Unsigned saturation to `imm & 0xFF` bits, 0–31.
x_usat(cpu: *Cpu, i: *Insn)
    val x = sat_operand(cpu, i)
    val hi = (i64(1) << i64(i.imm & 0xFF)) - 1
    var r = x

    if x > hi
        r = hi
        cpu.q = 1
    else if x < 0
        r = 0
        cpu.q = 1

    put(cpu, i.a, u32(r))

// ---------------------------------------------------------------------------------------------------
// The stack limits. A write to SP below the limit of the stack in use is the UsageFault STKOF, which
// cortical does not take: the core stops on the instruction, with nothing of it done.

@inline
sp_limit(cpu: *Cpu) -> u32 = if on_process_stack(cpu) then cpu.psplim else cpu.msplim

// Whether moving SP to `v` would break its limit; if it would, the core is stopped on `i`.
@inline
breaks_limit(cpu: *Cpu, i: *Insn, v: u32) -> bool
    if v >= sp_limit(cpu) then return false

    halt(cpu, Stop.StackLimit, addr_of(cpu, i))
    true

// `PUSH` (16-bit), the limit checked before anything is stored.
x_push_l(cpu: *Cpu, i: *Insn, n: u64) -> bool
    if breaks_limit(cpu, i, cpu.r[13] - 4 * count(i.imm)) then return false

    x_push(cpu, i, n)

@inline
x_sp_imm(cpu: *Cpu, i: *Insn) -> bool
    val v = reg(cpu, i.b) + i.imm

    if breaks_limit(cpu, i, v) then return false

    cpu.r[13] = v
    true

@inline
x_sp_reg(cpu: *Cpu, i: *Insn) -> bool
    val v = if i.c == 0 then reg(cpu, i.b) else cpu.r[13] + reg(cpu, i.b)

    if breaks_limit(cpu, i, v) then return false

    cpu.r[13] = v
    true

// `ADD`, `SUB` or `MOV` into SP with a shifted register, as `DpReg` records it.
x_sp_reg_w(cpu: *Cpu, i: *Insn) -> bool
    val op = i.imm >> 12
    val x = dp_operand(cpu, i, false)
    val v = if op == DP_ADD then reg(cpu, i.b) + x else if op == DP_SUB then reg(cpu, i.b) - x else x

    if breaks_limit(cpu, i, v) then return false

    cpu.r[13] = v
    true

// ---------------------------------------------------------------------------------------------------
// Loads and stores. Each answers whether it was made, as the 16-bit ones do; one that stops the core
// (an access where nothing is, or a broken stack limit) has done nothing the architecture would keep.

// Transfer `xfer` of register `rt` at `a`.
@inline
transfer(cpu: *Cpu, xfer: u32, rt: u4, a: u32, n: u64) -> bool
    if xfer == XFER_LDR then return load(cpu, a, 4, n, &cpu.r[rt])
    if xfer == XFER_LDRB then return load(cpu, a, 1, n, &cpu.r[rt])
    if xfer == XFER_LDRH then return load(cpu, a, 2, n, &cpu.r[rt])
    if xfer == XFER_LDRSB then return load_signed(cpu, a, 1, n, rt)
    if xfer == XFER_LDRSH then return load_signed(cpu, a, 2, n, rt)
    if xfer == XFER_STR then return store(cpu, a, reg(cpu, rt), 4, n)
    if xfer == XFER_STRB then return store(cpu, a, reg(cpu, rt), 1, n)

    store(cpu, a, reg(cpu, rt), 2, n)

@inline
x_ld_imm(cpu: *Cpu, i: *Insn, xfer: u32, n: u64) -> bool = transfer(cpu, xfer, i.a, reg(cpu, i.b) + i.imm, n)

// With writeback: pre-indexed, the access is at the new base; post-indexed (`c`'s bit 3), at the old.
// A new SP is held to its limit first, so a push with `STR Rt, [SP, #-4]!` is checked as `PUSH` is.
@inline
x_ld_wb(cpu: *Cpu, i: *Insn, xfer: u32, n: u64) -> bool
    val base = reg(cpu, i.b)
    val moved = base + i.imm

    if i.b == 13 && breaks_limit(cpu, i, moved) then return false

    if !transfer(cpu, xfer, i.a, if i.c & 8 != 0 then base else moved, n) then return false

    put(cpu, i.b, moved)
    true

@inline
x_ld_reg(cpu: *Cpu, i: *Insn, xfer: u32, n: u64) -> bool = transfer(cpu, xfer, i.a, reg(cpu, i.b) + (reg(cpu, i.c) << (i.imm & 3)), n)

@inline
x_ld_lit(cpu: *Cpu, i: *Insn, n: u64) -> bool = transfer(cpu, u32(i.c), i.a, i.imm, n)

// `LDR PC, …`: the word for the PC, which it answers, with the base written back where the addressing
// says. The branch is the caller's.
x_ld_pc(cpu: *Cpu, i: *Insn, n: u64) -> Option[u32]
    val base = reg(cpu, i.b)
    val mode = u32(i.c)
    val moved = base + i.imm
    val at = mode match
        0 -> moved
        1 -> moved
        2 -> base
        3 -> i.imm
        _ -> base + (reg(cpu, i.a) << i.imm)
    var to: u32 = 0

    if (mode == PC_PRE || mode == PC_POST) && i.b == 13 && breaks_limit(cpu, i, moved) then return None
    if !load(cpu, at, 4, n, &to) then return None
    if mode == PC_PRE || mode == PC_POST then put(cpu, i.b, moved)

    Some(to)

// `LDRD`/`STRD`'s address and the base after it: `imm`'s low half is the signed offset, bits 16–17
// the addressing.
@inline
dual_at(cpu: *Cpu, i: *Insn) -> u32
    val base = reg(cpu, i.b)

    if (i.imm >> 16) & 3 == 2 then base else base + sext(i.imm & 0xFFFF, 16)

// Whether the addressing writes the base back.
@inline
dual_writes_back(i: *Insn) -> bool = (i.imm >> 16) & 3 != 0

// The base after a written-back `LDRD`/`STRD`.
@inline
dual_moved(cpu: *Cpu, i: *Insn) -> u32 = reg(cpu, i.b) + sext(i.imm & 0xFFFF, 16)

x_ldrd(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val at = dual_at(cpu, i)
    val moved = dual_moved(cpu, i)
    var lo: u32 = 0
    var hi: u32 = 0

    if dual_writes_back(i) && i.b == 13 && breaks_limit(cpu, i, moved) then return false
    if !load(cpu, at, 4, n, &lo) || !load(cpu, at + 4, 4, n, &hi) then return false

    if dual_writes_back(i) then put(cpu, i.b, moved)
    put(cpu, i.a, lo)
    put(cpu, i.c, hi)
    true

x_strd(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val at = dual_at(cpu, i)
    val moved = dual_moved(cpu, i)

    if dual_writes_back(i) && i.b == 13 && breaks_limit(cpu, i, moved) then return false
    if !store(cpu, at, reg(cpu, i.a), 4, n) || !store(cpu, at + 4, reg(cpu, i.c), 4, n) then return false

    if dual_writes_back(i) then put(cpu, i.b, moved)
    true

x_ldrd_lit(cpu: *Cpu, i: *Insn, n: u64) -> bool
    var lo: u32 = 0
    var hi: u32 = 0

    if !load(cpu, i.imm, 4, n, &lo) || !load(cpu, i.imm + 4, 4, n, &hi) then return false

    put(cpu, i.a, lo)
    put(cpu, i.c, hi)
    true

// The first address of a wide `LDM`/`STM` and the base after it: increment-after from the base, or
// decrement-before (`c`'s bit 1) ending below it.
@inline
multiple_from(cpu: *Cpu, i: *Insn) -> u32
    val base = reg(cpu, i.a)

    if i.c & 2 != 0 then base - 4 * count(i.imm) else base

@inline
multiple_end(cpu: *Cpu, i: *Insn) -> u32
    val base = reg(cpu, i.a)

    if i.c & 2 != 0 then base - 4 * count(i.imm) else base + 4 * count(i.imm)

x_stm_w(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val end = multiple_end(cpu, i)
    var at = multiple_from(cpu, i)

    if i.c & 1 != 0 && i.a == 13 && breaks_limit(cpu, i, end) then return false

    for k in 0..<16
        if (i.imm >> k) & 1 != 0
            if !store(cpu, at, cpu.r[k], 4, n) then return false
            at += 4

    if i.c & 1 != 0 then put(cpu, i.a, end)
    true

// The registers of a wide `LDM`'s list but the PC, from `at`, which is left past them. One that stops
// the core leaves the base as it was.
@inline
load_multiple(cpu: *Cpu, i: *Insn, n: u64, at: *u32) -> bool
    val base = reg(cpu, i.a)

    for k in 0..<15
        if (i.imm >> k) & 1 != 0
            if !load(cpu, at[0], 4, n, &cpu.r[k])
                put(cpu, i.a, base)
                return false
            at[0] += 4

    true

x_ldm_w(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val end = multiple_end(cpu, i)
    var at = multiple_from(cpu, i)

    if i.c & 1 != 0 && i.a == 13 && breaks_limit(cpu, i, end) then return false
    if !load_multiple(cpu, i, n, &at) then return false

    if i.c & 1 != 0 && (i.imm >> i.a) & 1 == 0 then put(cpu, i.a, end)
    true

// An `LDM` with the PC in its list: the rest, then the word for the PC, which it answers.
x_ldm_pc(cpu: *Cpu, i: *Insn, n: u64) -> Option[u32]
    val end = multiple_end(cpu, i)
    var at = multiple_from(cpu, i)
    var to: u32 = 0

    if i.c & 1 != 0 && i.a == 13 && breaks_limit(cpu, i, end) then return None
    if !load_multiple(cpu, i, n, &at) || !load(cpu, at, 4, n, &to) then return None

    if i.c & 1 != 0 && (i.imm >> i.a) & 1 == 0 then put(cpu, i.a, end)
    Some(to)

// `TBB` (`width` 1) and `TBH` (2): the address it branches to, forward from the instruction's address
// plus 4 by twice the table's entry; None where reading the entry stopped the core.
x_table(cpu: *Cpu, i: *Insn, width: u32, n: u64) -> Option[u32]
    val base = if i.a != 0 then i.imm else reg(cpu, i.b)
    var entry: u32 = 0

    if !load(cpu, base + width * reg(cpu, i.c), width, n, &entry) then return None

    Some(addr_of(cpu, i) + 4 + 2 * entry)

// ---------------------------------------------------------------------------------------------------
// Exclusives.
//
// **The local monitor** holds the address, size and value of the last load-exclusive. A
// store-exclusive succeeds where the monitor is set for the same address and size **and the memory
// still holds that value**, which it checks and replaces in one host compare-and-swap; either way the
// monitor is then clear. CLREX, exception entry and exception return clear it too.
//
// **The global monitor** is two checks. A load-exclusive watches its 64-byte line (cpu.sysl's
// `watch`), so any store to the line by the other core is counted, and the store-exclusive fails
// where the other core has stored to the line since, whatever it stored: a store of the very value
// that was there (A, then B, then A) fails it as it does on silicon. The granule is the line, as the
// architecture allows; a core's own stores between the two leave its reservation alone. Then the
// compare-and-swap fails it where the value changed by any other means, atomically against the other
// core's thread. In turns the check is exact. On two threads it misses only another core's two
// stores falling between the count's check and the compare-and-swap, a few host instructions apart.
// An exclusive to an address off the RAM (a device) is an ordinary access, and a store-exclusive
// there succeeds whenever the local monitor matches.

@inline
ex_width(size: u32) -> u32 = if size == EX_BYTE then 1 else if size == EX_HALF then 2 else 4

// An exclusive or ordered access to an address that is not a multiple of its size: the UsageFault
// UNALIGNED, which silicon raises whatever CCR.UNALIGN_TRP says and cortical does not take, so the
// core stops on the instruction with nothing loaded or stored. It also keeps the host's
// compare-and-swap aligned, as the host requires.
@cold
unaligned(cpu: *Cpu, i: *Insn) -> bool
    halt(cpu, Stop.Fault, addr_of(cpu, i))
    false

x_ldrex(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val at = reg(cpu, i.b) + i.imm
    val width = ex_width(u32(i.c) & 3)
    var x: u32 = 0

    if at & (width - 1) != 0 then return unaligned(cpu, i)

    val stores = if at < RAM_BYTES then watch(cpu, at, width) else 0

    if !load(cpu, at, width, n, &x) then return false

    put(cpu, i.a, x)
    cpu.excl = true
    cpu.excl_addr = at
    cpu.excl_size = width
    cpu.excl_value = x
    cpu.excl_stores = stores
    if i.c & 4 != 0 then atomic_fence(SeqCst)
    true

// Replace the `width` bytes at `a` on the host page `page` with `x` if they still hold `was`.
@inline
host_swap(page: usize, a: u32, width: u32, was: u32, x: u32) -> bool
    val at = page + (a & 0xFFF)

    width match
        4 ->
            val p: *u32 = ptr_cast(at)
            atomic_cas(p, was, x, SeqCst) == was
        2 ->
            val p: *u16 = ptr_cast(at)
            atomic_cas(p, u16(was), u16(x), SeqCst) == u16(was)
        _ ->
            val p: *u8 = ptr_cast(at)
            atomic_cas(p, u8(was), u8(x), SeqCst) == u8(was)

x_strex(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val at = reg(cpu, i.b) + (i.imm & 0xFFFF)
    val width = ex_width((i.imm >> 16) & 3)
    val x = reg(cpu, i.c)
    val held = cpu.excl && cpu.excl_addr == at && cpu.excl_size == width

    if at & (width - 1) != 0 then return unaligned(cpu, i)
    if (i.imm >> 18) & 1 != 0 then atomic_fence(SeqCst)

    if !held
        cpu.excl = false
        put(cpu, i.a, 1)
        return true

    val page = page_for(cpu, at, width)

    if page == 0
        slow_write(cpu, at, width, low_bytes(x, width), n)
        if cpu.stop != Stop.Budget then return false
        cpu.excl = false
        put(cpu, i.a, 0)
        return true

    cpu.excl = false

    if others_stores(cpu, at) == cpu.excl_stores && host_swap(page, at, width, cpu.excl_value, x)
        stored(cpu, at, width)
        put(cpu, i.a, 0)
    else
        put(cpu, i.a, 1)

    true

@inline
x_clrex(cpu: *Cpu)
    cpu.excl = false

// `LDA`, `LDAB`, `LDAH`: a load, ordered before everything after it.
x_lda(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val at = reg(cpu, i.b)
    val width = ex_width(u32(i.c))

    if at & (width - 1) != 0 then return unaligned(cpu, i)
    if !load(cpu, at, width, n, &cpu.r[i.a]) then return false

    atomic_fence(SeqCst)
    true

// `STL`, `STLB`, `STLH`: a store, ordered after everything before it.
x_stl(cpu: *Cpu, i: *Insn, n: u64) -> bool
    val at = reg(cpu, i.b)
    val width = ex_width(u32(i.c))

    if at & (width - 1) != 0 then return unaligned(cpu, i)

    atomic_fence(SeqCst)
    store(cpu, at, reg(cpu, i.a), width, n)

// Armv8.1-M CSEL/CSINC/CSINV/CSNEG. Register 15 is ZR here, never the guest PC.
// Select first, then write, so Rd may overlap either source. Every flag is preserved.
@inline
x_csel(cpu: *Cpu, ip: *Insn)
    val left: u32 = if ip.b == 15 then 0 else cpu.r[ip.b]
    val right: u32 = if ip.c == 15 then 0 else cpu.r[ip.c]
    val other: u32 = ip.imm >> 4 match
        1 -> right + 1
        2 -> ~right
        3 -> 0 - right
        _ -> right

    put(cpu, ip.a, if holds(cpu, ip.imm & 15) then left else other)
end x_csel
