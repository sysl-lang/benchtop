module sh.sysl.cortical.v6m

// Core identities and physical configuration limits. Defaults are the implemented scalar subset;
// optional extensions are declared by board descriptions and refused until their semantics exist.
enum Arch
    V6m
    V7m
    V8mBase
    V8mMain
    V81mMain
end Arch

struct Model
    name: string
    kind: Kind
    arch: Arch
    cpuid: u32
    irqs: int
    fpu: string
    dsp: bool
    security: bool
    icache: bool
    dcache: bool
    mpu_step: long
    mpu_max: long
end Model

// CPUID revisions are virtual-model choices; the part numbers identify the processor.
// Arm DDI0432 (M0), DDI0413 (M1), DDI0337 (M3), DDI0550 (M23), the M35P TRM,
// 102776 r0p3 (M52, implementer 0x63), 101051 r1p0 (M55), 101924 r0p0 (M85).
val MODELS: [12]Model = [
    Model("cortex-m0plus", Kind.V6m, Arch.V6m, 0x410CC601, 32, "none", false, false, false, false, 8, 8),
    Model("cortex-m4", Kind.V7em, Arch.V7m, 0x410FC241, 240, "sp", true, false, false, false, 8, 8),
    Model("cortex-m7", Kind.V7emM7, Arch.V7m, 0x410FC270, 240, "dp", true, false, true, true, 8, 16),
    Model("cortex-m33", Kind.V8mMain, Arch.V8mMain, 0x411FD210, 480, "sp", true, true, false, false, 4, 16),
    Model("cortex-m0", Kind.M0, Arch.V6m, 0x410CC200, 32, "none", false, false, false, false, 0, 0),
    Model("cortex-m1", Kind.M1, Arch.V6m, 0x410CC210, 32, "none", false, false, false, false, 0, 0),
    Model("cortex-m3", Kind.M3, Arch.V7m, 0x410FC230, 240, "none", false, false, false, false, 8, 8),
    Model("cortex-m23", Kind.M23, Arch.V8mBase, 0x410FD200, 240, "none", false, true, false, false, 4, 16),
    Model("cortex-m35p", Kind.M35p, Arch.V8mMain, 0x410FD310, 480, "sp", true, true, true, false, 4, 16),
    Model("cortex-m52", Kind.M52, Arch.V81mMain, 0x630FD243, 480, "dp", true, true, true, true, 4, 16),
    Model("cortex-m55", Kind.M55, Arch.V81mMain, 0x411FD220, 480, "dp", true, true, true, true, 4, 16),
    Model("cortex-m85", Kind.M85, Arch.V81mMain, 0x410FD230, 480, "dp", true, true, true, true, 4, 16),
]

model_named(name: string) -> Option[Model]
    for model in MODELS do if model.name == name then return Some(model)
    None

model_of(kind: Kind) -> Model
    for model in MODELS do if model.kind == kind then return model
    panic("core model is missing from the catalog")

// Tiny architecture predicates used at decode/run boundaries. No table lookup in handlers.
@inline
is_v6m(kind: Kind) -> bool = kind == Kind.V6m || kind == Kind.M0 || kind == Kind.M1

@inline
is_baseline(kind: Kind) -> bool = is_v6m(kind) || kind == Kind.M23

@inline
is_v7m(kind: Kind) -> bool = kind == Kind.V7em || kind == Kind.V7emM7 || kind == Kind.M3

@inline
is_v81m(kind: Kind) -> bool = kind == Kind.M52 || kind == Kind.M55 || kind == Kind.M85

@inline
default_priority_bits(kind: Kind) -> u32 = if is_baseline(kind) then 2 else 4

model_names() -> string
    var out = ""
    for i in 0..<MODELS.len
        if i > 0 then out += if i + 1 == MODELS.len then " or " else ", "
        out += MODELS[i].name
    out
end model_names
