module sh.sysl.cortical

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// A description, as it says its boards are wired and how they appear.
//
// **Three levels.** A *chip* (the RP2040, the RP2350) is built into the registry: its cores, its pins
// and its bus controllers. A *board* is a chip, or a set of cores, with the parts soldered to it, the
// pins and buses it exposes to whatever it is plugged into, and a view of itself. A *product* is one
// or more boards, each an instance with a name of its own, the parts outside them wired to the pins
// and buses they expose (`pico.GP15`), and a view of the whole. A description file is one board or
// one product.
//
// **This is the typed model a description reads into, and nothing in it behaves.** A part is a name,
// the library part it is an instance of, its parameters and its wires; what an LED *does* when its
// pin goes high is the part library's business. The model is what the checker validates, what
// `cortical check` prints, and what the emulator builds its machine from.
//
// **Every name and value keeps the span it was read from**, so a diagnostic about a part, a wire or
// an element points at the line that wrote it. The spans are not part of what a board *is*: two
// models are the same when `description_text` writes them identically.

/** Which of the two things a description file is. */
enum Form
    NoForm
    BoardForm
    ProductForm
end Form

/** A description file read: a board or a product. A board named rather than written out
 * (`board = pico2w`) keeps the name in `named`, and `board` is the board it names.
 */
struct Description
    form: Form
    board: Board
    named: string
    named_span: Span
    product: Product

/** A board: a chip, or for a board with no real chip, the cores on its bus; its parts; what it
 * exposes; and its view.
 */
struct Board
    name: string
    chip: string
    chip_span: Span
    cores: Buf[Core]
    cores_span: Span
    parts: Buf[Part]
    buses: Buf[Bus]
    exposed_pins: Buf[Exposed]
    exposed_buses: Buf[Exposed]
    exposes_span: Span
    view: View
    keys: Buf[KeyBinding]
    pointers: Buf[PointerBinding]

/** A product: its boards, the parts outside them, the buses those parts use, and its view. */
struct Product
    name: string
    boards: Buf[Instance]
    boards_span: Span
    parts: Buf[Part]
    buses: Buf[Bus]
    view: View
    keys: Buf[KeyBinding]
    pointers: Buf[PointerBinding]

/** One board in a product: `pico { board = pico, parts.led.color = red }`. `of` is the board as the
 * file names it, a board built into cortical or a file's path; `board` is that board once it is found,
 * with the overrides applied, and `found` says whether it was.
 */
struct Instance
    name: string
    name_span: Span
    of: string
    of_span: Span
    overrides: Buf[Override]
    board: Board
    found: bool

/** A parameter of one of a board's parts, set by the product it is in: `parts.led.color = red`. */
struct Override
    part: string
    part_span: Span
    param: Param

/** A pin or a bus a board exposes, by its name on the chip: `GP15`, `spi0`. `pin` is -1 for a bus. */
struct Exposed
    name: string
    pin: int
    span: Span

/** One of a chipless board's cores, by the registry's name for it: `cortex-m0plus`. */
struct Core
    name: string
    span: Span

/** One part instantiated from the library: `d1 { part = led, color = red, wire { anode = GP16 } }`.
 * A part on the cores' bus also has its place there: `at`, its window's `size`, and its `irq`.
 */
struct Part
    name: string
    name_span: Span
    kind: string
    kind_span: Span
    params: Buf[Param]
    wires: Buf[Wire]
    at: Option[Amount]
    size: Option[Amount]
    irq: Option[Amount]

/** A whole number a part's place on the bus is written in, with the text it was written as, so a
 * board is written back as it was read: `0x40000000`, `1M`, `7`.
 */
struct Amount
    n: long
    written: string
    name_span: Span
    span: Span

/** A parameter as the file wrote it. Its type is the literal's; the checker holds it to the part's. */
struct Param
    name: string
    name_span: Span
    value: Setting
    span: Span

enum Setting
    Whole(n: long)
    Number(x: real)
    Text(s: string)
    Flag(on: bool)
end Setting

/** One of a part's ports wired to something. */
struct Wire
    port: string
    port_span: Span
    to: Target
    span: Span

/** What a port is wired to: a pin of the chip (`GP16`), one of the chip's buses (`spi0`), or a dotted
 * name, which is a port another part offers (`wifi.gpio0`) or, in a product, a pin or bus a board
 * exposes (`pico.GP15`).
 */
enum Target
    Pin(n: int)
    Bus(name: string)
    Port(part: string, port: string)
end Target

/** One of the chip's bus controllers, with the pin each of its signals is routed to. In a product,
 * `board` is the instance whose chip it is.
 */
struct Bus
    board: string
    board_span: Span
    name: string
    name_span: Span
    signals: Buf[Signal]

struct Signal
    name: string
    name_span: Span
    pin: int
    span: Span

/** The window's drawing of a board or a product. Units are host pixels at 1×. */
struct View
    width: int
    height: int
    background: string
    elements: Buf[Element]
    span: Span

/** What an element draws: a part (which knows its own look), a caption, or a filled rectangle. */
enum Shows
    ShowPart(name: string)
    Caption(text: string)
    Fill(color: string)
end Shows

/** One visible thing in the view. `has_size` is false where the file gave no size; the checker fills
 * in a screen's from its part's glass and marks it `natural`, which is a size the file did not write.
 */
struct Element
    name: string
    name_span: Span
    shows: Shows
    shows_span: Span
    x: int
    y: int
    w: int
    h: int
    has_size: bool
    natural: bool
    label: string
    look: Buf[Param]
    span: Span

/** A host key driving one of a part's controls: `up = joystick.up`. */
struct KeyBinding
    key: string
    key_span: Span
    part: string
    control: string
    span: Span

/** The mouse on an element of the view driving a part that takes a point: `screen = touch`. */
struct PointerBinding
    element: string
    element_span: Span
    part: string
    span: Span

private nowhere() -> Span = Span(0, 0)

private empty_view() -> View = View(0, 0, "", buf(), nowhere())

/** The empty board. */
empty_board() -> Board =
    Board("", "", nowhere(), buf(), nowhere(), buf(), buf(), buf(), buf(), nowhere(), empty_view(), buf(), buf())

/** The empty product. */
empty_product() -> Product = Product("", buf(), nowhere(), buf(), buf(), empty_view(), buf(), buf())

/** The description an empty file is: neither a board nor a product. */
empty_description() -> Description = Description(NoForm, empty_board(), "", nowhere(), empty_product())

/** A part by name, or `None`. */
part_named(parts: Buf[Part], name: string) -> Option[Part]
    for p in parts
        if p.name == name then return Some(p)

    None
end part_named

/** A parameter by name, or `None`. */
param_named(params: Buf[Param], name: string) -> Option[Param]
    for p in params
        if p.name == name then return Some(p)

    None
end param_named

/** A board instance of a product by name, or `None`. */
instance_named(p: Product, name: string) -> Option[Instance]
    for i in p.boards
        if i.name == name then return Some(i)

    None
end instance_named

/** A pin's name, as a description writes it. */
pin_name(n: int) -> string = s"GP$n"

/** A target as a description writes it. */
target_text(t: Target) -> string
    t match
        Pin(n) -> pin_name(n)
        Bus(name) -> name
        Port(part, port) -> s"$part.$port"
end target_text

/** A setting as a description writes it, and as a message quotes it. */
setting_text(s: Setting) -> string
    s match
        Whole(n) -> str(n)
        Number(x) -> str(x)
        Text(t) -> t
        Flag(on) -> if on then "true" else "false"
end setting_text
