module sh.sysl.cortical

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// A board, as its description says it is wired and how it appears.
//
// **This is the typed model a board file reads into, and nothing in it behaves.** A part is a name,
// the library part it is an instance of, its parameters and its wires; what an LED *does* when its
// pin goes high is the part library's business, in a later milestone. The model is what the checker
// validates, what `cortical check` prints, and what the emulator will build its machine from.
//
// **Every name and value keeps the span it was read from**, so a diagnostic about a part, a wire or
// an element points at the line that wrote it. The spans are not part of what a board *is*: two
// models are the same board when `board_text` writes them identically.

/** A whole board. It names a chip, or, for a board with no real chip, the cores on its bus. */
struct Board
    name: string
    chip: string
    chip_span: Span
    cores: Buf[Core]
    cores_span: Span
    parts: Buf[Part]
    buses: Buf[Bus]
    panel: Panel
    keys: Buf[KeyBinding]
    pointers: Buf[PointerBinding]

/** One of a chipless board's cores, by the registry's name for it: `cortex-m0plus`. */
struct Core
    name: string
    span: Span

/** One part instantiated from the library: `d1 { part = led, color = red, wire { anode = GP16 } }`.
 * A part on the cores' bus also has its place there: `at`, its window's `size`, and its `irq`.
 */
struct Part
    name: string
    name_span: Span
    kind: string
    kind_span: Span
    params: Buf[Param]
    wires: Buf[Wire]
    at: Option[Amount]
    size: Option[Amount]
    irq: Option[Amount]

/** A whole number a part's place on the bus is written in, with the text it was written as, so a
 * board is written back as it was read: `0x40000000`, `1M`, `7`.
 */
struct Amount
    n: long
    written: string
    name_span: Span
    span: Span

/** A parameter as the file wrote it. Its type is the literal's; the checker holds it to the part's. */
struct Param
    name: string
    name_span: Span
    value: Setting
    span: Span

enum Setting
    Whole(n: long)
    Number(x: real)
    Text(s: string)
    Flag(on: bool)
end Setting

/** One of a part's ports wired to something. */
struct Wire
    port: string
    port_span: Span
    to: Target
    span: Span

/** What a port is wired to: a pin of the chip (`GP16`), one of the chip's buses (`spi0`), or a port
 * another part offers (`wifi.gpio0`).
 */
enum Target
    Pin(n: int)
    Bus(name: string)
    Port(part: string, port: string)
end Target

/** One of the chip's bus controllers, with the pin each of its signals is routed to. */
struct Bus
    name: string
    name_span: Span
    signals: Buf[Signal]

struct Signal
    name: string
    name_span: Span
    pin: int
    span: Span

/** The window's drawing of the board. Units are host pixels at 1×. */
struct Panel
    width: int
    height: int
    background: string
    elements: Buf[Element]
    span: Span

/** What an element draws: a part (which knows its own look), a caption, or a filled rectangle. */
enum Shows
    ShowPart(name: string)
    Caption(text: string)
    Fill(color: string)
end Shows

/** One visible thing on the panel. `has_size` is false where the file gave no size; the checker fills
 * in a screen's from its part's glass and marks it `natural`, which is a size the file did not write.
 */
struct Element
    name: string
    name_span: Span
    shows: Shows
    shows_span: Span
    x: int
    y: int
    w: int
    h: int
    has_size: bool
    natural: bool
    label: string
    look: Buf[Param]
    span: Span

/** A host key driving one of a part's controls: `up = joystick.up`. */
struct KeyBinding
    key: string
    key_span: Span
    part: string
    control: string
    span: Span

/** The mouse on a panel element driving a part that takes a point: `screen = touch`. */
struct PointerBinding
    element: string
    element_span: Span
    part: string
    span: Span

/** The empty board an empty file describes. */
empty_board() -> Board =
    Board("", "", Span(0, 0), buf(), Span(0, 0), buf(), buf(), Panel(0, 0, "", buf(), Span(0, 0)), buf(), buf())

/** A part by name, or `None`. */
part_named(b: Board, name: string) -> Option[Part]
    for p in b.parts
        if p.name == name then return Some(p)

    None
end part_named

/** A parameter by name, or `None`. */
param_named(params: Buf[Param], name: string) -> Option[Param]
    for p in params
        if p.name == name then return Some(p)

    None
end param_named

/** A pin's name, as a board file writes it. */
pin_name(n: int) -> string = s"GP$n"

/** A target as a board file writes it. */
target_text(t: Target) -> string
    t match
        Pin(n) -> pin_name(n)
        Bus(name) -> name
        Port(part, port) -> s"$part.$port"
end target_text

/** A setting as a board file writes it, and as a message quotes it. */
setting_text(s: Setting) -> string
    s match
        Whole(n) -> str(n)
        Number(x) -> str(x)
        Text(t) -> t
        Flag(on) -> if on then "true" else "false"
end setting_text
