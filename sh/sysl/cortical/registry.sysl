module sh.sysl.cortical

import sysl.buf.{Buf, buf}

// The part library, as the checker sees it: what each chip and each part declares about itself.
//
// **A description wires parts; a part declares what may be wired to it.** Each part names its ports
// -- a pin, an ADC pin, a bus of a kind, or a pin it offers to other parts -- its parameters with
// their types, and the controls a host key or the mouse can drive. Each chip names its pins and its
// bus controllers with the pins every signal can be routed to. The checker holds a board to these,
// so a wiring mistake is reported against the library rather than discovered when the emulator runs.
//
// **The registry is data, and that is the interface.** The checker asks it `chip(name)` and
// `part(name)` and nothing else, so a test builds a registry of its own (a chip with four thousand
// pins, a part that exists for one test), and giving a part behaviour adds a constructor beside its
// spec without changing what the checker reads. Chips live here and nowhere else: a description
// names one, and a board is built around it. `library` declares the
// cores, chips and parts the descriptions in `boards/` need. Of its parts, the three on the cores' bus
// are emulated (`sh.sysl.cortical.virt`); the rest are declared, checked and drawn, and do nothing.

/** What kind of pin a pin port needs. */
enum PinNeed
    AnyPin
    AdcPin
end PinNeed

enum PortKind
    // A wire to one pin of the chip, or to a pin another part offers.
    PinPort(need: PinNeed)
    // A wire to one of the chip's bus controllers, of this kind: `spi`, `i2c`, `uart`.
    BusPort(bus: string)
    // A pin this part drives that another part's pin port may be wired to (the CYW43439's GPIOs).
    Offer
end PortKind

struct PortSpec
    name: string
    kind: PortKind
    required: bool

enum ParamKind
    PWhole(min: long, max: long)
    PNumber
    PText
    PFlag
    PChoice(options: Buf[string])
end ParamKind

struct ParamSpec
    name: string
    kind: ParamKind
    required: bool

/** How a part sits on the cores' bus, for a part that is mapped there (a RAM, the debug console):
 * the window of addresses it answers, `size` bytes unless the board sets its own where `sized`
 * allows (a `size` of 0 means the board must); the alignment its base `at` needs; and whether it can
 * raise an interrupt, on the IRQ the board gives it.
 */
struct Window
    size: long
    sized: bool
    align: long
    raises: bool

/** A part of the library. `window` is where a part on the cores' bus says how it sits there.
 * `modelled` is false for a part the emulator accepts and draws but does not
 * emulate yet; a part wired to one of its offered pins is reported as driven through it. `display`
 * marks a part whose `width` and `height` parameters are its glass, which is an element's natural size.
 */
struct PartSpec
    name: string
    summary: string
    modelled: bool
    display: bool
    params: Buf[ParamSpec]
    ports: Buf[PortSpec]
    controls: Buf[string]
    window: Option[Window]

    port(self, name: string) -> Option[PortSpec]
        for p in self.ports
            if p.name == name then return Some(p)

        None
    end port

    param(self, name: string) -> Option[ParamSpec]
        for p in self.params
            if p.name == name then return Some(p)

        None
    end param
end PartSpec

/** One signal of a bus controller, and the pins it can be routed to. */
struct SignalSpec
    name: string
    pins: Buf[int]

struct ControllerSpec
    name: string
    kind: string
    signals: Buf[SignalSpec]

    signal(self, name: string) -> Option[SignalSpec]
        for s in self.signals
            if s.name == name then return Some(s)

        None
    end signal
end ControllerSpec

/** A core: what a chip is built around, or what a board with no real chip names in `cores`. `irqs`
 * is how many external interrupts its NVIC takes, IRQ 0 up to `irqs - 1`.
 */
struct CoreSpec
    name: string
    summary: string
    irqs: int

/** A chip: its cores, its pins `GP0` up to `GP<pins - 1>`, and its ADC channels `adc_pins`. */
struct ChipSpec
    name: string
    summary: string
    core: string
    pins: int
    adc_pins: Buf[int]
    controllers: Buf[ControllerSpec]

    controller(self, name: string) -> Option[ControllerSpec]
        for c in self.controllers
            if c.name == name then return Some(c)

        None
    end controller
end ChipSpec

struct Registry
    cores: Buf[CoreSpec]
    chips: Buf[ChipSpec]
    parts: Buf[PartSpec]

    core(self, name: string) -> Option[CoreSpec]
        for c in self.cores
            if c.name == name then return Some(c)

        None
    end core

    core_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for c in self.cores
            out.push(c.name)

        out
    end core_names

    chip(self, name: string) -> Option[ChipSpec]
        for c in self.chips
            if c.name == name then return Some(c)

        None
    end chip

    part(self, name: string) -> Option[PartSpec]
        for p in self.parts
            if p.name == name then return Some(p)

        None
    end part

    chip_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for c in self.chips
            out.push(c.name)

        out
    end chip_names

    part_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for p in self.parts
            out.push(p.name)

        out
    end part_names
end Registry

// -- the library -----------------------------------------------------------------------------------

/** The cores, chips and parts the descriptions in `boards/` use. The parts on the cores' bus (`ram`,
 * `debug-console`, `virt-sio`) are the ones `cortical run` builds a machine from.
 */
library() -> Registry
    var cores: Buf[CoreSpec] = buf()
    var chips: Buf[ChipSpec] = buf()
    var parts: Buf[PartSpec] = buf()

    cores.push(CoreSpec("cortex-m0plus", "Arm Cortex-M0+ (Armv6-M)", 32))
    cores.push(CoreSpec("cortex-m4", "Arm Cortex-M4 (Armv7E-M)", 240))
    cores.push(CoreSpec("cortex-m7", "Arm Cortex-M7 (Armv7E-M)", 240))
    cores.push(CoreSpec("cortex-m33", "Arm Cortex-M33 (Armv8-M Mainline)", 480))

    chips.push(ChipSpec("rp2040", "Raspberry Pi RP2040: two Cortex-M0+ at 133 MHz", "cortex-m0plus", 30, ints([26, 27, 28, 29]), rp_controllers()))
    chips.push(ChipSpec("rp2350", "Raspberry Pi RP2350A: two Cortex-M33 at 150 MHz", "cortex-m33", 30, ints([26, 27, 28, 29]), rp_controllers()))

    parts.push(PartSpec("ram", "RAM on the cores' bus, `size` bytes from `at`", true, false,
        specs([]), ports([]), names([]),
        Some(Window(0, true, 4096, false))))

    parts.push(PartSpec("debug-console", "a console on the host's terminal: DATA, STATUS, EXIT and CTRL, a word each from `at`; it raises `irq` while input waits", true, false,
        specs([]), ports([]), names([]),
        Some(Window(16, false, 16, true))))

    parts.push(PartSpec("virt-sio", "two cores' shared block after the RP2040's SIO: CPUID, the inter-core FIFOs and 32 spinlocks; it raises `irq` in a core whose FIFO wants attention", true, false,
        specs([]), ports([]), names([]),
        Some(Window(0x180, false, 4096, true))))

    parts.push(PartSpec("led", "a single-colour LED, lit while its pin is at its active level", true, false,
        specs([ParamSpec("color", choice(["red", "green", "blue", "yellow", "orange", "white"]), false),
               ParamSpec("active", choice(["high", "low"]), false)]),
        ports([PortSpec("anode", PinPort(AnyPin), true)]),
        names([]), None))

    parts.push(PartSpec("button", "a push button between its pin and ground (or 3V3 when `active = high`)", true, false,
        specs([ParamSpec("active", choice(["low", "high"]), false)]),
        ports([PortSpec("pin", PinPort(AnyPin), true)]),
        names(["press"]), None))

    parts.push(PartSpec("joystick", "a two-axis analogue stick, each axis a voltage on an ADC pin", true, false,
        specs([]),
        ports([PortSpec("x", PinPort(AdcPin), true), PortSpec("y", PinPort(AdcPin), true)]),
        names(["up", "down", "left", "right"]), None))

    parts.push(PartSpec("buzzer", "a buzzer: `active` sounds a fixed tone while its pin is high, `passive` sounds the pin's waveform", true, false,
        specs([ParamSpec("kind", choice(["active", "passive"]), true),
               ParamSpec("tone", PWhole(20, 20000), false)]),
        ports([PortSpec("pin", PinPort(AnyPin), true)]),
        names([]), None))

    parts.push(PartSpec("ws2812", "an addressable RGB LED, decoded from its data pin's waveform", true, false,
        specs([ParamSpec("count", PWhole(1, 1024), false)]),
        ports([PortSpec("din", PinPort(AnyPin), true)]),
        names([]), None))

    parts.push(PartSpec("st7796", "the Sitronix ST7796 TFT controller and its glass, over SPI", true, true,
        specs([ParamSpec("width", PWhole(1, 4096), true),
               ParamSpec("height", PWhole(1, 4096), true),
               ParamSpec("invert", PFlag, false),
               ParamSpec("variant", choice(["st7796", "ili9488"]), false)]),
        ports([PortSpec("spi", BusPort("spi"), true),
               PortSpec("cs", PinPort(AnyPin), true),
               PortSpec("dc", PinPort(AnyPin), true),
               PortSpec("reset", PinPort(AnyPin), false),
               PortSpec("backlight", PinPort(AnyPin), false)]),
        names([]), None))

    parts.push(PartSpec("gt911", "the Goodix GT911 capacitive touch controller, over I2C", true, false,
        specs([ParamSpec("address", PWhole(0, 127), true)]),
        ports([PortSpec("i2c", BusPort("i2c"), true),
               PortSpec("int", PinPort(AnyPin), false),
               PortSpec("reset", PinPort(AnyPin), false)]),
        names(["point"]), None))

    parts.push(PartSpec("terminal", "the host's terminal on a UART: what the board writes is printed, what is typed is sent", true, false,
        specs([ParamSpec("baud", PWhole(300, 4000000), false)]),
        ports([PortSpec("uart", BusPort("uart"), true)]),
        names([]), None))

    parts.push(PartSpec("cyw43439", "the Infineon CYW43439 Wi-Fi and Bluetooth chip, over gSPI; its GPIOs drive other parts", false, false,
        specs([]),
        ports([PortSpec("wl_on", PinPort(AnyPin), true),
               PortSpec("data", PinPort(AnyPin), true),
               PortSpec("cs", PinPort(AnyPin), true),
               PortSpec("clock", PinPort(AnyPin), true),
               PortSpec("gpio0", Offer, false),
               PortSpec("gpio1", Offer, false),
               PortSpec("gpio2", Offer, false)]),
        names([]), None))

    Registry(cores, chips, parts)
end library

// The bus controllers the RP2040 and the RP2350A share on GPIO 0 to 29: the SPI (F1), UART (F2) and
// I2C (F3) columns of each datasheet's GPIO function table.
private rp_controllers() -> Buf[ControllerSpec]
    var out: Buf[ControllerSpec] = buf()

    out.push(ControllerSpec("spi0", "spi", signals([
        SignalSpec("rx", ints([0, 4, 16, 20])), SignalSpec("cs", ints([1, 5, 17, 21])),
        SignalSpec("sck", ints([2, 6, 18, 22])), SignalSpec("tx", ints([3, 7, 19, 23]))])))
    out.push(ControllerSpec("spi1", "spi", signals([
        SignalSpec("rx", ints([8, 12, 24, 28])), SignalSpec("cs", ints([9, 13, 25, 29])),
        SignalSpec("sck", ints([10, 14, 26])), SignalSpec("tx", ints([11, 15, 27]))])))
    out.push(ControllerSpec("uart0", "uart", signals([
        SignalSpec("tx", ints([0, 12, 16, 28])), SignalSpec("rx", ints([1, 13, 17, 29]))])))
    out.push(ControllerSpec("uart1", "uart", signals([
        SignalSpec("tx", ints([4, 8, 20, 24])), SignalSpec("rx", ints([5, 9, 21, 25]))])))
    out.push(ControllerSpec("i2c0", "i2c", signals([
        SignalSpec("sda", ints([0, 4, 8, 12, 16, 20, 24, 28])), SignalSpec("scl", ints([1, 5, 9, 13, 17, 21, 25, 29]))])))
    out.push(ControllerSpec("i2c1", "i2c", signals([
        SignalSpec("sda", ints([2, 6, 10, 14, 18, 22, 26])), SignalSpec("scl", ints([3, 7, 11, 15, 19, 23, 27]))])))

    out
end rp_controllers

private choice(options: []const string) -> ParamKind = PChoice(names(options))

// The tables above are written as array literals; each of these names the element type the literal
// is read at, so an empty `[]` still has one.
private names(xs: []const string) -> Buf[string] = listed(xs)
private ints(xs: []const int) -> Buf[int] = listed(xs)
private specs(xs: []const ParamSpec) -> Buf[ParamSpec] = listed(xs)
private ports(xs: []const PortSpec) -> Buf[PortSpec] = listed(xs)
private signals(xs: []const SignalSpec) -> Buf[SignalSpec] = listed(xs)

private listed[T](xs: []const T) -> Buf[T]
    var out: Buf[T] = buf()

    out.extend(xs)
    out
end listed
