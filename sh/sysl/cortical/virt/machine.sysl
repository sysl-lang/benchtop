module sh.sysl.cortical.virt

import sh.sysl.cortical.{Board, Part, Registry, article_of, library, load}
import sh.sysl.cortical.v6m.RAM_BYTES
import sh.sysl.parsing.source
import sysl.buf.{Buf, buf}

// A board description made into the machine cortical runs.
//
// **The description is the machine.** Every device's base and IRQ comes from its part's `at` and
// `irq`, so a board that moves the console moves it for the guest too. What cortical can run is
// narrower than what `cortical check` accepts: two Cortex-M0+ cores, their RAM where the cores have
// it, and the parts cortical emulates on their bus. Anything else is refused by name, so a board
// described for the checker alone (a real chip, an LED) says why it does not run.

/** A board description read, checked and put on the bus; or the diagnostics or the reason it cannot
 * run. `name` is what the diagnostics call the file.
 */
board_from(name: string, text: []const u8) -> Result[Board, string]
    val src = source(name, text)
    val reg = library()
    val got = load(src, reg)

    if got.report.has_errors() then return Err(got.report.render(src))

    assemble(got.board, reg) match
        Ok(_) -> Ok(got.board)
        Err(why) -> Err(s"$name: $why\n")

/** Put the devices a checked board describes on the cores' bus, or say why cortical cannot run it. */
assemble(b: Board, reg: Registry) -> Result[unit, string]
    if !b.chip.is_empty() then
        return Err(s"cortical does not emulate the ${b.chip}: `cortical check` reads this board, and `cortical run` runs a board of two cortex-m0plus cores and the parts on their bus")

    var m0 = 0

    for c in b.cores
        if c.name == "cortex-m0plus" then m0 += 1

    if m0 != 2 || b.cores.len() != 2 then
        return Err(s"cortical runs two cortex-m0plus cores, and this board names ${core_names(b)}")

    var ds: Buf[Mapped] = buf()
    var ram = false

    for p in b.parts
        // A checked board has `at` on every part on the bus, and on no other.
        val at: long = p.at match
            Some(a) -> a.n
            None -> 0
        val irq = p.irq match
            Some(q) -> int(q.n)
            None -> -1

        p.kind match
            "ram" ->
                val size: long = p.size.unwrap().n

                if at != 0 || size != long(RAM_BYTES) then
                    return Err(f"cortical's cores have 1M of RAM at 0x00000000, and `${p.name}` is ${size} bytes at 0x${at}%08x")

                if ram then return Err(s"cortical's cores have one RAM, and `${p.name}` is a second")

                ram = true
            "debug-console" -> ds.push(placed(Console, p, at, 16, irq))
            "virt-sio" -> ds.push(placed(Sio, p, at, 0x180, irq))
            _ -> return Err(s"`${p.name}` is ${article_of(p.kind)} ${p.kind}, which cortical does not emulate")
    end for

    if !ram then return Err("the board has no `ram` at 0x00000000, where the cores boot from")

    for i in 0..<ds.len()
        for j in 0..<i
            if ds.at(i).device == ds.at(j).device then
                return Err(s"cortical runs one ${device_name(ds.at(i).device)}, and this board has two")

    attach(ds.view())
    Ok(())
end assemble

private placed(d: Device, p: Part, at: long, fixed: long, irq: int) -> Mapped
    val size: long = p.size match
        Some(s) -> s.n
        None -> fixed

    Mapped(d, u32(at), u32(at + size - 1), irq)

private device_name(d: Device) -> string = d match
    Console -> "`debug-console`"
    Sio -> "`virt-sio`"

private core_names(b: Board) -> string
    var out = ""

    for i in 0..<b.cores.len()
        if i > 0 then out = s"$out, "

        out = s"$out${b.cores.at(i).name}"

    out

