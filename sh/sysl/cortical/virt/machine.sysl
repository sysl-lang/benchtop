module sh.sysl.cortical.virt

import sh.sysl.cortical.{Board, Description, Part, ProductForm, Registry, article_of, built_in_shelf, library, load, open_description}
import sh.sysl.cortical.v6m.{Kind, RAM_BYTES}
import sh.sysl.parsing.{Diagnostic, Source, Span, source}
import sysl.buf.{Buf, buf}

// A board description made into the machine cortical runs.
//
// **The description is the machine.** Every device's base and IRQ comes from its part's `at` and
// `irq`, so a board that moves the console moves it for the guest too. What cortical can run is
// narrower than what `cortical check` accepts: two Cortex-M0+ cores or two Cortex-M33 cores, their
// RAM where the cores have it, and the parts cortical emulates on their bus. Anything else is refused by name, so a board
// described for the checker alone (a real chip, an LED) says why it does not run.

/** A board description read, checked and put on the bus; or the diagnostics or the reason it cannot
 * run. `name` is what the diagnostics call the file.
 */
board_from(name: string, text: []const u8) -> Result[Board, string] = board_of(source(name, text))

/** `board_from` for the description `which` names: one built into cortical, or a file's path. */
board_named(which: string) -> Result[Board, string]
    open_description(built_in_shelf(), which, "", Span(0, 0)) match
        Ok(src) -> board_of(src)
        Err(d) -> Err(described_error(d))

/** A mistake in naming a description on the command line, where there is no file to point into. */
described_error(d: Diagnostic) -> string
    val label = if d.label.is_empty() then "" else s" (${d.label})"

    s"cortical: ${d.message}$label\n  = note: ${d.note}\n"

private board_of(src: Source) -> Result[Board, string]
    val reg = library()
    val got = load(src, reg)

    if got.report.has_errors() then return Err(got.report.render(src))

    val b = runnable(got.description) match
        Ok(b) -> b
        Err(why) -> return Err(s"${src.name}: $why\n")

    assemble(b, reg) match
        Ok(_) -> Ok(b)
        Err(why) -> Err(s"${src.name}: $why\n")

/** The one board a description runs: the board it is, or a product's one board. A product's own
 * parts are outside every board's bus, and cortical does not run them.
 */
runnable(d: Description) -> Result[Board, string]
    if d.form != ProductForm then return Ok(d.board)

    val p = d.product

    if p.boards.len() != 1 then
        return Err(s"cortical runs one board, and this product has ${p.boards.len()}")

    if !p.parts.is_empty() then
        return Err(s"cortical runs a product's board and nothing outside it, and `${p.parts.at(0).name}` is outside it")

    Ok(p.boards.at(0).board)
end runnable

/** Put the devices a checked board describes on the cores' bus, or say why cortical cannot run it. */
assemble(b: Board, reg: Registry) -> Result[unit, string]
    if !b.chip.is_empty() then
        return Err(s"cortical does not emulate the ${b.chip}: `cortical check` reads this board, and `cortical run` runs a board of two cortex-m0plus, two cortex-m4, two cortex-m7 or two cortex-m33 cores and the parts on their bus")

    var m0 = 0
    var m33 = 0
    var m4 = 0
    var m7 = 0

    for c in b.cores
        if c.name == "cortex-m0plus" then m0 += 1
        if c.name == "cortex-m33" then m33 += 1
        if c.name == "cortex-m4" then m4 += 1
        if c.name == "cortex-m7" then m7 += 1

    if b.cores.len() != 2 || (m0 != 2 && m33 != 2 && m4 != 2 && m7 != 2) then
        return Err(s"cortical runs two cortex-m0plus, two cortex-m4, two cortex-m7 or two cortex-m33 cores, and this board names ${core_names(b)}")

    var ds: Buf[Mapped] = buf()
    var ram = false

    for p in b.parts
        // A checked board has `at` on every part on the bus, and on no other.
        val at: long = p.at match
            Some(a) -> a.n
            None -> 0
        val irq = p.irq match
            Some(q) -> int(q.n)
            None -> -1

        p.kind match
            "ram" ->
                val size: long = p.size.unwrap().n

                if at != 0 || size != long(RAM_BYTES) then
                    return Err(f"cortical's cores have 1M of RAM at 0x00000000, and `${p.name}` is ${size} bytes at 0x${at}%08x")

                if ram then return Err(s"cortical's cores have one RAM, and `${p.name}` is a second")

                ram = true
            "debug-console" -> ds.push(placed(Console, p, at, 16, irq))
            "virt-sio" -> ds.push(placed(Sio, p, at, 0x180, irq))
            _ -> return Err(s"`${p.name}` is ${article_of(p.kind)} ${p.kind}, which cortical does not emulate")
    end for

    if !ram then return Err("the board has no `ram` at 0x00000000, where the cores boot from")

    for i in 0..<ds.len()
        for j in 0..<i
            if ds.at(i).device == ds.at(j).device then
                return Err(s"cortical runs one ${device_name(ds.at(i).device)}, and this board has two")

    attach(ds.view(), if m33 == 2 then Kind.V8mMain else if m4 == 2 then Kind.V7em else if m7 == 2 then Kind.V7emM7 else Kind.V6m)
    Ok(())
end assemble

private placed(d: Device, p: Part, at: long, fixed: long, irq: int) -> Mapped
    val size: long = p.size match
        Some(s) -> s.n
        None -> fixed

    Mapped(d, u32(at), u32(at + size - 1), irq)

private device_name(d: Device) -> string = d match
    Console -> "`debug-console`"
    Sio -> "`virt-sio`"

private core_names(b: Board) -> string
    var out = ""

    for i in 0..<b.cores.len()
        if i > 0 then out = s"$out, "

        out = s"$out${b.cores.at(i).name}"

    out

