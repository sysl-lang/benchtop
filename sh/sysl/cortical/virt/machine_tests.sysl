module sh.sysl.cortical.virt
@tests

// The machine a description builds: its devices answer where the description puts them and raise
// the IRQs it gives them, and a board cortical cannot run is refused with the reason.

import sh.sysl.cortical.v6m.{Cpu, Stop}

val irq_moved = embed("../../../../examples/virt/irq-moved.elf")
val moved = embed("../../../../examples/virt/moved.hocon")

// The virtual board with its parts' places and IRQs as given, for the tests that move them.
private described(console: string, sio: string) -> string = s"""
    board { name = "test", cores = [cortex-m0plus, cortex-m0plus] }
    parts {
      ram     { part = ram, at = 0x00000000, size = 1M }
      console { part = debug-console, $console }
      sio     { part = virt-sio, $sio }
    }
    """

// What `board_from` says about a description, or "" where it runs.
private refusal(text: string) -> string = board_from("b.hocon", text.bytes) match
    Ok(_) -> ""
    Err(why) -> why

@test("irq.elf built for a console at 0x50000000 and IRQ 7 runs on moved.hocon as irq.elf runs on virt")
machine_moved_console()
    var cpu: Cpu

    on_board("moved.hocon", moved)
    booted_on(&cpu, irq_moved, "one\ntwo\n")
    run_board(&cpu)

    assert(output() == s"${IRQ_GREETING}one\ntwo\n\nbye after 8 bytes\n".bytes, str_cast(output()))
    assert(cpu.stop == Stop.Exit && cpu.stop_at == 0x50000008 && cpu.exit_code == 0)

@test("a program built for one console base finds nothing at it on a board that puts the console elsewhere")
machine_console_elsewhere()
    var cpu: Cpu

    booted(&cpu, irq_moved, "x\n")
    run_board(&cpu)
    assert(cpu.stop == Stop.Unmapped && cpu.stop_at == 0x50000000, f"${cpu.stop} at 0x${cpu.stop_at}%08x")

    on_board("moved.hocon", moved)
    booted_on(&cpu, irq, "x\n")
    run_board(&cpu)
    assert(cpu.stop == Stop.Unmapped && cpu.stop_at == 0x40000000, f"${cpu.stop} at 0x${cpu.stop_at}%08x")

@test("the console raises the IRQ its part gives, and none where it gives none")
machine_console_irq()
    var cpu: Cpu

    // irq-moved.elf enables IRQ 7 alone; raised on IRQ 0, its handler never runs and WFI never wakes.
    on_board("t.hocon", described("at = 0x50000000, irq = 0", "at = 0xD0000000, irq = 1").bytes)
    booted_on(&cpu, irq_moved, "one\n")
    run_board(&cpu)
    assert(cpu.stop == Stop.Asleep, s"${cpu.stop}")
    assert(output() == IRQ_GREETING.bytes, str_cast(output()))

    on_board("t.hocon", described("at = 0x50000000", "at = 0xD0000000, irq = 1").bytes)
    booted_on(&cpu, irq_moved, "one\n")
    run_board(&cpu)
    assert(cpu.stop == Stop.Asleep, s"${cpu.stop}")

    on_board("t.hocon", described("at = 0x50000000, irq = 7", "at = 0xD0000000, irq = 1").bytes)
    booted_on(&cpu, irq_moved, "one\n")
    run_board(&cpu)
    assert(cpu.stop == Stop.Exit && cpu.exit_code == 0, s"${cpu.stop}")

@test("the SIO answers at the base its part gives, register by register")
machine_sio_moved()
    var cpu: Cpu

    on_board("t.hocon", described("at = 0x40000000, irq = 0", "at = 0x60000000").bytes)
    booted_on(&cpu, [], "")

    assert(board_read(&cpu, 0x60000000, 4) == 0, "CPUID on core 0")
    assert(board_read(&cpu, 0x60000100, 4) == 1, "spinlock 0 claimed")
    assert(board_read(&cpu, 0x6000005C, 4) == 1, "SPINLOCK_ST")
    assert(cpu.stop == Stop.Budget)

    board_read(&cpu, 0xD0000000, 4)
    assert(cpu.stop == Stop.Unmapped && cpu.stop_at == 0xD0000000)

@test("run refuses a board cortical cannot run, saying why")
machine_refusals()
    val chip = "board { name = p, chip = rp2040 }\nparts { d1 { part = led, wire { anode = GP16 } } }\n"

    assert(refusal(chip) == "b.hocon: cortical does not emulate the rp2040: `cortical check` reads this board, and `cortical run` runs a board of two cortex-m0plus cores and the parts on their bus\n", refusal(chip))

    val one = "board { name = v, cores = [cortex-m0plus] }\nparts { ram { part = ram, at = 0, size = 1M } }\n"

    assert(refusal(one) == "b.hocon: cortical runs two cortex-m0plus cores, and this board names cortex-m0plus\n", refusal(one))

    val m33 = "board { name = v, cores = [cortex-m0plus, cortex-m33] }\nparts { ram { part = ram, at = 0, size = 1M } }\n"

    assert(refusal(m33) == "b.hocon: cortical runs two cortex-m0plus cores, and this board names cortex-m0plus, cortex-m33\n", refusal(m33))

    val two = "board { name = v, cores = [cortex-m0plus, cortex-m0plus] }\nparts {\n"
    val led = s"${two}  ram { part = ram, at = 0, size = 1M }\n  d1 { part = led, wire { anode = GP16 } }\n}\n"

    assert(refusal(led) == "b.hocon: `d1` is a led, which cortical does not emulate\n", refusal(led))

    val big = s"${two}  ram { part = ram, at = 0, size = 2M }\n}\n"

    assert(refusal(big) == "b.hocon: cortical's cores have 1M of RAM at 0x00000000, and `ram` is 2097152 bytes at 0x00000000\n", refusal(big))

    val high = s"${two}  ram { part = ram, at = 0x20000000, size = 1M }\n}\n"

    assert(refusal(high) == "b.hocon: cortical's cores have 1M of RAM at 0x00000000, and `ram` is 1048576 bytes at 0x20000000\n", refusal(high))

    val none = s"${two}  console { part = debug-console, at = 0x40000000 }\n}\n"

    assert(refusal(none) == "b.hocon: the board has no `ram` at 0x00000000, where the cores boot from\n", refusal(none))

    val consoles = s"${two}  ram { part = ram, at = 0, size = 1M }\n  a { part = debug-console, at = 0x40000000 }\n  b { part = debug-console, at = 0x40000010 }\n}\n"

    assert(refusal(consoles) == "b.hocon: cortical runs one `debug-console`, and this board has two\n", refusal(consoles))

@test("run reports a description's mistakes as check does, before anything runs")
machine_mistakes()
    val why = refusal("board { name = v, cores = [cortex-m0plus, cortex-m0plus] }\nparts { ram { part = ram, size = 1M } }\n")

    assert(why.contains("`ram` has no address"), why)
    assert(why.contains("b.hocon:2:9"), why)
