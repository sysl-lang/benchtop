module sh.sysl.cortical.virt
@tests

import sh.sysl.cortical.v6m.{Cpu, Model, Stop, MODELS, has_fixed_dsp, model_named, run_match, run_threaded}

val dsp_guest = embed("../../../../examples/virt/dsp.elf")
val dsp_qemu = embed("../../../../examples/virt/dsp.qemu")

// Core 1 says `dsp = false` where the model lets it, and leaves the option out where the model
// always has the extension.
private dsp_board(model: Model, second: bool) -> string
    val other = if has_fixed_dsp(model.kind) then "" else s", dsp = $second"
    s"board { name = dsp, cores = [{ core = ${model.name}, dsp = true }, { core = ${model.name}$other }], parts { ram { part = ram, at = 0, size = 1M }, console { part = debug-console, at = 0x40000000, irq = 0 }, sio { part = virt-sio, at = 0xD0000000, irq = 1 } } }"

@test("all DSP models match QEMU for 152 instruction variants over integer edges, accumulators, NZCVQ and every GE value")
dsp_differential()
    var cpu: Cpu
    for model in MODELS
        if !model.dsp then continue
        for exec in [&run_match, &run_threaded]
            on_board("dsp.hocon", dsp_board(model, false).bytes)
            booted_on(&cpu, dsp_guest, "")
            assert(cpu.dsp && core1().dsp == has_fixed_dsp(model.kind), "each core's board option applied independently")
            while cpu.stop == Stop.Budget && cpu.retired < 200000000
                cpu.limit = cpu.retired + 1000000
                exec(&cpu)
            assert(cpu.stop == Stop.Exit && cpu.exit_code == 0, s"${model.name}: ${cpu.stop} at ${cpu.stop_at}")
            val want = lines(dsp_qemu)
            val got = lines(output())
            assert(want.len() == 152 && got.len() == want.len(), "complete DSP oracle")
            for i in 0..<want.len() do assert(got.at(i) == want.at(i), s"${model.name}: ${got.at(i)}, QEMU: ${want.at(i)}")
    end for
end dsp_differential

@test("DSP settings survive core 1 launch on both schedulers; a plain board gives each model its own default")
dsp_board_lifecycle()
    var cpu: Cpu
    for parallel in [false, true]
        val both = dsp_board(model_named("cortex-m33").unwrap(), true)
        on_board("dsp.hocon", both.bytes)
        booted_on(&cpu, dual_m33, "")
        if parallel then set_threads()
        val stopped = run_board(&cpu)
        assert(stopped.stop == Stop.Exit && cpu.dsp && core1().dsp, "launch reapplies each setting")
    end for
    run_on(&cpu, "virt33", crunch_m33, false)
    assert(!cpu.dsp && !core1().dsp && cpu.ge == 0 && core1().ge == 0, "a plain M33 board leaves the optional DSP off")
    for board in ["virt4", "virt7"]
        run_on(&cpu, board, if board == "virt4" then crunch_m4 else crunch_m7, false)
        assert(cpu.dsp && core1().dsp, s"$board: the M4 and M7 always have the DSP extension")
end dsp_board_lifecycle
