module sh.sysl.cortical.virt
@tests

// The board as a guest sees it: a C program built for it, talking through the console, and small
// hand-assembled images reaching each register, each way off the RAM, and each way an image is
// refused. The console's state is the module's, so every test opens it afresh.

import sh.sysl.cortical.v6m.{Cpu, Stop, RAM_BYTES, reset, run_threaded}
import sysl.buf.{Buf, buf}
import sysl.threads.{Channel, spawn}

val echo = embed("../../../../examples/virt/echo.elf")
val irq = embed("../../../../examples/virt/irq.elf")

// echo.c's greeting, printed before it reads anything.
const GREETING = "hello from an M0+ on cortical's virtual board\ntype a line; Ctrl-D ends\n> "

// irq.c's.
const IRQ_GREETING = "echoing from an interrupt; Ctrl-D ends\n"

// Where the virtual board puts the console.
const CONSOLE: u32 = 0x40000000

// The board `name` describes put on the bus; a description cortical cannot run fails the test.
on_board(name: string, description: []const u8)
    board_from(name, description) match
        Ok(_) -> ()
        Err(why) -> assert(false, why)

// The virtual board put on the bus, found by name as `cortical run` finds it.
on_virt()
    board_named("virt") match
        Ok(_) -> ()
        Err(why) -> assert(false, why)

// `file` booted on a fresh virtual board with `keys` to type, its output captured.
booted(cpu: *Cpu, file: []const u8, keys: string)
    on_virt()
    booted_on(cpu, file, keys)

// `file` booted on the board on the bus now with `keys` to type, its output captured.
booted_on(cpu: *Cpu, file: []const u8, keys: string)
    open_console()
    capture()
    type_in(keys.bytes)

    image_of(file) match
        Ok(image) -> boot(cpu, image.view())
        Err(why) -> assert(false, why)

// Run until the core stops, or for ten million instructions at most, so a guest that never stops fails
// its test rather than hanging it.
run_capped(cpu: *Cpu)
    while cpu.stop == Stop.Budget && cpu.retired < 10000000
        cpu.limit = cpu.retired + 1000000
        run_threaded(cpu)

// A raw image: the stack at the top of RAM, a reset vector to the Thumb code at 8, then `literal` at
// 16, the word `ldr r0, [pc, #4]` at 8 reads: (8 + 4) aligned down to 4, plus 4.
raw(code: [4]u16, literal: u32) -> [20]u8
    val words: [5]u32 = [RAM_BYTES, 9, code[0] | u32(code[1]) << 16, code[2] | u32(code[3]) << 16, literal]
    var b: [20]u8

    for i in 0..<20 do b[i] = u8(words[i / 4] >> (i % 4 * 8) & 0xFF)
    b

// A raw image run to its stop, with nothing typed.
ran(cpu: *Cpu, code: [4]u16, literal: u32)
    val image = raw(code, literal)

    booted(cpu, image[..], "")
    run_capped(cpu)

@test("echo.elf greets, echoes each line typed after a prompt, and exits 0 when the input ends")
board_echo()
    var cpu: Cpu

    booted(&cpu, echo, "one\ntwo\n")
    run_board(&cpu)

    assert(output() == s"${GREETING}one\n> two\n> \nbye after 2 lines\n".bytes, str_cast(output()))
    assert(cpu.stop == Stop.Exit && cpu.stop_at == CONSOLE + EXIT)
    assert(cpu.exit_code == 0)

@test("echo.elf stops at Ctrl-D, with the lines after it never read")
board_echo_ctrl_d()
    var cpu: Cpu

    booted(&cpu, echo, "one\n\u{4}two\n")
    run_board(&cpu)

    assert(output() == s"${GREETING}one\n> \nbye after 1 lines\n".bytes, str_cast(output()))
    assert(cpu.stop == Stop.Exit && cpu.exit_code == 0)

@test("echo.elf with nothing typed says goodbye after no lines")
board_echo_nothing()
    var cpu: Cpu

    booted(&cpu, echo, "")
    run_board(&cpu)

    assert(output() == s"${GREETING}\nbye after 0 lines\n".bytes, str_cast(output()))
    assert(cpu.stop == Stop.Exit && cpu.exit_code == 0)

@test("irq.elf echoes from its interrupt handler while main sleeps in WFI, and exits 0 when the input ends")
board_irq()
    var cpu: Cpu

    booted(&cpu, irq, "one\ntwo\n")
    run_board(&cpu)

    assert(output() == s"${IRQ_GREETING}one\ntwo\n\nbye after 8 bytes\n".bytes, str_cast(output()))
    assert(cpu.stop == Stop.Exit && cpu.exit_code == 0)
    assert(cpu.ipsr == 0 && cpu.active == 0 && cpu.primask == 0, "back in thread mode, unmasked")

@test("irq.elf stops echoing at Ctrl-D, and with nothing typed echoes nothing")
board_irq_ctrl_d()
    var cpu: Cpu

    booted(&cpu, irq, "one\n\u{4}two\n")
    run_board(&cpu)
    assert(output() == s"${IRQ_GREETING}one\n\nbye after 4 bytes\n".bytes, str_cast(output()))
    assert(cpu.stop == Stop.Exit && cpu.exit_code == 0)

    booted(&cpu, irq, "")
    run_board(&cpu)
    assert(output() == s"${IRQ_GREETING}\nbye after 0 bytes\n".bytes, str_cast(output()))

// Types `late` into the console from another thread, and then ends its input.
private typist(ch: *Channel[u8])
    for b in "late\n".bytes do ch.send(b)
    ch.close()

@test("input that arrives while the guest sleeps wakes it through the console's interrupt")
board_irq_late_input()
    var cpu: Cpu

    on_virt()
    open_console()
    capture()

    image_of(irq) match
        Ok(image) -> boot(&cpu, image.view())
        Err(why) -> assert(false, why)

    assert(spawn(&typist, &typed).is_some())
    run_board(&cpu)

    assert(output() == s"${IRQ_GREETING}late\n\nbye after 5 bytes\n".bytes, str_cast(output()))
    assert(cpu.stop == Stop.Exit && cpu.exit_code == 0)

@test("CTRL keeps bit 0 and reads it back")
board_ctrl()
    var cpu: Cpu

    on_virt()
    reset(&cpu, [], 0)
    open_console()
    assert(board_read(&cpu, CONSOLE +CTRL, 4) == 0)
    board_write(&cpu, CONSOLE +CTRL, 4, 0xFFFFFFFF)
    assert(board_read(&cpu, CONSOLE +CTRL, 4) == 1)
    board_write(&cpu, CONSOLE +CTRL, 4, 2)
    assert(board_read(&cpu, CONSOLE +CTRL, 4) == 0 && cpu.stop == Stop.Budget)

// 8: wfi   10: b 10   12: nop   14: nop
@test("with CTRL off, a byte typed does not wake WFI, and the board stops at Asleep after it")
board_asleep()
    var cpu: Cpu

    booted(&cpu, raw([0xBF30, 0xE7FE, 0xBF00, 0xBF00], 0)[..], "x")
    run_board(&cpu)

    assert(cpu.stop == Stop.Asleep && cpu.stop_at == 10 && cpu.retired == 1, s"${cpu.stop} at ${cpu.stop_at}")

@test("STATUS is 0 while the input is open and empty, WAITING with a byte queued, and DATA takes it")
board_status_open()
    var cpu: Cpu

    on_virt()
    reset(&cpu, [], 0)
    open_console()
    capture()

    assert(board_read(&cpu, CONSOLE +STATUS, 4) == 0)
    assert(board_read(&cpu, CONSOLE +DATA, 4) == 0xFFFFFFFF)

    typed.send(u8('x'))
    assert(board_read(&cpu, CONSOLE +STATUS, 4) == WAITING)
    assert(board_read(&cpu, CONSOLE +STATUS, 4) == WAITING)
    assert(board_read(&cpu, CONSOLE +DATA, 4) == u32('x'))
    assert(board_read(&cpu, CONSOLE +STATUS, 4) == 0)
    assert(cpu.stop == Stop.Budget)

@test("once the input ends, STATUS is WAITING until the last byte is read, then ENDED, and DATA all ones")
board_status_ended()
    var cpu: Cpu

    on_virt()
    reset(&cpu, [], 0)
    open_console()
    capture()
    type_in("ab".bytes)

    assert(board_read(&cpu, CONSOLE +STATUS, 4) == WAITING)
    assert(board_read(&cpu, CONSOLE +DATA, 4) == u32('a'))
    assert(board_read(&cpu, CONSOLE +DATA, 4) == u32('b'))
    assert(board_read(&cpu, CONSOLE +STATUS, 4) == ENDED)
    assert(board_read(&cpu, CONSOLE +DATA, 4) == 0xFFFFFFFF)
    assert(board_read(&cpu, CONSOLE +STATUS, 4) == ENDED)
    assert(cpu.stop == Stop.Budget)

@test("DATA writes collect the low byte of each word")
board_data_write()
    var cpu: Cpu

    on_virt()
    reset(&cpu, [], 0)
    open_console()
    capture()
    board_write(&cpu, CONSOLE +DATA, 4, 0x1234_5641)
    board_write(&cpu, CONSOLE +DATA, 4, 0x0A)

    assert(output() == "A\n".bytes)
    assert(cpu.stop == Stop.Budget)

// 8: ldr r0, [pc, #4]   10: movs r1, #7   12: str r1, [r0]   14: b 14   16: 0x4000_0008
@test("a guest's write of 7 to EXIT stops the core at Exit with exit code 7")
board_exit_code()
    var cpu: Cpu

    ran(&cpu, [0x4801, 0x2107, 0x6001, 0xE7FE], CONSOLE + EXIT)

    assert(cpu.stop == Stop.Exit && cpu.stop_at == CONSOLE + EXIT)
    assert(cpu.exit_code == 7)
    // The core stops on the store, which the console has taken and which is not counted.
    assert(cpu.retired == 2 && cpu.pc == 12, s"${cpu.retired} pc ${cpu.pc}")

// 8: ldr r0, [pc, #4]   10: ldr r1, [r0]   12: b 12   14: nop   16: the address
@test("a read where nothing is stops the core at Unmapped, at that address, on the load")
board_unmapped_read()
    var cpu: Cpu

    for a in [0x50000000u32, 0x40000010, CONSOLE + EXIT, 0xD0000180, 0xCFFFFFFC, RAM_BYTES]
        ran(&cpu, [0x4801, 0x6801, 0xE7FE, 0xBF00], a)

        assert(cpu.stop == Stop.Unmapped && cpu.stop_at == a, f"0x${a}%08x")
        assert(cpu.pc == 10 && cpu.retired == 1 && cpu.r[1] == 0, f"pc 0x${cpu.pc}%x, ${cpu.retired} retired")

// 8: ldr r0, [pc, #4]   10: str r0, [r0]   12: b 12   14: nop   16: the address
@test("a write where nothing is stops the core at Unmapped, at that address, on the store")
board_unmapped_write()
    var cpu: Cpu

    for a in [0x50000000u32, 0x40000010, CONSOLE + STATUS, 0xD0000180, 0xCFFFFFFC, RAM_BYTES]
        ran(&cpu, [0x4801, 0x6000, 0xE7FE, 0xBF00], a)

        assert(cpu.stop == Stop.Unmapped && cpu.stop_at == a, f"0x${a}%08x")
        assert(cpu.pc == 10 && cpu.retired == 1, f"pc 0x${cpu.pc}%x, ${cpu.retired} retired")

// 8: ldr r0, [pc, #4]   10: bx r0   12: b 12   14: nop   16: the target
@test("a jump off the RAM stops the core at Unmapped, its pc the target")
board_jump_off_ram()
    var cpu: Cpu

    ran(&cpu, [0x4801, 0x4700, 0xE7FE, 0xBF00], 0x00200001)

    assert(cpu.stop == Stop.Unmapped && cpu.stop_at == 0x00200000, f"0x${cpu.stop_at}%08x")
    assert(cpu.pc == 0x00200000 && cpu.retired == 2, f"pc 0x${cpu.pc}%08x")

@test("cortical run's message for a stop names where the guest stopped")
board_stop_message()
    var cpu: Cpu

    // 8: ldr r0, [pc, #4]   10: ldr r1, [r0]: an access to nothing, on the load at 10
    ran(&cpu, [0x4801, 0x6801, 0xE7FE, 0xBF00], 0x50000000)

    val read = stop_message(&cpu)

    assert(read == "the guest stopped at an access to 0x50000000, where nothing is (pc 0x0000000a, 1 instructions)", read)

    // 8: ldr r0, [pc, #4]   10: bx r0: a jump to nothing
    ran(&cpu, [0x4801, 0x4700, 0xE7FE, 0xBF00], 0x00200001)

    val jump = stop_message(&cpu)

    assert(jump == "the guest stopped at an access to 0x00200000, where nothing is (pc 0x00200000, 2 instructions)", jump)

@test("an ELF file of a class or byte order cortical was built not to read is refused as unsupported")
board_elf_unsupported()
    // The identification bytes of an ELF-64 little-endian file and an ELF-32 big-endian one, each in
    // a header-sized file of zeros.
    for ident in [[0x7Fu8, u8('E'), u8('L'), u8('F'), 2, 1, 1], [0x7F, u8('E'), u8('L'), u8('F'), 1, 2, 1]]
        var file: [64]u8

        for i in 0..<64 do file[i] = if i < 7 then ident[i] else 0

        image_of(file[..]) match
            Ok(_) -> assert(false, "read")
            Err(why) -> assert(why == "an ELF file of a class or byte order this program was built not to read", why)

@test("a raw image fits the board's RAM exactly, and a byte more is refused")
board_raw_size()
    var file: Buf[u8] = buf()

    for i in 0..<RAM_BYTES do file.push(u8(i & 0xFF))

    image_of(file.view()) match
        Ok(image) -> assert(image.len() == RAM_BYTES && image.view()[RAM_BYTES - 1] == 0xFF)
        Err(why) -> assert(false, why)

    file.push(0)

    image_of(file.view()) match
        Ok(_) -> assert(false, "loaded")
        Err(why) -> assert(why == "larger than the board's 1 MB of RAM", why)
