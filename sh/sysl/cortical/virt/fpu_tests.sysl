module sh.sysl.cortical.virt
@tests

import sh.sysl.cortical.v6m.{Cpu, Stop, run_match, run_threaded}

val fpu_m4 = embed("../../../../examples/virt/fpu-m4.elf")
val fpu_m33 = embed("../../../../examples/virt/fpu-m33.elf")
val fpu_m7 = embed("../../../../examples/virt/fpu-m7.elf")
val fpu_m4_qemu = embed("../../../../examples/virt/fpu-m4.qemu")
val fpu_m33_qemu = embed("../../../../examples/virt/fpu-m33.qemu")
val fpu_m7_qemu = embed("../../../../examples/virt/fpu-m7.qemu")

// A board of two `model` cores, core 0 with the unit `unit`.
private fpu_board(model: string, unit: string) -> string =
    s"board { name = fpu, cores = [{ core = $model, fpu = $unit }, $model], parts { ram { part = ram, at = 0, size = 1M }, console { part = debug-console, at = 0x40000000, irq = 0 }, sio { part = virt-sio, at = 0xD0000000, irq = 1 } } }"

// The instructions whose negated operand the compiler's optimizer moves today, so a NaN result can
// come out with the other sign: checked on their own.
val NEGATING: [4]string = ["vmls", "vnmla", "vnmls", "vfms"]

// Whether a line is one of `NEGATING`'s, as `negating` asks.
private kept(line: string, negating: bool) -> bool
    var named = false

    for name in NEGATING do if line.starts_with(name + " ") then named = true
    named == negating

// `guest` on the board under each executor prints exactly QEMU's lines: those of `NEGATING`, or the
// rest, as `negating` asks.
private matches_qemu(model: string, unit: string, guest: []const u8, oracle: []const u8, count: usize)
    compare_qemu(model, unit, guest, oracle, count, false)

private compare_qemu(model: string, unit: string, guest: []const u8, oracle: []const u8, count: usize, negating: bool)
    val cpu = core0()

    for exec in [&run_match, &run_threaded]
        on_board("fpu.hocon", fpu_board(model, unit).bytes)
        booted_on(cpu, guest, "")
        assert(cpu.fpu == (if unit == "dp" then 2 else 1) && core1().fpu == 0, "the unit is core 0's alone")
        while cpu.stop == Stop.Budget && cpu.retired < 2000000000
            cpu.limit = cpu.retired + 1000000
            exec(cpu)
        assert(cpu.stop == Stop.Exit && cpu.exit_code == 0, s"$model: ${cpu.stop} at ${cpu.stop_at}")
        val want = lines(oracle)
        val got = lines(output())
        assert(want.len() == count && got.len() == want.len(), s"$model: ${got.len()} lines of ${want.len()}")

        var differ = ""

        for i in 0..<want.len()
            if kept(want.at(i), negating) && got.at(i) != want.at(i) then differ += s" [${got.at(i)}, QEMU ${want.at(i)}]"
        assert(differ == "", s"$model:$differ")
    end for

@test("the M4's FPv4-SP matches QEMU's on 32 instructions over 24 edge values under every FPSCR setting")
fpu_m4_differential() = matches_qemu("cortex-m4", "sp", fpu_m4, fpu_m4_qemu, 32)

@test("the M33's FPv5-SP matches QEMU's on 48 instructions, VSEL, VMAXNM, VRINT and VCVTA among them")
fpu_m33_differential() = matches_qemu("cortex-m33", "sp", fpu_m33, fpu_m33_qemu, 48)

@test("the M7's double-precision FPv5 matches QEMU's on 66 instructions, the conversions between precisions among them")
fpu_m7_differential() = matches_qemu("cortex-m7", "dp", fpu_m7, fpu_m7_qemu, 66)

@test(ignore: "sysl's optimizer moves a negation across a @strict_fp add or fma, so a NaN result can take the other sign")
fpu_negating_differential()
    compare_qemu("cortex-m4", "sp", fpu_m4, fpu_m4_qemu, 32, true)
    compare_qemu("cortex-m33", "sp", fpu_m33, fpu_m33_qemu, 48, true)
    compare_qemu("cortex-m7", "dp", fpu_m7, fpu_m7_qemu, 66, true)
