module sh.sysl.cortical.virt
@tests

// The board `virt33`: virt's devices with two Cortex-M33s, running the example programs built for
// the M33 (examples/virt/build.sh). crunch.c is checked against the same C built for and run on the
// host, so that output, not cortical, is the oracle; the others say what they should print.

import sh.sysl.cortical.v6m.{Cpu, Kind, Stop}

val echo_m33 = embed("../../../../examples/virt/echo-m33.elf")
val dual_m33 = embed("../../../../examples/virt/dual-m33.elf")
val crunch_m33 = embed("../../../../examples/virt/crunch-m33.elf")
val crunch_m0 = embed("../../../../examples/virt/crunch.elf")
val exclusive_m33 = embed("../../../../examples/virt/exclusive-m33.elf")
val count_m33 = embed("../../../../examples/virt/count-m33.elf")
val crunch_host = embed("../../../../examples/virt/crunch.out")

// The board `name`, bundled, put on the bus.
on_bundled(name: string)
    board_named(name) match
        Ok(_) -> ()
        Err(why) -> assert(false, why)

// `file` on the bundled board `name`, nothing typed and its output captured, each core on a thread
// of its own where `parallel` says so; run to its end, answering the core that stopped.
run_on(cpu: *Cpu, name: string, file: []const u8, parallel: bool) -> *Cpu
    on_bundled(name)
    open_console()
    capture()
    type_in([])

    image_of(file) match
        Ok(img) -> boot(cpu, img.view())
        Err(why) -> assert(false, why)

    if parallel then set_threads()
    run_board(cpu)

@test("virt33 boots both cores as M33s, and virt as M0+s")
m33_kinds()
    val cpu = core0()

    run_on(cpu, "virt33", echo_m33, false)
    assert(cpu.kind == Kind.V8mMain && core1().kind == Kind.V8mMain, "virt33")

    run_on(cpu, "virt", crunch_m0, false)
    assert(cpu.kind == Kind.V6m && core1().kind == Kind.V6m, "virt")

@test("echo.c built for the M33 greets as one on virt33, and echoes what is typed")
m33_echo()
    val cpu = core0()

    on_bundled("virt33")
    open_console()
    capture()
    type_in("one\ntwo\n".bytes)

    image_of(echo_m33) match
        Ok(img) -> boot(cpu, img.view())
        Err(why) -> assert(false, why)

    val stopped = run_board(cpu)
    val want = "hello from an M33 on cortical's virtual board\ntype a line; Ctrl-D ends\n> one\n> two\n> \nbye after 2 lines\n"

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, stop_message(stopped))
    assert(output() == want.bytes, str_cast(output()))

@test("crunch.c built for the M33 prints on virt33 what the same C prints built for the host")
m33_crunch()
    val cpu = core0()
    val stopped = run_on(cpu, "virt33", crunch_m33, false)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, stop_message(stopped))
    assert(output() == crunch_host, str_cast(output()))

@test("crunch.c built for the M0+ prints on virt what the same C prints built for the host")
m33_crunch_m0()
    val cpu = core0()
    val stopped = run_on(cpu, "virt", crunch_m0, false)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, stop_message(stopped))
    assert(output() == crunch_host, str_cast(output()))

@test("dual.c built for the M33 holds the same conversation on virt33 as the M0+ build does on virt")
m33_dual()
    val cpu = core0()
    val stopped = run_on(cpu, "virt33", dual_m33, false)

    assert(stopped == cpu && cpu.stop == Stop.Exit && cpu.exit_code == 0, stop_message(stopped))

    // Each core's lines in its own order, and the total last. How the two cores' lines interleave
    // follows their instruction counts, which the M33 build changes; so does where core 1's stack
    // sits, which the line naming it says.
    val want = lines(DUAL_OUTPUT.bytes)
    val got = lines(output())

    assert(got.len() == want.len() && got.at(got.len() - 1) == want.at(want.len() - 1), str_cast(output()))

    for k in 0..<2
        val mine = said_by(got.view(), k)
        val theirs = said_by(want.view(), k)

        assert(mine.len() == theirs.len(), str_cast(output()))

        for i in 0..<mine.len()
            if !theirs.at(i).starts_with("core 1: up") then assert(mine.at(i) == theirs.at(i), mine.at(i))

@test("the exclusives keep two cores' unlocked atomic additions exact, word, halfword and byte, taking turns")
m33_exclusive_turns()
    val cpu = core0()
    val stopped = run_on(cpu, "virt33", exclusive_m33, false)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, str_cast(output()))
    assert(output() == "word 40000, half 40000, byte 64\n".bytes, str_cast(output()))

@test("the exclusives keep two cores' unlocked atomic additions exact with a thread each")
m33_exclusive_threads()
    val cpu = core0()

    for round in 0..<5
        val stopped = run_on(cpu, "virt33", exclusive_m33, true)

        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, str_cast(output()))

@test("count.c's spinlock excludes on virt33's cores with a thread each")
m33_count_threads()
    val cpu = core0()
    val stopped = run_on(cpu, "virt33", count_m33, true)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, str_cast(output()))

@test("a board of one M33 and one M0+ is refused by name")
m33_mixed()
    val text = "board {\n  name = mixed\n  cores = [cortex-m33, cortex-m0plus]\n  parts { ram { part = ram, at = 0, size = 1M } }\n}\n"

    board_from("mixed.hocon", text.bytes) match
        Ok(_) -> assert(false, "ran")
        Err(why) -> assert(why.contains("two cores of the same model, and this board names cortex-m33, cortex-m0plus"), why)

val isa_m33 = embed("../../../../examples/virt/isa-m33.elf")
val isa_qemu = embed("../../../../examples/virt/isa.qemu")

@test("isa.c's 96 instructions, each on every pair of edge values from every flag state, hash on virt33 as on QEMU's M33")
m33_isa_qemu()
    val cpu = core0()
    val stopped = run_on(cpu, "virt33", isa_m33, false)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, stop_message(stopped))

    // Line by line, so a failure names the instruction.
    val want = lines(isa_qemu)
    val got = lines(output())

    assert(got.len() == want.len(), str_cast(output()))
    for i in 0..<want.len() do assert(got.at(i) == want.at(i), s"cortical: ${got.at(i)}, QEMU: ${want.at(i)}")
