module sh.sysl.cortical.virt
@tests

// The board with each core on a thread of its own. What these check is what holds however the two
// threads interleave: a lock that excludes, a FIFO that loses and reorders nothing, a launch, code one
// core writes reaching the other, the board ending from either core, and both cores asleep.

import sh.sysl.cortical.v6m.{Cpu, Stop, SYST_CSR, SYST_RVR, clock, store32}
import sysl.buf.{Buf, buf}

val count_elf = embed("../../../../examples/virt/count.elf")
val pingpong_elf = embed("../../../../examples/virt/pingpong.elf")
val order_elf = embed("../../../../examples/virt/order.elf")

// `file` booted with nothing to type and its output captured, each core on a thread of its own when
// `parallel` says so; run to its end, answering the core that stopped.
run_elf(cpu: *Cpu, file: []const u8, parallel: bool) -> *Cpu
    on_virt()
    open_console()
    capture()
    type_in([])

    image_of(file) match
        Ok(img) -> boot(cpu, img.view())
        Err(why) -> assert(false, why)

    if parallel then set_threads()
    run_board(cpu)

// The lines of `text`.
lines(text: []const u8) -> Buf[string]
    var out: Buf[string] = buf()
    var from = 0

    for i in 0..<text.len
        if text[i] == 10
            out.push(str_cast(text[from..<i]).copy())
            from = i + 1

    out

// The lines of `all` that core `k` wrote, in order.
said_by(all: []const string, k: int) -> Buf[string]
    var out: Buf[string] = buf()

    for l in all do if l.starts_with(s"core $k:") then out.push(l)

    out

@test("with a thread each, dual.elf launches core 1, trades squares in order, keeps each core's lines whole and in its order, and exits 0")
threads_dual()
    var cpu: Cpu
    val stopped = run_elf(&cpu, dual, true)

    assert(stopped == &cpu && cpu.stop == Stop.Exit && cpu.exit_code == 0, stop_message(stopped))

    // The squares come in an order the FIFO forces, and the total last; the two cores' lines between
    // them may interleave either way, but each core's come whole and in its own order.
    val want = lines(DUAL_OUTPUT.bytes)
    val got = lines(output())

    assert(got.len() == want.len(), str_cast(output()))

    assert(got.view()[0..<10] == want.view()[0..<10], str_cast(output()))
    assert(got.at(got.len() - 1) == want.at(want.len() - 1), str_cast(output()))

    for k in 0..<2 do assert(said_by(got.view(), k).view() == said_by(want.view(), k).view(), str_cast(output()))

@test("both cores counting under one spinlock reach exactly twice the count, on one thread and on two")
threads_spinlock()
    var cpu: Cpu

    for parallel in [false, true]
        val stopped = run_elf(&cpu, count_elf, parallel)

        assert(output() == "total 40000\n".bytes, str_cast(output()))
        assert(stopped == &cpu && cpu.stop == Stop.Exit && cpu.exit_code == 0)

@test("the spinlock excludes in fifty runs on two threads")
threads_spinlock_stress()
    var cpu: Cpu

    for run in 0..<50
        val stopped = run_elf(&cpu, count_elf, true)

        assert(output() == "total 40000\n".bytes, s"run $run: ${str_cast(output())}")
        assert(stopped.exit_code == 0)

@test("the FIFO run full both ways loses and reorders nothing, and wakes a core asleep on another thread")
threads_fifo()
    var cpu: Cpu

    for parallel in [false, true]
        val stopped = run_elf(&cpu, pingpong_elf, parallel)

        assert(output() == "replies 20000, wrong 0, errors 0\n".bytes, str_cast(output()))
        assert(stopped == &cpu && cpu.stop == Stop.Exit && cpu.exit_code == 0)

@test("a slot written before a DMB is never seen older than the index written after it")
threads_barriers()
    var cpu: Cpu

    for run in 0..<5
        val stopped = run_elf(&cpu, order_elf, true)

        assert(output()[0..<8] == "stale 0 ".bytes, str_cast(output()))
        assert(stopped == &cpu && cpu.exit_code == 0)

// Core 0 at 0x100 writes `movs r2, #2` over core 1's `movs r2, #1` at 0x200, and a DSB; then counts
// down a million and exits 99. Core 1 at 0x200 sets r2 to 1, executes an ISB, and loops until r2 is
// 2, which it exits with.
// core 0: ldr r0, =0x200; ldr r1, =0x2202; strh r1, [r0]; dsb; ldr r3, =1000000;
//         subs r3, #1; bne; ldr r0, =EXIT; movs r1, #99; str r1, [r0]; b .
// core 1: movs r2, #1; isb; cmp r2, #2; bne 0x200; ldr r0, =EXIT; str r2, [r0]; b .
val WRITES_CODE: [20]u16 = [0x4805, 0x4906, 0x8001, 0xF3BF, 0x8F4F, 0x4B05, 0x3B01, 0xD1FD, 0x4804, 0x2163, 0x6001, 0xE7FE, 0x0200, 0x0000, 0x2202, 0x0000, 0x4240, 0x000F, 0x0008, 0x4000]
val RUNS_CODE: [10]u16 = [0x2201, 0xF3BF, 0x8F6F, 0x2A02, 0xD1FA, 0x4801, 0x6002, 0xE7FE, 0x0008, 0x4000]

@test("code one core writes, with a DSB, is run afresh by the other core after its ISB")
threads_shared_code()
    var cpu: Cpu

    for run in 0..<10
        started(&cpu, image([(0x100, WRITES_CODE[..]), (0x200, RUNS_CODE[..])]).view())
        launch(0, 0x7000, 0x201)
        set_threads()

        val stopped = run_board(&cpu)

        assert(stopped == core1() && stopped.stop == Stop.Exit && stopped.exit_code == 2, stop_message(stopped))
        assert(cpu.stop == Stop.Budget)

// 0x100: b .
val SPINNER: [1]u16 = [0xE7FE]

@test("core 1's EXIT ends the board with core 0 running, and core 0's with core 1 running")
threads_exit_either()
    var cpu: Cpu

    started(&cpu, image([(0x100, SPINNER[..]), (0x200, COUNTER[..])]).view())
    launch(0, 0x7000, 0x201)
    set_threads()

    var stopped = run_board(&cpu)

    assert(stopped == core1() && stopped.stop == Stop.Exit && stopped.exit_code == 200)
    assert(cpu.stop == Stop.Budget && !cpu.sleeping)

    started(&cpu, image([(0x100, COUNTER[..]), (0x200, SPINNER[..])]).view())
    launch(0, 0x7000, 0x201)
    set_threads()
    stopped = run_board(&cpu)

    assert(stopped == &cpu && cpu.stop == Stop.Exit && cpu.exit_code == 200)
    assert(core1().stop == Stop.Budget)

// Core 0 at 0x100 sets the word at 0x2000 to 1 and sleeps for good. Core 1 at 0x200 waits for the
// word, counts down a hundred thousand — far past the lag bound, so core 0 is asleep by the end
// whatever the threads do — and exits 200.
// core 0: movs r0, #1; ldr r1, =0x2000; str r0, [r1]; wfi; b wfi
// core 1: ldr r1, =0x2000; ldr r0, [r1]; cmp r0, #1; bne ldr; ldr r0, =100000; subs r0, #1; bne subs;
//         ldr r1, =EXIT; movs r0, #200; str r0, [r1]; b .
val SETS_AND_SLEEPS: [8]u16 = [0x2001, 0x4902, 0x6008, 0xBF30, 0xE7FD, 0x0000, 0x2000, 0x0000]
val WAITS_AND_COUNTS: [18]u16 = [0x4905, 0x6808, 0x2801, 0xD1FC, 0x4804, 0x3801, 0xD1FD, 0x4904, 0x20C8, 0x6008, 0xE7FE, 0x0000, 0x2000, 0x0000, 0x86A0, 0x0001, 0x0008, 0x4000]

@test("on two threads, core 0 asleep for good does not stop the board while core 1 runs")
threads_one_asleep()
    var cpu: Cpu

    started(&cpu, image([(0x100, SETS_AND_SLEEPS[..]), (0x200, WAITS_AND_COUNTS[..])]).view())
    launch(0, 0x7000, 0x201)
    set_threads()

    val stopped = run_board(&cpu)

    assert(stopped == core1() && stopped.stop == Stop.Exit && stopped.exit_code == 200)
    assert(cpu.stop == Stop.Budget && cpu.sleeping)

@test("on two threads, both cores asleep with nothing to wake them stops the board at Asleep, on core 0")
threads_both_asleep()
    var cpu: Cpu

    for run in 0..<10
        started(&cpu, image([(0x100, SLEEPER[..]), (0x200, SLEEPER[..])]).view())
        launch(0, 0x7000, 0x201)
        set_threads()

        val stopped = run_board(&cpu)

        assert(stopped == &cpu && cpu.stop == Stop.Asleep && cpu.stop_at == 0x102)
        assert(core1().stop == Stop.Asleep && core1().stop_at == 0x202)

@test("on two threads, both asleep, the board skips to the first SysTick that wakes one")
threads_both_asleep_systick()
    var cpu: Cpu

    started(&cpu, image([(0x100, SLEEPER[..]), (0x200, SLEEPER[..])]).view())
    launch(0, 0x7000, 0x201)
    store32(core1(), SYST_RVR, 49999)
    store32(core1(), SYST_CSR, 7)
    set_threads()

    val stopped = run_board(&cpu)

    assert(stopped == core1() && stopped.stop == Stop.Fault && stopped.stop_at == 0x3C)
    assert(clock(stopped, stopped.retired) == 50000, s"${clock(stopped, stopped.retired)}")
