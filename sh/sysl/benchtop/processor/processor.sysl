module sh.sysl.benchtop.processor

// What a chip's devices need of a core, whatever its architecture: which of the chip's cores it is, its
// clock, and its interrupt inputs. The Cortex-M core (`v6m.Cpu`) and the RISC-V hart (`riscv.Cpu`)
// each implement it, so a chip layer written against it (`chip.Rp2350`) serves a board of either.

trait Processor
    /** Which of the chip's cores this is, from 0: what the SIO's CPUID answers it. */
    number(*self) -> u32
    /** The instructions it has retired: its own clock, which a device access is timed by. */
    instructions(*self) -> u64
    /** Drive external interrupt `irq`'s line. A core whose controller latches (an NVIC) takes a raised
     * line as pending; one that samples levels (Hazard3's) follows it both ways.
     */
    interrupt(*self, irq: u32, level: bool)
    /** The RISC-V machine software and timer interrupt inputs; nothing on a core without them. */
    machine_timer(*self, software: bool, timer: bool) = ()
