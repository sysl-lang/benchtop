module sh.sysl.benchtop

import sh.sysl.benchtop.v6m.MODELS
import sysl.buf.{Buf, buf}
import sh.sysl.benchtop.riscv.{MODELS as RISCV_MODELS}
import sh.sysl.benchtop.parts.ds3231 as rtc

// The library, as the checker sees it: what each core, peripheral and part declares about itself.
//
// **A description wires parts and places peripherals; the library declares what each may be.** A
// peripheral is on the cores' bus: it declares its window, the alignment its base needs, how many
// interrupts it raises, its parameters, and, for one that drives pins, its signals and the kind of bus
// it is. A part is off the bus: it names its ports -- a pin, an ADC pin, a bus of a kind, or a pin it
// offers to other parts -- its parameters with their types, and the controls a host key or the mouse
// can drive. The checker holds a chip and a board to these, so a mistake is reported against the
// library rather than discovered when the emulator runs.
//
// **The registry is data, and that is the interface.** The checker asks it `core(name)`,
// `peripheral(name)` and `part(name)` and nothing else, so a test builds a registry of its own (a part
// that exists for one test), and giving a part behaviour adds a constructor beside its spec without
// changing what the checker reads. Chips are not here: a chip is a description (`mcus/`), built from
// the library's cores and peripherals. Of the peripherals, `ram`, `debug-console`, `virt-sio`,
// `rp-resets`, `rp-timer` and `rp-watchdog` are emulated (`sh.sysl.benchtop.virt`); the rest, and
// every part, are declared, checked and drawn, and do nothing yet.

/** What kind of pin a pin port needs. */
enum PinNeed
    AnyPin
    // A component input may share an MCU output with other component inputs.
    InputPin
    AdcPin
    AnalogPin
end PinNeed

enum PortKind
    // A wire to one pin of the chip, or to a pin another part offers.
    PinPort(need: PinNeed)
    // A wire to one of the chip's buses, of this kind: `spi`, `i2c`, `uart`.
    BusPort(bus: string)
    // A pin this part drives that another part's pin port may be wired to (the CYW43439's GPIOs).
    Offer
end PortKind

struct PortSpec
    name: string
    kind: PortKind
    required: bool

enum ParamKind
    PWhole(min: long, max: long)
    PNumber
    PText
    PFlag
    PChoice(options: Buf[string])
end ParamKind

struct ParamSpec
    name: string
    kind: ParamKind
    required: bool

/** How a peripheral sits on the cores' bus: the window of addresses it answers, `size` bytes unless
 * the chip sets its own where `sized` allows (a `size` of 0 means the chip must); the alignment its
 * base `at` needs; and how many interrupts it raises, on the IRQs the chip gives it.
 */
struct Window
    size: long
    sized: bool
    align: long
    irqs: int

/** A peripheral of the library. `bus` is the kind of bus it is (`uart`, `spi`, `i2c`), empty for one
 * that is not, and `signals` the signals a chip routes to its pins; `adc` marks one whose `channels`
 * are ADC pins. `modelled` is false for one the checker accepts and the emulator does not run yet.
 */
struct PeripheralSpec
    name: string
    summary: string
    modelled: bool
    params: Buf[ParamSpec]
    window: Window
    bus: string
    signals: Buf[string]
    adc: bool

    param(self, name: string) -> Option[ParamSpec]
        for p in self.params
            if p.name == name then return Some(p)

        None
    end param
end PeripheralSpec

/** A part of the library. `modelled` is false for a part the emulator accepts and draws but does not
 * emulate yet; a part wired to one of its offered pins is reported as driven through it. `display`
 * marks a part whose `width` and `height` parameters are its glass, which is an element's natural size.
 * `defaults` are what an optional parameter is where a part leaves it out, and `rule` what the part
 * asks of its settings and wiring together, beyond each parameter's own type and range: the checker
 * reports each message it answers against the part.
 */
struct PartSpec
    name: string
    summary: string
    modelled: bool
    display: bool
    params: Buf[ParamSpec]
    ports: Buf[PortSpec]
    controls: Buf[string]
    defaults: Buf[(string, Setting)]
    rule: Option[&Fn(Part, PartSpec) -> Buf[string]]

    port(self, name: string) -> Option[PortSpec]
        for p in self.ports
            if p.name == name then return Some(p)

        None
    end port

    param(self, name: string) -> Option[ParamSpec]
        for p in self.params
            if p.name == name then return Some(p)

        None
    end param

    /** What `name` is where a part leaves it out, if the part says. */
    default(self, name: string) -> Option[Setting]
        for (key, value) in self.defaults do if key == name then return Some(value)
        None

    /** This part with `name` defaulting to `value`. */
    defaulting(self, name: string, value: Setting) -> PartSpec
        var out = self
        out.defaults.push((name, value))
        out

    /** This part asking `rule` of each part of its kind. */
    ruled(self, rule: &Fn(Part, PartSpec) -> Buf[string]) -> PartSpec
        var out = self
        out.rule = Some(rule)
        out
end PartSpec

/** A part's setting `name`: its own, its catalogue entry's, or else its spec's default. */
spec_setting(p: Part, spec: PartSpec, name: string) -> Option[Setting] = part_setting(p, name) match
    Some(s) -> Some(s)
    None -> spec.default(name)

/** `spec_setting` as a whole number, 0 where it is none. */
spec_whole(p: Part, spec: PartSpec, name: string) -> long = spec_setting(p, spec, name) match
    Some(Whole(n)) -> n
    _ -> 0

/** `spec_setting` as a flag, false where it is none. */
spec_flag(p: Part, spec: PartSpec, name: string) -> bool = spec_setting(p, spec, name) match
    Some(Flag(on)) -> on
    _ -> false

/** A core: what a chip is built around. `irqs` is its external interrupt input count, IRQ 0
 * up to `irqs - 1`; bare ISA profiles without an interrupt controller have zero.
 */
struct CoreSpec
    name: string
    summary: string
    irqs: int

struct Registry
    cores: Buf[CoreSpec]
    peripherals: Buf[PeripheralSpec]
    parts: Buf[PartSpec]

    core(self, name: string) -> Option[CoreSpec]
        for c in self.cores
            if c.name == name then return Some(c)

        None
    end core

    core_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for c in self.cores
            out.push(c.name)

        out
    end core_names

    peripheral(self, name: string) -> Option[PeripheralSpec]
        for p in self.peripherals
            if p.name == name then return Some(p)

        None
    end peripheral

    peripheral_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for p in self.peripherals
            out.push(p.name)

        out
    end peripheral_names

    part(self, name: string) -> Option[PartSpec]
        for p in self.parts
            if p.name == name then return Some(p)

        catalog_part(name) match
            Some(entry) ->
                for p in self.parts
                    if p.name == entry.model
                        var selected = p
                        selected.name = name
                        selected.summary = s"${entry.manufacturer} ${entry.number}: ${p.summary}"
                        return Some(selected)
            None -> ()
        None
    end part

    part_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for p in self.parts
            out.push(p.name)

        for entry in catalog_parts() do if self.part(entry.name).is_some() then out.push(entry.name)
        out
    end part_names
end Registry

// -- the library -----------------------------------------------------------------------------------

/** The cores, peripherals and parts the descriptions in `mcus/` and `boards/` use. */
library() -> Registry
    var cores: Buf[CoreSpec] = buf()
    var peripherals: Buf[PeripheralSpec] = buf()
    var parts: Buf[PartSpec] = buf()

    for model in MODELS do cores.push(CoreSpec(model.name, s"Arm ${model.name}", model.irqs))

    for model in RISCV_MODELS do cores.push(CoreSpec(model.name, s"RISC-V ${model.isa}", model.irqs))

    peripherals.push(peripheral("ram", "RAM, `size` bytes from `at`", window(0, 4096, sized = true)))
    peripherals.push(peripheral("flash", "on-mcu executable flash storage, initially erased to 0xff; ordinary CPU stores fault",
        window(0, 4096, sized = true)))
    peripherals.push(peripheral("flash-interface", "memory-mapped external flash interface (direct execution, no serial controller registers yet)",
        window(0, 4096, sized = true), bus = "flash"))
    parts.push(part("flash", "external flash storage attached to a memory-mapped flash interface",
        [port("interface", BusPort("flash"))], params = [param("capacity", PWhole(4096, 4194304), required = true)]))
    peripherals.push(peripheral("virt-i2s", "48kHz mono-left PCM audio adapter with bounded TX/RX FIFOs and 24-bit I2S frames",
        window(256, 256), bus = "i2s", signals = ["bclk", "ws", "tx", "rx"], params = [param("clock-hz", PWhole(48000, 1000000000))]))
    parts.push(part("i2s-amplifier", "I2S left-channel amplifier with a speaker output",
        [port("i2s", BusPort("i2s")), port("out", Offer, required = false)]))
    parts.push(part("i2s-microphone", "24-bit signed I2S MEMS microphone, left channel", [port("i2s", BusPort("i2s"))]))
    parts.push(part("pdm-microphone", "host-backed digital MEMS microphone; ideal PDM decimation at the attached codec",
        [port("out", Offer, required = false)]))
    parts.push(part("headphones", "stereo headphones driven by a codec output; gain is the host listening level",
        [port("input", PinPort(AnalogPin))], params = [param("gain", PWhole(0, 100))]))
    parts.push(part("speaker", "speaker driven by an amplifier; host playback gain is a debugging parameter, and below `resonance-hz` the cone rolls off at 12 dB an octave (0, the default, is an ideal speaker)",
        [port("input", PinPort(AnalogPin))], params = [param("gain", PWhole(0, 100)), param("resonance-hz", PWhole(0, 20000))]))
    peripherals.push(peripheral("rom", "a boot ROM, `size` bytes from `at`", window(0, 4096, sized = true), modelled = false))
    peripherals.push(peripheral("debug-console", "a console on the host's terminal: DATA, STATUS, EXIT and CTRL, a word each from `at`; it raises `irq` while input waits",
        window(16, 16, irqs = 1)))
    peripherals.push(peripheral("stm32-sdmmc", "STM32H7 SDMMC single/multiblock transfers with single/double-buffer internal DMA",
        window(0x400, 0x400, irqs = 1), bus = "sdmmc", signals = ["ck", "cmd", "d0", "d1", "d2", "d3"],
        params = [param("kernel-clock-hz", PWhole(1, 1000000000), required = true)]))
    peripherals.push(peripheral("stm32-spi", "STM32H7 eight-bit polling SPI master with timed full-duplex FIFO",
        window(0x400, 0x400), bus = "spi", signals = ["sck", "tx", "rx"],
        params = [param("kernel-clock-hz", PWhole(1, 1000000000), required = true)]))
    peripherals.push(peripheral("stm32-gpio", "STM32 GPIO bank: MODER, BSRR and alternate-function routing", window(0x400, 0x400),
        params = [param("bank", PText, required = true), param("reset-mode", PWhole(0, 4294967295))]))
    parts.push(part("sd-card", "SPI-mode SDHC block storage, optionally backed by a disk image",
        [port("spi", BusPort("spi"), required = false), port("sdmmc", BusPort("sdmmc"), required = false),
         port("cs", PinPort(InputPin), required = false), port("detect", PinPort(AnyPin), required = false)],
        params = [param("sectors", PWhole(1024, 131072), required = true), param("image", PText), param("write-protected", PFlag)]).ruled(sd_card_rule))
    peripherals.push(peripheral("stm32-i2c", "STM32 I2C v2 polling master, real byte/word data registers and transaction flags",
        window(0x400, 0x400), bus = "i2c", signals = ["sda", "scl"]))
    parts.push(part("wm8994", "WM8994 I2C-controlled AIF1 DAC2 speaker and DMIC1 ADC1 capture subset",
        [port("i2c", BusPort("i2c")), port("sai", BusPort("sai")), port("out", Offer, required = false),
         port("headphones", Offer, required = false), port("dmic1", PinPort(InputPin), required = false)],
        params = [param("address", PWhole(0, 127)), param("block", PWhole(0, 1))]))
    parts.push(part("ft6x06", "FT6206 capacitive touch controller, two-contact I2C polling subset", [port("i2c", BusPort("i2c"))],
        params = [param("address", PWhole(0, 127)), param("width", PWhole(1, 4096)), param("height", PWhole(1, 4096))],
        controls = ["point"]))
    peripherals.push(peripheral("stm32-sai", "STM32H7 SAI A/B audio blocks with timed FIFO slots and DMA requests",
        window(0x400, 0x400, irqs = 1), bus = "sai", signals = ["mclk", "sck", "fs", "sd-a", "sd-b"],
        params = [param("kernel-clock-hz", PWhole(1, 1000000000)), param("request-a", PWhole(1, 255)), param("request-b", PWhole(1, 255))]))
    peripherals.push(peripheral("stm32-dma", "STM32 DMA1/DMA2 interrupt-capable stream controller, direct-mode peripheral transfers",
        window(0x400, 0x400, irqs = 8), params = [param("controller", PWhole(1, 2))]))
    peripherals.push(peripheral("stm32-dmamux", "STM32 DMAMUX1 request selectors for DMA1 and DMA2", window(0x400, 0x400)))
    peripherals.push(peripheral("stm32-dsi", "STM32 DSI host command-mode packet engine, with timed DCS/generic writes and reads",
        window(0x800, 0x800), bus = "dsi", params = [param("reference-clock-hz", PWhole(1, 1000000000))]))
    parts.push(part("mipi-dcs-display", "MIPI DCS display connected to a DSI virtual channel (common DCS subset)",
        [port("dsi", BusPort("dsi"))],
        params = [param("width", PWhole(1, 800), required = true), param("height", PWhole(1, 800), required = true),
                  param("channel", PWhole(0, 3))]))
    peripherals.push(peripheral("stm32h7-rcc", "STM32H7 dual-core boot control subset: RCC_GCR and configured CM4 option-byte boot address",
        window(0x400, 0x400), params = [param("cm4-boot-address", PWhole(0, 4294967295))]))
    peripherals.push(peripheral("virt-sio", "two cores' shared block after the RP2040's SIO: CPUID, the inter-core FIFOs and 32 spinlocks; it raises `irq` in a core whose FIFO wants attention",
        window(0x180, 4096, irqs = 1)))
    peripherals.push(peripheral("rp-sio", "the RP2040's and RP2350's single-cycle IO block: CPUID, the inter-core FIFOs, spinlocks, the dividers and interpolators",
        window(0x1000, 4096, irqs = 2), modelled = false))
    peripherals.push(peripheral("rp-resets", "the RP2040's RESETS: holds each peripheral in reset until the guest releases it, and reports it done",
        window(0x4000, 0x4000)))
    peripherals.push(peripheral("rp-timer", "the RP2040's 64-bit microsecond timer, counting the watchdog's ticks, with four alarms raising `irq` (a list of four)",
        window(0x4000, 0x4000, irqs = 4)))
    peripherals.push(peripheral("rp-watchdog", "the RP2040's watchdog: its tick generator, dividing clk_ref (the cores' clock) into the timer's tick, its counter (CTRL, LOAD, REASON; its reset stops the cores) and its scratch registers",
        window(0x4000, 0x4000)))
    peripherals.push(peripheral("panel-gpio", "virtual 32-pin GPIO for LEDs/buttons: OUT, IN, OE, EDGES, IRQ_MASK, IRQ_STATUS",
        window(256, 256, irqs = 1)))
    peripherals.push(peripheral("virt-adc", "virtual 12-bit ADC: sampled conversions, ready/error flags and interrupt",
        window(256, 256, irqs = 1), adc = true,
        params = [param("reference-uv", PWhole(1, 5000000)), param("conversion-cycles", PWhole(1, 1000000))]))
    peripherals.push(peripheral("virt-pwm", "virtual PWM channel: enable, period, high time, counter and output pad",
        window(256, 256), signals = ["out"], params = [param("clock-hz", PWhole(48000, 1000000000))]))
    peripherals.push(peripheral("virt-i2c", "virtual I2C byte controller: address, data, command, status",
        window(256, 256), bus = "i2c", signals = ["sda", "scl"], params = [param("clock-hz", PWhole(1, 1000000000))]))
    peripherals.push(peripheral("pl011", "the Arm PL011 UART", window(0x1000, 4096, irqs = 1), bus = "uart",
        signals = ["tx", "rx", "cts", "rts"], modelled = false))
    peripherals.push(peripheral("pl022", "Arm PL022 SPI master: clocked 4..16-bit Motorola transfers, TX/RX FIFOs, loopback and IRQ flags",
        window(0x1000, 4096, irqs = 1), bus = "spi", signals = ["rx", "cs", "sck", "tx"]))
    peripherals.push(peripheral("dw-i2c", "the Synopsys DesignWare I2C controller", window(0x1000, 4096, irqs = 1), bus = "i2c",
        signals = ["sda", "scl"], modelled = false))
    peripherals.push(peripheral("rp-adc", "the RP2040's and RP2350's 12-bit ADC, its channels on the pins it lists",
        window(0x1000, 4096, irqs = 1), adc = true))

    val colors = ["red", "green", "blue", "yellow", "orange", "white"]

    parts.push(part("led", "a single-colour LED, lit while its pin is at its active level", [port("anode", PinPort(AnyPin))],
        params = [param("color", choice(colors)), param("active", choice(["high", "low"]))]))

    parts.push(part("led-matrix-5x5", "5x5 GPIO-scanned LEDs: active-high rows and active-low columns",
        [port("row0", PinPort(InputPin)), port("row1", PinPort(InputPin)), port("row2", PinPort(InputPin)),
         port("row3", PinPort(InputPin)), port("row4", PinPort(InputPin)),
         port("col0", PinPort(InputPin)), port("col1", PinPort(InputPin)), port("col2", PinPort(InputPin)),
         port("col3", PinPort(InputPin)), port("col4", PinPort(InputPin))],
        params = [param("color", choice(colors)), param("persistence-cycles", PWhole(1, 10000000))]))

    parts.push(part("seven-segment", "GPIO-driven multiplexed LED digits with a..g/dp segments and common digit terminals",
        [port("a", PinPort(AnyPin)), port("b", PinPort(AnyPin)), port("c", PinPort(AnyPin)), port("d", PinPort(AnyPin)),
         port("e", PinPort(AnyPin)), port("f", PinPort(AnyPin)), port("g", PinPort(AnyPin)),
         port("dp", PinPort(AnyPin), required = false),
         port("digit0", PinPort(AnyPin), required = false), port("digit1", PinPort(AnyPin), required = false),
         port("digit2", PinPort(AnyPin), required = false), port("digit3", PinPort(AnyPin), required = false),
         port("digit4", PinPort(AnyPin), required = false), port("digit5", PinPort(AnyPin), required = false),
         port("digit6", PinPort(AnyPin), required = false), port("digit7", PinPort(AnyPin), required = false)],
        params = [param("digits", PWhole(1, 8)), param("common", choice(["cathode", "anode"])),
                  param("color", choice(colors)), param("persistence-cycles", PWhole(1, 10000000))])
        .defaulting("digits", Whole(1)).ruled(seven_segment_rule))

    parts.push(part("st7789", "ST7789 color TFT with 240x320 controller memory and four-wire GPIO SPI",
        [port("sck", PinPort(InputPin)), port("mosi", PinPort(InputPin)), port("cs", PinPort(InputPin)),
         port("dc", PinPort(InputPin)), port("reset", PinPort(InputPin))],
        params = [param("width", PWhole(1, 240)), param("height", PWhole(1, 320)),
                  param("column-offset", PWhole(0, 239)), param("row-offset", PWhole(0, 319))])
        .defaulting("width", Whole(240)).defaulting("height", Whole(240))
        .defaulting("column-offset", Whole(0)).defaulting("row-offset", Whole(0)).ruled(st7789_rule))

    parts.push(part("ssd1306", "128x64 monochrome OLED driven by four-wire mode-0 GPIO SPI",
        [port("sck", PinPort(InputPin)), port("mosi", PinPort(InputPin)), port("cs", PinPort(InputPin)),
         port("dc", PinPort(InputPin)), port("reset", PinPort(InputPin))]))

    parts.push(part("hd44780", "GPIO-driven HD44780 character LCD with a four-bit write interface",
        [port("rs", PinPort(AnyPin)), port("rw", PinPort(AnyPin), required = false), port("e", PinPort(AnyPin)),
         port("d4", PinPort(AnyPin)), port("d5", PinPort(AnyPin)), port("d6", PinPort(AnyPin)), port("d7", PinPort(AnyPin))],
        params = [param("write-only", PFlag), param("columns", PWhole(1, 40)), param("rows", PWhole(1, 2)),
                  param("instruction-cycles", PWhole(1, 10000000)), param("clear-cycles", PWhole(1, 10000000))])
        .defaulting("write-only", Flag(false)).ruled(hd44780_rule))

    parts.push(part("potentiometer", "an ideal potentiometer supplying its wiper voltage from a host-controlled position",
        [port("wiper", PinPort(AnalogPin))],
        params = [param("low-uv", PWhole(0, 5000000)), param("high-uv", PWhole(0, 5000000)),
                  param("position", PWhole(0, 100)), param("taper", choice(["linear"]))])
        .defaulting("low-uv", Whole(0)).defaulting("high-uv", Whole(3300000)).ruled(analog_range_rule))

    parts.push(part("button", "a push button between its pin and ground (or 3V3 when `active = high`)", [port("pin", PinPort(AnyPin))],
        params = [param("active", choice(["low", "high"]))], controls = ["press"]))
    parts.push(part("reset-button", "the chip's reset push button: pressing it resets the chip, which stays in reset until it is let go",
        [], controls = ["press"]))

    parts.push(part("switch", "an ideal maintained SPST switch between its GPIO pin and ground (or supply when active = high)",
        [port("pin", PinPort(AnyPin))], params = [param("active", choice(["low", "high"])), param("closed", PFlag)]))

    parts.push(part("joystick", "a spring-centred two-axis analogue stick, each axis a voltage on an ADC pin",
        [port("x", PinPort(AdcPin)), port("y", PinPort(AdcPin))],
        params = [param("low-uv", PWhole(0, 5000000)), param("high-uv", PWhole(0, 5000000))],
        controls = ["up", "down", "left", "right"])
        .defaulting("low-uv", Whole(0)).defaulting("high-uv", Whole(3300000)).ruled(analog_range_rule))

    parts.push(part("ds3231", "DS3231 I2C real-time clock with calendar, alarms and temperature registers", [port("i2c", BusPort("i2c"))],
        params = [param("initial-time", choice(["host", "fixed"])), param("initial-year", PWhole(2000, 2199)),
                  param("initial-month", PWhole(1, 12)), param("initial-day", PWhole(1, 31)),
                  param("temperature-quarter-c", PWhole(-160, 340))])
        .defaulting("initial-year", Whole(2026)).defaulting("initial-month", Whole(1)).defaulting("initial-day", Whole(1))
        .ruled(ds3231_rule))
    parts.push(part("buzzer", "a buzzer: `active` sounds a fixed tone while its pin is high, `passive` sounds the pin's waveform",
        [port("pin", PinPort(AnyPin))],
        params = [param("kind", choice(["active", "passive"]), required = true), param("tone", PWhole(20, 20000)),
                  param("gain", PWhole(0, 100))]))

    parts.push(part("ws2812", "an addressable RGB LED, decoded from its data pin's waveform", [port("din", PinPort(AnyPin))],
        params = [param("count", PWhole(1, 1024))]))

    parts.push(part("st7796", "the Sitronix ST7796 TFT controller and its glass, over SPI",
        [port("spi", BusPort("spi")), port("cs", PinPort(AnyPin)), port("dc", PinPort(AnyPin)),
         port("reset", PinPort(AnyPin), required = false), port("backlight", PinPort(AnyPin), required = false)],
        params = [param("width", PWhole(1, 4096), required = true), param("height", PWhole(1, 4096), required = true),
                  param("invert", PFlag), param("variant", choice(["st7796", "ili9488"]))],
        display = true))

    parts.push(part("gt911", "the Goodix GT911 capacitive touch controller, over I2C",
        [port("i2c", BusPort("i2c")), port("int", PinPort(AnyPin), required = false), port("reset", PinPort(AnyPin), required = false)],
        params = [param("address", PWhole(0, 127)), param("width", PWhole(1, 4096)), param("height", PWhole(1, 4096))],
        controls = ["point"]).defaulting("address", Whole(0x5d)).ruled(gt911_rule))

    parts.push(part("terminal", "the host's terminal on a UART: what the board writes is printed, what is typed is sent",
        [port("uart", BusPort("uart"))], params = [param("baud", PWhole(300, 4000000))]))

    parts.push(part("cyw43439", "the Infineon CYW43439 Wi-Fi and Bluetooth mcu, over gSPI; its GPIOs drive other parts",
        [port("wl-on", PinPort(AnyPin)), port("data", PinPort(AnyPin)), port("cs", PinPort(AnyPin)), port("clock", PinPort(AnyPin)),
         port("gpio0", Offer, required = false), port("gpio1", Offer, required = false), port("gpio2", Offer, required = false)],
        modelled = false))

    Registry(cores, peripherals, parts)
end library

/** A peripheral of the library: everything not named is the common case — modelled, on no bus, with
 * no signals and no parameters, and not an ADC.
 */
private peripheral(name: string, summary: string, window: Window, bus: string = "", signals: []const string = [],
        params: []const ParamSpec = [], adc: bool = false, modelled: bool = true) -> PeripheralSpec =
    PeripheralSpec(name, summary, modelled, specs(params), window, bus, names(signals), adc)

/** A part of the library: modelled, not a display, with no parameters, no controls, no defaults and
 * no rule unless named; `defaulting` and `ruled` add the last two.
 */
private part(name: string, summary: string, ports: []const PortSpec, params: []const ParamSpec = [],
        controls: []const string = [], display: bool = false, modelled: bool = true) -> PartSpec =
    PartSpec(name, summary, modelled, display, specs(params), listed(ports), names(controls), buf(), None)

/** A bus window of `size` bytes whose base is aligned to `align`; `sized` lets the chip set the size. */
private window(size: long, align: long, irqs: int = 0, sized: bool = false) -> Window = Window(size, sized, align, irqs)

/** A parameter, optional unless `required` says otherwise. */
private[benchtop] param(name: string, kind: ParamKind, required: bool = false) -> ParamSpec = ParamSpec(name, kind, required)

/** A port, which a part needs wired unless `required` says otherwise. */
private port(name: string, kind: PortKind, required: bool = true) -> PortSpec = PortSpec(name, kind, required)

// -- what a part asks of its settings and wiring together ----------------------------------------------

// A card is on one bus: an SPI one with its chip select, or an SDMMC one without.
private sd_card_rule(p: Part, spec: PartSpec) -> Buf[string]
    var out: Buf[string] = buf()
    if wired(p, "spi") == wired(p, "sdmmc") then out.push("SD card needs exactly one SPI or SDMMC connection")
    if wired(p, "spi") && !wired(p, "cs") then out.push("SPI SD card needs cs connected")
    if wired(p, "sdmmc") && wired(p, "cs") then out.push("native SD cards do not use SPI chip select")
    out

// Every digit it has has its common terminal wired, and no other.
private seven_segment_rule(p: Part, spec: PartSpec) -> Buf[string]
    var out: Buf[string] = buf()
    val count = spec_whole(p, spec, "digits")
    for i in 0..<8
        val terminal = s"digit$i"
        if i < count && !wired(p, terminal) then out.push(s"`${p.name}.$terminal` is not connected")
        if i >= count && wired(p, terminal) then out.push(s"`${p.name}.$terminal` exceeds its configured digit count")
    out

// The ST7789's frame memory is 240 columns by 320 rows; the glass and its offset sit inside it.
private st7789_rule(p: Part, spec: PartSpec) -> Buf[string]
    var out: Buf[string] = buf()
    if spec_whole(p, spec, "width") + spec_whole(p, spec, "column-offset") > 240 || spec_whole(p, spec, "height") + spec_whole(p, spec, "row-offset") > 320
        out.push("ST7789 glass and offsets must fit its 240x320 controller memory")
    out

// An analogue source's range runs upwards.
private analog_range_rule(p: Part, spec: PartSpec) -> Buf[string]
    var out: Buf[string] = buf()
    if spec_whole(p, spec, "low-uv") > spec_whole(p, spec, "high-uv") then out.push("analogue source low-uv must not exceed high-uv")
    out

// The GT911 answers at one of the two addresses its INT strap selects.
private gt911_rule(p: Part, spec: PartSpec) -> Buf[string]
    var out: Buf[string] = buf()
    val address = spec_whole(p, spec, "address")
    if address != 0x14 && address != 0x5d then out.push("GT911 address must be 0x14 or 0x5d")
    out

// The starting date is a day its month has.
private ds3231_rule(p: Part, spec: PartSpec) -> Buf[string]
    var out: Buf[string] = buf()
    val month = int(spec_whole(p, spec, "initial-month"))
    if month >= 1 && month <= 12 && spec_whole(p, spec, "initial-day") > long(rtc.days(int(spec_whole(p, spec, "initial-year")), month))
        out.push("RTC initial day is invalid for its month")
    out

// RW is wired, or tied low and said so.
private hd44780_rule(p: Part, spec: PartSpec) -> Buf[string]
    var out: Buf[string] = buf()
    val write_only = spec_flag(p, spec, "write-only")
    if !wired(p, "rw") && !write_only then out.push("LCD needs rw connected or write-only = true (RW tied low)")
    if wired(p, "rw") && write_only then out.push("LCD write-only ties RW low; omit its rw connection")
    out

private choice(options: []const string) -> ParamKind = PChoice(names(options))

// The tables above are written as array literals; each of these names the element type the literal
// is read at, so an empty `[]` still has one.
private names(xs: []const string) -> Buf[string] = listed(xs)
private specs(xs: []const ParamSpec) -> Buf[ParamSpec] = listed(xs)

private listed[T](xs: []const T) -> Buf[T]
    var out: Buf[T] = buf()

    out.extend(xs)
    out
end listed
