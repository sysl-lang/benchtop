module sh.sysl.benchtop

import sh.sysl.benchtop.v6m.MODELS
import sysl.buf.{Buf, buf}
import sh.sysl.benchtop.riscv.{MODELS as RISCV_MODELS}

// The library, as the checker sees it: what each core, peripheral and part declares about itself.
//
// **A description wires parts and places peripherals; the library declares what each may be.** A
// peripheral is on the cores' bus: it declares its window, the alignment its base needs, how many
// interrupts it raises, its parameters, and, for one that drives pins, its signals and the kind of bus
// it is. A part is off the bus: it names its ports -- a pin, an ADC pin, a bus of a kind, or a pin it
// offers to other parts -- its parameters with their types, and the controls a host key or the mouse
// can drive. The checker holds a chip and a board to these, so a mistake is reported against the
// library rather than discovered when the emulator runs.
//
// **The registry is data, and that is the interface.** The checker asks it `core(name)`,
// `peripheral(name)` and `part(name)` and nothing else, so a test builds a registry of its own (a part
// that exists for one test), and giving a part behaviour adds a constructor beside its spec without
// changing what the checker reads. Chips are not here: a chip is a description (`mcus/`), built from
// the library's cores and peripherals. Of the peripherals, `ram`, `debug-console`, `virt-sio`,
// `rp-resets`, `rp-timer` and `rp-watchdog` are emulated (`sh.sysl.benchtop.virt`); the rest, and
// every part, are declared, checked and drawn, and do nothing yet.

/** What kind of pin a pin port needs. */
enum PinNeed
    AnyPin
    // A component input may share an MCU output with other component inputs.
    InputPin
    AdcPin
    AnalogPin
end PinNeed

enum PortKind
    // A wire to one pin of the chip, or to a pin another part offers.
    PinPort(need: PinNeed)
    // A wire to one of the chip's buses, of this kind: `spi`, `i2c`, `uart`.
    BusPort(bus: string)
    // A pin this part drives that another part's pin port may be wired to (the CYW43439's GPIOs).
    Offer
end PortKind

struct PortSpec
    name: string
    kind: PortKind
    required: bool

enum ParamKind
    PWhole(min: long, max: long)
    PNumber
    PText
    PFlag
    PChoice(options: Buf[string])
end ParamKind

struct ParamSpec
    name: string
    kind: ParamKind
    required: bool

/** How a peripheral sits on the cores' bus: the window of addresses it answers, `size` bytes unless
 * the chip sets its own where `sized` allows (a `size` of 0 means the chip must); the alignment its
 * base `at` needs; and how many interrupts it raises, on the IRQs the chip gives it.
 */
struct Window
    size: long
    sized: bool
    align: long
    irqs: int

/** A peripheral of the library. `bus` is the kind of bus it is (`uart`, `spi`, `i2c`), empty for one
 * that is not, and `signals` the signals a chip routes to its pins; `adc` marks one whose `channels`
 * are ADC pins. `modelled` is false for one the checker accepts and the emulator does not run yet.
 */
struct PeripheralSpec
    name: string
    summary: string
    modelled: bool
    params: Buf[ParamSpec]
    window: Window
    bus: string
    signals: Buf[string]
    adc: bool

    param(self, name: string) -> Option[ParamSpec]
        for p in self.params
            if p.name == name then return Some(p)

        None
    end param
end PeripheralSpec

/** A part of the library. `modelled` is false for a part the emulator accepts and draws but does not
 * emulate yet; a part wired to one of its offered pins is reported as driven through it. `display`
 * marks a part whose `width` and `height` parameters are its glass, which is an element's natural size.
 */
struct PartSpec
    name: string
    summary: string
    modelled: bool
    display: bool
    params: Buf[ParamSpec]
    ports: Buf[PortSpec]
    controls: Buf[string]

    port(self, name: string) -> Option[PortSpec]
        for p in self.ports
            if p.name == name then return Some(p)

        None
    end port

    param(self, name: string) -> Option[ParamSpec]
        for p in self.params
            if p.name == name then return Some(p)

        None
    end param
end PartSpec

/** A core: what a chip is built around. `irqs` is its external interrupt input count, IRQ 0
 * up to `irqs - 1`; bare ISA profiles without an interrupt controller have zero.
 */
struct CoreSpec
    name: string
    summary: string
    irqs: int

struct Registry
    cores: Buf[CoreSpec]
    peripherals: Buf[PeripheralSpec]
    parts: Buf[PartSpec]

    core(self, name: string) -> Option[CoreSpec]
        for c in self.cores
            if c.name == name then return Some(c)

        None
    end core

    core_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for c in self.cores
            out.push(c.name)

        out
    end core_names

    peripheral(self, name: string) -> Option[PeripheralSpec]
        for p in self.peripherals
            if p.name == name then return Some(p)

        None
    end peripheral

    peripheral_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for p in self.peripherals
            out.push(p.name)

        out
    end peripheral_names

    part(self, name: string) -> Option[PartSpec]
        for p in self.parts
            if p.name == name then return Some(p)

        catalog_part(name) match
            Some(entry) ->
                for p in self.parts
                    if p.name == entry.model
                        var selected = p
                        selected.name = name
                        selected.summary = s"${entry.manufacturer} ${entry.number}: ${p.summary}"
                        return Some(selected)
            None -> ()
        None
    end part

    part_names(self) -> Buf[string]
        var out: Buf[string] = buf()

        for p in self.parts
            out.push(p.name)

        for entry in catalog_parts() do if self.part(entry.name).is_some() then out.push(entry.name)
        out
    end part_names
end Registry

// -- the library -----------------------------------------------------------------------------------

/** The cores, peripherals and parts the descriptions in `mcus/` and `boards/` use. */
library() -> Registry
    var cores: Buf[CoreSpec] = buf()
    var peripherals: Buf[PeripheralSpec] = buf()
    var parts: Buf[PartSpec] = buf()

    for model in MODELS do cores.push(CoreSpec(model.name, s"Arm ${model.name}", model.irqs))

    for model in RISCV_MODELS do cores.push(CoreSpec(model.name, s"RISC-V ${model.isa}", model.irqs))

    peripherals.push(PeripheralSpec("ram", "RAM, `size` bytes from `at`", true, specs([]),
        Window(0, true, 4096, 0), "", names([]), false))
    peripherals.push(PeripheralSpec("flash", "on-mcu executable flash storage, initially erased to 0xff; ordinary CPU stores fault", true, specs([]),
        Window(0, true, 4096, 0), "", names([]), false))
    peripherals.push(PeripheralSpec("flash-interface", "memory-mapped external flash interface (direct execution, no serial controller registers yet)", true, specs([]),
        Window(0, true, 4096, 0), "flash", names([]), false))
    parts.push(PartSpec("flash", "external flash storage attached to a memory-mapped flash interface", true, false,
        specs([ParamSpec("capacity", PWhole(4096, 4194304), true)]),
        ports([PortSpec("interface", BusPort("flash"), true)]), names([])))
    peripherals.push(PeripheralSpec("virt-i2s", "48kHz mono-left PCM audio adapter with bounded TX/RX FIFOs and 24-bit I2S frames", true,
        specs([ParamSpec("clock-hz", PWhole(48000, 1000000000), false)]), Window(256, false, 256, 0), "i2s", names(["bclk", "ws", "tx", "rx"]), false))
    parts.push(PartSpec("i2s-amplifier", "I2S left-channel amplifier with a speaker output", true, false, specs([]),
        ports([PortSpec("i2s", BusPort("i2s"), true), PortSpec("out", Offer, false)]), names([])))
    parts.push(PartSpec("i2s-microphone", "24-bit signed I2S MEMS microphone, left channel", true, false, specs([]),
        ports([PortSpec("i2s", BusPort("i2s"), true)]), names([])))
    parts.push(PartSpec("pdm-microphone", "host-backed digital MEMS microphone; ideal PDM decimation at the attached codec", true,false,specs([]),
        ports([PortSpec("out",Offer,false)]),names([])))
    parts.push(PartSpec("headphones", "stereo headphones driven by a codec output; gain is the host listening level", true,false,
        specs([ParamSpec("gain",PWhole(0,100),false)]),ports([PortSpec("input",PinPort(AnalogPin),true)]),names([])))
    parts.push(PartSpec("speaker", "speaker driven by an amplifier; host playback gain is a debugging parameter", true, false,
        specs([ParamSpec("gain", PWhole(0, 100), false)]), ports([PortSpec("input", PinPort(AnalogPin), true)]), names([])))
    peripherals.push(PeripheralSpec("rom", "a boot ROM, `size` bytes from `at`", false, specs([]),
        Window(0, true, 4096, 0), "", names([]), false))
    peripherals.push(PeripheralSpec("debug-console", "a console on the host's terminal: DATA, STATUS, EXIT and CTRL, a word each from `at`; it raises `irq` while input waits", true, specs([]),
        Window(16, false, 16, 1), "", names([]), false))
    peripherals.push(PeripheralSpec("stm32-sdmmc", "STM32H7 SDMMC single/multiblock transfers with single/double-buffer internal DMA", true,
        specs([ParamSpec("kernel-clock-hz",PWhole(1,1000000000),true)]),Window(0x400,false,0x400,1),"sdmmc",names(["ck","cmd","d0","d1","d2","d3"]),false))
    peripherals.push(PeripheralSpec("stm32-spi", "STM32H7 eight-bit polling SPI master with timed full-duplex FIFO", true,
        specs([ParamSpec("kernel-clock-hz",PWhole(1,1000000000),true)]), Window(0x400,false,0x400,0), "spi", names(["sck","tx","rx"]),false))
    peripherals.push(PeripheralSpec("stm32-gpio", "STM32 GPIO bank: MODER, BSRR and alternate-function routing", true,
        specs([ParamSpec("bank",PText,true),ParamSpec("reset-mode",PWhole(0,4294967295),false)]), Window(0x400,false,0x400,0), "", names([]),false))
    parts.push(PartSpec("sd-card", "SPI-mode SDHC block storage, optionally backed by a disk image", true,false,
        specs([ParamSpec("sectors",PWhole(1024,131072),true),ParamSpec("image",PText,false),ParamSpec("write-protected",PFlag,false)]),
        ports([PortSpec("spi",BusPort("spi"),false),PortSpec("sdmmc",BusPort("sdmmc"),false),PortSpec("cs",PinPort(InputPin),false),PortSpec("detect",PinPort(AnyPin),false)]),names([])))
    peripherals.push(PeripheralSpec("stm32-i2c", "STM32 I2C v2 polling master, real byte/word data registers and transaction flags", true, specs([]),
        Window(0x400,false,0x400,0), "i2c", names(["sda","scl"]),false))
    parts.push(PartSpec("wm8994", "WM8994 I2C-controlled AIF1 DAC2 speaker and DMIC1 ADC1 capture subset", true,false,
        specs([ParamSpec("address",PWhole(0,127),false),ParamSpec("block",PWhole(0,1),false)]),
        ports([PortSpec("i2c",BusPort("i2c"),true),PortSpec("sai",BusPort("sai"),true),PortSpec("out",Offer,false),PortSpec("headphones",Offer,false),PortSpec("dmic1",PinPort(InputPin),false)]),names([])))
    parts.push(PartSpec("ft6x06", "FT6206 capacitive touch controller, two-contact I2C polling subset", true,false,
        specs([ParamSpec("address",PWhole(0,127),false),ParamSpec("width",PWhole(1,4096),false),ParamSpec("height",PWhole(1,4096),false)]),
        ports([PortSpec("i2c",BusPort("i2c"),true)]),names(["point"])))
    peripherals.push(PeripheralSpec("stm32-sai", "STM32H7 SAI A/B audio blocks with timed FIFO slots and DMA requests", true,
        specs([ParamSpec("kernel-clock-hz",PWhole(1,1000000000),false),ParamSpec("request-a",PWhole(1,255),false),ParamSpec("request-b",PWhole(1,255),false)]),
        Window(0x400,false,0x400,1), "sai", names(["mclk","sck","fs","sd-a","sd-b"]), false))
    peripherals.push(PeripheralSpec("stm32-dma", "STM32 DMA1/DMA2 interrupt-capable stream controller, direct-mode peripheral transfers", true,
        specs([ParamSpec("controller",PWhole(1,2),false)]), Window(0x400,false,0x400,8), "", names([]), false))
    peripherals.push(PeripheralSpec("stm32-dmamux", "STM32 DMAMUX1 request selectors for DMA1 and DMA2", true,
        specs([]), Window(0x400,false,0x400,0), "", names([]), false))
    peripherals.push(PeripheralSpec("stm32-dsi", "STM32 DSI host command-mode packet engine, with timed DCS/generic writes and reads", true,
        specs([ParamSpec("reference-clock-hz", PWhole(1,1000000000), false)]),
        Window(0x800, false, 0x800, 0), "dsi", names([]), false))
    parts.push(PartSpec("mipi-dcs-display", "MIPI DCS display connected to a DSI virtual channel (common DCS subset)", true, false,
        specs([ParamSpec("width", PWhole(1,800), true), ParamSpec("height", PWhole(1,800), true), ParamSpec("channel", PWhole(0,3), false)]),
        ports([PortSpec("dsi", BusPort("dsi"), true)]), names([])))
    peripherals.push(PeripheralSpec("stm32h7-rcc", "STM32H7 dual-core boot control subset: RCC_GCR and configured CM4 option-byte boot address", true,
        specs([ParamSpec("cm4-boot-address", PWhole(0, 4294967295), false)]),
        Window(0x400, false, 0x400, 0), "", names([]), false))
    peripherals.push(PeripheralSpec("virt-sio", "two cores' shared block after the RP2040's SIO: CPUID, the inter-core FIFOs and 32 spinlocks; it raises `irq` in a core whose FIFO wants attention", true, specs([]),
        Window(0x180, false, 4096, 1), "", names([]), false))
    peripherals.push(PeripheralSpec("rp-sio", "the RP2040's and RP2350's single-cycle IO block: CPUID, the inter-core FIFOs, spinlocks, the dividers and interpolators", false, specs([]),
        Window(0x1000, false, 4096, 2), "", names([]), false))
    peripherals.push(PeripheralSpec("rp-resets", "the RP2040's RESETS: holds each peripheral in reset until the guest releases it, and reports it done", true, specs([]),
        Window(0x4000, false, 0x4000, 0), "", names([]), false))
    peripherals.push(PeripheralSpec("rp-timer", "the RP2040's 64-bit microsecond timer, counting the watchdog's ticks, with four alarms raising `irq` (a list of four)", true, specs([]),
        Window(0x4000, false, 0x4000, 4), "", names([]), false))
    peripherals.push(PeripheralSpec("rp-watchdog", "the RP2040's watchdog: its tick generator, dividing clk_ref (the cores' clock) into the timer's tick, and its scratch registers", true, specs([]),
        Window(0x4000, false, 0x4000, 0), "", names([]), false))
    peripherals.push(PeripheralSpec("panel-gpio", "virtual 32-pin GPIO for LEDs/buttons: OUT, IN, OE, EDGES, IRQ_MASK, IRQ_STATUS", true, specs([]),
        Window(256, false, 256, 1), "", names([]), false))
    peripherals.push(PeripheralSpec("virt-adc", "virtual 12-bit ADC: sampled conversions, ready/error flags and interrupt", true,
        specs([ParamSpec("reference-uv", PWhole(1, 5000000), false),
               ParamSpec("conversion-cycles", PWhole(1, 1000000), false)]),
        Window(256, false, 256, 1), "", names([]), true))
    peripherals.push(PeripheralSpec("virt-pwm", "virtual PWM channel: enable, period, high time, counter and output pad", true,
        specs([ParamSpec("clock-hz", PWhole(48000,1000000000), false)]), Window(256, false, 256, 0), "", names(["out"]), false))
    peripherals.push(PeripheralSpec("virt-i2c", "virtual I2C byte controller: address, data, command, status", true,
        specs([ParamSpec("clock-hz", PWhole(1, 1000000000), false)]), Window(256, false, 256, 0), "i2c", names(["sda", "scl"]), false))
    peripherals.push(PeripheralSpec("pl011", "the Arm PL011 UART", false, specs([]),
        Window(0x1000, false, 4096, 1), "uart", names(["tx", "rx", "cts", "rts"]), false))
    peripherals.push(PeripheralSpec("pl022", "Arm PL022 SPI master: clocked 4..16-bit Motorola transfers, TX/RX FIFOs, loopback and IRQ flags", true, specs([]),
        Window(0x1000, false, 4096, 1), "spi", names(["rx", "cs", "sck", "tx"]), false))
    peripherals.push(PeripheralSpec("dw-i2c", "the Synopsys DesignWare I2C controller", false, specs([]),
        Window(0x1000, false, 4096, 1), "i2c", names(["sda", "scl"]), false))
    peripherals.push(PeripheralSpec("rp-adc", "the RP2040's and RP2350's 12-bit ADC, its channels on the pins it lists", false, specs([]),
        Window(0x1000, false, 4096, 1), "", names([]), true))

    parts.push(PartSpec("led", "a single-colour LED, lit while its pin is at its active level", true, false,
        specs([ParamSpec("color", choice(["red", "green", "blue", "yellow", "orange", "white"]), false),
               ParamSpec("active", choice(["high", "low"]), false)]),
        ports([PortSpec("anode", PinPort(AnyPin), true)]),
        names([])))

    parts.push(PartSpec("led-matrix-5x5", "5x5 GPIO-scanned LEDs: active-high rows and active-low columns", true, false,
        specs([ParamSpec("color", choice(["red", "green", "blue", "yellow", "orange", "white"]), false),
               ParamSpec("persistence-cycles", PWhole(1, 10000000), false)]),
        ports([PortSpec("row0", PinPort(InputPin), true),
               PortSpec("row1", PinPort(InputPin), true),
               PortSpec("row2", PinPort(InputPin), true),
               PortSpec("row3", PinPort(InputPin), true),
               PortSpec("row4", PinPort(InputPin), true),
               PortSpec("col0", PinPort(InputPin), true),
               PortSpec("col1", PinPort(InputPin), true),
               PortSpec("col2", PinPort(InputPin), true),
               PortSpec("col3", PinPort(InputPin), true),
               PortSpec("col4", PinPort(InputPin), true)]), names([])))

    parts.push(PartSpec("seven-segment", "GPIO-driven multiplexed LED digits with a..g/dp segments and common digit terminals", true, false,
        specs([ParamSpec("digits", PWhole(1, 8), false),
               ParamSpec("common", choice(["cathode", "anode"]), false),
               ParamSpec("color", choice(["red", "green", "blue", "yellow", "orange", "white"]), false),
               ParamSpec("persistence-cycles", PWhole(1, 10000000), false)]),
        ports([PortSpec("a", PinPort(AnyPin), true),
               PortSpec("b", PinPort(AnyPin), true),
               PortSpec("c", PinPort(AnyPin), true),
               PortSpec("d", PinPort(AnyPin), true),
               PortSpec("e", PinPort(AnyPin), true),
               PortSpec("f", PinPort(AnyPin), true),
               PortSpec("g", PinPort(AnyPin), true),
               PortSpec("dp", PinPort(AnyPin), false),
               PortSpec("digit0", PinPort(AnyPin), false),
               PortSpec("digit1", PinPort(AnyPin), false),
               PortSpec("digit2", PinPort(AnyPin), false),
               PortSpec("digit3", PinPort(AnyPin), false),
               PortSpec("digit4", PinPort(AnyPin), false),
               PortSpec("digit5", PinPort(AnyPin), false),
               PortSpec("digit6", PinPort(AnyPin), false),
               PortSpec("digit7", PinPort(AnyPin), false)]), names([])))

    parts.push(PartSpec("st7789", "ST7789 color TFT with 240x320 controller memory and four-wire GPIO SPI", true, false,
        specs([ParamSpec("width", PWhole(1, 240), false), ParamSpec("height", PWhole(1, 320), false),
               ParamSpec("column-offset", PWhole(0, 239), false), ParamSpec("row-offset", PWhole(0, 319), false)]),
        ports([PortSpec("sck", PinPort(InputPin), true), PortSpec("mosi", PinPort(InputPin), true),
               PortSpec("cs", PinPort(InputPin), true), PortSpec("dc", PinPort(InputPin), true),
               PortSpec("reset", PinPort(InputPin), true)]), names([])))

    parts.push(PartSpec("ssd1306", "128x64 monochrome OLED driven by four-wire mode-0 GPIO SPI", true, false,
        specs([]),
        ports([PortSpec("sck", PinPort(InputPin), true),
               PortSpec("mosi", PinPort(InputPin), true),
               PortSpec("cs", PinPort(InputPin), true),
               PortSpec("dc", PinPort(InputPin), true),
               PortSpec("reset", PinPort(InputPin), true)]), names([])))

    parts.push(PartSpec("hd44780", "GPIO-driven HD44780 character LCD with a four-bit write interface", true, false,
        specs([ParamSpec("write-only", PFlag, false), ParamSpec("columns", PWhole(1, 40), false),
               ParamSpec("rows", PWhole(1, 2), false),
               ParamSpec("instruction-cycles", PWhole(1, 10000000), false),
               ParamSpec("clear-cycles", PWhole(1, 10000000), false)]),
        ports([PortSpec("rs", PinPort(AnyPin), true),
               PortSpec("rw", PinPort(AnyPin), false),
               PortSpec("e", PinPort(AnyPin), true),
               PortSpec("d4", PinPort(AnyPin), true),
               PortSpec("d5", PinPort(AnyPin), true),
               PortSpec("d6", PinPort(AnyPin), true),
               PortSpec("d7", PinPort(AnyPin), true)]), names([])))

    parts.push(PartSpec("potentiometer", "an ideal potentiometer supplying its wiper voltage from a host-controlled position", true, false,
        specs([ParamSpec("low-uv", PWhole(0, 5000000), false),
               ParamSpec("high-uv", PWhole(0, 5000000), false),
               ParamSpec("position", PWhole(0, 100), false),
               ParamSpec("taper", choice(["linear"]), false)]),
        ports([PortSpec("wiper", PinPort(AnalogPin), true)]), names([])))

    parts.push(PartSpec("button", "a push button between its pin and ground (or 3V3 when `active = high`)", true, false,
        specs([ParamSpec("active", choice(["low", "high"]), false)]),
        ports([PortSpec("pin", PinPort(AnyPin), true)]),
        names(["press"])))

    parts.push(PartSpec("joystick", "a two-axis analogue stick, each axis a voltage on an ADC pin", true, false,
        specs([]),
        ports([PortSpec("x", PinPort(AdcPin), true), PortSpec("y", PinPort(AdcPin), true)]),
        names(["up", "down", "left", "right"])))

    parts.push(PartSpec("ds3231", "DS3231 I2C real-time clock with calendar, alarms and temperature registers", true, false,
        specs([ParamSpec("initial-time", choice(["host","fixed"]), false), ParamSpec("initial-year", PWhole(2000,2199), false), ParamSpec("initial-month", PWhole(1,12), false),
               ParamSpec("initial-day", PWhole(1,31), false), ParamSpec("temperature-quarter-c", PWhole(-160,340), false)]),
        ports([PortSpec("i2c", BusPort("i2c"), true)]), names([])))
    parts.push(PartSpec("buzzer", "a buzzer: `active` sounds a fixed tone while its pin is high, `passive` sounds the pin's waveform", true, false,
        specs([ParamSpec("kind", choice(["active", "passive"]), true),
               ParamSpec("tone", PWhole(20, 20000), false), ParamSpec("gain", PWhole(0, 100), false)]),
        ports([PortSpec("pin", PinPort(AnyPin), true)]),
        names([])))

    parts.push(PartSpec("ws2812", "an addressable RGB LED, decoded from its data pin's waveform", true, false,
        specs([ParamSpec("count", PWhole(1, 1024), false)]),
        ports([PortSpec("din", PinPort(AnyPin), true)]),
        names([])))

    parts.push(PartSpec("st7796", "the Sitronix ST7796 TFT controller and its glass, over SPI", true, true,
        specs([ParamSpec("width", PWhole(1, 4096), true),
               ParamSpec("height", PWhole(1, 4096), true),
               ParamSpec("invert", PFlag, false),
               ParamSpec("variant", choice(["st7796", "ili9488"]), false)]),
        ports([PortSpec("spi", BusPort("spi"), true),
               PortSpec("cs", PinPort(AnyPin), true),
               PortSpec("dc", PinPort(AnyPin), true),
               PortSpec("reset", PinPort(AnyPin), false),
               PortSpec("backlight", PinPort(AnyPin), false)]),
        names([])))

    parts.push(PartSpec("gt911", "the Goodix GT911 capacitive touch controller, over I2C", true, false,
        specs([ParamSpec("address", PWhole(0, 127), false), ParamSpec("width", PWhole(1,4096), false), ParamSpec("height", PWhole(1,4096), false)]),
        ports([PortSpec("i2c", BusPort("i2c"), true),
               PortSpec("int", PinPort(AnyPin), false),
               PortSpec("reset", PinPort(AnyPin), false)]),
        names(["point"])))

    parts.push(PartSpec("terminal", "the host's terminal on a UART: what the board writes is printed, what is typed is sent", true, false,
        specs([ParamSpec("baud", PWhole(300, 4000000), false)]),
        ports([PortSpec("uart", BusPort("uart"), true)]),
        names([])))

    parts.push(PartSpec("cyw43439", "the Infineon CYW43439 Wi-Fi and Bluetooth mcu, over gSPI; its GPIOs drive other parts", false, false,
        specs([]),
        ports([PortSpec("wl_on", PinPort(AnyPin), true),
               PortSpec("data", PinPort(AnyPin), true),
               PortSpec("cs", PinPort(AnyPin), true),
               PortSpec("clock", PinPort(AnyPin), true),
               PortSpec("gpio0", Offer, false),
               PortSpec("gpio1", Offer, false),
               PortSpec("gpio2", Offer, false)]),
        names([])))

    Registry(cores, peripherals, parts)
end library

private choice(options: []const string) -> ParamKind = PChoice(names(options))

// The tables above are written as array literals; each of these names the element type the literal
// is read at, so an empty `[]` still has one.
private names(xs: []const string) -> Buf[string] = listed(xs)
private specs(xs: []const ParamSpec) -> Buf[ParamSpec] = listed(xs)
private ports(xs: []const PortSpec) -> Buf[PortSpec] = listed(xs)

private listed[T](xs: []const T) -> Buf[T]
    var out: Buf[T] = buf()

    out.extend(xs)
    out
end listed
