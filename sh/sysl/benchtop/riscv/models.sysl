module sh.sysl.benchtop.riscv

// One interpreter, selected by ISA capabilities rather than a separate implementation per chip.
// Profiles describe hardware; implemented() is deliberately separate from what a profile declares.
const EXT_M: u32 = 1
const EXT_A: u32 = 2
const EXT_C: u32 = 4
const EXT_CSR: u32 = 8
const EXT_B: u32 = 16
const EXT_ZC: u32 = 32
const EXT_IFENCE: u32 = 64
const SUPPORTED: u32 = EXT_M | EXT_C

struct Model
    name: string
    isa: string
    extensions: u32
    irqs: int

val MODELS: [5]Model = [
    Model("rv32i", "rv32i", 0, 0),
    Model("rv32im", "rv32im", EXT_M, 0),
    Model("rv32ic", "rv32ic", EXT_C, 0),
    Model("rv32imc", "rv32imc", EXT_M | EXT_C, 0),
    Model("hazard3", "rv32ima_zicsr_zifencei_zba_zbb_zbs_zbkb_zca_zcb_zcmp", EXT_M | EXT_A | EXT_C | EXT_CSR | EXT_B | EXT_ZC | EXT_IFENCE, 52),
]

model_named(name: string) -> Option[Model]
    for model in MODELS do if model.name == name then return Some(model)
    None

implemented(model: Model) -> bool = (model.extensions & ~SUPPORTED) == 0

has(model: Model, extension: u32) -> bool = (model.extensions & extension) == extension
