module sh.sysl.benchtop.riscv

// One interpreter, selected by ISA capabilities rather than a separate implementation per chip. A
// profile (`Model`) says which extensions the core decodes and how many external interrupts its
// controller has; what one chip's integration fixes besides (its ID registers, its reset PMP
// regions, its reservation granule, its errata) is a `Chip`, which the board supplies.
// implemented() is deliberately separate from what a profile declares.
const EXT_M: u32 = 1
const EXT_A: u32 = 2
const EXT_C: u32 = 4
const EXT_CSR: u32 = 8
const EXT_B: u32 = 16
const EXT_ZC: u32 = 32
const EXT_IFENCE: u32 = 64
const EXT_H3BEXTM: u32 = 128
const EXT_H3POWER: u32 = 256
const EXT_H3IRQ: u32 = 512
const EXT_H3PMPM: u32 = 1024
const EXT_PRIV: u32 = 2048
const HAZARD3: u32 = EXT_M | EXT_A | EXT_C | EXT_CSR | EXT_B | EXT_ZC | EXT_IFENCE | EXT_H3BEXTM | EXT_H3POWER | EXT_H3IRQ | EXT_H3PMPM | EXT_PRIV
const SUPPORTED: u32 = HAZARD3

/** The most external interrupts a profile's controller may have: one bit each in a `u64`. */
const MAX_IRQS: int = 64

struct Model
    name: string
    isa: string
    extensions: u32
    // External interrupt inputs of the core's controller (Xh3irq), 0 where it has none.
    irqs: int

val MODELS: [5]Model = [
    Model("rv32i", "rv32i", 0, 0),
    Model("rv32im", "rv32im", EXT_M, 0),
    Model("rv32ic", "rv32ic", EXT_C, 0),
    Model("rv32imc", "rv32imc", EXT_M | EXT_C, 0),
    Model("hazard3", "rv32ima_zicsr_zifencei_zba_zbb_zbs_zbkb_zca_zcb_zcmp_xh3bextm_xh3power_xh3irq_xh3pmpm", HAZARD3, 52),
]

model_named(name: string) -> Option[Model]
    for model in MODELS do if model.name == name then return Some(model)
    None

implemented(model: Model) -> bool = (model.extensions & ~SUPPORTED) == 0 && model.irqs <= MAX_IRQS

has(model: Model, extension: u32) -> bool = (model.extensions & extension) == extension

/** What a chip's integration of the core fixes, beyond the ISA profile. */
struct Chip
    // misa, mvendorid, marchid and mimpid as the chip reports them.
    misa: u32
    vendor: u32
    arch: u32
    implementation: u32
    // Bytes the exclusive monitor tracks for one reservation: an address's tag is it rounded down.
    reservation_granule: u32
    // Whether a hart's own ordinary store into its reserved granule leaves the reservation.
    keeps_own_reservation: bool
    // The PMP regions in force from reset (configuration bytes and pmpaddr values).
    pmp_cfg: [16]u8
    pmp_addr: [16]u32
    // Erratum: the X and R permission bits of a PMP configuration are swapped.
    pmp_xr_swapped: bool
    // Erratum: mstatus.MIE masks interrupts in User mode as well as Machine mode.
    mie_masks_user: bool

/** A chip that adds nothing to the profile: no IDs, no reset PMP regions, a word-sized granule. */
val BARE: Chip = Chip(0, 0, 0, 0, 4, false, [0; 16], [0; 16], false, false)
