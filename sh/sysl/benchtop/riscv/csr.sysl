module sh.sysl.benchtop.riscv

// CSR numbers (the privileged spec's, and Hazard3's custom ones), their fields, and the encodings the
// interpreter recognises whole.
const CSR_MSTATUS: u32 = 0x300
const CSR_MISA: u32 = 0x301
const CSR_MIE: u32 = 0x304
const CSR_MTVEC: u32 = 0x305
const CSR_MCOUNTEREN: u32 = 0x306
const CSR_MENVCFG: u32 = 0x30A
const CSR_MSTATUSH: u32 = 0x310
const CSR_MENVCFGH: u32 = 0x31A
const CSR_MCOUNTINHIBIT: u32 = 0x320
const CSR_MSCRATCH: u32 = 0x340
const CSR_MEPC: u32 = 0x341
const CSR_MCAUSE: u32 = 0x342
const CSR_MTVAL: u32 = 0x343
const CSR_MIP: u32 = 0x344
const CSR_PMPCFG0: u32 = 0x3A0
const CSR_PMPADDR0: u32 = 0x3B0
const CSR_MCYCLE: u32 = 0xB00
const CSR_MINSTRET: u32 = 0xB02
const CSR_MCYCLEH: u32 = 0xB80
const CSR_MINSTRETH: u32 = 0xB82
const CSR_CYCLE: u32 = 0xC00
const CSR_INSTRET: u32 = 0xC02
const CSR_CYCLEH: u32 = 0xC80
const CSR_INSTRETH: u32 = 0xC82
const CSR_MVENDORID: u32 = 0xF11
const CSR_MARCHID: u32 = 0xF12
const CSR_MIMPID: u32 = 0xF13
const CSR_MHARTID: u32 = 0xF14
const CSR_MCONFIGPTR: u32 = 0xF15
// Hazard3: PMPCFGM0 (Xh3pmpm), MSLEEP (Xh3power) and the external interrupt controller (Xh3irq).
const CSR_PMPCFGM0: u32 = 0xBD0
const CSR_MSLEEP: u32 = 0xBF0
const CSR_MEIEA: u32 = 0xBE0
const CSR_MEIPA: u32 = 0xBE1
const CSR_MEIFA: u32 = 0xBE2
const CSR_MEIPRA: u32 = 0xBE3
const CSR_MEINEXT: u32 = 0xBE4
const CSR_MEICONTEXT: u32 = 0xBE5

const PRIV_USER: u32 = 0
const PRIV_MACHINE: u32 = 3

const MSTATUS_MIE: u32 = 0x8
const MSTATUS_MPIE: u32 = 0x80
const MSTATUS_MPP: u32 = 0x1800
const MSTATUS_MPRV: u32 = 0x20000
const MSTATUS_TW: u32 = 0x200000

// mie and mip: machine software, timer and external interrupts.
const MIP_MSIP: u32 = 0x8
const MIP_MTIP: u32 = 0x80
const MIP_MEIP: u32 = 0x800

const CAUSE_INTERRUPT: u32 = 0x80000000
const CAUSE_SOFTWARE: u32 = 3
const CAUSE_TIMER: u32 = 7
const CAUSE_EXTERNAL: u32 = 11
const MCAUSE_MASK: u32 = CAUSE_INTERRUPT | 15

// mcountinhibit: CY stops mcycle, IR stops minstret.
const INHIBIT_CY: u32 = 1
const INHIBIT_IR: u32 = 4

// pmpcfg: R, W, X, the address-matching mode A, and the lock L.
const PMPCFG_R: u32 = 1
const PMPCFG_W: u32 = 2
const PMPCFG_X: u32 = 4
const PMPCFG_A: u32 = 0x18
const PMPCFG_L: u32 = 0x80

// meicontext with no IRQ being handled: NOIRQ set, everything else clear.
const MEICONTEXT_NOIRQ: u32 = 0x8000
// meicontext.CLEARTS, and meinext.UPDATE.
const MEICONTEXT_CLEARTS: u32 = 2
const MEINEXT_UPDATE: u32 = 1
// MSLEEP fields, and the two kinds of sleep (`Cpu.sleep_kind`).
const MSLEEP_DEEPSLEEP: u32 = 1
const MSLEEP_POWERDOWN: u32 = 2
const MSLEEP_SLEEPONBLOCK: u32 = 4
const SLEEP_WFI: u32 = 1
const SLEEP_BLOCK: u32 = 2

const ECALL: u32 = 0x00000073
const EBREAK: u32 = 0x00100073
const MRET: u32 = 0x30200073
const WFI: u32 = 0x10500073
// Xh3power's hints: slt x0, x0, x0 and slt x0, x0, x1.
const H3_BLOCK: u32 = 0x00002033
const H3_UNBLOCK: u32 = 0x00102033

// The bits of the u64 interrupt arrays a profile with `irqs` inputs implements.
private irq_mask(cpu: *Cpu) -> u64 = if cpu.model.irqs >= 64 then ~0u64 else (1u64 << u32(cpu.model.irqs)) - 1

// CSR accesses validate before any read/write side effects. Indexed arrays use the raw
// source operand, not the value produced by CSRRS/CSRRC. See Hazard3 v1.0-rc1 RTL.
private csr_value(cpu: *Cpu, address: u32, raw: u32, writing: bool) -> Option[u32]
    val s = &cpu.cs
    if address >= CSR_PMPCFG0 && address < CSR_PMPCFG0 + 4
        var value: u32 = 0
        for i in 0u32..<4 do value |= u32(s.pmpcfg[(address - CSR_PMPCFG0) * 4 + i]) << (i * 8)
        return Some(value)
    if address >= CSR_PMPADDR0 && address < CSR_PMPADDR0 + 16
        val index = address - CSR_PMPADDR0
        val value = s.pmpaddr[index]
        return Some(if index < 8 && (u32(s.pmpcfg[index]) & PMPCFG_A) == 0 then value & ~7u32 else value)
    // mhpmcounter3..31 (and their high halves) and mhpmevent3..31 read as zero.
    if (address >= 0xB03 && address <= 0xB1F) || (address >= 0xB83 && address <= 0xB9F) || (address >= 0x323 && address <= 0x33F) then return Some(0)
    address match
        CSR_MSTATUS -> return Some(s.mstatus)
        CSR_MISA -> return Some(cpu.chip.misa)
        CSR_MIE -> return Some(s.mie)
        CSR_MTVEC -> return Some(s.mtvec)
        CSR_MCOUNTEREN -> return Some(s.mcounteren)
        CSR_MSTATUSH | CSR_MENVCFG | CSR_MENVCFGH -> return Some(0)
        CSR_MCOUNTINHIBIT -> return Some(s.inhibit)
        CSR_MSCRATCH -> return Some(s.mscratch)
        CSR_MEPC -> return Some(s.mepc)
        CSR_MCAUSE -> return Some(s.mcause)
        CSR_MTVAL -> return Some(0) // MTVAL is hardwired zero on Hazard3.
        CSR_MIP -> return Some(pending_bits(cpu))
        CSR_MCYCLE | CSR_CYCLE -> return Some(u32.wrap(s.cycle))
        CSR_MCYCLEH | CSR_CYCLEH -> return Some(u32(s.cycle >> 32))
        CSR_MINSTRET | CSR_INSTRET -> return Some(u32.wrap(s.instret))
        CSR_MINSTRETH | CSR_INSTRETH -> return Some(u32(s.instret >> 32))
        CSR_MVENDORID -> return Some(cpu.chip.vendor)
        CSR_MARCHID -> return Some(cpu.chip.arch)
        CSR_MIMPID -> return Some(cpu.chip.implementation)
        CSR_MHARTID -> return Some(cpu.hart)
        CSR_MCONFIGPTR -> return Some(0)
        CSR_PMPCFGM0 -> return if has(cpu.model, EXT_H3PMPM) then Some(s.cfgm) else None
        CSR_MSLEEP -> return if has(cpu.model, EXT_H3POWER) then Some(s.sleep) else None
        CSR_MEIEA | CSR_MEIPA | CSR_MEIFA ->
            if !has(cpu.model, EXT_H3IRQ) then return None
            val index = raw & 31
            val values = if address == CSR_MEIEA then s.enabled elif address == CSR_MEIPA then s.pending | s.forced else s.forced
            return Some(if index >= 4 then 0 else u32((values >> (16 * index)) & 65535) << 16)
        CSR_MEIPRA ->
            if !has(cpu.model, EXT_H3IRQ) then return None
            val first = (raw & 127) * 4
            var value: u32 = 0
            for i in 0u32..<4 do if first + i < u32(cpu.model.irqs) then value |= u32(s.priority[first + i]) << (16 + 4 * i)
            return Some(value)
        CSR_MEINEXT ->
            if !has(cpu.model, EXT_H3IRQ) then return None
            val next = next_irq(cpu, preempt_level(cpu))
            return Some(if next < 0 then 0x80000000 else u32(next) << 2)
        CSR_MEICONTEXT ->
            if !has(cpu.model, EXT_H3IRQ) then return None
            // CLEARTS reads back the MTIE and MSIE it is about to clear, as MTIESAVE and MSIESAVE.
            val saved = if writing && (raw & MEICONTEXT_CLEARTS) != 0 then ((s.mie >> 4) & 8) | ((s.mie >> 1) & 4) else 0
            return Some(s.context | saved)
        _ -> return None

private csr_store(cpu: *Cpu, address: u32, raw: u32, value: u32, operation: u32, selected: int)
    val s = &cpu.cs
    if address >= CSR_PMPCFG0 && address < CSR_PMPCFG0 + 4
        for i in 0u32..<4
            val index = (address - CSR_PMPCFG0) * 4 + i
            if index >= 8 || (u32(s.pmpcfg[index]) & PMPCFG_L) != 0 then continue
            var cfg = (value >> (8 * i)) & 0x9F
            if (cfg & PMPCFG_A) != PMPCFG_A then cfg &= ~PMPCFG_A // NAPOT only, 32-byte granule.
            s.pmpcfg[index] = u8(cfg)
        decode_pmp(cpu)
        return
    if address >= CSR_PMPADDR0 && address < CSR_PMPADDR0 + 8
        val index = address - CSR_PMPADDR0
        if (u32(s.pmpcfg[index]) & PMPCFG_L) == 0 then s.pmpaddr[index] = (value & 0x3FFFFFFF) | 3
        decode_pmp(cpu)
        return
    address match
        CSR_MSTATUS -> s.mstatus = (value & (MSTATUS_TW | MSTATUS_MPRV | MSTATUS_MPIE | MSTATUS_MIE)) | (if (value & 0x1000) != 0 then MSTATUS_MPP else 0)
        CSR_MIE -> s.mie = value & (MIP_MEIP | MIP_MTIP | MIP_MSIP)
        CSR_MTVEC -> s.mtvec = value & ~2u32
        CSR_MCOUNTEREN -> s.mcounteren = value & 7
        CSR_MCOUNTINHIBIT -> s.inhibit = value & (INHIBIT_CY | INHIBIT_IR)
        CSR_MSCRATCH -> s.mscratch = value
        CSR_MEPC -> s.mepc = value & ~1u32
        CSR_MCAUSE -> s.mcause = value & MCAUSE_MASK
        CSR_MCYCLE -> s.cycle = (s.cycle & 0xFFFFFFFF00000000) | u64(value)
        CSR_MCYCLEH -> s.cycle = (u64(value) << 32) | (s.cycle & 0xFFFFFFFF)
        CSR_MINSTRET ->
            s.instret = (s.instret & 0xFFFFFFFF00000000) | u64(value)
            s.wrote_instret = true
        CSR_MINSTRETH ->
            s.instret = (u64(value) << 32) | (s.instret & 0xFFFFFFFF)
            s.wrote_instret = true
        CSR_PMPCFGM0 ->
            s.cfgm = value & 255
            decode_pmp(cpu)
        CSR_MSLEEP -> s.sleep = value & 7
        CSR_MEIEA | CSR_MEIFA ->
            val index = raw & 31
            if index >= 4 then return
            val mask = 65535u64 << (16 * index)
            val bits = u64(value >> 16) << (16 * index)
            if address == CSR_MEIEA then s.enabled = ((s.enabled & ~mask) | bits) & irq_mask(cpu)
            else s.forced = ((s.forced & ~mask) | bits) & irq_mask(cpu)
            refresh_external(cpu)
        CSR_MEIPRA ->
            val first = (raw & 127) * 4
            for i in 0u32..<4 do if first + i < u32(cpu.model.irqs) then s.priority[first + i] = u8((value >> (16 + 4 * i)) & 15)
            refresh_external(cpu)
        CSR_MEINEXT ->
            if (value & MEINEXT_UPDATE) != 0
                val level = if selected < 0 then 16u32 else u32(s.priority[selected]) + 1
                s.context = (s.context & 0xFF000001) | (level << 16) | (if selected < 0 then MEICONTEXT_NOIRQ else u32(selected) << 4)
                refresh_external(cpu)
        CSR_MEICONTEXT ->
            // Self-clearing CLEARTS triggers only on write/set, never CSRRC.
            if operation != 3 && (raw & MEICONTEXT_CLEARTS) != 0
                s.mie &= ~(MIP_MTIP | MIP_MSIP)
            else
                if (value & 8) != 0 then s.mie |= MIP_MTIP
                if (value & 4) != 0 then s.mie |= MIP_MSIP
            s.context = value & 0xFF1F9FF1
            refresh_external(cpu)
        _ -> () // Legal hardwired or read-only fields inside writable CSRs.

/** One atomic CSR operation. op is CSRRW=1, CSRRS=2, CSRRC=3. */
csr_access(cpu: *Cpu, address: u32, operation: u32, source: u32, reading: bool, writing: bool) -> Option[u32]
    if !has(cpu.model, EXT_CSR) || operation < 1 || operation > 3 then return None
    if ((address >> 8) & 3) > cpu.cs.privilege || (writing && (address >> 10) == 3) then return None
    if cpu.cs.privilege == PRIV_USER
        val counter: u32 = if address == CSR_CYCLE || address == CSR_CYCLEH then 1 elif address == CSR_INSTRET || address == CSR_INSTRETH then 4 else 0
        if counter != 0 && (cpu.cs.mcounteren & counter) == 0 then return None
    val raw = if writing then source else 0
    val old = csr_value(cpu, address, raw, writing && operation != 3) match
        Some(value) -> value
        None -> return None
    val selected = if address == CSR_MEINEXT then next_irq(cpu, preempt_level(cpu)) else -1
    if writing
        val value = if operation == 1 then source elif operation == 2 then old | source else old & ~source
        csr_store(cpu, address, raw, value, operation, selected)
    if reading && address == CSR_MEINEXT && selected >= 0
        cpu.cs.forced &= ~(1u64 << u32(selected))
        refresh_external(cpu)
    Some(if reading then old else 0)
