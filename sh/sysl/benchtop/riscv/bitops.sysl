module sh.sysl.benchtop.riscv

// Zba/Zbb/Zbs/Zbkb, selected only for profiles declaring EXT_B. None of these paths
// changes architectural state: decoding/validation completes before the caller commits rd.
private rotate(a: u32, n: u32) -> u32
    val shift = n & 31
    if shift == 0 then return a
    (a >> shift) | (a << (32 - shift))

private count_bits(a: u32, which: u32) -> u32
    var count: u32 = 0
    if which == 2
        for i in 0u32..<32 do count += (a >> i) & 1
    else
        for i in 0u32..<32
            val bit = if which == 0 then 31 - i else i
            if ((a >> bit) & 1) != 0 then break
            count += 1
    count

private[riscv] bit_operation(code: u32, a: u32, b: u32) -> Option[u32]
    val opcode = code & 127
    val op = (code >> 12) & 7
    val top = code >> 25
    val rs2 = (code >> 20) & 31
    val n = b & 31
    if opcode == 0x33
        if top == 16 && (op == 2 || op == 4 || op == 6) then return Some((a << (op / 2)) + b)
        if top == 32
            if op == 4 then return Some(~(a ^ b))
            if op == 6 then return Some(a | ~b)
            if op == 7 then return Some(a & ~b)
        if top == 5
            op match
                4 -> return Some(if i32(a) < i32(b) then a else b)
                5 -> return Some(if a < b then a else b)
                6 -> return Some(if i32(a) > i32(b) then a else b)
                7 -> return Some(if a > b then a else b)
                _ -> ()
        if top == 48
            if op == 1 then return Some(rotate(a, (32 - n) & 31))
            if op == 5 then return Some(rotate(a, n))
        if top == 4 && op == 4 && rs2 == 0 then return Some(a & 65535)
        if op == 1
            if top == 20 then return Some(a | (1u32 << n))
            if top == 36 then return Some(a & ~(1u32 << n))
            if top == 52 then return Some(a ^ (1u32 << n))
        if top == 36 && op == 5 then return Some((a >> n) & 1)
        if top == 4 && op == 4
            // PACK: low halves from each source.
            return Some((a & 65535) | (b << 16))
        if top == 4 && op == 7 then return Some((a & 255) | ((b & 255) << 8))
    if opcode == 0x13
        if top == 48 && op == 1
            if rs2 <= 2 then return Some(count_bits(a, rs2))
            if rs2 == 4 then return Some(u32(i32(i8(a))))
            if rs2 == 5 then return Some(u32(i32(i16(a))))
        if top == 48 && op == 5 then return Some(rotate(a, rs2))
        if top == 20 && op == 5 && rs2 == 7
            var out: u32 = 0
            for i in 0u32..<4 do if ((a >> (8 * i)) & 255) != 0 then out |= 255u32 << (8 * i)
            return Some(out)
        if top == 52 && op == 5 && rs2 == 24
            return Some(((a & 255) << 24) | ((a & 0xFF00) << 8) | ((a >> 8) & 0xFF00) | (a >> 24))
        if top == 52 && op == 5 && rs2 == 7
            var out: u32 = 0
            for i in 0u32..<32 do out |= ((a >> i) & 1) << ((i & ~7u32) + (7 - (i & 7)))
            return Some(out)
        if top == 4 && rs2 == 15 && (op == 1 || op == 5)
            var out: u32 = 0
            for i in 0u32..<16
                if op == 1
                    out |= ((a >> i) & 1) << (2 * i)
                    out |= ((a >> (i + 16)) & 1) << (2 * i + 1)
                else
                    out |= ((a >> (2 * i)) & 1) << i
                    out |= ((a >> (2 * i + 1)) & 1) << (i + 16)
            return Some(out)
        if op == 1
            if top == 20 then return Some(a | (1u32 << rs2))
            if top == 36 then return Some(a & ~(1u32 << rs2))
            if top == 52 then return Some(a ^ (1u32 << rs2))
        if top == 36 && op == 5 then return Some((a >> rs2) & 1)
    None
