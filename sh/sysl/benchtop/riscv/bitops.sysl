module sh.sysl.benchtop.riscv

// Zba/Zbb/Zbs/Zbkb, selected only for profiles declaring EXT_B. None of these paths
// changes architectural state: decoding/validation completes before the caller commits rd.
// The counts, rotates and reversals are the library's integer operations.

private[riscv] bit_operation(code: u32, a: u32, b: u32) -> Option[u32]
    val opcode = code & 127
    val op = (code >> 12) & 7
    val top = code >> 25
    val rs2 = (code >> 20) & 31
    val n = b & 31
    if opcode == 0x33
        if top == 16 && (op == 2 || op == 4 || op == 6) then return Some((a << (op / 2)) +% b)
        if top == 32
            if op == 4 then return Some(~(a ^ b))
            if op == 6 then return Some(a | ~b)
            if op == 7 then return Some(a & ~b)
        if top == 5
            op match
                4 -> return Some(if i32.wrap(a) < i32.wrap(b) then a else b)
                5 -> return Some(if a < b then a else b)
                6 -> return Some(if i32.wrap(a) > i32.wrap(b) then a else b)
                7 -> return Some(if a > b then a else b)
                _ -> ()
        if top == 48
            if op == 1 then return Some(a.rotate_left(n))
            if op == 5 then return Some(a.rotate_right(n))
        if top == 4 && op == 4 && rs2 == 0 then return Some(a & 65535)
        if op == 1
            if top == 20 then return Some(a | (1u32 << n))
            if top == 36 then return Some(a & ~(1u32 << n))
            if top == 52 then return Some(a ^ (1u32 << n))
        if top == 36 && op == 5 then return Some((a >> n) & 1)
        if top == 4 && op == 4
            // PACK: low halves from each source.
            return Some((a & 65535) | (b << 16))
        if top == 4 && op == 7 then return Some((a & 255) | ((b & 255) << 8))
    if opcode == 0x13
        if top == 48 && op == 1
            if rs2 == 0 then return Some(a.leading_zeros())
            if rs2 == 1 then return Some(a.trailing_zeros())
            if rs2 == 2 then return Some(a.count_ones())
            if rs2 == 4 then return Some(u32.wrap(i8.wrap(a)))
            if rs2 == 5 then return Some(u32.wrap(i16.wrap(a)))
        if top == 48 && op == 5 then return Some(a.rotate_right(rs2))
        if top == 20 && op == 5 && rs2 == 7
            // ORC.B: each nonzero byte becomes 0xFF (the library has no byte-wise operation for it).
            var out: u32 = 0
            for i in 0u32..<4 do if ((a >> (8 * i)) & 255) != 0 then out |= 255u32 << (8 * i)
            return Some(out)
        if top == 52 && op == 5 && rs2 == 24 then return Some(a.swap_bytes())
        // BREV8: each byte's bits reversed, the bytes in place.
        if top == 52 && op == 5 && rs2 == 7 then return Some(a.reverse_bits().swap_bytes())
        if top == 4 && rs2 == 15 && (op == 1 || op == 5)
            var out: u32 = 0
            for i in 0u32..<16
                if op == 1
                    out |= ((a >> i) & 1) << (2 * i)
                    out |= ((a >> (i + 16)) & 1) << (2 * i + 1)
                else
                    out |= ((a >> (2 * i)) & 1) << i
                    out |= ((a >> (2 * i + 1)) & 1) << (i + 16)
            return Some(out)
        if op == 1
            if top == 20 then return Some(a | (1u32 << rs2))
            if top == 36 then return Some(a & ~(1u32 << rs2))
            if top == 52 then return Some(a ^ (1u32 << rs2))
        if top == 36 && op == 5 then return Some((a >> rs2) & 1)
    None
