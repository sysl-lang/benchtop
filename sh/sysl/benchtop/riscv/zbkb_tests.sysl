module sh.sysl.benchtop.riscv

// The branch-free ORC.B, ZIP and UNZIP against their definitions as loops.

orc_reference(a: u32) -> u32
    var out: u32 = 0
    for i in 0u32..<4 do if ((a >> (8 * i)) & 255) != 0 then out |= 255u32 << (8 * i)
    out

zip_reference(a: u32) -> u32
    var out: u32 = 0
    for i in 0u32..<16
        out |= ((a >> i) & 1) << (2 * i)
        out |= ((a >> (i + 16)) & 1) << (2 * i + 1)
    out

unzip_reference(a: u32) -> u32
    var out: u32 = 0
    for i in 0u32..<16
        out |= ((a >> (2 * i)) & 1) << i
        out |= ((a >> (2 * i + 1)) & 1) << (i + 16)
    out

check_word(a: u32)
    assert(orc_bytes(a) == orc_reference(a))
    assert(zip_bits(a) == zip_reference(a))
    assert(unzip_bits(a) == unzip_reference(a))
    assert(unzip_bits(zip_bits(a)) == a)
    assert(zip_bits(unzip_bits(a)) == a)

@test("ORC.B, ZIP and UNZIP bit tricks match the loop definitions on edge words")
zbkb_edge_words()
    val edges: [8]u32 = [0, 0xFFFFFFFF, 0x80000000, 0x55555555, 0xAAAAAAAA, 0x00FF00FF, 0xFF00FF00, 0x0000FFFF]
    for e in edges do check_word(e)
    for i in 0u32..<32 do check_word(1u32 << i)
    for i in 0u32..<32 do check_word(~(1u32 << i))
    assert(orc_bytes(0x00010000) == 0x00FF0000)
    assert(orc_bytes(0x80000001) == 0xFF0000FF)
    assert(zip_bits(0x0000FFFF) == 0x55555555)
    assert(zip_bits(0xFFFF0000) == 0xAAAAAAAA)

@test("ORC.B, ZIP and UNZIP bit tricks match the loop definitions on 100000 random words")
zbkb_random_words()
    var s: u64 = 0x9E3779B97F4A7C15
    for _ in 0..<100000
        s ^= s << 13
        s ^= s >> 7
        s ^= s << 17
        check_word(u32.wrap(s >> 16))
        // Sparse words exercise the zero-byte cases of ORC.B.
        check_word(u32.wrap(s >> 16) & u32.wrap(s >> 40) & u32.wrap(s >> 8))
