module sh.sysl.benchtop.riscv

// Machine-mode state: the CSRs, Hazard3's interrupt controller (Xh3irq), its PMP and its power
// controls. Harts may share RAM with pair(), run one after the other by the caller; every guest store
// passes through `store`, which keeps LR/SC reservations coherent.
//
// Two summaries are kept as the state they summarise changes, so that `run` tests them per
// instruction without a scan: `meip`, the external-interrupt line the controller drives (the
// priority scan runs on a change to the controller, not per instruction), and the PMP regions'
// bounds, decoded on a write to pmpcfg, pmpaddr or the M-mode enforcement mask.
struct Machine
    privilege: u32
    mstatus: u32
    mie: u32
    mip: u32
    mtvec: u32
    mscratch: u32
    mepc: u32
    mcause: u32
    mcounteren: u32
    inhibit: u32
    cycle: u64
    instret: u64
    wrote_instret: bool
    enabled: u64
    pending: u64
    forced: u64
    priority: [64]u8
    context: u32
    sleep: u32
    cfgm: u32
    pmpcfg: [16]u8
    pmpaddr: [16]u32
    // MIP_MEIP while an enabled external interrupt above the context's threshold is pending, else 0.
    meip: u32
    // The decoded PMP regions: bit i of `pmp_active` while region i is in force, its bytes
    // [pmp_lower[i], pmp_upper[i]); and whether any active region binds Machine mode too.
    pmp_active: u32
    pmp_lower: [16]u64
    pmp_upper: [16]u64
    pmp_binds_machine: bool

private[riscv] reset_machine(cpu: *Cpu)
    var state: Machine
    state.privilege = PRIV_MACHINE
    state.mstatus = MSTATUS_MPP
    state.context = MEICONTEXT_NOIRQ
    state.inhibit = INHIBIT_CY | INHIBIT_IR
    for i in 0..<16
        state.pmpcfg[i] = cpu.chip.pmp_cfg[i]
        state.pmpaddr[i] = cpu.chip.pmp_addr[i]
    cpu.cs = state
    cpu.peer = null
    cpu.hart = 0
    cpu.reserved = false
    cpu.reservation = 0
    cpu.event = false
    cpu.sleep_kind = 0
    cpu.halt_breakpoint = false
    cpu.halt_faults = false
    cpu.instruction = 0
    decode_pmp(cpu)
    refresh_external(cpu)

// Pairs are scheduled sequentially by the caller. No hidden global state or host threads.
pair(a: *Cpu, b: *Cpu) -> bool
    if a == b || a.ram.len == 0 || a.ram.len != b.ram.len || a.base != b.base then return false
    if &a.ram[0] != &b.ram[0] || a.peer != null || b.peer != null then return false
    a.peer = b
    b.peer = a
    a.hart = 0
    b.hart = 1
    a.reserved = false
    b.reserved = false
    true

unpair(cpu: *Cpu)
    if cpu.peer != null
        cpu.peer.peer = null
        cpu.peer.reserved = false
    cpu.peer = null
    cpu.reserved = false

private[riscv] reservation_tag(cpu: *Cpu, address: u32) -> u32 = address & ~(cpu.chip.reservation_granule - 1)

// A store to `address`: it clears the hart's own reservation of the granule unless the chip's monitor
// keeps it, and always the peer's, which it signals.
private[riscv] invalidate(cpu: *Cpu, address: u32, width: u32)
    if !cpu.chip.keeps_own_reservation && cpu.reserved && reservation_tag(cpu, address) == cpu.reservation then cpu.reserved = false
    if cpu.peer != null
        val other = cpu.peer
        if other.reserved && reservation_tag(other, address) == other.reservation
            other.reserved = false
            notify_unblock(other)

/** Observable functional power request: 0 running, 1 stalled, 2 clock gated, 3 power down. */
sleep_depth(cpu: *Cpu) -> u32
    if cpu.stop != Stop.Sleep then return 0
    if cpu.sleep_kind == SLEEP_BLOCK && (cpu.cs.sleep & MSLEEP_SLEEPONBLOCK) == 0 then return 1
    if (cpu.cs.sleep & MSLEEP_POWERDOWN) != 0 then return 3
    if (cpu.cs.sleep & MSLEEP_DEEPSLEEP) != 0 then return 2
    1

notify_unblock(cpu: *Cpu)
    cpu.event = true
    if cpu.stop == Stop.Sleep && cpu.sleep_kind == SLEEP_BLOCK
        cpu.stop = Stop.Budget
        cpu.event = false

private[riscv] send_unblock(cpu: *Cpu)
    notify_unblock(cpu)
    if cpu.peer != null then notify_unblock(cpu.peer)

/** Level-sensitive external IRQ input, below the profile's `irqs`. Returns false for an invalid input. */
irq(cpu: *Cpu, number: u32, asserted: bool) -> bool
    if !has(cpu.model, EXT_H3IRQ) || number >= u32(cpu.model.irqs) then return false
    val mask = 1u64 << number
    if asserted then cpu.cs.pending |= mask else cpu.cs.pending &= ~mask
    refresh_external(cpu)
    true

/** Machine software/timer input levels; their pending CSR bits are read-only on Hazard3. */
interrupt_inputs(cpu: *Cpu, software: bool, timer: bool)
    cpu.cs.mip = (if software then MIP_MSIP else 0) | (if timer then MIP_MTIP else 0)

// The external interrupt the controller would take at or above priority `threshold`: the highest
// priority, the lowest number among equals; -1 where none is enabled and pending.
private[riscv] next_irq(cpu: *Cpu, threshold: u32) -> int
    val active = (cpu.cs.pending | cpu.cs.forced) & cpu.cs.enabled
    if active == 0 then return -1
    var best = -1
    var priority: u32 = 0
    for i in 0..<cpu.model.irqs
        val p = u32(cpu.cs.priority[i])
        if (active & (1u64 << u32(i))) != 0 && p >= threshold && (best < 0 || p > priority)
            best = i
            priority = p
    best

// The preemption threshold meicontext holds (PPREEMPT), and the priority above which a new IRQ may
// preempt while one is being handled (MREG).
private[riscv] threshold(cpu: *Cpu) -> u32 = (cpu.cs.context >> 16) & 31
private[riscv] preempt_level(cpu: *Cpu) -> u32 = (cpu.cs.context >> 24) & 15

// Recompute `meip`: called wherever the controller's inputs, enables, priorities or context change.
private[riscv] refresh_external(cpu: *Cpu)
    cpu.cs.meip = if next_irq(cpu, threshold(cpu)) >= 0 then MIP_MEIP else 0

private[riscv] pending_bits(cpu: *Cpu) -> u32 = cpu.cs.mip | cpu.cs.meip

private[riscv] trap(cpu: *Cpu, cause: u32)
    val status = cpu.cs.mstatus
    cpu.cs.mepc = cpu.pc & ~1u32
    cpu.cs.mcause = cause & MCAUSE_MASK
    cpu.cs.mstatus = (status & ~(MSTATUS_MPP | MSTATUS_MPIE | MSTATUS_MIE)) | ((status & MSTATUS_MIE) << 4) | (cpu.cs.privilege << 11)
    cpu.cs.privilege = PRIV_MACHINE
    cpu.reserved = false
    if cause == CAUSE_INTERRUPT | CAUSE_EXTERNAL
        val n = next_irq(cpu, preempt_level(cpu))
        val level = if n < 0 then 16u32 else u32(cpu.cs.priority[n]) + 1
        val context = cpu.cs.context
        cpu.cs.context = (context & 0x00009FF0) | (((context >> 24) & 15) << 28) | (((context >> 16) & 15) << 24) | (level << 16) | 1
        refresh_external(cpu)
    else
        cpu.cs.context &= ~1u32
    cpu.pc = (cpu.cs.mtvec & ~3u32) + (if (cause & CAUSE_INTERRUPT) != 0 && (cpu.cs.mtvec & 1) != 0 then (cause & 15) * 4 else 0)
    cpu.stop = Stop.Budget
    cpu.sleep_kind = 0

private[riscv] take_interrupt(cpu: *Cpu) -> bool
    if !has(cpu.model, EXT_PRIV) then return false
    val pending = pending_bits(cpu) & cpu.cs.mie
    val masked = cpu.cs.privilege == PRIV_MACHINE || cpu.chip.mie_masks_user
    if pending == 0 || (masked && (cpu.cs.mstatus & MSTATUS_MIE) == 0) then return false
    val number = if (pending & MIP_MEIP) != 0 then CAUSE_EXTERNAL elif (pending & MIP_MSIP) != 0 then CAUSE_SOFTWARE else CAUSE_TIMER
    trap(cpu, CAUSE_INTERRUPT | number)
    true

private[riscv] return_from_trap(cpu: *Cpu) -> u32
    val status = cpu.cs.mstatus
    cpu.cs.privilege = (status >> 11) & 3
    cpu.cs.mstatus = (status & ~(MSTATUS_MPP | MSTATUS_MPIE | MSTATUS_MIE)) | ((status >> 4) & MSTATUS_MIE) | MSTATUS_MPIE
    if cpu.cs.privilege != PRIV_MACHINE then cpu.cs.mstatus &= ~MSTATUS_MPRV
    val context = cpu.cs.context
    cpu.cs.context &= ~1u32
    if (context & 1) != 0
        cpu.cs.context = (context & 0x00009FF0) | (((context >> 28) & 15) << 24) | (((context >> 24) & 15) << 16)
    refresh_external(cpu)
    cpu.reserved = false
    cpu.cs.mepc

private[riscv] resolve_fault(cpu: *Cpu)
    if cpu.halt_faults || !has(cpu.model, EXT_PRIV) || cpu.stop == Stop.Budget || cpu.stop == Stop.Sleep || cpu.stop == Stop.Exit then return
    if cpu.stop == Stop.Breakpoint && cpu.halt_breakpoint then return
    val access = cpu.fault_access
    val cause: u32 = cpu.stop match
        Breakpoint -> 3
        Ecall -> if cpu.cs.privilege == PRIV_MACHINE then 11 else 8
        Misaligned -> access match
            Fetch -> 0
            Load -> 4
            Store -> 6
        Unmapped | AccessFault -> access match
            Fetch -> 1
            Load -> 5
            Store -> 7
        _ -> 2
    trap(cpu, cause)

// Decode pmpcfg/pmpaddr into `pmp_active` and the regions' bounds. Only NAPOT regions can be set.
private[riscv] decode_pmp(cpu: *Cpu)
    val s = &cpu.cs
    s.pmp_active = 0
    s.pmp_binds_machine = false
    for i in 0..<16
        val cfg = u32(s.pmpcfg[i])
        if (cfg & PMPCFG_A) == 0 then continue
        var trailing: u32 = 0
        val encoded = s.pmpaddr[i]
        while trailing < 30 && ((encoded >> trailing) & 1) != 0 do trailing += 1
        val size = 1u64 << (trailing + 3)
        s.pmp_lower[i] = (u64(encoded) << 2) & ~(size - 1)
        s.pmp_upper[i] = s.pmp_lower[i] + size
        s.pmp_active |= 1u32 << u32(i)
        if (cfg & PMPCFG_L) != 0 || (s.cfgm & (1u32 << u32(i))) != 0 then s.pmp_binds_machine = true

private[riscv] pmp_allows(cpu: *Cpu, address: u32, width: u32, access: Access) -> bool
    if !has(cpu.model, EXT_PRIV) then return true
    var privilege = cpu.cs.privilege
    if access != Access.Fetch && (cpu.cs.mstatus & MSTATUS_MPRV) != 0 then privilege = (cpu.cs.mstatus >> 11) & 3
    // Every region is 8-byte aligned and at least 8 bytes, so an access inside one 8-byte block is
    // inside or outside each region whole; in Machine mode with no region binding it, it is allowed.
    if privilege == PRIV_MACHINE && !cpu.cs.pmp_binds_machine && (address & 7) + width <= 8 then return true
    // Lowest numbered region matching any byte wins; a partial match always faults.
    val start = u64(address)
    val end = start + u64(width)
    val active = cpu.cs.pmp_active
    for i in 0..<16
        if (active >> u32(i)) == 0 then break
        if (active & (1u32 << u32(i))) == 0 then continue
        val lower = cpu.cs.pmp_lower[i]
        val upper = cpu.cs.pmp_upper[i]
        if start >= upper || end <= lower then continue
        if start < lower || end > upper then return false
        val cfg = u32(cpu.cs.pmpcfg[i])
        if privilege == PRIV_MACHINE && (cfg & PMPCFG_L) == 0 && (cpu.cs.cfgm & (1u32 << u32(i))) == 0 then return true
        val swapped = cpu.chip.pmp_xr_swapped
        val permission = access match
            Fetch -> if swapped then PMPCFG_R else PMPCFG_X
            Load -> if swapped then PMPCFG_X else PMPCFG_R
            Store -> PMPCFG_W
        return (cfg & permission) != 0
    privilege == PRIV_MACHINE
