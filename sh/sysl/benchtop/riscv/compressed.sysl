module sh.sysl.benchtop.riscv

// RV32C expands to RV32I; the semantics, faults, register writes and retirement stay shared.
// Zero is not a legal canonical instruction and marks a reserved/unsupported encoding.
private ri(opcode: u32, rd: u32, op: u32, rs: u32, imm: u32) -> u32 =
    ((imm & 4095) << 20) | (rs << 15) | (op << 12) | (rd << 7) | opcode
private rr(rd: u32, op: u32, a: u32, b: u32, top: u32) -> u32 =
    (top << 25) | (b << 20) | (a << 15) | (op << 12) | (rd << 7) | 0x33
private st(rs: u32, base: u32, imm: u32) -> u32 =
    ((imm >> 5) << 25) | (rs << 20) | (base << 15) | (2 << 12) | ((imm & 31) << 7) | 0x23
private jump(rd: u32, imm: u32) -> u32 =
    (((imm >> 20) & 1) << 31) | ((imm & 0x7FE) << 20) | (((imm >> 11) & 1) << 20) | (imm & 0xFF000) | (rd << 7) | 0x6F
private br(op: u32, rs: u32, imm: u32) -> u32 =
    (((imm >> 12) & 1) << 31) | (((imm >> 5) & 63) << 25) | (rs << 15) | (op << 12) | (((imm >> 1) & 15) << 8) | (((imm >> 11) & 1) << 7) | 0x63

private cx(value: u32, bits: u32) -> u32 = u32(i32(value << (32 - bits)) >> (32 - bits))

decompress(c: u32) -> u32
    val quadrant = c & 3
    val op = c >> 13
    val rd = (c >> 7) & 31
    val rs = (c >> 2) & 31
    val small_rd = 8 + ((c >> 2) & 7)
    val small_rs = 8 + ((c >> 7) & 7)
    val imm = cx(((c >> 2) & 31) | (((c >> 12) & 1) << 5), 6)

    if quadrant == 0
        val offset = (((c >> 5) & 1) << 6) | (((c >> 10) & 7) << 3) | (((c >> 6) & 1) << 2)
        op match
            0 ->
                val n = (((c >> 7) & 15) << 6) | (((c >> 11) & 3) << 4) | (((c >> 5) & 1) << 3) | (((c >> 6) & 1) << 2)
                return if n == 0 then 0 else ri(0x13, small_rd, 0, 2, n)
            2 -> return ri(0x03, small_rd, 2, small_rs, offset)
            6 -> return st(small_rd, small_rs, offset)
            _ -> return 0

    if quadrant == 1
        op match
            0 -> return ri(0x13, rd, 0, rd, imm)
            1 | 5 ->
                val n = cx((((c >> 12) & 1) << 11) | (((c >> 11) & 1) << 4) | (((c >> 9) & 3) << 8) | (((c >> 8) & 1) << 10) | (((c >> 7) & 1) << 6) | (((c >> 6) & 1) << 7) | (((c >> 3) & 7) << 1) | (((c >> 2) & 1) << 5), 12)
                return jump(if op == 1 then 1 else 0, n)
            2 -> return ri(0x13, rd, 0, 0, imm)
            3 ->
                if rd == 2
                    val n = cx((((c >> 12) & 1) << 9) | (((c >> 6) & 1) << 4) | (((c >> 5) & 1) << 6) | (((c >> 3) & 3) << 7) | (((c >> 2) & 1) << 5), 10)
                    return if n == 0 then 0 else ri(0x13, 2, 0, 2, n)
                if imm == 0 then return 0
                return (imm << 12) | (rd << 7) | 0x37
            4 ->
                val sub = (c >> 10) & 3
                if sub < 2
                    if (c & 0x1000) != 0 then return 0
                    return ri(0x13, small_rs, 5, small_rs, rs | (sub << 10))
                if sub == 2 then return ri(0x13, small_rs, 7, small_rs, imm)
                if (c & 0x1000) != 0 then return 0
                val which = (c >> 5) & 3
                val alu: u32 = if which == 0 then 0 elif which == 1 then 4 elif which == 2 then 6 else 7
                return rr(small_rs, alu, small_rs, small_rd, if which == 0 then 32 else 0)
            6 | 7 ->
                val n = cx((((c >> 12) & 1) << 8) | (((c >> 10) & 3) << 3) | (((c >> 5) & 3) << 6) | (((c >> 3) & 3) << 1) | (((c >> 2) & 1) << 5), 9)
                return br(if op == 6 then 0 else 1, small_rs, n)
            _ -> return 0

    if quadrant == 2
        op match
            0 ->
                if (c & 0x1000) != 0 then return 0
                return ri(0x13, rd, 1, rd, rs)
            2 ->
                if rd == 0 then return 0
                val n = (((c >> 12) & 1) << 5) | (((c >> 4) & 7) << 2) | (((c >> 2) & 3) << 6)
                return ri(0x03, rd, 2, 2, n)
            4 ->
                if (c & 0x1000) == 0
                    if rs != 0 then return rr(rd, 0, 0, rs, 0)
                    return if rd == 0 then 0 else ri(0x67, 0, 0, rd, 0)
                if rs != 0 then return rr(rd, 0, rd, rs, 0)
                return if rd == 0 then 0x00100073 else ri(0x67, 1, 0, rd, 0)
            6 ->
                val n = (((c >> 9) & 15) << 2) | (((c >> 7) & 3) << 6)
                return st(rs, 2, n)
            _ -> return 0
    0
