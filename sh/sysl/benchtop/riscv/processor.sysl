module sh.sysl.benchtop.riscv

import sh.sysl.benchtop.processor.Processor

// A hart as a chip's devices see it: its hart number, its retired count, its Xh3irq inputs (levels)
// and its machine software and timer inputs.
impl Processor for Cpu
    number(*self) -> u32 = self.hart
    instructions(*self) -> u64 = self.retired
    interrupt(*self, line: u32, level: bool)
        irq(self, line, level)
    override machine_timer(*self, software: bool, timer: bool) = interrupt_inputs(self, software, timer)
