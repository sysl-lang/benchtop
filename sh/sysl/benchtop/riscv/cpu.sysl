module sh.sysl.benchtop.riscv

import sysl.raw.ptr_cast

// Little-endian RV32 interpreter. The caller gives a hart a window of RAM, at an address it chooses,
// and a bus for every other address; a board puts its devices on the bus, and the chip's
// integration facts in a `Chip`. `run` is the reference interpreter: it decodes every step, with no
// cache. `run_threaded` (threaded.sysl) runs the same steps through a decode cache.
// Unsupported encodings and accesses stop before retirement, with PC and destination preserved.
// Spec: https://docs.riscv.org/reference/isa/v20260120/unpriv/rv32.html

enum Stop
    Budget = 0
    Breakpoint
    Ecall
    Undefined
    Misaligned
    Unmapped
    AccessFault
    Sleep
    // The guest asked the board to end, with `exit_code`.
    Exit

/** What an access is for: it selects the PMP permission and the cause of a fault it takes. */
enum Access
    Fetch = 0
    Load
    Store

/** A hart's way to everything that is not its RAM window: the board's devices. An access nothing
 * answers calls `halt(cpu, Stop.Unmapped, a)`. `n` is the hart's retired-instruction count.
 */
trait Bus
    read(*self, cpu: *Cpu, a: u32, width: u32, n: u64) -> u32
    write(*self, cpu: *Cpu, a: u32, width: u32, x: u32, n: u64)

// A bus with nothing on it: every access off the RAM stops the hart.
struct NoDevices
end NoDevices

impl Bus for NoDevices
    read(*self, cpu: *Cpu, a: u32, width: u32, n: u64) -> u32
        halt(cpu, Stop.Unmapped, a)
        0

    write(*self, cpu: *Cpu, a: u32, width: u32, x: u32, n: u64) = halt(cpu, Stop.Unmapped, a)

/** The bus `reset` gives a hart: nothing is on it. */
var nothing_attached = NoDevices()

struct Cpu
    model: Model
    chip: Chip
    r: [32]u32
    pc: u32
    retired: u64
    stop: Stop
    stop_at: u32
    exit_code: u32
    // What the access that stopped the hart was for; it selects the trap cause.
    fault_access: Access
    ram: []u8
    base: u32
    bus: *Bus
    cs: Machine
    peer: *Cpu
    hart: u32
    reserved: bool
    reservation: u32
    event: bool
    sleep_kind: u32
    halt_faults: bool
    halt_breakpoint: bool
    // The encoding the interpreter last fetched; the threaded executor's own records do not set it.
    instruction: u32
    // The decode cache `run_threaded` uses (`use_code_cache`): its records, one per halfword of the
    // RAM window and one past it, `dec` the first of them or null while there is none; the marks of
    // the 64-byte lines holding decoded code; and the retired count at which the cache hands back.
    code: []Insn
    code_lines: []u8
    dec: *Insn
    limit: u64

/** Reset the hart onto `ram` at `base`, starting at `entry`. A decode cache it has stays, forgotten,
 * where it still covers the new window; otherwise the hart has none.
 */
reset(cpu: *Cpu, model: Model, chip: Chip, ram: []u8, base: u32, entry: u32)
    if cpu.peer != null then unpair(cpu)
    cpu.model = model
    cpu.chip = chip
    for i in 0..<32 do cpu.r[i] = 0
    cpu.pc = entry
    cpu.retired = 0
    cpu.stop = if implemented(model) then Stop.Budget else Stop.Undefined
    cpu.stop_at = entry
    cpu.exit_code = 0
    cpu.fault_access = Access.Fetch
    cpu.ram = ram
    cpu.base = base
    cpu.bus = &nothing_attached
    if cpu.dec != null && !covers(cpu, cpu.code, cpu.code_lines) then detach_code(cpu)
    reset_machine(cpu)

/** Stop the hart at `at` for `why`: what a bus does with an access it cannot answer. */
halt(cpu: *Cpu, why: Stop, at: u32)
    cpu.stop = why
    cpu.stop_at = at

private[riscv] fail(cpu: *Cpu, why: Stop, at: u32) = halt(cpu, why, at)

private[riscv] fault(cpu: *Cpu, why: Stop, at: u32, access: Access)
    halt(cpu, why, at)
    cpu.fault_access = access

/** A guest load of `width` (1, 2 or 4) bytes at `address`, as an instruction makes it. */
read(cpu: *Cpu, address: u32, width: u32) -> u32
    if width != 1 && width != 2 && width != 4
        fail(cpu, Stop.Unmapped, address)
        return 0
    load(cpu, address, width, Access.Load)

/** A guest store of `width` (1, 2 or 4) bytes at `address`, as an instruction makes it. */
write(cpu: *Cpu, address: u32, width: u32, value: u32)
    if width != 1 && width != 2 && width != 4
        fail(cpu, Stop.Unmapped, address)
        return
    store(cpu, address, width, value)

// The RAM window's offset of an access, or -1 where any byte of it is outside the window.
@inline
private[riscv] window(cpu: *Cpu, address: u32, width: u32) -> i64
    val offset = address - cpu.base
    if u64(offset) + u64(width) > u64(cpu.ram.len) then return -1
    i64(offset)

@inline
private[riscv] ram_load(cpu: *Cpu, offset: usize, width: u32) -> u32
    val at = usize(&cpu.ram[offset])
    width match
        4 ->
            val p: *u32 = ptr_cast(at)
            *p
        2 ->
            val p: *u16 = ptr_cast(at)
            u32(*p)
        _ -> u32(cpu.ram[offset])

@inline
private[riscv] ram_store(cpu: *Cpu, offset: usize, width: u32, value: u32)
    val at = usize(&cpu.ram[offset])
    width match
        4 ->
            val p: *u32 = ptr_cast(at)
            *p = value
        2 ->
            val p: *u16 = ptr_cast(at)
            *p = u16(value)
        _ -> cpu.ram[offset] = u8(value)

// An aligned access the PMP allows reaches the RAM window, or else the bus. An access that stops the
// hart answers 0 and changes nothing.
private[riscv] load(cpu: *Cpu, address: u32, width: u32, access: Access) -> u32
    if (address & (width - 1)) != 0
        fault(cpu, Stop.Misaligned, address, access)
        return 0
    if !pmp_allows(cpu, address, width, access)
        fault(cpu, Stop.AccessFault, address, access)
        return 0
    val offset = window(cpu, address, width)
    if offset >= 0 then return ram_load(cpu, usize(offset), width)
    cpu.fault_access = access
    cpu.bus.read(cpu, address, width, cpu.retired)

private[riscv] store(cpu: *Cpu, address: u32, width: u32, value: u32)
    if (address & (width - 1)) != 0
        fault(cpu, Stop.Misaligned, address, Access.Store)
        return
    if !pmp_allows(cpu, address, width, Access.Store)
        fault(cpu, Stop.AccessFault, address, Access.Store)
        return
    invalidate(cpu, address, width)
    val offset = window(cpu, address, width)
    if offset >= 0
        ram_store(cpu, usize(offset), width, value)
        code_written(cpu, u32(offset), width)
        return
    cpu.fault_access = Access.Store
    cpu.bus.write(cpu, address, width, value, cpu.retired)

/** Another master's store (a DMA, a debugger) into the RAM window; false where it is not all there. */
external_write(cpu: *Cpu, address: u32, width: u32, value: u32) -> bool
    if width != 1 && width != 2 && width != 4 then return false
    val offset = window(cpu, address, width)
    if (address & (width - 1)) != 0 || offset < 0 then return false
    val own = cpu.reserved && reservation_tag(cpu, address) == cpu.reservation
    ram_store(cpu, usize(offset), width, value)
    invalidate(cpu, address, width)
    code_written(cpu, u32(offset), width)
    if own
        cpu.reserved = false
        notify_unblock(cpu)
    true

private[riscv] sext(value: u32, bits: u32) -> u32 = u32(i32(value << (32 - bits)) >> (32 - bits))

// The offsets JAL, a branch and a store carry, sign-extended.
private[riscv] jal_offset(insn: u32) -> u32 =
    sext(((insn >> 31) << 20) | (((insn >> 12) & 255) << 12) | (((insn >> 20) & 1) << 11) | (((insn >> 21) & 1023) << 1), 21)
private[riscv] branch_offset(insn: u32) -> u32 =
    sext(((insn >> 31) << 12) | (((insn >> 7) & 1) << 11) | (((insn >> 25) & 63) << 5) | (((insn >> 8) & 15) << 1), 13)
private[riscv] store_offset(insn: u32) -> u32 = sext(((insn >> 25) << 5) | ((insn >> 7) & 31), 12)

private[riscv] branch(op: u32, a: u32, b: u32) -> bool = op match
    0 -> a == b
    1 -> a != b
    4 -> i32(a) < i32(b)
    5 -> i32(a) >= i32(b)
    6 -> a < b
    7 -> a >= b
    _ -> false

// The M extension's eight operations, shared by every profile that enables it. Wide signed
// division also handles INT_MIN/-1 without invoking the host's overflow behaviour.
private multiply(op: u32, a: u32, b: u32) -> u32 = op match
    0 -> a * b
    1 -> u32(u64(i64(i32(a)) * i64(i32(b))) >> 32)
    2 -> u32(u64(i64(i32(a)) * i64(b)) >> 32)
    3 -> u32((u64(a) * u64(b)) >> 32)
    4 -> if b == 0 then 0xFFFFFFFF else u32(i64(i32(a)) / i64(i32(b)))
    5 -> if b == 0 then 0xFFFFFFFF else a / b
    6 -> if b == 0 then a else u32(i64(i32(a)) % i64(i32(b)))
    _ -> if b == 0 then a else a % b

// The low bits a PC must have clear: halfword alignment with C, word alignment without.
@inline
private[riscv] ialign_mask(cpu: *Cpu) -> u32 = if has(cpu.model, EXT_C) then 1 else 3

// The one way an instruction retires: a target off the instruction alignment stops it (nothing is
// written), else `rd` takes `value` (x0 never does), the PC moves on and the count goes up. Answers
// whether it retired.
private[riscv] retire(cpu: *Cpu, next: u32, rd: u32, value: u32) -> bool
    if (next & ialign_mask(cpu)) != 0
        fault(cpu, Stop.Misaligned, next, Access.Fetch)
        return false
    if rd != 0 then cpu.r[rd] = value
    cpu.pc = next
    cpu.retired += 1
    true

// Retire, then sleep: WFI and h3.block retire before the hart stops.
private retire_to_sleep(cpu: *Cpu, next: u32, kind: u32)
    if !retire(cpu, next, 0, 0) then return
    cpu.sleep_kind = kind
    cpu.stop = Stop.Sleep

// User mode with mstatus.TW set may not wait: WFI and h3.block are illegal there.
private waits_trapped(cpu: *Cpu) -> bool = cpu.cs.privilege == PRIV_USER && (cpu.cs.mstatus & MSTATUS_TW) != 0

// h3.block and h3.unblock (Xh3power), slt hints with rd = x0.
private execute_power(cpu: *Cpu, insn: u32, next: u32)
    if waits_trapped(cpu)
        fail(cpu, Stop.Undefined, cpu.pc)
        return
    if insn == H3_UNBLOCK
        send_unblock(cpu)
        retire(cpu, next, 0, 0)
    elif cpu.event
        cpu.event = false
        retire(cpu, next, 0, 0)
    elif pending_bits(cpu) & cpu.cs.mie == 0
        retire_to_sleep(cpu, next, SLEEP_BLOCK)
    else
        retire(cpu, next, 0, 0)

// ECALL, EBREAK, MRET and WFI.
private execute_system(cpu: *Cpu, insn: u32, next: u32)
    val privileged = has(cpu.model, EXT_PRIV)
    if insn == EBREAK then fail(cpu, Stop.Breakpoint, cpu.pc)
    elif insn == ECALL then fail(cpu, Stop.Ecall, cpu.pc)
    elif insn == MRET && privileged && cpu.cs.privilege == PRIV_MACHINE then retire(cpu, return_from_trap(cpu), 0, 0)
    elif insn == WFI && privileged && !waits_trapped(cpu)
        if pending_bits(cpu) & cpu.cs.mie == 0 then retire_to_sleep(cpu, next, SLEEP_WFI) else retire(cpu, next, 0, 0)
    else fail(cpu, Stop.Undefined, cpu.pc)

// Execute a canonical 32-bit instruction. Compressed encodings expand into this same path. Decoding
// and validation finish before anything is committed, through `retire`; a load or store that stops
// the hart is the only side effect before it, and it leaves `rd` and the PC alone.
private execute(cpu: *Cpu, insn: u32, length: u32)
    val rd = (insn >> 7) & 31
    val rs1 = (insn >> 15) & 31
    val rs2 = (insn >> 20) & 31
    val a = cpu.r[rs1]
    val b = cpu.r[rs2]
    val op = (insn >> 12) & 7
    val imm = sext(insn >> 20, 12)
    val next = cpu.pc + length

    if (insn == H3_BLOCK || insn == H3_UNBLOCK) && has(cpu.model, EXT_H3POWER)
        execute_power(cpu, insn, next)
        return

    var target = next
    var result: u32 = 0
    var put = true
    var valid = true

    (insn & 127) match
        0x37 -> result = insn & 0xFFFFF000
        0x17 -> result = cpu.pc + (insn & 0xFFFFF000)
        0x6F ->
            result = next
            target = cpu.pc + jal_offset(insn)
        0x67 ->
            valid = op == 0
            result = next
            target = (a + imm) & ~1u32
        0x63 ->
            put = false
            valid = op != 2 && op != 3
            if valid && branch(op, a, b) then target = cpu.pc + branch_offset(insn)
        0x03 ->
            valid = op == 0 || op == 1 || op == 2 || op == 4 || op == 5
            if valid
                result = load(cpu, a + imm, 1u32 << (op & 3), Access.Load)
                if op < 2 then result = sext(result, 8u32 << op)
        0x23 ->
            put = false
            valid = op <= 2
            if valid then store(cpu, a + store_offset(insn), 1u32 << op, b)
        0x0B ->
            valid = has(cpu.model, EXT_H3BEXTM) && (insn & 0xE2000000) == 0 && (op == 0 || op == 4)
            if valid
                val shift = (if op == 0 then b else rs2) & 31
                val bits = ((insn >> 26) & 7) + 1
                result = (a >> shift) & ((1u32 << bits) - 1)
        0x2F ->
            atomic_operation(cpu, insn, a, b) match
                Some(value) -> result = value
                None -> valid = false
        0x13 | 0x33 ->
            // The base/M and bit-manipulation encodings are disjoint, so the common one is tried first.
            alu_operation(cpu, insn, a, b) match
                Some(value) -> result = value
                None ->
                    val bit_result = if has(cpu.model, EXT_B) then bit_operation(insn, a, b) else None
                    if bit_result.is_some() then result = bit_result.unwrap() else valid = false
        0x0F ->
            put = false
            valid = op == 0 || (op == 1 && has(cpu.model, EXT_IFENCE))
        0x73 ->
            if op == 0
                execute_system(cpu, insn, next)
                return
            val source = if (op & 4) != 0 then rs1 else a
            val writing = (op & 3) == 1 || rs1 != 0
            val reading = (op & 3) != 1 || rd != 0
            csr_access(cpu, insn >> 20, op & 3, source, reading, writing) match
                Some(value) -> result = value
                None -> valid = false
        _ -> valid = false

    if !valid then fail(cpu, Stop.Undefined, cpu.pc)
    if cpu.stop != Stop.Budget then return
    retire(cpu, target, if put then rd else 0, result)

// Shared base/M ALU semantics are unchanged; extensions only add validated encodings.
private alu_operation(cpu: *Cpu, insn: u32, a: u32, b: u32) -> Option[u32]
    val immediate = (insn & 127) == 0x13
    alu_key(cpu, insn) match
        Some(k) -> Some(alu_apply(k, a, if immediate then sext(insn >> 20, 12) else b))
        None -> None

// The base or M operation an OP or OP-IMM encoding is, as a key for `alu_apply`: funct3, plus 8 for
// SUB and SRA(I), plus 16 for M; None where it is neither (it may still be a bit-manipulation one).
private[riscv] alu_key(cpu: *Cpu, insn: u32) -> Option[u32]
    val op = (insn >> 12) & 7
    val top = insn >> 25
    val immediate = (insn & 127) == 0x13
    if !immediate && top == 1 then return if has(cpu.model, EXT_M) then Some(16 | op) else None
    val valid = op match
        0 -> immediate || top == 0 || top == 32
        1 -> top == 0
        5 -> top == 0 || top == 32
        _ -> immediate || top == 0
    if !valid then return None
    Some(op | (if top == 32 && (op == 5 || !immediate) then 8 else 0))

// The operation `alu_key` names, on `a` and the second operand `b` (rs2 or the immediate).
@inline
private[riscv] alu_apply(k: u32, a: u32, b: u32) -> u32
    if k >= 16 then return multiply(k & 7, a, b)
    val shift = b & 31
    k match
        0 -> a + b
        8 -> a - b
        1 -> a << shift
        2 -> if i32(a) < i32(b) then 1 else 0
        3 -> if a < b then 1 else 0
        4 -> a ^ b
        5 -> a >> shift
        13 -> u32(i32(a) >> shift)
        6 -> a | b
        _ -> a & b

/** Run up to `budget` steps: an instruction, or an interrupt taken in its place. A hart that has
 * stopped stays stopped; one asleep wakes when an enabled interrupt is pending, or, after
 * h3.block, on an event.
 */
run(cpu: *Cpu, budget: u64)
    if !wake(cpu, budget) then return
    // Without the privileged architecture there are no CSRs, no counters, no traps: a stop ends the run.
    val privileged = has(cpu.model, EXT_PRIV)
    var left = budget
    while left != 0 && cpu.stop == Stop.Budget
        left -= 1
        if privileged then step_privileged(cpu) else step(cpu)

// Whether a run of `budget` may take a step: a hart asleep wakes as `run` says; a stopped one stays.
private[riscv] wake(cpu: *Cpu, budget: u64) -> bool
    if budget == 0 then return false
    if cpu.stop == Stop.Sleep
        if pending_bits(cpu) & cpu.cs.mie == 0 && !(cpu.sleep_kind == SLEEP_BLOCK && cpu.event) then return false
        if cpu.sleep_kind == SLEEP_BLOCK then cpu.event = false
        cpu.stop = Stop.Budget
    cpu.stop == Stop.Budget

// One step of a hart with the privileged architecture: the cycle count, an interrupt taken in place
// of an instruction, or an instruction, counted, with a fault it takes turned into its trap.
private[riscv] step_privileged(cpu: *Cpu)
    val s = &cpu.cs
    if (s.inhibit & INHIBIT_CY) == 0 then s.cycle += 1
    // The interrupt test is two loads and an AND: the external line is cached when it changes.
    if (s.mip | s.meip) & s.mie != 0 && take_interrupt(cpu) then return
    val before = cpu.retired
    val counting = (s.inhibit & INHIBIT_IR) == 0
    s.wrote_instret = false
    step(cpu)
    if cpu.retired != before && counting && !s.wrote_instret then s.instret += 1
    if cpu.stop != Stop.Budget then resolve_fault(cpu)

private[riscv] step(cpu: *Cpu)
    val pc = cpu.pc
    if (pc & ialign_mask(cpu)) != 0
        fault(cpu, Stop.Misaligned, pc, Access.Fetch)
        return
    val lo = load(cpu, pc, 2, Access.Fetch)
    if cpu.stop != Stop.Budget then return
    cpu.instruction = lo
    if (lo & 3) != 3
        if !has(cpu.model, EXT_C)
            fail(cpu, Stop.Undefined, pc)
            return
        if has(cpu.model, EXT_ZC) && execute_zcmp(cpu, lo) then return
        var expanded = decompress(lo)
        if expanded == 0 && has(cpu.model, EXT_ZC) then expanded = decompress_extra(lo)
        if expanded == 0
            fail(cpu, Stop.Undefined, pc)
            return
        execute(cpu, expanded, 2)
    else
        val hi = load(cpu, pc + 2, 2, Access.Fetch)
        if cpu.stop != Stop.Budget then return
        // A 32-bit instruction must fit a single winning PMP region, even with C.
        if !pmp_allows(cpu, pc, 4, Access.Fetch)
            fault(cpu, Stop.AccessFault, pc, Access.Fetch)
            return
        cpu.instruction = lo | (hi << 16)
        execute(cpu, cpu.instruction, 4)
