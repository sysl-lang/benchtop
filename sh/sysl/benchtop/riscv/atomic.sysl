module sh.sysl.benchtop.riscv

// Sequential harts: the indivisible memory transaction finishes before the scheduler can
// switch harts. aq/rl are therefore already satisfied. pair() shares reservation invalidation.
private[riscv] atomic_operation(cpu: *Cpu, code: u32, address: u32, value: u32) -> Option[u32]
    if !has(cpu.model, EXT_A) || ((code >> 12) & 7) != 2 then return None
    val op = code >> 27
    val rs2 = (code >> 20) & 31
    if op != 0 && op != 1 && op != 2 && op != 3 && op != 4 && op != 8 && op != 12 && op != 16 && op != 20 && op != 24 && op != 28 then return None
    if op == 2 && rs2 != 0 then return None
    cpu.access = if op == 2 then 1 else 2
    if !accessible(cpu, address, 4) then return Some(0)
    if !pmp_allows(cpu, address, 4, cpu.access) || (op != 3 && !pmp_allows(cpu, address, 4, 1))
        fail(cpu, Stop.AccessFault, address)
        return Some(0)
    if op == 3
        val success = cpu.reserved && cpu.reservation == reservation_tag(cpu, address)
        cpu.reserved = false
        if success then write(cpu, address, 4, value)
        return Some(if success then 0 else 1)
    val old = read(cpu, address, 4)
    if op == 2
        cpu.reserved = true
        cpu.reservation = reservation_tag(cpu, address)
        return Some(old)
    val result = op match
        0 -> old + value
        1 -> value
        4 -> old ^ value
        8 -> old | value
        12 -> old & value
        16 -> if i32(old) < i32(value) then old else value
        20 -> if i32(old) > i32(value) then old else value
        24 -> if old < value then old else value
        _ -> if old > value then old else value
    cpu.reserved = false
    write(cpu, address, 4, result)
    Some(old)
