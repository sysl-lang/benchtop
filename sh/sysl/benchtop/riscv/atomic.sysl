module sh.sysl.benchtop.riscv

// Sequential harts: the indivisible memory transaction finishes before the scheduler can
// switch harts. aq/rl are therefore already satisfied. pair() shares reservation invalidation.
private[riscv] atomic_operation(cpu: *Cpu, code: u32, address: u32, value: u32) -> Option[u32]
    if !has(cpu.model, EXT_A) || ((code >> 12) & 7) != 2 then return None
    val op = code >> 27
    val rs2 = (code >> 20) & 31
    if op != 0 && op != 1 && op != 2 && op != 3 && op != 4 && op != 8 && op != 12 && op != 16 && op != 20 && op != 24 && op != 28 then return None
    if op == 2 && rs2 != 0 then return None
    // LR is a load; SC and the AMOs are stores, and an AMO needs read permission as well.
    val access = if op == 2 then Access.Load else Access.Store
    if (address & 3) != 0
        fault(cpu, Stop.Misaligned, address, access)
        return Some(0)
    // The exclusive monitor covers the RAM window only: an atomic anywhere else, a failed SC
    // included, is an access fault and never reaches the bus.
    if window(cpu, address, 4) < 0
        fault(cpu, Stop.Unmapped, address, access)
        return Some(0)
    if !pmp_allows(cpu, address, 4, access) || (op != 3 && !pmp_allows(cpu, address, 4, Access.Load))
        fault(cpu, Stop.AccessFault, address, access)
        return Some(0)
    if op == 3
        val success = cpu.reserved && cpu.reservation == reservation_tag(cpu, address)
        cpu.reserved = false
        if success then store(cpu, address, 4, value)
        return Some(if success then 0 else 1)
    val old = load(cpu, address, 4, Access.Load)
    if op == 2
        cpu.reserved = true
        cpu.reservation = reservation_tag(cpu, address)
        return Some(old)
    val result = op match
        0 -> old + value
        1 -> value
        4 -> old ^ value
        8 -> old | value
        12 -> old & value
        16 -> if i32(old) < i32(value) then old else value
        20 -> if i32(old) > i32(value) then old else value
        24 -> if old < value then old else value
        _ -> if old > value then old else value
    cpu.reserved = false
    store(cpu, address, 4, result)
    Some(old)
