module sh.sysl.benchtop
@tests

import sh.sysl.parsing.source_of
import sysl.raw.str_cast
import sysl.text.replace_all

private val TFT_BOARD = str_cast(embed("../../../boards/workbench.hocon"))

@test("ST7789 TFT: catalog dimensions and offsets validate, SPI inputs share pins and exclusive connections still reject conflicts")
tft_schema()
    val src = source_of("tft.hocon", TFT_BOARD)
    val got = load(src, library())
    assert(!got.report.has_errors(), got.report.render(src))
    val p = got.description.board.parts.at(9)
    assert(p.kind == "st7789" && p.reference == "DS4" && p.wires.len() == 5)
    val written = description_text(got.description)
    val again = load(source_of("again.hocon", written), library())
    assert(!again.report.has_errors() && description_text(again.description) == written)
    val offset = source_of("offset.hocon", replace_all(TFT_BOARD, "ref = DS4, width = 240", "ref = DS4, row-offset = 80, width = 240"))
    assert(!load(offset, library()).report.has_errors())
    for pair in [
        ("ref = DS4, width = 240", "ref = DS4, width = 241"),
        ("ref = DS4, width = 240", "ref = DS4, row-offset = 81, width = 240"),
        ("ref = DS4", "ref = DS3"),
        ("cs = GP30", "cs = GP32"),
        ("cs = GP30,", ""),
        ("cs = GP30", "cs = GP0")]
        val bad = source_of("bad.hocon", replace_all(TFT_BOARD, pair.0, pair.1))
        assert(load(bad, library()).report.has_errors(), pair.1)

@test("ST7789 TFT: products can fan out exposed board inputs while exclusive consumers still conflict")
product_inputs()
    var shelf = built_in_shelf()
    val board = replace_all(TFT_BOARD, "  input {", "  exposes { pins = [GP6, GP7, GP29, GP30, GP31] }\n  input {")
    shelf.bundled.push(("shared-display-board", board))
    val text = "product { name = shared, boards { controller { board = shared-display-board } }, parts { extra { part = st7789, wire { sck = controller.GP6, mosi = controller.GP7, reset = controller.GP29, cs = controller.GP30, dc = controller.GP31 } } } }"
    val src = source_of("product.hocon", text)
    val got = load(src, library(), shelf)
    assert(!got.report.has_errors(), got.report.render(src))
    val conflict = source_of("conflict.hocon", replace_all(text, "extra { part = st7789,", "load { part = led, wire { anode = controller.GP6 } }, extra { part = st7789,"))
    assert(load(conflict, library(), shelf).report.has_errors())
