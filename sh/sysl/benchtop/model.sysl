module sh.sysl.benchtop

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// A description, as it says its boards are wired and how they appear.
//
// **Three levels.** A *chip* (the RP2040, the RP2350, the virtual `virt`) is what is inside the
// package: its cores, its pins, and its peripherals, everything on the cores' bus. A *board* is a chip
// with the parts soldered beside it, the pins and buses it exposes to whatever it is plugged into, and
// a view of itself. A *product* is one or more boards, each an instance with a name of its own, the
// parts outside them wired to the pins and buses they expose (`pico.GP15`), and a view of the whole.
// A chip and a board are each named or written out; a description file is one chip, one board or one
// product.
//
// **This is the typed model a description reads into, and nothing in it behaves.** A part is a name,
// the library part it is an instance of, its parameters and its wires; what an LED *does* when its
// pin goes high is the part library's business. The model is what the checker validates, what
// `benchtop check` prints, and what the emulator builds its machine from.
//
// **Every name and value keeps the span it was read from**, so a diagnostic about a part, a wire or
// an element points at the line that wrote it. The spans are not part of what a board *is*: two
// models are the same when `description_text` writes them identically.

/** Which of the three things a description file is. */
enum Form
    NoForm
    ChipForm
    BoardForm
    ProductForm
end Form

/** A description file read: a chip, a board or a product. A chip or a board named rather than
 * written out (`board = pico2w`) keeps the name in `named`, and `chip` or `board` is what it names.
 */
struct Description
    form: Form
    chip: Chip
    board: Board
    named: string
    named_span: Span
    product: Product

/** A chip: its cores, its pins by bank, and its peripherals, everything the cores reach by address. */
struct Chip
    name: string
    summary: string
    clock_hz: Option[Amount]
    cores: Buf[Core]
    cores_span: Span
    banks: Buf[Bank]
    peripherals: Buf[Peripheral]
    span: Span

/** A bank of pins: `GP = 30` is `GP0` to `GP29`. */
struct Bank
    prefix: string
    count: int
    span: Span

/** One peripheral on the cores' bus: `uart0 { peripheral = pl011, at = 0x40034000, irq = 20,
 * signals { tx = [GP0, GP12] } }`. An ADC lists its `channels`.
 */
struct Peripheral
    name: string
    name_span: Span
    kind: string
    kind_span: Span
    params: Buf[Param]
    at: Option[Amount]
    size: Option[Amount]
    irqs: Buf[Amount]
    irq_span: Span
    signals: Buf[Route]
    channels: Buf[PinRef]

/** A signal of a peripheral and the pins it can be routed to. */
struct Route
    name: string
    name_span: Span
    pins: Buf[PinRef]

/** A pin as a description writes it, where it wrote it. */
struct PinRef
    name: string
    span: Span

/** A board: its chip, named (`mcu = rp2040`) or written out, with `chip_named` the name and `chip`
 * the chip itself once found; its parts; what it exposes; and its view.
 */
struct Board
    name: string
    chip_named: string
    chip_span: Span
    chip: Chip
    has_chip: bool
    chip_found: bool
    parts: Buf[Part]
    buses: Buf[Bus]
    exposed_pins: Buf[Exposed]
    exposed_buses: Buf[Exposed]
    exposes_span: Span
    view: View
    keys: Buf[KeyBinding]
    pointers: Buf[PointerBinding]

/** A product: its boards, the parts outside them, the buses those parts use, and its view. */
struct Product
    name: string
    boards: Buf[Instance]
    boards_span: Span
    parts: Buf[Part]
    buses: Buf[Bus]
    view: View
    keys: Buf[KeyBinding]
    pointers: Buf[PointerBinding]

/** One board in a product: `pico { board = pico, parts.led.color = red }`. `of` is the board as the
 * file names it, a board built into benchtop or a file's path; `board` is that board once it is found,
 * with the overrides applied, and `found` says whether it was.
 */
struct Instance
    name: string
    name_span: Span
    of: string
    of_span: Span
    overrides: Buf[Override]
    board: Board
    found: bool

/** A parameter of one of a board's parts, set by the product it is in: `parts.led.color = red`. */
struct Override
    part: string
    part_span: Span
    param: Param

/** A pin or a bus a board exposes, by its name on the chip: `GP15`, `spi0`. */
struct Exposed
    name: string
    span: Span

/** One of a chip's cores, by the registry's name for it: `cortex-m0plus`. */
struct Core
    name: string
    span: Span
    options: Buf[Param]
    configured: bool
    extent: Span

/** One part instantiated from the library: `d1 { part = led, ref = D1, color = red, wire { anode = GP16 } }`.
 * A part is off the cores' bus; `at`, `size` and `irq` are kept only so that the checker can say they
 * belong to a peripheral.
 */
struct Part
    reference: string
    reference_span: Span
    name: string
    name_span: Span
    kind: string
    kind_span: Span
    params: Buf[Param]
    wires: Buf[Wire]
    at: Option[Amount]
    size: Option[Amount]
    irq: Option[Amount]

/** A whole number a peripheral's place on the bus is written in, with the text it was written as, so a
 * board is written back as it was read: `0x40000000`, `1M`, `7`.
 */
struct Amount
    n: long
    written: string
    name_span: Span
    span: Span

/** A parameter as the file wrote it. Its type is the literal's; the checker holds it to the part's. */
struct Param
    name: string
    name_span: Span
    value: Setting
    span: Span

enum Setting
    Whole(n: long)
    Number(x: real)
    Text(s: string)
    Flag(on: bool)
end Setting

/** One of a part's ports wired to something. */
struct Wire
    port: string
    port_span: Span
    to: Target
    span: Span

/** What a port is wired to: a pin of the board's own chip, written bare (`GP16`), one of the chip's
 * buses (`spi0`), or a dotted name, which is a port another part offers (`wifi.gpio0`) or, in a
 * product, a pin or bus a board exposes (`pico.GP15`).
 */
enum Target
    Pin(name: string)
    Bus(name: string)
    Port(part: string, port: string)
end Target

/** One of the chip's buses, with the pin each of its signals is routed to. In a product, `board` is
 * the instance whose chip it is.
 */
struct Bus
    board: string
    board_span: Span
    name: string
    name_span: Span
    signals: Buf[Signal]

struct Signal
    name: string
    name_span: Span
    pin: string
    span: Span

/** The window's drawing of a board or a product. Units are host pixels at 1×. */
struct View
    width: int
    height: int
    background: string
    elements: Buf[Element]
    span: Span

/** What an element draws: a part (which knows its own look), a caption, a filled rectangle, or, in a
 * product's view, one of its boards whole. The file writes a board as it writes a part, `show =
 * pico`; the checker tells the two apart.
 */
enum Shows
    ShowPart(name: string)
    ShowBoard(name: string)
    Caption(text: string)
    Fill(color: string)
end Shows

/** One visible thing in the view. `has_size` is false where the file gave no size; the checker fills
 * in a screen's from its part's glass and marks it `natural`, which is a size the file did not write.
 */
struct Element
    name: string
    name_span: Span
    shows: Shows
    shows_span: Span
    x: int
    y: int
    w: int
    h: int
    has_size: bool
    natural: bool
    label: string
    look: Buf[Param]
    span: Span

/** A host key driving one of a part's controls: `up = joystick.up`. */
struct KeyBinding
    key: string
    key_span: Span
    part: string
    control: string
    span: Span

/** The mouse on an element of the view driving a part that takes a point: `screen = touch`. */
struct PointerBinding
    element: string
    element_span: Span
    part: string
    span: Span

private nowhere() -> Span = Span(0, 0)

private empty_view() -> View = View(0, 0, "", buf(), nowhere())

/** The empty chip. */
empty_chip() -> Chip = Chip("", "", None, buf(), nowhere(), buf(), buf(), nowhere())

/** The empty board. */
empty_board() -> Board =
    Board("", "", nowhere(), empty_chip(), false, false, buf(), buf(), buf(), buf(), nowhere(), empty_view(), buf(), buf())

/** The empty product. */
empty_product() -> Product = Product("", buf(), nowhere(), buf(), buf(), empty_view(), buf(), buf())

/** The description an empty file is: neither a chip, a board nor a product. */
empty_description() -> Description = Description(NoForm, empty_chip(), empty_board(), "", nowhere(), empty_product())

/** A peripheral by name, or `None`. */
peripheral_named(ps: Buf[Peripheral], name: string) -> Option[Peripheral]
    for p in ps
        if p.name == name then return Some(p)

    None
end peripheral_named

/** A part by name, or `None`. */
part_named(parts: Buf[Part], name: string) -> Option[Part]
    for p in parts
        if p.name == name then return Some(p)

    None
end part_named

/** A parameter by name, or `None`. */
param_named(params: Buf[Param], name: string) -> Option[Param]
    for p in params
        if p.name == name then return Some(p)

    None
end param_named

/** A board instance of a product by name, or `None`. */
instance_named(p: Product, name: string) -> Option[Instance]
    for i in p.boards
        if i.name == name then return Some(i)

    None
end instance_named

/** A pin's bank and number, `("GP", 16)` for `GP16`, or `None` for text that is not a pin's name. A
 * pin is spelled as one or more capital letters and then digits, so `GP16` and `PA0` are pins and
 * `spi0`, a bus, is not.
 */
pin_parts(t: string) -> Option[(string, int)]
    var i: usize = 0

    while i < t.bytes.len && t.bytes[i] >= u8('A') && t.bytes[i] <= u8('Z') do i += 1

    if i == 0 || i == t.bytes.len then return None

    var n = 0

    for k in i..<t.bytes.len
        val c = t.bytes[k]

        if !c.is_digit() || n > 100000 then return None

        n = n * 10 + int(c - u8('0'))
    end for

    Some((t[0..<i], n))
end pin_parts

/** Whether text is spelled as a pin. */
is_pin_name(t: string) -> bool = pin_parts(t).is_some()

/** A target as a description writes it. */
target_text(t: Target) -> string
    t match
        Pin(name) -> name
        Bus(name) -> name
        Port(part, port) -> s"$part.$port"
end target_text

/** A setting as a description writes it, and as a message quotes it. */
setting_text(s: Setting) -> string
    s match
        Whole(n) -> n.to_string()
        Number(x) -> x.to_string()
        Text(t) -> t
        Flag(on) -> if on then "true" else "false"
end setting_text

/** The guest timebase: the mcu's `clock-hz`, or `fallback` where the description gives none. */
mcu_clock_hz(c: Chip, fallback: u64 = 12000000) -> u64 = c.clock_hz match
    Some(hz) -> u64(hz.n)
    None -> fallback
