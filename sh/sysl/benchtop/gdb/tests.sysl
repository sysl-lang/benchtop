module sh.sysl.benchtop.gdb
@tests

// The remote protocol's framing; then gdb's packets against a virtual board running a hand-assembled
// loop, against the RP2040's own board, and over a real loopback socket. Every test makes its own
// board.

import sh.sysl.benchtop.v6m.{Cpu, Fpu, RAM_BYTES, Stop}
import sh.sysl.benchtop.virt.{Machine, board_named, boot, capture, image_of, launch, machine, open_console}
import sh.sysl.benchtop.chip as chip
import sysl.buf.{Buf, buf}
import sysl.net.{resolve, socket}
import sysl.raw.str_cast
import sysl.text.Search

private val PICO_BLINK = embed("../../../../examples/pico/blink.elf")
private val PICO2_BLINK = embed("../../../../examples/pico2/blink.elf")

// `movs r0, #0` at 8; at 10 `adds r0, #1`; at 12 `b 10`; a `nop` at 14 that nothing reaches.
private val LOOP: [4]u16 = [0x2000, 0x3001, 0xE7FD, 0xBF00]

// A raw image of `code` at 8: the stack at the top of RAM and the reset vector to 8 before it.
private raw_image(code: []const u16) -> Buf[u8]
    var b: Buf[u8] = buf()
    push_le(&b, u64(RAM_BYTES), 4)
    push_le(&b, 9, 4)
    for h in code do push_le(&b, u64(h), 2)
    parse_bytes(b.view()).unwrap()

// The board `name` made on a machine of its own, `code` booted on it.
private booted(name: string, code: []const u16) -> &Machine
    val board = machine()
    val m = &*board
    board_named(m, name).unwrap()
    open_console(m)
    capture(m)
    val image = raw_image(code)
    boot(m, image_of(m, image.view()).unwrap().view())
    board

// What a debugger's gdb on core `k` gets back for `body`: the reply's body, with any `+` before it.
private ask[T: Target](d: *Debugger[T], k: u32, body: string) -> string
    d.receive(k, frame(body.bytes).view())
    taken(d, k)

// Every byte core `k`'s gdb has been sent since the last look, taken.
private taken[T: Target](d: *Debugger[T], k: u32) -> string
    val out = d.links[k].out
    d.links[k].out = buf()
    var text = ""
    for b in out.view() do text = text + str_cast([b][..])
    text

// A reply packet's body, its framing checked.
private body_of(sent: string) -> string
    val dollar = sent.index_of_byte(u8('$')).unwrap()
    val hash = sent.index_of_byte(u8('#')).unwrap()
    assert(hash + 3 == sent.len, sent)
    val body = sent[dollar + 1..<hash]
    assert(parse_hex(sent[hash + 1..<sent.len].bytes).unwrap() == u64(checksum(body.bytes)), sent)
    body

// Run the board until it stops, a bounded number of slices.
private until_stopped[T: Target](d: *Debugger[T])
    var n = 0
    while d.running && n < 1000
        d.advance()
        n += 1

// A debugger on `m` with gdb attached to core 0, saying it understands `swbreak` and `hwbreak`.
private attached(m: *MachineTarget) -> Debugger[MachineTarget]
    var d = debugger(m)
    assert(d.attach(0))
    assert(ask(&d, 0, "qSupported:multiprocess+;swbreak+;hwbreak+").starts_with("+$PacketSize=4000;"))
    d

private hex32(v: u32) -> string
    var out: Buf[u8] = buf()
    push_le(&out, u64(v), 4)
    str_cast(out.view())

// ---------------------------------------------------------------------------------------------------
// Framing.

@test("gdb: a packet is framed with its checksum, and #, $, } and * go escaped")
gdb_frame()
    assert(checksum("OK".bytes) == 0x9a)
    assert(frame("OK".bytes).view() == "$OK#9a".bytes)
    assert(frame("".bytes).view() == "$#00".bytes)
    val f = frame("a#b$c}d*".bytes)
    val escaped = "a}\u{3}b}\u{4}c}]d}\n"
    assert(f.view()[1..<1 + escaped.len] == escaped.bytes, str_cast(f.view()))
    assert(f.len() == escaped.len + 4 && f[escaped.len + 1] == u8('#'))
    assert(parse_hex(f.view()[escaped.len + 2..<f.len()]).unwrap() == u64(checksum(escaped.bytes)))

@test("gdb: a framed packet decodes back to its body, escapes undone, whatever it holds")
gdb_decode_round_trip()
    for body in ["OK", "a#b$c}d*", "}}", "", "m20000000,4"]
        var d = decoder()
        var got: Option[Event] = None
        for b in frame(body.bytes).view() do d.feed(b) match
            Some(e) -> got = Some(e)
            None -> ()
        got match
            Some(Packet(p)) -> assert(p.view() == body.bytes, body)
            _ -> assert(false, body)

@test("gdb: a bad or non-hex checksum is corrupt; Ctrl-C, + and - are their own events; $ restarts a packet")
gdb_decode_events()
    var d = decoder()
    var last: Option[Event] = None
    for b in "$OK#00".bytes do d.feed(b) match
        Some(e) -> last = Some(e)
        None -> ()
    assert(last.is_some() && last.unwrap() is Event.Corrupt)
    last = None
    for b in "$OK#9z".bytes do d.feed(b) match
        Some(e) -> last = Some(e)
        None -> ()
    assert(last.is_some() && last.unwrap() is Event.Corrupt)
    assert(d.feed(3).unwrap() is Event.Interrupt)
    assert(d.feed(u8('+')).unwrap() is Event.Ack)
    assert(d.feed(u8('-')).unwrap() is Event.Nak)
    last = None
    for b in "$garbage$OK#9a".bytes do d.feed(b) match
        Some(e) -> last = Some(e)
        None -> ()
    last.unwrap() match
        Packet(p) -> assert(p.view() == "OK".bytes)
        _ -> assert(false, "the restarted packet")

@test("gdb: hex fields are digits alone; register values are little-endian")
gdb_hex()
    assert(parse_hex("1f".bytes).unwrap() == 31 && parse_hex("FFFFFFFF".bytes).unwrap() == 0xFFFFFFFF)
    assert(parse_hex("".bytes).is_none() && parse_hex("-1".bytes).is_none() && parse_hex("+1".bytes).is_none())
    assert(parse_hex("g".bytes).is_none() && parse_hex("11112222333344445".bytes).is_none())
    assert(parse_le("78563412".bytes, 4).unwrap() == 0x12345678 && parse_le("785634".bytes, 4).is_none())
    assert(parse_bytes("abc".bytes).is_none() && parse_bytes("zz".bytes).is_none())
    assert(parse_bytes("00ff".bytes).unwrap().view() == [0u8, 255][..])
    assert(hex32(0xdeadbeef) == "efbeadde")

// ---------------------------------------------------------------------------------------------------
// Packets against a board.

@test("gdb: packets are acknowledged until no-ack mode; a corrupt one is asked again; an unknown one is answered empty")
gdb_acks()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    assert(ask(&d, 0, "vMustReplyEmpty") == "+$#00")
    assert(ask(&d, 0, "qWhatever") == "+$#00")
    d.receive(0, "$OK#00".bytes)
    assert(taken(&d, 0) == "-")
    assert(ask(&d, 0, "QStartNoAckMode") == "+$OK#9a")
    assert(ask(&d, 0, "qC") == "$QC1#c5")
    d.receive(0, "$OK#00".bytes)
    assert(taken(&d, 0) == "")
    // A `-` sends the last packet again.
    d.receive(0, "-".bytes)
    assert(taken(&d, 0) == "$QC1#c5")

@test("gdb: thread-less queries, the stop reason before any run, and vCont's actions")
gdb_queries()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    assert(body_of(ask(&d, 0, "?")) == "T05")
    assert(body_of(ask(&d, 0, "qAttached")) == "1")
    assert(body_of(ask(&d, 0, "qfThreadInfo")) == "m1" && body_of(ask(&d, 0, "qsThreadInfo")) == "l")
    assert(body_of(ask(&d, 0, "Hg0")) == "OK" && body_of(ask(&d, 0, "qSymbol::")) == "OK")
    assert(body_of(ask(&d, 0, "vCont?")) == "vCont;c;C;s;S;t")

@test("gdb: registers read and write back through g, G, p and P; a bad number or bad hex is E01")
gdb_registers()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    val cpu = t.core(0)
    val g = body_of(ask(&d, 0, "g"))
    // An M0+: r0–r15, xpsr, msp, psp, primask and control.
    assert(g.len == 21 * 8, g)
    assert(g[15 * 8..<16 * 8] == hex32(8) && g[13 * 8..<14 * 8] == hex32(RAM_BYTES), g)
    assert(g[16 * 8..<17 * 8] == hex32(0x01000000), g)
    assert(body_of(ask(&d, 0, s"P1=${hex32(0xcafef00d)}")) == "OK" && cpu.r[1] == 0xcafef00d)
    assert(body_of(ask(&d, 0, "p1")) == "0df0feca")
    assert(body_of(ask(&d, 0, s"Pf=${hex32(0x0b)}")) == "OK" && cpu.pc == 0x0a)
    // The flags written through xpsr, and only they.
    assert(body_of(ask(&d, 0, s"P10=${hex32(0x90000000)}")) == "OK" && body_of(ask(&d, 0, "p10")) == hex32(0x91000000))
    val all = body_of(ask(&d, 0, "g"))
    assert(body_of(ask(&d, 0, s"G$all")) == "OK" && body_of(ask(&d, 0, "g")) == all)
    assert(body_of(ask(&d, 0, "G00")) == "E01")
    assert(body_of(ask(&d, 0, "pzz")) == "E01" && body_of(ask(&d, 0, "p15")) == "E01" && body_of(ask(&d, 0, "P1=12")) == "E01")
    assert(body_of(ask(&d, 0, "P1")) == "E01")
    // msp is sp while the core runs on the main stack.
    assert(body_of(ask(&d, 0, s"P11=${hex32(0x1000)}")) == "OK" && cpu.r[13] == 0x1000)

@test("gdb: memory reads and writes go through the core; an address nothing answers, or bad hex, is E01")
gdb_memory()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    assert(body_of(ask(&d, 0, "M100,4:efbeadde")) == "OK")
    assert(body_of(ask(&d, 0, "m100,4")) == "efbeadde")
    assert(body_of(ask(&d, 0, "m101,3")) == "beadde")
    assert(body_of(ask(&d, 0, "X104,2:\u{1}\u{2}")) == "OK" && body_of(ask(&d, 0, "m104,2")) == "0102")
    assert(body_of(ask(&d, 0, "X106,0:")) == "OK")
    // The code itself, as the guest wrote it.
    assert(body_of(ask(&d, 0, "m8,4")) == "00200130")
    assert(body_of(ask(&d, 0, "mf0000000,4")) == "E01")
    assert(body_of(ask(&d, 0, "Mf0000000,4:00000000")) == "E01")
    assert(t.core(0).stop == Stop.Running)
    assert(body_of(ask(&d, 0, "mzz,4")) == "E01" && body_of(ask(&d, 0, "m100")) == "E01")
    assert(body_of(ask(&d, 0, "M100,4:efbead")) == "E01" && body_of(ask(&d, 0, "M100,4:zzzzzzzz")) == "E01")

@test("gdb: a breakpoint stops the core at its address, the instruction not run, and again each time round")
gdb_breakpoint()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    val cpu = t.core(0)
    assert(body_of(ask(&d, 0, "Z0,c,2")) == "OK")
    assert(ask(&d, 0, "c") == "+" && d.running)
    until_stopped(&d)
    assert(body_of(taken(&d, 0)) == "T05swbreak:;" && cpu.pc == 12 && cpu.r[0] == 1, s"${cpu.pc} ${cpu.r[0]}")
    // The memory holds the guest's instruction still.
    assert(body_of(ask(&d, 0, "mc,2")) == "fde7")
    ask(&d, 0, "c")
    until_stopped(&d)
    assert(body_of(taken(&d, 0)) == "T05swbreak:;" && cpu.pc == 12 && cpu.r[0] == 2)
    // A hardware one says so; taken away, the loop runs until Ctrl-C.
    assert(body_of(ask(&d, 0, "z0,c,2")) == "OK" && body_of(ask(&d, 0, "Z1,a,2")) == "OK")
    ask(&d, 0, "c")
    until_stopped(&d)
    assert(body_of(taken(&d, 0)) == "T05hwbreak:;" && cpu.pc == 10)
    assert(body_of(ask(&d, 0, "z1,a,2")) == "OK")
    ask(&d, 0, "c")
    for _ in 0..<5 do d.advance()
    assert(d.running && taken(&d, 0) == "")
    d.receive(0, [3u8][..])
    assert(body_of(taken(&d, 0)) == "T02" && !d.running && cpu.stop == Stop.Running)

@test("gdb: a breakpoint where nothing runs, of an unknown kind, or of a type benchtop does not take, is refused")
gdb_breakpoint_refused()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    assert(body_of(ask(&d, 0, "Z0,f0000000,2")) == "E01")
    assert(body_of(ask(&d, 0, "Z0,c,7")) == "E01" && body_of(ask(&d, 0, "Z0,zz,2")) == "E01")
    assert(body_of(ask(&d, 0, "Z5,100,4")) == "" && body_of(ask(&d, 0, "Z0")) == "E01")
    // Taking one away that is not there is no error.
    assert(body_of(ask(&d, 0, "z0,c,2")) == "OK")

@test("gdb: a step runs one instruction, past a breakpoint at the pc too")
gdb_step()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    val cpu = t.core(0)
    assert(body_of(ask(&d, 0, "Z0,a,2")) == "OK")
    assert(body_of(ask(&d, 0, "s")) == "T05" && cpu.pc == 10 && cpu.retired == 1)
    assert(body_of(ask(&d, 0, "s")) == "T05" && cpu.pc == 12 && cpu.r[0] == 1 && cpu.retired == 2)
    assert(body_of(ask(&d, 0, "vCont;s:1")) == "T05" && cpu.pc == 10)
    // Continuing from the breakpoint's own address runs past it, and round to it again.
    ask(&d, 0, "c")
    until_stopped(&d)
    assert(body_of(taken(&d, 0)) == "T05swbreak:;" && cpu.pc == 10 && cpu.r[0] == 2)
    // `s addr` steps from there.
    assert(body_of(ask(&d, 0, "s8")) == "T05" && cpu.pc == 10 && cpu.r[0] == 0)

// `movs r0, #0`; at 10 `adds r0, #1`; at 12 `cmp r0, #3`; at 14 `bne 10`, which the decoder fuses with
// the compare; at 16 `b 16`.
private val COUNT_TO_3: [5]u16 = [0x2000, 0x3001, 0x2803, 0xD1FC, 0xE7FE]

@test("gdb: a breakpoint on a branch fused with its compare stops at the branch, on an M0+ and an M7")
gdb_breakpoint_fused()
    for name in ["virt", "virt7"]
        val board = booted(name, COUNT_TO_3[..])
        var t = MachineTarget(&*board)
        var d = attached(&t)
        val cpu = t.core(0)
        // Run once so the pair is decoded, and fused, before the breakpoint is set.
        assert(body_of(ask(&d, 0, "Z0,10,2")) == "OK")
        ask(&d, 0, "c")
        until_stopped(&d)
        assert(body_of(taken(&d, 0)) == "T05swbreak:;" && cpu.pc == 16 && cpu.r[0] == 3, name)
        assert(body_of(ask(&d, 0, "s8")) == "T05" && body_of(ask(&d, 0, "Z0,e,2")) == "OK")
        for round in 1u32..3
            ask(&d, 0, "c")
            until_stopped(&d)
            assert(body_of(taken(&d, 0)) == "T05swbreak:;" && cpu.pc == 14 && cpu.r[0] == round, s"$name: ${cpu.pc} ${cpu.r[0]}")
        // Gone, the loop runs out to its end.
        assert(body_of(ask(&d, 0, "z0,e,2")) == "OK")
        ask(&d, 0, "c")
        until_stopped(&d)
        assert(body_of(taken(&d, 0)) == "T05swbreak:;" && cpu.pc == 16 && cpu.r[0] == 3, name)

// `movs r0, #0`; at 10 `cmp r0, #<k>`; at 12 `it eq`; at 14 `addeq r0, #1`; at 16 `adds r0, #2`; at 18
// `b 18`.
private it_block(k: u16) -> [6]u16 = [0x2000, 0x2800 | k, 0xBF08, 0x3001, 0x3002, 0xE7FE]

@test("gdb: on an M7 a breakpoint inside an IT block stops only when its condition holds, and the block runs on past it")
gdb_breakpoint_it()
    for (k, stops, total) in [(0u16, true, 3u32), (1u16, false, 2u32)]
        val code = it_block(k)
        val board = booted("virt7", code[..])
        var t = MachineTarget(&*board)
        var d = attached(&t)
        val cpu = t.core(0)
        assert(body_of(ask(&d, 0, "Z0,e,2")) == "OK" && body_of(ask(&d, 0, "Z0,12,2")) == "OK")
        ask(&d, 0, "c")
        until_stopped(&d)
        if stops
            assert(body_of(taken(&d, 0)) == "T05swbreak:;" && cpu.pc == 14 && cpu.r[0] == 0 && cpu.it != 0)
            ask(&d, 0, "c")
            until_stopped(&d)
        assert(body_of(taken(&d, 0)) == "T05swbreak:;" && cpu.pc == 18 && cpu.r[0] == total, s"$k: ${cpu.pc} ${cpu.r[0]}")

@test("gdb: a breakpoint only core 1's gdb holds does not stop core 0")
gdb_breakpoint_owned()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    assert(d.attach(1) && !d.attach(1))
    assert(body_of(ask(&d, 1, "Z0,c,2")) == "OK")
    ask(&d, 0, "c")
    for _ in 0..<5 do d.advance()
    assert(d.running && t.core(0).r[0] == 5, s"${t.core(0).r[0]}")
    d.receive(0, [3u8][..])
    assert(body_of(taken(&d, 0)) == "T02")
    // Core 1's gdb lets go: the board's breakpoint goes with its last holder.
    assert(body_of(ask(&d, 1, "D")) == "OK" && !d.links[1].attached)
    assert(t.memory().debug_break_count == 0)

// ---------------------------------------------------------------------------------------------------
// Watchpoints.

// `movs r1, #1` at 8; at 10 `lsls r1, r1, #12`, so r1 is 0x1000; at 12 `adds r0, #1`; at 14
// `str r0, [r1]`; at 16 `ldr r2, [r1, #4]`; at 18 `b 12`.
private val WATCHED: [6]u16 = [0x2101, 0x0309, 0x3001, 0x6008, 0x684A, 0xE7FB]

// The same with a byte and a halfword: at 14 `strb r0, [r1, #2]`; at 16 `strh r0, [r1, #6]`.
private val NARROW: [6]u16 = [0x2101, 0x0309, 0x3001, 0x7088, 0x80C8, 0xE7FB]

// r1 is 0xffe: at 12 `subs r1, #2`; at 14 `adds r0, #1`; at 16 `str r0, [r1]`, a word across the page
// boundary at 0x1000, which an M7 makes; at 18 `b 14`.
private val STRADDLING: [6]u16 = [0x2101, 0x0309, 0x3902, 0x3001, 0x6008, 0xE7FC]

// Core 0 runs `WATCHED`; core 1, from 32: `movs r1, #2`, `lsls r1, r1, #12`, so r1 is 0x2000; at 36
// `adds r0, #1`; at 38 `str r0, [r1]`; at 40 `b 36`.
private val TWO_CORES: [17]u16 = [0x2101, 0x0309, 0x3001, 0x6008, 0x684A, 0xE7FB, 0xBF00, 0xBF00, 0xBF00, 0xBF00, 0xBF00, 0xBF00, 0x2102, 0x0309, 0x3001, 0x6008, 0xE7FC]

// What core `k`'s gdb is told once it continues: the stop reply, or "" where the board runs on for 20
// slices, which Ctrl-C then stops.
private continued[T: Target](d: *Debugger[T], k: u32) -> string
    val first = ask(d, k, "c")
    if first.len > 1 then return body_of(first)
    var n = 0
    while d.running && n < 20
        d.advance()
        n += 1
    if !d.running then return body_of(taken(d, k))
    d.receive(k, [3u8][..])
    assert(body_of(taken(d, k)) == "T02")
    ""

// The reply core 0's gdb on a board of `name` running `code` gets for continuing with the watchpoint
// `z` set, and the core's pc then.
private first_watch(name: string, code: []const u16, z: string) -> (string, u32)
    val board = booted(name, code)
    var t = MachineTarget(&*board)
    var d = attached(&t)
    assert(body_of(ask(&d, 0, z)) == "OK", z)
    val reply = continued(&d, 0)
    (reply, t.core(0).pc)

@test("gdb: a write, read or access watchpoint stops the core after the access, saying which and where, on an M0+ and an M7")
gdb_watchpoint_kinds()
    for name in ["virt", "virt7"]
        val board = booted(name, WATCHED[..])
        var t = MachineTarget(&*board)
        var d = attached(&t)
        val cpu = t.core(0)
        assert(body_of(ask(&d, 0, "Z2,1000,4")) == "OK")
        assert(continued(&d, 0) == "T05watch:00001000;" && cpu.pc == 16 && cpu.r[0] == 1, s"$name: ${cpu.pc} ${cpu.r[0]}")
        // The store was made, and the next one round the loop stops it again.
        assert(body_of(ask(&d, 0, "m1000,4")) == "01000000")
        assert(continued(&d, 0) == "T05watch:00001000;" && cpu.pc == 16 && cpu.r[0] == 2, name)
        // A read watchpoint stops after the load and not the store; an access one after either.
        assert(body_of(ask(&d, 0, "z2,1000,4")) == "OK" && body_of(ask(&d, 0, "Z3,1004,4")) == "OK")
        assert(continued(&d, 0) == "T05rwatch:00001004;" && cpu.pc == 18 && cpu.r[0] == 2, name)
        assert(body_of(ask(&d, 0, "z3,1004,4")) == "OK" && body_of(ask(&d, 0, "Z4,1000,8")) == "OK")
        assert(continued(&d, 0) == "T05awatch:00001000;" && cpu.pc == 16 && cpu.r[0] == 3, name)
        assert(continued(&d, 0) == "T05awatch:00001004;" && cpu.pc == 18 && cpu.r[0] == 3, name)
        // `?` says it again; the board stopped as a whole.
        assert(body_of(ask(&d, 0, "?")) == "T05awatch:00001004;" && !d.running)

@test("gdb: a watchpoint stops on an access that shares a byte with its range, of any width, and on no other")
gdb_watchpoint_edges()
    // Word stores at 0x1000 and word loads at 0x1004.
    for (z, want, pc) in [("Z2,1003,1", "T05watch:00001003;", 16u32), ("Z2,ffd,4", "T05watch:00001000;", 16u32), ("Z2,ffc,4", "", 0u32), ("Z2,1004,1", "", 0u32), ("Z3,1000,4", "", 0u32), ("Z2,1004,4", "", 0u32), ("Z3,1007,1", "T05rwatch:00001007;", 18u32), ("Z3,1008,4", "", 0u32), ("Z4,f00,200","T05awatch:00001000;", 16u32)]
        val (reply, at) = first_watch("virt", WATCHED[..], z)
        assert(reply == want && (pc == 0 || at == pc), s"$z: $reply at $at")
    // A byte stored at 0x1002 and a halfword at 0x1006.
    for (z, want, pc) in [("Z2,1002,1", "T05watch:00001002;", 16u32), ("Z2,1001,1", "", 0u32), ("Z2,1003,3", "", 0u32), ("Z2,1005,2", "T05watch:00001006;", 18u32), ("Z2,1007,1", "T05watch:00001007;", 18u32), ("Z2,1008,1", "", 0u32)]
        val (reply, at) = first_watch("virt", NARROW[..], z)
        assert(reply == want && (pc == 0 || at == pc), s"$z: $reply at $at")
    // A word stored from 0xffe, across a page boundary, on an M7.
    for (z, want) in [("Z2,1001,1", "T05watch:00001001;"), ("Z2,fff,2", "T05watch:00000fff;"), ("Z2,1002,2", ""), ("Z2,ffc,2", "")]
        val (reply, at) = first_watch("virt7", STRADDLING[..], z)
        assert(reply == want && (want == "" || at == 18), s"$z: $reply at $at")

@test("gdb: the stored word a straddling store makes past a watched page boundary is the whole of it")
gdb_watchpoint_straddling_store()
    val board = booted("virt7", STRADDLING[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    assert(body_of(ask(&d, 0, "Z2,1000,1")) == "OK")
    assert(continued(&d, 0) == "T05watch:00001000;")
    assert(body_of(ask(&d, 0, "mffe,4")) == "01000000")
    // Code on a watched page runs as it did: round the loop again.
    assert(continued(&d, 0) == "T05watch:00001000;" && body_of(ask(&d, 0, "mffe,4")) == "02000000")

// r1 is 0x1000: at 12 `ldrex r2, [r1]`; at 16 `adds r2, #1`; at 18 `strex r3, r2, [r1]`; at 22 `b 12`.
private val EXCLUSIVE: [8]u16 = [0x2101, 0x0309, 0xE851, 0x2F00, 0x3201, 0xE841, 0x2300, 0xE7F9]

@test("gdb: on an M7 a load- and a store-exclusive reach watchpoints, and the store-exclusive still succeeds")
gdb_watchpoint_exclusive()
    val board = booted("virt7", EXCLUSIVE[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    val cpu = t.core(0)
    assert(body_of(ask(&d, 0, "Z3,1000,4")) == "OK")
    assert(continued(&d, 0) == "T05rwatch:00001000;" && cpu.pc == 16, s"${cpu.pc}")
    assert(body_of(ask(&d, 0, "z3,1000,4")) == "OK" && body_of(ask(&d, 0, "Z2,1000,4")) == "OK")
    assert(continued(&d, 0) == "T05watch:00001000;" && cpu.pc == 22 && cpu.r[3] == 0, s"${cpu.pc} ${cpu.r[3]}")
    assert(body_of(ask(&d, 0, "m1000,4")) == "01000000")
    assert(continued(&d, 0) == "T05watch:00001000;" && cpu.r[3] == 0 && body_of(ask(&d, 0, "m1000,4")) == "02000000")

@test("gdb: a core holds four watchpoints and refuses a fifth, and one of no length; taken away, they stop nothing")
gdb_watchpoint_limit()
    val board = booted("virt", WATCHED[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    val cpu = t.core(0)
    assert(body_of(ask(&d, 0, "Z3,1000,0")) == "E01" && cpu.watch_count == 0)
    for z in ["Z2,1000,4", "Z2,1000,4", "Z3,1004,4", "Z4,1000,8", "Z2,2000,4"] do assert(body_of(ask(&d, 0, z)) == "OK", z)
    assert(cpu.watch_count == 4)
    // Only the pages they cover leave the core's fast path, and only the core's: the memory's own table
    // is whole.
    assert(cpu.pages[1] == 0 && cpu.pages[2] == 0 && cpu.pages[3] != 0 && t.memory().page_table[2] != 0)
    assert(body_of(ask(&d, 0, "Z2,3000,4")) == "E01")
    // One let go makes room for another.
    assert(body_of(ask(&d, 0, "z2,2000,4")) == "OK" && body_of(ask(&d, 0, "Z2,3000,4")) == "OK")
    // Taking one away that is not there, or of another kind, is no error and changes nothing.
    assert(body_of(ask(&d, 0, "z2,4000,4")) == "OK" && body_of(ask(&d, 0, "z3,1000,4")) == "OK" && cpu.watch_count == 4)
    for z in ["z2,1000,4", "z3,1004,4", "z4,1000,8", "z2,3000,4"] do assert(body_of(ask(&d, 0, z)) == "OK", z)
    assert(cpu.watch_count == 0 && cpu.pages == &t.memory().page_table[0])
    assert(continued(&d, 0) == "" && cpu.r[0] > 2)

@test("gdb: a step over a watched access says so, and continuing from a breakpoint on it stops after it")
gdb_watchpoint_step()
    val board = booted("virt", WATCHED[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    val cpu = t.core(0)
    assert(body_of(ask(&d, 0, "Z2,1000,4")) == "OK")
    for pc in [10u32, 12u32, 14u32] do assert(body_of(ask(&d, 0, "s")) == "T05" && cpu.pc == pc)
    assert(body_of(ask(&d, 0, "s")) == "T05watch:00001000;" && cpu.pc == 16 && cpu.r[0] == 1)
    assert(body_of(ask(&d, 0, "s")) == "T05" && cpu.pc == 18)
    // A breakpoint on the store stops the core before it; continuing runs it, and stops after.
    assert(body_of(ask(&d, 0, "Z0,e,2")) == "OK")
    assert(continued(&d, 0) == "T05swbreak:;" && cpu.pc == 14 && cpu.r[0] == 2)
    assert(continued(&d, 0) == "T05watch:00001000;" && cpu.pc == 16 && cpu.r[0] == 2)

@test("gdb: each core's watchpoints are its own: a store of the other core's stops neither")
gdb_watchpoint_cores()
    val board = booted("virt", TWO_CORES[..])
    launch(&*board, 0, 0x7000, 33)
    var t = MachineTarget(&*board)
    var d = attached(&t)
    assert(d.attach(1))
    // Each gdb watches what only the other core stores.
    assert(body_of(ask(&d, 0, "Z2,2000,4")) == "OK" && body_of(ask(&d, 1, "Z2,1000,4")) == "OK")
    assert(ask(&d, 1, "c") == "+")
    assert(continued(&d, 0) == "" && t.core(0).r[0] > 2 && t.core(1).r[0] > 2)
    assert(body_of(taken(&d, 1)) == "T02")
    // Core 1's gdb watching core 1's own store stops core 1 there; core 0's gdb hears the board stop.
    assert(body_of(ask(&d, 1, "Z2,2000,4")) == "OK")
    assert(ask(&d, 0, "c") == "+")
    assert(continued(&d, 1) == "T05watch:00002000;" && t.core(1).pc == 40)
    assert(body_of(taken(&d, 0)) == "T02")
    // Core 0's watchpoint goes with its gdb; core 1's stay.
    assert(body_of(ask(&d, 0, "D")) == "OK" && t.core(0).watch_count == 0 && t.core(1).watch_count == 2)

@test("gdb: a DMA's store to a watched address stops nothing: a watchpoint watches its own core's accesses")
gdb_watchpoint_dma()
    // The RP2350's: benchtop models its DMA.
    val b = chip.arm_board(chip.SramMap(0x20000000, 520 * 1024))
    b.boot(PICO2_BLINK).unwrap()
    var t = ArmTarget(&*b, 0)
    var d = debugger(&t)
    assert(d.attach(0))
    // The DMA let out of reset: RESETS' clear alias, bit 2.
    assert(body_of(ask(&d, 0, "M40023000,4:04000000")) == "OK")
    assert(body_of(ask(&d, 0, "M20010000,4:efbeadde")) == "OK")
    assert(body_of(ask(&d, 0, "Z2,20020000,4")) == "OK" && body_of(ask(&d, 0, "Z4,20020000,4")) == "OK")
    // Channel 0: one word from 0x20010000 to 0x20020000, unpaced (TREQ_SEL 0x3f), started.
    for m in ["M50000000,4:00000120", "M50000004,4:00000220", "M50000008,4:01000000", "M5000000c,4:09007e00"]
        assert(body_of(ask(&d, 0, m)) == "OK", m)
    assert(continued(&d, 0) == "")
    assert(body_of(ask(&d, 0, "m20020000,4")) == "efbeadde")

@test("gdb: detaching lets the board run on; k ends benchtop; the guest's exit is W")
gdb_detach()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    assert(body_of(ask(&d, 0, "Z0,c,2")) == "OK")
    assert(body_of(ask(&d, 0, "D")) == "OK" && d.links[0].closing && d.running)
    assert(t.memory().debug_break_count == 0)
    for _ in 0..<5 do d.advance()
    assert(d.running && !d.quit)
    // A gdb attaching stops it again.
    assert(d.attach(0) && !d.running)
    ask(&d, 0, "k")
    assert(d.quit && d.exit_code == 0)

@test("gdb: the target description is well-formed and names every register, the FPU's where there is one")
gdb_target_xml()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var d = attached(&t)
    val reply = body_of(ask(&d, 0, "qXfer:features:read:target.xml:0,3fff"))
    assert(reply.starts_with("l<?xml version=\"1.0\"?>"), reply)
    val xml = reply[1..<reply.len]
    well_formed(xml)
    for name in ["r0", "r12", "sp", "lr", "pc", "xpsr", "msp", "psp", "primask", "control"]
        assert(xml.contains(s"<reg name=\"$name\""), name)
    assert(xml.contains("<feature name=\"org.gnu.gdb.arm.m-profile\">") && !xml.contains("basepri") && !xml.contains("vfp"))
    assert(xml.contains("name=\"xpsr\" bitsize=\"32\" regnum=\"16\""))
    // In pieces, and past the end.
    val first = body_of(ask(&d, 0, "qXfer:features:read:target.xml:0,10"))
    assert(first == "m" + xml[0..<16], first)
    assert(body_of(ask(&d, 0, f"qXfer:features:read:target.xml:${xml.len}%x,10")) == "l")
    assert(body_of(ask(&d, 0, "qXfer:features:read:other.xml:0,10")) == "E00")
    // A Cortex-M7, with Mainline's masks, given the double-precision FPU the H747's has.
    val m7 = booted("virt7", LOOP[..])
    var t7 = MachineTarget(&*m7)
    t7.core(0).fpu = Fpu.Double
    t7.core(0).s[2] = 0x11223344
    t7.core(0).s[3] = 0x55667788
    val xml7 = target_xml(t7.core(0))
    well_formed(xml7)
    for name in ["basepri", "faultmask", "d0", "d15", "fpscr"] do assert(xml7.contains(s"<reg name=\"$name\""), name)
    assert(xml7.contains("name=\"d0\" bitsize=\"64\"") && xml7.contains("<feature name=\"org.gnu.gdb.arm.vfp\">"))
    var d7 = attached(&t7)
    assert(body_of(ask(&d7, 0, "g")).len == (16 + 7) * 8 + 16 * 16 + 8)
    // d1 is s2 and s3, little-endian; p numbers it after control (22).
    assert(body_of(ask(&d7, 0, "p18")) == "4433221188776655")

// Every element opened is closed, in order, and the document is one `target`.
private well_formed(xml: string)
    var stack: Buf[string] = buf()
    var i: usize = 0
    var roots = 0
    while i < xml.len
        if xml[i] != u8('<')
            i += 1
            continue
        val close = xml.index_of_byte_from(u8('>'), i).unwrap()
        val tag = xml[i + 1..<close]
        i = close + 1
        if tag.starts_with("?") || tag.starts_with("!") then continue
        if tag.starts_with("/")
            assert(stack.len() > 0 && stack[stack.len() - 1] == tag[1..<tag.len], tag)
            stack.truncate(stack.len() - 1)
            continue
        if stack.len() == 0 then roots += 1
        if tag.ends_with("/") then continue
        val space = tag.index_of_byte(u8(' ')).unwrap_or(tag.len)
        stack.push(tag[0..<space])
    assert(stack.len() == 0 && roots == 1, xml)

@test("gdb: the RP2040's board steps, reads its ROM and registers, and stops at the guest's BKPT")
gdb_pico()
    val b = chip.pico_board(chip.SramMap(0x20000000, 264 * 1024))
    b.boot(PICO_BLINK).unwrap()
    var t = ArmTarget(&*b, 0)
    var d = debugger(&t)
    assert(d.attach(0))
    val cpu = t.core(0)
    val pc = cpu.pc
    assert(body_of(ask(&d, 0, "s")) == "T05" && cpu.retired == 1 && cpu.pc != pc)
    // The boot ROM's first word is its initial stack pointer.
    assert(body_of(ask(&d, 0, "m0,4")).len == 8)
    assert(body_of(ask(&d, 0, "g")).len == 21 * 8)
    // A breakpoint at where the core is now, continued to after a step away, comes round no more:
    // core 0 runs on, and Ctrl-C stops it.
    ask(&d, 0, "c")
    for _ in 0..<3 do d.advance()
    d.receive(0, [3u8][..])
    assert(body_of(taken(&d, 0)) == "T02")

// ---------------------------------------------------------------------------------------------------
// Over a socket.

@test("gdb: a scripted gdb over a loopback socket: connect, ask, read registers, set a breakpoint, run to it, end benchtop")
gdb_socket()
    val board = booted("virt", LOOP[..])
    var t = MachineTarget(&*board)
    var server = open_server(&t, 0).unwrap()
    val port = server.port_of(0)
    assert(port > 0 && server.port_of(1) > 0 && server.port_of(1) != port)
    val to = resolve("127.0.0.1", port).unwrap()[0]
    var c = socket(to).unwrap()
    c.connect(to).unwrap()
    assert(server.turn())
    // A second gdb on the same port is turned away.
    var second = socket(to).unwrap()
    second.connect(to).unwrap()
    assert(server.turn())
    var one: [16]u8
    assert(second.recv(one[..]).unwrap() == 0)
    second.close().unwrap()
    val supported = exchange(&server, &c, "qSupported:swbreak+")
    assert(supported.starts_with("+$PacketSize=4000;"), supported)
    assert(exchange(&server, &c, "?") == "+$T05#b9")
    assert(exchange(&server, &c, "p0") == "+$00000000#80")
    assert(exchange(&server, &c, "Z0,c,2") == "+$OK#9a")
    // The acknowledgement first, then, once the board reaches it, the stop.
    val want = "+" + str_cast(frame("T05swbreak:;".bytes).view())
    var got = exchange(&server, &c, "c")
    var n = 0
    while got.len < want.len && n < 100
        assert(server.turn())
        got = got + heard(&c)
        n += 1
    assert(got == want, got)
    c.send_all(frame("k".bytes).view()).unwrap()
    n = 0
    while server.turn() && n < 20 do n += 1
    assert(n < 20 && server.d.quit && server.d.exit_code == 0)
    c.close().unwrap()

// Send `body` framed, and answer what came back: the server takes turns until something has, since
// a reply on the loopback is not always readable the instant it is sent.
private exchange(server: *Server[MachineTarget], c: *sysl.net.Socket, body: string) -> string
    c.send_all(frame(body.bytes).view()).unwrap()
    var text = ""
    var n = 0
    while text.is_empty() && n < 20
        assert(server.turn())
        text = heard(c)
        n += 1
    text

// What the socket holds now, without waiting for more.
private heard(c: *sysl.net.Socket) -> string
    c.non_blocking().unwrap()
    var text = ""
    var bytes: [256]u8
    loop
        c.recv(bytes[..]) match
            Ok(n) ->
                if n == 0 then break
                for b in bytes[0..<n] do text = text + str_cast([b][..])
            Err(_) -> break
    c.non_blocking(false).unwrap()
    text
