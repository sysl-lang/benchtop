module sh.sysl.benchtop.gdb

// The registers gdb sees of a Cortex-M core, in the order of the target description benchtop sends it
// (`target_xml`), which is the order of a `g` packet and the numbers of `p` and `P`:
//
// - `org.gnu.gdb.arm.m-profile`: r0–r12, sp, lr, pc and xpsr, numbers 0–16.
// - `org.gnu.gdb.arm.m-system`: msp, psp, primask, and on a Mainline core basepri and faultmask; then
//   control.
// - `org.gnu.gdb.arm.vfp`, on a core with the floating-point extension: d0–d15 and fpscr. gdb shows
//   s0–s31 as halves of them.

import sh.sysl.benchtop.v6m.{Cpu, Fpu, is_baseline, main_sp, process_sp, set_debug_control, set_debug_xpsr, set_main_sp, set_process_sp, xpsr}
import sysl.buf.{Buf, buf}

/** Which of a core's registers a number is. */
enum Reg
    // r0–r15, 15 being the pc.
    R(n: u32)
    Xpsr
    Msp
    Psp
    Primask
    Basepri
    Faultmask
    Control
    // d0–d15, each two of s0–s31.
    D(n: u32)
    Fpscr

/** Every register gdb sees of `cpu`, in number order. */
registers(cpu: *Cpu) -> Buf[Reg]
    var regs: Buf[Reg] = buf()
    for i in 0u32..<16 do regs.push(Reg.R(i))
    regs.push(Reg.Xpsr)
    regs.push(Reg.Msp)
    regs.push(Reg.Psp)
    regs.push(Reg.Primask)
    if !is_baseline(cpu.kind)
        regs.push(Reg.Basepri)
        regs.push(Reg.Faultmask)
    regs.push(Reg.Control)
    if cpu.fpu != Fpu.Absent
        for i in 0u32..<16 do regs.push(Reg.D(i))
        regs.push(Reg.Fpscr)
    regs

/** How many bytes register `r` is. */
reg_bytes(r: Reg) -> u32 = r match
    D(_) -> 8
    _ -> 4

/** The value of register `r` of `cpu`. */
read_reg(cpu: *Cpu, r: Reg) -> u64 = r match
    R(i) -> u64(if i == 15 then cpu.pc else cpu.r[i])
    Xpsr -> u64(xpsr(cpu))
    Msp -> u64(main_sp(cpu))
    Psp -> u64(process_sp(cpu))
    Primask -> u64(cpu.primask)
    Basepri -> u64(cpu.basepri)
    Faultmask -> u64(cpu.faultmask)
    Control -> u64(cpu.control)
    D(i) -> u64(cpu.s[2 * i]) | u64(cpu.s[2 * i + 1]) << 32
    Fpscr -> u64(cpu.fpscr)

/** Register `r` of `cpu` written `v`. The pc keeps its Thumb bit clear, as the core's own does. */
write_reg(cpu: *Cpu, r: Reg, v: u64)
    val w = u32(v & 0xFFFFFFFF)
    r match
        R(i) ->
            if i == 15 then cpu.pc = w & ~1u32 else cpu.r[i] = w
        Xpsr -> set_debug_xpsr(cpu, w)
        Msp -> set_main_sp(cpu, w)
        Psp -> set_process_sp(cpu, w)
        Primask -> cpu.primask = w & 1
        Basepri -> cpu.basepri = w & 0xFF
        Faultmask -> cpu.faultmask = w & 1
        Control -> set_debug_control(cpu, w)
        D(i) ->
            cpu.s[2 * i] = w
            cpu.s[2 * i + 1] = u32(v >> 32)
        Fpscr -> cpu.fpscr = w

/** A register's name in the target description. */
reg_name(r: Reg) -> string = r match
    R(i) -> if i == 13 then "sp" elif i == 14 then "lr" elif i == 15 then "pc" else s"r$i"
    Xpsr -> "xpsr"
    Msp -> "msp"
    Psp -> "psp"
    Primask -> "primask"
    Basepri -> "basepri"
    Faultmask -> "faultmask"
    Control -> "control"
    D(i) -> s"d$i"
    Fpscr -> "fpscr"

// The feature a register belongs to, and the type gdb shows it as.
private feature_of(r: Reg) -> string = r match
    R(_) | Xpsr -> "org.gnu.gdb.arm.m-profile"
    D(_) | Fpscr -> "org.gnu.gdb.arm.vfp"
    _ -> "org.gnu.gdb.arm.m-system"

private type_of(r: Reg) -> string = r match
    R(i) -> if i == 13 then "data_ptr" elif i == 15 then "code_ptr" else "uint32"
    Msp | Psp -> "data_ptr"
    D(_) -> "ieee_double"
    _ -> "uint32"

/** The target description of `cpu`, the `target.xml` gdb reads through `qXfer:features:read`. */
target_xml(cpu: *Cpu) -> string
    val regs = registers(cpu)
    var out = "<?xml version=\"1.0\"?>\n<!DOCTYPE target SYSTEM \"gdb-target.dtd\">\n<target version=\"1.0\">\n<architecture>arm</architecture>\n"
    var open = ""
    for n in 0..<regs.len()
        val r = regs[n]
        val feature = feature_of(r)
        if feature != open
            if !open.is_empty() then out = out + "</feature>\n"
            out = out + s"<feature name=\"$feature\">\n"
            open = feature
        val group = feature_of(r) match
            "org.gnu.gdb.arm.m-system" -> " group=\"system\""
            "org.gnu.gdb.arm.vfp" -> " group=\"float\""
            _ -> " group=\"general\""
        out = out + s"<reg name=\"${reg_name(r)}\" bitsize=\"${reg_bytes(r) * 8}\" regnum=\"$n\" type=\"${type_of(r)}\"$group/>\n"
    out + "</feature>\n</target>\n"
