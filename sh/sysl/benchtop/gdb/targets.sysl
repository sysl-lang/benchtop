module sh.sysl.benchtop.gdb

// The boards gdb debugs: benchtop's machine (the virtual boards and the STM32H747I-DISCO), run in core
// turns on one thread, and the RP2040 and RP2350 chips' own board (`chip.ArmBoard`), with UART0 — and
// on the RP2350 the USB serial port — on stdout as `benchtop run` has them. Neither is paced: the board
// runs as fast as the host lets it, so a stop holds its clock exactly where it is, and a resume goes on
// from there with nothing to catch up.

import sh.sysl.benchtop.v6m.{Cpu, Memory, Stop}
import sh.sysl.benchtop.virt.{Machine, pump_board, running_both}
import sh.sysl.benchtop.chip as chip
import sh.sysl.benchtop.host as host

// Turns of the machine's scheduler a slice runs: each is a round of its quantum, 1000 instructions a
// core, as `benchtop run` takes them.
private const SLICE_TURNS = 16

// clk_sys cycles a slice of an RP chip runs.
private const SLICE_CYCLES: u64 = 16000

/** benchtop's machine, a core's turn at a time on the caller's thread. */
struct MachineTarget
    m: *Machine

impl Target for MachineTarget
    cores(*self) -> u32 = 2
    core(*self, k: u32) -> *Cpu = &self.m.cores[k]
    started(*self, k: u32) -> bool = k == 0 || running_both(self.m)
    memory(*self) -> &sync Memory = self.m.memory
    slice(*self) -> Slice
        for _ in 0..<SLICE_TURNS do if !pump_board(self.m, 1000) then return Slice.Stopped
        Slice.Ran

/** An RP2040's or RP2350's board, its console on stdout. */
struct ArmTarget[C: chip.ArmChip]
    b: *chip.ArmBoard[C]
    // How much of the console has gone to stdout.
    shown: usize

impl[C: chip.ArmChip] Target for ArmTarget[C]
    cores(*self) -> u32 = 2
    core(*self, k: u32) -> *Cpu = &self.b.cores[k]
    started(*self, k: u32) -> bool = self.b.started[k]
    memory(*self) -> &sync Memory = self.b.mem
    slice(*self) -> Slice
        val end = self.b.run(SLICE_CYCLES)
        val last = end != chip.RunEnd.Budget
        self.shown = host.show_console(self.b.console.view(), self.shown, last, b -> putbytes(b), () -> flush())
        val h = &self.b.usb_host
        h.consume(host.show_console(h.received.view(), 0, last, b -> putbytes(b), () -> flush()))
        h.take_note() match
            Some(n) -> eprints(s"benchtop: $n\r\n")
            None -> ()
        end match
            Budget -> Slice.Ran
            Breakpoint -> Slice.Stopped
            Asleep -> Slice.Asleep
            Fault ->
                for k in 0..<2 do if self.b.cores[k].stop != Stop.Running then return Slice.Stopped
                Slice.Failed(self.b.refused)

    // The chip says why it refused an access in `why`, which a run would take as its own fault.
    override read(*self, k: u32, a: u32, width: u32) -> Option[u32]
        val v = core_read(self.core(k), a, width)
        if self.b.why.is_empty() then return v
        self.b.why = ""
        None

    override write(*self, k: u32, a: u32, width: u32, x: u32) -> bool
        val made = core_write(self.core(k), a, width, x)
        if self.b.why.is_empty() then return made
        self.b.why = ""
        false
