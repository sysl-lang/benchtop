module sh.sysl.benchtop.instrument

import sysl.buf.{Buf, buf}

/** A source may observe any numeric value. None records a gap, never a made-up value. */
struct Source
    name: string
    units: string
    read: &Fn() -> Option[real]

struct Sample
    time: u64
    value: Option[real]

/** Bounded chronological ring, clocked in guest cycles, independent of any view. */
struct Plot
    source: Source
    capacity: usize
    window: u64
    interval: u64
    minimum: real
    maximum: real
    samples: Buf[Sample]
    oldest: usize
    last: Option[u64]
    held: bool
    gap: bool

finite(x: real) -> bool = x == x && x <= 1.7976931348623157e308 && x >= -1.7976931348623157e308

/** The fewest and the most samples a plot holds. */
const MIN_CAPACITY: usize = 2
const MAX_CAPACITY: usize = 65536

plot(source: Source, capacity: usize = 1024, window: u64 = 20000000, interval: u64 = 20000,
     minimum: real = 0.0, maximum: real = 4095.0) -> Result[&Plot, string]
    if capacity < MIN_CAPACITY || capacity > MAX_CAPACITY then return Err(s"plot capacity must be $MIN_CAPACITY..$MAX_CAPACITY")
    if window == 0 || interval == 0 then return Err("plot durations must be positive guest cycles")
    if !finite(minimum) || !finite(maximum) || minimum >= maximum || !finite(maximum - minimum)
        return Err("plot needs a finite increasing range")
    Ok(Plot(source, capacity, window, interval, minimum, maximum, buf(), 0, None, false, false))

clear(p: &Plot)
    p.samples = buf()
    p.oldest = 0
    p.last = None
    p.gap = false

hold(p: &Plot, held: bool)
    if p.held && !held then p.gap = true
    p.held = held

sample(p: &Plot, time: u64)
    p.last match
        Some(t) ->
            if time < t then clear(p)
            elif time == t || time - t < p.interval then return
        None -> ()
    if p.held then return
    var value = (p.source.read)()
    value match
        Some(x) -> if !finite(x) then value = None
        None -> ()
    if p.gap
        append(p, Sample(time, None))
        p.gap = false
    append(p, Sample(time, value))
    p.last = Some(time)

private append(p: &Plot, s: Sample)
    if p.samples.len() < p.capacity then p.samples.push(s)
    else
        p.samples.set(p.oldest, s)
        p.oldest = (p.oldest + 1) % p.capacity

at(p: &Plot, i: usize) -> Sample
    require i < p.samples.len(), "sample index is in history"
    p.samples.at((p.oldest + i) % p.samples.len())
