module sh.sysl.benchtop.instrument
@tests

import sysl.math.Float

@test("plot instrument: bounded ring wraps in chronological order and ignores paused or early samples")
ring()
    val p = plot(Source("counter", "ticks", () -> Some(7.0)), 3, 100, 10).unwrap()
    for t in [0u64, 10, 20, 30, 40] do sample(p, t)
    assert(p.samples.len() == 3)
    assert(at(p, 0).time == 20 && at(p, 1).time == 30 && at(p, 2).time == 40)
    sample(p, 40)
    sample(p, 49)
    assert(at(p, 2).time == 40 && p.samples.len() == 3)
    sample(p, 50)
    assert(at(p, 0).time == 30 && at(p, 2).time == 50)

@test("plot instrument: reset and clock rewind clear history while hold resumes with an explicit gap")
reset_hold()
    val p = plot(Source("value", "V", () -> Some(1.0)), 6, 100, 1).unwrap()
    sample(p, 100)
    hold(p, true)
    sample(p, 200)
    assert(p.samples.len() == 1 && p.last == Some(100u64))
    hold(p, false)
    sample(p, 250)
    assert(p.samples.len() == 3 && at(p, 1).value.is_none() && at(p, 2).value == Some(1.0))
    sample(p, 10)
    assert(p.samples.len() == 1 && at(p, 0).time == 10)
    clear(p)
    assert(p.samples.len() == 0 && p.last.is_none())

@test("plot instrument: missing and nonfinite values are gaps, invalid ranges and capacities are rejected")
invalid_values()
    val p = plot(Source("missing", "", () -> None)).unwrap()
    sample(p, 0)
    assert(at(p, 0).value.is_none())
    val huge = 1.0e308
    val infinity = huge * huge
    assert(!finite(infinity) && !finite(infinity - infinity))
    val q = plot(Source("overflow", "", () -> Some(infinity))).unwrap()
    sample(q, 0)
    assert(at(q, 0).value.is_none())
    assert(plot(p.source, capacity = 1).is_err())
    assert(plot(p.source, capacity = 65537).is_err())
    assert(plot(p.source, window = 0).is_err() && plot(p.source, interval = 0).is_err())
    assert(plot(p.source, minimum = 1.0, maximum = 1.0).is_err())
    assert(plot(p.source, minimum = infinity).is_err())
    assert(plot(p.source, minimum = -huge, maximum = huge).is_err())
