module sh.sysl.benchtop
@tests

import sh.sysl.benchtop.v6m.{MODELS, default_priority_bits, is_v81m}
import sh.sysl.parsing.source_of

@test("all model names and partial option blocks use model-specific defaults and round-trip")
model_options_defaults()
    for model in MODELS
        val text = s"board { name = t, cores = [${model.name}, { core = ${model.name}, fpu = none }] }"
        val got = load(source_of("model.hocon", text), library())
        assert(!got.report.has_errors(), model.name)
        val rendered = description_text(got.description)
        val again = load(source_of("again.hocon", rendered), library())
        assert(!again.report.has_errors() && description_text(again.description) == rendered)
        for core in again.description.board.cores
            assert(setting_text(core_option(core, "nvic_priority_bits")) == str(default_priority_bits(model.kind)))
            assert(unemulated_core_option(core).is_none())
end model_options_defaults

@test("models reject options their hardware lacks and explicitly report valid unimplemented extensions")
model_options_capabilities()
    for model in MODELS
        val fp = if model.fpu == "none" then "sp" else model.fpu
        val text = s"board { name = t, cores = [{ core = ${model.name}, fpu = $fp }] }"
        val got = load(source_of("fp.hocon", text), library())
        if model.fpu == "none"
            assert(got.report.has_errors(), model.name)
        else
            assert(!got.report.has_errors() && unemulated_core_option(got.description.board.cores.at(0)).is_some(), model.name)
        if is_v81m(model.kind)
            for option in ["mve = integer", "mve = float", "low_overhead_loops = true"]
                val selected = s"board { name = t, cores = [{ core = ${model.name}, $option }] }"
                val parsed = load(source_of("extension.hocon", selected), library())
                assert(!parsed.report.has_errors(), selected)
                assert(unemulated_core_option(parsed.description.board.cores.at(0)).is_some(), "extensions are not silently ignored")
end model_options_capabilities

@test("custom registries keep accepting plain core names without a built-in option model")
model_options_custom_registry()
    var reg = library()
    reg.cores.push(CoreSpec("test-core", "a test-only core", 32))
    val plain = load(source_of("custom.hocon", "board { name = custom, cores = [test-core] }"), reg)
    assert(!plain.report.has_errors(), "registry-defined names remain valid")
    val src = source_of("custom.hocon", "board { name = custom, cores = [{ core = test-core, fpu = none }] }")
    val options = load(src, reg)
    assert(options.report.has_errors() && options.report.render(src).contains("has no option `fpu`"), "a diagnostic rather than an unwrap panic")
end model_options_custom_registry
