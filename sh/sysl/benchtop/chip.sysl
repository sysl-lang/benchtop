module sh.sysl.benchtop

import sh.sysl.parsing.{Report, Source, Span, error}
import sysl.buf.{Buf, buf}
import sh.sysl.benchtop.v6m.model_named

// A chip held to the library, and the chip as a board's checker reads it.
//
// **Everything on the cores' bus is the chip's.** Each peripheral is one the library has, at an
// aligned address, its window inside the address space, clear of every other and of the cores' own
// private peripheral bus, raising as many interrupts as it declares, each below the cores' count and
// raised by no other. A peripheral that drives pins names, for each of its signals, the chip's pins
// that signal can be routed to; an ADC names its channels' pins.

/** One signal of a chip's bus, and the pins it can be routed to. */
struct SignalSpec
    name: string
    pins: Buf[string]

/** One of a chip's buses: a peripheral that drives pins, by its instance name, of its library kind. */
struct ControllerSpec
    name: string
    kind: string
    signals: Buf[SignalSpec]

    signal(self, name: string) -> Option[SignalSpec]
        for s in self.signals
            if s.name == name then return Some(s)

        None
    end signal
end ControllerSpec

/** A chip as a board is checked against it: its pins by bank, its ADC pins, and its buses. */
struct ChipSpec
    name: string
    summary: string
    cores: Buf[Core]
    banks: Buf[Bank]
    adc_pins: Buf[string]
    controllers: Buf[ControllerSpec]

    controller(self, name: string) -> Option[ControllerSpec]
        for c in self.controllers
            if c.name == name then return Some(c)

        None
    end controller

    /** Whether `name` is one of the chip's pins. */
    has_pin(self, name: string) -> bool
        pin_parts(name) match
            Some((prefix, n)) ->
                for b in self.banks
                    if b.prefix == prefix then return n >= 0 && n < b.count

                false
            None -> false
    end has_pin

    /** The chip's pins as a note lists them: `GP0 to GP29`, `PA0 to PA15 and PB0 to PB15`. */
    pin_span(self) -> string
        var runs: Buf[string] = buf()

        for b in self.banks do runs.push(s"${b.prefix}0 to ${b.prefix}${b.count - 1}")

        plain_names(runs, "and")
    end pin_span
end ChipSpec

/** The chip a board is checked against, from its description. */
chip_spec(c: Chip, reg: Registry) -> ChipSpec
    var adc: Buf[string] = buf()
    var controllers: Buf[ControllerSpec] = buf()

    for p in c.peripherals
        val spec = reg.peripheral(p.kind) match
            Some(s) -> s
            None -> continue

        if spec.adc then
            for pin in p.channels do adc.push(pin.name)

        if spec.bus.is_empty() then continue

        var signals: Buf[SignalSpec] = buf()

        for route in p.signals
            var pins: Buf[string] = buf()

            for pin in route.pins do pins.push(pin.name)

            signals.push(SignalSpec(route.name, pins))
        end for

        controllers.push(ControllerSpec(p.name, spec.bus, signals))
    end for

    ChipSpec(c.name, c.summary, c.cores, c.banks, adc, controllers)
end chip_spec

// -- the chip's checks -----------------------------------------------------------------------------

/** Check a chip against the library, adding every mistake to `r`. */
check_chip(c: Chip, reg: Registry, src: Source, r: *Report)
    for core in c.cores
        if reg.core(core.name).is_none()
            if !core.name.is_empty() then
                r.add(guessed(error(core.span, s"unknown core `${core.name}`"), core.name, reg.core_names())
                    .with_note(s"the cores benchtop knows are ${listing(reg.core_names())}"))
        else
            check_core_options(core, r)

    for i in 0..<c.banks.len()
        for j in 0..<i
            if c.banks.at(j).prefix == c.banks.at(i).prefix then
                r.add(error(c.banks.at(i).span, s"`pins.${c.banks.at(i).prefix}` is set twice"))

    val spec = chip_spec(c, reg)

    for p in c.peripherals
        val ps = reg.peripheral(p.kind) match
            Some(s) -> s
            None ->
                if !p.kind.is_empty() then
                    val also = if reg.part(p.kind).is_some() then
                        s"; `${p.kind}` is a part, which is wired to the chip on a board rather than placed on its bus"
                    else
                        ""

                    r.add(guessed(error(p.kind_span, s"unknown peripheral `${p.kind}`"), p.kind, reg.peripheral_names())
                        .with_note(s"the peripherals benchtop knows are ${listing(reg.peripheral_names())}$also"))
                continue

        if is_pin_name(p.name) then
            r.add(error(p.name_span, s"`${p.name}` is spelled as a pin")
                .with_note("a peripheral's name starts with a small letter, as `uart0`, so that a wire to it is not read as one to a pin"))

        for prm in p.params
            ps.param(prm.name) match
                Some(x) -> check_param(s"`${p.name}.${prm.name}`", prm, x, r)
                None ->
                    r.add(error(prm.name_span, s"`${p.name}` (${ps.name}) has no parameter `${prm.name}`")
                        .with_note("it has no parameters"))

        check_routes(p, ps, spec, r)
    end for

    check_bus(c, reg, src, r)
end check_chip

// A peripheral's signals and channels: its library's signals, on pins the chip has.
private check_routes(p: Peripheral, ps: PeripheralSpec, chip: ChipSpec, r: *Report)
    if !p.signals.is_empty() && ps.signals.is_empty() then
        r.add(error(p.signals.at(0).name_span, s"${article_of(ps.name)} ${ps.name} drives no pins, so `${p.name}.signals` means nothing"))
        return

    for route in p.signals
        if !contains_text(ps.signals, route.name) then
            r.add(guessed(error(route.name_span, s"`${p.name}` (${ps.name}) has no signal `${route.name}`"), route.name, ps.signals)
                .with_note(s"its signals are ${listing(ps.signals)}"))
            continue

        for pin in route.pins do chip_pin(chip, pin, s"`${p.name}.signals.${route.name}`", r)
    end for

    if !p.channels.is_empty() && !ps.adc then
        r.add(error(p.channels.at(0).span, s"${article_of(ps.name)} ${ps.name} is not an ADC, so `${p.name}.channels` means nothing"))
        return

    for pin in p.channels do chip_pin(chip, pin, s"`${p.name}.channels`", r)
end check_routes

// A pin a chip's peripheral names, which must be one of the chip's.
private chip_pin(chip: ChipSpec, pin: PinRef, what: string, r: *Report)
    if chip.has_pin(pin.name) then return

    val its = if chip.banks.is_empty() then "it has no pins" else s"its pins are ${chip.pin_span()}"

    r.add(error(pin.span, s"$what names ${pin.name}, which the ${chip.name} does not have").with_note(its))

// The block of addresses every Cortex-M keeps for itself: the NVIC, SysTick and the SCB live here, and
// a peripheral placed over it would never be reached.
const PPB_BASE: long = 0xE0000000
const PPB_END: long = 0xE0100000
const SPACE_END: long = 0x100000000

// A peripheral's window, from `base` up to but not including `end`, and the place `at` was written.
private struct Placed
    name: string
    base: long
    end: long
    span: Span
end Placed

/** Each peripheral has an aligned address, a window inside the address space that meets no other's
 * and not the cores' own, and the IRQs it raises, which the cores have and no other raises.
 */
private check_bus(c: Chip, reg: Registry, src: Source, r: *Report)
    var has_ppb = false
    for core in c.cores do if model_named(core.name).is_some() then has_ppb = true
    val (irqs, core) = irq_count(c, reg)
    var placed: Buf[Placed] = buf()
    var raised: Buf[(long, string, Span)] = buf()

    for p in c.peripherals
        val spec = reg.peripheral(p.kind) match
            Some(s) -> s
            None -> continue

        val w = spec.window

        // An amount the reader could not read is -1, and was reported there.
        val size: long = p.size match
            Some(s) ->
                if s.n < 0 then
                    0
                elif !w.sized then
                    r.add(error(s.name_span, f"the size of ${article_of(spec.name)} ${spec.name} is fixed, at ${w.size} bytes (0x${w.size}%x)")
                        .with_note(s"leave `${p.name}.size` out"))
                    w.size
                elif s.n == 0 then
                    r.add(error(s.span, s"`${p.name}.size` must be more than 0"))
                    0
                else
                    s.n
            None ->
                if w.size == 0 then
                    r.add(error(p.name_span, s"`${p.name}` has no size")
                        .with_note(s"the size of ${article_of(spec.name)} ${spec.name} is the chip's to give, as `size = 1M`"))
                w.size

        if w.irqs == 0 && !p.irqs.is_empty() then
            r.add(error(p.irq_span, s"${article_of(spec.name)} ${spec.name} raises no interrupt, so `${p.name}.irq` means nothing"))
        elif !p.irqs.is_empty() && p.irqs.len() != usize(w.irqs) then
            val wants = if w.irqs == 1 then "one interrupt" else s"${w.irqs} interrupts"

            r.add(error(p.irq_span, s"${article_of(spec.name)} ${spec.name} raises $wants, and `${p.name}.irq` gives ${p.irqs.len()}"))
        else
            for q in p.irqs
                if q.n < 0 then continue

                if irqs >= 0 && q.n >= irqs then
                    r.add(error(q.span, s"IRQ ${q.n} is beyond the $core's $irqs interrupts")
                        .with_note(s"its interrupts are IRQ 0 to IRQ ${irqs - 1}"))
                    continue

                var again = false

                for (n, who, at) in raised
                    if !again && n == q.n then
                        r.add(error(q.span, s"IRQ ${q.n} is used twice")
                            .with_note(s"`$who` already raises it, at ${src.locate(at.start)}"))
                        again = true

                if !again then raised.push((q.n, p.name, q.span))
            end for
        end if

        val a = p.at match
            Some(a) -> a
            None ->
                r.add(error(p.name_span, s"`${p.name}` has no address")
                    .with_note(s"${article_of(spec.name)} ${spec.name} is on the cores' bus; give it its base, as `at = 0x40000000`"))
                continue

        if a.n < 0 then continue

        if a.n % w.align != 0 then
            r.add(error(a.span, f"`${p.name}.at` is not aligned: ${article_of(spec.name)} ${spec.name}'s base is a multiple of 0x${w.align}%x"))
            continue

        if size == 0 then continue

        val end = a.n + size

        if end > SPACE_END then
            r.add(error(a.span, f"`${p.name}` runs past the end of the address space: ${size} bytes from 0x${a.n}%08x end beyond 0xffffffff"))
            continue

        if has_ppb && a.n < PPB_END && PPB_BASE < end then
            r.add(error(a.span, f"`${p.name}` (0x${a.n}%08x to 0x${end - 1}%08x) overlaps the cores' own private peripheral bus")
                .with_note("every Cortex-M keeps 0xe0000000 to 0xe00fffff for its NVIC, SysTick and system control block"))
            continue

        var clear = true

        for q in placed
            if clear && a.n < q.end && q.base < end then
                r.add(error(a.span, f"`${p.name}` (0x${a.n}%08x to 0x${end - 1}%08x) overlaps `${q.name}` (0x${q.base}%08x to 0x${q.end - 1}%08x)")
                    .with_note(s"`${q.name}` is placed at ${src.locate(q.span.start)}"))
                clear = false

        if clear then placed.push(Placed(p.name, a.n, end, a.span))
    end for
end check_bus

// How many IRQs the chip's cores take, the fewest of theirs, and the core that says so. -1 where no
// core is known.
private irq_count(c: Chip, reg: Registry) -> (int, string)
    var irqs = -1
    var name = ""

    for core in c.cores
        reg.core(core.name) match
            Some(k) ->
                if irqs < 0 || k.irqs < irqs then
                    irqs = k.irqs
                    name = k.name
            None -> ()

    (irqs, name)
end irq_count

/** The size of a peripheral's window: its own where it gives one, else its library's. */
window_size(p: Peripheral, reg: Registry) -> long
    p.size match
        Some(s) -> return s.n
        None -> ()

    reg.peripheral(p.kind) match
        Some(spec) -> spec.window.size
        None -> 0
end window_size

private contains_text(xs: Buf[string], n: string) -> bool
    for x in xs
        if x == n then return true

    false
end contains_text

// Names joined with commas and a last word, without backticks.
private plain_names(names: Buf[string], last: string) -> string
    var out = ""

    for i in 0..<names.len()
        if i > 0 then out = out + (if i + 1 == names.len() then s" $last " else ", ")

        out = out + names.at(i)

    out
end plain_names
