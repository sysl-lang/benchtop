module sh.sysl.benchtop.v6m
@tests

@test("single instruction stepping: every model stops after arithmetic and taken branches")
single_steps()
    for model in MODELS
        var c: Cpu
        c.kind = model.kind
        prepare(&c, [0x2001, 0x3001, 0xE7FD], [], 0, [])
        val start = c.pc
        for expected in [1u32, 2, 2, 3]
            set_limit(&c, c.retired + 1)
            val before = c.retired
            run_single(&c)
            assert(c.stop == Stop.Running && c.retired == before + 1, model.name)
            assert(c.r[0] == expected, model.name)
        assert(c.pc == start + 4)

@test("single instruction stepping: IT skipped instructions retire individually")
single_it()
    var c: Cpu
    c.kind = Kind.V8mMain
    prepare(&c, [0x4280, 0xBF0C, 0x2107, 0x2109], [], 0, [])
    val start = c.pc
    for i in 0u64..<4
        set_limit(&c, i + 1)
        run_single(&c)
        assert(c.retired == i + 1 && c.pc == start + u32(i + 1) * 2)
    assert(c.r[1] == 7 && c.it == 0)
