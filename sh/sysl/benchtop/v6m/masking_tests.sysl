module sh.sysl.benchtop.v6m
@tests

// The masking report (masking.sysl) on one core: masked intervals from PRIMASK, BASEPRI and FAULTMASK,
// their lengths in the core's cycles and the instructions that began and ended them, and the latency
// of an interrupt from becoming pending to its handler. Every case runs under both executors, which
// must report the same, on exceptions.sysl's machine.

import sysl.buf.{Buf, buf}

const MASK_NOP: u16 = 0xBF00
const CPSID_F: u16 = 0xB671
// msr basepri, r2 (0x80) and msr basepri, r3 (0).
const MSR_BASEPRI_R2_1: u16 = 0xF382
const MSR_BASEPRI_R3_1: u16 = 0xF383
const MSR_BASEPRI_2: u16 = 0x8811
// ldr r1, [r4]: two cycles under estimated timing.
const LDR_R1_R4: u16 = 0x6821
const PENDSVCLR: u32 = 0x08000000
// movs r7, #9: r7 is not stacked, so a handler's mark survives its return.
const MOVS_R7_9: u16 = 0x2709

// `code` on a core of kind `kind` under both executors, each recording from the start (after
// `setup`), required to give the same report; the threaded machine answered.
recorded(kind: Kind, code: []const u16, regs: []const u32, handlers: [][2]u32, setup: Setup) -> Cpu = recorded_with(kind, code, regs, handlers, setup, masking_defaults())

// `recorded`, the report taking the options `o`.
recorded_with(kind: Kind, code: []const u16, regs: []const u32, handlers: [][2]u32, setup: Setup, o: MaskingOptions) -> Cpu
    var a: Cpu
    var b: Cpu

    a.kind = kind
    b.kind = kind

    machine(&a, code, regs, 0, handlers, setup)
    record_masking(&a, o)
    finish(&a, &run_match)

    machine(&b, code, regs, 0, handlers, setup)
    record_masking(&b, o)
    finish(&b, &run_threaded)

    val ta = masking_text(&a, 0)
    val tb = masking_text(&b, 0)
    assert(ta == tb, s"the executors agree on the report:\n$ta\n$tb")
    stop_masking(&a)
    b

// The longest interval's cycles, first and last instruction, or zeros for none.
longest(c: *Cpu) -> (u64, u32, u32) = masking_longest(c) match
    Some(v) -> (v.cycles, v.from, v.to)
    None -> (0, 0, 0)

// IRQ 0 enabled at priority `p`.
irq0_at(cpu: *Cpu, p: u32)
    store32(cpu, NVIC_ISER, 1)
    store32(cpu, NVIC_IPR, p)

irq0_kernel(cpu: *Cpu) = irq0_at(cpu, 0x80)
irq0_above(cpu: *Cpu) = irq0_at(cpu, 0x40)

timed(cpu: *Cpu) = configure_instruction_timing(cpu, true)

// SysTick reaching zero at clock 10, and every 10 after.
systick_10(cpu: *Cpu)
    store32(cpu, SYST_RVR, 9)
    store32(cpu, SYST_CSR, 7)

// ---------------------------------------------------------------------------------------------------
// Masked intervals.

@test("PRIMASK alone on the M0+: the interval runs from the CPSID to the CPSIE, in cycles")
mask_primask_m0()
    // 0: nop; cpsid i; nop x5; 14: cpsie i; bkpt
    val code: [9]u16 = [MASK_NOP, CPSID, MASK_NOP, MASK_NOP, MASK_NOP, MASK_NOP, MASK_NOP, CPSIE, BKPT]
    var c = recorded(Kind.V6m, code[..], [], [], &nothing)

    assert(longest(&c) == (6, 0x2, 0xE), s"${longest(&c)}")
    assert(masking_totals(&c) == (1, 6))
    stop_masking(&c)

@test("an interval is measured in the core's estimated cycles where it counts them")
mask_estimated()
    // cpsid i; ldr r1, [r4] (2 cycles); nop; cpsie i
    val code: [4]u16 = [CPSID, LDR_R1_R4, MASK_NOP, CPSIE]
    var c = recorded(Kind.V6m, code[..], [0, 0, 0, 0, LOG], [], &timed)
    assert(longest(&c) == (4, 0x0, 0x6), s"estimated: ${longest(&c)}")
    stop_masking(&c)

    c = recorded(Kind.V6m, code[..], [0, 0, 0, 0, LOG], [], &nothing)
    assert(longest(&c) == (3, 0x0, 0x6), s"unit: ${longest(&c)}")
    stop_masking(&c)

@test("BASEPRI alone on the M33: from the MSR that set it to the one that cleared it")
mask_basepri()
    // 0: msr basepri, r2; nop x3; 10: msr basepri, r3; bkpt
    val code: [8]u16 = [MSR_BASEPRI_R2_1, MSR_BASEPRI_2, MASK_NOP, MASK_NOP, MASK_NOP, MSR_BASEPRI_R3_1, MSR_BASEPRI_2, BKPT]
    var c = recorded(Kind.V8mMain, code[..], [0, 0, 0x80, 0], [], &nothing)

    assert(longest(&c) == (4, 0x0, 0xA), s"${longest(&c)}")
    assert(masking_totals(&c) == (1, 4))
    stop_masking(&c)

@test("PRIMASK and BASEPRI nested are one interval, until the last of them clears; apart they are two")
mask_nested()
    // 0: cpsid i; msr basepri, r2; nop; 8: cpsie i; nop; 12: msr basepri, r3; bkpt
    val nested: [9]u16 = [CPSID, MSR_BASEPRI_R2_1, MSR_BASEPRI_2, MASK_NOP, CPSIE, MASK_NOP, MSR_BASEPRI_R3_1, MSR_BASEPRI_2, BKPT]
    var c = recorded(Kind.V8mMain, nested[..], [0, 0, 0x80, 0], [], &nothing)

    assert(longest(&c) == (5, 0x0, 0xC), s"${longest(&c)}")
    assert(masking_totals(&c) == (1, 5))
    stop_masking(&c)

    // 0: cpsid i; nop; 4: cpsie i; 6: msr basepri, r2; nop x3; 16: msr basepri, r3; bkpt
    val apart: [11]u16 = [CPSID, MASK_NOP, CPSIE, MSR_BASEPRI_R2_1, MSR_BASEPRI_2, MASK_NOP, MASK_NOP, MASK_NOP, MSR_BASEPRI_R3_1, MSR_BASEPRI_2, BKPT]
    c = recorded(Kind.V8mMain, apart[..], [0, 0, 0x80, 0], [], &nothing)

    assert(longest(&c) == (4, 0x6, 0x10), s"${longest(&c)}")
    assert(masking_totals(&c) == (2, 6))
    val text = masking_text(&c, 0)
    assert(text.contains("masking core=0 rank=1 cycles=4 from=0x00000006 to=0x00000010\nmasking core=0 rank=2 cycles=2 from=0x00000000 to=0x00000004\n"), text)
    assert(text.contains("masking core=0 bucket=2-3 count=1\nmasking core=0 bucket=4-7 count=1\n"), text)
    stop_masking(&c)

@test("an exception taken above BASEPRI does not cut the interval: its handler's time is masked time")
mask_spans_exception()
    // 0: msr basepri, r2; 4: str r6, [r5] (IRQ 0 pending, at 0x40); isb; 10: nop;
    // 12: msr basepri, r3; bkpt; 18: the handler, movs r7, #9; bx lr
    val code: [11]u16 = [MSR_BASEPRI_R2_1, MSR_BASEPRI_2, STR_R6_R5, ISB_1, ISB_2, MASK_NOP, MSR_BASEPRI_R3_1, MSR_BASEPRI_2, BKPT, MOVS_R7_9, BX_LR]
    var c = recorded(Kind.V8mMain, code[..], [0, 0, 0x80, 0, LOG, NVIC_ISPR, 1], [[IRQ0, 18]], &irq0_above)

    assert(c.r[7] == 9, "the handler ran")
    // msr, str, isb, the handler's two, nop.
    assert(longest(&c) == (6, 0x0, 0xC), s"${longest(&c)}")
    assert(masking_totals(&c) == (1, 6))
    // Pending from the store, taken after the ISB.
    assert(latency_of(&c, IRQ0) == (1, 2, 2), s"${latency_of(&c, IRQ0)}")
    stop_masking(&c)

@test("on the M0+, a HardFault taken under PRIMASK is inside the interval")
mask_spans_hardfault()
    // 0: cpsid i; 2: svc (escalated to HardFault); 4: cpsie i; bkpt; 8: the handler, nop; bx lr
    val code: [6]u16 = [CPSID, SVC, CPSIE, BKPT, MASK_NOP, BX_LR]
    var c = recorded(Kind.V6m, code[..], [], [[HARD_FAULT, 8]], &nothing)

    assert(longest(&c) == (4, 0x0, 0x4), s"${longest(&c)}")
    // The SVC was never pending: it has no latency.
    assert(latency_of(&c, HARD_FAULT) == (0, 0, 0))
    stop_masking(&c)

@test("masking inside a handler counts as it does in thread mode")
mask_in_handler()
    // 0: str r6, [r5] (PendSV); isb; 6: bkpt; 8: PendSV's handler, cpsid i; nop; nop; 14: cpsie i; bx lr
    val code: [9]u16 = [STR_R6_R5, ISB_1, ISB_2, BKPT, CPSID, MASK_NOP, MASK_NOP, CPSIE, BX_LR]
    var c = recorded(Kind.V6m, code[..], [0, 0, 0, 0, LOG, ICSR, PENDSVSET], [[PENDSV, 8]], &nothing)

    assert(longest(&c) == (3, 0x8, 0xE), s"${longest(&c)}")
    assert(latency_of(&c, PENDSV) == (1, 2, 2), s"${latency_of(&c, PENDSV)}")
    stop_masking(&c)

@test("the return from an exception that clears FAULTMASK ends the interval, at the return")
mask_faultmask_return()
    // 0: str r6, [r5] (PendSV); isb; 6: bkpt; 8: PendSV's handler, cpsid f; nop; 12: bx lr
    val code: [8]u16 = [STR_R6_R5, ISB_1, ISB_2, BKPT, CPSID_F, MASK_NOP, BX_LR, BKPT]
    var c = recorded(Kind.V8mMain, code[..], [0, 0, 0, 0, LOG, ICSR, PENDSVSET], [[PENDSV, 8]], &nothing)

    assert(c.faultmask == 0 && c.stop == Stop.Breakpoint && c.pc == 6)
    assert(longest(&c) == (2, 0x8, 0xC), s"${longest(&c)}")
    stop_masking(&c)

@test("an interval still open when the run ends is reported up to the core's clock, to=end")
mask_open_at_end()
    // cpsid i; nop; nop; bkpt
    val code: [3]u16 = [CPSID, MASK_NOP, MASK_NOP]
    var c = recorded(Kind.V6m, code[..], [], [], &nothing)

    assert(masking_longest(&c).is_none() && masking_totals(&c) == (0, 0), "nothing closed")
    assert(masking_text(&c, 0) == "masking core=0 timing=unit cycles=3 intervals=1 masked=3 longest=3 from=0x00000000 to=end\nmasking core=0 rank=1 cycles=3 from=0x00000000 to=end\nmasking core=0 bucket=2-3 count=1\n", masking_text(&c, 0))
    assert(masking_text(&c, 3).starts_with("masking core=3 "), "the core named as asked")
    stop_masking(&c)

@test("the longest few are kept longest first, and every interval counts in the histogram")
mask_top()
    // Ten intervals of 1 to 10 nops, shortest first: cpsid i; nop x k; cpsie i.
    var code: Buf[u16] = buf()
    for k in 1..10
        code.push(CPSID)
        for i in 0..<k do code.push(MASK_NOP)
        code.push(CPSIE)
    var c = recorded(Kind.V6m, code.view(), [], [], &nothing)

    assert(masking_totals(&c) == (10, 65), s"${masking_totals(&c)}")
    val text = masking_text(&c, 0)
    assert(text.contains("rank=1 cycles=11 ") && text.contains("rank=8 cycles=4 ") && !text.contains("rank=9"), text)
    assert(text.contains("bucket=2-3 count=2\n") && text.contains("bucket=8-15 count=4\n"), text)
    stop_masking(&c)

// ---------------------------------------------------------------------------------------------------
// Latency.

@test("an IRQ held off by BASEPRI waits the masked remainder: pending at the store, taken after the MSR that unmasks")
latency_basepri()
    // 0: msr basepri, r2; 4: str r6, [r5] (IRQ 0 pending, at 0x80); nop x4; 14: msr basepri, r3; bkpt;
    // 20: the handler, movs r7, #9; bx lr
    val code: [12]u16 = [MSR_BASEPRI_R2_1, MSR_BASEPRI_2, STR_R6_R5, MASK_NOP, MASK_NOP, MASK_NOP, MASK_NOP, MSR_BASEPRI_R3_1, MSR_BASEPRI_2, BKPT, MOVS_R7_9, BX_LR]
    var c = recorded(Kind.V8mMain, code[..], [0, 0, 0x80, 0, LOG, NVIC_ISPR, 1], [[IRQ0, 20]], &irq0_kernel)

    assert(c.r[7] == 9, "the handler ran")
    // Pending at cycle 1; masked until the MSR at cycle 6, which retires at 7; entry takes nothing.
    assert(latency_of(&c, IRQ0) == (1, 6, 6), s"${latency_of(&c, IRQ0)}")
    assert(longest(&c) == (6, 0x0, 0xE), s"${longest(&c)}")
    val text = masking_text(&c, 0)
    assert(text.contains("latency core=0 exception=irq0 taken=1 max=6 mean=6\nlatency core=0 exception=irq0 bucket=4-7 count=1\n"), text)
    stop_masking(&c)

@test("two IRQs pending together: the second is tail-chained, and waits the first's handler too")
latency_tail_chained()
    // As latency_basepri, with IRQs 0 and 1 pending at once; each handler is two instructions.
    val code: [12]u16 = [MSR_BASEPRI_R2_1, MSR_BASEPRI_2, STR_R6_R5, MASK_NOP, MASK_NOP, MASK_NOP, MASK_NOP, MSR_BASEPRI_R3_1, MSR_BASEPRI_2, BKPT, MOVS_R7_9, BX_LR]
    var c = recorded(Kind.V8mMain, code[..], [0, 0, 0x80, 0, LOG, NVIC_ISPR, 3], [[IRQ0, 20], [IRQ0 + 1, 20]], &two_irqs)

    assert(latency_of(&c, IRQ0) == (1, 6, 6), s"${latency_of(&c, IRQ0)}")
    assert(latency_of(&c, IRQ0 + 1) == (1, 8, 8), s"${latency_of(&c, IRQ0 + 1)}")
    stop_masking(&c)

two_irqs(cpu: *Cpu)
    store32(cpu, NVIC_ISER, 3)
    store32(cpu, NVIC_IPR, 0x8080)

@test("on the M0+, PendSV held off by PRIMASK waits from the store that pended it to the CPSIE")
latency_pendsv()
    // exc_primask's guest: 0: cpsid i; 2: str r6, [r5]; isb; movs; log; 12: cpsie i; ...; 20: PendSV
    val code: [13]u16 = [
        CPSID, STR_R6_R5, ISB_1, ISB_2,
        MOVS_R0 | 1, LOG_R0, CPSIE,
        MOVS_R0 | 2, LOG_R0, BKPT,
        MOVS_R0 | 14, LOG_R0, BX_LR]
    var c = recorded(Kind.V6m, code[..], [0, 0, 0, 0, LOG, ICSR, PENDSVSET], [[PENDSV, 20]], &nothing)

    assert(logged(&c, [1, 14, 2]))
    assert(latency_of(&c, PENDSV) == (1, 5, 5), s"${latency_of(&c, PENDSV)}")
    assert(longest(&c) == (5, 0x0, 0xC), s"${longest(&c)}")
    stop_masking(&c)

@test("an exception cleared while pending forgets when it became pending; pended again, it waits from then")
latency_cleared()
    // 0: cpsid i; str r6, [r5] (set); str r7, [r5] (clear); nop; nop; 10: str r6, [r5]; 12: cpsie i;
    // bkpt; 16: PendSV, bx lr
    val code: [9]u16 = [CPSID, STR_R6_R5, STR_R7_R5, MASK_NOP, MASK_NOP, STR_R6_R5, CPSIE, BKPT, BX_LR]
    var c = recorded(Kind.V6m, code[..], [0, 0, 0, 0, LOG, ICSR, PENDSVSET, PENDSVCLR], [[PENDSV, 16]], &nothing)

    assert(latency_of(&c, PENDSV) == (1, 2, 2), s"${latency_of(&c, PENDSV)}")
    stop_masking(&c)

@test("SysTick is pending from the cycle it reached zero, under PRIMASK on the M0+ and on the M33")
latency_systick()
    // 0: cpsid i; nop x15; 32: cpsie i; bkpt; 36: SysTick, bx lr
    var code: Buf[u16] = buf()
    code.push(CPSID)
    for i in 0..<15 do code.push(MASK_NOP)
    code.push(CPSIE)
    code.push(BKPT)
    code.push(BX_LR)

    for kind in [Kind.V6m, Kind.V8mMain]
        var c = recorded(kind, code.view(), [], [[SYSTICK, 36]], &systick_10)

        // Zero at 10; the CPSIE at 16 retires at 17.
        assert(latency_of(&c, SYSTICK) == (1, 7, 7), s"${latency_of(&c, SYSTICK)}")
        assert(longest(&c) == (16, 0x0, 0x20), s"${longest(&c)}")
        assert(masking_text(&c, 0).contains("latency core=0 exception=systick taken=1 max=7 mean=7\n"))
        stop_masking(&c)

// ---------------------------------------------------------------------------------------------------
// The site table and the number of ranks.

val SITES_ON: MaskingOptions = MaskingOptions(true, 8, null)
// movs r0, #3; subs r0, #1; bne to the CPSID at 0x2 (offset -6); movs r0, #2; beq to 0xE (offset +1);
// b to the CPSID at 0x2 (offset -7).
const MOVS_R0_3: u16 = 0x2003
const MOVS_R0_2: u16 = 0x2002
const SUBS_R0_1: u16 = 0x3801
const BNE_BACK_6: u16 = 0xD1FA
const BEQ_FWD_1: u16 = 0xD001
const B_BACK_7: u16 = 0xE7F9

// `text` without its site lines.
without_sites(text: string) -> string
    var out = ""
    var from = 0
    for i in 0..<text.len
        if text[i] != u8('\n') then continue
        val line = text[from..<i + 1]
        if !line.contains(" site from=") then out = s"$out$line"
        from = i + 1
    out

// Where `text` lists a line starting `prefix`: how many do.
lines_with(text: string, prefix: string) -> int
    var n = 0
    var from = 0
    for i in 0..<text.len
        if text[i] != u8('\n') then continue
        if text[from..<i + 1].starts_with(prefix) then n += 1
        from = i + 1
    n

@test("two sites of different lengths and counts are listed longest first, each with its own longest and count")
sites_two()
    // 0: movs r0, #3; 2: cpsid i; 4: nop; 6: cpsie i; 8: subs; A: bne 2 (three times round); C: cpsid i;
    // E, 10, 12: nop; 14: cpsie i; 16: bkpt
    val code: [12]u16 = [MOVS_R0_3, CPSID, MASK_NOP, CPSIE, SUBS_R0_1, BNE_BACK_6, CPSID, MASK_NOP, MASK_NOP, MASK_NOP, CPSIE, BKPT]
    var c = recorded_with(Kind.V6m, code[..], [], [], &nothing, SITES_ON)

    val text = masking_text(&c, 0)
    assert(text.contains("masking core=0 site from=0x0000000c to=0x00000014 longest=4 count=1\nmasking core=0 site from=0x00000002 to=0x00000006 longest=2 count=3\n"), text)
    assert(lines_with(text, "masking core=0 site ") == 2, text)
    assert(masking_totals(&c) == (4, 10), s"${masking_totals(&c)}")
    stop_masking(&c)

@test("one start with two ends is two sites")
sites_same_start()
    // 0: movs r0, #2; 2: cpsid i; 4: nop; 6: subs; 8: beq E; A: cpsie i; C: b 2; E: cpsie i; 10: bkpt
    val code: [9]u16 = [MOVS_R0_2, CPSID, MASK_NOP, SUBS_R0_1, BEQ_FWD_1, CPSIE, B_BACK_7, CPSIE, BKPT]
    var c = recorded_with(Kind.V6m, code[..], [], [], &nothing, SITES_ON)

    val text = masking_text(&c, 0)
    assert(text.contains("site from=0x00000002 to=0x0000000a longest=4 count=1\nmasking core=0 site from=0x00000002 to=0x0000000e longest=4 count=1\n"), text)
    assert(lines_with(text, "masking core=0 site ") == 2, text)
    stop_masking(&c)

@test("an interval open at the end is a site of its own, to=end, beside the closed ones")
sites_open_at_end()
    // 0: cpsid i; 2: nop; 4: cpsie i; 6: cpsid i; 8, A: nop
    val code: [6]u16 = [CPSID, MASK_NOP, CPSIE, CPSID, MASK_NOP, MASK_NOP]
    var c = recorded_with(Kind.V6m, code[..], [], [], &nothing, SITES_ON)

    val text = masking_text(&c, 0)
    assert(text.contains("masking core=0 site from=0x00000006 to=end longest=3 count=1\nmasking core=0 site from=0x00000000 to=0x00000004 longest=2 count=1\n"), text)
    // Asking again reports the same: the open interval is not added to the table.
    assert(masking_text(&c, 0) == text)
    stop_masking(&c)

@test("each core keeps its own site table")
sites_per_core()
    val first: [4]u16 = [CPSID, MASK_NOP, CPSIE, BKPT]
    val second: [5]u16 = [MASK_NOP, MASK_NOP, CPSID, CPSIE, BKPT]
    var a = recorded_with(Kind.V6m, first[..], [], [], &nothing, SITES_ON)
    var b = recorded_with(Kind.V6m, second[..], [], [], &nothing, SITES_ON)

    val ta = masking_text(&a, 0)
    val tb = masking_text(&b, 1)
    assert(ta.contains("masking core=0 site from=0x00000000 to=0x00000004 longest=2 count=1\n") && lines_with(ta, "masking core=0 site ") == 1, ta)
    assert(tb.contains("masking core=1 site from=0x00000004 to=0x00000006 longest=1 count=1\n") && lines_with(tb, "masking core=1 site ") == 1, tb)
    stop_masking(&a)
    stop_masking(&b)

@test("a site's addresses are named by the image's symbols where there are any, and bare where not")
sites_symbols()
    // 0: nop; 2: cpsid i; 4: nop; 6: cpsie i; 8: bkpt. `tick` holds 0 to 5; 6 is in no symbol.
    val code: [5]u16 = [MASK_NOP, CPSID, MASK_NOP, CPSIE, BKPT]
    var names: Buf[ImageSymbol] = buf()
    names.push(ImageSymbol(0, 6, "tick", 6))
    val table: &SymbolTable = SymbolTable(names, buf())
    var named = recorded_with(Kind.V6m, code[..], [], [], &nothing, SITES_ON.with_table(table))
    assert(masking_text(&named, 0).contains("masking core=0 site from=0x00000002 (tick+0x2) to=0x00000006 longest=2 count=1\n"), masking_text(&named, 0))
    stop_masking(&named)

    var bare = recorded_with(Kind.V6m, code[..], [], [], &nothing, SITES_ON)
    assert(masking_text(&bare, 0).contains("masking core=0 site from=0x00000002 to=0x00000006 longest=2 count=1\n"), masking_text(&bare, 0))
    stop_masking(&bare)

    var starts: Buf[ImageSymbol] = buf()
    starts.push(ImageSymbol(2, 4, "tick", 6))
    starts.push(ImageSymbol(6, 4, "tock", 0xA))
    val both: &SymbolTable = SymbolTable(starts, buf())
    var at_start = recorded_with(Kind.V6m, code[..], [], [], &nothing, SITES_ON.with_table(both))
    assert(masking_text(&at_start, 0).contains("site from=0x00000002 (tick) to=0x00000006 (tock) longest=2 count=1\n"), masking_text(&at_start, 0))
    stop_masking(&at_start)

@test("the site table is the one thing the options add: without sites the report is what it was, and with them it only gains lines")
sites_report_unchanged()
    var code: Buf[u16] = buf()
    for k in 1..4
        code.push(CPSID)
        for i in 0..<k do code.push(MASK_NOP)
        code.push(CPSIE)
    code.push(CPSID)
    var plain = recorded(Kind.V6m, code.view(), [], [], &nothing)
    var explicit = recorded_with(Kind.V6m, code.view(), [], [], &nothing, MaskingOptions(false, 8, null))
    var sited = recorded_with(Kind.V6m, code.view(), [], [], &nothing, SITES_ON)

    val off = masking_text(&plain, 0)
    assert(masking_text(&explicit, 0) == off && !off.contains(" site "), off)
    assert(without_sites(masking_text(&sited, 0)) == off, masking_text(&sited, 0))
    assert(lines_with(masking_text(&sited, 0), "masking core=0 site ") == 5, masking_text(&sited, 0))
    stop_masking(&plain)
    stop_masking(&explicit)
    stop_masking(&sited)

@test("a table that grows past its first size keeps every site")
sites_many()
    // 100 intervals, each from its own CPSID to its own CPSIE: 100 sites.
    var code: Buf[u16] = buf()
    for k in 0..<100
        code.push(CPSID)
        code.push(CPSIE)
    code.push(BKPT)
    var c = recorded_with(Kind.V6m, code.view(), [], [], &nothing, SITES_ON)
    val text = masking_text(&c, 0)
    assert(lines_with(text, "masking core=0 site ") == 100, text)
    assert(text.contains("site from=0x000000c8 to=0x000000ca longest=1 count=1\n"), text)
    stop_masking(&c)

@test("--masking-ranks: n longest intervals are listed, n from 1 to 4096, and the default is 8")
ranks_listed()
    // Twenty-six intervals of 2 to 27 cycles: cpsid i; nop x k; cpsie i.
    var code: Buf[u16] = buf()
    for k in 1..26
        code.push(CPSID)
        for i in 0..<k do code.push(MASK_NOP)
        code.push(CPSIE)
    var one = recorded_with(Kind.V6m, code.view(), [], [], &nothing, MaskingOptions(false, 1, null))
    val t1 = masking_text(&one, 0)
    assert(lines_with(t1, "masking core=0 rank=") == 1 && t1.contains("rank=1 cycles=27 "), t1)
    assert(t1.contains("intervals=26 "), t1)
    stop_masking(&one)

    var twenty = recorded_with(Kind.V6m, code.view(), [], [], &nothing, MaskingOptions(false, 20, null))
    val t20 = masking_text(&twenty, 0)
    assert(lines_with(t20, "masking core=0 rank=") == 20 && t20.contains("rank=20 cycles=8 ") && !t20.contains("rank=21"), t20)
    stop_masking(&twenty)

    var plain = recorded(Kind.V6m, code.view(), [], [], &nothing)
    assert(lines_with(masking_text(&plain, 0), "masking core=0 rank=") == 8, masking_text(&plain, 0))
    stop_masking(&plain)

    var most = recorded_with(Kind.V6m, code.view(), [], [], &nothing, MaskingOptions(true, 4096, null))
    assert(lines_with(masking_text(&most, 0), "masking core=0 rank=") == 26, masking_text(&most, 0))
    stop_masking(&most)

@test("--masking-ranks takes 1 to 4096 and refuses anything else, saying so")
ranks_parsed()
    assert(masking_ranks("1") == Ok(1) && masking_ranks("8") == Ok(8) && masking_ranks("4096") == Ok(4096))
    for bad in ["0", "5000", "4097", "-1", "", "many", "3.5"]
        masking_ranks(bad) match
            Ok(n) -> assert(false, s"$bad was taken as $n")
            Err(why) -> assert(why.starts_with("--masking-ranks takes a number from 1 to 4096"), why)

// ---------------------------------------------------------------------------------------------------
// Off.

@test("with the report off nothing is recorded, and the report is empty")
mask_off()
    val code: [4]u16 = [CPSID, MASK_NOP, CPSIE, BKPT]
    var c = run_both(code[..], [], 0, [], &nothing)

    assert(c.masking == null && !records_masking(&c))
    assert(masking_text(&c, 0) == "" && masking_longest(&c).is_none() && latency_of(&c, PENDSV) == (0, 0, 0))

    // Stopped, a core records nothing more.
    var d = recorded(Kind.V6m, code[..], [], [], &nothing)
    stop_masking(&d)
    assert(d.masking == null && masking_text(&d, 0) == "")

@test("exception names: the system exceptions, IRQs by number, and Non-secure copies")
mask_names()
    assert(exception_name(SYSTICK) == "systick" && exception_name(PENDSV) == "pendsv" && exception_name(NMI) == "nmi")
    assert(exception_name(IRQ0) == "irq0" && exception_name(IRQ0 + 42) == "irq42")
    assert(exception_name(NS_BANK + SYSTICK) == "systick_ns" && exception_name(9) == "exception9")
