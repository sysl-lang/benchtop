module sh.sysl.benchtop.v6m
@tests

@test("Thumb ADD PC: compiler jump tables use instruction PC plus four, clear bit zero, preserve flags and respect budgets")
add_pc()
    for exec in [&run_match, &run_threaded]
        for reg in 0..<15
            for offset in [0u32, 1, 4, 5, 0xFFFFFFFC]
                var cpu: Cpu
                reset(&cpu, test_memory, [], 0)
                store16(&cpu, 0, u16(0x4487 | (u32(reg) << 3)))
                store16(&cpu, 2, 0xBE00)
                store16(&cpu, 4, 0xBE00)
                store16(&cpu, 8, 0xBE00)
                cpu.r[reg] = offset
                cpu.nz = 0x80000000
                cpu.c = 1
                cpu.va = 0x7FFFFFFF
                cpu.vb = 1
                cpu.vr = 0x80000000
                cpu.limit = 1
                exec(&cpu)
                assert(cpu.stop == Stop.Running && cpu.retired == 1)
                assert(cpu.pc == ((4 +% offset) & ~1), s"r$reg offset $offset -> ${cpu.pc}")
                assert(flag_n(&cpu) == 1 && !flag_z(&cpu) && cpu.c == 1 && flag_v(&cpu) == 1)
                if offset != 0xFFFFFFFC
                    cpu.limit = 2
                    exec(&cpu)
                    assert(cpu.stop == Stop.Breakpoint && cpu.retired == 1)
        var bad: Cpu
        reset(&bad, test_memory, [], 0)
        store16(&bad, 0, 0x44FF) // ADD PC, PC is unpredictable; reject it.
        bad.limit = 1
        exec(&bad)
        assert(bad.stop == Stop.Undefined)
