module sh.sysl.benchtop.v6m

// What a debugger needs of a core besides its registers: breakpoints, and a step of one instruction.
//
// **A breakpoint changes no byte of the guest's memory.** The addresses are kept beside the records
// (`Memory.debug_breaks`), and a record decoded at one is a `Bkpt` marked `DEBUG_BREAK`, which stops
// the core there with the instruction not run. Setting or clearing one forgets the records that read
// the address — its own, the compare before it a branch may be fused with, and an IT block it is in —
// so the next decode sees it; flash and ROM take a breakpoint exactly as RAM does, and a read of the
// address still answers the guest's instruction.
//
// **A guest's own `BKPT` stops the core as before** (`stop_here`); a debugger's stops it without
// touching anything else, so the guest runs on from it as if nothing had happened.
//
// **A watchpoint is its core's, and costs an access nothing unless the access is to a page it covers.**
// While a core holds any, it reads through tables of its own (`watch_views`): copies of the page table
// it would read by, with every page a watchpoint covers cleared, from 3 bytes before the range so that
// a store straddling into it is caught too. An access to such a page takes the slow path, as one to a
// device does, and only the slow path looks at the watchpoints: an instruction's load or store that
// reaches one stops the core before it (`watch_reached`), as an access nothing answers does; any other
// access there, the instruction's own fetch, exception stacking or the host's, is made in place
// through the table left whole. The debugger then runs the instruction once with the watchpoints not
// looked at (`debug_step`), so the core stops after it, the access made. The other core, and a DMA or
// any other bus master writing the memory itself, never see the copies.

import sysl.raw.ptr_cast

/** How many breakpoints a debugger may hold at once, for both cores. */
const DEBUG_BREAKS: usize = 64

/** A `Bkpt` record's `imm` where a debugger's breakpoint made it: no `BKPT` encodes it (its immediate
 * is 8 bits). */
const DEBUG_BREAK: u32 = 0x100

/** Whether a debugger holds a breakpoint at `a` on `cpu`'s memory. */
debug_break_at(cpu: *Cpu, a: u32) -> bool
    val mem = cpu.mem
    for i in 0..<mem.debug_break_count do if mem.debug_breaks[i] == a then return true
    false

/** The record of an instruction a debugger holds a breakpoint at. */
private[v6m] debug_record(into: *Insn)
    into.op = Op.Bkpt
    into.a = 0
    into.b = 0
    into.c = 0
    into.imm = DEBUG_BREAK

/** The core reached a debugger's breakpoint at `ip`, `n` instructions retired: it stops there, the
 * instruction not run, and nothing else of its state changes. */
private[v6m] debug_stop(cpu: *Cpu, ip: *Insn, n: u64)
    if cpu.stop != Stop.Running then return

    val at = addr_of(cpu, ip)

    halt(cpu, Stop.Breakpoint, at)
    cpu.pc = at
    cpu.retired = n

/** Whether `cpu` has stopped at a debugger's breakpoint, rather than a `BKPT` of the guest's. */
at_debug_break(cpu: *Cpu) -> bool = cpu.stop == Stop.Breakpoint && debug_break_at(cpu, cpu.pc)

/** Hold a breakpoint at `a` for every core on `mem`; holding one already is no change. False where `a`
 * is not code the cores can run, or `DEBUG_BREAKS` are held. Only while no core runs. */
set_debug_break(mem: &sync Memory, a: u32) -> bool
    if mem.code_offset(a) == NO_CODE then return false
    for i in 0..<mem.debug_break_count do if mem.debug_breaks[i] == a then return true
    if mem.debug_break_count == DEBUG_BREAKS then return false

    mem.debug_breaks[mem.debug_break_count] = a
    mem.debug_break_count += 1
    debug_code_changed(mem, a)
    true

/** Let go of the breakpoint at `a`; false where none is held there. Only while no core runs. */
clear_debug_break(mem: &sync Memory, a: u32) -> bool
    for i in 0..<mem.debug_break_count
        if mem.debug_breaks[i] != a then continue
        mem.debug_break_count -= 1
        mem.debug_breaks[i] = mem.debug_breaks[mem.debug_break_count]
        debug_code_changed(mem, a)
        return true
    false

// Every record that reads the instruction at `a`: from 16 bytes before it, for an IT block's, to 20
// after, on either core.
private debug_code_changed(mem: &sync Memory, a: u32)
    val offset = mem.code_offset(a)
    if offset == NO_CODE then return

    val top = u32(mem.decoded.len - 1) * 2
    forget_decoded(mem, if offset >= 16 then offset - 16 else 0, if offset + 20 < top then offset + 20 else top)

/** Make a core a debugger has held ready to run again: a stop it made is cleared, and where it is inside
 * an IT block, the rest of the block is decoded under its ITSTATE again, since a breakpoint set or
 * cleared there forgot the block's records. */
debug_resume(cpu: *Cpu)
    cpu.watch_hit = 0
    cpu.watch_done = 0
    if cpu.stop != Stop.Running
        cpu.stop = Stop.Running
        cpu.stop_at = 0

    if cpu.it != 0 && cpu.mem.is_code(cpu.pc) then decode_block(cpu, cpu.pc & ~1, cpu.it)

/** Run one instruction on `cpu`, the one at its `pc` even where a debugger holds a breakpoint there,
 * which is held again after it. Answers whether the core ran: one stopped, or asleep, runs nothing, and
 * a sleeping core is woken by its board running, not by a step. An exception pending and enabled is
 * taken first, as on the hardware, and the step runs its handler's first instruction.
 *
 * An instruction that reaches a watchpoint, this one or the one a watchpoint stopped the core before,
 * runs with the watchpoints not looked at, so it completes, and its kind is left in `watch_done`. */
debug_step(cpu: *Cpu, mem: &sync Memory) -> bool
    val reached = cpu.watch_hit
    debug_resume(cpu)
    if cpu.sleeping then return false

    val at = cpu.pc
    val held = clear_debug_break(mem, at)
    val before = cpu.retired

    set_limit(cpu, 0xFFFFFFFFFFFFFFFF)
    cpu.watch_off = reached != 0
    run_single(cpu)
    cpu.watch_off = false
    var done = reached
    if done == 0 && cpu.watch_hit != 0
        done = cpu.watch_hit
        cpu.watch_hit = 0
        cpu.stop = Stop.Running
        cpu.stop_at = 0
        set_limit(cpu, 0xFFFFFFFFFFFFFFFF)
        cpu.watch_off = true
        run_single(cpu)
        cpu.watch_off = false
    cpu.watch_done = done
    if held then set_debug_break(mem, at)
    // The step's breakpoint, held again, forgot the records of the block the core may now be in.
    if held && cpu.stop == Stop.Running && cpu.it != 0 && cpu.mem.is_code(cpu.pc) then decode_block(cpu, cpu.pc & ~1, cpu.it)

    cpu.retired != before || cpu.pc != at

/** xPSR written by a debugger: the flags, Q and GE. The exception number, the T bit and ITSTATE are
 * the core's state, which a debugger does not move. */
set_debug_xpsr(cpu: *Cpu, psr: u32)
    set_apsr(cpu, psr)
    if cpu.dsp then cpu.ge = (psr >> 16) & 0xF

/** The main stack pointer written by a debugger, whichever stack is in use. */
set_main_sp(cpu: *Cpu, sp: u32)
    if on_process_stack(cpu) then cpu.sp_other = sp else cpu.r[13] = sp

/** The process stack pointer written by a debugger. */
set_process_sp(cpu: *Cpu, sp: u32)
    if on_process_stack(cpu) then cpu.r[13] = sp else cpu.sp_other = sp

/** CONTROL's nPRIV and SPSEL written by a debugger: in thread mode a change of SPSEL changes which
 * stack pointer `SP` is, as `MSR CONTROL` does. */
set_debug_control(cpu: *Cpu, x: u32)
    val switched = cpu.ipsr == 0 && (cpu.control ^ x) & 2 != 0

    if switched
        val sp = cpu.r[13]
        cpu.r[13] = cpu.sp_other
        cpu.sp_other = sp

    cpu.control = (cpu.control & ~3u32) | (x & 3)

// ---------------------------------------------------------------------------------------------------
// Watchpoints.

/** How many watchpoints a debugger may hold on each core: the Cortex-M7's DWT has four comparators. */
const DEBUG_WATCHES: usize = 4

/** A watchpoint's kind, numbered as gdb's `Z2`, `Z3` and `Z4` number them. */
const WATCH_WRITE: u32 = 2
const WATCH_READ: u32 = 3
const WATCH_ACCESS: u32 = 4

/** The `len` bytes at `at`, watched for stores (`WATCH_WRITE`), loads (`WATCH_READ`) or either. */
struct Watch
    at: u32
    len: u32
    kind: u32

/** Watch the `len` bytes at `a` on `cpu` for `kind`; holding the same one already is no change. False
 * where `len` is 0, `kind` is not a watchpoint's, or `DEBUG_WATCHES` are held. Only while no core runs. */
set_debug_watch(cpu: *Cpu, kind: u32, a: u32, len: u32) -> bool
    if len == 0 || kind < WATCH_WRITE || kind > WATCH_ACCESS then return false
    for i in 0..<usize(cpu.watch_count) do if same_watch(cpu.watches[i], kind, a, len) then return true
    if usize(cpu.watch_count) == DEBUG_WATCHES then return false

    cpu.watches[usize(cpu.watch_count)] = Watch(a, len, kind)
    cpu.watch_count += 1
    watch_views(cpu)
    true

/** Let go of the watchpoint of `kind` on the `len` bytes at `a`; false where none is held. Only while
 * no core runs. */
clear_debug_watch(cpu: *Cpu, kind: u32, a: u32, len: u32) -> bool
    for i in 0..<usize(cpu.watch_count)
        if !same_watch(cpu.watches[i], kind, a, len) then continue
        cpu.watch_count -= 1
        cpu.watches[i] = cpu.watches[usize(cpu.watch_count)]
        watch_views(cpu)
        return true
    false

/** Let go of every watchpoint on `cpu`. Only while no core runs. */
clear_debug_watches(cpu: *Cpu)
    if cpu.watch_count == 0 then return
    cpu.watch_count = 0
    watch_views(cpu)

private same_watch(w: Watch, kind: u32, a: u32, len: u32) -> bool = w.kind == kind && w.at == a && w.len == len

/** The page table the core reads by with no watchpoint held: the memory's, or its own Non-secure one. */
private[v6m] unwatched_table(cpu: *Cpu) -> *usize =
    if cpu.ns then cpu.mem.ns_page_table[usize(cpu.core & 1)] else &cpu.mem.page_table[0]

/** Make the tables the core reads through agree with its watchpoints and with the tables they copy:
 * called when either changes. With none held, the core reads the memory's own again. */
private[v6m] watch_views(cpu: *Cpu)
    val mem = cpu.mem
    val ns_table = mem.ns_page_table[usize(cpu.core & 1)]
    if cpu.watch_count == 0
        if cpu.ns_ready && cpu.ns_pages != ns_table then cpu.ns_pages = ns_table
        val table = if cpu.ns then cpu.ns_pages else &mem.page_table[0]
        if cpu.pages != table then cpu.pages = table
        return

    if cpu.watch_secure == null then cpu.watch_secure = ptr_cast(c_calloc(usize(PAGES), sizeof(usize)))
    watched_copy(cpu, &mem.page_table[0], cpu.watch_secure)
    if cpu.ns_ready
        if cpu.watch_ns == null then cpu.watch_ns = ptr_cast(c_calloc(usize(PAGES), sizeof(usize)))
        watched_copy(cpu, ns_table, cpu.watch_ns)
        if cpu.ns_pages != cpu.watch_ns then cpu.ns_pages = cpu.watch_ns
    val table = if cpu.ns then cpu.ns_pages else cpu.watch_secure
    if cpu.pages != table then cpu.pages = table

// `from` into `to`, each entry written once, with every page a watchpoint covers 0.
private watched_copy(cpu: *Cpu, from: *usize, to: *usize)
    var first: [DEBUG_WATCHES]u32 = [0; DEBUG_WATCHES]
    var last: [DEBUG_WATCHES]u32 = [0; DEBUG_WATCHES]
    val count = usize(cpu.watch_count)
    for i in 0..<count
        val w = cpu.watches[i]
        first[i] = (if w.at >= 3 then w.at - 3 else 0) >> PAGE_SHIFT
        val end = u64(w.at) + u64(w.len) - 1
        last[i] = u32(if end > 0xFFFFFFFF then 0xFFFFFFFF else end) >> PAGE_SHIFT
    for p in 0..<PAGES
        var covered = false
        for i in 0..<count do if u32(p) >= first[i] && u32(p) <= last[i] then covered = true
        to[p] = if covered then 0 else from[p]

/** The page the `width` bytes at `a` are on in the table the watchpoints leave whole, 0 where that
 * table has none either. */
@noinline
@cold
private[v6m] unwatched_page(cpu: *Cpu, a: u32, width: u32) -> usize
    val seen = cpu.pages
    cpu.pages = unwatched_table(cpu)
    val page = page_for(cpu, a, width)
    cpu.pages = seen
    page

/** A store made in place through the table the watchpoints leave whole, as the fast path would make
 * it; false where that table has no page for it either. */
@noinline
@cold
private[v6m] unwatched_write(cpu: *Cpu, a: u32, width: u32, x: u32) -> bool
    val seen = cpu.pages
    cpu.pages = unwatched_table(cpu)
    val page = store_page(cpu, a, width)
    if page != 0
        host_write(page, a, width, x)
        stored(cpu, a, width)
    cpu.pages = seen
    page != 0

/** The instruction's load (`store` false) or store of the `width` bytes at `a` reaches a watchpoint of
 * the kind: the core stops before it, the first watched byte in `watch_at`. False where none is
 * reached, or the instruction runs with the watchpoints not looked at. */
@noinline
@cold
private[v6m] watch_reached(cpu: *Cpu, a: u32, width: u32, store: bool) -> bool
    if cpu.watch_off || cpu.stop != Stop.Running then return false
    val other = if store then WATCH_READ else WATCH_WRITE
    for i in 0..<usize(cpu.watch_count)
        val w = cpu.watches[i]
        if w.kind == other || u64(a) >= u64(w.at) + u64(w.len) || u64(w.at) >= u64(a) + u64(width) then continue
        cpu.watch_hit = w.kind
        cpu.watch_at = if a > w.at then a else w.at
        halt(cpu, Stop.Breakpoint, cpu.watch_at)
        return true
    false
