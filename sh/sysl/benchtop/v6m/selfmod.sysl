module sh.sysl.benchtop.v6m
@tests

// Code that writes code: a store over an instruction already decoded is run as the new instruction
// the next time control reaches it, under both executors, including where the instruction written is
// the branch a compare before it was fused with.

// 0: adds r2, #1        2: cmp r3, #1        4: beq 12           6: movs r3, #1
// 8: strh r1, [r0, #0]  10: b 0              12: bkpt
@test("a store over a decoded instruction runs the new one the next time through")
smc_rewrite()
    val code: [7]u16 = [0x3201, 0x2B01, 0xD002, 0x2301, 0x8001, 0xE7F9, 0xBE00]
    var cpu: Cpu

    for exec in [&run_match, &run_threaded]
        // r1: adds r2, #16
        program(&cpu, exec, code[..], 0, 0x3210, 1000)
        assert(cpu.stop == Stop.Breakpoint && cpu.stop_at == 12, s"${cpu.stop} at ${cpu.stop_at}")
        assert(cpu.r[2] == 17, s"r2 = ${cpu.r[2]}: the first adds was run again")
        assert(load16(&cpu, 0) == 0x3210)

// 0: movs r5, #5        2: adds r2, #1       4: cmp r2, r5       6: bne 2
// 8: cmp r3, #1         10: beq 20           12: movs r3, #1     14: movs r5, #6
// 16: strh r1, [r0, #6] 18: b 2              20: bkpt
//
// The second time through, the compare is equal, so the stale fused pair would fall past the branch's
// record and never run what replaced it.
@test("a store over the branch of a fused compare and branch decodes the pair again")
smc_fused_branch()
    val code: [11]u16 = [0x2505, 0x3201, 0x42AA, 0xD1FC, 0x2B01, 0xD003, 0x2301, 0x2506, 0x80C1, 0xE7F6, 0xBE00]
    var cpu: Cpu

    for exec in [&run_match, &run_threaded]
        // r1: adds r4, #1
        program(&cpu, exec, code[..], 0, 0x3401, 1000)
        assert(cpu.stop == Stop.Breakpoint && cpu.stop_at == 20, s"${cpu.stop} at ${cpu.stop_at}")
        assert(cpu.r[2] == 6 && cpu.r[4] == 1, s"r2 = ${cpu.r[2]}, r4 = ${cpu.r[4]}")

@test("a store to data beside code leaves the code decoded, and a store over code forgets only it")
smc_forget_range()
    var cpu: Cpu
    val code: [4]u16 = [0x2001, 0x2002, 0x2003, 0xBE00]

    program(&cpu, &run_threaded, code[..], 0, 0, 1000)
    assert(cpu.stop == Stop.Breakpoint && cpu.r[0] == 3)
    for i in 0..<4 do assert(decoded[i].op != Op.Undecoded, s"record $i")

    // Data well past the code: nothing forgotten.
    store32(&cpu, 0x800, 7)
    for i in 0..<4 do assert(decoded[i].op != Op.Undecoded, s"record $i after a store to data")

    // A halfword at 4: its own record and the one before it.
    store16(&cpu, 4, 0x2009)
    assert(decoded[0].op != Op.Undecoded && decoded[3].op != Op.Undecoded)
    assert(decoded[1].op == Op.Undecoded && decoded[2].op == Op.Undecoded)

    // A byte at 0: record 0 alone.
    store8(&cpu, 0, 0x05)
    assert(decoded[0].op == Op.Undecoded)
