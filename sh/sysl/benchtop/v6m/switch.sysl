module sh.sysl.benchtop.v6m

// The `match` executor: one loop, one `match` over the record's case. It reads the same records and
// runs the same semantics as the threaded executor, so it is both the other half of the measurement
// and the reference the threaded chain is checked against.
//
// **On ARMv8-M it keeps ITSTATE as the architecture does**, in `cpu.it`, and tests each instruction of
// an IT block against it before running it: it does not read the condition the decoder baked into
// the record's handler, so it is an independent check of that baking. One instance of the loop is
// made for each kind, and on ARMv6-M the test folds away.
run_match(cpu: *Cpu)
    if cpu.fpu != Fpu.Absent then fp_begin(cpu)
    if is_baseline(cpu.kind) then run_match_of[false, false](cpu) else run_match_of[true, false](cpu)
    end_run(cpu)
    if cpu.fpu != Fpu.Absent then fp_end(cpu)

/** Execute one instruction using the shared reference semantics. */
run_single(cpu: *Cpu)
    if cpu.fpu != Fpu.Absent then fp_begin(cpu)
    if is_baseline(cpu.kind) then run_match_of[false, true](cpu) else run_match_of[true, true](cpu)
    end_run(cpu)
    if cpu.fpu != Fpu.Absent then fp_end(cpu)

// `V8`: the core has IT blocks. `SINGLE`: stop after one instruction.
run_match_of[const V8: bool, const SINGLE: bool](cpu: *Cpu)
    if !begin_run(cpu) then return

    var ip = insn_at(cpu, cpu.pc)
    var n = cpu.retired

    loop
        if SINGLE && n > cpu.retired
            cpu.pc = addr_of(cpu, ip)
            cpu.retired = n
            return
        if V8 && cpu.it != 0 && ip.op != Op.Undecoded
            val st = cpu.it

            cpu.it = it_advance(st)

            if !holds(cpu, st >> 4)
                // Skipped: it retires as a NOP of its own length, read from the halfword itself.
                val at = addr_of(cpu, ip)

                n += 1
                ip = &ip[if cpu.mem.is_code(at) && wide(load16(cpu, at)) then 2 else 1]
                continue

            // Run: kept for a stop on it (`end_run`).
            cpu.it_own = st
            cpu.it_at = n

        val executed = ip

        // A taken branch sets `target` and falls to the bottom; everything else continues.
        ip.op match
            Undecoded ->
                decode(cpu, addr_of(cpu, ip), ip)
                continue
            Undefined ->
                stop_here(cpu, ip, n, Stop.Undefined)
                return
            Outside ->
                stop_here(cpu, ip, n, Stop.Unmapped)
                return
            Leave ->
                if holds(cpu, ip.c) then return leave(cpu, ip, n)
            Bkpt ->
                stop_here(cpu, ip, n, Stop.Breakpoint)
                return
            Nop -> ()
            Barrier ->
                barrier(cpu)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, &ip[2]) then return
                ip = &ip[2]
                continue
            Svc ->
                val to = svc(cpu, ip, n)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, to) then return
                ip = to
                continue
            Cps ->
                cps(cpu, ip)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, &ip[1]) then return
                ip = &ip[1]
                continue
            Mrs ->
                mrs(cpu, ip)
                ip = &ip[1]
            Msr ->
                msr(cpu, ip)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, &ip[2]) then return
                ip = &ip[2]
                continue
            Wfi ->
                wfi(cpu)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, &ip[1]) then return
                ip = &ip[1]
                continue
            LslImm -> x_lsl_imm(cpu, ip)
            LsrImm -> x_lsr_imm(cpu, ip)
            AsrImm -> x_asr_imm(cpu, ip)
            AddsReg -> x_adds_reg(cpu, ip)
            SubsReg -> x_subs_reg(cpu, ip)
            AddsImm -> x_adds_imm(cpu, ip)
            SubsImm -> x_subs_imm(cpu, ip)
            MovsReg -> x_movs_reg(cpu, ip)
            MovsImm -> x_movs_imm(cpu, ip)
            CmpImm -> x_cmp_imm(cpu, ip)
            Ands -> x_ands(cpu, ip)
            Eors -> x_eors(cpu, ip)
            LslsReg -> x_lsls_reg(cpu, ip)
            LsrsReg -> x_lsrs_reg(cpu, ip)
            AsrsReg -> x_asrs_reg(cpu, ip)
            Adcs -> x_adcs(cpu, ip)
            Sbcs -> x_sbcs(cpu, ip)
            Rors -> x_rors(cpu, ip)
            Tst -> x_tst(cpu, ip)
            Negs -> x_negs(cpu, ip)
            CmpReg -> x_cmp_reg(cpu, ip)
            Cmn -> x_cmn(cpu, ip)
            Orrs -> x_orrs(cpu, ip)
            Muls -> x_muls(cpu, ip)
            Bics -> x_bics(cpu, ip)
            Mvns -> x_mvns(cpu, ip)
            AddHi -> x_add_hi(cpu, ip)
            MovHi -> x_mov_hi(cpu, ip)
            AddImm -> x_add_imm(cpu, ip)
            LoadConst -> x_load_const(cpu, ip)
            LdrLit -> if !x_ldr_lit(cpu, ip, n) then return stop_access(cpu, ip, n)
            StrReg -> if !x_str_reg(cpu, ip, n) then return stop_access(cpu, ip, n)
            StrhReg -> if !x_strh_reg(cpu, ip, n) then return stop_access(cpu, ip, n)
            StrbReg -> if !x_strb_reg(cpu, ip, n) then return stop_access(cpu, ip, n)
            LdrsbReg -> if !x_ldrsb_reg(cpu, ip, n) then return stop_access(cpu, ip, n)
            LdrReg -> if !x_ldr_reg(cpu, ip, n) then return stop_access(cpu, ip, n)
            LdrhReg -> if !x_ldrh_reg(cpu, ip, n) then return stop_access(cpu, ip, n)
            LdrbReg -> if !x_ldrb_reg(cpu, ip, n) then return stop_access(cpu, ip, n)
            LdrshReg -> if !x_ldrsh_reg(cpu, ip, n) then return stop_access(cpu, ip, n)
            StrImm -> if !x_str_imm(cpu, ip, n) then return stop_access(cpu, ip, n)
            LdrImm -> if !x_ldr_imm(cpu, ip, n) then return stop_access(cpu, ip, n)
            StrbImm -> if !x_strb_imm(cpu, ip, n) then return stop_access(cpu, ip, n)
            LdrbImm -> if !x_ldrb_imm(cpu, ip, n) then return stop_access(cpu, ip, n)
            StrhImm -> if !x_strh_imm(cpu, ip, n) then return stop_access(cpu, ip, n)
            LdrhImm -> if !x_ldrh_imm(cpu, ip, n) then return stop_access(cpu, ip, n)
            Sxth -> x_sxth(cpu, ip)
            Sxtb -> x_sxtb(cpu, ip)
            Uxth -> x_uxth(cpu, ip)
            Uxtb -> x_uxtb(cpu, ip)
            Rev -> x_rev(cpu, ip)
            Rev16 -> x_rev16(cpu, ip)
            Revsh -> x_revsh(cpu, ip)
            Push -> if !x_push(cpu, ip, n) then return stop_access(cpu, ip, n)
            Pop -> if !x_pop(cpu, ip, n) then return stop_access(cpu, ip, n)
            Stm -> if !x_stm(cpu, ip, n) then return stop_access(cpu, ip, n)
            Ldm -> if !x_ldm(cpu, ip, n) then return stop_access(cpu, ip, n)
            PopPc ->
                val target = x_pop_pc(cpu, ip, n) match
                    Some(t) -> t
                    None -> return stop_access(cpu, ip, n)
                val to = branch_to(cpu, target, ip, n)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, to) then return
                ip = to
                continue
            Bx ->
                val to = branch_to(cpu, cpu.r[ip.b], ip, n)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, to) then return
                ip = to
                continue
            MovPc | AddPc ->
                val to = insn_at(cpu, (cpu.r[ip.b] +% ip.imm) & ~1)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, to) then return
                ip = to
                continue
            Blx ->
                val to = insn_at(cpu, cpu.r[ip.b] & ~1)
                cpu.r[14] = (addr_of(cpu, ip) + 2) | 1
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, to) then return
                ip = to
                continue
            Bl ->
                cpu.r[14] = (addr_of(cpu, ip) + 4) | 1
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, target_of(ip)) then return
                ip = target_of(ip)
                continue
            B ->
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, target_of(ip)) then return
                ip = target_of(ip)
                continue
            Beq | Bne | Bcs | Bcc | Bmi | Bpl | Bvs | Bvc | Bhi | Bls | Bge | Blt | Bgt | Ble ->
                if holds(cpu, u32(ip.op) - u32(Op.Beq))
                    charge_instruction(cpu,executed)
                    n += 1
                    if taken(cpu, n, target_of(ip)) then return
                    ip = target_of(ip)
                    continue
            // ARMv8-M Mainline. A 32-bit instruction steps over its second record here, and the
            // bottom of the loop over its first.
            It -> cpu.it = ip.imm
            Cbz | Cbnz ->
                if (cpu.r[ip.a] == 0) == (ip.op == Op.Cbz)
                    charge_instruction(cpu,executed)
                    n += 1
                    if taken(cpu, n, target_of(ip)) then return
                    ip = target_of(ip)
                    continue
            ItAlu -> x_it_alu(cpu, ip)
            PushL -> if !x_push_l(cpu, ip, n) then return stop_access(cpu, ip, n)
            SpImm -> if !x_sp_imm(cpu, ip) then return stop_access(cpu, ip, n)
            SpReg -> if !x_sp_reg(cpu, ip) then return stop_access(cpu, ip, n)
            Cps8 ->
                cps8(cpu, ip)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, &ip[1]) then return
                ip = &ip[1]
                continue
            DpImm ->
                x_dp_imm(cpu, ip)
                ip = &ip[1]
            LogicImm ->
                x_logic_imm(cpu, ip, false)
                ip = &ip[1]
            LogicImmC ->
                x_logic_imm(cpu, ip, true)
                ip = &ip[1]
            DpReg ->
                x_dp_reg(cpu, ip)
                ip = &ip[1]
            ShiftReg ->
                x_shift_reg(cpu, ip)
                ip = &ip[1]
            Dsp ->
                if !cpu.dsp
                    stop_here(cpu, ip, n, Stop.Undefined)
                    return
                x_dsp(cpu, ip)
                ip = &ip[1]
            Csel ->
                x_csel(cpu, ip)
                ip = &ip[1]
            FpData ->
                if !fp_ok(cpu, ip) then return stop_access(cpu, ip, n)
                x_fp(cpu, ip)
                ip = &ip[1]
            FpLdr ->
                if !fp_ok(cpu, ip) || !x_fp_ldr(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            FpLdrLit ->
                if !fp_ok(cpu, ip) || !x_fp_ldr_lit(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            FpMulti ->
                if !fp_ok(cpu, ip) || !x_fp_multi(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            FpMove ->
                if !fp_ok(cpu, ip) then return stop_access(cpu, ip, n)
                x_fp_move(cpu, ip)
                ip = &ip[1]
            Movt ->
                x_movt(cpu, ip)
                ip = &ip[1]
            Bfi ->
                x_bfi(cpu, ip)
                ip = &ip[1]
            Bfc ->
                x_bfc(cpu, ip)
                ip = &ip[1]
            Ubfx ->
                x_ubfx(cpu, ip)
                ip = &ip[1]
            Sbfx ->
                x_sbfx(cpu, ip)
                ip = &ip[1]
            BitOp ->
                x_bit_op(cpu, ip, u32(ip.c))
                ip = &ip[1]
            Extend ->
                x_extend(cpu, ip, u32(ip.c))
                ip = &ip[1]
            MulW ->
                x_mul_w(cpu, ip)
                ip = &ip[1]
            Mla ->
                x_mla(cpu, ip)
                ip = &ip[1]
            Mls ->
                x_mls(cpu, ip)
                ip = &ip[1]
            Umull ->
                x_umull(cpu, ip)
                ip = &ip[1]
            Smull ->
                x_smull(cpu, ip)
                ip = &ip[1]
            Umlal ->
                x_umlal(cpu, ip)
                ip = &ip[1]
            Smlal ->
                x_smlal(cpu, ip)
                ip = &ip[1]
            Udiv ->
                if !x_udiv(cpu, ip) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Sdiv ->
                if !x_sdiv(cpu, ip) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Ssat ->
                x_ssat(cpu, ip)
                ip = &ip[1]
            Usat ->
                x_usat(cpu, ip)
                ip = &ip[1]
            LdImm ->
                if !x_ld_imm(cpu, ip, u32(ip.c), n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            LdWb ->
                if !x_ld_wb(cpu, ip, u32(ip.c) & 7, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            LdReg ->
                if !x_ld_reg(cpu, ip, ip.imm >> 8, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            LdLit ->
                if !x_ld_lit(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Ldrd ->
                if !x_ldrd(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Strd ->
                if !x_strd(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            LdrdLit ->
                if !x_ldrd_lit(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            LdmW ->
                if !x_ldm_w(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            StmW ->
                if !x_stm_w(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Ldrex ->
                if !x_ldrex(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Strex ->
                if !x_strex(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Coproc ->
                if !x_coproc(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Clrex ->
                x_clrex(cpu)
                ip = &ip[1]
            Lda ->
                if !x_lda(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Stl ->
                if !x_stl(cpu, ip, n) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            LdPc | LdmPc ->
                val loaded = if ip.op == Op.LdPc then x_ld_pc(cpu, ip, n) else x_ldm_pc(cpu, ip, n)
                val target = loaded match
                    Some(t) -> t
                    None -> return stop_access(cpu, ip, n)
                val to = branch_to(cpu, target, ip, n)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, to) then return
                ip = to
                continue
            Tbb | Tbh ->
                val dest = x_table(cpu, ip, if ip.op == Op.Tbb then 1 else 2, n) match
                    Some(t) -> t
                    None -> return stop_access(cpu, ip, n)
                val to = insn_at(cpu, dest)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, to) then return
                ip = to
                continue
            BcondW ->
                if holds(cpu, u32(ip.c))
                    charge_instruction(cpu,executed)
                    n += 1
                    if taken(cpu, n, target_of(ip)) then return
                    ip = target_of(ip)
                    continue
                ip = &ip[1]
            LeaveW ->
                if holds(cpu, u32(ip.c)) then return leave(cpu, ip, n)
                ip = &ip[1]
            Mrs8 ->
                mrs8(cpu, ip)
                ip = &ip[1]
            Msr8 ->
                msr8(cpu, ip)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, &ip[2]) then return
                ip = &ip[2]
                continue
            NopW -> ip = &ip[1]
            WfiW ->
                wfi(cpu)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, &ip[2]) then return
                ip = &ip[2]
                continue
            SpImmW ->
                if !x_sp_imm(cpu, ip) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            SpRegW ->
                if !x_sp_reg_w(cpu, ip) then return stop_access(cpu, ip, n)
                ip = &ip[1]
            Tt ->
                x_tt(cpu, ip)
                ip = &ip[1]
            NsBranch ->
                if ns_target(cpu, ip) then return stop_ns_branch(cpu, ip, n)
                val to = ns_branch(cpu, ip, n)
                charge_instruction(cpu,executed)
                n += 1
                if taken(cpu, n, to) then return
                ip = to
                continue
            NsRegister -> return stop_ns_register(cpu, ip, n)

        charge_instruction(cpu,executed)
        n += 1
        ip = &ip[1]

// A taken branch to the record `to`: whether the budget is spent, saving where to resume if it is.
@inline
taken(cpu: *Cpu, n: u64, to: *Insn) -> bool
    if executed_cycles(cpu,n) < limit_of(cpu) then return false

    if cpu.stop == Stop.Running then cpu.pc = addr_of(cpu, to)
    cpu.retired = n
    true

// Stop at the record `ip` for `why`. A core already stopped is left as it is: that is a run started
// at an address off the RAM, which `insn_at` has stopped there.
stop_here(cpu: *Cpu, ip: *Insn, n: u64, why: Stop)
    if cpu.stop != Stop.Running then return

    halt(cpu, why, addr_of(cpu, ip))
    cpu.pc = addr_of(cpu, ip)
    cpu.retired = n
