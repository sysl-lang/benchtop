module sh.sysl.benchtop.v6m

import sh.sysl.benchtop.processor.Processor

// A Cortex-M core as a chip's devices see it: its core number, its retired count and its NVIC, which
// latches a raised line as pending; a lowered line leaves what is pending to the NVIC.
impl Processor for Cpu
    number(*self) -> u32 = self.core
    instructions(*self) -> u64 = self.retired
    interrupt(*self, irq: u32, level: bool) = if level then raise(self, irq)
