module sh.sysl.benchtop.v6m

import sysl.buf.{Buf, Frozen, buf}
import sysl.raw.ptr_cast
import sysl.sync.*

// The core: the registers, the flags, guest memory behind a page table, and the decoded-instruction
// array, which the cores of a machine share while they take turns on one thread, and of which each
// has its own while each runs on a thread of its own. It is an ARMv6-M core (the Cortex-M0 and M0+)
// or a Thumb-2 core (the Cortex-M4, Cortex-M7 or Cortex-M33 integer subset, thumb2.sysl), as its `kind`
// says; the module is named for the first.
//
// **Decoding is one record per halfword of guest address.** The instruction at guest address `a` is
// decoded into `dec[a >> 1]`, so the next instruction is the next record (or the one after, for a
// 32-bit encoding) and a branch target is an index, not a lookup. A record starts as "not decoded"
// and is decoded the first time control reaches it. Code runs from RAM, which starts at address 0;
// one more record past its end stands for everywhere else, and stops the core that reaches it.
//
// **An access with no page is the board's**, unless it is to the system control space, which is the
// core's own (except.sysl). Devices live at addresses the page table leaves empty, and the core hands
// such an access to the board through its `bus`.
//
// **A store never leaves a stale record behind.** A map of the RAM's 64-byte lines marks each line a
// record has been decoded from, and a store to a marked line puts back to "not decoded" every record
// whose bytes it touched — the records of the halfwords written and the one before them, which may be
// a 32-bit instruction or a compare fused with the branch after it. The same map marks the lines a
// load-exclusive watches, whose stores are counted for the exclusive monitor (`touched`). A store
// to a line of data alone costs one test of the map. Where the cores share the records, code one core writes is decoded
// afresh when any core next runs it. Where each core has its own (`pair`), a store forgets the
// writer's records at once and posts the line to the other core, which forgets its own records there
// at its next barrier (`DMB`, `DSB`, `ISB`) or between runs (`refresh`): the point at which ARMv6-M
// requires a core to see code another has written, since it must execute an `ISB` first.
//
// **Two threads may reach the RAM, the line map and a core's `limit` at once**, so every access to
// them is atomic. A relaxed access is the host's plain load or store of the same width, so it costs
// the one-thread machine nothing, and it is what makes a guest's racing accesses defined behaviour
// on the host: each is single-copy atomic up to a word, as the architecture asks, and ordered only
// where a barrier orders it.
//
// **The flags are kept lazily.** N and Z are both read from `nz`, the last flag-setting result: N is
// its top bit and Z is whether it is zero. C is 0 or 1. V is kept as the last addition that set it —
// its two operands and its result — and worked out only when a condition reads it, which a signed
// comparison does and almost nothing else. An instruction that sets flags stores words rather than
// computing bits.

// The guest's RAM, from address 0. Code and data share it, as they do on an M0+ running from SRAM.
const RAM_BYTES: u32 = 1024 * 1024
const FLASH_BYTES: u32 = 4 * 1024 * 1024
// The code offsets (`code_offset`) of the RAM backing, then of the flash. One record's halfword sits
// between them, so a run falling off the RAM's last record meets a guard rather than the flash's first.
const FLASH_OFFSET: u32 = RAM_BYTES + 2
const MEMORY_BYTES: u32 = FLASH_OFFSET + FLASH_BYTES
// The code offset of an address that holds no code: the one record past every other, the
// undecodable one.
const NO_CODE: u32 = MEMORY_BYTES
// The offset in the RAM backing of an address in no RAM bank.
const NO_RAM: u32 = RAM_BYTES
// How far past the end of each RAM bank its guard records reach, in bytes of the backing, and how
// many records that is: a run falling off a bank's end meets these and is sent to the guest address
// it ran on to.
const GUARD_BYTES: u32 = 4096
const GUARD_RECORDS: u32 = GUARD_BYTES / 2

// RAM banks share the one backing, its code lines and monitors, each at its own offset.
struct RamBank
    base: u32
    size: u32
    offset: u32

/** Where a board puts its memory: its first RAM region, its flash (none where `flash_size` is 0),
 * and its other RAM regions, each with its offset in the RAM backing. A board's assembler checks it;
 * `reset_mapped` lays a `Memory` out by it. The other regions are frozen, so a map is read from any
 * thread the machine holding it runs on.
 */
struct MemoryMap
    ram_at: u32
    ram_size: u32
    flash_at: u32
    flash_size: u32
    banks: &sync Frozen[RamBank]

/** The map of a board with 1 MB of RAM at address 0 and no flash. */
ram_only() -> MemoryMap = MemoryMap(0, RAM_BYTES, 0x10000000, 0, no_banks())

/** No RAM regions beyond the first. */
no_banks() -> &sync Frozen[RamBank]
    var banks: Buf[RamBank] = buf()
    banks.freeze()

/** A machine's memory: the map that places its RAM and flash in the address space, and the host
 * storage behind it — the bytes, the page table, the map of lines holding code, and the decoded
 * records. A machine owns one, and each of its cores points at it (`Cpu.mem`), so two machines in one
 * process have two.
 */
struct Memory
    ram_base: u32
    ram_size: u32
    flash_base: u32
    flash_size: u32
    extra_ram: [7]RamBank
    extra_ram_count: usize
    // Bit k for each of the other regions that is read-only to the guest (`read_only`): a boot ROM,
    // read on the fast path and executed like RAM, whose stores take the slow path to the bus.
    read_only_banks: u32
    ram: [1048576]u8
    flash: [4194304]u8
    // One entry per 4 KB page of the 4 GB address space (`PAGES`).
    page_table: [1048576]usize
    // One bit per 4 KB page, set for a page of one of the other RAM regions that is not read-only: a
    // store inside such a page whose entry is not 0 writes in place (`store_page`). A board that takes
    // a page off the fast path clears its entry, and the bit is not consulted.
    bank_store_pages: [16384]u64
    // One byte per 64-byte line of RAM, and what a store to the line must do besides the store
    // itself: `LINE_CODE` once a record has been decoded from it or from the 3 bytes after it,
    // `LINE_WATCHED` once a load-exclusive has read it or the 3 bytes after it.
    code_lines: [16384]u8
    // Each core's count of the stores it has made to each watched line, which the other core's
    // store-exclusive checks (t2sem.sysl).
    line_stores: [2][16384]u32
    // One record per halfword of RAM and of flash, and the record for everywhere else.
    decoded: [2621442]Insn
    // The same, for the second core while it has records of its own.
    decoded_own: [2621442]Insn
    // Beside `decoded` and `decoded_own`, one entry per record: for a record of an IT block, the
    // handler of its instruction, chosen when the block was decoded. The record's own handler is its
    // condition's (`h_pred`), which runs this one when the condition holds. Read for no other record.
    predicated: [2621442]Handler
    predicated_own: [2621442]Handler

    @inline
    ram_offset(*self, a: u32, width: u32) -> u32
        if a >= self.ram_base && u64(a) + u64(width) <= u64(self.ram_base) + u64(self.ram_size) then return a - self.ram_base
        self.extra_ram_offset(a, width)

    @noinline
    @cold
    extra_ram_offset(*self, a: u32, width: u32) -> u32
        for i in 0..<self.extra_ram_count
            val b = self.extra_ram[i]
            if a >= b.base && u64(a) + u64(width) <= u64(b.base) + u64(b.size) then return b.offset + a - b.base
        NO_RAM

    @inline
    ram_range(*self, a: u32, width: u32) -> bool
        if a >= self.ram_base && u64(a) + u64(width) <= u64(self.ram_base) + u64(self.ram_size) then return true
        self.extra_ram_offset(a, width) != NO_RAM

    // Whether a store may write the `width` bytes at `a` in place: RAM, and no read-only region.
    @inline
    ram_store_range(*self, a: u32, width: u32) -> bool
        if a >= self.ram_base && u64(a) + u64(width) <= u64(self.ram_base) + u64(self.ram_size) then return true
        self.extra_store_range(a, width)

    @noinline
    @cold
    extra_store_range(*self, a: u32, width: u32) -> bool
        for i in 0..<self.extra_ram_count
            val b = self.extra_ram[i]
            if a >= b.base && u64(a) + u64(width) <= u64(b.base) + u64(b.size) then return self.read_only_banks & (1u32 << u32(i)) == 0
        false

    @inline
    flash_range(*self, a: u32, width: u32) -> bool =
        self.flash_size != 0 && a >= self.flash_base && u64(a) + u64(width) <= u64(self.flash_base) + u64(self.flash_size)

    // Whether any of the `width` bytes at `a` is flash.
    flash_overlaps(*self, a: u32, width: u32) -> bool =
        self.flash_size != 0 && u64(a) + u64(width) > u64(self.flash_base) && u64(a) < u64(self.flash_base) + u64(self.flash_size)

    @inline
    code_offset(*self, a: u32) -> u32
        if a >= self.ram_base && u64(a) + 2 <= u64(self.ram_base) + u64(self.ram_size) then return a - self.ram_base
        if self.flash_range(a, 2) then return FLASH_OFFSET + a - self.flash_base
        // Another region's page on the fast path holds its offset in the backing: a branch into a
        // pinned XIP_SRAM page, or a boot ROM, finds its record without searching the regions.
        val page = self.page_table[a >> PAGE_SHIFT] -% usize(&self.ram[0])
        if page < usize(RAM_BYTES) && a & PAGE_MASK <= PAGE_MASK - 1 then return u32(page) + (a & PAGE_MASK)
        val offset = self.extra_ram_offset(a, 2)
        if offset != NO_RAM then offset else NO_CODE

    // Whether the halfword at `a` can hold code: whether it has a code offset.
    @inline
    is_code(*self, a: u32) -> bool = self.code_offset(a) != NO_CODE

    // The guest address of code offset `offset`; one in a bank's guard records answers the address
    // a run falling into them had reached.
    @inline
    code_address(*self, offset: u32) -> u32
        if offset >= FLASH_OFFSET then return self.flash_base + offset - FLASH_OFFSET
        if offset < self.ram_size + GUARD_BYTES then return self.ram_base + offset
        for i in 0..<self.extra_ram_count
            val b = self.extra_ram[i]
            if offset >= b.offset && offset < b.offset + b.size + GUARD_BYTES then return b.base + offset - b.offset
        self.ram_base + offset

    install_ram_guards(*self, records: *Insn)
        if self.extra_ram_count == 0 then return
        for k in 0..self.extra_ram_count
            val end = if k == 0 then self.ram_size else self.extra_ram[k - 1].offset + self.extra_ram[k - 1].size
            val address = if k == 0 then self.ram_base + self.ram_size else self.extra_ram[k - 1].base + self.extra_ram[k - 1].size
            for i in 0..<GUARD_RECORDS
                if end + i * 2 > RAM_BYTES then break
                records[(end >> 1) + i] = Insn(&h_ram_boundary, address + i * 2, Op.Undecoded, 0, 0, 0)
end Memory

/** A memory with the map of `ram_only` and nothing in it, which `reset` or `reset_mapped` lays out.
 * Its count is atomic, since a machine's cores run on threads of their own.
 */
memory() -> &sync Memory =
    Memory(0, RAM_BYTES, 0x10000000, 0, [RamBank(0, 0, 0); 7], 0, 0, [0; 1048576], [0; 4194304], [0; 1048576], [0; 16384], [0; 16384],
        [[0; 16384]; 2], [Insn(null, 0, Op.Undecoded, 0, 0, 0); 2621442], [Insn(null, 0, Op.Undecoded, 0, 0, 0); 2621442],
        [null; 2621442], [null; 2621442])


// One page-table entry per 4 KB page of the 4 GB address space. An entry is the host address of the
// page's first byte, or 0 for a page with no fast path.
const PAGE_SHIFT: u32 = 12
const PAGES = 1 << 20
const PAGE_BYTES: u32 = 4096
// An address's offset in its page.
const PAGE_MASK: u32 = PAGE_BYTES - 1

// A line of RAM is the unit a store is checked against for code, once it is on a page that holds some.
const LINE_SHIFT: u32 = 6

// The handler type: every handler takes the machine, the record it is to execute, and the count of
// instructions retired so far, and replaces its own frame with the next handler's.
type Handler = *extern(*Cpu, *Insn, u64) -> unit

/** The board's half of an access with no page, which the core reaches through its `bus`: a read
 * answers the value, `width` bytes (1, 2 or 4) zero-extended; a write takes it. Either may stop the
 * core with `halt`. `n` is the count of instructions retired before the one making the access, for a
 * device that answers by the time. The object is the core's one way back to the machine it is part
 * of: each core holds its own.
 */
trait Bus
    read(*self, cpu: *Cpu, a: u32, width: u32, n: u64) -> u32
    write(*self, cpu: *Cpu, a: u32, width: u32, x: u32, n: u64)
    /** A coprocessor instruction CPACR has let through (coproc.sysl): a read's value, Rt in the low
     * word and Rt2 in the high, 0 for a write; or None where nothing is on its port, which stops the
     * core at `Undefined`. It may stop the core with `halt`, as an access may; the core then stops on
     * the instruction, whatever address the halt gave.
     */
    coprocessor(*self, cpu: *Cpu, op: CoprocessorOp, n: u64) -> Option[u64] = None

// Why `run` came back. `Running` is no stop at all: the run ran out of its budget, or was cut, and the
// core goes on at `pc`. Every other stop also leaves `pc` where the guest was: on an access that
// stopped the core, the instruction that made it (not retired); after a jump off the RAM, its target.
enum Stop
    Running = 0
    Breakpoint
    Undefined
    // An access, or a jump, to an address nothing answers; `stop_at` is the address.
    Unmapped
    // The guest asked to end, with `exit_code`.
    Exit
    // A `WFI` that nothing can ever wake: no exception is pending that could run, the system timer
    // will not raise one, and the board has nothing that will. `stop_at` is the instruction after it.
    Asleep
    // Where an M0+ would take a HardFault it cannot (and lock up), or where benchtop does not model
    // the fault: an exception whose vector lacks its Thumb bit (an unset one is 0), `stop_at` the
    // vector's address; an `SVC` or a return that cannot be taken, or an EXC_RETURN that names no
    // return, `stop_at` the instruction.
    Fault
    // The guest asked for a system reset (AIRCR.SYSRESETREQ); what that does is the board's.
    Reset
    // ARMv8-M Mainline: an instruction or an exception entry would have moved the stack pointer in use
    // below its limit (MSPLIM or PSPLIM) where not even HardFault can be taken — at a negative
    // priority without CCR.STKOFHFNMIGN — which is a lockup. `stop_at` is the instruction, or for an
    // entry the address it would have returned to; nothing was stored. Where the fault can be taken it
    // is: the UsageFault STKOF, or HardFault (t2system.sysl).
    StackLimit
    // A core with the Security Extension, which benchtop runs Secure-only, was asked to go to
    // Non-secure state, which is not modelled: `Cpu.transition` says how. `stop_at` is the instruction
    // (for an access to a Non-secure alias, the address); nothing of it was done.
    NonSecure

/** How a Secure-only core was asked to reach Non-secure state (`Stop.NonSecure`). */
enum Transition: u8
    None = 0
    // `BXNS` to an address with bit 0 clear.
    Bxns
    // `BLXNS` to an address with bit 0 clear: a Non-secure function call.
    Blxns
    // An EXC_RETURN with S clear: a return to the Non-secure stack and state.
    ReturnNonSecure
    // An EXC_RETURN with DCRS clear: only an exception taken from Secure state to Non-secure state
    // stacks the callee registers that would unstack.
    ReturnCallee
    // A load or store to the Non-secure alias of the private peripheral bus (0xE002_0000).
    PpbAlias
    // `MRS` or `MSR` of a Non-secure register (`MSP_NS`, `CONTROL_NS`, …).
    NsRegister

/** What a stop for `Stop.NonSecure` says, as a person reads it. */
transition_name(t: Transition) -> string = t match
    None -> "nothing"
    Bxns -> "BXNS to a Non-secure address"
    Blxns -> "BLXNS, a call to Non-secure code"
    ReturnNonSecure -> "an exception return to Non-secure state"
    ReturnCallee -> "an exception return with the callee registers stacked (DCRS clear)"
    PpbAlias -> "an access to the Non-secure alias of the private peripheral bus"
    NsRegister -> "MRS or MSR of a Non-secure register"

// The selected core model; `MODELS` (models.sysl) says what each one is. Four are named after the
// architecture benchtop first modelled with them: `V6m` is the Cortex-M0+, `V8mMain` the Cortex-M33,
// `V7em` the Cortex-M4 and `V7emM7` the Cortex-M7; the rest are named after their cores. Models
// select a shared architecture at decode time, never a second implementation of an instruction.
enum Kind: u8
    V6m = 0
    V8mMain
    V7em
    V7emM7
    M0
    M1
    M3
    M23
    M35p
    M52
    M55
    M85

// A decoded instruction. `h` is its handler for the threaded executor and `op` its case for the
// `match` executor; the rest are its operands, extracted once. A register number is a `u4`, so
// indexing the sixteen registers with one needs no bounds check, and the record is 16 bytes.
struct Insn
    h: Handler
    imm: u32
    op: Op
    a: u4
    b: u4
    c: u4

struct Cpu
    r: [16]u32
    nz: u32
    c: u32
    // V is the signed overflow of `va + vb`, which came to `vr`.
    va: u32
    vb: u32
    vr: u32
    // Where to resume, as a guest address, after `run` comes back.
    pc: u32
    // `run` comes back at the first taken branch at or past this many executed cycles. Another core's
    // thread cuts it to 0, so it is read and written with `limit_of`, `set_limit` and `lower_limit`.
    limit: u64
    retired: u64
    extra_cycles: u64
    instruction_timing: bool
    cycle_costs: [256]u8
    stop: Stop
    stop_at: u32
    exit_code: u32
    // The machine's memory, and three of its arrays the hot paths reach through: the page table, the
    // line map, and the records this core runs (the machine's, or its own after `pair`) with the
    // predicated handlers beside them.
    mem: *Memory
    pages: *usize
    lines: *u8
    dec: *Insn
    predicated: *Handler
    bus: *Bus
    // The exception model (except.sysl). `r[13]` is the stack pointer in use; `sp_other` is the
    // other one: the main stack's while thread mode runs on the process stack, the process stack's
    // otherwise.
    sp_other: u32
    // CONTROL's two bits: nPRIV (kept, and restricting nothing) and SPSEL.
    control: u32
    // The exception number running, 0 in thread mode, which is exactly when IPSR is 0.
    ipsr: u32
    primask: u32
    // The vector table's address, VTOR.
    vtor: u32
    // The NVIC's sets, one bit per exception number (nvic.sysl): pending, active, and enabled (IRQ k
    // is bit `IRQ0 + k`). The summary masks have bit w set while word w > 0 of their set is non-zero.
    pending: [NVIC_BANKS]u64
    active: [NVIC_BANKS]u64
    enabled: [NVIC_BANKS]u64
    pending_banks: u32
    active_banks: u32
    // The number of external interrupt lines the model implements.
    nvic_irqs: u32
    // The priority byte of each exception number that has one to set; priority_bits are kept.
    prio: [512]u8
    // Implemented NVIC priority width, selected per core by the board description.
    priority_bits: u32
    // Set by `WFI`: the core runs nothing until something wakes it.
    sleeping: bool
    // The clock is executed cycles plus `slept`, the time skipped while asleep.
    slept: u64
    // SysTick: CSR's ENABLE and TICKINT bits, COUNTFLAG, the reload value, and the current value
    // while it is stopped. While it runs, the current value is worked out from `tick_zero`, the clock
    // at which it next counts down to 0, and `tick_last`, the clock at which it was last 0.
    tick_ctrl: u32
    tick_flag: bool
    tick_reload: u32
    tick_value: u32
    tick_zero: u64
    tick_last: u64
    // The IRQs another core's thread has raised in this core (`poke`), one bit per exception number,
    // taken into `pending` by the core's own thread between runs (`take_incoming`), and its summary.
    incoming: [NVIC_BANKS]u64
    incoming_banks: u32
    // The other core, where each core has records of its own; null where the cores share them.
    peer: *Cpu
    // The lines of RAM the other core has stored to since this core last forgot its records there,
    // one bit per line, and whether any bit is set.
    stale: [256]u64
    stale_any: u32
    // What the core is. `reset` and `clear` leave it, so whoever makes a core of another kind sets it
    // before resetting it.
    kind: Kind
    // Which of the machine's cores this is, 0 or 1. `reset` and `clear` leave it too.
    core: u32
    // ARMv8-M Mainline's state; an ARMv6-M core keeps every one of these 0.
    //
    // ITSTATE, the IT block's condition and mask (EPSR.IT), as IT sets it and each instruction of the
    // block advances it. Only IT and the instructions it governs touch it (thumb2.sysl), so code
    // outside an IT block pays nothing for it.
    it: u32
    // An instruction of a block steps `it` before it runs, so a core that stops on it — not retired —
    // would hold the next one's ITSTATE. Each one that runs (a skipped one always retires) therefore keeps the instruction's own ITSTATE in
    // `it_own` and the retired count it ran at in `it_at`, and a run that ends with `retired` still
    // `it_at` puts `it_own` back (`end_run`, except.sysl): the architecture reports, and stacks, the
    // ITSTATE of the instruction the core stopped on.
    it_own: u32
    it_at: u64
    // The sticky saturation flag, APSR.Q: 0 or 1.
    q: u32
    // Optional integer DSP extension and APSR.GE[3:0].
    dsp: bool
    ge: u32
    // The floating-point extension (fpu.sysl), if any; the
    // registers S0–S31 as bits, D`k` being S`2k` and S`2k+1`; FPSCR as last gathered from the host;
    // CPACR, FPCCR, FPCAR and FPDSCR; and whether this core's FP instructions may run without the
    // check of CPACR and CONTROL.FPCA, which anything that changes either clears.
    fpu: Fpu
    s: [32]u32
    fpscr: u32
    cpacr: u32
    // The coprocessors 0–7 the board puts on the core's port, bit n for CPn: CPACR keeps their fields.
    coprocessors: u32
    // The core has the Security Extension, which the board runs Secure-only: the core resets into
    // Secure state and stays there, so every banked register here is the Secure one (t2secure.sysl).
    security: bool
    fpccr: u32
    fpcar: u32
    fpdscr: u32
    fp_ready: bool
    // BASEPRI and FAULTMASK, and the stack limits.
    basepri: u32
    faultmask: u32
    msplim: u32
    psplim: u32
    // AIRCR.PRIGROUP, and the SCB's configuration registers, stored: SHCSR's enables, CCR.
    prigroup: u32
    shcsr: u32
    ccr: u32
    // The local exclusive monitor: whether it is set, and the address, size in bytes and value a
    // load-exclusive left in it, with the count of stores to its line then (t2sem.sysl).
    excl: bool
    excl_addr: u32
    excl_size: u32
    excl_value: u32
    excl_stores: u32
    // How many ticks of the board's clock one tick of this core's takes (1 where the core runs at the
    // chip's clock), as the board configures it; the core itself never reads it.
    divisor: u64
    // The rest are read only off the hot paths, so they come last, where they move no hot field.
    //
    // The SAU, stored: SAU_CTRL, SAU_RNR, and each region's SAU_RBAR and SAU_RLAR. `TT` reads it.
    sau_ctrl: u32
    sau_rnr: u32
    sau_rbar: [SAU_REGIONS]u32
    sau_rlar: [SAU_REGIONS]u32
    // The fault status registers benchtop records into (t2secure.sysl): CFSR, HFSR, SFSR and SFAR.
    cfsr: u32
    hfsr: u32
    sfsr: u32
    sfar: u32
    // Why the core stopped at `NonSecure`.
    transition: Transition

const LINE_CODE: u8 = 1
const LINE_WATCHED: u8 = 2

// A machine with `image` at address 0 of `mem`, which `cpu` is attached to, ready to start at
// `entry`, and no devices. The caller keeps `mem` alive while the core points at it.
reset(cpu: *Cpu, mem: &sync Memory, image: []const u8, entry: u32)
    mem.ram_base = 0
    mem.ram_size = RAM_BYTES
    mem.extra_ram_count = 0
    mem.read_only_banks = 0
    mem.flash_size = 0
    for i in 0..<mem.ram.len do mem.ram[i] = 0
    for i in 0..<image.len do mem.ram[i] = image[i]
    for i in 0..<mem.page_table.len do mem.page_table[i] = 0
    for p in 0..<(RAM_BYTES >> PAGE_SHIFT) do mem.page_table[p] = usize(&mem.ram[p << PAGE_SHIFT])
    for i in 0..<mem.bank_store_pages.len do mem.bank_store_pages[i] = 0
    for i in 0..<mem.code_lines.len do mem.code_lines[i] = 0
    for i in 0..<mem.code_lines.len
        mem.line_stores[0][i] = 0
        mem.line_stores[1][i] = 0
    for i in 0..(RAM_BYTES >> 1) do mem.decoded[i] = undecoded()
    mem.decoded[NO_CODE >> 1] = undecoded()

    attach_memory(cpu, mem)
    clear(cpu, entry)
    cpu.bus = &nothing_attached

/** Point `cpu` at `mem`, sharing the machine's records; `clear` keeps the attachment. The caller keeps
 * `mem` alive while the core points at it.
 */
attach_memory(cpu: *Cpu, mem: &sync Memory)
    cpu.mem = &*mem

// The core's own state as a reset leaves it, to start at `entry`, on the memory it is attached to.
// Memory is the machine's, untouched, and so is the core's kind.
clear(cpu: *Cpu, entry: u32)
    for i in 0..<16 do cpu.r[i] = 0
    cpu.nz = 1
    cpu.c = 0
    cpu.va = 0
    cpu.vb = 0
    cpu.vr = 0
    cpu.pc = entry
    set_limit(cpu, 0)
    cpu.retired = 0
    cpu.extra_cycles = 0
    configure_instruction_timing(cpu,false)
    cpu.stop = Stop.Running
    cpu.stop_at = 0
    cpu.exit_code = 0
    cpu.pages = &cpu.mem.page_table[0]
    cpu.lines = &cpu.mem.code_lines[0]
    cpu.dec = &cpu.mem.decoded[0]
    cpu.predicated = &cpu.mem.predicated[0]
    cpu.peer = null
    for w in 0..<cpu.stale.len do cpu.stale[w] = 0
    cpu.stale_any = 0
    cpu.it = 0
    cpu.it_own = 0
    cpu.it_at = ~0
    cpu.q = 0
    cpu.ge = 0
    cpu.dsp = false
    cpu.fpu = Fpu.Absent
    for k in 0..<32 do cpu.s[k] = 0
    cpu.fpscr = 0
    cpu.cpacr = 0
    cpu.coprocessors = 0
    cpu.security = false
    clear_security(cpu)
    cpu.fpccr = FPCCR_RESET
    cpu.fpcar = 0
    cpu.fpdscr = 0
    cpu.fp_ready = false
    cpu.excl = false
    cpu.excl_addr = 0
    cpu.excl_size = 0
    cpu.excl_value = 0
    cpu.excl_stores = 0
    clear_exceptions(cpu)

/** Give each of two cores records of its own, so each can run on a thread of its own: `first` keeps
 * the machine's, and `second` starts with its own, all "not decoded". A store from then on forgets
 * the writer's records and posts its line to the other core (`forget`).
 */
pair(first: *Cpu, second: *Cpu)
    require first.mem == second.mem, "two cores of one machine"
    val mem = first.mem

    for i in 0..(RAM_BYTES >> 1) do mem.decoded_own[i] = undecoded()
    for i in (FLASH_OFFSET >> 1)..((FLASH_OFFSET + mem.flash_size) >> 1) do mem.decoded_own[i] = undecoded()
    mem.decoded_own[NO_CODE >> 1] = undecoded()

    mem.install_ram_guards(&mem.decoded_own[0])
    second.dec = &mem.decoded_own[0]
    second.predicated = &mem.predicated_own[0]
    first.peer = second
    second.peer = first

/** Undo `pair` before `second` has run on its own records: both cores share the machine's again. */
unpair(first: *Cpu, second: *Cpu)
    second.dec = &second.mem.decoded[0]
    second.predicated = &second.mem.predicated[0]
    first.peer = null
    second.peer = null

// `limit`, read and written by the core's own thread while another may cut it. Relaxed: the plain
// load and store of the host.
@inline
limit_of(cpu: *Cpu) -> u64 = atomic_load(&cpu.limit, Relaxed)

@inline
set_limit(cpu: *Cpu, n: u64) = atomic_store(&cpu.limit, n, Relaxed)

// Lower `limit` to `n` where it is above it, never undoing a cut another thread made meanwhile.
lower_limit(cpu: *Cpu, n: u64)
    var seen = limit_of(cpu)

    while n < seen
        val got = atomic_cas(&cpu.limit, seen, n, Relaxed)

        if got == seen then return

        seen = got

// The record for guest address `a`: past the end of RAM, the one record that stands for everywhere
// else, and the core stopped at `a`, both its `stop_at` and its `pc`. A branch to it comes back at
// once, since the stop has spent the budget.
@inline
insn_at(cpu: *Cpu, a: u32) -> *Insn
    val offset = cpu.mem.code_offset(a)
    if offset != NO_CODE then return &cpu.dec[offset >> 1]

    if cpu.stop == Stop.Running then cpu.pc = a
    halt(cpu, Stop.Unmapped, a)
    &cpu.dec[NO_CODE >> 1]

// Stop the core for `why` at `at`, unless it has already stopped. A taken branch then comes back at
// once, since the budget is gone, and leaves `pc` alone: whatever stops the core says where.
halt(cpu: *Cpu, why: Stop, at: u32)
    if cpu.stop != Stop.Running then return

    cpu.stop = why
    cpu.stop_at = at
    set_limit(cpu, 0)

// The instruction at `ip`, `n` retired before it, made an access that stopped the core: it stops
// there, not retired, with nothing after the access in it done.
stop_access(cpu: *Cpu, ip: *Insn, n: u64)
    cpu.pc = addr_of(cpu, ip)
    cpu.retired = n

// A taken `Leave` at `ip`, `n` retired before it: the branch retires, and the core stops at its target.
leave(cpu: *Cpu, ip: *Insn, n: u64)
    if ip.a != 0 then cpu.r[14] = (addr_of(cpu, ip) + 4) | 1

    halt(cpu, Stop.Unmapped, ip.imm)
    cpu.pc = ip.imm
    charge_instruction(cpu,ip)
    cpu.retired = n + 1

// A machine with no devices: every access off the page table stops the core.
struct NoDevices
end NoDevices

impl Bus for NoDevices
    read(*self, cpu: *Cpu, a: u32, width: u32, n: u64) -> u32
        halt(cpu, Stop.Unmapped, a)
        0

    write(*self, cpu: *Cpu, a: u32, width: u32, x: u32, n: u64) = halt(cpu, Stop.Unmapped, a)

/** The bus `reset` gives a core: nothing is on it. */
var nothing_attached = NoDevices()

// A record that decodes itself the first time control reaches it.
@inline
undecoded() -> Insn = Insn(&h_decode, 0, Op.Undecoded, 0, 0, 0)

// The record at RAM address `pc` is being decoded from the bytes `pc` to `pc + 3`. A store whose
// first byte is within 3 of them may write one of them, so the lines holding `pc - 3` to `pc + 3` are
// marked as holding code.
holds_code(cpu: *Cpu, address: u32)
    val mem = cpu.mem

    if !mem.ram_range(address, 2) then return
    val pc = mem.ram_offset(address, 2)
    val from = if pc >= 4 then pc - 4 else 0
    val to = if pc + 2 < RAM_BYTES then pc + 2 else RAM_BYTES - 1

    for a in from..to do atomic_or(&mem.code_lines[a >> LINE_SHIFT], LINE_CODE, Relaxed)

// A load-exclusive of the `width` bytes at RAM address `a`: watch the lines a store touching them
// can start on, as `holds_code` marks code, and answer the other core's count of stores to `a`'s line.
watch(cpu: *Cpu, address: u32, width: u32) -> u32
    val a = ram_storage_offset(cpu, address)
    val from = if a >= 3 then a - 3 else 0

    for b in from..(a + width - 1) do atomic_or(&cpu.mem.code_lines[b >> LINE_SHIFT], LINE_WATCHED, SeqCst)

    others_stores(cpu, address)

// The other core's count of stores to the line of RAM address `a`.
// Valid RAM accesses already have a page mapping. Reuse it for bookkeeping
// with multiple banks, without searching banks on each ordinary data store.
@inline
private ram_storage_offset(cpu: *Cpu, a: u32) -> u32
    val mem = cpu.mem

    if mem.extra_ram_count == 0 then return a - mem.ram_base
    u32(cpu.pages[a >> PAGE_SHIFT] - usize(&mem.ram[0])) + (a & 4095)

@inline
others_stores(cpu: *Cpu, a: u32) -> u32 = atomic_load(&cpu.mem.line_stores[1 - cpu.core][ram_storage_offset(cpu, a) >> LINE_SHIFT], SeqCst)

// The store of `width` bytes just made at RAM address `a`: where it is on a line holding code, every
// record that read any of its bytes is decoded again when control next reaches it, and where it is on
// a watched line, the store is counted. A store to a line of neither costs this one test.
@inline
stored(cpu: *Cpu, address: u32, width: u32)
    val a = ram_storage_offset(cpu, address)
    val mark = atomic_load(&cpu.lines[a >> LINE_SHIFT], Relaxed)

    if mark != 0 then touched(cpu, a, width, mark)

/** A store the bus made on `cpu`'s behalf into its RAM at `address`, through no page (a board serving
 * a region it keeps off the fast path): the same bookkeeping as a store of the core's own.
 */
bus_stored(cpu: *Cpu, address: u32, width: u32)
    val a = cpu.mem.ram_offset(address, width)
    if a == NO_RAM then return
    val mark = atomic_load(&cpu.lines[a >> LINE_SHIFT], Relaxed)
    if mark != 0 then touched(cpu, a, width, mark)

@noinline
@cold
private touched(cpu: *Cpu, a: u32, width: u32, mark: u8)
    if mark & LINE_WATCHED != 0
        val last = a + width - 1
        val mem = cpu.mem

        atomic_add(&mem.line_stores[cpu.core][a >> LINE_SHIFT], 1, SeqCst)
        if last >> LINE_SHIFT != a >> LINE_SHIFT then atomic_add(&mem.line_stores[cpu.core][last >> LINE_SHIFT], 1, SeqCst)

    if mark & LINE_CODE != 0 then forget(cpu, a, width)

// Put back to "not decoded" the records that read the `width` bytes at `a`: the halfwords' own, and
// the one before them; and where the other core has records of its own, post it the lines they are on.
@noinline
@cold
forget(cpu: *Cpu, a: u32, width: u32)
    drop_records(cpu, a, width)

    val other = cpu.peer

    if other == null then return

    val back = reach_back(cpu)
    val from = (if a >= back then a - back else 0) >> LINE_SHIFT

    for line in from..(last_reached(cpu, a, width) >> LINE_SHIFT)
        atomic_or(&other.stale[line >> 6], u64(1) << (line & 63), Relaxed)

    atomic_store(&other.stale_any, 1, Release)

// How far before a byte written the records that depend on it may start: the halfword before, for a
// 32-bit instruction or a compare fused with the branch after it. On ARMv8-M an IT's decode is what
// gives the instructions of its block their conditions (thumb2.sysl), so a block and its IT are
// forgotten together: 16 bytes back reaches the IT of a block the store is in, and 18 bytes on
// reaches the end of the block of an IT the store overwrites.
@inline
private reach_back(cpu: *Cpu) -> u32 = if is_baseline(cpu.kind) then 2 else 16

// The last byte whose record may depend on the `width` bytes stored at `a`.
@inline
private last_reached(cpu: *Cpu, a: u32, width: u32) -> u32
    val last = a + width - 1

    if is_baseline(cpu.kind) then return last

    if last + 18 < RAM_BYTES then last + 18 else RAM_BYTES - 1

// The core's own records that depend on any of the `width` bytes at `a`, put back to "not decoded".
private drop_records(cpu: *Cpu, a: u32, width: u32)
    val back = reach_back(cpu)
    val first = (if a >= back then a - back else 0) >> 1

    for i in first..(last_reached(cpu, a, width) >> 1) do if cpu.dec[i].op != Op.Undecoded then cpu.dec[i] = undecoded()

/** Forget the core's own records on every line the other core has posted since the last time, so a
 * record of code the other core has written is decoded afresh. The core's own thread calls it, at a
 * barrier and between runs.
 */
@inline
refresh(cpu: *Cpu)
    if atomic_load(&cpu.stale_any, Relaxed) != 0 then drop_stale(cpu)

/** A `DMB`, `DSB` or `ISB`: a full host fence, so the guest's accesses on each side of it are ordered
 * as the architecture orders them, and the point at which code the other core has written is seen.
 * ARMv6-M has the three for different orderings; one sequentially consistent fence gives every one of
 * them.
 */
@inline
barrier(cpu: *Cpu)
    atomic_fence(SeqCst)
    refresh(cpu)

@noinline
@cold
private drop_stale(cpu: *Cpu)
    // Pairs with the release that posted the lines, so the bits it set are seen. A line posted after
    // this sets the flag again, for the next time.
    if atomic_swap(&cpu.stale_any, 0, Acquire) == 0 then return

    for w in 0..<cpu.stale.len
        if atomic_load(&cpu.stale[w], Relaxed) == 0 then continue

        var lines = atomic_swap(&cpu.stale[w], 0, Acquire)
        var line = u32(w) << 6

        while lines != 0
            if lines & 1 != 0 then drop_records(cpu, line << LINE_SHIFT, 1 << LINE_SHIFT)
            lines >>= 1
            line += 1

// The record a direct branch goes to: its `imm` is a signed count of records from its own.
@inline
target_of(ip: *Insn) -> *Insn = &ip[i32.wrap(ip.imm)]

// The guest address of a record.
@inline
addr_of(cpu: *Cpu, ip: *Insn) -> u32 = cpu.mem.code_address(u32(ip - cpu.dec) << 1)

// ---------------------------------------------------------------------------------------------------
// Memory. The fast path is one table load, one test and one host access; everything else (a page
// with no entry) is the slow path: the system control space (except.sysl), or else the board's
// `bus`.
//
// A guest access is made at `n`, the count of instructions retired before the one making it, since
// the system timer's registers answer by the time. `load32` and the rest are the same accesses made
// at the time the core last stopped, for the host's own use and for the core's work between
// instructions.

// The host address of the first byte of the page holding `a`, or 0 for a page with no fast path. The
// test is made on this, not on the byte's own address, which nothing stops from being 0.
@inline
page_of(cpu: *Cpu, a: u32) -> usize = cpu.pages[a >> PAGE_SHIFT]

// The page of the `width` bytes at `a`, or 0 where they run past the RAM's last byte. Every entry that
// is not 0 is a whole page of the RAM, of another RAM region or of the flash, and a board takes a page
// off the fast path by clearing its entry (a pinned XIP_SRAM page unpinned, the flash in direct mode),
// so for an access inside one page the table is the whole test, whichever region it is in.
@inline
page_for(cpu: *Cpu, a: u32, width: u32) -> usize
    if a & PAGE_MASK <= PAGE_BYTES - width then return page_of(cpu, a)
    straddling_page(cpu, a, width)

// An access across a page boundary. Each region is one host array, so one inside a region is still one
// host access where both pages are on the fast path; one at a region's very end would reach the host
// memory after it, and one into a page a board has taken off the fast path would miss its check, so
// both take the slow path.
@noinline
@cold
private straddling_page(cpu: *Cpu, a: u32, width: u32) -> usize =
    if (cpu.mem.ram_range(a, width) || cpu.mem.flash_range(a, width)) && page_of(cpu, a + width - 1) != 0 then page_of(cpu, a) else 0

// The page a store of `width` bytes at `a` may write through: RAM only. Flash is read-only to the
// guest, so a store that touches it finds no page and takes the slow path, which faults it; a store
// to a read-only RAM region takes it to the bus. The fast path pays nothing for the protection: the
// first region's test is the same, and another region's page is one bit (`bank_store_pages`).
@inline
store_page(cpu: *Cpu, a: u32, width: u32) -> usize
    val mem = cpu.mem
    if a >= mem.ram_base && u64(a) + u64(width) <= u64(mem.ram_base) + u64(mem.ram_size) then return page_of(cpu, a)
    if a & PAGE_MASK <= PAGE_BYTES - width
        val page = a >> PAGE_SHIFT
        return if (mem.bank_store_pages[page >> 6] >> u64(page & 63)) & 1 != 0 then page_of(cpu, a) else 0
    if mem.extra_store_range(a, width) && page_of(cpu, a + width - 1) != 0 then page_of(cpu, a) else 0

// The slow path of a read, `width` bytes at `a`.
slow_read(cpu: *Cpu, a: u32, width: u32, n: u64) -> u32
    if a >= SCS && a < PPB_NS_END then return ppb_read(cpu, a, width, n)

    cpu.bus.read(cpu, a, width, n)

slow_write(cpu: *Cpu, a: u32, width: u32, x: u32, n: u64)
    if cpu.mem.flash_overlaps(a, width)
        halt(cpu, Stop.Fault, a)
        return

    if a >= SCS && a < PPB_NS_END
        ppb_write(cpu, a, width, x, n)
        return

    cpu.bus.write(cpu, a, width, x, n)

// The part of the private peripheral bus the core answers itself: the system control space, and on a
// Secure-only core the bus's Non-secure alias, refused by name. The rest between them is the board's.
// Kept out of the slow paths above so that they stay small enough for the accesses' fast paths to
// take them in.
ppb_read(cpu: *Cpu, a: u32, width: u32, n: u64) -> u32
    if a < SCS_END then return scs_read(cpu, a, width, n)

    if cpu.security && a >= PPB_NS
        non_secure(cpu, Transition.PpbAlias, a)
        return 0

    cpu.bus.read(cpu, a, width, n)

ppb_write(cpu: *Cpu, a: u32, width: u32, x: u32, n: u64)
    if a < SCS_END then return scs_write(cpu, a, width, x, n)
    if cpu.security && a >= PPB_NS then return non_secure(cpu, Transition.PpbAlias, a)

    cpu.bus.write(cpu, a, width, x, n)

// The `width` bytes at `a` on the host page `page`, zero-extended; and storing them.
@inline
host_read(page: usize, a: u32, width: u32) -> u32
    val at = page + (a & 0xFFF)

    width match
        4 ->
            val p: *u32 = ptr_cast(at)
            atomic_load(p, Relaxed)
        2 ->
            val p: *u16 = ptr_cast(at)
            atomic_load(p, Relaxed)
        _ ->
            val p: *u8 = ptr_cast(at)
            atomic_load(p, Relaxed)

@inline
host_write(page: usize, a: u32, width: u32, x: u32)
    val at = page + (a & 0xFFF)

    width match
        4 ->
            val p: *u32 = ptr_cast(at)
            atomic_store(p, x, Relaxed)
        2 ->
            val p: *u16 = ptr_cast(at)
            atomic_store(p, u16.wrap(x), Relaxed)
        _ ->
            val p: *u8 = ptr_cast(at)
            atomic_store(p, u8.wrap(x), Relaxed)

// The low `width` bytes of `x`.
@inline
low_bytes(x: u32, width: u32) -> u32 = if width == 4 then x else x & ((1 << (width * 8)) - 1)

// An instruction's own access: the `width` bytes at `a` into `into`, or `x`'s low `width` bytes to
// `a`, answering whether the access was made. One that stops the core is not: a read leaves `into`
// as it was, and the instruction stops on it (`stop_access`). The test is in the slow path alone; on
// the fast path the answer is a constant, and the handler's check of it folds away.
@inline
load(cpu: *Cpu, a: u32, width: u32, n: u64, into: *u32) -> bool
    val page = page_for(cpu, a, width)

    if page == 0
        val x = slow_read(cpu, a, width, n)

        if cpu.stop != Stop.Running then return false

        into[0] = x
        return true

    into[0] = host_read(page, a, width)
    true

@inline
store(cpu: *Cpu, a: u32, x: u32, width: u32, n: u64) -> bool
    val page = store_page(cpu, a, width)

    if page == 0
        slow_write(cpu, a, width, low_bytes(x, width), n)
        return cpu.stop == Stop.Running

    host_write(page, a, width, x)
    stored(cpu, a, width)
    true

// The same accesses where nothing stops on them: the exception model's stacking and the host's own.
@inline
read32(cpu: *Cpu, a: u32, n: u64) -> u32
    val page = page_for(cpu, a, 4)

    if page == 0 then return slow_read(cpu, a, 4, n)

    host_read(page, a, 4)

@inline
read16(cpu: *Cpu, a: u32, n: u64) -> u32
    val page = page_for(cpu, a, 2)

    if page == 0 then return slow_read(cpu, a, 2, n)

    host_read(page, a, 2)

@inline
read8(cpu: *Cpu, a: u32, n: u64) -> u32
    val page = page_of(cpu, a)

    if page == 0 then return slow_read(cpu, a, 1, n)

    host_read(page, a, 1)

@inline
write(cpu: *Cpu, a: u32, width: u32, x: u32, n: u64)
    val page = store_page(cpu, a, width)

    if page == 0
        slow_write(cpu, a, width, low_bytes(x, width), n)
        return

    host_write(page, a, width, x)
    stored(cpu, a, width)

@inline
write32(cpu: *Cpu, a: u32, x: u32, n: u64) = write(cpu, a, 4, x, n)

@inline
write16(cpu: *Cpu, a: u32, x: u32, n: u64) = write(cpu, a, 2, x, n)

@inline
write8(cpu: *Cpu, a: u32, x: u32, n: u64) = write(cpu, a, 1, x, n)

load32(cpu: *Cpu, a: u32) -> u32 = read32(cpu, a, cpu.retired)

load16(cpu: *Cpu, a: u32) -> u32 = read16(cpu, a, cpu.retired)

load8(cpu: *Cpu, a: u32) -> u32 = read8(cpu, a, cpu.retired)

store32(cpu: *Cpu, a: u32, x: u32) = write32(cpu, a, x, cpu.retired)

store16(cpu: *Cpu, a: u32, x: u32) = write16(cpu, a, x, cpu.retired)

store8(cpu: *Cpu, a: u32, x: u32) = write8(cpu, a, x, cpu.retired)

// ---------------------------------------------------------------------------------------------------
// Flags.

@inline
set_nz(cpu: *Cpu, res: u32)
    cpu.nz = res

@inline
add_flags(cpu: *Cpu, a: u32, b: u32, carry: u32) -> u32
    val wide = u64(a) + u64(b) + u64(carry)
    val res = u32.wrap(wide)

    cpu.nz = res
    cpu.c = u32(wide >> 32)
    cpu.va = a
    cpu.vb = b
    cpu.vr = res
    res

// `a - b` is `a + ~b + 1`, and `SBC` is `a + ~b + C`; C is "no borrow".
@inline
sub_flags(cpu: *Cpu, a: u32, b: u32, carry: u32) -> u32 = add_flags(cpu, a, ~b, carry)

@inline
flag_n(cpu: *Cpu) -> u32 = cpu.nz >> 31

@inline
flag_z(cpu: *Cpu) -> bool = cpu.nz == 0

// Overflow: the operands agreed in sign and the result does not.
@inline
flag_v(cpu: *Cpu) -> u32 = ((cpu.va ^ cpu.vr) & (cpu.vb ^ cpu.vr)) >> 31

// Condition `cond` (the four-bit field of a `B<cond>`) against the flags.
@inline
holds(cpu: *Cpu, cond: u32) -> bool = cond match
    0 -> cpu.nz == 0
    1 -> cpu.nz != 0
    2 -> cpu.c != 0
    3 -> cpu.c == 0
    4 -> flag_n(cpu) != 0
    5 -> flag_n(cpu) == 0
    6 -> flag_v(cpu) != 0
    7 -> flag_v(cpu) == 0
    8 -> cpu.c != 0 && cpu.nz != 0
    9 -> cpu.c == 0 || cpu.nz == 0
    10 -> flag_n(cpu) == flag_v(cpu)
    11 -> flag_n(cpu) != flag_v(cpu)
    12 -> cpu.nz != 0 && flag_n(cpu) == flag_v(cpu)
    13 -> cpu.nz == 0 || flag_n(cpu) != flag_v(cpu)
    _ -> true

// ---------------------------------------------------------------------------------------------------
// Shifts by a register, as the data-processing forms define them: the bottom byte of the amount, and
// the carry out of the last bit shifted (unchanged when the amount is 0).

lsl_reg(cpu: *Cpu, x: u32, by: u32) -> u32
    val n = by & 0xFF

    if n == 0 then return x

    if n < 32
        cpu.c = (x >> (32 - n)) & 1
        return x << n

    cpu.c = if n == 32 then x & 1 else 0
    0

lsr_reg(cpu: *Cpu, x: u32, by: u32) -> u32
    val n = by & 0xFF

    if n == 0 then return x

    if n < 32
        cpu.c = (x >> (n - 1)) & 1
        return x >> n

    cpu.c = if n == 32 then x >> 31 else 0
    0

asr_reg(cpu: *Cpu, x: u32, by: u32) -> u32
    val n = by & 0xFF

    if n == 0 then return x

    if n < 32
        cpu.c = u32.wrap(i32.wrap(x) >> (n - 1)) & 1
        return u32.wrap(i32.wrap(x) >> n)

    cpu.c = x >> 31
    u32.wrap(i32.wrap(x) >> 31)

ror_reg(cpu: *Cpu, x: u32, by: u32) -> u32
    if by & 0xFF == 0 then return x

    val n = by & 31
    val res = if n == 0 then x else (x >> n) | (x << (32 - n))

    cpu.c = res >> 31
    res

/** Reset `mem` from a packed image laid out by `map`: RAM backing first, then flash contents, and
 * attach `cpu` to it. The map is page aligned and checked by the board assembler, which coalesces
 * physically adjacent banks before assigning backing offsets.
 */
reset_mapped(cpu: *Cpu, mem: &sync Memory, image: []const u8, map: MemoryMap)
    require map.banks.len() <= 7, "at most seven extra RAM banks"
    require map.ram_size <= RAM_BYTES && map.flash_size <= FLASH_BYTES, "the map fits the backing"
    require map.flash_size == 0 || image.len >= usize(RAM_BYTES + map.flash_size), "the image holds the flash"
    reset(cpu, mem, if image.len > usize(RAM_BYTES) then image[..<usize(RAM_BYTES)] else image, 0)
    mem.ram_base = map.ram_at
    mem.ram_size = map.ram_size
    mem.flash_base = map.flash_at
    mem.flash_size = map.flash_size
    for p in 0..<(RAM_BYTES >> PAGE_SHIFT) do mem.page_table[p] = 0
    for p in 0..<(mem.ram_size >> PAGE_SHIFT) do mem.page_table[(mem.ram_base >> PAGE_SHIFT) + p] = usize(&mem.ram[p << PAGE_SHIFT])
    for bank in map.banks
        assert(bank.base & 4095 == 0 && bank.size & 4095 == 0 && bank.offset & 4095 == 0, "page-aligned RAM bank")
        assert(u64(bank.offset) + u64(bank.size) <= u64(RAM_BYTES), "RAM bank fits backing")
        mem.extra_ram[mem.extra_ram_count] = bank
        mem.extra_ram_count += 1
        for p in 0..<(bank.size >> PAGE_SHIFT)
            val page = (bank.base >> PAGE_SHIFT) + p
            mem.page_table[page] = usize(&mem.ram[bank.offset + (p << PAGE_SHIFT)])
            mem.bank_store_pages[page >> 6] |= 1u64 << u64(page & 63)
    mem.install_ram_guards(&mem.decoded[0])
    for i in 0..<mem.flash_size do mem.flash[i] = image[usize(RAM_BYTES + i)]
    for p in 0..<(mem.flash_size >> PAGE_SHIFT) do mem.page_table[(mem.flash_base >> PAGE_SHIFT) + p] = usize(&mem.flash[p << PAGE_SHIFT])
    for i in (FLASH_OFFSET >> 1)..((FLASH_OFFSET + mem.flash_size) >> 1) do mem.decoded[i] = undecoded()

/** Make the map's other RAM region at `base` read-only to the guest: still read and executed on the
 * fast path, while a store to it goes to the bus (`Bus.write`), which says why it is refused.
 */
read_only(mem: &sync Memory, base: u32)
    for i in 0..<mem.extra_ram_count
        val b = mem.extra_ram[i]
        if b.base != base then continue
        mem.read_only_banks |= 1u32 << u32(i)
        for p in 0..<(b.size >> PAGE_SHIFT)
            val page = (b.base >> PAGE_SHIFT) + p
            mem.bank_store_pages[page >> 6] &= ~(1u64 << u64(page & 63))

/** `length` bytes of flash from `offset` have been changed by something other than a core's store (a
 * flash device being programmed or erased): every record decoded from them, and every record that
 * reads them (from 16 bytes before, for an IT block's, to 18 after), decodes again when control next
 * reaches it, on either core. Called between instructions, or from a bus access, as `forget` is.
 */
flash_changed(mem: &sync Memory, offset: u32, length: u32)
    if length == 0 || offset >= mem.flash_size then return
    val from = if offset >= 16 then offset - 16 else 0
    val end = if u64(offset) + u64(length) + 18 < u64(mem.flash_size) then offset + length + 18 else mem.flash_size
    for i in ((FLASH_OFFSET + from) >> 1)..<((FLASH_OFFSET + end + 1) >> 1)
        mem.decoded[i] = undecoded()
        mem.decoded_own[i] = undecoded()

/** A DMA/device bus write made on this core's host thread, to RAM only: it never enters MMIO or
 * faults the CPU, and answers whether it was made. The store's own bookkeeping invalidates decoded
 * instructions and the peer's monitor; the device also invalidates this core's monitor.
 */
device_store(cpu: *Cpu, address: u32, width: u32, value: u32) -> bool
    if (width != 1 && width != 2 && width != 4) || address & (width - 1) != 0 then return false
    val page = store_page(cpu,address,width)
    if page == 0 then return false
    host_write(page,address,width,value)
    stored(cpu,address,width)
    if cpu.excl && (address >> LINE_SHIFT) == (cpu.excl_addr >> LINE_SHIFT) then cpu.excl = false
    true
