module sh.sysl.benchtop.v6m

import sysl.fenv.{RoundingMode, with_rounding}

// The floating-point extension's data processing, and the handlers of its records (fpu.sysl has the
// state, the decoder and the transfers). Every function here that computes with a float is
// `@strict_fp`. `fp_single` and `fp_double` take the operation as a value; a handler made for one
// operation (`h_fp`) passes a constant, so its body is that operation alone.

// ---------------------------------------------------------------------------------------------------
// Single precision.

@inline
@strict_fp
fp_single(cpu: *Cpu, i: *Insn, k: u32)
    val d = fp_dest(i)
    val n = fp_n(i)
    val m = fp_m(i)
    val x = fp_extra(i)

    k match
        FP_ADD -> sset(cpu, d, sget(cpu, n) + sget(cpu, m))
        FP_SUB -> sset(cpu, d, sget(cpu, n) - sget(cpu, m))
        FP_MUL -> sset(cpu, d, sget(cpu, n) * sget(cpu, m))
        FP_NMUL ->
            val p = sget(cpu, n) * sget(cpu, m)
            sset(cpu, d, -p)
        // The multiply-accumulates round the product, then the sum: two operations, as the `val`
        // between them keeps them. The negations are the architecture's, of the operand itself.
        FP_MLA ->
            val p = sget(cpu, n) * sget(cpu, m)
            sset(cpu, d, sget(cpu, d) + p)
        FP_MLS ->
            val p = sget(cpu, n) * sget(cpu, m)
            val q = -p
            sset(cpu, d, sget(cpu, d) + q)
        FP_NMLA ->
            val p = sget(cpu, n) * sget(cpu, m)
            val q = -p
            val a = -sget(cpu, d)
            sset(cpu, d, a + q)
        FP_NMLS ->
            val p = sget(cpu, n) * sget(cpu, m)
            val a = -sget(cpu, d)
            sset(cpu, d, a + p)
        FP_DIV -> sset(cpu, d, sget(cpu, n) / sget(cpu, m))
        FP_FMA -> sset(cpu, d, fma32(sget(cpu, n), sget(cpu, m), sget(cpu, d)))
        FP_FMS -> sset(cpu, d, fma32(-sget(cpu, n), sget(cpu, m), sget(cpu, d)))
        FP_FNMA -> sset(cpu, d, fma32(-sget(cpu, n), sget(cpu, m), -sget(cpu, d)))
        FP_FNMS -> sset(cpu, d, fma32(sget(cpu, n), sget(cpu, m), -sget(cpu, d)))
        FP_MOV -> cpu.s[d] = cpu.s[m]
        FP_ABS -> cpu.s[d] = cpu.s[m] & 0x7FFFFFFF
        FP_NEG -> cpu.s[d] = cpu.s[m] ^ 0x80000000
        FP_SQRT -> sset(cpu, d, sqrt32(sget(cpu, m)))
        FP_MOVI -> cpu.s[d] = expand32(x)
        FP_CMP -> compare(cpu, f64(sget(cpu, d)), if x & 2 != 0 then 0.0 else f64(sget(cpu, m)), x & 1 != 0)
        FP_FROM_INT ->
            val v = cpu.s[m]
            sset(cpu, d, if x & 1 != 0 then f32(i32(v)) else f32(v))
        FP_TO_INT -> cpu.s[d] = to_int(cpu, f64(sget(cpu, m)), x & 7, x & 8 != 0)
        // From fixed point, the conversion rounds to nearest whatever FPSCR's mode; the scaling is exact.
        FP_FROM_FIXED ->
            val v = with_rounding(RoundingMode.NearestEven, () -> f32(fixed_value(cpu.s[d], x)))
            sset(cpu, d, v * f32.from_bits((127 - (x & 63)) << 23))
        FP_TO_FIXED -> cpu.s[d] = u32(to_fixed(cpu, f64(sget(cpu, d)) * f64.from_bits(u64(1023 + (x & 63)) << 52), x))
        FP_CVT -> dset(cpu, d, f64(sget(cpu, m)))
        FP_RINT -> sset(cpu, d, rounded32(sget(cpu, m), x))
        FP_SEL -> cpu.s[d] = if holds(cpu, sel_condition(x)) then cpu.s[n] else cpu.s[m]
        FP_MAXNM -> sset(cpu, d, maxnum32(sget(cpu, n), sget(cpu, m)))
        FP_MINNM -> sset(cpu, d, minnum32(sget(cpu, n), sget(cpu, m)))
        FP_HALF ->
            if x & 2 != 0 then set_half(cpu, d, x & 1, f16(sget(cpu, m))) else sset(cpu, d, f32(half(cpu, m, x & 1)))
        _ -> ()
end fp_single

// ---------------------------------------------------------------------------------------------------
// Double precision.

@inline
@strict_fp
fp_double(cpu: *Cpu, i: *Insn, k: u32)
    val d = fp_dest(i)
    val n = fp_n(i)
    val m = fp_m(i)
    val x = fp_extra(i)

    k match
        FP_ADD -> dset(cpu, d, dget(cpu, n) + dget(cpu, m))
        FP_SUB -> dset(cpu, d, dget(cpu, n) - dget(cpu, m))
        FP_MUL -> dset(cpu, d, dget(cpu, n) * dget(cpu, m))
        FP_NMUL ->
            val p = dget(cpu, n) * dget(cpu, m)
            dset(cpu, d, -p)
        FP_MLA ->
            val p = dget(cpu, n) * dget(cpu, m)
            dset(cpu, d, dget(cpu, d) + p)
        FP_MLS ->
            val p = dget(cpu, n) * dget(cpu, m)
            val q = -p
            dset(cpu, d, dget(cpu, d) + q)
        FP_NMLA ->
            val p = dget(cpu, n) * dget(cpu, m)
            val q = -p
            val a = -dget(cpu, d)
            dset(cpu, d, a + q)
        FP_NMLS ->
            val p = dget(cpu, n) * dget(cpu, m)
            val a = -dget(cpu, d)
            dset(cpu, d, a + p)
        FP_DIV -> dset(cpu, d, dget(cpu, n) / dget(cpu, m))
        FP_FMA -> dset(cpu, d, fma64(dget(cpu, n), dget(cpu, m), dget(cpu, d)))
        FP_FMS -> dset(cpu, d, fma64(-dget(cpu, n), dget(cpu, m), dget(cpu, d)))
        FP_FNMA -> dset(cpu, d, fma64(-dget(cpu, n), dget(cpu, m), -dget(cpu, d)))
        FP_FNMS -> dset(cpu, d, fma64(dget(cpu, n), dget(cpu, m), -dget(cpu, d)))
        FP_MOV -> dset_bits(cpu, d, dbits(cpu, m))
        FP_ABS -> dset_bits(cpu, d, dbits(cpu, m) & 0x7FFFFFFFFFFFFFFF)
        FP_NEG -> dset_bits(cpu, d, dbits(cpu, m) ^ 0x8000000000000000)
        FP_SQRT -> dset(cpu, d, sqrt64(dget(cpu, m)))
        FP_MOVI -> dset_bits(cpu, d, expand64(x))
        FP_CMP -> compare(cpu, dget(cpu, d), if x & 2 != 0 then 0.0 else dget(cpu, m), x & 1 != 0)
        FP_FROM_INT ->
            val v = cpu.s[m]
            dset(cpu, d, if x & 1 != 0 then f64(i32(v)) else f64(v))
        // Sd receives the integer from Dm.
        FP_TO_INT -> cpu.s[d] = to_int(cpu, dget(cpu, m), x & 7, x & 8 != 0)
        FP_FROM_FIXED -> dset(cpu, d, f64(fixed_value(cpu.s[2 * d], x)) * f64.from_bits(u64(1023 - (x & 63)) << 52))
        FP_TO_FIXED -> dset_bits(cpu, d, to_fixed(cpu, scaled(dget(cpu, d), x & 63), x))
        // Sd receives Dm narrowed.
        FP_CVT -> sset(cpu, d, f32(dget(cpu, m)))
        FP_RINT -> dset(cpu, d, rounded64(dget(cpu, m), x))
        FP_SEL -> dset_bits(cpu, d, if holds(cpu, sel_condition(x)) then dbits(cpu, n) else dbits(cpu, m))
        FP_MAXNM -> dset(cpu, d, maxnum64(dget(cpu, n), dget(cpu, m)))
        FP_MINNM -> dset(cpu, d, minnum64(dget(cpu, n), dget(cpu, m)))
        FP_HALF ->
            if x & 2 != 0 then set_half(cpu, d, x & 1, f16(dget(cpu, m))) else dset(cpu, d, f64(half(cpu, m, x & 1)))
        _ -> ()
end fp_double

// The half-precision value in the bottom (`top` 0) or top half of Sk, and a new one put there, the
// other half kept.
@inline
half(cpu: *Cpu, k: u32, top: u32) -> f16 = f16.from_bits(u16(cpu.s[k] >> (top * 16)))

@inline
set_half(cpu: *Cpu, k: u32, top: u32, h: f16)
    val at = top * 16
    cpu.s[k] = (cpu.s[k] & ~(0xFFFF << at)) | (u32(h.bits()) << at)

// ---------------------------------------------------------------------------------------------------
// The pieces.

// VFPExpandImm: the 8-bit immediate's sign, three exponent bits and four fraction bits.
expand32(imm8: u32) -> u32
    val b6 = (imm8 >> 6) & 1
    val exp = ((b6 ^ 1) << 7) | (if b6 == 1 then 0x7C else 0) | ((imm8 >> 4) & 3)

    ((imm8 >> 7) << 31) | (exp << 23) | ((imm8 & 0xF) << 19)

expand64(imm8: u32) -> u64
    val b6 = u64((imm8 >> 6) & 1)
    val exp = ((b6 ^ 1) << 10) | (if b6 == 1 then 0x3FC else 0) | u64((imm8 >> 4) & 3)

    (u64(imm8 >> 7) << 63) | (exp << 52) | (u64(imm8 & 0xF) << 48)

// VSEL's condition as the core's: EQ, VS, GE, GT.
@inline
sel_condition(x: u32) -> u32 = x match
    0 -> 0
    1 -> 6
    2 -> 10
    _ -> 12

// VCMP and VCMPE, on the operands widened (exactly; a signalling NaN raises invalid as the compare
// would). Unordered is NZCV 0011; VCMPE raises invalid for a quiet NaN too. Both operands are read
// whatever the first is, so a subnormal one raises input-denormal under flush-to-zero beside a NaN.
@strict_fp
compare(cpu: *Cpu, a: f64, b: f64, signal: bool)
    var nzcv: u32 = 0
    val a_nan = a != a
    val b_nan = b != b

    if a_nan || b_nan
        if signal then cpu.fpscr |= FP_IOC
        nzcv = 0x3
    else if a == b
        nzcv = 0x6
    else if a < b
        nzcv = 0x8
    else
        nzcv = 0x2

    cpu.fpscr = (cpu.fpscr & 0x0FFFFFFF) | (nzcv << 28)

// `x` rounded to an integral value as `rounding` says. Only ROUND_EXACT raises inexact.
@strict_fp
rounded32(x: f32, rounding: u32) -> f32 = rounding match
    ROUND_ZERO -> trunc32(x)
    ROUND_MODE -> nearbyint32(x)
    ROUND_EXACT -> rint32(x)
    ROUND_AWAY -> round32(x)
    ROUND_UP -> ceil32(x)
    ROUND_EVEN -> roundeven32(x)
    _ -> floor32(x)

@strict_fp
rounded64(x: f64, rounding: u32) -> f64 = rounding match
    ROUND_ZERO -> trunc64(x)
    ROUND_MODE -> nearbyint64(x)
    ROUND_EXACT -> rint64(x)
    ROUND_AWAY -> round64(x)
    ROUND_UP -> ceil64(x)
    ROUND_EVEN -> roundeven64(x)
    _ -> floor64(x)

// FPToFixed to a 32-bit integer: rounded as `rounding` says, saturating with invalid past either
// end (a NaN is 0, and invalid), and inexact where a fraction was dropped. Rounding to an integer is
// exact at either precision, so a single's value is rounded widened.
@strict_fp
to_int(cpu: *Cpu, x: f64, rounding: u32, signed: bool) -> u32
    if x != x
        cpu.fpscr |= FP_IOC
        return 0

    val r = rounded64(x, rounding)

    if signed
        if r >= 2147483648.0
            cpu.fpscr |= FP_IOC
            return 0x7FFFFFFF
        if r < -2147483648.0
            cpu.fpscr |= FP_IOC
            return 0x80000000
    else
        if r >= 4294967296.0
            cpu.fpscr |= FP_IOC
            return 0xFFFFFFFF
        if r < 0.0
            cpu.fpscr |= FP_IOC
            return 0

    if r != x then cpu.fpscr |= FP_IXC

    if signed then u32(i32(r)) else u32(r)

// The fixed-point integer in the low bits of `raw`, as `extra` describes it, as a value.
@inline
fixed_value(raw: u32, extra: u32) -> i64
    val unsigned = (extra >> 6) & 1 != 0

    if (extra >> 7) & 1 != 0
        return if unsigned then i64(raw) else i64(i32(raw))

    if unsigned then i64(raw & 0xFFFF) else i64(i16(raw))

// A double scaled up by 2^`fbits`, which is exact short of an overflow; past 2^63 every fixed-point
// result saturates anyway, so such a value is left as it is rather than raising overflow.
@strict_fp
scaled(x: f64, fbits: u32) -> f64
    if x != x || (x.bits() & 0x7FFFFFFFFFFFFFFF) >= 0x43E0000000000000 then return x

    x * f64.from_bits(u64(1023 + fbits) << 52)

// FPToFixed with the fraction bits already scaled in: rounded toward zero to the integer `extra`
// describes, saturating with invalid, inexact where a fraction was dropped, and extended to 64 bits
// as the integer is signed or not.
@strict_fp
to_fixed(cpu: *Cpu, y: f64, extra: u32) -> u64
    val unsigned = (extra >> 6) & 1 != 0
    val size: u32 = if (extra >> 7) & 1 != 0 then 32 else 16
    val hi = if unsigned then f64.from_bits(u64(1023 + size) << 52) - 1.0 else f64.from_bits(u64(1023 + size - 1) << 52) - 1.0
    val lo = if unsigned then 0.0 else -f64.from_bits(u64(1023 + size - 1) << 52)

    if y != y
        cpu.fpscr |= FP_IOC
        return 0

    val r = trunc64(y)
    var v: i64 = 0

    if r > hi
        cpu.fpscr |= FP_IOC
        v = i64(hi)
    else if r < lo
        cpu.fpscr |= FP_IOC
        v = i64(lo)
    else
        if r != y then cpu.fpscr |= FP_IXC
        v = i64(r)

    u64(v)
end to_fixed

// ---------------------------------------------------------------------------------------------------
// Handlers.

// `Op.FpData` with the operation `K` at precision `D`, after the extension's access check.
@strict_fp
h_fp[const K: u32, const D: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if !fp_ok(cpu, ip)
        stop_access(cpu, ip, n)
        return

    if D == 0 then fp_single(cpu, ip, K) else fp_double(cpu, ip, K)
    become next(cpu, &ip[2], retire_timed(cpu, ip, n))

// The same with the operation read from the record: the `match` executor's, through `x_fp`.
@strict_fp
x_fp(cpu: *Cpu, ip: *Insn)
    if fp_is_double(ip) == 0 then fp_single(cpu, ip, fp_op(ip)) else fp_double(cpu, ip, fp_op(ip))

@strict_fp
h_fp_any(cpu: *Cpu, ip: *Insn, n: u64)
    if !fp_ok(cpu, ip)
        stop_access(cpu, ip, n)
        return

    x_fp(cpu, ip)
    become next(cpu, &ip[2], retire_timed(cpu, ip, n))

h_fp_ldr(cpu: *Cpu, ip: *Insn, n: u64)
    if fp_ok(cpu, ip) && x_fp_ldr(cpu, ip, n) then become next(cpu, &ip[2], retire_timed(cpu, ip, n))
    stop_access(cpu, ip, n)

h_fp_ldr_lit(cpu: *Cpu, ip: *Insn, n: u64)
    if fp_ok(cpu, ip) && x_fp_ldr_lit(cpu, ip, n) then become next(cpu, &ip[2], retire_timed(cpu, ip, n))
    stop_access(cpu, ip, n)

h_fp_multi(cpu: *Cpu, ip: *Insn, n: u64)
    if fp_ok(cpu, ip) && x_fp_multi(cpu, ip, n) then become next(cpu, &ip[2], retire_timed(cpu, ip, n))
    stop_access(cpu, ip, n)

h_fp_move(cpu: *Cpu, ip: *Insn, n: u64)
    if !fp_ok(cpu, ip)
        stop_access(cpu, ip, n)
        return

    x_fp_move(cpu, ip)
    become next(cpu, &ip[2], retire_timed(cpu, ip, n))

// The handler for an `Op.FpData` record: its operation's own.
fp_handler(ip: *Insn) -> Handler = if fp_is_double(ip) == 0 then fp_handler_s(fp_op(ip)) else fp_handler_d(fp_op(ip))

private fp_handler_s(k: u32) -> Handler = k match
    FP_ADD -> &h_fp[FP_ADD, 0]
    FP_SUB -> &h_fp[FP_SUB, 0]
    FP_MUL -> &h_fp[FP_MUL, 0]
    FP_NMUL -> &h_fp[FP_NMUL, 0]
    FP_MLA -> &h_fp[FP_MLA, 0]
    FP_MLS -> &h_fp[FP_MLS, 0]
    FP_NMLA -> &h_fp[FP_NMLA, 0]
    FP_NMLS -> &h_fp[FP_NMLS, 0]
    FP_DIV -> &h_fp[FP_DIV, 0]
    FP_FMA -> &h_fp[FP_FMA, 0]
    FP_FMS -> &h_fp[FP_FMS, 0]
    FP_FNMA -> &h_fp[FP_FNMA, 0]
    FP_FNMS -> &h_fp[FP_FNMS, 0]
    FP_MOV -> &h_fp[FP_MOV, 0]
    FP_ABS -> &h_fp[FP_ABS, 0]
    FP_NEG -> &h_fp[FP_NEG, 0]
    FP_SQRT -> &h_fp[FP_SQRT, 0]
    FP_MOVI -> &h_fp[FP_MOVI, 0]
    FP_CMP -> &h_fp[FP_CMP, 0]
    FP_FROM_INT -> &h_fp[FP_FROM_INT, 0]
    FP_TO_INT -> &h_fp[FP_TO_INT, 0]
    FP_FROM_FIXED -> &h_fp[FP_FROM_FIXED, 0]
    FP_TO_FIXED -> &h_fp[FP_TO_FIXED, 0]
    FP_CVT -> &h_fp[FP_CVT, 0]
    FP_RINT -> &h_fp[FP_RINT, 0]
    FP_SEL -> &h_fp[FP_SEL, 0]
    FP_MAXNM -> &h_fp[FP_MAXNM, 0]
    FP_MINNM -> &h_fp[FP_MINNM, 0]
    FP_HALF -> &h_fp[FP_HALF, 0]
    _ -> &h_fp_any

private fp_handler_d(k: u32) -> Handler = k match
    FP_ADD -> &h_fp[FP_ADD, 1]
    FP_SUB -> &h_fp[FP_SUB, 1]
    FP_MUL -> &h_fp[FP_MUL, 1]
    FP_NMUL -> &h_fp[FP_NMUL, 1]
    FP_MLA -> &h_fp[FP_MLA, 1]
    FP_MLS -> &h_fp[FP_MLS, 1]
    FP_NMLA -> &h_fp[FP_NMLA, 1]
    FP_NMLS -> &h_fp[FP_NMLS, 1]
    FP_DIV -> &h_fp[FP_DIV, 1]
    FP_FMA -> &h_fp[FP_FMA, 1]
    FP_FMS -> &h_fp[FP_FMS, 1]
    FP_FNMA -> &h_fp[FP_FNMA, 1]
    FP_FNMS -> &h_fp[FP_FNMS, 1]
    FP_MOV -> &h_fp[FP_MOV, 1]
    FP_ABS -> &h_fp[FP_ABS, 1]
    FP_NEG -> &h_fp[FP_NEG, 1]
    FP_SQRT -> &h_fp[FP_SQRT, 1]
    FP_MOVI -> &h_fp[FP_MOVI, 1]
    FP_CMP -> &h_fp[FP_CMP, 1]
    FP_FROM_INT -> &h_fp[FP_FROM_INT, 1]
    FP_TO_INT -> &h_fp[FP_TO_INT, 1]
    FP_FROM_FIXED -> &h_fp[FP_FROM_FIXED, 1]
    FP_TO_FIXED -> &h_fp[FP_TO_FIXED, 1]
    FP_CVT -> &h_fp[FP_CVT, 1]
    FP_RINT -> &h_fp[FP_RINT, 1]
    FP_SEL -> &h_fp[FP_SEL, 1]
    FP_MAXNM -> &h_fp[FP_MAXNM, 1]
    FP_MINNM -> &h_fp[FP_MINNM, 1]
    FP_HALF -> &h_fp[FP_HALF, 1]
    _ -> &h_fp_any
