module sh.sysl.benchtop.v6m

// The Security Extension's Secure side (ARMv8-M ARM, DDI0553: "The Security Extension", "Security
// attribution", "TT, TTT, TTA, TTAT", "Stack limit checks", "Fault handling"), and the faults ARMv8-M
// Mainline takes rather than stops at. Non-secure state is t2nonsecure.sysl's.
//
// A core with `Cpu.security` resets into Secure state. `SG` is a `NOP` in Secure state, as the
// architecture has it.
//
// **The SAU** (`SAU_CTRL`, `SAU_TYPE`, `SAU_RNR`, `SAU_RBAR`, `SAU_RLAR`; `regs/m33.h`, M33_SAU_*) has
// the M33's eight regions; `TT` answers from it and the core enforces it (t2nonsecure.sysl). Its reset
// state, disabled with ALLNS clear, makes every address Secure, which is what the SDK runs under.
//
// **The IDAU** is the board's: at most one region that reports a number (`Cpu.idau`), Secure
// Non-secure-callable, which outranks the SAU's Non-secure; every other address is exempt or left to
// the SAU, with no IDAU region valid. The RP2350's is the boot ROM's 0x7e00–0x7fff, region 2 (its
// boot ROM's start-up checks `TT` of both answers).
//
// **The MPU** (`MPU_TYPE`, `MPU_CTRL`, `MPU_RNR`, `MPU_RBAR`, `MPU_RLAR` and their three aliases,
// `MAIR0`, `MAIR1`; `regs/m33.h`, M33_MPU_*) is stored, with the M33's eight regions per state, and
// `TT` answers MREGION, MRVALID and the R and RW permissions from it. It is not enforced: an access its
// regions forbid is made, where silicon takes a MemManage fault. `NSACR` and NVIC_ITNS are stored.
//
// **Faults taken.** A stack-limit violation is the UsageFault STKOF, and an EXC_RETURN whose ES bit
// names a Non-secure exception from Secure state is the UsageFault INVPC: each is recorded in the
// state's CFSR and taken where SHCSR enables it and its priority preempts, escalated to HardFault
// (HFSR.FORCED) where it does not, and a lockup — a stop — where not even HardFault would preempt.
// SecureFault (exception 7) has its enable, its priority in SHPR1 and its status in SFSR and SFAR;
// software pends it through SHCSR.

/** The SAU regions the M33 on the RP2350 has (M33_SAU_TYPE_SREGION_RESET). */
const SAU_REGIONS: u32 = 8

const SCB_SFSR: u32 = 0xE000EDE4
const SCB_SFAR: u32 = 0xE000EDE8
const SAU_CTRL: u32 = 0xE000EDD0
const SAU_TYPE: u32 = 0xE000EDD4
const SAU_RNR: u32 = 0xE000EDD8
const SAU_RBAR: u32 = 0xE000EDDC
const SAU_RLAR: u32 = 0xE000EDE0

/** The MPU regions the M33 on the RP2350 has (M33_MPU_TYPE_DREGION_RESET). */
const MPU_REGIONS: u32 = 8

const SCB_NSACR: u32 = 0xE000ED8C
const SCB_SCR: u32 = 0xE000ED10
const MPU_TYPE: u32 = 0xE000ED90
const MPU_CTRL: u32 = 0xE000ED94
const MPU_RNR: u32 = 0xE000ED98
const MPU_RBAR: u32 = 0xE000ED9C
const MPU_RLAR_A3: u32 = 0xE000EDB8
const MPU_MAIR0: u32 = 0xE000EDC0
const MPU_MAIR1: u32 = 0xE000EDC4
/** CPACR in the private peripheral bus's Non-secure alias. */
const CPACR_NS: u32 = 0xE002ED88

// The bits each register keeps (M33_*_BITS).
const NSACR_BITS: u32 = 0x00000CFF
const SCR_BITS: u32 = 0x0000001E
const SCR_SLEEPDEEPS: u32 = 0x00000008
const SCR_SEVONPEND: u32 = 0x00000010
const MPU_CTRL_BITS: u32 = 0x7
const MPU_RLAR_BITS: u32 = 0xFFFFFFEF

/** The IDAU region a board gives its cores: `base` to `limit` inclusive, reporting `number`, Secure
 * Non-secure-callable. `limit` below `base` is none.
 */
struct IdauRegion
    base: u32
    limit: u32
    number: u32

/** No IDAU region. */
val NO_IDAU: IdauRegion = IdauRegion(1, 0, 0)

const SECURE_FAULT: u32 = 7

// CFSR's UsageFault bits (UFSR, CFSR[31:16]), and HFSR's FORCED.
const CFSR_INVPC: u32 = 1 << 18
const CFSR_STKOF: u32 = 1 << 20
const HFSR_FORCED: u32 = 1 << 30

// CCR.STKOFHFNMIGN: at a negative priority, a stack-limit violation is ignored.
const CCR_STKOFHFNMIGN: u32 = 1 << 10

// The private peripheral bus, whose addresses the SAU does not attribute, and its Non-secure alias.
const PPB: u32 = 0xE0000000
const PPB_END: u32 = 0xE0100000
const PPB_NS: u32 = 0xE0020000
const PPB_NS_END: u32 = 0xE0030000

// The security state as a reset leaves it.
clear_security(cpu: *Cpu)
    cpu.sau_ctrl = 0
    cpu.sau_rnr = 0
    for k in 0..<SAU_REGIONS
        cpu.sau_rbar[k] = 0
        cpu.sau_rlar[k] = 0
    cpu.cfsr = 0
    cpu.hfsr = 0
    cpu.sfsr = 0
    cpu.sfar = 0
    cpu.transition = Transition.None
    cpu.nsacr = 0
    cpu.scr = 0
    cpu.idau = NO_IDAU
    cpu.mpu_ctrl = 0
    cpu.mpu_rnr = 0
    for k in 0..<MPU_REGIONS
        cpu.mpu_rbar[k] = 0
        cpu.mpu_rlar[k] = 0
    cpu.mpu_mair = [0, 0]

// ---------------------------------------------------------------------------------------------------
// Taking a fault.

// A fault exception `e` raised by the instruction at `at`, which does not complete: pending, to be
// taken before anything else runs — the run comes back, and `begin_run` takes it, to return to `at` —
// where SHCSR enables it and its priority preempts what runs; HardFault, with HFSR.FORCED, where not;
// and where not even HardFault preempts, a lockup, which stops the core at `lockup`, there. A Baseline
// core has no configurable faults: its fault is HardFault.
@cold
fault(cpu: *Cpu, e: u32, at: u32, lockup: Stop)
    val running = running_priority(cpu, true)
    var to = e

    if is_baseline(cpu.kind) || !fault_enabled(cpu, e) || group(cpu, priority(cpu, e)) >= running
        if running <= -1
            halt(cpu, lockup, at)
            return

        if !is_baseline(cpu.kind) then cpu.hfsr |= HFSR_FORCED
        to = HARD_FAULT

    set_pending(cpu, to, true)
    set_limit(cpu, 0)

// Whether a stack-limit violation is ignored: at a negative priority, under CCR.STKOFHFNMIGN.
@inline
overflow_ignored(cpu: *Cpu, priority: int) -> bool = cpu.ccr & CCR_STKOFHFNMIGN != 0 && priority < 0

// The instruction at `at` would move SP below its limit: the UsageFault STKOF, nothing of the
// instruction done and SP as it was. Answers whether the instruction stops, which it does unless
// CCR.STKOFHFNMIGN ignores the violation.
@cold
stack_overflow(cpu: *Cpu, at: u32) -> bool
    if overflow_ignored(cpu, running_priority(cpu, true)) then return false

    usage_fault(cpu, CFSR_STKOF, at, Stop.StackLimit)
    true

// The fault an exception entry whose frame would go below the stack's limit derives, judged against
// the priority the core ran at before the entry: the UsageFault STKOF of the state whose stack it is,
// where it is enabled and would preempt, HardFault where only that would; -1 for a lockup.
derived_overflow(cpu: *Cpu) -> int
    val running = running_priority(cpu, true)
    val uf = in_state(cpu, USAGE_FAULT)

    if cpu.ns then cpu.cfsr_ns |= CFSR_STKOF else cpu.cfsr |= CFSR_STKOF

    if !is_baseline(cpu.kind) && fault_enabled(cpu, uf) && group(cpu, priority(cpu, uf)) < running
        return int(uf)

    if running <= -1 then return -1

    if !is_baseline(cpu.kind) then cpu.hfsr |= HFSR_FORCED
    int(HARD_FAULT)

// Stop at `NonSecure` on the instruction (or access) at `at`, having been asked by `t` for something of
// the Security Extension that is not modelled.
@cold
non_secure(cpu: *Cpu, t: Transition, at: u32)
    if cpu.stop != Stop.Running then return

    cpu.transition = t
    halt(cpu, Stop.NonSecure, at)

// ---------------------------------------------------------------------------------------------------
// The system control space's security registers and the configurable faults' state.

// SHCSR as read: the enables kept, and each fault's active and pending state from the NVIC's sets.
// HardFault's and NMI's bits are ARMv8-M's; SecureFault's the Security Extension's.
shcsr_value(cpu: *Cpu) -> u32
    val act = cpu.active[0]
    val pend = cpu.pending[0]
    var v = cpu.shcsr | bit_of(act, MEM_MANAGE) | (bit_of(act, BUS_FAULT) << 1) | (bit_of(act, USAGE_FAULT) << 3)

    v |= (bit_of(act, SVCALL) << 7) | (bit_of(act, PENDSV) << 10) | (bit_of(act, SYSTICK) << 11)
    v |= (bit_of(pend, USAGE_FAULT) << 12) | (bit_of(pend, MEM_MANAGE) << 13) | (bit_of(pend, BUS_FAULT) << 14) | (bit_of(pend, SVCALL) << 15)

    if !is_v7m(cpu.kind)
        v |= (bit_of(act, HARD_FAULT) << 2) | (bit_of(act, NMI) << 5) | (bit_of(pend, HARD_FAULT) << 21)

    if cpu.security then v |= (bit_of(act, SECURE_FAULT) << 4) | (bit_of(pend, SECURE_FAULT) << 20)

    v

// An SHCSR write: the enables, which also make each fault eligible to be taken (`Cpu.enabled`, whose
// bits below IRQ0 no interrupt uses), and the pending bits software may set or clear.
shcsr_write(cpu: *Cpu, x: u32)
    val enables: u32 = if cpu.security then 0x000F0000 else 0x00070000

    cpu.shcsr = x & enables
    cpu.enabled[0] = (cpu.enabled[0] & ~u64(0xF0)) | (u64(cpu.shcsr >> 16) << 4)
    set_pending(cpu, USAGE_FAULT, (x >> 12) & 1 != 0)
    set_pending(cpu, MEM_MANAGE, (x >> 13) & 1 != 0)
    set_pending(cpu, BUS_FAULT, (x >> 14) & 1 != 0)
    set_pending(cpu, SVCALL, (x >> 15) & 1 != 0)
    if cpu.security then set_pending(cpu, SECURE_FAULT, (x >> 20) & 1 != 0)

// The Security Extension's registers in the system control space, read: None for an address that is
// not one, or on a core without the extension. A region register with SAU_RNR past the last region is
// refused, as an access where nothing is.
secure_read(cpu: *Cpu, a: u32) -> Option[u32]
    if !cpu.security then return None

    a match
        SAU_CTRL -> Some(cpu.sau_ctrl)
        SAU_TYPE -> Some(SAU_REGIONS)
        SAU_RNR -> Some(cpu.sau_rnr)
        SAU_RBAR | SAU_RLAR ->
            if cpu.sau_rnr >= SAU_REGIONS
                halt(cpu, Stop.Unmapped, a)
                return Some(0)
            Some(if a == SAU_RBAR then cpu.sau_rbar[cpu.sau_rnr] else cpu.sau_rlar[cpu.sau_rnr])
        SCB_SFSR -> Some(cpu.sfsr)
        SCB_SFAR -> Some(cpu.sfar)
        SCB_NSACR -> Some(cpu.nsacr)
        MPU_TYPE -> Some(MPU_REGIONS << 8)
        MPU_CTRL -> Some(cpu.mpu_ctrl)
        MPU_RNR -> Some(cpu.mpu_rnr)
        MPU_MAIR0 -> Some(cpu.mpu_mair[0])
        MPU_MAIR1 -> Some(cpu.mpu_mair[1])
        _ ->
            if a >= MPU_RBAR && a <= MPU_RLAR_A3
                val (k, limit) = mpu_region_register(cpu, a)
                return Some(if limit then cpu.mpu_rlar[k] else cpu.mpu_rbar[k])
            if a >= NVIC_ITNS && a < NVIC_ITNS + 64 then return Some(cpu.itns[usize((a - NVIC_ITNS) / 4)] & itns_mask(cpu, (a - NVIC_ITNS) / 4))
            None

// The same, written; whether `a` is one of them.
secure_write(cpu: *Cpu, a: u32, x: u32) -> bool
    if !cpu.security then return false

    a match
        SAU_CTRL ->
            cpu.sau_ctrl = x & 3
            cpu.attribution_stale = true
        // The region count is fixed.
        SAU_TYPE -> ()
        SAU_RNR -> cpu.sau_rnr = x & 0xFF
        SAU_RBAR | SAU_RLAR ->
            if cpu.sau_rnr >= SAU_REGIONS
                halt(cpu, Stop.Unmapped, a)
                return true
            if a == SAU_RBAR then cpu.sau_rbar[cpu.sau_rnr] = x & 0xFFFFFFE0 else cpu.sau_rlar[cpu.sau_rnr] = x & 0xFFFFFFE3
            cpu.attribution_stale = true
        // Write one to clear.
        SCB_SFSR -> cpu.sfsr &= ~(x & 0xFF)
        SCB_SFAR -> cpu.sfar = x
        SCB_NSACR ->
            cpu.nsacr = x & NSACR_BITS
            // The Non-secure CPACR's fields NSACR no longer gives read as zero.
            if cpu.ns then cpu.cpacr &= nsacr_access(cpu) else cpu.banked.cpacr &= nsacr_access(cpu)
            cpu.fp_ready = false
        // The region count is fixed.
        MPU_TYPE -> ()
        MPU_CTRL -> cpu.mpu_ctrl = x & MPU_CTRL_BITS
        // REGION has three bits, for eight regions: the rest are dropped.
        MPU_RNR -> cpu.mpu_rnr = x & (MPU_REGIONS - 1)
        MPU_MAIR0 -> cpu.mpu_mair[0] = x
        MPU_MAIR1 -> cpu.mpu_mair[1] = x
        _ ->
            if a >= NVIC_ITNS && a < NVIC_ITNS + 64
                val k = (a - NVIC_ITNS) / 4
                cpu.itns[usize(k)] = x & itns_mask(cpu, k)
                if x != 0 then cpu.trustzone = true
                return true
            if a < MPU_RBAR || a > MPU_RLAR_A3 then return false
            val (k, limit) = mpu_region_register(cpu, a)
            if limit then cpu.mpu_rlar[k] = x & MPU_RLAR_BITS else cpu.mpu_rbar[k] = x
    true

// The implemented IRQs of NVIC_ITNS word `k`.
private itns_mask(cpu: *Cpu, k: u32) -> u32
    val first = k * 32
    if first >= cpu.nvic_irqs then return 0
    if cpu.nvic_irqs - first >= 32 then 0xFFFFFFFF else (1u32 << (cpu.nvic_irqs - first)) - 1

// The region an MPU_RBAR or MPU_RLAR, or one of their aliases, names (alias n is region RNR + n, in
// the three bits RNR has), and whether it is the limit register.
mpu_region_register(cpu: *Cpu, a: u32) -> (usize, bool)
    val word = (a - MPU_RBAR) / 4
    (usize((cpu.mpu_rnr + word / 2) & (MPU_REGIONS - 1)), word & 1 != 0)

// ---------------------------------------------------------------------------------------------------
// Security attribution and TT.

// How the SAU attributes an address: Non-secure or not, and the region that says so, -1 where no one
// region does.
struct Attribution
    non_secure: bool
    region: int
    // The region is Non-secure callable.
    nsc: bool

// The SAU's attribution of `a` ("SecurityCheck"): the private peripheral bus is exempt and Secure
// here; with the SAU disabled, ALLNS decides for every address; enabled, an address in exactly one
// enabled region is Non-secure (Secure where the region is Non-secure callable), and any other Secure,
// with no region.
attribution(cpu: *Cpu, a: u32) -> Attribution
    if a >= PPB && a < PPB_END then return Attribution(false, -1, false)
    if cpu.sau_ctrl & 1 == 0 then return Attribution(cpu.sau_ctrl & 2 != 0, -1, false)

    var hit = -1
    var hits = 0

    for k in 0..<SAU_REGIONS
        val limit = cpu.sau_rlar[k]

        if limit & 1 != 0 && a >= cpu.sau_rbar[k] && a <= (limit | 0x1F)
            hit = int(k)
            hits += 1

    if hits != 1 then return Attribution(false, -1, false)

    val nsc = cpu.sau_rlar[usize(hit)] & 2 != 0
    Attribution(!nsc, hit, nsc)

/** `TT`'s answer for `a`: `alt` for TTA and TTAT, which from Secure state ask about the Non-secure
 * domain, `unprivileged` for TTT and TTAT. S, SRVALID and SREGION come from the SAU, IRVALID and
 * IREGION from the IDAU, whose Non-secure-callable region makes an address Secure whatever the SAU
 * says; Non-secure state is answered none of them, nor NSR and NSRW. The MPU fields are answered where
 * the domain asked about is privileged (CONTROL.nPRIV clear, or handler mode): with the MPU enabled,
 * the one region of that domain's MPU holding `a` gives MREGION and its AP field R and RW, and an
 * address no region holds has the default map where PRIVDEFENA lets a privileged query use it, and no
 * access otherwise. The default map lets every address be read and written but the private peripheral
 * bus unprivileged; NSR and NSRW are R and RW of a Non-secure address.
 */
tt_response(cpu: *Cpu, a: u32, alt: bool, unprivileged: bool) -> u32
    // TTA and TTAT from Secure state ask about the other domain: its MPU and CONTROL are the bank's.
    if alt && !cpu.ns
        exchange_bank(cpu)
        val r = tt_domain(cpu, a, unprivileged, true)
        exchange_bank(cpu)
        return r
    tt_domain(cpu, a, unprivileged, !cpu.ns)

// `TT` against the live bank's MPU and privilege, the security fields where `secure` asks.
private tt_domain(cpu: *Cpu, a: u32, unprivileged: bool, secure: bool) -> u32
    val at = attribution(cpu, a)
    val idau = a >= cpu.idau.base && a <= cpu.idau.limit
    val non_secure = at.non_secure && !idau
    var resp: u32 = 0

    if secure
        if !non_secure then resp |= 1 << 22
        if at.region >= 0 then resp |= (u32(at.region) << 8) | (1 << 17)
        if idau then resp |= (cpu.idau.number << 24) | (1 << 23)

    val privileged = cpu.ipsr != 0 || cpu.control & 1 == 0

    if privileged
        var r = !(unprivileged && a >= PPB && a < PPB_END)
        var rw = r

        if cpu.mpu_ctrl & 1 != 0
            val k = mpu_region(cpu, a)
            if k >= 0
                resp |= u32(k) | (1 << 16)
                // AP: bit 2 read-only, bit 1 any privilege.
                val ap = (cpu.mpu_rbar[usize(k)] >> 1) & 3
                r = !unprivileged || ap & 1 != 0
                rw = r && ap & 2 == 0
            elif k == MPU_OVERLAP || unprivileged || cpu.mpu_ctrl & 4 == 0
                r = false
                rw = false

        if r then resp |= 1 << 18
        if rw then resp |= 1 << 19
        if secure && non_secure
            if r then resp |= 1 << 20
            if rw then resp |= 1 << 21

    resp

// The one enabled MPU region holding `a`; -1 where none does, and `MPU_OVERLAP` where more than one
// does, which no access may use (silicon faults it) and `TT` names no region for.
mpu_region(cpu: *Cpu, a: u32) -> int
    var hit = -1
    for k in 0..<MPU_REGIONS
        val limit = cpu.mpu_rlar[k]
        if limit & 1 != 0 && a >= cpu.mpu_rbar[k] & ~0x1F && a <= (limit | 0x1F)
            if hit >= 0 then return MPU_OVERLAP
            hit = int(k)
    hit

const MPU_OVERLAP: int = -2

// `TT`, `TTT`, `TTA` or `TTAT`: a = Rd, b = Rn, imm bit 1 = A, bit 0 = T.
x_tt(cpu: *Cpu, i: *Insn)
    cpu.r[i.a] = tt_response(cpu, cpu.r[i.b], i.imm & 2 != 0, i.imm & 1 != 0)

// `BXNS` or `BLXNS` (c = 1) to Rm = b whose bit 0 is set, which stays in Secure state: `BX` or
// `BLX`. Bit 0 clear goes to Non-secure state (`ns_call`), which the executors ask first.
ns_branch(cpu: *Cpu, ip: *Insn, n: u64) -> *Insn
    val target = cpu.r[ip.b]

    if ip.c == 0 then return branch_to(cpu, target, ip, n)

    cpu.r[14] = (addr_of(cpu, ip) + 2) | 1
    insn_at(cpu, target & ~1)

// Whether a `BXNS` or `BLXNS` at `ip` goes to Non-secure state: its target's bit 0 is clear.
@inline
ns_target(cpu: *Cpu, ip: *Insn) -> bool = cpu.r[ip.b] & 1 == 0
