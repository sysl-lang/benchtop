module sh.sysl.benchtop.v6m
@tests

// A machine's memory is its own: two cores on two memories share no byte, no page, no decoded record
// and no line mark, and laying one out leaves the other alone.

import sysl.buf.{Buf, buf}

@test("two memories in one process: stores, code and maps stay with their own machine")
mem_two_machines()
    val one = memory()
    val two = memory()
    var a: Cpu
    var b: Cpu

    reset(&a, one, [], 0)
    reset(&b, two, [], 0)

    // movs r0, #N; bkpt — different code at the same address of each.
    store16(&a, 0, 0x2001)
    store16(&a, 2, 0xBE00)
    store16(&b, 0, 0x2002)
    store16(&b, 2, 0xBE00)
    store32(&a, 0x100, 0x11111111)

    assert(load32(&b, 0x100) == 0, "a store to one is not in the other")

    for cpu in [&a, &b]
        cpu.stop = Stop.Budget
        set_limit(cpu, 100)
        run_threaded(cpu)

    assert(a.r[0] == 1 && b.r[0] == 2, "each runs its own code")
    assert(one.decoded[0].op != Op.Undecoded && two.decoded[0].op != Op.Undecoded, "each decoded its own")

    // Rewriting one's code forgets one's record and leaves the other's.
    store16(&a, 0, 0x2003)
    assert(one.decoded[0].op == Op.Undecoded && two.decoded[0].op != Op.Undecoded, "a store forgets its own records")

    // Laying one out with flash and a second bank leaves the other's map.
    var banks: Buf[RamBank] = buf()
    var image: Buf[u8] = buf()

    banks.push(RamBank(0x30000000, 4096, 8192))
    for i in 0..<(RAM_BYTES + 4096) do image.push(0)
    reset_mapped(&a, one, image.view(), MemoryMap(0x20000000, 4096, 0x10000000, 4096, banks))

    assert(one.flash_range(0x10000000, 4) && one.ram_range(0x30000000, 4) && one.extra_ram_count == 1)
    assert(!two.flash_range(0x10000000, 4) && !two.ram_range(0x30000000, 4) && two.extra_ram_count == 0, "the other's map")
    assert(two.ram_range(0, 4) && load32(&b, 0) == 0xBE002002, "and its RAM at 0")
    assert(a.mem != b.mem && a.pages != b.pages && a.dec != b.dec)

@test("a core attached to a memory takes its records back after `clear`, and `pair` gives the second its own")
mem_attach_and_pair()
    val mem = memory()
    var a: Cpu
    var b: Cpu

    a.kind = Kind.V7em
    b.kind = Kind.V7em
    reset(&a, mem, [], 0)
    attach_memory(&b, mem)
    clear(&b, 0)
    assert(b.mem == a.mem && b.dec == &mem.decoded[0] && b.pages == &mem.page_table[0], "one memory, shared records")

    pair(&a, &b)
    assert(b.dec == &mem.decoded_own[0] && a.dec == &mem.decoded[0], "the second core's own records")

    unpair(&a, &b)
    assert(b.dec == &mem.decoded[0] && b.peer == null && a.peer == null, "shared again")
