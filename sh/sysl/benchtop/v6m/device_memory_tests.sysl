module sh.sysl.benchtop.v6m
@tests

@test("DMA memory: device writes invalidate both monitors and paired decoded code without faulting CPUs")
device_memory_coherence()
    var a: Cpu
    var b: Cpu
    a.kind = Kind.V7em
    b.kind = Kind.V7em
    reset(&a,[],0)
    clear(&b,0)
    a.core = 0
    b.core = 1
    pair(&a,&b)
    store16(&a,0,0x2001)
    store16(&a,2,0xbe00)
    decode(&a,0,insn_at(&a,0))
    decode(&b,0,insn_at(&b,0))
    a.excl = true
    a.excl_addr = 0
    a.excl_size = 4
    val previous = watch(&b,0,4)
    assert(device_store(&a,0,2,0x2002) && !a.excl)
    assert(others_stores(&b,0) != previous)
    refresh(&b)
    run_single(&b)
    assert(b.r[0] == 2,"device writes must not leave executable RAM decoded as old instructions")
    assert(!device_store(&a,0x60000000,4,0) && a.stop == Stop.Budget)
    assert(!device_store(&a,RAM_BYTES - 1,2,0) && a.stop == Stop.Budget)
