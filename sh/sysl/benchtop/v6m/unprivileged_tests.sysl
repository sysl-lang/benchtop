module sh.sysl.benchtop.v6m
@tests

// What unprivileged thread mode may do to the special registers, against the ARM ARMs' MSR, MRS and CPS
// (ARMv6-M with the unprivileged extension, ARMv7-M, ARMv8-M): an MSR reaches APSR and nothing else,
// CPS is a NOP, and an MRS of a stack pointer, a limit or a mask reads 0 while the PSR views and
// CONTROL read as they are. A `_NS` register goes by the privilege of the Secure state naming it.
// Every case runs under both executors (`run_both_thumb2`), on the M33, the M4 and the M7, and on the
// M0+ and the M23 where the core has the register.

val MAINLINE: [3]Kind = [Kind.V8mMain, Kind.V7em, Kind.V7emM7]
val EVERY: [5]Kind = [Kind.V8mMain, Kind.V7em, Kind.V7emM7, Kind.V6m, Kind.M23]

const PSP_AT: u32 = 0x1C00

// Unprivileged thread mode on the main stack, PSP at PSP_AT.
unprivileged(cpu: *Cpu)
    cpu.control = 1
    cpu.sp_other = PSP_AT

// The same with PRIMASK set, and BASEPRI and FAULTMASK where the core has them.
unprivileged_masked(cpu: *Cpu)
    unprivileged(cpu)
    cpu.primask = 1
    if !is_baseline(cpu.kind)
        cpu.basepri = 0x40
        cpu.faultmask = 1

// Unprivileged thread mode on the process stack, at PSP_AT, as an RTOS task runs.
unprivileged_task(cpu: *Cpu)
    cpu.sp_other = cpu.r[13]
    cpu.r[13] = PSP_AT
    cpu.control = 3

// `code` from `setup`'s mode on `kind`, run to its BKPT.
on(kind: Kind, code: []const u16, regs: []const u32, setup: Setup) -> Cpu
    val c = run_both_thumb2(kind, code, regs, 0, [], setup)
    assert(c.stop == Stop.Breakpoint && c.stop_at == u32(code.len) * 2, s"${model_of(kind).name}: ${c.stop} at 0x${c.stop_at}")
    c

// ---------------------------------------------------------------------------------------------------
// MSR.

@test("an unprivileged MSR PRIMASK is ignored")
unpriv_msr_primask()
    // msr primask, r1
    for kind in EVERY
        assert(on(kind, [0xF381, 0x8810], [0, 1], &unprivileged).primask == 0, model_of(kind).name)

@test("an unprivileged MSR BASEPRI is ignored")
unpriv_msr_basepri()
    // msr basepri, r1
    for kind in MAINLINE
        assert(on(kind, [0xF381, 0x8811], [0, 0x10], &unprivileged).basepri == 0, model_of(kind).name)

@test("an unprivileged MSR BASEPRI_MAX is ignored")
unpriv_msr_basepri_max()
    // msr basepri_max, r1
    for kind in MAINLINE
        assert(on(kind, [0xF381, 0x8812], [0, 0x10], &unprivileged).basepri == 0, model_of(kind).name)

@test("an unprivileged MSR FAULTMASK is ignored")
unpriv_msr_faultmask()
    // msr faultmask, r1
    for kind in MAINLINE
        assert(on(kind, [0xF381, 0x8813], [0, 1], &unprivileged).faultmask == 0, model_of(kind).name)

@test("an unprivileged MSR CONTROL keeps nPRIV, SPSEL and FPCA: code cannot make itself privileged or change its stack")
unpriv_msr_control()
    // msr control, r1: nPRIV clear, then SPSEL and FPCA set with it.
    for kind in EVERY
        for x in [0u32, 6]
            val c = on(kind, [0xF381, 0x8814], [0, x], &unprivileged)

            assert(c.control == 1 && c.r[13] == 0x2000 && c.sp_other == PSP_AT, s"${model_of(kind).name}: CONTROL 0x${c.control} after $x")

@test("an unprivileged MSR MSP is ignored")
unpriv_msr_msp()
    // msr msp, r1
    for kind in EVERY
        assert(on(kind, [0xF381, 0x8808], [0, 0x1800], &unprivileged).r[13] == 0x2000, model_of(kind).name)

@test("an unprivileged MSR PSP is ignored")
unpriv_msr_psp()
    // msr psp, r1
    for kind in EVERY
        assert(on(kind, [0xF381, 0x8809], [0, 0x1800], &unprivileged).sp_other == PSP_AT, model_of(kind).name)

@test("an unprivileged MSR MSPLIM or PSPLIM is ignored")
unpriv_msr_limits()
    // msr msplim, r1; msr psplim, r1
    val c = on(Kind.V8mMain, [0xF381, 0x880A, 0xF381, 0x880B], [0, 0x1000], &unprivileged)

    assert(c.msplim == 0 && c.psplim == 0)

@test("an unprivileged MSR APSR_nzcvq still writes the flags, and MRS APSR reads them")
unpriv_msr_apsr()
    // msr apsr_nzcvq, r1; mrs r0, apsr; log r0
    for kind in EVERY
        var c = on(kind, [0xF381, 0x8800, MRS, 0x8000, LOG_R0], [0, 0xB0000000, 0, 0, LOG], &unprivileged)

        assert(flags(&c) == 0b1011 && logged(&c, [0xB0000000]), model_of(kind).name)

// ---------------------------------------------------------------------------------------------------
// CPS.

@test("an unprivileged CPSID i is a NOP, and so is CPSID f")
unpriv_cpsid()
    for kind in EVERY
        assert(on(kind, [CPSID], [], &unprivileged).primask == 0, model_of(kind).name)
    // cpsid f
    for kind in MAINLINE
        assert(on(kind, [0xB671], [], &unprivileged).faultmask == 0, model_of(kind).name)

@test("an unprivileged CPSIE i is a NOP, and so is CPSIE f")
unpriv_cpsie()
    for kind in EVERY
        assert(on(kind, [CPSIE], [], &unprivileged_masked).primask == 1, model_of(kind).name)
    // cpsie f
    for kind in MAINLINE
        assert(on(kind, [0xB661], [], &unprivileged_masked).faultmask == 1, model_of(kind).name)

// ---------------------------------------------------------------------------------------------------
// MRS.

@test("an unprivileged MRS of PRIMASK, MSP or PSP reads 0, and of CONTROL reads it")
unpriv_mrs()
    // mrs r0, primask; log; mrs r0, msp; log; mrs r0, psp; log; mrs r0, control; log
    val code: []const u16 = [MRS, 0x8010, LOG_R0, MRS, 0x8008, LOG_R0, MRS, 0x8009, LOG_R0, MRS, 0x8014, LOG_R0]
    for kind in EVERY
        var c = on(kind, code, [0, 0, 0, 0, LOG], &unprivileged_masked)

        assert(logged(&c, [0, 0, 0, 1]), model_of(kind).name)

@test("an unprivileged MRS of BASEPRI, BASEPRI_MAX, FAULTMASK, MSPLIM or PSPLIM reads 0")
unpriv_mrs_mainline()
    // mrs r0, basepri; log; mrs r0, basepri_max; log; mrs r0, faultmask; log
    val code: []const u16 = [MRS, 0x8011, LOG_R0, MRS, 0x8012, LOG_R0, MRS, 0x8013, LOG_R0]
    for kind in MAINLINE
        var c = on(kind, code, [0, 0, 0, 0, LOG], &unprivileged_masked)

        assert(logged(&c, [0, 0, 0]), model_of(kind).name)

    // mrs r0, msplim; log; mrs r0, psplim; log, the limits set first.
    var c = on(Kind.V8mMain, [MRS, 0x800A, LOG_R0, MRS, 0x800B, LOG_R0], [0, 0, 0, 0, LOG], &limited_unprivileged)
    assert(logged(&c, [0, 0]), "the limits")

limited_unprivileged(cpu: *Cpu)
    unprivileged(cpu)
    cpu.msplim = 0x1000
    cpu.psplim = 0x1800

// ---------------------------------------------------------------------------------------------------
// Privileged code still writes.

@test("privileged thread mode still writes BASEPRI and PRIMASK, by MSR and by CPSID")
priv_thread_writes()
    // msr basepri, r1; cpsid i
    for kind in MAINLINE
        val c = on(kind, [0xF381, 0x8811, CPSID], [0, 0x10], &nothing)

        assert(c.basepri == 0x10 && c.primask == 1, model_of(kind).name)

@test("handler mode writes the masks and CONTROL though CONTROL.nPRIV is set: an SVC from unprivileged code")
handler_writes()
    // 0: svc; 2: bkpt; 4: the handler: cpsid i; msr control, r3 (r3 = 0, clearing nPRIV); bx lr.
    val code: []const u16 = [SVC, BKPT, CPSID, 0xF383, 0x8814, BX_LR]
    for kind in EVERY
        val c = run_both_thumb2(kind, code, [], 0, [[SVCALL, 4]], &unprivileged)

        assert(c.stop == Stop.Breakpoint && c.stop_at == 2, s"${model_of(kind).name}: ${c.stop} at 0x${c.stop_at}")
        assert(c.primask == 1 && c.control == 0, model_of(kind).name)

    // 4: the handler: msr basepri, r1; msr faultmask, r2; msr faultmask, r3; bx lr.
    val mainline: []const u16 = [SVC, BKPT, 0xF381, 0x8811, 0xF382, 0x8813, 0xF383, 0x8813, BX_LR]
    for kind in MAINLINE
        val c = run_both_thumb2(kind, mainline, [0, 0x10, 1, 0], 0, [[SVCALL, 4]], &unprivileged)

        assert(c.stop == Stop.Breakpoint && c.stop_at == 2 && c.basepri == 0x10, model_of(kind).name)

// ---------------------------------------------------------------------------------------------------
// The Non-secure registers from Secure state.

unprivileged_secure(cpu: *Cpu)
    secure(cpu)
    unprivileged(cpu)
    cpu.banked.msp = NS_STACK

@test("unprivileged Secure code's MSR of PRIMASK_NS, BASEPRI_NS, FAULTMASK_NS, CONTROL_NS and MSP_NS is ignored, and MRS of MSP_NS reads 0")
unpriv_ns_registers()
    // msr primask_ns, r2; msr basepri_ns, r1; msr faultmask_ns, r2; msr control_ns, r3; msr msp_ns, r1;
    // mrs r5, msp_ns
    val code: []const u16 = [0xF382, 0x8890, 0xF381, 0x8891, 0xF382, 0x8893, 0xF383, 0x8894, 0xF381, 0x8888, 0xF3EF, 0x8588]
    val c = on(Kind.V8mMain, code, [0, 0x1800, 1, 3, 0, 0x55], &unprivileged_secure)

    assert(c.banked.primask == 0 && c.banked.basepri == 0 && c.banked.faultmask == 0, "the Non-secure masks")
    assert(c.banked.control == 0 && c.banked.msp == NS_STACK && c.r[5] == 0, "CONTROL_NS and MSP_NS")
    assert(c.primask == 0 && c.basepri == 0 && c.control == 1 && c.r[13] == 0x2000, "the Secure copies untouched")

ns_unprivileged(cpu: *Cpu)
    secure(cpu)
    cpu.banked.control = 1

@test("privileged Secure code writes PRIMASK_NS though CONTROL_NS.nPRIV is set: the Secure state's privilege decides")
priv_ns_registers()
    // msr primask_ns, r2; msr basepri_ns, r1
    val c = on(Kind.V8mMain, [0xF382, 0x8890, 0xF381, 0x8891], [0, 0x10, 1], &ns_unprivileged)

    assert(c.banked.primask == 1 && c.banked.basepri == 0x10 && c.banked.control == 1)
    assert(c.primask == 0 && c.basepri == 0, "the Secure copies untouched")

// ---------------------------------------------------------------------------------------------------
// An RTOS task.

@test("an unprivileged task's MSR BASEPRI and CPSID i are ignored, so its SVC is taken, not escalated to HardFault")
unpriv_task_svc()
    // 0: msr basepri, r0 (0x10); 4: cpsid i; 6: svc #1; 8: bkpt; 10: the handler logs IPSR and returns.
    val code: []const u16 = [0xF380, 0x8811, CPSID, SVC | 1, BKPT, MRS, 0x8005, LOG_R0, BX_LR]
    for kind in MAINLINE
        var c = run_both_thumb2(kind, code, [0x10, 0, 0, 0, LOG], 0, [[SVCALL, 10], [HARD_FAULT, 8]], &unprivileged_task)

        assert(c.stop == Stop.Breakpoint && c.stop_at == 8 && logged(&c, [SVCALL]), s"${model_of(kind).name}: ${c.stop} at 0x${c.stop_at}")
        assert(c.primask == 0 && c.basepri == 0 && c.cfsr == 0 && c.hfsr == 0, model_of(kind).name)
        assert(c.ipsr == 0 && c.control == 3 && c.r[13] == PSP_AT, "back in the task, on its stack")

    // The M0+ and the M23: 0: cpsid i; 2: svc #1; 4: bkpt; 6: the handler.
    val baseline: []const u16 = [CPSID, SVC | 1, BKPT, MRS, 0x8005, LOG_R0, BX_LR]
    for kind in [Kind.V6m, Kind.M23]
        var c = run_both_thumb2(kind, baseline, [0, 0, 0, 0, LOG], 0, [[SVCALL, 6], [HARD_FAULT, 4]], &unprivileged_task)

        assert(c.stop == Stop.Breakpoint && c.stop_at == 4 && logged(&c, [SVCALL]), s"${model_of(kind).name}: ${c.stop} at 0x${c.stop_at}")
        assert(c.primask == 0 && c.ipsr == 0 && c.control == 3 && c.r[13] == PSP_AT, model_of(kind).name)
