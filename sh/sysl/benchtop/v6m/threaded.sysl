// ---------------------------------------------------------------------------------------------------
// Branches. `POP {pc}` and `BX` are the two that return from an exception, in `branch_to`'s slow path.

h_pop_pc[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    x_pop_pc(cpu, ip, n) match
        Some(target) -> become jump[TIMED](cpu, branch_to(cpu, target, ip, n), retire_timed[TIMED](cpu, ip, n))
        None -> stop_access(cpu, ip, n)

h_mov_pc[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    become jump[TIMED](cpu, insn_at(cpu, (cpu.r[ip.b] + ip.imm) & ~1), n + 1)

h_bx[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    become jump[TIMED](cpu, branch_to(cpu, cpu.r[ip.b], ip, n), retire_timed[TIMED](cpu, ip, n))

h_blx[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    val to = insn_at(cpu, cpu.r[ip.b] & ~1)

    cpu.r[14] = (addr_of(cpu, ip) + 2) | 1

    become jump[TIMED](cpu, to, retire_timed[TIMED](cpu, ip, n))

h_b[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))

h_bl[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    cpu.r[14] = (addr_of(cpu, ip) + 4) | 1

    become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))

// A conditional branch, with its condition a value parameter: each of the fourteen is its own handler
// with the test compiled in.
h_bcond[const K: u32, const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, K) then become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))
    become next(cpu, &ip[1], retire_timed[TIMED](cpu, ip, n))

// A compare and the conditional branch after it, as `fuse` pairs them: the flags are set exactly as
// the compare sets them, the target is the branch record's, and the pair retires two instructions.
h_cmp_imm_bcond[const K: u32, const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    x_cmp_imm(cpu, ip)
    if holds(cpu, K) then become jump[TIMED](cpu, target_of(&ip[1]), retire_timed[TIMED](cpu, &ip[1], n + 1))
    become next(cpu, &ip[2], retire_timed[TIMED](cpu, &ip[1], n + 1))

h_cmp_reg_bcond[const K: u32, const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    x_cmp_reg(cpu, ip)
    if holds(cpu, K) then become jump[TIMED](cpu, target_of(&ip[1]), retire_timed[TIMED](cpu, &ip[1], n + 1))
    become next(cpu, &ip[2], retire_timed[TIMED](cpu, &ip[1], n + 1))

// The fused handler for a compare `op` followed by a branch on `cond`.
fused_handler_of_timing[const TIMED: u32](op: Op, cond: u32) -> Handler
    if op == Op.CmpImm
        return cond match
            0 -> &h_cmp_imm_bcond[0, TIMED]
            1 -> &h_cmp_imm_bcond[1, TIMED]
            2 -> &h_cmp_imm_bcond[2, TIMED]
            3 -> &h_cmp_imm_bcond[3, TIMED]
            4 -> &h_cmp_imm_bcond[4, TIMED]
            5 -> &h_cmp_imm_bcond[5, TIMED]
            6 -> &h_cmp_imm_bcond[6, TIMED]
            7 -> &h_cmp_imm_bcond[7, TIMED]
            8 -> &h_cmp_imm_bcond[8, TIMED]
            9 -> &h_cmp_imm_bcond[9, TIMED]
            10 -> &h_cmp_imm_bcond[10, TIMED]
            11 -> &h_cmp_imm_bcond[11, TIMED]
            12 -> &h_cmp_imm_bcond[12, TIMED]
            _ -> &h_cmp_imm_bcond[13, TIMED]

    cond match
        0 -> &h_cmp_reg_bcond[0, TIMED]
        1 -> &h_cmp_reg_bcond[1, TIMED]
        2 -> &h_cmp_reg_bcond[2, TIMED]
        3 -> &h_cmp_reg_bcond[3, TIMED]
        4 -> &h_cmp_reg_bcond[4, TIMED]
        5 -> &h_cmp_reg_bcond[5, TIMED]
        6 -> &h_cmp_reg_bcond[6, TIMED]
        7 -> &h_cmp_reg_bcond[7, TIMED]
        8 -> &h_cmp_reg_bcond[8, TIMED]
        9 -> &h_cmp_reg_bcond[9, TIMED]
        10 -> &h_cmp_reg_bcond[10, TIMED]
        11 -> &h_cmp_reg_bcond[11, TIMED]
        12 -> &h_cmp_reg_bcond[12, TIMED]
        _ -> &h_cmp_reg_bcond[13, TIMED]

// The handler for each case.
handler_of_timing[const TIMED: u32](op: Op) -> Handler = op match
    Undecoded -> &h_decode
    Undefined -> &h_undefined
    Outside -> &h_outside
    Leave -> &h_leave[TIMED]
    Bkpt -> &h_bkpt
    Nop -> &h_nop
    Barrier -> &h_barrier[TIMED]
    Svc -> &h_svc[TIMED]
    Cps -> &h_cps[TIMED]
    Mrs -> &h_mrs[TIMED]
    Msr -> &h_msr[TIMED]
    Wfi -> &h_wfi[TIMED]
    LslImm -> &h_lsl_imm
    LsrImm -> &h_lsr_imm
    AsrImm -> &h_asr_imm
    AddsReg -> &h_adds_reg
    SubsReg -> &h_subs_reg
    AddsImm -> &h_adds_imm
    SubsImm -> &h_subs_imm
    MovsReg -> &h_movs_reg
    MovsImm -> &h_movs_imm
    CmpImm -> &h_cmp_imm
    Ands -> &h_ands
    Eors -> &h_eors
    LslsReg -> &h_lsls_reg
    LsrsReg -> &h_lsrs_reg
    AsrsReg -> &h_asrs_reg
    Adcs -> &h_adcs
    Sbcs -> &h_sbcs
    Rors -> &h_rors
    Tst -> &h_tst
    Negs -> &h_negs
    CmpReg -> &h_cmp_reg
    Cmn -> &h_cmn
    Orrs -> &h_orrs
    Muls -> &h_muls
    Bics -> &h_bics
    Mvns -> &h_mvns
    AddHi -> &h_add_hi
    MovHi -> &h_mov_hi
    AddImm -> &h_add_imm
    LoadConst -> &h_load_const
    LdrLit -> &h_ldr_lit[TIMED]
    MovPc | AddPc -> &h_mov_pc[TIMED]
    Bx -> &h_bx[TIMED]
    Blx -> &h_blx[TIMED]
    B -> &h_b[TIMED]
    Bl -> &h_bl[TIMED]
    Beq -> &h_bcond[0, TIMED]
    Bne -> &h_bcond[1, TIMED]
    Bcs -> &h_bcond[2, TIMED]
    Bcc -> &h_bcond[3, TIMED]
    Bmi -> &h_bcond[4, TIMED]
    Bpl -> &h_bcond[5, TIMED]
    Bvs -> &h_bcond[6, TIMED]
    Bvc -> &h_bcond[7, TIMED]
    Bhi -> &h_bcond[8, TIMED]
    Bls -> &h_bcond[9, TIMED]
    Bge -> &h_bcond[10, TIMED]
    Blt -> &h_bcond[11, TIMED]
    Bgt -> &h_bcond[12, TIMED]
    Ble -> &h_bcond[13, TIMED]
    StrReg -> &h_str_reg[TIMED]
    StrhReg -> &h_strh_reg[TIMED]
    StrbReg -> &h_strb_reg[TIMED]
    LdrsbReg -> &h_ldrsb_reg[TIMED]
    LdrReg -> &h_ldr_reg[TIMED]
    LdrhReg -> &h_ldrh_reg[TIMED]
    LdrbReg -> &h_ldrb_reg[TIMED]
    LdrshReg -> &h_ldrsh_reg[TIMED]
    StrImm -> &h_str_imm[TIMED]
    LdrImm -> &h_ldr_imm[TIMED]
    StrbImm -> &h_strb_imm[TIMED]
    LdrbImm -> &h_ldrb_imm[TIMED]
    StrhImm -> &h_strh_imm[TIMED]
    LdrhImm -> &h_ldrh_imm[TIMED]
    Sxth -> &h_sxth
    Sxtb -> &h_sxtb
    Uxth -> &h_uxth
    Uxtb -> &h_uxtb
    Rev -> &h_rev
    Rev16 -> &h_rev16
    Revsh -> &h_revsh
    Push -> &h_push[TIMED]
    Pop -> &h_pop[TIMED]
    PopPc -> &h_pop_pc[TIMED]
    Stm -> &h_stm[TIMED]
    Ldm -> &h_ldm[TIMED]
    It -> &h_it
    Cbz -> &h_cbz[TIMED]
    Cbnz -> &h_cbnz[TIMED]
    ItAlu -> &h_it_alu
    PushL -> &h_push_l[TIMED]
    SpImm -> &h_sp_imm
    SpReg -> &h_sp_reg
    DpImm -> &h_dp_imm_any
    LogicImm -> &h_logic_imm_any
    LogicImmC -> &h_logic_imm_c_any
    DpReg -> &h_dp_reg_any
    ShiftReg -> &h_shift_reg
    Csel -> &h_csel
