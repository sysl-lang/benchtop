module sh.sysl.benchtop.v6m

// The threaded executor: every record carries its handler's address, and every handler ends by
// `become`-ing the next record's handler. The whole guest run is one native frame; the machine, the
// record pointer and the retired count stay in registers across it.
//
// **A straight-line handler** does its instruction and jumps to the next record. **A branch** jumps
// to the target's record, an index from the target address, and is where the budget is checked:
// `run` comes back at the first taken branch at or past `limit`, with `pc` and `retired` saved. A
// stop (a breakpoint, an undefined instruction) returns at once, from the handler that stops; so does
// an access that stops the core, from the slow path's branch of its handler.

// Run from `cpu.pc` until the budget is spent or the guest stops.
run_threaded(cpu: *Cpu)
    if cpu.fpu != 0 then fp_begin(cpu)
    run_chain(cpu)
    if cpu.fpu != 0 then fp_end(cpu)

private run_chain(cpu: *Cpu)
    if !begin_run(cpu) then return

    val ip = insn_at(cpu, cpu.pc)
    val f = ip.h

    f(cpu, ip, cpu.retired)

@inline
next(cpu: *Cpu, ip: *Insn, n: u64)
    val f = ip.h

    become f(cpu, ip, n)

// A taken branch to the record `to`. It has a handler's shape, so a branch handler `become`s it. A
// branch that stopped the core (to an address off the RAM, or a fault) has set `pc` already.
@inline
jump[const TIMED: u32](cpu: *Cpu, to: *Insn, n: u64)
    if (if TIMED != 0 then executed_cycles(cpu,n) else n) >= limit_of(cpu)
        if cpu.stop == Stop.Budget then cpu.pc = addr_of(cpu, to)
        cpu.retired = n
        return

    become next(cpu, to, n)

h_ram_boundary(cpu: *Cpu, ip: *Insn, n: u64)
    become jump[1](cpu,insn_at(cpu,ip.imm),n)

h_decode(cpu: *Cpu, ip: *Insn, n: u64)
    decode(cpu, addr_of(cpu, ip), ip)

    become next(cpu, ip, n)

h_undefined(cpu: *Cpu, ip: *Insn, n: u64) = stop_here(cpu, ip, n, Stop.Undefined)

h_outside(cpu: *Cpu, ip: *Insn, n: u64) = stop_here(cpu, ip, n, Stop.Unmapped)

h_leave[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if !holds(cpu, ip.c) then become next(cpu, &ip[1], retire_timed[TIMED](cpu, ip, n))
    leave(cpu, ip, n)

h_bkpt(cpu: *Cpu, ip: *Insn, n: u64) = stop_here(cpu, ip, n, Stop.Breakpoint)

h_nop(cpu: *Cpu, ip: *Insn, n: u64)
    become next(cpu, &ip[1], n + 1)

// The system instructions: each is a point where the budget is checked, as a taken branch to the
// instruction after it. A barrier is also the host's (`barrier`).
h_barrier[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    barrier(cpu)
    become jump[TIMED](cpu, &ip[2], n + 1)

h_svc[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    become jump[TIMED](cpu, svc(cpu, ip, n), n + 1)

h_cps[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    cps(cpu, ip)
    become jump[TIMED](cpu, &ip[1], n + 1)

h_mrs[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    mrs(cpu, ip)
    become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))

h_msr[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    msr(cpu, ip)
    become jump[TIMED](cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))

h_wfi[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    wfi(cpu)
    become jump[TIMED](cpu, &ip[1], n + 1)

h_lsl_imm(cpu: *Cpu, ip: *Insn, n: u64)
    x_lsl_imm(cpu, ip)
    become next(cpu, &ip[1], n + 1)

h_lsr_imm(cpu: *Cpu, ip: *Insn, n: u64)
    x_lsr_imm(cpu, ip)
    become next(cpu, &ip[1], n + 1)

h_asr_imm(cpu: *Cpu, ip: *Insn, n: u64)
    x_asr_imm(cpu, ip)
    become next(cpu, &ip[1], n + 1)

h_adds_reg(cpu: *Cpu, ip: *Insn, n: u64)
    x_adds_reg(cpu, ip)
    become next(cpu, &ip[1], n + 1)

h_subs_reg(cpu: *Cpu, ip: *Insn, n: u64)
    x_subs_reg(cpu, ip)
    become next(cpu, &ip[1], n + 1)

h_adds_imm(cpu: *Cpu, ip: *Insn, n: u64)
