// Unit handlers have no cycle-accounting branch in their instruction paths.
handler_of(op: Op) -> Handler = handler_of_timing[0](op)
fused_handler_of(op: Op, cond: u32) -> Handler = fused_handler_of_timing[0](op,cond)
