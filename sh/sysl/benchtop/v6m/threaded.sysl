// The loads and stores: an access that stops the core leaves the handler on its slow path, the core
// stopped on the instruction, and nothing after it run.
h_ldr_lit[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ldr_lit(cpu, ip, n) then become next(cpu, &ip[1], retire_timed[TIMED](cpu, ip, n))
    stop_access(cpu, ip, n)

h_str_reg[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if x_str_reg(cpu, ip, n) then become next(cpu, &ip[1], retire_timed[TIMED](cpu, ip, n))
    stop_access(cpu, ip, n)

h_strh_reg[const TIMED: u32](cpu: *Cpu, ip: *Insn, n: u64)
    if x_strh_reg(cpu, ip, n) then become next(cpu, &ip[1], retire_timed[TIMED](cpu, ip, n))
    stop_access(cpu, ip, n)

