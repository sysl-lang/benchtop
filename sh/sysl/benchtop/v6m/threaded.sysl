module sh.sysl.benchtop.v6m

// The threaded executor: every record carries its handler's address, and every handler ends by
// `become`-ing the next record's handler. The whole guest run is one native frame; the machine, the
// record pointer and the retired count stay in registers across it.
//
// **A straight-line handler** does its instruction and jumps to the next record. **A branch** jumps
// to the target's record, an index from the target address, and is where the budget is checked:
// `run` comes back at the first taken branch at or past `limit`, with `pc` and `retired` saved. A
// stop (a breakpoint, an undefined instruction) returns at once, from the handler that stops; so does
// an access that stops the core, from the slow path's branch of its handler.
//
// **`TIMED`** on a handler says the core counts cycles (`cpu.instruction_timing`): each handler that
// can take more than one cycle has an instance that charges them and one that does not, and the
// decoder gives a record the one its core needs (`handler_for`).

// Run from `cpu.pc` until the budget is spent or the guest stops.
run_threaded(cpu: *Cpu)
    if cpu.fpu != Fpu.Absent then fp_begin(cpu)
    run_chain(cpu)
    end_run(cpu)
    if cpu.fpu != Fpu.Absent then fp_end(cpu)

private run_chain(cpu: *Cpu)
    if !begin_run(cpu) then return

    val ip = insn_at(cpu, cpu.pc)
    val f = ip.h

    f(cpu, ip, cpu.retired)

@inline
next(cpu: *Cpu, ip: *Insn, n: u64)
    val f = ip.h

    become f(cpu, ip, n)

// A taken branch to the record `to`. It has a handler's shape, so a branch handler `become`s it. A
// branch that stopped the core (to an address off the RAM, or a fault) has set `pc` already.
@inline
jump[const TIMED: bool](cpu: *Cpu, to: *Insn, n: u64)
    if (if TIMED then executed_cycles(cpu,n) else n) >= limit_of(cpu)
        if cpu.stop == Stop.Running then cpu.pc = addr_of(cpu, to)
        cpu.retired = n
        return

    become next(cpu, to, n)

h_ram_boundary(cpu: *Cpu, ip: *Insn, n: u64)
    become jump[true](cpu,insn_at(cpu,ip.imm),n)

h_decode(cpu: *Cpu, ip: *Insn, n: u64)
    val running = cpu.stop == Stop.Running

    decode(cpu, addr_of(cpu, ip), ip)
    if running && cpu.stop != Stop.Running then return fetch_refused(cpu, ip, n)

    become next(cpu, ip, n)

h_undefined(cpu: *Cpu, ip: *Insn, n: u64) = stop_here(cpu, ip, n, Stop.Undefined)

h_outside(cpu: *Cpu, ip: *Insn, n: u64) = stop_here(cpu, ip, n, Stop.Unmapped)

h_leave[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if !holds(cpu, ip.c) then become next(cpu, &ip[1], retire_timed[TIMED](cpu, ip, n))
    leave(cpu, ip, n)

h_bkpt(cpu: *Cpu, ip: *Insn, n: u64) = stop_here(cpu, ip, n, Stop.Breakpoint)

// The system instructions: each is a point where the budget is checked, as a taken branch to the
// instruction after it. A barrier is also the host's (`barrier`).
h_barrier[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    barrier(cpu)
    become jump[TIMED](cpu, &ip[2], n + 1)

h_svc[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    become jump[TIMED](cpu, svc(cpu, ip, n), n + 1)

h_cps[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    cps(cpu, ip)
    become jump[TIMED](cpu, &ip[1], n + 1)

h_mrs[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    mrs(cpu, ip)
    become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))

h_msr[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    msr(cpu, ip)
    become jump[TIMED](cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))

h_wfi[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    hint(cpu, ip.imm)
    become jump[TIMED](cpu, &ip[1], n + 1)

// ---------------------------------------------------------------------------------------------------
// The two shapes most operations share, each one generic handler with the operation `OP` a constant
// and `L` its records (1 for a 16-bit instruction, 2 for a 32-bit one): the body's `match` on `OP`
// folds to the operation's one call, so each instance is that call and the jump to the next record.
// It charges cycles only where the core counts them and some core can take more than one (`costed`).

// An operation that cannot stop the core.
h_step[const OP: Op, const L: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    OP match
        Nop | NopW -> ()
        It -> cpu.it = ip.imm
        ItAlu -> x_it_alu(cpu, ip)
        LslImm -> x_lsl_imm(cpu, ip)
        LsrImm -> x_lsr_imm(cpu, ip)
        AsrImm -> x_asr_imm(cpu, ip)
        AddsReg -> x_adds_reg(cpu, ip)
        SubsReg -> x_subs_reg(cpu, ip)
        AddsImm -> x_adds_imm(cpu, ip)
        SubsImm -> x_subs_imm(cpu, ip)
        MovsReg -> x_movs_reg(cpu, ip)
        MovsImm -> x_movs_imm(cpu, ip)
        CmpImm -> x_cmp_imm(cpu, ip)
        Ands -> x_ands(cpu, ip)
        Eors -> x_eors(cpu, ip)
        LslsReg -> x_lsls_reg(cpu, ip)
        LsrsReg -> x_lsrs_reg(cpu, ip)
        AsrsReg -> x_asrs_reg(cpu, ip)
        Adcs -> x_adcs(cpu, ip)
        Sbcs -> x_sbcs(cpu, ip)
        Rors -> x_rors(cpu, ip)
        Tst -> x_tst(cpu, ip)
        Negs -> x_negs(cpu, ip)
        CmpReg -> x_cmp_reg(cpu, ip)
        Cmn -> x_cmn(cpu, ip)
        Orrs -> x_orrs(cpu, ip)
        Muls -> x_muls(cpu, ip)
        Bics -> x_bics(cpu, ip)
        Mvns -> x_mvns(cpu, ip)
        AddHi -> x_add_hi(cpu, ip)
        MovHi -> x_mov_hi(cpu, ip)
        AddImm -> x_add_imm(cpu, ip)
        LoadConst -> x_load_const(cpu, ip)
        Sxth -> x_sxth(cpu, ip)
        Sxtb -> x_sxtb(cpu, ip)
        Uxth -> x_uxth(cpu, ip)
        Uxtb -> x_uxtb(cpu, ip)
        Rev -> x_rev(cpu, ip)
        Rev16 -> x_rev16(cpu, ip)
        Revsh -> x_revsh(cpu, ip)
        ShiftReg -> x_shift_reg(cpu, ip)
        Movt -> x_movt(cpu, ip)
        Bfi -> x_bfi(cpu, ip)
        Bfc -> x_bfc(cpu, ip)
        Ubfx -> x_ubfx(cpu, ip)
        Sbfx -> x_sbfx(cpu, ip)
        MulW -> x_mul_w(cpu, ip)
        Ssat -> x_ssat(cpu, ip)
        Usat -> x_usat(cpu, ip)
        Csel -> x_csel(cpu, ip)
        Tt -> x_tt(cpu, ip)
        Clrex -> x_clrex(cpu)
        Mla -> x_mla(cpu, ip)
        Mls -> x_mls(cpu, ip)
        Umull -> x_umull(cpu, ip)
        Smull -> x_smull(cpu, ip)
        Umlal -> x_umlal(cpu, ip)
        Smlal -> x_smlal(cpu, ip)
        _ -> trap()

    become next(cpu, &ip[L], retire_timed[TIMED && costed(OP)](cpu, ip, n))

// An operation whose access may stop the core, which then stops on the instruction with nothing after
// it run.
h_access[const OP: Op, const L: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    val done = OP match
        LdrLit -> x_ldr_lit(cpu, ip, n)
        StrReg -> x_str_reg(cpu, ip, n)
        StrhReg -> x_strh_reg(cpu, ip, n)
        StrbReg -> x_strb_reg(cpu, ip, n)
        LdrsbReg -> x_ldrsb_reg(cpu, ip, n)
        LdrReg -> x_ldr_reg(cpu, ip, n)
        LdrhReg -> x_ldrh_reg(cpu, ip, n)
        LdrbReg -> x_ldrb_reg(cpu, ip, n)
        LdrshReg -> x_ldrsh_reg(cpu, ip, n)
        StrImm -> x_str_imm(cpu, ip, n)
        LdrImm -> x_ldr_imm(cpu, ip, n)
        StrbImm -> x_strb_imm(cpu, ip, n)
        LdrbImm -> x_ldrb_imm(cpu, ip, n)
        StrhImm -> x_strh_imm(cpu, ip, n)
        LdrhImm -> x_ldrh_imm(cpu, ip, n)
        Push -> x_push(cpu, ip, n)
        Pop -> x_pop(cpu, ip, n)
        Stm -> x_stm(cpu, ip, n)
        Ldm -> x_ldm(cpu, ip, n)
        PushL -> x_push_l(cpu, ip, n)
        SpImm | SpImmW -> x_sp_imm(cpu, ip)
        SpReg -> x_sp_reg(cpu, ip)
        SpRegW -> x_sp_reg_w(cpu, ip)
        LdLit -> x_ld_lit(cpu, ip, n)
        Ldrd -> x_ldrd(cpu, ip, n)
        Strd -> x_strd(cpu, ip, n)
        LdrdLit -> x_ldrd_lit(cpu, ip, n)
        LdmW -> x_ldm_w(cpu, ip, n)
        StmW -> x_stm_w(cpu, ip, n)
        Ldrex -> x_ldrex(cpu, ip, n)
        Strex -> x_strex(cpu, ip, n)
        Lda -> x_lda(cpu, ip, n)
        Stl -> x_stl(cpu, ip, n)
        Udiv -> x_udiv(cpu, ip)
        Sdiv -> x_sdiv(cpu, ip)
        Coproc -> x_coproc(cpu, ip, n)
        _ -> trap()

    if done then become next(cpu, &ip[L], retire_timed[TIMED && costed(OP)](cpu, ip, n))
    stop_access(cpu, ip, n)

// ---------------------------------------------------------------------------------------------------
// Branches. `POP {pc}` and `BX` are the two that return from an exception, in `branch_to`'s slow path.

h_pop_pc[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    x_pop_pc(cpu, ip, n) match
        Some(target) -> become jump[TIMED](cpu, branch_to(cpu, target, ip, n), retire_timed[TIMED](cpu, ip, n))
        None -> stop_access(cpu, ip, n)

h_mov_pc[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    become jump[TIMED](cpu, insn_at(cpu, (cpu.r[ip.b] +% ip.imm) & ~1), n + 1)

h_bx[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    become jump[TIMED](cpu, branch_to(cpu, cpu.r[ip.b], ip, n), retire_timed[TIMED](cpu, ip, n))

h_blx[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    val to = insn_at(cpu, cpu.r[ip.b] & ~1)

    cpu.r[14] = (addr_of(cpu, ip) + 2) | 1

    become jump[TIMED](cpu, to, retire_timed[TIMED](cpu, ip, n))

// `BXNS` and `BLXNS`: to Non-secure state where the target's bit 0 is clear (`ns_call`), otherwise
// `BX` and `BLX`. In Non-secure state they are undefined.
h_ns_branch[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if cpu.ns then return stop_here(cpu, ip, n, Stop.Undefined)
    if ns_target(cpu, ip)
        ns_call(cpu, ip, n) match
            Some(to) -> become jump[TIMED](cpu, to, retire_timed[TIMED](cpu, ip, n))
            None -> return stop_access(cpu, ip, n)

    become jump[TIMED](cpu, ns_branch(cpu, ip, n), retire_timed[TIMED](cpu, ip, n))

// `MRS` or `MSR` of a `_NS` register; an MSR may change what can interrupt.
h_ns_register[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    ns_register(cpu, ip)
    become jump[TIMED](cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))

// `SG` entering Secure state (`sg_entry`), at the address the record keeps.
h_sg_entry[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    sg_entry(cpu, ip.imm) match
        Some(to) -> become jump[TIMED](cpu, to, retire_timed[TIMED](cpu, ip, n))
        None -> return stop_access(cpu, ip, n)

// `VLSTM` or `VLLDM`: a NOP, or a stop on it.
h_vlstm(cpu: *Cpu, ip: *Insn, n: u64)
    if !x_vlstm(cpu, ip) then return stop_access(cpu, ip, n)
    become next(cpu, &ip[2], n + 1)

// An address the core's state may not execute: SecureFault, or the record decoded afresh.
h_fetch_fault(cpu: *Cpu, ip: *Insn, n: u64)
    if fetch_fault(cpu, ip, n) then become next(cpu, ip, n)

h_b[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))

h_bl[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    cpu.r[14] = (addr_of(cpu, ip) + 4) | 1

    become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))

// A conditional branch, with its condition a value parameter: each of the fourteen is its own handler
// with the test compiled in.
h_bcond[const K: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, K) then become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))
    become next(cpu, &ip[1], retire_timed[TIMED](cpu, ip, n))

// A compare and the conditional branch after it, as `fuse` pairs them: the flags are set exactly as
// the compare sets them, the target is the branch record's, and the pair retires two instructions.
h_cmp_imm_bcond[const K: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    x_cmp_imm(cpu, ip)
    if holds(cpu, K) then become jump[TIMED](cpu, target_of(&ip[1]), retire_timed[TIMED](cpu, &ip[1], n + 1))
    become next(cpu, &ip[2], retire_timed[TIMED](cpu, &ip[1], n + 1))

h_cmp_reg_bcond[const K: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    x_cmp_reg(cpu, ip)
    if holds(cpu, K) then become jump[TIMED](cpu, target_of(&ip[1]), retire_timed[TIMED](cpu, &ip[1], n + 1))
    become next(cpu, &ip[2], retire_timed[TIMED](cpu, &ip[1], n + 1))

// ---------------------------------------------------------------------------------------------------
// Choosing a record's handler.

// The handler a decoded record runs on `cpu`: the one made for its operation where its case is a
// family (`handler_at`), timed where the core counts cycles. The one place the decoder asks.
handler_for(cpu: *Cpu, ip: *Insn) -> Handler =
    if cpu.instruction_timing then handler_at[true](ip) else handler_at[false](ip)

// The fused handler for a compare `op` followed by a branch on `cond` (`fuse`).
fused_handler_for(cpu: *Cpu, op: Op, cond: u32) -> Handler =
    if cpu.instruction_timing then fused_handler_of[true](op, cond) else fused_handler_of[false](op, cond)

private fused_handler_of[const TIMED: bool](op: Op, cond: u32) -> Handler
    for const k in 0..<13
        if cond == k then return if op == Op.CmpImm then &h_cmp_imm_bcond[k, TIMED] else &h_cmp_reg_bcond[k, TIMED]

    if op == Op.CmpImm then &h_cmp_imm_bcond[13, TIMED] else &h_cmp_reg_bcond[13, TIMED]

// Where a case's handler comes from, read off its place in `Op` (decode.sysl), whose groups each
// begin at the case named here: 0 a handler of its own (`own_handler`), 1 and 2 `h_step` over one
// record and over two, 3 and 4 `h_access` over one and over two.
const handler_family(op: Op) -> u32 =
    if u8(op) < u8(Op.Nop) then 0
    elif u8(op) < u8(Op.NopW) then 1
    elif u8(op) < u8(Op.LdrLit) then 2
    elif u8(op) < u8(Op.LdLit) then 3
    else 4

// The handler for operation `op` alone, reading any family's operation from the record: a walk of
// `Op`, so a case's handler is made where its group says.
handler_of[const TIMED: bool](op: Op) -> Handler
    for const c in Op::Variants
        if op == Op::Make(c, ()) then return handler_of_case[Op::Make(c, ()), TIMED]()

    trap()

@inline
private handler_of_case[const OP: Op, const TIMED: bool]() -> Handler
    if const handler_family(OP) == 1 then &h_step[OP, 1, TIMED]
    elif const handler_family(OP) == 2 then &h_step[OP, 2, TIMED]
    elif const handler_family(OP) == 3 then &h_access[OP, 1, TIMED]
    elif const handler_family(OP) == 4 then &h_access[OP, 2, TIMED]
    else own_handler[OP, TIMED]()

// The handler of a case that has one of its own.
@inline
private own_handler[const OP: Op, const TIMED: bool]() -> Handler
    OP match
        Undecoded -> &h_decode
        Undefined -> &h_undefined
        Outside -> &h_outside
        Leave -> &h_leave[TIMED]
        Bkpt -> &h_bkpt
        Barrier -> &h_barrier[TIMED]
        Svc -> &h_svc[TIMED]
        Cps -> &h_cps[TIMED]
        Mrs -> &h_mrs[TIMED]
        Msr -> &h_msr[TIMED]
        Wfi -> &h_wfi[TIMED]
        MovPc | AddPc -> &h_mov_pc[TIMED]
        Bx -> &h_bx[TIMED]
        Blx -> &h_blx[TIMED]
        B -> &h_b[TIMED]
        Bl -> &h_bl[TIMED]
        Beq | Bne | Bcs | Bcc | Bmi | Bpl | Bvs | Bvc | Bhi | Bls | Bge | Blt | Bgt | Ble -> bcond_handler[OP, TIMED]()
        PopPc -> &h_pop_pc[TIMED]
        Cbz -> &h_cbz[TIMED]
        Cbnz -> &h_cbnz[TIMED]
        DpImm -> &h_dp_imm_any
        LogicImm -> &h_logic_imm_any
        LogicImmC -> &h_logic_imm_c_any
        DpReg -> &h_dp_reg_any
        Dsp -> &h_dsp
        FpData -> &h_fp_any[TIMED]
        FpLdr -> &h_fp_ldr[TIMED]
        FpLdrLit -> &h_fp_ldr_lit[TIMED]
        FpMulti -> &h_fp_multi[TIMED]
        FpMove -> &h_fp_move[TIMED]
        BitOp -> &h_bit_op_any
        Extend -> &h_extend_any
        LdImm -> &h_ld_imm_any[TIMED]
        LdWb -> &h_ld_wb_any[TIMED]
        LdReg -> &h_ld_reg_any[TIMED]
        LdPc -> &h_ld_pc[TIMED]
        LdmPc -> &h_ldm_pc[TIMED]
        Tbb -> &h_tbb[TIMED]
        Tbh -> &h_tbh[TIMED]
        BcondW -> &h_bcond_w_any[TIMED]
        LeaveW -> &h_leave_w[TIMED]
        Mrs8 -> &h_mrs8[TIMED]
        Msr8 -> &h_msr8[TIMED]
        Cps8 -> &h_cps8[TIMED]
        WfiW -> &h_wfi_w[TIMED]
        NsBranch -> &h_ns_branch[TIMED]
        NsRegister -> &h_ns_register[TIMED]
        SgEntry -> &h_sg_entry[TIMED]
        FetchFault -> &h_fetch_fault
        Vlstm -> &h_vlstm
        _ -> trap()

// The `B<cond>` handler for `OP`, its condition the distance from `Beq`. The match arm naming it is
// checked for every `OP`, so the `if const` keeps the subtraction to the conditional branches.
private bcond_handler[const OP: Op, const TIMED: bool]() -> Handler
    if const is_bcond(OP)
        &h_bcond[u8(OP) - u8(Op.Beq), TIMED]
    else
        trap()

// Whether `op` is one of the 14 conditional branches, `Beq` to `Ble`.
private const is_bcond(op: Op) -> bool = u8(op) >= u8(Op.Beq) && u8(op) <= u8(Op.Ble)
