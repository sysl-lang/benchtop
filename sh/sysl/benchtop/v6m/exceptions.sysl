module sh.sysl.benchtop.v6m
@tests

// The exception model, against the ARMv6-M Architecture Reference Manual (B1.4–B1.5, B3): the system
// instructions, the frame an exception stacks and what its return restores, the two stacks,
// priorities and PRIMASK, SysTick, the NVIC and SCB registers, WFI, and where the core stops instead
// of faulting. Every guest case runs under both executors, which must agree on the exception state as
// well as on everything `execute` compares.
//
// A handler records what it sees in a log: r4 points at it (0x1000), and `stmia r4!, {r0}` appends
// r0, leaving the flags alone.

const VECTORS: u32 = 0x0C00
const LOG: u32 = 0x1000

const BKPT: u16 = 0xBE00
const BX_LR: u16 = 0x4770
const LOG_R0: u16 = 0xC401
const MOVS_R0: u16 = 0x2000
const SVC: u16 = 0xDF00
const WFI: u16 = 0xBF30
const CPSID: u16 = 0xB672
const CPSIE: u16 = 0xB662
const ISB_1: u16 = 0xF3BF
const ISB_2: u16 = 0x8F6F
const MRS: u16 = 0xF3EF
const MOV_R0_SP: u16 = 0x4668
const MOV_R0_LR: u16 = 0x4670
// str r6, [r5]; str r6, [r5, #4]; str r7, [r5]; str r6, [r7]
const STR_R6_R5: u16 = 0x602E
const STR_R6_R5_4: u16 = 0x606E
const STR_R7_R5: u16 = 0x602F
const STR_R6_R7: u16 = 0x603E

const ICSR: u32 = 0xE000ED04
const PENDSVSET: u32 = 0x10000000

type Setup = *extern(*Cpu) -> unit

nothing(cpu: *Cpu) = ()

// PendSV at the lowest priority, SVCall left at the highest.
pendsv_lowest(cpu: *Cpu) = store32(cpu, SCB_SHPR3, 0x00C00000)

// `prepare`'s machine, with the vector table at VECTORS naming each `[exception, handler address]`
// of `handlers` (the Thumb bit added), and `setup` run on it.
machine(cpu: *Cpu, code: []const u16, regs: []const u32, nzcv: u32, handlers: [][2]u32, setup: Setup)
    prepare(cpu, code, regs, nzcv, [])
    store32(cpu, SCB_VTOR, VECTORS)
    for h in handlers do store32(cpu, VECTORS + h[0] * 4, h[1] | 1)
    setup(cpu)

// `execute`, for a machine with handlers: both executors, required to agree on the exception state
// too, and the threaded machine answered.
run_both(code: []const u16, regs: []const u32, nzcv: u32, handlers: [][2]u32, setup: Setup) -> Cpu
    var a: Cpu
    var b: Cpu
    var words: [(HIGH - LOW) / 4]u32

    machine(&a, code, regs, nzcv, handlers, setup)
    finish(&a, &run_match)
    for i in 0..<words.len do words[i] = load32(&a, LOW + u32(i) * 4)

    machine(&b, code, regs, nzcv, handlers, setup)
    finish(&b, &run_threaded)

    for i in 0..<16 do assert(a.r[i] == b.r[i], s"the executors agree on r$i")
    assert(flags(&a) == flags(&b), "the executors agree on the flags")
    assert(a.stop == b.stop && a.stop_at == b.stop_at && a.retired == b.retired && a.pc == b.pc, "and on the stop")
    assert(a.ipsr == b.ipsr && a.control == b.control && a.primask == b.primask && a.sp_other == b.sp_other, "and on the modes")
    assert(a.pending == b.pending && a.active == b.active && a.slept == b.slept, "and on the exceptions")
    for i in 0..<words.len do assert(words[i] == load32(&b, LOW + u32(i) * 4), "and on memory")

    b

// Whether the log holds exactly `want`, saying what differs where it does not.
logged(c: *Cpu, want: []const u32) -> bool
    if c.r[4] != LOG + u32(want.len) * 4
        print(s"logged ${(c.r[4] - LOG) / 4} entries, not ${want.len}")
        return false

    for i in 0..<want.len
        if load32(c, LOG + u32(i) * 4) != want[i]
            print(f"log entry $i is 0x${load32(c, LOG + u32(i) * 4)}%x, not 0x${want[i]}%x")
            return false

    true

// ---------------------------------------------------------------------------------------------------
// MRS, MSR and CPS.

@test("MRS reads back what MSR and CPS wrote, with reserved bits 0, and CONTROL.SPSEL switches the stack")
exc_mrs_msr()
    // r1 = 0xBFFFFFFF, r2 = all ones, r3 = 0x1803, r4 = the log, r5 = 0x1F07
    val code: [47]u16 = [
        0xF381, 0x8800,             // msr apsr, r1
        MRS, 0x8000, LOG_R0,        // mrs r0, apsr
        MRS, 0x8003, LOG_R0,        // mrs r0, xpsr: EPSR's T bit reads as 0
        MRS, 0x8005, LOG_R0,        // mrs r0, ipsr
        MRS, 0x8006, LOG_R0,        // mrs r0, epsr
        CPSID, MRS, 0x8010, LOG_R0, // mrs r0, primask
        CPSIE, MRS, 0x8010, LOG_R0,
        0xF382, 0x8810,             // msr primask, r2
        MRS, 0x8010, LOG_R0,
        0xF383, 0x8809,             // msr psp, r3
        MRS, 0x8009, LOG_R0,        // mrs r0, psp
        MRS, 0x8008, LOG_R0,        // mrs r0, msp
        0xF382, 0x8814,             // msr control, r2
        MRS, 0x8014, LOG_R0,        // mrs r0, control
        MOV_R0_SP, LOG_R0,
        0xF385, 0x8808,             // msr msp, r5
        MRS, 0x8008, LOG_R0]
    var c = run_both(code[..], [0, 0xBFFFFFFF, 0xFFFFFFFF, 0x1803, LOG, 0x1F07], 0, [], &nothing)

    assert(logged(&c, [0xB0000000, 0xB0000000, 0, 0, 1, 0, 1, 0x1800, 0x2000, 3, 0x1800, 0x1F04]))
    assert(flags(&c) == 0b1011, "MSR APSR set N, C and V")
    assert(c.primask == 1 && c.control == 3 && c.r[13] == 0x1800 && c.sp_other == 0x1F04)
    assert(c.stop == Stop.Breakpoint && c.retired == 31, s"${c.retired}")

@test("MRS and MSR of a register ARMv6-M lacks, or of SP or PC, are undefined")
exc_mrs_msr_refused()
    // mrs r0, basepri; msr basepri, r0; mrs sp, apsr; msr apsr, pc; mrs r0, SYSm 4
    for code in [[MRS, 0x8011], [0xF380, 0x8811], [MRS, 0x8D00], [0xF38F, 0x8800], [MRS, 0x8004]]
        val c = execute(code[..], [], 0, [])

        assert(c.stop == Stop.Undefined && c.stop_at == 0 && c.retired == 0, f"${code[0]}%04x ${code[1]}%04x")

// ---------------------------------------------------------------------------------------------------
// Entry and return.

// 0: svc #5; 2: bkpt; 4: the handler logs IPSR, SP and LR, clobbers r0–r3, r12 and the flags, and
// returns.
val SVC_FRAME: [15]u16 = [
    SVC | 5, BKPT,
    MRS, 0x8005, LOG_R0,
    MOV_R0_SP, LOG_R0,
    MOV_R0_LR, LOG_R0,
    0x2100, 0x2200, 0x2300, 0x469C, 0x2000,     // movs r1-r3, #0; mov r12, r3; movs r0, #0
    BX_LR]

svc_frame(sp: u32) -> Cpu
    val regs: [15]u32 = [0x10, 0x11, 0x12, 0x13, LOG, 0, 0, 0, 0, 0, 0, 0, 0xC, sp, 0x0E0F]

    run_both(SVC_FRAME[..], regs[..], 0b1001, [[11, 4]], &nothing)

@test("SVC stacks r0-r3, r12, LR, the return address and xPSR on an 8-aligned SP, and its return restores them all")
exc_svc_frame()
    var c = svc_frame(0x2000)
    val frame: [8]u32 = [0x10, 0x11, 0x12, 0x13, 0xC, 0x0E0F, 2, 0x91000000]

    for k in 0..<8 do assert(load32(&c, 0x1FE0 + u32(k) * 4) == frame[k], s"word $k")
    assert(logged(&c, [11, 0x1FE0, 0xFFFFFFF9]), "IPSR 11, SP on the frame, LR = EXC_RETURN to thread mode on MSP")

    for k in 0..<4 do assert(c.r[k] == 0x10 + u32(k), s"r$k restored")
    assert(c.r[12] == 0xC && c.r[14] == 0x0E0F && c.r[13] == 0x2000, "r12, LR and SP restored")
    assert(flags(&c) == 0b1001, "the flags restored")
    assert(c.ipsr == 0 && c.active == 0 && c.pending == 0, "back in thread mode")
    assert(c.stop == Stop.Breakpoint && c.stop_at == 2 && c.retired == 13, s"${c.retired}")

@test("SVC on an SP that is 4 mod 8 skips a word, says so in bit 9 of the stacked xPSR, and returns to that SP")
exc_svc_frame_padded()
    var c = svc_frame(0x1FFC)

    assert(load32(&c, 0x1FD8 + 24) == 2 && load32(&c, 0x1FD8 + 28) == 0x91000200, "the frame at 0x1FD8, bit 9 set")
    assert(load32(&c, 0x1FD8) == 0x10 && load32(&c, 0x1FD8 + 20) == 0x0E0F)
    assert(logged(&c, [11, 0x1FD8, 0xFFFFFFF9]))
    assert(c.r[13] == 0x1FFC && flags(&c) == 0b1001)

@test("thread mode on PSP: the exception stacks on PSP, the handler runs on MSP, and the return goes back to PSP")
exc_process_stack()
    // r4 = the log, r5 = 0x1800, r6 = 2
    val code: [15]u16 = [
        0xF385, 0x8809,                 // 0: msr psp, r5
        0xF386, 0x8814,                 // 4: msr control, r6
        SVC,                            // 8
        0x4669,                         // 10: mov r1, sp
        BKPT,                           // 12
        MOV_R0_SP, LOG_R0,              // 14: the handler
        MOV_R0_LR, LOG_R0,
        MRS, 0x8009, LOG_R0,            // mrs r0, psp
        BX_LR]
    var c = run_both(code[..], [0, 0, 0, 0, LOG, 0x1800, 2], 0, [[11, 14]], &nothing)

    assert(logged(&c, [0x2000, 0xFFFFFFFD, 0x17E0]), "on MSP, LR = EXC_RETURN to PSP, the frame on PSP")
    assert(load32(&c, 0x17E0 + 24) == 10, "the return address on the process stack")
    assert(c.r[1] == 0x1800 && c.r[13] == 0x1800 && c.sp_other == 0x2000 && c.control == 2, "back on PSP")
    assert(c.stop == Stop.Breakpoint && c.stop_at == 12)

@test("in handler mode MSR CONTROL keeps SPSEL, and MSP and PSP name the stacks as thread mode left them")
exc_handler_control()
    // r5 = 0x1800, r6 = 2: 0: msr psp, r5; 4: msr control, r6; 8: svc; 10: bkpt;
    // 12: the handler: msr control, r7 (r7 = 0); mrs r0, control, logged; mrs r0, psp, logged; bx lr
    val code: [15]u16 = [0xF385, 0x8809, 0xF386, 0x8814, SVC, BKPT, 0xF387, 0x8814, MRS, 0x8014, LOG_R0, MRS, 0x8009, LOG_R0, BX_LR]
    var c = run_both(code[..], [0, 0, 0, 0, LOG, 0x1800, 2, 0], 0, [[11, 12]], &nothing)

    assert(logged(&c, [0, 0x17E0]), "CONTROL reads 0 in the handler, SPSEL being thread mode's")
    assert(c.control == 2 && c.r[13] == 0x1800, "and thread mode is back on PSP")

@test("a handler that alters its stacked xPSR to name an exception returns to Fault, not to thread mode")
exc_return_mismatch()
    // r6 = 0x01000005: 0: svc; 2: bkpt; 4: str r6, [sp, #28]; 6: bx lr
    val c = run_both([SVC, BKPT, 0x9607, BX_LR], [0, 0, 0, 0, LOG, 0, 0x01000005], 0, [[11, 4]], &nothing)

    assert(c.stop == Stop.Fault && c.stop_at == 6 && c.ipsr == 11, s"${c.stop} at ${c.stop_at}")
    assert(c.pc == 6, f"pc 0x${c.pc}%x")

@test("an EXC_RETURN naming no return stops at Fault; in thread mode the same value is an ordinary jump off the RAM")
exc_return_invalid()
    // r7 = 0xFFFFFFF5: 0: svc; 2: bkpt; 4: bx r7
    var c = run_both([SVC, BKPT, 0x4738], [0, 0, 0, 0, LOG, 0, 0, 0xFFFFFFF5], 0, [[11, 4]], &nothing)

    assert(c.stop == Stop.Fault && c.stop_at == 4 && c.ipsr == 11 && c.pc == 4)

    // 0: bx r7, from thread mode
    c = run_both([0x4738], [0, 0, 0, 0, LOG, 0, 0, 0xFFFFFFF9], 0, [], &nothing)
    assert(c.stop == Stop.Unmapped && c.stop_at == 0xFFFFFFF8 && c.pc == 0xFFFFFFF8)

@test("an exception return to an address off the RAM stops there; one whose frame is off the RAM stops on the return")
exc_return_off_ram()
    // r6 = 0x0030_0000: 0: svc; 2: bkpt; 4: str r6, [sp, #24], the stacked return address; 6: bx lr
    var c = run_both([SVC, BKPT, 0x9606, BX_LR], [0, 0, 0, 0, LOG, 0, 0x00300000], 0, [[11, 4]], &nothing)

    assert(c.stop == Stop.Unmapped && c.stop_at == 0x00300000 && c.pc == 0x00300000, f"0x${c.pc}%08x")
    assert(c.ipsr == 0 && c.r[13] == 0x2000 && c.retired == 3, "returned to thread mode, then stopped")

    // r7 = 0x4000_0000: 4: msr msp, r7; 8: bx lr, reading its frame from 0x4000_0000
    c = run_both([SVC, BKPT, 0xF387, 0x8808, BX_LR], [0x10, 0, 0, 0, LOG, 0, 0, 0x40000000], 0, [[11, 4]], &nothing)
    assert(c.stop == Stop.Unmapped && c.stop_at == 0x40000000 && c.pc == 8, f"0x${c.stop_at}%08x, pc 0x${c.pc}%x")
    assert(c.ipsr == 11 && c.r[13] == 0x40000000 && c.r[0] == 0x10, "still in the handler, nothing restored")

@test("an exception whose frame cannot be stacked stops on the instruction it was taken from")
exc_entry_off_ram()
    // SP = 0x4000_0020: 0: svc
    var regs: [14]u32 = [0; 14]

    regs[13] = 0x40000020

    val c = run_both([SVC], regs[..], 0, [[11, 4]], &nothing)

    assert(c.stop == Stop.Unmapped && c.stop_at == 0x40000000 && c.pc == 0, f"0x${c.stop_at}%08x, pc 0x${c.pc}%x")
    assert(c.ipsr == 0 && c.active == 0 && c.r[13] == 0x40000020, "not entered")

@test("POP {pc} of an EXC_RETURN returns from the exception as BX LR does")
exc_return_pop()
    // 0: svc; 2: bkpt; 4: push {lr}; 6: movs r0, #1; 8: pop {pc}
    val c = run_both([SVC, BKPT, 0xB500, 0x2001, 0xBD00], [0x10], 0, [[11, 4]], &nothing)

    assert(c.stop == Stop.Breakpoint && c.stop_at == 2 && c.r[0] == 0x10 && c.r[13] == 0x2000 && c.ipsr == 0)

// ---------------------------------------------------------------------------------------------------
// Priorities. r4 is the log, r5 ICSR and r6 PendSV's set bit.

@test("an exception pended at the running priority waits for the handler's return")
exc_equal_priority_waits()
    val code: [13]u16 = [
        SVC, BKPT,                                      // 0
        MOVS_R0 | 11, LOG_R0, STR_R6_R5, ISB_1, ISB_2,  // 4: SVCall, pending PendSV
        MOVS_R0 | 12, LOG_R0, BX_LR,
        MOVS_R0 | 14, LOG_R0, BX_LR]                    // 20: PendSV
    var c = run_both(code[..], [0, 0, 0, 0, LOG, ICSR, PENDSVSET], 0, [[11, 4], [14, 20]], &nothing)

    assert(logged(&c, [11, 12, 14]))
    assert(c.stop == Stop.Breakpoint && c.stop_at == 2 && c.pending == 0 && c.active == 0)

@test("a higher-priority exception preempts a running handler, on a nested frame with LR to handler mode")
exc_nested()
    val code: [17]u16 = [
        STR_R6_R5, ISB_1, ISB_2,                // 0: PendSV, taken at the ISB
        MOVS_R0 | 1, LOG_R0, BKPT,              // 6
        MOVS_R0 | 14, LOG_R0, SVC,              // 12: PendSV, at the lowest priority
        MOVS_R0 | 15, LOG_R0, BX_LR,
        MOVS_R0 | 11, LOG_R0,                   // 24: SVCall
        MOV_R0_LR, LOG_R0, BX_LR]
    var c = run_both(code[..], [0, 0, 0, 0, LOG, ICSR, PENDSVSET], 0, [[14, 12], [11, 24]], &pendsv_lowest)

    assert(logged(&c, [14, 11, 0xFFFFFFF1, 15, 1]))
    assert(c.stop == Stop.Breakpoint && c.stop_at == 10 && c.r[13] == 0x2000 && c.active == 0)

@test("PRIMASK holds a pending exception off until CPSIE, which takes it at once")
exc_primask()
    val code: [13]u16 = [
        CPSID, STR_R6_R5, ISB_1, ISB_2,     // 0
        MOVS_R0 | 1, LOG_R0, CPSIE,         // 8
        MOVS_R0 | 2, LOG_R0, BKPT,          // 14
        MOVS_R0 | 14, LOG_R0, BX_LR]        // 20: PendSV
    var c = run_both(code[..], [0, 0, 0, 0, LOG, ICSR, PENDSVSET], 0, [[14, 20]], &nothing)

    assert(logged(&c, [1, 14, 2]))

@test("an enabled IRQ made pending through the NVIC is taken; a disabled one stays pending")
exc_nvic_irq()
    // r5 = ISER, r6 = bit 3, r7 = ISPR
    val code: [11]u16 = [
        STR_R6_R5, STR_R6_R7, ISB_1, ISB_2,     // 0
        MOVS_R0 | 1, LOG_R0, BKPT,              // 8
        MRS, 0x8005, LOG_R0, BX_LR]             // 14: IRQ 3
    val regs: [8]u32 = [0, 0, 0, 0, LOG, 0xE000E100, 8, 0xE000E200]
    var c = run_both(code[..], regs[..], 0, [[19, 14]], &nothing)

    assert(logged(&c, [19, 1]), "IRQ 3 is exception 19")
    assert(c.pending == 0 && c.enabled == 8)

    // The same with a nop for the enable.
    c = run_both([0xBF00, STR_R6_R7, ISB_1, ISB_2, MOVS_R0 | 1, LOG_R0, BKPT], regs[..], 0, [[19, 14]], &nothing)
    assert(logged(&c, [1]) && c.pending == u64(1) << 19)

@test("SVC where SVCall cannot preempt escalates to HardFault, and where HardFault cannot either, stops at Fault")
exc_svc_escalates()
    // 0: cpsid i; 2: svc; 4: bkpt; 6: HardFault: mrs r0, ipsr, logged; bx lr
    var c = run_both([CPSID, SVC, BKPT, MRS, 0x8005, LOG_R0, BX_LR], [0, 0, 0, 0, LOG], 0, [[3, 6]], &nothing)

    assert(logged(&c, [3]) && c.stop == Stop.Breakpoint && c.stop_at == 4)

    // 6: HardFault: svc
    c = run_both([CPSID, SVC, BKPT, SVC], [0, 0, 0, 0, LOG], 0, [[3, 6]], &nothing)
    assert(c.stop == Stop.Fault && c.stop_at == 6 && c.ipsr == 3 && c.pc == 6, s"${c.stop} at ${c.stop_at}")

@test("an exception whose vector lacks the Thumb bit, as an unset one does, stops at Fault on the vector")
exc_unset_vector()
    val c = run_both([SVC, BKPT], [], 0, [], &nothing)

    assert(c.stop == Stop.Fault && c.stop_at == VECTORS + 11 * 4, f"${c.stop} at 0x${c.stop_at}%x")

// ---------------------------------------------------------------------------------------------------
// SysTick and WFI. r5 is SysTick's CSR.

@test("SysTick is taken RELOAD + 1 clocks after the store that starts it, counting one per instruction")
exc_systick_period()
    // r6 = 9, r7 = ENABLE | TICKINT | CLKSOURCE. 0: str r6, [r5, #4]; 2: str r7, [r5]; 4: b .;
    // 6: the handler, a breakpoint.
    val c = run_both([STR_R6_R5_4, STR_R7_R5, 0xE7FE, BKPT], [0, 0, 0, 0, LOG, 0xE000E010, 9, 7], 0, [[15, 6]], &nothing)

    // Started at clock 1, so the expiry is at 1 + 9 + 1.
    assert(c.stop == Stop.Breakpoint && c.stop_at == 6 && c.retired == 11 && c.ipsr == 15, s"${c.retired}")

@test("SysTick counts RELOAD down to 0 and reloads, COUNTFLAG set at 0 and cleared by reading it")
exc_systick_count()
    // r6 = 3, r7 = ENABLE | CLKSOURCE. Started at clock 1, it is 0 at 5 and 9.
    val code: [11]u16 = [
        STR_R6_R5_4, STR_R7_R5,
        0xBF00, 0xBF00, 0xBF00, 0xBF00, 0xBF00,
        0x6828, 0x6829,             // ldr r0, [r5]; ldr r1, [r5], at clocks 7 and 8
        0x68AA, 0x68AB]             // ldr r2, [r5, #8]; ldr r3, [r5, #8], at 9 and 10
    val c = run_both(code[..], [0, 0, 0, 0, LOG, 0xE000E010, 3, 5], 0, [], &nothing)

    assert(c.r[0] == 0x10005 && c.r[1] == 5, f"CSR 0x${c.r[0]}%x then 0x${c.r[1]}%x")
    assert(c.r[2] == 0 && c.r[3] == 3, s"CVR ${c.r[2]} then ${c.r[3]}")
    assert(c.pending == 0, "no TICKINT, no exception")

@test("SysTick's registers: RELOAD is 24 bits, a CVR write clears the count and COUNTFLAG, and a disabled timer holds")
exc_systick_registers()
    var c: Cpu

    reset(&c, test_memory, [], 0)
    store32(&c, SYST_RVR, 0xFFFFFFFF)
    assert(load32(&c, SYST_RVR) == 0xFFFFFF)
    assert(load32(&c, SYST_CSR) == 4 && load32(&c, SYST_CALIB) == 0xC0000000)

    store32(&c, SYST_RVR, 4)
    store32(&c, SYST_CSR, 1)
    c.retired = 3
    assert(load32(&c, SYST_CVR) == 2, "4 at 1, 3 at 2, 2 at 3")
    c.retired = 6
    assert(load32(&c, SYST_CSR) == 0x10005, "0 at 5")
    store32(&c, SYST_CVR, 1234)
    assert(load32(&c, SYST_CVR) == 0 && load32(&c, SYST_CSR) == 5, "cleared, with COUNTFLAG")
    c.retired = 7
    assert(load32(&c, SYST_CVR) == 4, "reloaded")
    store32(&c, SYST_CSR, 0)
    c.retired = 100
    assert(load32(&c, SYST_CVR) == 4 && load32(&c, SYST_CSR) == 4, "held while disabled")

    // A reload of 0 stops it at 0 for good, and a reload written then starts it again.
    store32(&c, SYST_RVR, 0)
    store32(&c, SYST_CSR, 1)
    c.retired = 104
    assert(load32(&c, SYST_CVR) == 0 && load32(&c, SYST_CSR) == 0x10005, "0 at 104")
    c.retired = 200
    assert(load32(&c, SYST_CVR) == 0 && load32(&c, SYST_CSR) == 5, "and at 0 since, with no new COUNTFLAG")
    store32(&c, SYST_RVR, 2)
    c.retired = 201
    assert(load32(&c, SYST_CVR) == 2, "reloaded the clock after")

@test("WFI sleeps until SysTick's expiry, skipping the clock there, and the handler runs before the code after it")
exc_wfi_systick()
    // r6 = 99, r7 = ENABLE | TICKINT | CLKSOURCE
    val code: [9]u16 = [
        STR_R6_R5_4, STR_R7_R5, WFI,    // 0
        MOVS_R0 | 1, LOG_R0, BKPT,      // 6
        MOVS_R0 | 15, LOG_R0, BX_LR]    // 12: SysTick
    var c = run_both(code[..], [0, 0, 0, 0, LOG, 0xE000E010, 99, 7], 0, [[15, 12]], &nothing)

    assert(logged(&c, [15, 1]))
    // Asleep after 3 instructions, at clock 3; the expiry is at 1 + 99 + 1.
    assert(c.slept == 98 && c.retired == 8 && !c.sleeping, s"${c.slept} ${c.retired}")

@test("WFI with nothing that can wake it stops at Asleep, after the WFI")
exc_wfi_asleep()
    var c = run_both([0x2001, WFI, 0x2002], [], 0, [], &nothing)

    assert(c.stop == Stop.Asleep && c.stop_at == 4 && c.r[0] == 1 && c.retired == 2 && c.sleeping)

    // SysTick counting without TICKINT raises nothing to wake it.
    c = run_both([STR_R6_R5_4, STR_R7_R5, WFI], [0, 0, 0, 0, LOG, 0xE000E010, 9, 5], 0, [[15, 6]], &nothing)
    assert(c.stop == Stop.Asleep && c.stop_at == 6)

@test("with PRIMASK set, a pending exception wakes WFI without being taken, until CPSIE")
exc_wfi_primask()
    val code: [12]u16 = [
        CPSID, STR_R6_R5, WFI,          // 0
        MOVS_R0 | 1, LOG_R0, CPSIE,     // 6
        MOVS_R0 | 2, LOG_R0, BKPT,      // 12
        MOVS_R0 | 14, LOG_R0, BX_LR]    // 18: PendSV
    var c = run_both(code[..], [0, 0, 0, 0, LOG, ICSR, PENDSVSET], 0, [[14, 18]], &nothing)

    assert(logged(&c, [1, 14, 2]) && c.slept == 0)

// ---------------------------------------------------------------------------------------------------
// The NVIC and SCB registers.

@test("the NVIC's enable and pending registers set, clear and read back, and priorities keep two bits")
exc_nvic_registers()
    var c: Cpu

    reset(&c, test_memory, [], 0)
    store32(&c, NVIC_ISER, 5)
    assert(load32(&c, NVIC_ISER) == 5 && load32(&c, NVIC_ICER) == 5)
    store32(&c, NVIC_ICER, 1)
    assert(load32(&c, NVIC_ISER) == 4)

    store32(&c, NVIC_ISPR, 3)
    assert(load32(&c, NVIC_ISPR) == 3 && load32(&c, NVIC_ICPR) == 3)
    store32(&c, NVIC_ICPR, 1)
    assert(load32(&c, NVIC_ISPR) == 2)

    store32(&c, NVIC_IPR, 0xFFFFFFFF)
    store32(&c, NVIC_IPR + 28, 0x12345678)
    assert(load32(&c, NVIC_IPR) == 0xC0C0C0C0 && load32(&c, NVIC_IPR + 28) == 0x00004040)
    assert(c.prio[IRQ0] == 0xC0 && c.prio[IRQ0 + 29] == 0x40 && c.prio[IRQ0 + 30] == 0)
    assert(c.stop == Stop.Budget)

@test("the SCB: ICSR's set, clear and pending fields, VTOR, SHPR2 and SHPR3, CPUID and AIRCR")
exc_scb_registers()
    var c: Cpu

    reset(&c, test_memory, [], 0)
    assert(load32(&c, SCB_CPUID) == 0x410CC601 && load32(&c, SCB_AIRCR) == 0xFA050000)
    assert(load32(&c, ICSR) == 0)

    // IRQ 1 pending but not enabled: ISRPENDING, though VECTPENDING names PendSV.
    store32(&c, NVIC_ISPR, 2)
    store32(&c, ICSR, PENDSVSET | (1 << 26))
    assert(load32(&c, ICSR) == PENDSVSET | (1 << 26) | (1 << 22) | (14 << 12), f"0x${load32(&c, ICSR)}%08x")
    store32(&c, ICSR, (1 << 27) | (1 << 25))
    assert(load32(&c, ICSR) == (1 << 22), "PENDSVCLR and PENDSTCLR")
    store32(&c, ICSR, 1 << 31)
    assert(load32(&c, ICSR) == (1 << 31) | (1 << 22) | (2 << 12), "NMIPENDSET")

    store32(&c, SCB_VTOR, 0x12345)
    assert(load32(&c, SCB_VTOR) == 0x12300)
    store32(&c, SCB_SHPR2, 0xFFFFFFFF)
    store32(&c, SCB_SHPR3, 0xFFFFFFFF)
    assert(load32(&c, SCB_SHPR2) == 0xC0000000 && load32(&c, SCB_SHPR3) == 0xC0C00000)

    // SYSRESETREQ without the key does nothing.
    store32(&c, SCB_AIRCR, 4)
    assert(c.stop == Stop.Budget)
    store32(&c, SCB_AIRCR, 0x05FA0004)
    assert(c.stop == Stop.Reset && c.stop_at == SCB_AIRCR)

@test("an access to the system control space that is not a word, or not a register, stops at Unmapped")
exc_scs_refused()
    for a in [NVIC_ISER + 1, 0xE000E300, 0xE000ED30]
        var c: Cpu

        reset(&c, test_memory, [], 0)
        assert(load32(&c, a) == 0 && c.stop == Stop.Unmapped && c.stop_at == a, f"0x${a}%08x")

    var c: Cpu

    reset(&c, test_memory, [], 0)
    store8(&c, NVIC_ISER, 1)
    assert(c.stop == Stop.Unmapped && c.stop_at == NVIC_ISER && c.enabled == 0)
