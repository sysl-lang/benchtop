module sh.sysl.benchtop.v6m
@tests

@test("M4 uses both shared Thumb-2 executors for divide, bitfields, IT and exclusives")
m4_integer()
    var c = execute_thumb2(Kind.V7em, [0xFB91, 0xF0F2], [0, 0xFFFFFFF9, 2], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 0xFFFFFFFD, "SDIV")
    c = execute_thumb2(Kind.V7em, [0xF3C1, 0x1007], [0, 0x12345678], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 0x67, "UBFX")
    // cmp r0, r0; ite eq; moveq r1, #7; movne r1, #9
    c = execute_thumb2(Kind.V7em, [0x4280, 0xBF0C, 0x2107, 0x2109], [], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[1] == 7 && c.it == 0, "IT")
    c = execute_thumb2(Kind.V7em, [0xE851, 0x0F00, 0x3001, 0xE841, 0x0200], [0, 0x1000, 9], 0, [[0x1000, 41]])
    assert(c.stop == Stop.Breakpoint && c.r[2] == 0 && load32(&c, 0x1000) == 42, "LDREX/STREX")

@test("M4 rejects M33 ordered accesses and stack-limit registers under both executors")
m4_v8_only()
    val codes: [10][2]u16 = [
        [0xE8D1, 0x0FAF], [0xE8C1, 0x0F8F], // LDA, STLB
        [0xE8D1, 0x0FEF], [0xE8C1, 0x0FE2], // LDAEX, STLEX
        [0xF3EF, 0x800A], [0xF380, 0x880A], // MRS/MSR MSPLIM
        [0xF3EF, 0x800B], [0xF380, 0x880B], // MRS/MSR PSPLIM
        [0xE8D1, 0x0FCF], [0xE8C1, 0x0FD2], // LDAEXB, STLEXH
    ]

    for code in codes
        var c = execute_thumb2(Kind.V7em, code, [0, 0x1000, 0], 0, [])
        assert(c.stop == Stop.Undefined && c.retired == 0, "v8-only encoding")
end m4_v8_only

@test("M4 identifies itself and keeps its own CCR behavior without changing M33")
m4_system()
    var c: Cpu
    c.kind = Kind.V7em
    reset(&c, test_memory, [], 0)
    assert(load32(&c, SCB_CPUID) == 0x410FC241 && load32(&c, SCB_CCR) == 0x200, "M4 reset")
    store32(&c, SCB_CCR, 0)
    assert(load32(&c, SCB_CCR) == 0, "M4 CCR bits are writable")
    store32(&c, NVIC_IPR, 0xFF)
    assert(load32(&c, NVIC_IPR) == 0xF0, "four priority bits")
    assert(c.msplim == 0 && c.psplim == 0, "M4 limits stay zero; their instructions are undefined")
    c.kind = Kind.V8mMain
    reset(&c, test_memory, [], 0)
    store32(&c, SCB_CCR, 0)
    assert(load32(&c, SCB_CPUID) == M33_CPUID && load32(&c, SCB_CCR) == CCR_RESET, "M33 unchanged")

@test("M4 shares BASEPRI interrupt delivery and clears the exclusive monitor on SVC")
m4_exceptions()
    val code: []const u16 = [0x2001, LOG_R0, 0xF382, 0x8811, 0x2002, LOG_R0, BKPT, LOG_9, LOG_R0, BX_LR]
    var c = run_both_thumb2(Kind.V7em, code, [0, 0, 0x80, 0, LOG], 0, [[IRQ0, 14]], &held_by_basepri)
    assert(logged(&c, [1, 9, 2]) && c.basepri == 0x80, "BASEPRI")
    c = run_both_thumb2(Kind.V7em, [0xE851, 0x0F00, SVC, 0xE841, 0x0200, BKPT, BX_LR], [0, 0x1000, 9], 0, [[SVCALL, 12]], &nothing)
    assert(c.stop == Stop.Breakpoint && c.r[2] == 1 && c.ipsr == 0, "SVC and return clear the monitor")

// A word-aligned but not doubleword-aligned stack, with each possible STKALIGN setting.
m4_word_stack(cpu: *Cpu)
    cpu.r[13] = 0x2004
    store32(cpu, SCB_CCR, 0)

m4_aligned_stack(cpu: *Cpu)
    cpu.r[13] = 0x2004

@test("M4 CCR.STKALIGN controls exception frame alignment and return restores SP")
m4_stack_alignment()
    val code: []const u16 = [SVC, BKPT, MOV_R0_SP, LOG_R0, BX_LR]
    var c = run_both_thumb2(Kind.V7em, code, [0, 0, 0, 0, LOG], 0, [[SVCALL, 4]], &m4_word_stack)
    assert(c.stop == Stop.Breakpoint && c.r[13] == 0x2004, "word-aligned return")
    assert(logged(&c, [0x1FE4]) && load32(&c, 0x1FE4 + 28) & 0x200 == 0, "no alignment padding")
    c = run_both_thumb2(Kind.V7em, code, [0, 0, 0, 0, LOG], 0, [[SVCALL, 4]], &m4_aligned_stack)
    assert(c.stop == Stop.Breakpoint && c.r[13] == 0x2004, "doubleword-aligned return")
    assert(logged(&c, [0x1FE0]) && load32(&c, 0x1FE0 + 28) & 0x200 != 0, "padding recorded in stacked xPSR")
