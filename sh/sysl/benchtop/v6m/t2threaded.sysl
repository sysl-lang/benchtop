module sh.sysl.benchtop.v6m

// The threaded executor's handlers for ARMv8-M Mainline (threaded.sysl has the chain). A 32-bit
// instruction's handler goes on to the record two after its own. A family of operations has a handler
// per operation, made from one generic body with the operation a constant, and the decoder gives each
// record its operation's (`handler_at`); each family also has a handler that reads the operation
// from the record, which `handler_of` answers for the case alone.

// The handler a decoded record runs, the one made for its operation where its case is a family.
handler_at[const TIMED: bool](ip: *Insn) -> Handler = ip.op match
    DpImm -> dp_imm_handler(u32(ip.c))
    LogicImm -> logic_handler[false](u32(ip.c) & 7)
    LogicImmC -> logic_handler[true](u32(ip.c) & 7)
    DpReg -> dp_reg_handler(ip.imm >> 12, ip.imm & 0x1FF)
    BitOp -> bit_handler(u32(ip.c))
    Extend -> extend_handler(u32(ip.c))
    LdImm -> ld_imm_handler[TIMED](u32(ip.c))
    LdReg -> ld_reg_handler[TIMED](ip.imm >> 8)
    LdWb -> ld_wb_handler[TIMED](u32(ip.c) & 7)
    BcondW -> bcond_w_handler[TIMED](u32(ip.c))
    FpData -> fp_handler[TIMED](ip)
    _ -> handler_of[TIMED](ip.op)

// ---------------------------------------------------------------------------------------------------
// IT blocks.

// An instruction of an IT block, on condition `K`, `L` records long. ITSTATE steps on whether it runs
// or not. Run, it keeps the instruction's own ITSTATE for a stop on it (`Cpu.it_own`; a skipped one
// always retires) and goes on to its instruction's handler, which the decoder chose with the block and
// keeps beside the record (`Cpu.predicated`), timed or not as the core was; skipped, it retires as a
// NOP. Reached with ITSTATE 0 — by a branch into the block, which is UNPREDICTABLE — it runs
// unconditionally, as the `match` executor does (thumb2.sysl).
h_pred[const K: u32, const L: u32](cpu: *Cpu, ip: *Insn, n: u64)
    val st = cpu.it

    cpu.it = it_advance(st)

    if st == 0 || holds(cpu, K)
        cpu.it_own = st
        cpu.it_at = n

        become cpu.predicated[ip - cpu.dec](cpu, ip, n)

    become next(cpu, &ip[L], n + 1)

// The handler of an instruction in an IT block on condition `cond` (0..14), `len` records long.
pred_handler(cond: u32, len: u32) -> Handler
    for const k in 0..<14
        if cond == k then return if len == 1 then &h_pred[k, 1] else &h_pred[k, 2]

    if len == 1 then &h_pred[14, 1] else &h_pred[14, 2]

// ---------------------------------------------------------------------------------------------------
// 16-bit.

h_cbz[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if cpu.r[ip.a] == 0 then become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))
    become next(cpu, &ip[1], retire_timed[TIMED](cpu, ip, n))

h_cbnz[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if cpu.r[ip.a] != 0 then become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))
    become next(cpu, &ip[1], retire_timed[TIMED](cpu, ip, n))

h_cps8[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    cps8(cpu, ip)
    become jump[TIMED](cpu, &ip[1], n + 1)

// ---------------------------------------------------------------------------------------------------
// Data processing.

h_dp_imm[const OP: u32](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, OP, ip.a, reg(cpu, ip.b), ip.imm)
    become next(cpu, &ip[2], n + 1)

// A 32-bit `CMP` with an immediate and the 16-bit `B<cond>` after it, as `fuse_wide` pairs them: the
// flags as the compare sets them, the target the branch record's, two instructions retired.
h_cmp_w_bcond[const K: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, DP_CMP, ip.a, reg(cpu, ip.b), ip.imm)
    if holds(cpu, K) then become jump[TIMED](cpu, target_of(&ip[2]), retire_timed[TIMED](cpu, &ip[2], n + 1))
    become next(cpu, &ip[3], retire_timed[TIMED](cpu, &ip[2], n + 1))

// The fused handler for a wide `CMP` followed by a branch on `cond` (`fuse_wide`).
cmp_w_bcond_handler(cpu: *Cpu, cond: u32) -> Handler =
    if cpu.instruction_timing then cmp_w_bcond_handler_of[true](cond) else cmp_w_bcond_handler_of[false](cond)

private cmp_w_bcond_handler_of[const TIMED: bool](cond: u32) -> Handler
    for const k in 0..<13
        if cond == k then return &h_cmp_w_bcond[k, TIMED]

    &h_cmp_w_bcond[13, TIMED]

h_dp_imm_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_dp_imm(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_logic_imm[const OP: u32](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, OP, ip.a, reg(cpu, ip.b), ip.imm)
    become next(cpu, &ip[2], n + 1)

h_logic_imm_c[const OP: u32](cpu: *Cpu, ip: *Insn, n: u64)
    cpu.c = (u32(ip.c) >> 3) & 1
    alu(cpu, OP, ip.a, reg(cpu, ip.b), ip.imm)
    become next(cpu, &ip[2], n + 1)

h_logic_imm_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_logic_imm(cpu, ip, false)
    become next(cpu, &ip[2], n + 1)

h_logic_imm_c_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_logic_imm(cpu, ip, true)
    become next(cpu, &ip[2], n + 1)

// With Rm shifted; and `h_dp_reg0`, for the most common shift, none (LSL #0).
// With Rm shifted by an immediate of kind `K`: the shift's amount is the record's, its kind compiled
// in, so the handler holds the one shift and no test of which.
h_dp_reg[const OP: u32, const K: u32](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, OP, ip.a, reg(cpu, ip.b), shift_c(cpu, reg(cpu, ip.c), K, ip.imm & 63, sets_carry(OP)))
    become next(cpu, &ip[2], n + 1)

h_dp_reg0[const OP: u32](cpu: *Cpu, ip: *Insn, n: u64)
    alu(cpu, OP, ip.a, reg(cpu, ip.b), reg(cpu, ip.c))
    become next(cpu, &ip[2], n + 1)

h_dp_reg_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_dp_reg(cpu, ip)
    become next(cpu, &ip[2], n + 1)

h_bit_op[const W: u32](cpu: *Cpu, ip: *Insn, n: u64)
    x_bit_op(cpu, ip, W)
    become next(cpu, &ip[2], n + 1)

h_bit_op_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_bit_op(cpu, ip, u32(ip.c))
    become next(cpu, &ip[2], n + 1)

h_extend[const W: u32](cpu: *Cpu, ip: *Insn, n: u64)
    x_extend(cpu, ip, W)
    become next(cpu, &ip[2], n + 1)

h_extend_any(cpu: *Cpu, ip: *Insn, n: u64)
    x_extend(cpu, ip, u32(ip.c))
    become next(cpu, &ip[2], n + 1)

// A record is decoded by what the core's kind can have (`dsp_capable`), so cores of one kind share
// records whatever their chips chose; whether this core has the extension is `cpu.dsp`, its one flag,
// and both executors check it here.
h_dsp(cpu: *Cpu, ip: *Insn, n: u64)
    if !cpu.dsp then return stop_here(cpu, ip, n, Stop.Undefined)
    x_dsp(cpu, ip)
    become next(cpu, &ip[2], n + 1)

// ---------------------------------------------------------------------------------------------------
// Loads and stores.

h_ld_imm[const X: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_imm(cpu, ip, X, n) then become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))
    stop_access(cpu, ip, n)

h_ld_imm_any[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_imm(cpu, ip, u32(ip.c), n) then become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))
    stop_access(cpu, ip, n)

h_ld_wb[const X: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_wb(cpu, ip, X, n) then become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))
    stop_access(cpu, ip, n)

h_ld_wb_any[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_wb(cpu, ip, u32(ip.c) & 7, n) then become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))
    stop_access(cpu, ip, n)

h_ld_reg[const X: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_reg(cpu, ip, X, n) then become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))
    stop_access(cpu, ip, n)

h_ld_reg_any[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if x_ld_reg(cpu, ip, ip.imm >> 8, n) then become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))
    stop_access(cpu, ip, n)

// ---------------------------------------------------------------------------------------------------
// Branches. `LDR PC` and an `LDM` with the PC return from an exception as `POP {pc}` does.

h_ld_pc[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    x_ld_pc(cpu, ip, n) match
        Some(target) -> become jump[TIMED](cpu, branch_to(cpu, target, ip, n), retire_timed[TIMED](cpu, ip, n))
        None -> stop_access(cpu, ip, n)

h_ldm_pc[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    x_ldm_pc(cpu, ip, n) match
        Some(target) -> become jump[TIMED](cpu, branch_to(cpu, target, ip, n), retire_timed[TIMED](cpu, ip, n))
        None -> stop_access(cpu, ip, n)

// `TBB` and `TBH`: forward by twice the table's entry from the instruction's address plus 4.
h_tbb[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    x_table(cpu, ip, 1, n) match
        Some(to) -> become jump[TIMED](cpu, insn_at(cpu, to), retire_timed[TIMED](cpu, ip, n))
        None -> stop_access(cpu, ip, n)

h_tbh[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    x_table(cpu, ip, 2, n) match
        Some(to) -> become jump[TIMED](cpu, insn_at(cpu, to), retire_timed[TIMED](cpu, ip, n))
        None -> stop_access(cpu, ip, n)

h_bcond_w[const K: u32, const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, K) then become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))
    become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))

h_bcond_w_any[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, u32(ip.c)) then become jump[TIMED](cpu, target_of(ip), retire_timed[TIMED](cpu, ip, n))
    become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))

h_leave_w[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    if !holds(cpu, u32(ip.c)) then become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))
    leave(cpu, ip, n)

// ---------------------------------------------------------------------------------------------------
// System. As on ARMv6-M, an instruction that may change what can interrupt checks the budget as a
// taken branch does.

h_mrs8[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    mrs8(cpu, ip)
    become next(cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))

h_msr8[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    msr8(cpu, ip)
    become jump[TIMED](cpu, &ip[2], retire_timed[TIMED](cpu, ip, n))

h_wfi_w[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64)
    wfi(cpu)
    become jump[TIMED](cpu, &ip[2], n + 1)

// ---------------------------------------------------------------------------------------------------
// The handler made for each operation of a family.

// `DpImm`'s operation is the record's `IMM_*` code (`imm_op`), 0 to `IMM_CMN`.
private dp_imm_handler(code: u32) -> Handler
    for const k in 0..<IMM_CMN
        if code == k then return &h_dp_imm[imm_op(u32(k))]

    &h_dp_imm[imm_op(IMM_CMN)]

// `LogicImm`'s is the record's `LOGIC_*` code (`logic_op`), 0 to `LOGIC_TEQ`; `CARRY` for the
// encodings whose immediate sets C.
private logic_handler[const CARRY: bool](code: u32) -> Handler
    for const k in 0..<LOGIC_TEQ
        if code == k then return if CARRY then &h_logic_imm_c[logic_op(u32(k))] else &h_logic_imm[logic_op(u32(k))]

    if CARRY then &h_logic_imm_c[logic_op(LOGIC_TEQ)] else &h_logic_imm[logic_op(LOGIC_TEQ)]

// `DpReg`'s operation `op` (a `DP_*`) with Rm shifted as `shift` says: none, or a kind (`SH_*`) and an
// amount.
private dp_reg_handler(op: u32, shift: u32) -> Handler
    val kind = if shift >> 6 < SH_RRX then shift >> 6 else SH_RRX

    for const k in 0..DP_CMN
        if op == k
            if shift == 0 then return &h_dp_reg0[k]
            for const s in 0..SH_RRX
                if kind == s then return &h_dp_reg[k, s]

    &h_dp_reg_any

private bit_handler(w: u32) -> Handler
    for const k in 0..<5
        if w == k then return &h_bit_op[k]

    &h_bit_op_any

private extend_handler(w: u32) -> Handler
    for const k in 0..<4
        if w == k then return &h_extend[k]

    &h_extend_any

// The load and store families' operation is an `XFER_*`.
private ld_imm_handler[const TIMED: bool](x: u32) -> Handler
    for const k in 0..XFER_STRH
        if x == k then return &h_ld_imm[k, TIMED]

    &h_ld_imm_any[TIMED]

private ld_wb_handler[const TIMED: bool](x: u32) -> Handler
    for const k in 0..XFER_STRH
        if x == k then return &h_ld_wb[k, TIMED]

    &h_ld_wb_any[TIMED]

private ld_reg_handler[const TIMED: bool](x: u32) -> Handler
    for const k in 0..XFER_STRH
        if x == k then return &h_ld_reg[k, TIMED]

    &h_ld_reg_any[TIMED]

private bcond_w_handler[const TIMED: bool](k: u32) -> Handler
    for const c in 0..<14
        if k == c then return &h_bcond_w[c, TIMED]

    &h_bcond_w_any[TIMED]
