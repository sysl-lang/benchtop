module sh.sysl.benchtop.v6m

// ARMv8-M Mainline's system registers and instructions, over the exception model except.sysl has for
// both kinds (ARMv8-M ARM, DDI0553, "System Address Map" and "The System Control Block"): BASEPRI,
// BASEPRI_MAX and FAULTMASK, the stack limits, AIRCR.PRIGROUP, four bits of priority, the system
// handler priorities and the byte access to them, and the configurable-fault registers.
//
// **Faults are taken as silicon takes them** (t2secure.sysl), recording themselves in CFSR and HFSR:
// the UsageFaults, the stack-limit one among them, the INVPC of an EXC_RETURN naming a Non-secure
// exception on a Secure-only core, MemManage where the MPU refuses an access (the M33's PMSAv8,
// mpu.sysl, or an ARMv7-M core's PMSAv7, pmsav7.sysl), and
// BusFault on a bus error (cpu.sysl's `bus_error`). A debugger's core stops on them instead
// (`catch_faults`). SHCSR's enables and pending bits, CCR and SHPR1 are kept as written. MMFAR holds
// the address of the last data access the MPU refused, BFAR that of the last precise data BusFault,
// and each what software writes to it.

// Cortex-M4 r0p1.
const M4_CPUID: u32 = 0x410FC241

// Cortex-M7 r0p0. Its FPU and MPU are the board's to give it (`fpu`, `mpu-regions`).
const M7_CPUID: u32 = 0x410FC270

// BP and STKALIGN are read-as-one on M7 (Arm DUI0646C, CCR bit assignments).
const M7_CCR_FIXED: u32 = 0x40200

// CCR.DC (bit 16) and CCR.IC (bit 17): stored and read back, with no effect on any access.
const M7_CCR_CACHE_ENABLES: u32 = 0x30000

// The M7's L1 cache identification (Cortex-M7 TRM, "Cache identification registers"; ARMv7-M ARM
// B4.2) for the STM32H747's 16 KB I-cache and 16 KB D-cache, each 4-way with 32-byte lines (128 sets).
// CLIDR: Ctype1 = 3 (separate I and D), LoC = 1, LoUU = 1. CTR: CWG = 3, DminLine = IminLine = 3
// (2^3 words), L1Ip = PIPT. CCSIDR, selected by CSSELR.InD: NumSets - 1 = 127, Associativity - 1 = 3,
// LineSize = 1 (8 words); the D-cache supports write-through, write-back, read- and write-allocate,
// the I-cache read-allocate only.
const M7_CLIDR: u32 = 0x09000003
const M7_CTR: u32 = 0x8303C003
const M7_CCSIDR_DCACHE: u32 = 0xF00FE019
const M7_CCSIDR_ICACHE: u32 = 0x200FE019

// The Cortex-M33 r1p0, as the RP2350's report themselves.
const M33_CPUID: u32 = 0x411FD210

// CCR at reset: STKALIGN and the reserved bit 0, both read-as-one.
const CCR_RESET: u32 = 0x201

// Identity and CCR selection belong to the model, rather than instruction handlers.
cpuid_of(kind: Kind) -> u32 = model_of(kind).cpuid

ccr_reset(kind: Kind) -> u32
    if is_v6m(kind) then return 0
    if is_baseline(kind) then return 0x208
    if is_v7m(kind) then return if kind == Kind.V7emM7 then M7_CCR_FIXED else 0x200
    CCR_RESET

ccr_written(kind: Kind, x: u32) -> u32
    if is_v6m(kind) then return 0
    if is_baseline(kind) then return 0x208
    if kind == Kind.V7emM7 then return (x & (0x11B | M7_CCR_CACHE_ENABLES)) | M7_CCR_FIXED
    if is_v7m(kind) then return x & 0x31B
    (x & 0x0007071A) | CCR_RESET

// The registers ARMv8-M adds to the system control space.
const ICTR: u32 = 0xE000E004
const ACTLR: u32 = 0xE000E008
const SCB_CCR: u32 = 0xE000ED14
const SCB_SHPR1: u32 = 0xE000ED18
const SCB_SHCSR: u32 = 0xE000ED24
const SCB_CFSR: u32 = 0xE000ED28
const SCB_HFSR: u32 = 0xE000ED2C
const SCB_MMFAR: u32 = 0xE000ED34
const SCB_BFAR: u32 = 0xE000ED38
const SCB_CLIDR: u32 = 0xE000ED78
const SCB_CTR: u32 = 0xE000ED7C
const SCB_CCSIDR: u32 = 0xE000ED80
const SCB_CSSELR: u32 = 0xE000ED84
const SCB_CPACR: u32 = 0xE000ED88
const NVIC_STIR: u32 = 0xE000EF00

// The M7's cache maintenance operations: ICIALLU, ICIMVAU, DCIMVAC, DCISW, DCCMVAU, DCCMVAC, DCCSW,
// DCCIMVAC, DCCISW and BPIALL. They are write-only: a write is accepted, a read gives 0.
// benchtop models no cache, so memory is always coherent and a maintenance operation has nothing to
// clean or invalidate; accepting it is the whole of its effect.
cache_maintenance(a: u32) -> bool =
    a match
        0xE000EF50 | 0xE000EF58 | 0xE000EF5C | 0xE000EF60 | 0xE000EF64 -> true
        0xE000EF68 | 0xE000EF6C | 0xE000EF70 | 0xE000EF74 | 0xE000EF78 -> true
        _ -> false

// CCSIDR for the cache CSSELR selects.
m7_ccsidr(cpu: *Cpu) -> u32 = if cpu.csselr & 1 != 0 then M7_CCSIDR_ICACHE else M7_CCSIDR_DCACHE

// The configurable faults' exception numbers, whose priorities SHPR1 holds.
const MEM_MANAGE: u32 = 4
const BUS_FAULT: u32 = 5
const USAGE_FAULT: u32 = 6

// The implemented high bits of a priority byte, configured per core. Defaults are 2 on Baseline
// models and 4 on Mainline models. Board validation holds the value to the model's range.
@inline
prio_mask(cpu: *Cpu) -> u32 = (0xFF << (8 - cpu.priority_bits)) & 0xFF

// Whether an access of `width` bytes to `a` is one of the bytes or halfwords of a priority register,
// which ARMv8-M allows as well as words (CMSIS's `NVIC_SetPriority` writes a byte).
byte_wide(a: u32, width: u32) -> bool
    if a & (width - 1) != 0 then return false

    (a >= NVIC_IPR && a < NVIC_IPR + 512) || (a >= SCB_SHPR1 && a < SCB_SHPR3 + 4) || (a >= SCB_CFSR && a < SCB_CFSR + 4)

// The `width` bytes at `a` of the word `w` read from its aligned address; and `w` with them replaced.
@inline
part_of(w: u32, a: u32, width: u32) -> u32 = low_bytes(w >> ((a & 3) * 8), width)

@inline
with_part(w: u32, a: u32, width: u32, x: u32) -> u32
    val shift = (a & 3) * 8
    val mask = low_bytes(0xFFFFFFFF, width) << shift

    (w & ~mask) | ((x << shift) & mask)

// SCR's bits on a core: SLEEPONEXIT, SLEEPDEEP and SEVONPEND on every profile, and SLEEPDEEPS with
// the Security Extension. SEVONPEND makes an interrupt becoming pending an event (`raise`, and
// a write to ISPR in `nvic_write`);
// SLEEPDEEP is stored and changes nothing the boards model.
scr_bits(cpu: *Cpu) -> u32 = if cpu.security then SCR_BITS else SCR_BITS & ~SCR_SLEEPDEEPS

// The registers only ARMv8-M has, and SCR, which every profile has. On ARMv6-M each of the rest is an
// address benchtop does not model (`scs_unmodelled`).
scs_read8(cpu: *Cpu, a: u32) -> u32
    if a == SCB_SCR then return cpu.scr

    if is_v6m(cpu.kind)
        scs_unmodelled(cpu, a)
        return 0

    if cpu.kind == Kind.M23 && a != SCB_CCR && a != ICTR then
        scs_unmodelled(cpu, a)
        return 0

    a match
        ICTR -> (cpu.nvic_irqs + 31) / 32 - 1
        ACTLR -> 0
        SCB_CCR -> cpu.ccr
        SCB_SHPR1 ->
            val secure: u32 = if cpu.security then u32(cpu.prio[SECURE_FAULT]) << 24 else 0
            u32(cpu.prio[MEM_MANAGE]) | u32(cpu.prio[BUS_FAULT]) << 8 | u32(cpu.prio[USAGE_FAULT]) << 16 | secure
        SCB_SHCSR -> shcsr_value(cpu)
        SCB_CFSR -> cpu.cfsr
        SCB_HFSR -> cpu.hfsr
        SCB_MMFAR -> cpu.mmfar
        SCB_BFAR -> cpu.bfar
        // Without the floating-point extension, every CPACR field reads as "no access".
        SCB_CPACR -> cpu.cpacr
        SCB_CLIDR if cpu.kind == Kind.V7emM7 -> M7_CLIDR
        SCB_CTR if cpu.kind == Kind.V7emM7 -> M7_CTR
        SCB_CCSIDR if cpu.kind == Kind.V7emM7 -> m7_ccsidr(cpu)
        SCB_CSSELR if cpu.kind == Kind.V7emM7 -> cpu.csselr
        _ ->
            if cpu.kind == Kind.V7emM7 && cache_maintenance(a) then return 0

            if cpu.fpu != Fpu.Absent
                a match
                    FP_FPCCR -> return cpu.fpccr
                    FP_FPCAR -> return cpu.fpcar
                    FP_FPDSCR -> return cpu.fpdscr
                    FP_MVFR0 -> return fp_feature(cpu, 0)
                    FP_MVFR1 -> return fp_feature(cpu, 1)
                    FP_MVFR2 -> if fpv5(cpu) then return fp_feature(cpu, 2)
                    _ -> ()

            if is_v7m(cpu.kind)
                pmsav7_read(cpu, a) match
                    Some(v) -> return v
                    None -> ()

            secure_read(cpu, a) match
                Some(v) -> return v
                None -> ()

            scs_unmodelled(cpu, a)
            0

scs_write8(cpu: *Cpu, a: u32, x: u32)
    if a == SCB_SCR
        cpu.scr = x & scr_bits(cpu)
        return

    if is_v6m(cpu.kind) then return scs_unmodelled(cpu, a)

    if cpu.kind == Kind.M23 && a != SCB_CCR then return scs_unmodelled(cpu, a)

    val mask = prio_mask(cpu)

    a match
        ACTLR -> ()
        // Each model keeps only its implemented bits and preserves its fixed ones.
        SCB_CCR -> cpu.ccr = ccr_written(cpu.kind, x)
        SCB_SHPR1 ->
            cpu.prio[MEM_MANAGE] = u8(x & mask)
            cpu.prio[BUS_FAULT] = u8((x >> 8) & mask)
            cpu.prio[USAGE_FAULT] = u8((x >> 16) & mask)
            if cpu.security then cpu.prio[SECURE_FAULT] = u8((x >> 24) & mask)
        SCB_SHCSR -> shcsr_write(cpu, x)
        // Write one to clear.
        SCB_CFSR -> cpu.cfsr &= ~x
        SCB_HFSR -> cpu.hfsr &= ~x
        SCB_MMFAR -> cpu.mmfar = x
        SCB_BFAR -> cpu.bfar = x
        // CP10 and CP11, where the core has a unit to give access to, and each coprocessor 0–7 the
        // board puts on its port; the rest read as zero.
        SCB_CPACR ->
            var keep: u32 = if cpu.fpu != Fpu.Absent then 0x00F00000 else 0
            for i in 0u32..<8 do if cpu.coprocessors & (1 << i) != 0 then keep |= 3 << (2 * i)
            cpu.cpacr = x & keep
            cpu.fp_ready = false
        // A software trigger: the interrupt becomes pending.
        NVIC_STIR -> raise(cpu,x & 0x1ff)
        // FPCCR keeps ASPEN and LSPEN: the state is preserved eagerly, so nothing is ever pending
        // (LSPACT and the rest read 0). FPCAR is a doubleword address, and FPDSCR holds the
        // defaults a new context's FPSCR takes: AHP, DN, FZ and RMode.
        FP_FPCCR if cpu.fpu != Fpu.Absent ->
            cpu.fpccr = x & 0xC0000000
            cpu.fp_ready = false
        FP_FPCAR if cpu.fpu != Fpu.Absent -> cpu.fpcar = x & ~7
        FP_FPDSCR if cpu.fpu != Fpu.Absent -> cpu.fpdscr = x & FPSCR_CONTROLS
        // The M7's identification registers are read-only; CSSELR keeps its InD bit (level 0 is the
        // only level). A maintenance operation is accepted and does nothing: no cache is modelled, so
        // memory is always coherent.
        SCB_CLIDR | SCB_CTR | SCB_CCSIDR if cpu.kind == Kind.V7emM7 -> ()
        SCB_CSSELR if cpu.kind == Kind.V7emM7 -> cpu.csselr = x & 1
        _ ->
            if cpu.kind == Kind.V7emM7 && cache_maintenance(a) then return
            if is_v7m(cpu.kind) && pmsav7_write(cpu, a, x) then return
            if !secure_write(cpu, a, x) then scs_unmodelled(cpu, a)

// ---------------------------------------------------------------------------------------------------
// The system instructions.

// `MRS`: as on ARMv6-M, with APSR's Q, the stack limits, BASEPRI and FAULTMASK. BASEPRI_MAX reads as
// BASEPRI. EPSR reads as 0. Unprivileged, the stack pointers, the limits and the masks read as 0.
mrs8(cpu: *Cpu, ip: *Insn) = mrs8_as(cpu, ip, is_privileged(cpu))

// `mrs8` from code `privileged` or not: a `_NS` register's read goes by the privilege of the state
// reading it, not that of the bank read.
mrs8_as(cpu: *Cpu, ip: *Insn, privileged: bool)
    val sysm = ip.imm

    if !privileged && unprivileged_hidden(sysm, true)
        cpu.r[ip.a] = 0
        return

    cpu.r[ip.a] = sysm match
        8 -> main_sp(cpu)
        9 -> process_sp(cpu)
        10 -> cpu.msplim
        11 -> cpu.psplim
        16 -> cpu.primask
        17 | 18 -> cpu.basepri
        19 -> cpu.faultmask
        20 -> cpu.control
        _ ->
            val ipsr = if sysm & 1 != 0 then cpu.ipsr else 0
            val apsr = if sysm & 4 == 0 then xpsr(cpu) & 0xF80F0000 else 0

            ipsr | apsr

// `MSR`. A stack pointer keeps bits 31–2 and a limit bits 31–3. BASEPRI keeps the implemented bits,
// and BASEPRI_MAX writes it only to raise the priority (a lower non-zero value). FAULTMASK cannot be
// set from the NMI handler. CONTROL is nPRIV and SPSEL, SPSEL only in thread mode, and FPCA where the
// core has the floating-point extension. APSR takes N, Z, C, V and Q (`MSR APSR_nzcvq`), with
// set_apsr's one limit: N and Z both set reads back as Z. Unprivileged code writes APSR alone; every
// other register, CONTROL's FPCA included, ignores it. `n` retired before it.
msr8(cpu: *Cpu, ip: *Insn, n: u64)
    msr8_as(cpu, ip, is_privileged(cpu))
    if cpu.masking != null then masks_changed(cpu, addr_of(cpu, ip), n)

// What `MSR` writes, for the record `ip`, which may be one made on the spot (`ns_register`), from code
// `privileged` or not: a `_NS` register's write goes by the privilege of the state writing it, not
// that of the bank written.
msr8_as(cpu: *Cpu, ip: *Insn, privileged: bool)
    if !privileged && unprivileged_hidden(ip.imm & 0xFF, false) then return
    val x = cpu.r[ip.b]
    val mask = prio_mask(cpu)

    (ip.imm & 0xFF) match
        8 ->
            if on_process_stack(cpu) then cpu.sp_other = x & ~3 else cpu.r[13] = x & ~3
        9 ->
            if on_process_stack(cpu) then cpu.r[13] = x & ~3 else cpu.sp_other = x & ~3
        10 -> cpu.msplim = x & ~7
        11 -> cpu.psplim = x & ~7
        16 -> cpu.primask = x & 1
        17 -> cpu.basepri = x & mask
        18 ->
            val v = x & mask

            if v != 0 && (cpu.basepri == 0 || v < cpu.basepri) then cpu.basepri = v
        19 ->
            if cpu.ipsr != NMI then cpu.faultmask = x & 1
        20 ->
            val fpca = if cpu.fpu != Fpu.Absent then x & 4 else 0

            cpu.fp_ready = false

            if cpu.ipsr != 0
                cpu.control = (cpu.control & 2) | (x & 1) | fpca
            else
                val was = on_process_stack(cpu)

                cpu.control = (x & 3) | fpca

                if on_process_stack(cpu) != was
                    val sp = cpu.r[13]

                    cpu.r[13] = cpu.sp_other
                    cpu.sp_other = sp
        _ ->
            if ip.imm & 4 == 0
                if ip.imm & 0x200 != 0 then set_apsr(cpu, x)
                if cpu.dsp && ip.imm & 0x100 != 0 then cpu.ge = (x >> 16) & 15

    recheck(cpu)
    // CONTROL.nPRIV and FAULTMASK change what the MPU lets the core do.
    if cpu.mpu_used then mpu_privilege_changed(cpu)

// `CPSID` (imm bit 0 set) or `CPSIE`, of PRIMASK (bit 1) and FAULTMASK (bit 2). FAULTMASK is not
// set from the NMI handler. `n` retired before it. Unprivileged, it is a NOP.
cps8(cpu: *Cpu, ip: *Insn, n: u64)
    if !is_privileged(cpu) then return
    val v = ip.imm & 1

    if ip.imm & 2 != 0 then cpu.primask = v
    if ip.imm & 4 != 0 && !(v == 1 && cpu.ipsr == NMI) then cpu.faultmask = v
    if cpu.masking != null then masks_changed(cpu, addr_of(cpu, ip), n)

    recheck(cpu)
    if cpu.mpu_used then mpu_privilege_changed(cpu)
