module sh.sysl.benchtop.v6m

// Core identities and physical configuration limits. Defaults are the implemented scalar subset;
// optional extensions are declared by board descriptions and refused until their semantics exist.
//
// `MODELS` is the one description of what each `Kind` is: its architecture, and from that every
// `is_*` predicate below; its floating-point unit; its DSP extension. Nothing else lists kinds by
// architecture.
enum Arch
    V6m
    V7m
    V8mBase
    V8mMain
    V81mMain
end Arch

struct Model
    name: string
    kind: Kind
    arch: Arch
    cpuid: u32
    // The external interrupt lines the NVIC implements.
    irqs: int
    // The floating-point unit the core may be built with (the board chooses whether it is), and
    // whether it is FPv5 (VSEL, VMAXNM, VRINT and the rest) rather than the Cortex-M4's FPv4-SP.
    fpu: Fpu
    fpv5: bool
    // Whether the DSP extension is in the core; on ARMv7-M it is then fixed (ARMv7E-M).
    dsp: bool
    security: bool
    icache: bool
    dcache: bool
    mpu_step: long
    mpu_max: long
end Model

// CPUID revisions are virtual-model choices; the part numbers identify the processor.
// Arm DDI0432 (M0), DDI0413 (M1), DDI0337 (M3), DDI0550 (M23), the M35P TRM,
// 102776 r0p3 (M52, implementer 0x63), 101051 r1p0 (M55), 101924 r0p0 (M85).
val MODELS: [12]Model = [
    Model(name = "cortex-m0plus", kind = Kind.V6m, arch = Arch.V6m, cpuid = 0x410CC601, irqs = 32,
        fpu = Fpu.Absent, fpv5 = false, dsp = false, security = false, icache = false, dcache = false, mpu_step = 8, mpu_max = 8),
    Model(name = "cortex-m4", kind = Kind.V7em, arch = Arch.V7m, cpuid = 0x410FC241, irqs = 240,
        fpu = Fpu.Single, fpv5 = false, dsp = true, security = false, icache = false, dcache = false, mpu_step = 8, mpu_max = 8),
    Model(name = "cortex-m7", kind = Kind.V7emM7, arch = Arch.V7m, cpuid = 0x410FC270, irqs = 240,
        fpu = Fpu.Double, fpv5 = true, dsp = true, security = false, icache = true, dcache = true, mpu_step = 8, mpu_max = 16),
    Model(name = "cortex-m33", kind = Kind.V8mMain, arch = Arch.V8mMain, cpuid = 0x411FD210, irqs = 480,
        fpu = Fpu.Single, fpv5 = true, dsp = true, security = true, icache = false, dcache = false, mpu_step = 4, mpu_max = 16),
    Model(name = "cortex-m0", kind = Kind.M0, arch = Arch.V6m, cpuid = 0x410CC200, irqs = 32,
        fpu = Fpu.Absent, fpv5 = false, dsp = false, security = false, icache = false, dcache = false, mpu_step = 0, mpu_max = 0),
    Model(name = "cortex-m1", kind = Kind.M1, arch = Arch.V6m, cpuid = 0x410CC210, irqs = 32,
        fpu = Fpu.Absent, fpv5 = false, dsp = false, security = false, icache = false, dcache = false, mpu_step = 0, mpu_max = 0),
    Model(name = "cortex-m3", kind = Kind.M3, arch = Arch.V7m, cpuid = 0x410FC230, irqs = 240,
        fpu = Fpu.Absent, fpv5 = false, dsp = false, security = false, icache = false, dcache = false, mpu_step = 8, mpu_max = 8),
    Model(name = "cortex-m23", kind = Kind.M23, arch = Arch.V8mBase, cpuid = 0x410FD200, irqs = 240,
        fpu = Fpu.Absent, fpv5 = false, dsp = false, security = true, icache = false, dcache = false, mpu_step = 4, mpu_max = 16),
    Model(name = "cortex-m35p", kind = Kind.M35p, arch = Arch.V8mMain, cpuid = 0x410FD310, irqs = 480,
        fpu = Fpu.Single, fpv5 = true, dsp = true, security = true, icache = true, dcache = false, mpu_step = 4, mpu_max = 16),
    Model(name = "cortex-m52", kind = Kind.M52, arch = Arch.V81mMain, cpuid = 0x630FD243, irqs = 480,
        fpu = Fpu.Double, fpv5 = true, dsp = true, security = true, icache = true, dcache = true, mpu_step = 4, mpu_max = 16),
    Model(name = "cortex-m55", kind = Kind.M55, arch = Arch.V81mMain, cpuid = 0x411FD220, irqs = 480,
        fpu = Fpu.Double, fpv5 = true, dsp = true, security = true, icache = true, dcache = true, mpu_step = 4, mpu_max = 16),
    Model(name = "cortex-m85", kind = Kind.M85, arch = Arch.V81mMain, cpuid = 0x410FD230, irqs = 480,
        fpu = Fpu.Double, fpv5 = true, dsp = true, security = true, icache = true, dcache = true, mpu_step = 4, mpu_max = 16),
]

// The index in `MODELS` of each kind, by its discriminant, so `model_of` is one load.
private val MODEL_INDEX: [12]u8 = model_index()

private model_index() -> [12]u8
    var index: [12]u8 = [0; 12]
    for i in 0..<MODELS.len do index[usize(int(MODELS[i].kind))] = u8(i)
    index

model_named(name: string) -> Option[Model]
    for model in MODELS do if model.name == name then return Some(model)
    None

@inline
model_of(kind: Kind) -> Model = MODELS[usize(MODEL_INDEX[usize(int(kind))])]

@inline
arch_of(kind: Kind) -> Arch = model_of(kind).arch

// Architecture predicates, read off the catalog, used at decode and run boundaries.
@inline
is_v6m(kind: Kind) -> bool = arch_of(kind) == Arch.V6m

@inline
is_baseline(kind: Kind) -> bool = arch_of(kind) == Arch.V6m || arch_of(kind) == Arch.V8mBase

@inline
is_v7m(kind: Kind) -> bool = arch_of(kind) == Arch.V7m

@inline
is_v81m(kind: Kind) -> bool = arch_of(kind) == Arch.V81mMain

// ARMv7E-M is ARMv7-M with the DSP extension, so a v7-M core that has it always has it; on the
// ARMv8-M cores that offer it, it is a choice made when the chip is built.
@inline
has_fixed_dsp(kind: Kind) -> bool = is_v7m(kind) && model_of(kind).dsp

@inline
default_priority_bits(kind: Kind) -> u32 = if is_baseline(kind) then 2 else 4

model_names() -> string
    var out = ""
    for i in 0..<MODELS.len
        if i > 0 then out += if i + 1 == MODELS.len then " or " else ", "
        out += MODELS[i].name
    out
end model_names
