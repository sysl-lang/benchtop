module sh.sysl.benchtop.v6m
@tests

// IT blocks, against the ARMv8-M ARM ("IT", `ITAdvance`, "Conditional execution"): every condition
// under every mask of one to four instructions, then and else, on every combination of the flags; the
// flags as each instruction finds them; 32-bit instructions in a block; the 16-bit instructions that
// set no flags inside one; and what thumb2.sysl says of exceptions taken inside a block, branches into
// one, and a halfword decoded both inside and outside one. Both executors run every case, and must
// agree: the threaded one on the conditions decoded into its handlers, the `match` one on ITSTATE kept
// as the architecture keeps it.

// Condition `cond` on the flags `nzcv`, from the architecture's table of conditions: each pair is a
// test and its negation, and 1110 is always.
cond_ref(cond: u32, nzcv: u32) -> bool
    val n = (nzcv >> 3) & 1
    val z = (nzcv >> 2) & 1
    val c = (nzcv >> 1) & 1
    val v = nzcv & 1
    val base = cond >> 1 match
        0 -> z == 1
        1 -> c == 1
        2 -> n == 1
        3 -> v == 1
        4 -> c == 1 && z == 0
        5 -> n == v
        6 -> n == v && z == 0
        _ -> true

    if cond & 1 == 1 && cond != 15 then !base else base

// The IT instruction for a block of `len` instructions on `cond`: bit k of `thens` says whether the
// instruction after the first, k + 2nd, is a then (1) or an else (0).
it_of(cond: u32, len: u32, thens: u32) -> u16
    var mask: u32 = 1 << (4 - len)

    for k in 0u32..<(len - 1)
        val x = if (thens >> k) & 1 == 1 then cond & 1 else 1 - (cond & 1)

        mask |= x << (3 - k)

    u16(0xBF00 | (cond << 4) | mask)

// Run the machine `cpu` holds again from 0, r0–r3 cleared and the flags `nzcv`, with `exec`.
again(cpu: *Cpu, nzcv: u32, exec: Exec)
    for k in 0..<4 do cpu.r[k] = 0
    set_flags(cpu, nzcv)
    cpu.pc = 0
    cpu.retired = 0
    cpu.stop = Stop.Running
    cpu.it = 0
    finish(cpu, exec)

// Every flag combination for one block: `IT`, then `ADDS rK, #1` for the K-th instruction, which in a
// block adds without setting flags. Each executor runs it, and each instruction runs exactly when its
// condition (or for an else, its negation) holds; every one retires; nothing touches the flags; and
// ITSTATE ends at 0.
block_holds(cond: u32, len: u32, thens: u32, exec: Exec) -> bool
    var cpu: Cpu
    var code: [5]u16

    code[0] = it_of(cond, len, thens)
    for k in 0..<len do code[k + 1] = u16(0x3001 | (k << 8))

    cpu.kind = Kind.V8mMain
    prepare(&cpu, code[0..(len)], [], 0, [])

    for nzcv in 0u32..<16
        // N and Z are never both set.
        if nzcv & 0xC == 0xC then continue

        again(&cpu, nzcv, exec)

        val holds = cond_ref(cond, nzcv)

        if cpu.stop != Stop.Breakpoint || cpu.stop_at != 2 + 2 * len || cpu.retired != u64(1 + len) || flags(&cpu) != nzcv || cpu.it != 0
            print(f"IT 0x${code[0]}%04x on ${nzcv}%04b: stopped at 0x${cpu.stop_at}%x after ${cpu.retired}, flags ${flags(&cpu)}%04b")
            return false

        for k in 0u32..<len
            val runs = if k == 0 || (thens >> (k - 1)) & 1 == 1 then holds else !holds

            if cpu.r[k] != (if runs then 1 else 0)
                print(f"IT 0x${code[0]}%04x on ${nzcv}%04b: instruction ${k + 1} ${if runs then "should run" else "should not"}")
                return false

    true

@test("every condition, under every mask of one to four instructions, then and else, on every flag combination")
t2t_every_mask()
    for cond in 0u32..<15
        for len in 1u32..<5
            for thens in 0u32..<(1 << (len - 1))
                // IT AL with an else is UNPREDICTABLE.
                if cond == 14 && thens != (1 << (len - 1)) - 1 then continue

                assert(block_holds(cond, len, thens, &run_match), "under the match executor")
                assert(block_holds(cond, len, thens, &run_threaded), "under the threaded executor")

@test("each instruction of a block tests the flags as the instructions before it in the block left them")
t2t_flags_within()
    // cmp r0, r0 (Z); itte eq; cmpeq r0, #1; addeq r1, #1; addne r2, #1
    val code: []const u16 = [0x4280, 0xBF06, 0x2801, 0x3101, 0x3201]
    var c = execute8(code, [1], 0, [])
    assert(c.r[1] == 1 && c.r[2] == 0 && c.retired == 5, "the compare leaves Z set")
    c = execute8(code, [2], 0, [])
    assert(c.r[1] == 0 && c.r[2] == 1 && c.retired == 5, "the compare clears Z")

@test("a block's 32-bit instructions run or are skipped whole")
t2t_wide()
    // ite ne; addne.w r1, r1, #1; moveq.w r2, #5
    val code: []const u16 = [0xBF14, 0xF101, 0x0101, 0xF04F, 0x0205]
    var c = execute8(code, [0, 7], 0b0100, [])
    assert(c.r[1] == 7 && c.r[2] == 5 && c.stop_at == 10 && c.retired == 3, "Z: the then is skipped")
    c = execute8(code, [0, 7], 0, [])
    assert(c.r[1] == 8 && c.r[2] == 0 && c.stop_at == 10 && c.retired == 3, "not Z: the else is skipped")

@test("a skipped load makes no access: one where nothing is does not stop the core")
t2t_skipped_access()
    // it ne; ldrne r0, [r1], r1 an address nothing answers
    var c = execute8([0xBF18, 0x6808], [0, 0x50000000], 0b0100, [])
    assert(c.stop == Stop.Breakpoint && c.retired == 2, "skipped")
    c = execute8([0xBF18, 0x6808], [0, 0x50000000], 0, [])
    assert(c.stop == Stop.Unmapped && c.stop_at == 0x50000000 && c.pc == 2, "run")

// One block of four from the 16-bit data-processing encodings that set flags outside a block, on EQ
// with Z set: each must give `want` (`[register, value]`) and leave the flags.
in_block(body: [4]u16, regs: []const u32, want: [][2]u32) -> bool
    var c = execute8([0xBF01, body[0], body[1], body[2], body[3]], regs, 0b0110, [])

    if c.stop != Stop.Breakpoint || c.retired != 5 || flags(&c) != 0b0110
        print(f"stopped at ${c.stop} after ${c.retired}, flags ${flags(&c)}%04b")
        return false

    for w in want
        if c.r[w[0]] != w[1]
            print(f"r${w[0]} = 0x${c.r[w[0]]}%08x, not 0x${w[1]}%08x")
            return false

    true

@test("inside a block the 16-bit data-processing instructions set no flags, and compute as they do outside one")
t2t_no_flags()
    // add r0, r1, r2; sub r3, r1, r2; lsl r4, r1, #4; lsr r5, r1, #32
    assert(in_block([0x1888, 0x1A8B, 0x010C, 0x080D], [0, 0x80000010, 0x10], [[0, 0x80000020], [3, 0x80000000], [4, 0x100], [5, 0]]), "A")
    // asr r0, r1, #1; and r2, r3; eor r4, r5; lsl r6, r7
    assert(in_block([0x1048, 0x401A, 0x406C, 0x40BE], [0, 0x80000000, 0xF0, 0x3C, 0xFF, 0x0F, 1, 33], [[0, 0xC0000000], [2, 0x30], [4, 0xF0], [6, 0]]), "B")
    // lsr r0, r1; asr r2, r3; adc r4, r5; sbc r6, r7, with C set
    assert(in_block([0x40C8, 0x411A, 0x416C, 0x41BE], [0x80000000, 31, 0x80000000, 40, 5, 6, 10, 3], [[0, 1], [2, 0xFFFFFFFF], [4, 12], [6, 7]]), "C")
    // ror r0, r1; rsb r2, r3, #0; orr r4, r5; mul r6, r7, r6
    assert(in_block([0x41C8, 0x425A, 0x432C, 0x437E], [1, 1, 0, 5, 0x0F, 0xF0, 7, 6], [[0, 0x80000000], [2, 0xFFFFFFFB], [4, 0xFF], [6, 42]]), "D")
    // bic r0, r1; mvn r2, r3; mov r4, #200; add r5, r6, #3
    assert(in_block([0x4388, 0x43DA, 0x24C8, 0x1CF5], [0xFF, 0x0F, 0, 0, 0, 0, 7], [[0, 0xF0], [2, 0xFFFFFFFF], [4, 200], [5, 10]]), "E")
    // add r0, #255; sub r1, #1; mov r2, r3 (the LSL #0 encoding); sub r4, r5, #2
    assert(in_block([0x30FF, 0x3901, 0x001A, 0x1EAC], [1, 0, 0, 0x1234, 0, 1], [[0, 256], [1, 0xFFFFFFFF], [2, 0x1234], [4, 0xFFFFFFFF]]), "F")

@test("a branch into the middle of a block (UNPREDICTABLE) runs what is left of it unconditionally, as decoded in the block")
t2t_branch_into()
    // 0: itte eq; 2: addeq r1, #1; 4: addeq r2, #1; 6: addne r3, #1; 8: cbz r4, 12; 10: bkpt;
    // 12: movs r4, #1; 14: b 4, into the block
    val code: []const u16 = [0xBF06, 0x3101, 0x3201, 0x3301, 0xB104, 0xBE00, 0x2401, 0xE7F9]
    val c = execute8(code, [], 0, [])

    // The first pass, from the IT with Z clear, skips the two thens and runs the else. The second
    // comes in at 4 with ITSTATE 0, Z still clear, and runs both instructions there.
    assert(c.stop == Stop.Breakpoint && c.stop_at == 10, "stopped at the breakpoint")
    assert(c.r[1] == 0 && c.r[2] == 1 && c.r[3] == 2, "the second pass ran unconditionally")

// ---------------------------------------------------------------------------------------------------
// The handler an instruction of a block runs, chosen when the block is decoded.

// 32-bit instructions, one from each family the decoder gives a handler made for its operation
// (`handler_at`), each setting rK to 1: add.w r0, r0, #1; orr.w r1, r1, #1; add.w r2, r2, r7, r7 = 1;
// ldr.w r3, [r6], r6 the address of a 1.
val WIDE: [4][2]u16 = [[0xF100, 0x0001], [0xF041, 0x0101], [0xEB02, 0x0207], [0xF8D6, 0x3000]]

// Run a prepared machine again from 0 as `again` does, its cycle count cleared too.
again_timed(cpu: *Cpu, nzcv: u32, exec: Exec)
    cpu.extra_cycles = 0
    again(cpu, nzcv, exec)

// A block of `len` of `WIDE` on `cond`, under both executors on every flag combination, timed or not:
// each instruction runs exactly when its condition holds, and the executors agree on the cycles, so
// the threaded one ran the handler made for the core's timing.
wide_block_holds(cond: u32, len: u32, thens: u32, timed: bool) -> bool
    var a: Cpu
    var b: Cpu
    var code: [9]u16

    code[0] = it_of(cond, len, thens)
    for k in 0..<len
        code[1 + 2 * k] = WIDE[k][0]
        code[2 + 2 * k] = WIDE[k][1]

    a.kind = Kind.V8mMain
    b.kind = Kind.V8mMain
    prepare(&a, code[0..(2 * len)], [0, 0, 0, 0, 0, 0, LOW, 1], 0, [[LOW, 1]])
    prepare(&b, code[0..(2 * len)], [0, 0, 0, 0, 0, 0, LOW, 1], 0, [[LOW, 1]])
    configure_instruction_timing(&a, timed)
    configure_instruction_timing(&b, timed)

    for nzcv in 0u32..<16
        if nzcv & 0xC == 0xC then continue

        again_timed(&a, nzcv, &run_match)
        again_timed(&b, nzcv, &run_threaded)

        val holds = cond_ref(cond, nzcv)

        for c in [&a, &b]
            if c.stop != Stop.Breakpoint || c.stop_at != 2 + 4 * len || c.retired != u64(1 + len) || flags(c) != nzcv || c.it != 0
                print(f"IT 0x${code[0]}%04x on ${nzcv}%04b: stopped at 0x${c.stop_at}%x after ${c.retired}")
                return false

            for k in 0u32..<len
                val runs = if k == 0 || (thens >> (k - 1)) & 1 == 1 then holds else !holds

                if c.r[k] != (if runs then 1 else 0)
                    print(f"IT 0x${code[0]}%04x on ${nzcv}%04b: wide instruction ${k + 1} ${if runs then "should run" else "should not"}")
                    return false

        if cycles(&a) != cycles(&b)
            print(f"IT 0x${code[0]}%04x on ${nzcv}%04b, timed ${timed}: ${cycles(&a)} cycles under match, ${cycles(&b)} threaded")
            return false

    true

@test("blocks of every length of 32-bit instructions of every handler family, timed or not, run as their conditions say")
t2t_wide_families()
    for timed in [false, true]
        for cond in 0u32..<15
            for len in 1u32..<5
                for thens in 0u32..<(1 << (len - 1))
                    if cond == 14 && thens != (1 << (len - 1)) - 1 then continue

                    assert(wide_block_holds(cond, len, thens, timed), s"cond $cond, length $len, thens $thens")

@test("paired cores keep the handlers of their own records of a block: one timed, the other not")
t2t_paired_predicated()
    val mem = memory()
    var a: Cpu
    var b: Cpu

    a.kind = Kind.V8mMain
    b.kind = Kind.V8mMain
    reset(&a, mem, [], 0)
    // cmp r0, r0; it eq; ldreq r1, [r2]; bkpt
    for (i, hw) in [0x4280u16, 0xBF08, 0x6811, 0xBE00].enumerate() do store16(&a, u32(i) * 2, hw)
    store32(&a, 0x100, 7)
    attach_memory(&b, mem)
    clear(&b, 0)
    pair(&a, &b)
    assert(a.predicated == &mem.predicated[0] && b.predicated == &mem.predicated_own[0], "each core's own table")
    configure_instruction_timing(&a, true)

    // Each decodes the block into its own records; then the first runs from its records again.
    for c in [&a, &b, &a]
        c.r[1] = 0
        c.r[2] = 0x100
        again_timed(c, 0, &run_threaded)
        assert(c.stop == Stop.Breakpoint && c.r[1] == 7 && c.retired == 3, "the load ran")

    assert(cycles(&a) == 4 && cycles(&b) == 3, s"timed ${cycles(&a)}, untimed ${cycles(&b)}")
    unpair(&a, &b)
    assert(b.predicated == &mem.predicated[0], "shared again")

// ---------------------------------------------------------------------------------------------------
// A compiler-shaped loop of IT blocks: bench/guest/it.s, whose answer it.c computes.

val it33 = embed("../../../../bench/guest/it33.bin")

// it.c's answer for two rounds.
const IT_2: u32 = 4114396997

// The IT guest, its round count patched to 2, timed or not, to its breakpoint.
it33_run(cpu: *Cpu, exec: Exec, timed: bool)
    cpu.kind = Kind.V8mMain
    reset(cpu, test_memory, it33, 0)
    configure_instruction_timing(cpu, timed)
    store32(cpu, 0x10, 2)

    while cpu.stop == Stop.Running
        cpu.limit = cpu.retired + 1000
        exec(cpu)

@test("the IT guest gives the host's answer under both executors, timed or not, in as many instructions and cycles")
t2t_it_guest()
    for timed in [false, true]
        var a: Cpu
        var b: Cpu

        it33_run(&a, &run_match, timed)
        it33_run(&b, &run_threaded, timed)
        assert(a.stop == Stop.Breakpoint && b.stop == Stop.Breakpoint, "stopped at the breakpoint")
        assert(a.r[0] == IT_2 && b.r[0] == IT_2, f"r0 is 0x${a.r[0]}%x and 0x${b.r[0]}%x, not 0x${IT_2}%x")
        assert(a.retired == b.retired && cycles(&a) == cycles(&b), s"retired ${a.retired} and ${b.retired}")
        assert(a.retired > 500000, "most of the loop runs inside blocks")
