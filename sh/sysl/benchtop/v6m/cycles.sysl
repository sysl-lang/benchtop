module sh.sysl.benchtop.v6m

// Constant instruction-cost estimates, not a pipeline/cache simulator. See
// docs/instruction-timing.md for sources and explicit approximation choices.
// Unit timing remains the default; changing mode requires a reset.
const CYCLE_ACCOUNTING: bool = true

instruction_cycles(kind: Kind, op: Op) -> u8 = op match
    LdrLit | StrReg | StrhReg | StrbReg | LdrsbReg | LdrReg | LdrhReg | LdrbReg | LdrshReg | StrImm | LdrImm | StrbImm | LdrbImm | StrhImm | LdrhImm | LdImm | LdWb | LdReg | LdLit | Ldrex | Strex | Lda | Stl | FpLdr | FpLdrLit -> 2
    Push | Pop | Stm | Ldm | PushL | LdmW | StmW | FpMulti -> 5
    PopPc | LdmPc -> 7
    Leave | AddPc | MovPc | Bx | Blx | B | Bl | LeaveW -> if kind == Kind.V6m || kind == Kind.V7emM7 then 2 else 3
    Beq | Bne | Bcs | Bcc | Bmi | Bpl | Bvs | Bvc | Bhi | Bls | Bge | Blt | Bgt | Ble | Cbz | Cbnz | BcondW -> 2
    LdPc | Tbb | Tbh -> 4
    Ldrd | Strd | LdrdLit -> 3
    Udiv | Sdiv -> 7
    Mla | Mls -> if kind == Kind.V7emM7 then 1 else 2
    Umull | Smull | Umlal | Smlal -> if kind == Kind.M3 then 4 else 1
    Mrs | Msr | Mrs8 | Msr8 -> if is_baseline(kind) then 3 else (if op == Op.Msr || op == Op.Msr8 then 2 else 1)
    FpData | FpMove -> 1
    _ -> 1

// Single-precision costs follow the M4 FPU table. M7 double precision uses
// conservative serial estimates; these are deliberately not throughput claims.
fp_instruction_cycles(kind: Kind, operation: u32, double: bool) -> u8
    if operation == FP_DIV || operation == FP_SQRT then return if double then 28 else 14
    if operation >= FP_MLA && operation <= FP_NMLS then return if double then 5 else 3
    if operation >= FP_FMA && operation <= FP_FNMS then return if double then 5 else 3
    if double && (operation == FP_ADD || operation == FP_SUB || operation == FP_MUL || operation == FP_NMUL) then return 3
    1

configure_instruction_timing(cpu: *Cpu, enabled: bool)
    cpu.instruction_timing = CYCLE_ACCOUNTING && enabled
    for i in 0..<cpu.cycle_costs.len do cpu.cycle_costs[i] = 1
    if !cpu.instruction_timing then return
    for op in [Op.LdrLit,Op.StrReg,Op.StrhReg,Op.StrbReg,Op.LdrsbReg,Op.LdrReg,Op.LdrhReg,Op.LdrbReg,Op.LdrshReg,Op.StrImm,Op.LdrImm,Op.StrbImm,Op.LdrbImm,Op.StrhImm,Op.LdrhImm,Op.LdImm,Op.LdWb,Op.LdReg,Op.LdLit,Op.Ldrex,Op.Strex,Op.Lda,Op.Stl,Op.FpLdr,Op.FpLdrLit,Op.Push,Op.Pop,Op.Stm,Op.Ldm,Op.PushL,Op.LdmW,Op.StmW,Op.FpMulti,Op.PopPc,Op.LdmPc,Op.Leave,Op.AddPc,Op.MovPc,Op.Bx,Op.Blx,Op.B,Op.Bl,Op.LeaveW,Op.Beq,Op.Bne,Op.Bcs,Op.Bcc,Op.Bmi,Op.Bpl,Op.Bvs,Op.Bvc,Op.Bhi,Op.Bls,Op.Bge,Op.Blt,Op.Bgt,Op.Ble,Op.Cbz,Op.Cbnz,Op.BcondW,Op.LdPc,Op.Tbb,Op.Tbh,Op.Ldrd,Op.Strd,Op.LdrdLit,Op.Udiv,Op.Sdiv,Op.Mla,Op.Mls,Op.Umull,Op.Smull,Op.Umlal,Op.Smlal,Op.Mrs,Op.Msr,Op.Mrs8,Op.Msr8,Op.FpData,Op.FpMove]
        cpu.cycle_costs[usize(u8(op))] = instruction_cycles(cpu.kind,op)

// Called only by potentially multi-cycle handlers. The common one-cycle ALU
// handlers remain unchanged. No growth of the 16-byte decoded instruction.
@inline
charge_instruction(cpu: *Cpu, ip: *Insn)
    if !CYCLE_ACCOUNTING || !cpu.instruction_timing then return
    val cost = if ip.op == Op.FpData then fp_instruction_cycles(cpu.kind,fp_op(ip),fp_is_double(ip) != 0)
        else cpu.cycle_costs[usize(u8(ip.op))]
    cpu.extra_cycles += u64(cost - 1)

@inline
retire_timed(cpu: *Cpu, ip: *Insn, n: u64) -> u64
    charge_instruction(cpu,ip)
    n + 1

// A run's limit is measured in executed cycles, excluding slept time.
@inline
executed_cycles(cpu: *Cpu, n: u64) -> u64 = n + (if CYCLE_ACCOUNTING then cpu.extra_cycles else 0)

cycles(cpu: *Cpu) -> u64 = executed_cycles(cpu,cpu.retired)
