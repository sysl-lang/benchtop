module sh.sysl.benchtop.v6m

// Constant instruction-cost estimates, not a pipeline/cache simulator. See
// docs/instruction-timing.md for sources and explicit approximation choices.
// A reset leaves a core on unit timing, one cycle per instruction; `configure_instruction_timing`
// changes it, and only a reset should follow.

// The cycles an operation takes on a core of kind `kind`. This is the one cost table: the per-core
// table is filled from it for every `Op` (`configure_instruction_timing`), and a handler built from a
// shared shape charges cycles exactly when some core can take more than one (`costed`).
const instruction_cycles(kind: Kind, op: Op) -> u8 = op match
    LdrLit | StrReg | StrhReg | StrbReg | LdrsbReg | LdrReg | LdrhReg | LdrbReg | LdrshReg | StrImm | LdrImm | StrbImm | LdrbImm | StrhImm | LdrhImm | LdImm | LdWb | LdReg | LdLit | Ldrex | Strex | Lda | Stl | FpLdr | FpLdrLit -> 2
    Push | Pop | Stm | Ldm | PushL | LdmW | StmW | FpMulti -> 5
    PopPc | LdmPc -> 7
    Leave | AddPc | MovPc | Bx | Blx | B | LeaveW -> if kind == Kind.V6m || kind == Kind.V7emM7 then 2 else 3
    Bl -> if kind == Kind.V7emM7 then 2 else 3
    Beq | Bne | Bcs | Bcc | Bmi | Bpl | Bvs | Bvc | Bhi | Bls | Bge | Blt | Bgt | Ble | Cbz | Cbnz | BcondW -> 2
    LdPc | Tbb | Tbh -> 4
    Ldrd | Strd | LdrdLit -> 3
    Udiv | Sdiv -> 7
    Mla | Mls -> if kind == Kind.V7emM7 then 1 else 2
    Umull | Smull | Umlal | Smlal -> if kind == Kind.M3 then 4 else 1
    Mrs | Msr | Mrs8 | Msr8 -> if is_baseline(kind) then 3 else (if op == Op.Msr || op == Op.Msr8 then 2 else 1)
    _ -> 1

// Whether any core takes more than one cycle for `op`: a handler for an operation that never does
// has no cycle accounting in it, timed or not.
const costed(op: Op) -> bool
    for const k in Kind::Variants
        if instruction_cycles(Kind::Make(k, ()), op) > 1 then return true

    false

// Single-precision costs follow the M4 FPU table. M7 double precision uses
// conservative serial estimates; these are deliberately not throughput claims.
fp_instruction_cycles(kind: Kind, operation: u32, double: bool) -> u8
    if operation == FP_DIV || operation == FP_SQRT then return if double then 28 else 14
    if operation >= FP_MLA && operation <= FP_NMLS then return if double then 5 else 3
    if operation >= FP_FMA && operation <= FP_FNMS then return if double then 5 else 3
    if double && (operation == FP_ADD || operation == FP_SUB || operation == FP_MUL || operation == FP_NMUL) then return 3
    1

configure_instruction_timing(cpu: *Cpu, enabled: bool)
    cpu.instruction_timing = enabled

    for const c in Op::Variants
        val op = Op::Make(c, ())

        cpu.cycle_costs[usize(u8(op))] = if enabled then instruction_cycles(cpu.kind, op) else 1

// The cycles the record `ip` takes on `cpu`: 1 on an untimed core, whichever core decoded the record
// (cores of one kind share records, and a timed handler may run on an untimed one). Only handlers
// that may take more than one cycle call it; the costs that vary by operand are worked out from the
// record's own fields, so the 16-byte record carries no cost of its own.
instruction_record_cycles(cpu: *Cpu, ip: *Insn) -> u8
    if !cpu.instruction_timing then return 1
    record_cycles(cpu, ip)

private record_cycles(cpu: *Cpu, ip: *Insn) -> u8 = ip.op match
    FpData -> fp_instruction_cycles(cpu.kind,fp_op(ip),fp_is_double(ip) != 0)
    FpLdr -> if ip.imm & 32 != 0 then 3 else 2
    FpLdrLit -> if u32(ip.c) & 2 != 0 then 3 else 2
    FpMove -> if (ip.imm & 7) == MOVE_FROM_PAIR || (ip.imm & 7) == MOVE_TO_PAIR then 2 else 1
    _ -> cpu.cycle_costs[usize(u8(ip.op))]

@inline
charge_instruction(cpu: *Cpu, ip: *Insn)
    if !cpu.instruction_timing then return
    cpu.extra_cycles += u64(record_cycles(cpu,ip) - 1)

@inline
retire_timed[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64) -> u64
    if TIMED then cpu.extra_cycles += u64(cpu.cycle_costs[usize(u8(ip.op))] - 1)
    n + 1

@inline
retire_fp[const TIMED: bool](cpu: *Cpu, ip: *Insn, n: u64) -> u64
    if TIMED then cpu.extra_cycles += u64(instruction_record_cycles(cpu,ip) - 1)
    n + 1

// A run's limit is measured in executed cycles, excluding slept time.
@inline
executed_cycles(cpu: *Cpu, n: u64) -> u64 = n + cpu.extra_cycles

cycles(cpu: *Cpu) -> u64 = executed_cycles(cpu,cpu.retired)
