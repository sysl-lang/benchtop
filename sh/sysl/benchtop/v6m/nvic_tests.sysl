module sh.sysl.benchtop.v6m
@tests
import sh.sysl.benchtop.timing.NEVER

@test("NVIC banks: every implemented IRQ sets, clears and masks without aliasing across model boundaries")
nvic_all_lines()
    for model in MODELS
        var c: Cpu
        c.kind = model.kind
        reset(&c, test_memory, [], 0)
        assert(c.nvic_irqs == u32(model.irqs))
        for irq in 0u32..<c.nvic_irqs
            val bank = irq / 32 * 4
            val bit = 1u32 << (irq & 31)
            store32(&c,NVIC_ISER + bank,bit)
            assert(irq_enabled(&c,irq) && load32(&c,NVIC_ISER + bank) == bit)
            store32(&c,NVIC_ISPR + bank,bit)
            assert(best_pending(&c) == int(IRQ0 + irq) && exception_pending(&c,IRQ0 + irq))
            store32(&c,NVIC_ICPR + bank,bit)
            store32(&c,NVIC_ICER + bank,bit)
            assert(best_pending(&c) == -1 && !irq_enabled(&c,irq) && c.pending_banks == 0)
        if !is_v6m(model.kind)
            val first_unimplemented = (c.nvic_irqs + 31) / 32
            if first_unimplemented < 16
                store32(&c,NVIC_ISER + first_unimplemented * 4,0xffffffff)
                assert(load32(&c,NVIC_ISER + first_unimplemented * 4) == 0)
            assert(load32(&c,ICTR) == (c.nvic_irqs + 31) / 32 - 1)
        assert(c.stop == Stop.Running,model.name)

@test("NVIC banks: high priority, BASEPRI, PRIGROUP, STIR and atomic incoming interrupts")
nvic_priority_and_incoming()
    var c: Cpu
    c.kind = Kind.V7emM7
    reset(&c, test_memory, [], 0)
    for irq in [0u32,32,47,48,57,87,239]
        store32(&c,NVIC_ISER + irq / 32 * 4,1u32 << (irq & 31))
        store8(&c,NVIC_IPR + irq,0x80)
        poke(&c,irq)
    assert(c.pending[0] == 0 && c.pending_banks == 0)
    take_incoming(&c)
    assert(best_pending(&c) == 16)
    store8(&c,NVIC_IPR + 239,0x20)
    assert(best_pending(&c) == 255)
    c.basepri = 0x20
    assert(running_priority(&c,true) == 0x20 && !could_wake(&c,255))
    c.basepri = 0
    assert(could_wake(&c,255))
    store32(&c,NVIC_STIR,57)
    assert(exception_pending(&c,73))
    set_active(&c,255,true)
    assert(running_priority(&c,true) == 0x20 && load32(&c,NVIC_IABR + 28) == (1u32 << 15))
    set_active(&c,255,false)
    clear(&c,0)
    take_incoming(&c)
    assert(c.pending[0] == 0 && c.pending_banks == 0 && c.active_banks == 0)

@test("NVIC banks: high exception entry and return preserve the full nine-bit IPSR under both executors")
nvic_high_entry_return()
    for exec in [&run_match,&run_threaded]
        var c: Cpu
        c.kind = Kind.V8mMain
        reset(&c, test_memory, [], 0x1000)
        c.r[13] = 0x8000
        store16(&c,0x1000,0xbe00)
        // IRQ479 handler: MOVS r7,#9; BX LR. Return resumes the breakpoint.
        store16(&c,0x1100,0x2709)
        store16(&c,0x1102,0x4770)
        store32(&c,(IRQ0 + 479) * 4,0x1101)
        store32(&c,NVIC_ISER + 14 * 4,1u32 << 31)
        raise(&c,479)
        set_limit(&c,NEVER)
        while c.stop == Stop.Running do exec(&c)
        assert(c.stop == Stop.Breakpoint && c.r[7] == 9 && c.ipsr == 0)
        assert(c.r[13] == 0x8000 && c.active_banks == 0 && c.pending_banks == 0)
        assert(load32(&c,NVIC_IABR + 14 * 4) == 0)

@test("NVIC banks: nested high exceptions restore nine-bit IPSR and active state across return")
nvic_high_nesting()
    for exec in [&run_match,&run_threaded]
        var c: Cpu
        c.kind = Kind.V8mMain
        reset(&c, test_memory, [], 0x1000)
        c.r[13] = 0x8000
        store16(&c,0x1000,0xbe00)
        // IRQ479: MOVS r7,#1; B next; BX LR. IRQ57: MOVS r6,#2; BX LR.
        for pair in [(0x1100u32,0x2701u16),(0x1102,0xe7ff),(0x1104,0x4770),(0x1200,0x2602),(0x1202,0x4770)] do store16(&c,pair.0,pair.1)
        store32(&c,495 * 4,0x1101)
        store32(&c,73 * 4,0x1201)
        store32(&c,NVIC_ISER + 14 * 4,1u32 << 31)
        store32(&c,NVIC_ISER + 4,1u32 << 25)
        store8(&c,NVIC_IPR + 479,0x80)
        store8(&c,NVIC_IPR + 57,0x20)
        raise(&c,479)
        assert((load32(&c,SCB_ICSR) >> 12) & 0x1ff == 495)
        set_limit(&c,0)
        exec(&c)
        assert(c.ipsr == 495 && c.pc == 0x1104 && exception_active(&c,495))
        raise(&c,57)
        set_limit(&c,0)
        exec(&c)
        assert(c.ipsr == 495 && c.r[6] == 2 && !exception_active(&c,73))
        assert(exception_active(&c,495) && c.r[13] == 0x7fe0)
        set_limit(&c,NEVER)
        exec(&c)
        assert(c.stop == Stop.Breakpoint && c.ipsr == 0 && c.active_banks == 0 && c.r[13] == 0x8000)

@test("NVIC banks: high IRQs wake WFI under PRIMASK and unimplemented trailing bits stay zero")
nvic_high_wake()
    for kind in [Kind.V7emM7,Kind.V8mMain]
        var c: Cpu
        c.kind = kind
        reset(&c, test_memory, [], 0)
        store32(&c,NVIC_ISER + 4,1u32 << 25)
        c.primask = 1
        c.sleeping = true
        raise(&c,57)
        assert(wake_by(&c,NEVER) && !c.sleeping && c.ipsr == 0)
        take_pending(&c)
        assert(c.ipsr == 0 && exception_pending(&c,73))
        if kind == Kind.V7emM7
            store32(&c,NVIC_ISER + 28,0xffffffff)
            assert(load32(&c,NVIC_ISER + 28) == 65535)
            store32(&c,NVIC_ISPR + 28,0xffffffff)
            assert(load32(&c,NVIC_ISPR + 28) == 65535)

@test("NVIC banks: every model's interrupt lines fit the exception-indexed words")
nvic_words_hold_every_model()
    assert(u32(NVIC_BANKS) * 64 >= IRQ0 + NVIC_MAX_IRQS)
    for model in MODELS do assert(u32(model.irqs) <= NVIC_MAX_IRQS, model.name)

@test("NVIC banks: a register bank that straddles two words reads, writes and scans as one")
nvic_straddling_bank()
    var c: Cpu
    c.kind = Kind.V8mMain
    reset(&c, test_memory, [], 0)
    // Bank 1 is IRQs 32–63, exceptions 48–79: its low half ends word 0 and its high half starts word 1.
    store32(&c,NVIC_ISER + 4,0x00018001)
    assert(load32(&c,NVIC_ISER + 4) == 0x00018001 && load32(&c,NVIC_ISER) == 0 && load32(&c,NVIC_ISER + 8) == 0)
    assert(irq_enabled(&c,32) && irq_enabled(&c,47) && irq_enabled(&c,48) && !irq_enabled(&c,46) && !irq_enabled(&c,49))
    assert(c.enabled[0] == (u64(1) << 48) | (u64(1) << 63) && c.enabled[1] == 1)
    store32(&c,NVIC_ISPR + 4,0x00018000)
    assert(load32(&c,NVIC_ISPR + 4) == 0x00018000 && c.pending_banks == 2)
    // Equal priorities: the lowest number wins, across the word boundary.
    assert(best_pending(&c) == int(IRQ0 + 47))
    // A higher priority in word 1 beats word 0.
    store8(&c,NVIC_IPR + 47,0x40)
    assert(best_pending(&c) == int(IRQ0 + 48))
    store32(&c,NVIC_ICPR + 4,0x00010000)
    assert(load32(&c,NVIC_ISPR + 4) == 0x00008000 && c.pending_banks == 0 && best_pending(&c) == int(IRQ0 + 47))
    store32(&c,NVIC_ICER + 4,0x00008000)
    assert(load32(&c,NVIC_ISER + 4) == 0x00010001 && best_pending(&c) == -1)
    // Active exceptions in word 0 and word 7: the running priority is the higher of the two.
    store8(&c,NVIC_IPR + 479,0x20)
    set_active(&c,IRQ0 + 47,true)
    set_active(&c,IRQ0 + 479,true)
    assert(c.active_banks == 128 && load32(&c,NVIC_IABR + 56) == 1u32 << 31 && load32(&c,NVIC_IABR + 4) == 1u32 << 15)
    assert(running_priority(&c,false) == 0x20)
    set_active(&c,IRQ0 + 479,false)
    assert(c.active_banks == 0 && running_priority(&c,false) == 0x40)

@test("NVIC banks: high cross-thread delivery is visible to scheduler wake checks before intake")
nvic_incoming_summary()
    var c: Cpu
    c.kind = Kind.V8mMain
    reset(&c, test_memory, [], 0)
    assert(!has_incoming(&c))
    poke(&c,479)
    assert(c.incoming[0] == 0 && has_incoming(&c))
    take_incoming(&c)
    assert(!has_incoming(&c) && exception_pending(&c,495))
    poke(&c,480)
    assert(!has_incoming(&c),"out-of-range delivery must not alias an implemented IRQ")
