module sh.sysl.benchtop.v6m
@tests

import sysl.buf.buf

@test("flash CPU: both executors fetch code and literals from flash, write relocated RAM and reject flash stores")
flash_execution()
    var image = buf[u8]()
    for i in 0..<RAM_BYTES do image.push(0)
    for i in 0..<4096 do image.push(255)
    // movs r0,7; ldr r1,[pc,#4]; str r0,[r1]; bkpt; RAM address literal.
    val words: [3]u32 = [0x49012007, 0xBE006008, 0x20000000]
    for i in 0..<3
        for byte in 0..<4 do image.set(usize(RAM_BYTES) + usize(i * 4 + byte), u8(words[i] >> u32(byte * 8)))
    for kind in [Kind.V6m, Kind.V8mMain]
        for exec in [&run_match, &run_threaded]
            var c: Cpu
            c.kind = kind
            reset_mapped(&c, image.view(), 0x20000000, 4096, 0x10000000, 4096)
            c.pc = 0x10000000
            run_to_stop(&c, exec)
            assert(c.stop == Stop.Breakpoint && c.pc == 0x10000006 && load32(&c, 0x20000000) == 7)
            reset_mapped(&c, image.view(), 0x20000000, 4096, 0x10000000, 4096)
            c.pc = 0x10000004
            c.r[1] = 0x10000000
            run_to_stop(&c, exec)
            assert(c.stop == Stop.Fault && c.stop_at == 0x10000000 && c.pc == 0x10000004)
            assert(load32(&c, 0x10000000) == words[0])

@test("flash CPU: sequential execution stops at flash and RAM ends instead of entering another region")
flash_boundaries()
    var image = buf[u8]()
    for i in 0..<(RAM_BYTES + 4096) do image.push(0)
    image.set(4094, 0)
    image.set(4095, 0xBF) // nop at end of RAM.
    image.set(usize(RAM_BYTES + 4094), 0)
    image.set(usize(RAM_BYTES + 4095), 0xBF)
    for exec in [&run_match, &run_threaded]
        for base in [0x10000000u32, 0x20000000u32]
            var c: Cpu
            c.kind = Kind.V6m
            reset_mapped(&c, image.view(), 0x20000000, 4096, 0x10000000, 4096)
            c.pc = base + 4094
            run_to_stop(&c, exec)
            assert(c.stop == Stop.Unmapped && c.pc == base + 4096)

@test("flash CPU: Thumb-2 wide calls, CBZ and taken wide conditional branches use mapped code addresses")
wide_flash_branches()
    var image = buf[u8]()
    for i in 0..<(RAM_BYTES + 4096) do image.push(0)
    // Assembled for Cortex-M33: movw; cbz; movw; cmp.w; bne.w;
    // bl; bkpt; adds; bx lr; movw; bkpt.
    val code: [17]u16 = [0xF240,0x007B,0xB109,0xF240,0x0009,0xF1B0,0x0F7B,
        0xF040,0x8005,0xF000,0xF801,0xBE00,0x3001,0x4770,0xF240,0x0037,0xBE00]
    for i in 0..<17
        image.set(usize(RAM_BYTES) + usize(i * 2), u8(code[i]))
        image.set(usize(RAM_BYTES) + usize(i * 2 + 1), u8(code[i] >> 8))
    for exec in [&run_match, &run_threaded]
        for input in [0u32, 1u32]
            var c: Cpu
            c.kind = Kind.V8mMain
            reset_mapped(&c, image.view(), 0x20000000, 4096, 0x10000000, 4096)
            c.pc = 0x10000000
            c.r[1] = input
            run_to_stop(&c, exec)
            assert(c.stop == Stop.Breakpoint)
            assert(c.r[0] == (if input == 0 then 124 else 55))
            assert(c.pc == (if input == 0 then 0x10000016u32 else 0x10000020u32))
        image.set(usize(RAM_BYTES + 4094), 0x40)
        image.set(usize(RAM_BYTES + 4095), 0xF2)
        var c: Cpu
        c.kind = Kind.V8mMain
        reset_mapped(&c, image.view(), 0x20000000, 4096, 0x10000000, 4096)
        c.pc = 0x10000FFE
        run_to_stop(&c, exec)
        assert(c.stop == Stop.Undefined && c.pc == 0x10000FFE, "wide decode cannot read past the flash region")
