module sh.sysl.benchtop.v6m
@tests

import sysl.buf.{Buf, buf}

private bank_run(c: *Cpu, pc: u32)
    c.pc = pc
    c.stop = Stop.Running
    set_limit(c,executed_cycles(c,c.retired) + 1000)
    run_threaded(c)

@test("RAM banks: is_code, NO_CODE and the guard window name where code can be and where a run falls to")
ram_banks_code_offsets()
    val mem = memory()
    var banks: Buf[RamBank] = buf()
    var c: Cpu
    c.kind = Kind.V7em
    banks.push(RamBank(0x30000000,4096,8192))
    reset_mapped(&c, mem, [], MemoryMap(0x24000000, 4096, 0x08000000, 0, banks.freeze()))
    for a in [0x24000000u32, 0x24000FFE, 0x30000000, 0x30000FFE] do assert(mem.is_code(a) && mem.code_offset(a) != NO_CODE, f"0x${a}%x")
    for a in [0x23FFFFFEu32, 0x24000FFF, 0x24001000, 0x30001000, 0x08000000] do assert(!mem.is_code(a) && mem.code_offset(a) == NO_CODE, f"0x${a}%x")
    assert(mem.extra_ram_offset(0x40000000,4) == NO_RAM && mem.extra_ram_offset(0x30000010,4) == 8192 + 16)
    // The guard records after each bank answer the address a run falling off its end reaches.
    assert(GUARD_RECORDS * 2 == GUARD_BYTES)
    assert(mem.code_address(4096) == 0x24001000 && mem.code_address(4096 + GUARD_BYTES - 2) == 0x24001000 + GUARD_BYTES - 2)
    assert(mem.code_address(8192 + 4096) == 0x30001000 && mem.code_address(8192 + 4096 + GUARD_BYTES - 2) == 0x30001000 + GUARD_BYTES - 2)
    assert(mem.decoded[(8192 + 4096) >> 1].h == &h_ram_boundary && mem.decoded[(8192 + 4096) >> 1].imm == 0x30001000)

@test("RAM banks: data, device writes, exclusive tracking, code invalidation and reset reuse shared backing")
ram_banks_data()
    val mem = memory()
    var banks: Buf[RamBank] = buf()
    var c: Cpu
    c.kind = Kind.V7em
    banks.push(RamBank(0x30000000,4096,8192))
    reset_mapped(&c, mem, [], MemoryMap(0x24000000, 4096, 0x08000000, 0, banks.freeze()))
    store32(&c,0x24000020,0x12345678)
    store32(&c,0x30000020,0xaabbccdd)
    assert(load32(&c,0x24000020) == 0x12345678 && load32(&c,0x30000020) == 0xaabbccdd)
    assert(!mem.ram_range(0x24001000,4) && !mem.ram_range(0x30000fff,2))
    store16(&c,0x30000000,0x2007)
    store16(&c,0x30000002,0xbe00)
    bank_run(&c,0x30000000)
    assert(c.stop == Stop.Breakpoint && c.r[0] == 7 && c.pc == 0x30000002)
    assert(device_store(&c,0x30000000,2,0x2009))
    bank_run(&c,0x30000000)
    assert(c.stop == Stop.Breakpoint && c.r[0] == 9)
    var peer: Cpu
    attach_memory(&peer, mem)
    clear(&peer,0)
    peer.core = 1
    val before = watch(&c,0x30000020,4)
    assert(device_store(&peer,0x30000020,4,42))
    assert(others_stores(&c,0x30000020) == before + 1)
    assert(!device_store(&peer,0x24001000,4,1))
    reset(&c, mem, [], 0)
    assert(mem.extra_ram_count == 0 && !mem.ram_range(0x30000000,4) && mem.page_table[0x30000000 >> PAGE_SHIFT] == 0)

@test("a read-only RAM bank is read and executed in place, and every store to it, its edges included, goes to the bus")
ram_bank_read_only()
    for exec in [&run_match, &run_threaded]
        val mem = memory()
        var banks: Buf[RamBank] = buf()
        var c: Cpu
        c.kind = Kind.V8mMain
        banks.push(RamBank(0, 4096, 8192))
        banks.push(RamBank(0x30000000, 4096, 16384))
        // movs r0,7; bkpt — at the read-only bank's base, laid in the backing.
        var image: Buf[u8] = buf()
        for i in 0..<(8192 + 4) do image.push(0)
        for pair in [(8192usize, 0x07u8), (8193, 0x20), (8195, 0xBE)] do image.set(pair.0, pair.1)
        reset_mapped(&c, mem, image.view(), MemoryMap(0x24000000, 4096, 0x08000000, 0, banks.freeze()))
        read_only(mem, 0)
        read_only(mem, 0x12345000)
        assert(mem.read_only_banks == 1, "only a region's own base names it")
        assert(load32(&c, 0) == 0xBE002007 && mem.ram_range(0, 4) && !mem.ram_store_range(0, 4))
        assert(mem.ram_store_range(0x30000000, 4) && mem.ram_store_range(0x24000000, 4), "the other regions stay writable")
        assert(!mem.ram_store_range(4092, 8) && !mem.ram_store_range(4095, 1), "the last bytes of the read-only bank")
        c.pc = 0
        set_limit(&c, executed_cycles(&c, c.retired) + 1000)
        exec(&c)
        assert(c.stop == Stop.Breakpoint && c.r[0] == 7, "executed in place")
        for at in [0u32, 4094, 4095]
            c.stop = Stop.Running
            store8(&c, at, 0x55)
            assert(c.stop == Stop.Unmapped && c.stop_at == at, f"a store at 0x${at}%x reaches the bus, which has nothing")
        assert(load32(&c, 0) == 0xBE002007 && load8(&c, 4095) == 0)
        assert(!device_store(&c, 0, 4, 1) && device_store(&c, 0x30000000, 4, 1), "nor does a device write it")
        reset(&c, mem, [], 0)
        assert(mem.read_only_banks == 0, "a reset forgets it")

@test("RAM banks: an access inside a bank's page is on the fast path by the page table alone, at both ends, and leaves it when a board clears the page's entry")
ram_banks_fast_path()
    for exec in [&run_match, &run_threaded]
        val mem = memory()
        var banks: Buf[RamBank] = buf()
        var c: Cpu
        c.kind = Kind.V8mMain
        banks.push(RamBank(0x30000000, 8192, 8192))
        reset_mapped(&c, mem, [], MemoryMap(0x24000000, 4096, 0x08000000, 0, banks.freeze()))
        // Each end of the bank, and a word across its inner page boundary, are on the fast path.
        for a in [0x30000000u32, 0x30000FFC, 0x30001000, 0x30001FFC, 0x30000FFE]
            assert(page_for(&c, a, 4) != 0 && store_page(&c, a, 4) != 0, f"0x${a}%x")
        assert(page_for(&c, 0x30001FFF, 1) == page_of(&c, 0x30001000) && store_page(&c, 0x30001FFF, 1) != 0)
        // Past its last byte, and before its first, they are not.
        for a in [0x30001FFEu32, 0x30002000, 0x2FFFFFFC]
            assert(page_for(&c, a, 4) == 0 && store_page(&c, a, 4) == 0, f"0x${a}%x")
        assert(mem.code_offset(0x30000000) == 8192 && mem.code_offset(0x30001FFE) == 8192 + 8190 && mem.code_offset(0x30002000) == NO_CODE)
        // Main RAM: blx r3; bkpt. The bank: ldr r1, [r2]; str r1, [r4]; bx lr — reached by an indirect
        // branch, its load from the bank's last word and its store to its second page.
        for pair in [(0x24000000u32, 0x4798u32), (0x24000002, 0xBE00), (0x30000000, 0x6811), (0x30000002, 0x6021), (0x30000004, 0x4770)]
            store16(&c, pair.0, pair.1)
        store32(&c, 0x30001FFC, 0xC0DE1234)
        c.r[2] = 0x30001FFC
        c.r[3] = 0x30000001
        c.r[4] = 0x30001800
        c.pc = 0x24000000
        c.stop = Stop.Running
        set_limit(&c, executed_cycles(&c, c.retired) + 1000)
        exec(&c)
        assert(c.stop == Stop.Breakpoint && c.r[1] == 0xC0DE1234 && load32(&c, 0x30001800) == 0xC0DE1234, f"${c.stop} r1 0x${c.r[1]}%x")
        // A board takes the second page off the fast path (as XIP_SRAM's when a line is unpinned):
        // its accesses go to the bus, the first page's stay, and its code still has its records.
        mem.page_table[0x30001000 >> PAGE_SHIFT] = 0
        for a in [0x30001000u32, 0x30001FFC, 0x30000FFE]
            assert(page_for(&c, a, 4) == 0 && store_page(&c, a, 4) == 0, f"0x${a}%x after the clear")
        assert(page_for(&c, 0x30000FFC, 4) != 0 && store_page(&c, 0x30000FFC, 4) != 0)
        assert(mem.code_offset(0x30001000) == 8192 + 4096, "a cleared page's code is found by the region")
        c.pc = 0x24000000
        c.stop = Stop.Running
        set_limit(&c, executed_cycles(&c, c.retired) + 1000)
        exec(&c)
        assert(c.stop == Stop.Unmapped && c.stop_at == 0x30001FFC, f"${c.stop} at 0x${c.stop_at}%x: the load reaches the bus, which has nothing")

@test("RAM banks: threaded fall-through respects guest gaps and adjacent banks, including Thumb32 and per-core records")
ram_banks_code_boundaries()
    for adjacent in [false,true]
        for wide in [false,true]
            val mem = memory()
            var c: Cpu
            c.kind = Kind.V7em
            val base: u32 = if adjacent then 0x24001000 else 0x30000000
            var banks: Buf[RamBank] = buf()
            if !adjacent then banks.push(RamBank(base,4096,8192))
            reset_mapped(&c, mem, [], MemoryMap(0x24000000, if adjacent then 8192 else 4096, 0x08000000, 0, banks.freeze()))
            store16(&c,0x24000ffe,if wide then 0xf240 else 0xbf00)
            if wide
                store16(&c,base,0x0007)
                store16(&c,base + 2,0xbe00)
            else
                store16(&c,base,0x2007)
                store16(&c,base + 2,0xbe00)
            var peer: Cpu
            attach_memory(&peer, mem)
            clear(&peer,0)
            peer.core = 1
            peer.kind = Kind.V7em
            pair(&c,&peer)
            bank_run(&c,0x24000ffe)
            bank_run(&peer,0x24000ffe)
            if adjacent
                assert(c.stop == Stop.Breakpoint && peer.stop == Stop.Breakpoint && c.r[0] == 7 && peer.r[0] == 7)
            else
                if wide
                    assert(c.stop == Stop.Undefined && peer.stop == Stop.Undefined,"a truncated Thumb32 instruction remains undefined")
                else
                    assert(c.stop == Stop.Unmapped && peer.stop == Stop.Unmapped)
                    assert(c.stop_at == 0x24001000 && peer.stop_at == 0x24001000,"fall-through cannot jump across backing into another guest bank")
            unpair(&c,&peer)

@test("RAM banks: code decoded from a page a board takes off the cores' memory decodes again, so its fetch goes to the bus, on either core's records, run straight on into it or reached by a branch decoded before; put back, it runs the bytes there now")
ram_banks_fetch_changed()
    for exec in [&run_match, &run_threaded]
        val mem = memory()
        var banks: Buf[RamBank] = buf()
        var c: Cpu
        c.kind = Kind.V8mMain
        banks.push(RamBank(0x30000000, 8192, 8192))
        reset_mapped(&c, mem, [], MemoryMap(0x24000000, 4096, 0x08000000, 0, banks.freeze()))
        var peer: Cpu
        attach_memory(&peer, mem)
        clear(&peer, 0)
        peer.core = 1
        peer.kind = Kind.V8mMain
        peer.bus = &nothing_attached
        pair(&c, &peer)
        // b.w 0x30001000 at the bank's base; movs r2, #5; movs r3, #6 at the end of its first page,
        // running on into the second: movs r0, #7; bkpt.
        for hw in [(0x30000000u32, 0xF000u32), (0x30000002, 0xBFFE), (0x30000FFC, 0x2205), (0x30000FFE, 0x2306), (0x30001000, 0x2007), (0x30001002, 0xBE00)]
            store16(&c, hw.0, hw.1)
        val second = 8192 + 4096
        for phase in 0..<3
            if phase == 1
                // The board takes the second page off (an XIP_SRAM line unpinned).
                mem.page_table[0x30001000 >> PAGE_SHIFT] = 0
                fetch_changed(mem, 0x30001000, 4096)
            if phase == 2
                // And puts it back, holding movs r0, #9 now.
                mem.ram[second] = 9
                mem.page_table[0x30001000 >> PAGE_SHIFT] = usize(&mem.ram[second])
                fetch_changed(mem, 0x30001000, 4096)
            for core in [&c, &peer]
                for start in [0x30000000u32, 0x30000FFC]
                    for k in 0..<4 do core.r[k] = 0
                    core.pc = start
                    core.stop = Stop.Running
                    val before = core.retired
                    set_limit(core, executed_cycles(core, core.retired) + 1000)
                    exec(core)
                    val ran = f"core ${core.core} from 0x${start}%x in phase $phase: ${core.stop} at 0x${core.stop_at}%x, pc 0x${core.pc}%x, r0 ${core.r[0]}"
                    if phase == 1
                        assert(core.stop == Stop.Unmapped && core.stop_at == 0x30001000 && core.pc == 0x30001000 && core.r[0] == 0, ran)
                        assert(core.retired == before + (if start == 0x30000000 then 1 else 2), f"$ran: the branch, or the two moves, retired")
                    else
                        assert(core.stop == Stop.Breakpoint && core.r[0] == (if phase == 0 then 7 else 9), ran)
                    if start == 0x30000FFC then assert(core.r[2] == 5 && core.r[3] == 6, f"$ran: the first page's code ran")
        unpair(&c, &peer)

@test("a store another bus master makes (master_stored): code decoded from its bytes decodes again on both cores, in SRAM and in a bank, and it breaks both cores' exclusives on a watched line")
ram_master_stored()
    val mem = memory()
    var banks: Buf[RamBank] = buf()
    var c: Cpu
    c.kind = Kind.V8mMain
    banks.push(RamBank(0x30000000, 4096, 8192))
    reset_mapped(&c, mem, [], MemoryMap(0x24000000, 4096, 0x08000000, 0, banks.freeze()))
    var peer: Cpu
    attach_memory(&peer, mem)
    clear(&peer, 0)
    peer.core = 1
    peer.kind = Kind.V8mMain
    peer.bus = &nothing_attached
    pair(&c, &peer)
    for (base, at) in [(0x24000100u32, 0x100u32), (0x30000100, 8192 + 0x100)]
        // movs r0, #7; bkpt, run on both cores so that each decodes it.
        store16(&c, base, 0x2007)
        store16(&c, base + 2, 0xBE00)
        for core in [&c, &peer]
            bank_run(core, base)
            assert(core.stop == Stop.Breakpoint && core.r[0] == 7)
        // The other master writes movs r0, #9 into the bytes, past the cores' own store path.
        mem.ram[at] = 9
        master_stored(mem, base, 1)
        for core in [&c, &peer]
            bank_run(core, base)
            assert(core.stop == Stop.Breakpoint && core.r[0] == 9, f"core ${core.core} at 0x${base}%x: r0 ${core.r[0]}")
        // A load-exclusive's line: the store counts against each core.
        val mine = watch(&c, base + 0x40, 4)
        val theirs = watch(&peer, base + 0x40, 4)
        master_stored(mem, base + 0x40, 4)
        assert(others_stores(&c, base + 0x40) == mine + 1 && others_stores(&peer, base + 0x40) == theirs + 1)
    // An address in no RAM region is not the cores' memory: nothing to do.
    master_stored(mem, 0x40000000, 4)
    unpair(&c, &peer)
