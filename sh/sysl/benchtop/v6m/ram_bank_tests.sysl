module sh.sysl.benchtop.v6m
@tests

private bank_run(c: *Cpu, pc: u32)
    c.pc = pc
    c.stop = Stop.Budget
    set_limit(c,executed_cycles(c,c.retired) + 1000)
    run_threaded(c)

@test("RAM banks: data, device writes, exclusive tracking, code invalidation and reset reuse shared backing")
ram_banks_data()
    var c: Cpu
    c.kind = Kind.V7em
    reset_mapped(&c,[],0x24000000,4096,0x08000000,0,[RamBank(0x30000000,4096,8192)])
    store32(&c,0x24000020,0x12345678)
    store32(&c,0x30000020,0xaabbccdd)
    assert(load32(&c,0x24000020) == 0x12345678 && load32(&c,0x30000020) == 0xaabbccdd)
    assert(!ram_range(0x24001000,4) && !ram_range(0x30000fff,2))
    store16(&c,0x30000000,0x2007)
    store16(&c,0x30000002,0xbe00)
    bank_run(&c,0x30000000)
    assert(c.stop == Stop.Breakpoint && c.r[0] == 7 && c.pc == 0x30000002)
    assert(device_store(&c,0x30000000,2,0x2009))
    bank_run(&c,0x30000000)
    assert(c.stop == Stop.Breakpoint && c.r[0] == 9)
    var peer: Cpu
    clear(&peer,0)
    peer.core = 1
    val before = watch(&c,0x30000020,4)
    assert(device_store(&peer,0x30000020,4,42))
    assert(others_stores(&c,0x30000020) == before + 1)
    assert(!device_store(&peer,0x24001000,4,1))
    reset(&c,[],0)
    assert(extra_ram_count == 0 && !ram_range(0x30000000,4) && page_table[0x30000000 >> PAGE_SHIFT] == 0)

@test("RAM banks: threaded fall-through respects guest gaps and adjacent banks, including Thumb32 and per-core records")
ram_banks_code_boundaries()
    for adjacent in [false,true]
        for wide in [false,true]
            var c: Cpu
            c.kind = Kind.V7em
            val base: u32 = if adjacent then 0x24001000 else 0x30000000
            reset_mapped(&c,[],0x24000000,4096,0x08000000,0,[RamBank(base,4096,8192)])
            store16(&c,0x24000ffe,if wide then 0xf240 else 0xbf00)
            if wide
                store16(&c,base,0x0007)
                store16(&c,base + 2,0xbe00)
            else
                store16(&c,base,0x2007)
                store16(&c,base + 2,0xbe00)
            var peer: Cpu
            clear(&peer,0)
            peer.core = 1
            peer.kind = Kind.V7em
            pair(&c,&peer)
            bank_run(&c,0x24000ffe)
            bank_run(&peer,0x24000ffe)
            if adjacent
                assert(c.stop == Stop.Breakpoint && peer.stop == Stop.Breakpoint && c.r[0] == 7 && peer.r[0] == 7)
            else
                assert(c.stop == Stop.Unmapped && peer.stop == Stop.Unmapped)
                assert(c.stop_at == 0x24001000 && peer.stop_at == 0x24001000,"fall-through cannot jump across backing into another guest bank")
            unpair(&c,&peer)
