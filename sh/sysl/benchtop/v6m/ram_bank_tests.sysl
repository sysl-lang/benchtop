module sh.sysl.benchtop.v6m
@tests

import sysl.buf.{Buf, buf}

private bank_run(c: *Cpu, pc: u32)
    c.pc = pc
    c.stop = Stop.Running
    set_limit(c,executed_cycles(c,c.retired) + 1000)
    run_threaded(c)

@test("RAM banks: is_code, NO_CODE and the guard window name where code can be and where a run falls to")
ram_banks_code_offsets()
    val mem = memory()
    var banks: Buf[RamBank] = buf()
    var c: Cpu
    c.kind = Kind.V7em
    banks.push(RamBank(0x30000000,4096,8192))
    reset_mapped(&c, mem, [], MemoryMap(0x24000000, 4096, 0x08000000, 0, banks.freeze()))
    for a in [0x24000000u32, 0x24000FFE, 0x30000000, 0x30000FFE] do assert(mem.is_code(a) && mem.code_offset(a) != NO_CODE, f"0x${a}%x")
    for a in [0x23FFFFFEu32, 0x24000FFF, 0x24001000, 0x30001000, 0x08000000] do assert(!mem.is_code(a) && mem.code_offset(a) == NO_CODE, f"0x${a}%x")
    assert(mem.extra_ram_offset(0x40000000,4) == NO_RAM && mem.extra_ram_offset(0x30000010,4) == 8192 + 16)
    // The guard records after each bank answer the address a run falling off its end reaches.
    assert(GUARD_RECORDS * 2 == GUARD_BYTES)
    assert(mem.code_address(4096) == 0x24001000 && mem.code_address(4096 + GUARD_BYTES - 2) == 0x24001000 + GUARD_BYTES - 2)
    assert(mem.code_address(8192 + 4096) == 0x30001000 && mem.code_address(8192 + 4096 + GUARD_BYTES - 2) == 0x30001000 + GUARD_BYTES - 2)
    assert(mem.decoded[(8192 + 4096) >> 1].h == &h_ram_boundary && mem.decoded[(8192 + 4096) >> 1].imm == 0x30001000)

@test("RAM banks: data, device writes, exclusive tracking, code invalidation and reset reuse shared backing")
ram_banks_data()
    val mem = memory()
    var banks: Buf[RamBank] = buf()
    var c: Cpu
    c.kind = Kind.V7em
    banks.push(RamBank(0x30000000,4096,8192))
    reset_mapped(&c, mem, [], MemoryMap(0x24000000, 4096, 0x08000000, 0, banks.freeze()))
    store32(&c,0x24000020,0x12345678)
    store32(&c,0x30000020,0xaabbccdd)
    assert(load32(&c,0x24000020) == 0x12345678 && load32(&c,0x30000020) == 0xaabbccdd)
    assert(!mem.ram_range(0x24001000,4) && !mem.ram_range(0x30000fff,2))
    store16(&c,0x30000000,0x2007)
    store16(&c,0x30000002,0xbe00)
    bank_run(&c,0x30000000)
    assert(c.stop == Stop.Breakpoint && c.r[0] == 7 && c.pc == 0x30000002)
    assert(device_store(&c,0x30000000,2,0x2009))
    bank_run(&c,0x30000000)
    assert(c.stop == Stop.Breakpoint && c.r[0] == 9)
    var peer: Cpu
    attach_memory(&peer, mem)
    clear(&peer,0)
    peer.core = 1
    val before = watch(&c,0x30000020,4)
    assert(device_store(&peer,0x30000020,4,42))
    assert(others_stores(&c,0x30000020) == before + 1)
    assert(!device_store(&peer,0x24001000,4,1))
    reset(&c, mem, [], 0)
    assert(mem.extra_ram_count == 0 && !mem.ram_range(0x30000000,4) && mem.page_table[0x30000000 >> PAGE_SHIFT] == 0)

@test("a read-only RAM bank is read and executed in place, and every store to it, its edges included, goes to the bus")
ram_bank_read_only()
    for exec in [&run_match, &run_threaded]
        val mem = memory()
        var banks: Buf[RamBank] = buf()
        var c: Cpu
        c.kind = Kind.V8mMain
        banks.push(RamBank(0, 4096, 8192))
        banks.push(RamBank(0x30000000, 4096, 16384))
        // movs r0,7; bkpt — at the read-only bank's base, laid in the backing.
        var image: Buf[u8] = buf()
        for i in 0..<(8192 + 4) do image.push(0)
        for pair in [(8192usize, 0x07u8), (8193, 0x20), (8195, 0xBE)] do image.set(pair.0, pair.1)
        reset_mapped(&c, mem, image.view(), MemoryMap(0x24000000, 4096, 0x08000000, 0, banks.freeze()))
        read_only(mem, 0)
        read_only(mem, 0x12345000)
        assert(mem.read_only_banks == 1, "only a region's own base names it")
        assert(load32(&c, 0) == 0xBE002007 && mem.ram_range(0, 4) && !mem.ram_store_range(0, 4))
        assert(mem.ram_store_range(0x30000000, 4) && mem.ram_store_range(0x24000000, 4), "the other regions stay writable")
        assert(!mem.ram_store_range(4092, 8) && !mem.ram_store_range(4095, 1), "the last bytes of the read-only bank")
        c.pc = 0
        set_limit(&c, executed_cycles(&c, c.retired) + 1000)
        exec(&c)
        assert(c.stop == Stop.Breakpoint && c.r[0] == 7, "executed in place")
        for at in [0u32, 4094, 4095]
            c.stop = Stop.Running
            store8(&c, at, 0x55)
            assert(c.stop == Stop.Unmapped && c.stop_at == at, f"a store at 0x${at}%x reaches the bus, which has nothing")
        assert(load32(&c, 0) == 0xBE002007 && load8(&c, 4095) == 0)
        assert(!device_store(&c, 0, 4, 1) && device_store(&c, 0x30000000, 4, 1), "nor does a device write it")
        reset(&c, mem, [], 0)
        assert(mem.read_only_banks == 0, "a reset forgets it")

@test("RAM banks: threaded fall-through respects guest gaps and adjacent banks, including Thumb32 and per-core records")
ram_banks_code_boundaries()
    for adjacent in [false,true]
        for wide in [false,true]
            val mem = memory()
            var c: Cpu
            c.kind = Kind.V7em
            val base: u32 = if adjacent then 0x24001000 else 0x30000000
            var banks: Buf[RamBank] = buf()
            if !adjacent then banks.push(RamBank(base,4096,8192))
            reset_mapped(&c, mem, [], MemoryMap(0x24000000, if adjacent then 8192 else 4096, 0x08000000, 0, banks.freeze()))
            store16(&c,0x24000ffe,if wide then 0xf240 else 0xbf00)
            if wide
                store16(&c,base,0x0007)
                store16(&c,base + 2,0xbe00)
            else
                store16(&c,base,0x2007)
                store16(&c,base + 2,0xbe00)
            var peer: Cpu
            attach_memory(&peer, mem)
            clear(&peer,0)
            peer.core = 1
            peer.kind = Kind.V7em
            pair(&c,&peer)
            bank_run(&c,0x24000ffe)
            bank_run(&peer,0x24000ffe)
            if adjacent
                assert(c.stop == Stop.Breakpoint && peer.stop == Stop.Breakpoint && c.r[0] == 7 && peer.r[0] == 7)
            else
                if wide
                    assert(c.stop == Stop.Undefined && peer.stop == Stop.Undefined,"a truncated Thumb32 instruction remains undefined")
                else
                    assert(c.stop == Stop.Unmapped && peer.stop == Stop.Unmapped)
                    assert(c.stop_at == 0x24001000 && peer.stop_at == 0x24001000,"fall-through cannot jump across backing into another guest bank")
            unpair(&c,&peer)
