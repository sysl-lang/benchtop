module sh.sysl.benchtop.v6m
@tests

// One instruction at a time, against the ARMv6-M Architecture Reference Manual's description of
// each: the result, all four flags (including the ones an instruction must leave alone), memory, and
// the stack pointer. Every case runs under both executors, which must also agree with each other on
// every register, flag, count and memory word, so a case is a check on the decoder, the semantics
// and both ways of dispatching at once.
//
// Flags are written as a nibble, NZCV. N and Z cannot both be set by any result, so a starting state
// never has both.

// The window of guest memory compared between the executors: data at 0x1000, the stack below 0x2000
// and the SP-relative offsets above it.
const LOW: u32 = 0x1000
const HIGH: u32 = 0x2400

// Start with the flags `nzcv`.
set_flags(cpu: *Cpu, nzcv: u32)
    cpu.nz = if nzcv & 4 != 0 then 0 else if nzcv & 8 != 0 then 0x80000000 else 1
    cpu.c = (nzcv >> 1) & 1
    // An addition of two non-negative operands that came out negative: V set.
    cpu.va = 0
    cpu.vb = 0
    cpu.vr = (nzcv & 1) << 31

flags(cpu: *Cpu) -> u32
    val z: u32 = if flag_z(cpu) then 4 else 0

    (flag_n(cpu) << 3) | z | (cpu.c << 1) | flag_v(cpu)

// `code` at 0 with a `BKPT` after it; r0 upward from `regs`, SP at 0x2000, the flags `nzcv`, and each
// `[address, word]` of `mem` stored first.
prepare(cpu: *Cpu, code: []const u16, regs: []const u32, nzcv: u32, mem: [][2]u32)
    reset(cpu, [], 0)
    for i in 0..<code.len do store16(cpu, u32(i) * 2, code[i])
    store16(cpu, u32(code.len) * 2, 0xBE00)
    cpu.r[13] = 0x2000
    for i in 0..<regs.len do cpu.r[i] = regs[i]
    set_flags(cpu, nzcv)
    for m in mem do store32(cpu, m[0], m[1])

finish(cpu: *Cpu, exec: Exec)
    while cpu.stop == Stop.Budget && cpu.retired < 1000000
        cpu.limit = cpu.retired + 1000
        exec(cpu)

// Run the case under both executors, one after the other since they share guest memory, require
// them to agree on everything, and answer the threaded machine, whose memory is still in place.
execute(code: []const u16, regs: []const u32, nzcv: u32, mem: [][2]u32) -> Cpu
    var c: Cpu

    // Run the existing v6-M edge cases on all three models, leaving M0+'s memory in place.
    for kind in [Kind.M0, Kind.M1, Kind.V6m]
        c = execute_thumb2(kind, code, regs, nzcv, mem)

    c
end execute

// The one-instruction case gives `value` in `reg` and the flags `want`, at the breakpoint after it.
gives(code: []const u16, regs: []const u32, nzcv: u32, reg: u4, value: u32, want: u32) -> bool
    var c = execute(code, regs, nzcv, [])

    c.stop == Stop.Breakpoint && c.retired == 1 && c.r[reg] == value && flags(&c) == want

// ---------------------------------------------------------------------------------------------------
// Arithmetic: every flag, at the edges where each one changes.

@test("ADDS and SUBS with a 3-bit immediate")
ins_add_sub_imm3()
    // adds r0, r1, #7
    assert(gives([0x1DC8], [0, 0xFFFFFFF9], 0, 0, 0, 0b0110), "ADDS: carry out to zero")
    assert(gives([0x1DC8], [0, 0x7FFFFFFA], 0, 0, 0x80000001, 0b1001), "ADDS: signed overflow")
    assert(gives([0x1DC8], [0, 1], 0b1011, 0, 8, 0b0000), "ADDS: clears what it does not set")
    // subs r0, r1, #7
    assert(gives([0x1FC8], [0, 7], 0, 0, 0, 0b0110), "SUBS: equal is zero, no borrow")
    assert(gives([0x1FC8], [0, 0], 0, 0, 0xFFFFFFF9, 0b1000), "SUBS: borrow clears C")
    assert(gives([0x1FC8], [0, 0x80000006], 0, 0, 0x7FFFFFFF, 0b0011), "SUBS: overflow from the negative edge")

@test("ADDS, SUBS, MOVS and CMP with an 8-bit immediate")
ins_imm8()
    // adds r0, #255
    assert(gives([0x30FF], [0xFFFFFF01], 0, 0, 0, 0b0110), "ADDS: carry out to zero")
    assert(gives([0x30FF], [0x7FFFFF01], 0, 0, 0x80000000, 0b1001), "ADDS: overflow")
    // subs r0, #255
    assert(gives([0x38FF], [255], 0, 0, 0, 0b0110), "SUBS: to zero")
    assert(gives([0x38FF], [254], 0, 0, 0xFFFFFFFF, 0b1000), "SUBS: borrow")
    // movs r0, #0 and #255: N and Z only, C and V kept
    assert(gives([0x2000], [5], 0b0011, 0, 0, 0b0111), "MOVS #0 keeps C and V")
    assert(gives([0x20FF], [5], 0b1011, 0, 255, 0b0011), "MOVS #255 clears N")
    // cmp r0, #255: flags only
    assert(gives([0x28FF], [255], 0, 0, 255, 0b0110), "CMP: equal")
    assert(gives([0x28FF], [0], 0, 0, 0, 0b1000), "CMP: below")
    assert(gives([0x28FF], [0x80000000], 0, 0, 0x80000000, 0b0011), "CMP: overflow")

@test("CMP and CMN on registers, low and high")
ins_cmp_cmn()
    // cmp r0, r1
    assert(gives([0x4288], [1, 2], 0, 0, 1, 0b1000), "CMP: 1 - 2 borrows")
    assert(gives([0x4288], [0x80000000, 1], 0, 0, 0x80000000, 0b0011), "CMP: overflow")
    assert(gives([0x4288], [0xFFFFFFFF, 0xFFFFFFFF], 0, 1, 0xFFFFFFFF, 0b0110), "CMP: equal")
    // cmn r0, r1
    assert(gives([0x42C8], [0xFFFFFFFF, 1], 0, 0, 0xFFFFFFFF, 0b0110), "CMN: carry out to zero")
    assert(gives([0x42C8], [0x7FFFFFFF, 1], 0, 0, 0x7FFFFFFF, 0b1001), "CMN: overflow")
    assert(gives([0x42C8], [0x80000000, 0x80000000], 0, 0, 0x80000000, 0b0111), "CMN: both")
    // cmp r8, r0
    assert(gives([0x4580], [5, 0, 0, 0, 0, 0, 0, 0, 5], 0, 8, 5, 0b0110), "CMP r8: equal")
    assert(gives([0x4580], [6, 0, 0, 0, 0, 0, 0, 0, 5], 0, 8, 5, 0b1000), "CMP r8: below")

@test("NEGS: zero has no borrow, and the most negative number overflows")
ins_negs()
    // negs r0, r1
    assert(gives([0x4248], [9, 0], 0, 0, 0, 0b0110), "0")
    assert(gives([0x4248], [9, 1], 0, 0, 0xFFFFFFFF, 0b1000), "1")
    assert(gives([0x4248], [9, 0x80000000], 0, 0, 0x80000000, 0b1001), "0x80000000")
    assert(gives([0x4248], [9, 0xFFFFFFFF], 0, 0, 1, 0b0000), "-1")

@test("ADCS and SBCS at the overflow edges")
ins_adc_sbc_overflow()
    // adcs r0, r1: the carry in tips 0x7FFFFFFF over
    assert(gives([0x4148], [0x7FFFFFFF, 0], 0b0010, 0, 0x80000000, 0b1001), "ADCS")
    // sbcs r0, r1: no carry in is a borrow of one
    assert(gives([0x4188], [0x80000000, 0], 0, 0, 0x7FFFFFFF, 0b0011), "SBCS")
    assert(gives([0x4188], [0, 0], 0, 0, 0xFFFFFFFF, 0b1000), "SBCS 0 - 0 - 1")

@test("MULS: the low word, N and Z from it, C and V kept")
ins_muls()
    // muls r0, r1, r0
    assert(gives([0x4348], [7, 6], 0b0011, 0, 42, 0b0011), "7 * 6")
    assert(gives([0x4348], [0x10000, 0x10000], 0b0011, 0, 0, 0b0111), "wraps to zero")
    assert(gives([0x4348], [0xFFFFFFFF, 3], 0b0000, 0, 0xFFFFFFFD, 0b1000), "-1 * 3")
    assert(gives([0x4348], [0x80000001, 0x80000001], 0b0010, 0, 1, 0b0010), "the high word is dropped")

// ---------------------------------------------------------------------------------------------------
// Logical: N and Z from the result; C and V are never touched.

@test("ANDS, EORS, ORRS, BICS, MVNS and TST keep C and V")
ins_logical()
    // ands r0, r1
    assert(gives([0x4008], [0xF0F0F0F0, 0x0FF00FF0], 0b0011, 0, 0x00F000F0, 0b0011), "ANDS")
    assert(gives([0x4008], [1, 2], 0b0011, 0, 0, 0b0111), "ANDS to zero")
    assert(gives([0x4008], [0x80000000, 0x80000001], 0, 0, 0x80000000, 0b1000), "ANDS negative")
    // eors r0, r1
    assert(gives([0x4048], [0xDEADBEEF, 0xDEADBEEF], 0b0011, 0, 0, 0b0111), "EORS to zero")
    assert(gives([0x4048], [0x80000000, 0x00000001], 0b0010, 0, 0x80000001, 0b1010), "EORS negative")
    // orrs r0, r1
    assert(gives([0x4308], [0, 0], 0b0001, 0, 0, 0b0101), "ORRS zero")
    assert(gives([0x4308], [0x80000000, 1], 0b0011, 0, 0x80000001, 0b1011), "ORRS")
    // bics r0, r1
    assert(gives([0x4388], [0xFFFFFFFF, 0xFFFFFFFF], 0b0011, 0, 0, 0b0111), "BICS everything")
    assert(gives([0x4388], [0xFFFFFFFF, 0x7FFFFFFF], 0, 0, 0x80000000, 0b1000), "BICS all but the top")
    // mvns r0, r1
    assert(gives([0x43C8], [5, 0xFFFFFFFF], 0b0011, 0, 0, 0b0111), "MVNS to zero")
    assert(gives([0x43C8], [5, 0], 0b0010, 0, 0xFFFFFFFF, 0b1010), "MVNS of zero")
    // tst r0, r1: r0 unchanged
    assert(gives([0x4208], [1, 2], 0b0011, 0, 1, 0b0111), "TST: no bits in common")
    assert(gives([0x4208], [0x80000000, 0x80000000], 0b0001, 0, 0x80000000, 0b1001), "TST: the top bit")

// ---------------------------------------------------------------------------------------------------
// Shifts by an immediate: C is the last bit shifted out, V is kept.

@test("LSLS, LSRS and ASRS by 1 and by 31")
ins_shift_imm()
    // lsls r0, r1, #1 and #31
    assert(gives([0x0048], [0, 0x80000001], 0b0001, 0, 2, 0b0011), "LSLS #1 shifts the top bit into C")
    assert(gives([0x07C8], [0, 3], 0b0001, 0, 0x80000000, 0b1011), "LSLS #31")
    assert(gives([0x07C8], [0, 2], 0b0000, 0, 0, 0b0110), "LSLS #31 to zero, C from bit 1")
    // lsrs r0, r1, #1 and #31
    assert(gives([0x0848], [0, 3], 0b0001, 0, 1, 0b0011), "LSRS #1")
    assert(gives([0x0FC8], [0, 0x80000000], 0b0011, 0, 1, 0b0001), "LSRS #31, C from bit 30")
    assert(gives([0x0FC8], [0, 0x40000000], 0b0000, 0, 0, 0b0110), "LSRS #31 to zero")
    // asrs r0, r1, #1 and #31
    assert(gives([0x1048], [0, 0x80000001], 0b0001, 0, 0xC0000000, 0b1011), "ASRS #1 keeps the sign")
    assert(gives([0x17C8], [0, 0x40000000], 0b0000, 0, 0, 0b0110), "ASRS #31 of a positive")
    assert(gives([0x17C8], [0, 0x80000000], 0b0011, 0, 0xFFFFFFFF, 0b1001), "ASRS #31 of a negative")

// ---------------------------------------------------------------------------------------------------
// No flags at all.

@test("SXTH, SXTB, UXTH, UXTB and the reversals leave every flag alone")
ins_extend()
    // sxth r0, r1
    assert(gives([0xB208], [0, 0x12348000], 0b1011, 0, 0xFFFF8000, 0b1011), "SXTH negative")
    assert(gives([0xB208], [0, 0xFFFF7FFF], 0b0100, 0, 0x7FFF, 0b0100), "SXTH positive")
    // sxtb r0, r1
    assert(gives([0xB248], [0, 0x1234567F], 0b0000, 0, 0x7F, 0b0000), "SXTB positive")
    assert(gives([0xB248], [0, 0x12345680], 0b0110, 0, 0xFFFFFF80, 0b0110), "SXTB negative")
    // uxth r0, r1 and uxtb r0, r1
    assert(gives([0xB288], [0, 0xFFFF8001], 0b1001, 0, 0x8001, 0b1001), "UXTH")
    assert(gives([0xB2C8], [0, 0xFFFFFF80], 0b0010, 0, 0x80, 0b0010), "UXTB")
    // rev, rev16, revsh r0, r1
    assert(gives([0xBA08], [0, 0x11223344], 0b0111, 0, 0x44332211, 0b0111), "REV")
    assert(gives([0xBA48], [0, 0x11223344], 0b1010, 0, 0x22114433, 0b1010), "REV16")
    assert(gives([0xBAC8], [0, 0x0000FF7F], 0b0001, 0, 0x7FFF, 0b0001), "REVSH positive")

@test("ADD and MOV on high registers, and CMP's partner forms, leave every flag alone")
ins_high()
    // add r8, r0 wraps
    assert(gives([0x4480], [5, 0, 0, 0, 0, 0, 0, 0, 0xFFFFFFFE], 0b1011, 8, 3, 0b1011), "ADD r8, r0")
    // add r0, r9
    assert(gives([0x4448], [1, 0, 0, 0, 0, 0, 0, 0, 0, 2], 0b0110, 0, 3, 0b0110), "ADD r0, r9")
    // add sp, r0
    assert(gives([0x4485], [0x10], 0, 13, 0x2010, 0), "ADD sp, r0")
    // mov r8, r1 and mov r0, r8
    assert(gives([0x4688], [0, 7], 0b1001, 8, 7, 0b1001), "MOV r8, r1")
    assert(gives([0x4640], [0, 0, 0, 0, 0, 0, 0, 0, 9], 0b0100, 0, 9, 0b0100), "MOV r0, r8")
    // mov sp, r0
    assert(gives([0x4685], [0x1800], 0, 13, 0x1800, 0), "MOV sp, r0")

@test("the PC read as an operand is the instruction's address plus 4")
ins_pc_operand()
    // add r0, pc at 0: r0 + 4
    assert(gives([0x4478], [1], 0b0011, 0, 5, 0b0011), "ADD r0, pc")

    // nop; mov r0, pc at 2: 6
    var c = execute([0xBF00, 0x4678], [], 0, [])

    assert(c.r[0] == 6 && c.retired == 2, "MOV r0, pc")

@test("SP-relative arithmetic, ADR and LDR (literal), at both alignments of the PC")
ins_pc_sp_relative()
    // add r0, sp, #8 and #1020
    assert(gives([0xA802], [], 0, 0, 0x2008, 0), "ADD r0, sp, #8")
    assert(gives([0xA8FF], [], 0, 0, 0x23FC, 0), "ADD r0, sp, #1020")
    // add sp, #16 / #508 and sub sp, #16 / #508
    assert(gives([0xB004], [], 0, 13, 0x2010, 0), "ADD sp, #16")
    assert(gives([0xB07F], [], 0, 13, 0x21FC, 0), "ADD sp, #508")
    assert(gives([0xB084], [], 0, 13, 0x1FF0, 0), "SUB sp, #16")
    assert(gives([0xB0FF], [], 0, 13, 0x1E04, 0), "SUB sp, #508")

    // adr r0, #8 at 0 and at 2: Align(PC + 4, 4) + 8 is 12 from both
    assert(gives([0xA002], [], 0, 0, 12, 0), "ADR at a word boundary")

    var c = execute([0xBF00, 0xA002], [], 0, [])

    assert(c.r[0] == 12, "ADR at a halfword boundary")

    // ldr r0, [pc, #4] at 0 and at 2 both read the word at 8
    c = execute([0x4801, 0xBE00, 0xBE00, 0xBE00, 0x5678, 0x1234], [], 0, [])
    assert(c.r[0] == 0x12345678 && c.retired == 1, "LDR (literal) at a word boundary")
    c = execute([0xBF00, 0x4801, 0xBE00, 0xBE00, 0x5678, 0x1234], [], 0, [])
    assert(c.r[0] == 0x12345678 && c.retired == 2, "LDR (literal) at a halfword boundary")

// ---------------------------------------------------------------------------------------------------
// Loads and stores.

// The one-instruction case loads `value` into r0, from r1 = 0x1000 and r2 = `offset`, with the
// word `word` at 0x1004.
loads(code: u16, offset: u32, word: u32, value: u32) -> bool
    var c = execute([code], [0, 0x1000, offset], 0b1011, [[0x1004, word]])

    c.stop == Stop.Breakpoint && c.r[0] == value && flags(&c) == 0b1011

// The one-instruction case stores r0 = 0xAABBCCDD at r1 = 0x1000 plus r2 = `offset`, over the word
// 0x11223344 at 0x1004, which then reads `word`.
stores(code: u16, offset: u32, word: u32) -> bool
    var c = execute([code], [0xAABBCCDD, 0x1000, offset], 0, [[0x1004, 0x11223344]])

    c.stop == Stop.Breakpoint && load32(&c, 0x1004) == word && c.r[0] == 0xAABBCCDD

@test("loads with a register offset: widths, sign extension and each byte lane")
ins_load_reg()
    // ldr, ldrh, ldrsh, ldrb, ldrsb r0, [r1, r2]
    assert(loads(0x5888, 4, 0xF1F28384, 0xF1F28384), "LDR")
    assert(loads(0x5A88, 4, 0xF1F28384, 0x8384), "LDRH low half")
    assert(loads(0x5A88, 6, 0xF1F28384, 0xF1F2), "LDRH high half")
    assert(loads(0x5E88, 4, 0xF1F28384, 0xFFFF8384), "LDRSH negative")
    assert(loads(0x5E88, 6, 0x01027F03, 0x0102), "LDRSH positive")
    assert(loads(0x5C88, 4, 0xF1F28384, 0x84), "LDRB lane 0")
    assert(loads(0x5C88, 7, 0xF1F28384, 0xF1), "LDRB lane 3")
    assert(loads(0x5688, 4, 0xF1F28384, 0xFFFFFF84), "LDRSB negative")
    assert(loads(0x5688, 5, 0x01027F03, 0x7F), "LDRSB positive")

@test("stores with a register offset write only their own bytes")
ins_store_reg()
    // str, strh, strb r0, [r1, r2]
    assert(stores(0x5088, 4, 0xAABBCCDD), "STR")
    assert(stores(0x5288, 4, 0x1122CCDD), "STRH low half")
    assert(stores(0x5288, 6, 0xCCDD3344), "STRH high half")
    assert(stores(0x5488, 4, 0x112233DD), "STRB lane 0")
    assert(stores(0x5488, 5, 0x1122DD44), "STRB lane 1")
    assert(stores(0x5488, 7, 0xDD223344), "STRB lane 3")

@test("loads and stores with an immediate offset, scaled by the width, to the largest offset")
ins_imm_offset()
    var c = execute([0x6848], [0, 0x1000], 0, [[0x1004, 0xCAFEF00D]])

    assert(c.r[0] == 0xCAFEF00D, "LDR r0, [r1, #4]")
    c = execute([0x6FC8], [0, 0x1000], 0, [[0x107C, 0x600DF00D]])
    assert(c.r[0] == 0x600DF00D, "LDR r0, [r1, #124]")
    c = execute([0x6048], [0x12345678, 0x1000], 0, [])
    assert(load32(&c, 0x1004) == 0x12345678, "STR r0, [r1, #4]")
    c = execute([0x7848], [0, 0x1000], 0, [[0x1000, 0x44332211]])
    assert(c.r[0] == 0x22, "LDRB r0, [r1, #1]")
    c = execute([0x7FC8], [0, 0x1000], 0, [[0x101C, 0x99887766]])
    assert(c.r[0] == 0x99, "LDRB r0, [r1, #31]")
    c = execute([0x7048], [0xFFFFFFAB, 0x1000], 0, [[0x1000, 0x44332211]])
    assert(load32(&c, 0x1000) == 0x4433AB11, "STRB r0, [r1, #1]")
    c = execute([0x8848], [0, 0x1000], 0, [[0x1000, 0x8899AABB]])
    assert(c.r[0] == 0x8899, "LDRH r0, [r1, #2]")
    c = execute([0x8FC8], [0, 0x1000], 0, [[0x103C, 0x5566EEFF]])
    assert(c.r[0] == 0x5566, "LDRH r0, [r1, #62]")
    c = execute([0x8048], [0xFFFF1234, 0x1000], 0, [[0x1000, 0x8899AABB]])
    assert(load32(&c, 0x1000) == 0x1234AABB, "STRH r0, [r1, #2]")
    // str r0, [sp, #8]; ldr r1, [sp, #1020]
    c = execute([0x9002], [0x0BADCAFE], 0, [])
    assert(load32(&c, 0x2008) == 0x0BADCAFE, "STR r0, [sp, #8]")
    c = execute([0x99FF], [], 0, [[0x23FC, 0x5EED5EED]])
    assert(c.r[1] == 0x5EED5EED, "LDR r1, [sp, #1020]")

@test("PUSH and POP: the lowest register at the lowest address, and SP moved by the count")
ins_push_pop()
    // push {r0, r4, lr}
    var regs: [15]u32 = [0; 15]

    regs[0] = 1
    regs[4] = 4
    regs[13] = 0x2000
    regs[14] = 0xE

    var c = execute([0xB511], regs, 0, [])

    assert(c.r[13] == 0x1FF4, "SP down by three words")
    assert(load32(&c, 0x1FF4) == 1 && load32(&c, 0x1FF8) == 4 && load32(&c, 0x1FFC) == 0xE, "in order")

    // pop {r1, r2}
    c = execute([0xBC06], [], 0, [[0x2000, 0xA], [0x2004, 0xB]])
    assert(c.r[1] == 0xA && c.r[2] == 0xB && c.r[13] == 0x2008, "POP {r1, r2}")

@test("STM and LDM: writeback, and a base in an LDM's list is loaded rather than written back")
ins_stm_ldm()
    // stm r0!, {r1, r2}
    var c = execute([0xC006], [0x1000, 0xA, 0xB], 0, [])

    assert(load32(&c, 0x1000) == 0xA && load32(&c, 0x1004) == 0xB && c.r[0] == 0x1008, "STM writes back")
    // stm r0!, {r0, r1}: the base is the lowest, so its original value is stored
    c = execute([0xC003], [0x1000, 5], 0, [])
    assert(load32(&c, 0x1000) == 0x1000 && load32(&c, 0x1004) == 5 && c.r[0] == 0x1008, "STM base lowest")
    // ldm r0!, {r1, r2}
    c = execute([0xC806], [0x1000], 0, [[0x1000, 0x11], [0x1004, 0x22]])
    assert(c.r[1] == 0x11 && c.r[2] == 0x22 && c.r[0] == 0x1008, "LDM writes back")
    // ldm r0, {r0, r1}
    c = execute([0xC803], [0x1000], 0, [[0x1000, 0x55], [0x1004, 0x66]])
    assert(c.r[0] == 0x55 && c.r[1] == 0x66, "LDM with the base in the list")

// ---------------------------------------------------------------------------------------------------
// Control flow.

@test("B, BL forward and backward, BX, BLX, MOV pc and POP {pc}")
ins_branches()
    // 0: b 4; 2: movs r0, #1; 4: movs r1, #2
    var c = execute([0xE000, 0x2001, 0x2102], [], 0, [])

    assert(c.r[0] == 0 && c.r[1] == 2 && c.retired == 2, "B forward")

    // 0: bl 8; 4: bkpt; 6: bkpt; 8: movs r0, #7
    c = execute([0xF000, 0xF802, 0xBE00, 0xBE00, 0x2007], [], 0, [])
    assert(c.r[0] == 7 && c.r[14] == 5 && c.retired == 2, "BL forward sets LR to the next instruction, Thumb")

    // 0: adds r0, #1; 2: cmp r0, #2; 4: beq 10; 6: bl 0; 10: bkpt
    c = execute([0x3001, 0x2802, 0xD001, 0xF7FF, 0xFFFB], [], 0, [])
    assert(c.r[0] == 2 && c.r[14] == 11 && c.retired == 7, "BL backward")

    // 0: bx r1 (r1 = 9); 2: movs r0, #1; 4: bkpt; 6: bkpt; 8: movs r0, #2
    c = execute([0x4708, 0x2001, 0xBE00, 0xBE00, 0x2002], [0, 9], 0, [])
    assert(c.r[0] == 2 && c.retired == 2, "BX")

    // 0: blx r1
    c = execute([0x4788, 0x2001, 0xBE00, 0xBE00, 0x2002], [0, 9], 0, [])
    assert(c.r[0] == 2 && c.r[14] == 3, "BLX sets LR")

    // 0: mov pc, r1 (r1 = 8)
    c = execute([0x468F, 0x2001, 0xBE00, 0xBE00, 0x2002], [0, 8], 0, [])
    assert(c.r[0] == 2 && c.retired == 2, "MOV pc, r1")

    // 0: pop {r0, pc}; 2: movs r1, #1; 4: bkpt; 6: movs r2, #2
    c = execute([0xBD01, 0x2101, 0xBE00, 0x2202], [], 0, [[0x2000, 0x77], [0x2004, 7]])
    assert(c.r[0] == 0x77 && c.r[1] == 0 && c.r[2] == 2 && c.r[13] == 0x2008, "POP {r0, pc}")

@test("BX, BLX, MOV pc and POP {pc} off the RAM stop the core at Unmapped, at the address jumped to")
ins_branches_off_ram()
    // 0: bx r1; 0: blx r1; 0: mov pc, r1
    for code in [0x4708u16, 0x4788, 0x468F]
        for to in [RAM_BYTES, 0x00200001u32, 0xFFFFFFFF]
            val c = execute([code, 0x2001, 0xBE00], [0, to], 0, [])

            assert(c.stop == Stop.Unmapped && c.stop_at == to & ~1 && c.r[0] == 0, f"${code}%04x to 0x${to}%08x")
            assert(c.pc == to & ~1 && c.retired == 1, f"${code}%04x: pc 0x${c.pc}%08x, ${c.retired} retired")

    // 0: pop {pc}, popping 0x0030_0001
    var c = execute([0xBD00, 0x2001, 0xBE00], [], 0, [[0x2000, 0x00300001]])

    assert(c.stop == Stop.Unmapped && c.stop_at == 0x00300000 && c.r[0] == 0, "POP {pc}")
    assert(c.pc == 0x00300000 && c.retired == 1 && c.r[13] == 0x2004, "POP {pc}: pc at the target, SP past it")

    // Falling off the end: 0: bx r1, to the last halfword of RAM, movs r0, #3
    c = execute([0x4708], [0, RAM_BYTES - 1], 0, [[RAM_BYTES - 4, 0x20030000]])
    assert(c.stop == Stop.Unmapped && c.stop_at == RAM_BYTES && c.pc == RAM_BYTES, f"0x${c.pc}%08x")
    assert(c.r[0] == 3 && c.retired == 2, "the last instruction ran")

@test("B, BL and B<cond> off the RAM, alone or fused with a compare, stop the core at their exact target")
ins_direct_branches_off_ram()
    // 0: b to 0 + 4 - 8, which wraps to 0xFFFFFFFC
    var c = execute([0xE7FC, 0x2001], [], 0, [])

    assert(c.stop == Stop.Unmapped && c.stop_at == 0xFFFFFFFC && c.pc == 0xFFFFFFFC, f"B: 0x${c.stop_at}%08x")
    assert(c.retired == 1 && c.r[0] == 0, "B retired, nothing after it")

    // 0: bl 0x0020_0000
    c = execute([0xF1FF, 0xFFFE, 0x2001], [], 0, [])
    assert(c.stop == Stop.Unmapped && c.stop_at == 0x00200000 && c.pc == 0x00200000, f"BL: 0x${c.stop_at}%08x")
    assert(c.retired == 1 && c.r[14] == 5 && c.r[0] == 0, "BL set LR")

    // 0: beq to 0xFFFFFFFC; 2: movs r0, #1. Taken with Z set, and falling through without.
    c = execute([0xD0FC, 0x2001], [], 0b0100, [])
    assert(c.stop == Stop.Unmapped && c.stop_at == 0xFFFFFFFC && c.pc == 0xFFFFFFFC && c.retired == 1, "BEQ taken")
    c = execute([0xD0FC, 0x2001], [], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 1 && c.retired == 2, "BEQ not taken")

    // 0: cmp r0, #0; 2: beq to 2 + 4 - 10. The threaded executor would fuse the pair.
    c = execute([0x2800, 0xD0FB, 0x2001], [0], 0, [])
    assert(c.stop == Stop.Unmapped && c.stop_at == 0xFFFFFFFC && c.pc == 0xFFFFFFFC && c.retired == 2, "CMP, BEQ taken")
    c = execute([0x2800, 0xD0FB, 0x2001], [1], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 1 && c.retired == 3, "CMP, BEQ not taken")

// 0: movs r0, #1; 2: `code`; 4: movs r0, #2; with `regs`, run to its stop.
around(code: u16, regs: []const u32, mem: [][2]u32) -> Cpu = execute([0x2001, code, 0x2002], regs, 0, mem)

// The core stopped at Unmapped on `at`, at the instruction at 2, which did not retire, and nothing
// after it ran.
stopped_at_2(c: *Cpu, at: u32) -> bool = c.stop == Stop.Unmapped && c.stop_at == at && c.pc == 2 && c.retired == 1 && c.r[0] == 1

@test("a load or a store where nothing is stops the core on it, before it takes effect and before what follows")
ins_access_unmapped()
    // r1 = 0x4000_0000, r2 = 0, r3 = 0x5A: ldr, ldrh, ldrb r3, [r1]; ldr, ldrh, ldrb, ldrsb, ldrsh
    // r3, [r1, r2]; ldr r3, [pc, #0] is never off the RAM. The stores of each width, both ways.
    val codes: [14]u16 = [0x680B, 0x880B, 0x780B, 0x588B, 0x5A8B, 0x5C8B, 0x568B, 0x5E8B, 0x600B, 0x800B, 0x700B, 0x508B, 0x528B, 0x548B]

    for code in codes
        var c = around(code, [0, 0x40000000, 0, 0x5A], [])

        assert(stopped_at_2(&c, 0x40000000) && c.r[3] == 0x5A, f"${code}%04x: pc 0x${c.pc}%x, ${c.retired} retired")

    // ldm r1!, {r3, r4} and stm r1!, {r3, r4}: no register written, no writeback
    for code in [0xC918u16, 0xC118]
        var c = around(code, [0, 0x40000000, 0, 0x5A, 0x5B], [])

        assert(stopped_at_2(&c, 0x40000000) && c.r[1] == 0x40000000 && c.r[3] == 0x5A && c.r[4] == 0x5B, f"${code}%04x")

    // push {r3, r4}, pop {r3, r4}, pop {pc} and pop {r3, pc}, with SP at 0x4000_0010: SP kept
    var regs: [14]u32 = [0; 14]

    regs[3] = 0x5A
    regs[4] = 0x5B
    regs[13] = 0x40000010

    val stack: [4][2]u32 = [[0xB418, 0x40000008], [0xBC18, 0x40000010], [0xBD00, 0x40000010], [0xBD08, 0x40000010]]

    for s in stack
        var c = around(u16(s[0]), regs[..], [])

        assert(stopped_at_2(&c, s[1]) && c.r[13] == 0x40000010 && c.r[3] == 0x5A && c.r[4] == 0x5B, f"${s[0]}%04x")

@test("a transfer of several words that runs off the RAM part-way stops on it, its base and SP as they were")
ins_access_part_unmapped()
    val last = RAM_BYTES - 4

    // ldm r1!, {r3, r4}: r3's word is the last of RAM, r4's is past it. The architecture leaves r3
    // UNKNOWN; benchtop has loaded it.
    var c = around(0xC918, [0, last, 0, 0x5A, 0x5B], [[last, 0x77]])

    assert(stopped_at_2(&c, RAM_BYTES) && c.r[1] == last && c.r[3] == 0x77 && c.r[4] == 0x5B, "LDM")

    // ldm r1, {r1, r4}: the base is loaded first, and restored
    c = around(0xC912, [0, last, 0, 0x5A, 0x5B], [[last, 0x77]])
    assert(stopped_at_2(&c, RAM_BYTES) && c.r[1] == last && c.r[4] == 0x5B, "LDM, the base in the list")

    // stm r1!, {r3, r4}: r3's word is stored, as the hardware would have stored it; no writeback
    c = around(0xC118, [0, last, 0, 0x5A, 0x5B], [])
    assert(stopped_at_2(&c, RAM_BYTES) && c.r[1] == last && load32(&c, last) == 0x5A, "STM")

    // pop {r3, r4} and push {r3, r4} across the end of RAM, and push below address 0
    var regs: [14]u32 = [0; 14]

    regs[3] = 0x5A
    regs[4] = 0x5B
    regs[13] = last
    c = around(0xBC18, regs[..], [[last, 0x77]])
    assert(stopped_at_2(&c, RAM_BYTES) && c.r[13] == last && c.r[4] == 0x5B, "POP")

    regs[13] = RAM_BYTES + 4
    c = around(0xB418, regs[..], [])
    assert(stopped_at_2(&c, RAM_BYTES) && c.r[13] == RAM_BYTES + 4 && load32(&c, last) == 0x5A, "PUSH")

    regs[13] = 4
    c = around(0xB418, regs[..], [])
    assert(stopped_at_2(&c, 0xFFFFFFFC) && c.r[13] == 4, "PUSH below address 0")

// Whether `cond` holds for the flags `nzcv`, as the architecture's table defines it.
condition_holds(cond: u32, nzcv: u32) -> bool
    val n = (nzcv >> 3) & 1 == 1
    val z = (nzcv >> 2) & 1 == 1
    val c = (nzcv >> 1) & 1 == 1
    val v = nzcv & 1 == 1

    cond match
        0 -> z
        1 -> !z
        2 -> c
        3 -> !c
        4 -> n
        5 -> !n
        6 -> v
        7 -> !v
        8 -> c && !z
        9 -> !c || z
        10 -> n == v
        11 -> n != v
        12 -> !z && n == v
        _ -> z || n != v

@test("every conditional branch on its own, against every reachable flag state")
ins_conditions()
    for cond in 0u32..<14
        for nzcv in 0u32..<16
            if nzcv & 0b1100 == 0b1100 then continue

            // 0: b<cond> 4; 2: mov r2, r8 (r8 = 1, and no flags); 4: bkpt
            var c = execute([u16(0xD000 | (cond << 8)), 0x4642], [0, 0, 0, 0, 0, 0, 0, 0, 1], nzcv, [])

            if condition_holds(cond, nzcv)
                assert(c.r[2] == 0 && c.retired == 1, s"condition $cond taken on flags $nzcv")
            else
                assert(c.r[2] == 1 && c.retired == 2, s"condition $cond not taken on flags $nzcv")

            assert(flags(&c) == nzcv, s"condition $cond leaves the flags")

@test("hints and barriers retire and do nothing, CPS only sets PRIMASK; BKPT and an undefined encoding stop where they are")
ins_system()
    // nop; yield; wfe; sev; cpsid i; dsb; dmb; isb; movs r0, #1
    var c = execute([0xBF00, 0xBF10, 0xBF20, 0xBF40, 0xB672, 0xF3BF, 0x8F4F, 0xF3BF, 0x8F5F, 0xF3BF, 0x8F6F, 0x2001], [], 0b1001, [])

    assert(c.r[0] == 1 && c.retired == 9 && c.stop_at == 24, "nine retired, the breakpoint at 24")
    // MOVS clears N; V is the starting state's.
    assert(c.primask == 1 && flags(&c) == 0b0001 && c.r[13] == 0x2000, "PRIMASK set, nothing else")

    // movs r0, #1; udf
    c = execute([0x2001, 0xDE00], [], 0, [])
    assert(c.stop == Stop.Undefined && c.stop_at == 2 && c.retired == 1 && c.pc == 2, "UDF")

    // a 32-bit encoding this core has no meaning for
    c = execute([0xF000, 0x0000], [], 0, [])
    assert(c.stop == Stop.Undefined && c.stop_at == 0 && c.retired == 0, "undefined 32-bit")
