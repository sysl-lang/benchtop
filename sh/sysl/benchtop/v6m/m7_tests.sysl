module sh.sysl.benchtop.v6m
@tests

// No new instruction handlers: test the new model through both existing executors.
@test("M7 shares signed and unsigned divide at integer boundaries, preserving NZCV")
m7_divide()
    val cases: [8][3]u32 = [
        [0, 1, 0], [7, 2, 3], [0xFFFFFFF9, 2, 0xFFFFFFFD],
        [7, 0xFFFFFFFE, 0xFFFFFFFD], [0x80000000, 0xFFFFFFFF, 0x80000000],
        [0x7FFFFFFF, 1, 0x7FFFFFFF], [0x80000000, 1, 0x80000000], [7, 0, 0],
    ]

    for operands in cases
        for nzcv in [0, 3, 6, 9, 11]
            var c = execute_thumb2(Kind.V7emM7, [0xFB91, 0xF0F2], [99, operands[0], operands[1]], u32(nzcv), [])
            assert(c.stop == Stop.Breakpoint && c.retired == 1 && c.r[0] == operands[2], "SDIV result")
            assert(flags(&c) == u32(nzcv), "divide preserves flags")
    end for

    var c = execute_thumb2(Kind.V7emM7, [0xFBB1, 0xF0F2], [99, 0xFFFFFFFF, 2], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 0x7FFFFFFF, "UDIV unsigned boundary")
    c = execute_thumb2(Kind.V7emM7, [0xFBB1, 0xF0F2], [99, 0xFFFFFFFF, 0], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 0, "UDIV zero without trap")
end m7_divide

@test("M7 DIV_0_TRP stops signed and unsigned division without retiring or overwriting the destination")
m7_divide_trap()
    for first in [u16(0xFB91), u16(0xFBB1)]
        // str r3, [r4] sets CCR before the divide.
        val code: [3]u16 = [0x6023, first, 0xF0F2]
        var c = execute_thumb2(Kind.V7emM7, code, [99, 7, 0, CCR_DIV_0_TRP, SCB_CCR], 0, [])
        assert(c.stop == Stop.Fault && c.stop_at == 2 && c.retired == 1 && c.r[0] == 99, "trapping divide")
end m7_divide_trap

@test("M7 and M4 reject every width of v8 ordered access and both stack-limit registers; M33 accepts them")
m7_architecture_boundary()
    val codes: [16][2]u16 = [
        [0xE8D1, 0x0F8F], [0xE8D1, 0x0F9F], [0xE8D1, 0x0FAF], // LDAB/H/word
        [0xE8C1, 0x0F8F], [0xE8C1, 0x0F9F], [0xE8C1, 0x0FAF], // STLB/H/word
        [0xE8D1, 0x0FCF], [0xE8D1, 0x0FDF], [0xE8D1, 0x0FEF], // LDAEXB/H/word
        [0xE8C1, 0x0FC2], [0xE8C1, 0x0FD2], [0xE8C1, 0x0FE2], // STLEXB/H/word
        [0xF3EF, 0x800A], [0xF380, 0x880A], // MRS/MSR MSPLIM
        [0xF3EF, 0x800B], [0xF380, 0x880B], // MRS/MSR PSPLIM
    ]

    for kind in [Kind.V6m, Kind.V7em, Kind.V7emM7, Kind.V8mMain]
        for code in codes
            var c = execute_thumb2(kind, code, [0, 0x1000, 9], 0, [[0x1000, 42]])
            if kind == Kind.V8mMain
                assert(c.stop == Stop.Breakpoint && c.retired == 1, "M33 accepts v8 instruction")
            else
                assert(c.stop == Stop.Undefined && c.retired == 0 && c.stop_at == 0, "other cores reject v8 instruction")
                assert(c.r[0] == 0 && c.r[2] == 9 && load32(&c, 0x1000) == 42, "rejection changes no registers or data")
end m7_architecture_boundary

@test("M7 CPUID is read-only and CCR preserves fixed bits while masking absent caches and reserved fields")
m7_system()
    var c: Cpu
    c.kind = Kind.V7emM7
    reset(&c, [], 0)
    assert(load32(&c, SCB_CPUID) == 0x410FC270, "M7 r0p0")
    store32(&c, SCB_CPUID, 0)
    assert(load32(&c, SCB_CPUID) == 0x410FC270, "identity cannot be overwritten")
    assert(load32(&c, SCB_CCR) == 0x40200, "BP and STKALIGN reset set")
    store32(&c, SCB_CCR, 0xFFFFFFFF)
    assert(load32(&c, SCB_CCR) == 0x4031B, "only implemented fields")
    store32(&c, SCB_CCR, 0)
    assert(load32(&c, SCB_CCR) == 0x40200, "BP and STKALIGN cannot clear; NONBASETHRDENA can")
    store32(&c, NVIC_IPR, 0xFFFFFFFF)
    assert(load32(&c, NVIC_IPR) == 0xF0F0F0F0, "four priority bits")
    assert(c.msplim == 0 && c.psplim == 0, "no stack limits")
end m7_system

@test("M7 exception entry always aligns the stack, records padding only when needed and restores SP")
m7_stack_alignment()
    val code: []const u16 = [SVC, BKPT, MOV_R0_SP, LOG_R0, BX_LR]
    // This setup attempts to clear STKALIGN and leaves SP at 0x2004.
    var c = run_both_thumb2(Kind.V7emM7, code, [0, 0, 0, 0, LOG], 0, [[SVCALL, 4]], &m4_word_stack)
    assert(c.stop == Stop.Breakpoint && c.r[13] == 0x2004, "restore unaligned SP")
    assert(logged(&c, [0x1FE0]) && load32(&c, 0x1FE0 + 28) & 0x200 != 0, "padding despite attempted CCR clear")
    c = run_both_thumb2(Kind.V7emM7, code, [0, 0, 0, 0, LOG], 0, [[SVCALL, 4]], &nothing)
    assert(c.stop == Stop.Breakpoint && c.r[13] == 0x2000, "restore aligned SP")
    assert(logged(&c, [0x1FE0]) && load32(&c, 0x1FE0 + 28) & 0x200 == 0, "no padding when already aligned")
end m7_stack_alignment

@test("M7 shares interrupt masking and clears its exclusive monitor across exception return")
m7_exceptions()
    val code: []const u16 = [0x2001, LOG_R0, 0xF382, 0x8811, 0x2002, LOG_R0, BKPT, LOG_9, LOG_R0, BX_LR]
    var c = run_both_thumb2(Kind.V7emM7, code, [0, 0, 0x80, 0, LOG], 0, [[IRQ0, 14]], &held_by_basepri)
    assert(c.stop == Stop.Breakpoint && logged(&c, [1, 9, 2]) && c.basepri == 0x80, "BASEPRI")
    c = run_both_thumb2(Kind.V7emM7, [0xE851, 0x0F00, SVC, 0xE841, 0x0200, BKPT, BX_LR], [0, 0x1000, 9], 0, [[SVCALL, 12]], &nothing)
    assert(c.stop == Stop.Breakpoint && c.r[2] == 1 && c.ipsr == 0, "SVC invalidates exclusive monitor")
end m7_exceptions
