module sh.sysl.benchtop.v6m
@tests

// No new instruction handlers: test the new model through both existing executors.
@test("M7 shares signed and unsigned divide at integer boundaries, preserving NZCV")
m7_divide()
    val cases: [8][3]u32 = [
        [0, 1, 0], [7, 2, 3], [0xFFFFFFF9, 2, 0xFFFFFFFD],
        [7, 0xFFFFFFFE, 0xFFFFFFFD], [0x80000000, 0xFFFFFFFF, 0x80000000],
        [0x7FFFFFFF, 1, 0x7FFFFFFF], [0x80000000, 1, 0x80000000], [7, 0, 0],
    ]

    for operands in cases
        for nzcv in [0, 3, 6, 9, 11]
            var c = execute_thumb2(Kind.V7emM7, [0xFB91, 0xF0F2], [99, operands[0], operands[1]], u32(nzcv), [])
            assert(c.stop == Stop.Breakpoint && c.retired == 1 && c.r[0] == operands[2], "SDIV result")
            assert(flags(&c) == u32(nzcv), "divide preserves flags")
    end for

    var c = execute_thumb2(Kind.V7emM7, [0xFBB1, 0xF0F2], [99, 0xFFFFFFFF, 2], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 0x7FFFFFFF, "UDIV unsigned boundary")
    c = execute_thumb2(Kind.V7emM7, [0xFBB1, 0xF0F2], [99, 0xFFFFFFFF, 0], 0, [])
    assert(c.stop == Stop.Breakpoint && c.r[0] == 0, "UDIV zero without trap")
end m7_divide

@test("M7 DIV_0_TRP takes DIVBYZERO on signed and unsigned division without retiring or overwriting the destination")
m7_divide_trap()
    for first in [u16(0xFB91), u16(0xFBB1)]
        // str r3, [r4] sets CCR before the divide.
        val code: [3]u16 = [0x6023, first, 0xF0F2]
        var c = execute_thumb2(Kind.V7emM7, code, [99, 7, 0, CCR_DIV_0_TRP, SCB_CCR], 0, [])
        assert(usage_taken(&c, 2, CFSR_DIVBYZERO) && c.retired == 1 && c.r[0] == 99, "trapping divide")
end m7_divide_trap

@test("M7 and M4 reject every width of v8 ordered access and both stack-limit registers; M33 accepts them")
m7_architecture_boundary()
    val codes: [16][2]u16 = [
        [0xE8D1, 0x0F8F], [0xE8D1, 0x0F9F], [0xE8D1, 0x0FAF], // LDAB/H/word
        [0xE8C1, 0x0F8F], [0xE8C1, 0x0F9F], [0xE8C1, 0x0FAF], // STLB/H/word
        [0xE8D1, 0x0FCF], [0xE8D1, 0x0FDF], [0xE8D1, 0x0FEF], // LDAEXB/H/word
        [0xE8C1, 0x0FC2], [0xE8C1, 0x0FD2], [0xE8C1, 0x0FE2], // STLEXB/H/word
        [0xF3EF, 0x800A], [0xF380, 0x880A], // MRS/MSR MSPLIM
        [0xF3EF, 0x800B], [0xF380, 0x880B], // MRS/MSR PSPLIM
    ]

    for kind in [Kind.V6m, Kind.V7em, Kind.V7emM7, Kind.V8mMain]
        for code in codes
            var c = execute_thumb2(kind, code, [0, 0x1000, 9], 0, [[0x1000, 42]])
            if kind == Kind.V8mMain
                assert(c.stop == Stop.Breakpoint && c.retired == 1, "M33 accepts v8 instruction")
            else
                assert(usage_taken(&c, 0, CFSR_UNDEFINSTR) && c.retired == 0, "other cores reject v8 instruction")
                assert(c.r[0] == 0 && c.r[2] == 9 && load32(&c, 0x1000) == 42, "rejection changes no registers or data")
end m7_architecture_boundary

@test("M7 CPUID is read-only and CCR preserves fixed bits while masking reserved fields")
m7_system()
    var c: Cpu
    c.kind = Kind.V7emM7
    reset(&c, test_memory, [], 0)
    assert(load32(&c, SCB_CPUID) == 0x410FC270, "M7 r0p0")
    store32(&c, SCB_CPUID, 0)
    assert(load32(&c, SCB_CPUID) == 0x410FC270, "identity cannot be overwritten")
    assert(load32(&c, SCB_CCR) == 0x40200, "BP and STKALIGN reset set")
    store32(&c, SCB_CCR, 0xFFFFFFFF)
    assert(load32(&c, SCB_CCR) == 0x7031B, "only implemented fields, the cache enables among them")
    store32(&c, SCB_CCR, 0)
    assert(load32(&c, SCB_CCR) == 0x40200, "BP and STKALIGN cannot clear; NONBASETHRDENA can")
    store32(&c, NVIC_IPR, 0xFFFFFFFF)
    assert(load32(&c, NVIC_IPR) == 0xF0F0F0F0, "four priority bits")
    assert(c.msplim == 0 && c.psplim == 0, "no stack limits")
end m7_system

@test("M7 exception entry always aligns the stack, records padding only when needed and restores SP")
m7_stack_alignment()
    val code: []const u16 = [SVC, BKPT, MOV_R0_SP, LOG_R0, BX_LR]
    // This setup attempts to clear STKALIGN and leaves SP at 0x2004.
    var c = run_both_thumb2(Kind.V7emM7, code, [0, 0, 0, 0, LOG], 0, [[SVCALL, 4]], &m4_word_stack)
    assert(c.stop == Stop.Breakpoint && c.r[13] == 0x2004, "restore unaligned SP")
    assert(logged(&c, [0x1FE0]) && load32(&c, 0x1FE0 + 28) & 0x200 != 0, "padding despite attempted CCR clear")
    c = run_both_thumb2(Kind.V7emM7, code, [0, 0, 0, 0, LOG], 0, [[SVCALL, 4]], &nothing)
    assert(c.stop == Stop.Breakpoint && c.r[13] == 0x2000, "restore aligned SP")
    assert(logged(&c, [0x1FE0]) && load32(&c, 0x1FE0 + 28) & 0x200 == 0, "no padding when already aligned")
end m7_stack_alignment

@test("M7 shares interrupt masking and clears its exclusive monitor across exception return")
m7_exceptions()
    val code: []const u16 = [0x2001, LOG_R0, 0xF382, 0x8811, 0x2002, LOG_R0, BKPT, LOG_9, LOG_R0, BX_LR]
    var c = run_both_thumb2(Kind.V7emM7, code, [0, 0, 0x80, 0, LOG], 0, [[IRQ0, 14]], &held_by_basepri)
    assert(c.stop == Stop.Breakpoint && logged(&c, [1, 9, 2]) && c.basepri == 0x80, "BASEPRI")
    c = run_both_thumb2(Kind.V7emM7, [0xE851, 0x0F00, SVC, 0xE841, 0x0200, BKPT, BX_LR], [0, 0x1000, 9], 0, [[SVCALL, 12]], &nothing)
    assert(c.stop == Stop.Breakpoint && c.r[2] == 1 && c.ipsr == 0, "SVC invalidates exclusive monitor")
end m7_exceptions

val CACHE_MAINTENANCE: [10]u32 = [
    0xE000EF50, 0xE000EF58, 0xE000EF5C, 0xE000EF60, 0xE000EF64,
    0xE000EF68, 0xE000EF6C, 0xE000EF70, 0xE000EF74, 0xE000EF78,
]

m7_core() -> Cpu
    var c: Cpu
    c.kind = Kind.V7emM7
    reset(&c, test_memory, [], 0)
    c

@test("M7 accepts every cache maintenance write and reads each as zero, and the run continues")
m7_cache_maintenance()
    var c = m7_core()
    for a in CACHE_MAINTENANCE
        store32(&c, a, 0xFFFFFFFF)
        assert(c.stop == Stop.Running, "the write is accepted")
        assert(load32(&c, a) == 0 && c.stop == Stop.Running, "the read gives 0")
        store32(&c, a, 0)
        assert(c.stop == Stop.Running, "a zero operand is accepted too")
    end for
    // The address between ICIALLU and ICIMVAU is no register.
    store32(&c, 0xE000EF54, 0)
    assert(c.stop == Stop.Unmapped, "reserved space next to the operations is still reserved")
end m7_cache_maintenance

@test("M7 CLIDR, CTR and CCSIDR describe the 16 KB L1 caches, CCSIDR by CSSELR, and are read-only")
m7_cache_identification()
    var c = m7_core()
    assert(load32(&c, 0xE000ED78) == 0x09000003, "CLIDR")
    assert(load32(&c, 0xE000ED7C) == 0x8303C003, "CTR")
    assert(load32(&c, 0xE000ED84) == 0, "CSSELR resets to the data cache")
    assert(load32(&c, 0xE000ED80) == 0xF00FE019, "CCSIDR of the D-cache: 128 sets, 4 ways, 32-byte lines")
    store32(&c, 0xE000ED84, 1)
    assert(load32(&c, 0xE000ED84) == 1 && load32(&c, 0xE000ED80) == 0x200FE019, "CCSIDR of the I-cache")
    store32(&c, 0xE000ED84, 0xFFFFFFFE)
    assert(load32(&c, 0xE000ED84) == 0 && load32(&c, 0xE000ED80) == 0xF00FE019, "only InD is kept; level 0")
    store32(&c, 0xE000ED78, 0)
    store32(&c, 0xE000ED7C, 0)
    store32(&c, 0xE000ED80, 0)
    assert(load32(&c, 0xE000ED78) == 0x09000003 && load32(&c, 0xE000ED7C) == 0x8303C003, "read-only")
    assert(load32(&c, 0xE000ED80) == 0xF00FE019 && c.stop == Stop.Running, "read-only")

    // The geometry in CCSIDR is 16 KB: (sets) * (ways) * (4 * 2^(LineSize + 2)) bytes.
    val geometries: [2]u32 = [0xF00FE019, 0x200FE019]
    for ccsidr in geometries
        val sets = ((ccsidr >> 13) & 0x7FFF) + 1
        val ways = ((ccsidr >> 3) & 0x3FF) + 1
        val line = 4 << ((ccsidr & 7) + 2)
        assert(sets * ways * line == 16384 && line == 32, "16 KB, 32-byte lines")
    end for
end m7_cache_identification

@test("M7 CCR.IC and CCR.DC read back and clear")
m7_cache_enables()
    var c = m7_core()
    assert(load32(&c, SCB_CCR) & 0x30000 == 0, "caches off at reset")
    store32(&c, SCB_CCR, load32(&c, SCB_CCR) | 0x10000)
    assert(load32(&c, SCB_CCR) == 0x50200, "DC")
    store32(&c, SCB_CCR, load32(&c, SCB_CCR) | 0x20000)
    assert(load32(&c, SCB_CCR) == 0x70200, "IC and DC")
    store32(&c, SCB_CCR, load32(&c, SCB_CCR) & ~0x10000)
    assert(load32(&c, SCB_CCR) == 0x60200, "IC alone")
    store32(&c, SCB_CCR, 0)
    assert(load32(&c, SCB_CCR) == 0x40200, "both clear")
end m7_cache_enables

// CMSIS's SCB_CleanInvalidateDCache and SCB_EnableDCache loops, then SCB_EnableICache, hand-assembled.
// r1 = CCSIDR, r2 = the set/way operation (DCCISW or DCISW), r5 = CSSELR, r8 = CCR, r9 = CCR.IC|DC,
// r10 = ICIALLU. The loops run CCSIDR's 128 sets by 4 ways: 4 + 128 * (1 + 4 * 6 + 2) instructions,
// then 8 for the enables, so the count is right only if CCSIDR is.
@test("M7 runs the CMSIS data cache clean-and-invalidate and enable sequences to completion")
m7_cmsis_cache_sequence()
    val code: [23]u16 = [
        0x2300,         // movs r3, #0
        0x602B,         // str r3, [r5]            CSSELR = 0
        0x680B,         // ldr r3, [r1]            CCSIDR
        0xF3C3, 0x344E, // ubfx r4, r3, #13, #15   sets - 1
        0xF3C3, 0x06C9, // ubfx r6, r3, #3, #10    ways - 1
        0x0167,         // lsls r7, r4, #5
        0x07B0,         // lsls r0, r6, #30
        0x4307,         // orrs r7, r0
        0x6017,         // str r7, [r2]            DCCISW / DCISW
        0x3E01,         // subs r6, #1
        0xD5F9,         // bpl  way loop
        0x3C01,         // subs r4, #1
        0xD5F5,         // bpl  set loop
        0x4646,         // mov r6, r8
        0x6837,         // ldr r7, [r6]            CCR
        0x464C,         // mov r4, r9
        0x4327,         // orrs r7, r4
        0x6037,         // str r7, [r6]            CCR |= IC | DC
        0x4656,         // mov r6, r10
        0x6034,         // str r4, [r6]            ICIALLU
        0x6830,         // ldr r0, [r6]            reads 0
    ]

    val ops: [2]u32 = [0xE000EF74, 0xE000EF60]
    for op in ops
        val regs: [11]u32 = [7, 0xE000ED80, op, 0, 0, 0xE000ED84, 0, 0, 0xE000ED14, 0x30000, 0xE000EF50]
        val c = execute_thumb2(Kind.V7emM7, code, regs, 0, [])
        assert(c.stop == Stop.Breakpoint && c.retired == 3468, s"the loops end: ${c.stop} after ${c.retired}")
        assert(c.r[0] == 0 && c.r[6] == 0xE000EF50, "ICIALLU reads 0")
        var d = c
        assert(load32(&d, SCB_CCR) == 0x70200, "the caches are enabled")
    end for
end m7_cmsis_cache_sequence

@test("the same addresses on the M4 and M33 act as any other reserved system space does")
non_m7_cache_addresses()
    for kind in [Kind.V7em, Kind.V8mMain, Kind.M3]
        var base: Cpu
        base.kind = kind
        reset(&base, test_memory, [], 0)
        load32(&base, 0xE000EFA0)
        val reserved = base.stop

        val probes: [8]u32 = [0xE000ED78, 0xE000ED7C, 0xE000ED80, 0xE000ED84, 0xE000EF50, 0xE000EF5C, 0xE000EF74, 0xE000EF78]
        for a in probes
            var r: Cpu
            r.kind = kind
            reset(&r, test_memory, [], 0)
            load32(&r, a)
            assert(r.stop == reserved, "a read is what reserved space gives")
            var w: Cpu
            w.kind = kind
            reset(&w, test_memory, [], 0)
            store32(&w, a, 0)
            assert(w.stop == reserved, "a write is what reserved space gives")
        end for
    end for
end non_m7_cache_addresses
