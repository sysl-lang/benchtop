module sh.sysl.benchtop.v6m
@tests
import sh.sysl.benchtop.timing.NEVER

@test("instruction timing: fused, reference and single-step paths keep retirement separate from cycles")
instruction_timing_paths()
    for kind in [Kind.V6m,Kind.M0,Kind.V7em,Kind.V7emM7,Kind.V8mMain]
        for exec in [&run_match,&run_threaded,&run_single]
            for enabled in [false,true]
                var c: Cpu
                c.kind = kind
                reset(&c, test_memory, [], 0)
                configure_instruction_timing(&c,enabled)
                // MOVS; LDR; CMP; BEQ +0; skipped NOP; NOP; BKPT.
                val code = [0x2001u16,0x6811,0x2801,0xd000,0xbf00,0xbf00,0xbe00]
                for i in 0..<code.len do store16(&c,u32(i) * 2,code[i])
                c.r[2] = 0x100
                store32(&c,0x100,0x12345678)
                set_limit(&c,NEVER)
                while c.stop == Stop.Budget do exec(&c)
                assert(c.stop == Stop.Breakpoint && c.r[1] == 0x12345678 && c.retired == 5)
                assert(cycles(&c) == (if enabled then 7u64 else 5u64))
                assert(clock(&c,c.retired) == cycles(&c))

@test("instruction timing: cycle budgets stop loops and failed memory accesses charge no cycles")
instruction_timing_limits()
    for exec in [&run_match,&run_threaded]
        var c: Cpu
        c.kind = Kind.V7em
        reset(&c, test_memory, [], 0)
        configure_instruction_timing(&c,true)
        // LDR r0,[r1]; B -4: two instructions, five cycles.
        store16(&c,0,0x6808)
        store16(&c,2,0xe7fd)
        c.r[1] = 0x100
        set_limit(&c,4)
        exec(&c)
        assert(c.retired == 2 && cycles(&c) == 5 && c.pc == 0)
        c.r[1] = 0x60000000
        set_limit(&c,NEVER)
        exec(&c)
        assert(c.stop == Stop.Unmapped && c.retired == 2 && cycles(&c) == 5)

@test("instruction timing: SysTick and sleeping advance in cycles, reset restores unit timing")
instruction_timing_systick()
    for exec in [&run_match,&run_threaded]
        var c: Cpu
        c.kind = Kind.V7em
        reset(&c, test_memory, [], 0)
        configure_instruction_timing(&c,true)
        store16(&c,0,0x6808)
        store16(&c,2,0xe7fd)
        c.r[1] = 0x100
        scs_write(&c,SYST_RVR,4,9,0)
        scs_write(&c,SYST_CVR,4,0,0)
        scs_write(&c,SYST_CSR,4,1,0)
        set_limit(&c,4)
        exec(&c)
        assert(cycles(&c) == 5 && scs_read(&c,SYST_CVR,4,c.retired) == 5)
        c.sleeping = true
        assert(!wake_by(&c,20))
        assert(clock(&c,c.retired) == 20 && c.slept == 15 && c.retired == 2)
        clear(&c,0)
        assert(!c.instruction_timing && cycles(&c) == 0 && clock(&c,0) == 0)

@test("instruction timing: floating-point divide and multiply-accumulate use distinct fixed costs")
instruction_timing_fp()
    for exec in [&run_match,&run_threaded]
        var c: Cpu
        // VDIV.F32 s0,s0,s1, followed by the harness breakpoint.
        fp_prepare(&c,Kind.V7em,1,[0xee80,0x0a20],[],[ONE,TWO],0,[])
        configure_instruction_timing(&c,true)
        set_limit(&c,NEVER)
        exec(&c)
        assert(c.stop == Stop.Breakpoint && c.retired == 1 && cycles(&c) == 14)
        assert(c.s[0] == 0x3f000000)
        assert(fp_instruction_cycles(Kind.V7em,FP_ADD,false) == 1)
        assert(fp_instruction_cycles(Kind.V7em,FP_MLA,false) == 3)
        assert(fp_instruction_cycles(Kind.V7emM7,FP_DIV,true) == 28)

@test("instruction timing: complete Thumb-2 workload agrees across both executors and timing modes")
instruction_timing_workload()
    for kind in [Kind.V7em,Kind.V7emM7,Kind.V8mMain]
        var retired: u64 = 0
        var elapsed: u64 = 0
        for enabled in [false,true]
            for exec in [&run_match,&run_threaded]
                var c: Cpu
                c.kind = kind
                reset(&c, test_memory, kernel33, 0)
                store32(&c,0x10,20)
                configure_instruction_timing(&c,enabled)
                while c.stop == Stop.Budget
                    set_limit(&c,cycles(&c) + 1000)
                    exec(&c)
                assert(c.stop == Stop.Breakpoint && c.r[0] == KERNEL_20)
                if retired == 0 then retired = c.retired
                assert(c.retired == retired,"timing cannot change the instruction stream")
                if enabled
                    assert(cycles(&c) > c.retired)
                    if elapsed == 0 then elapsed = cycles(&c)
                    assert(cycles(&c) == elapsed,"reference and fused threaded paths charge identical cycles")
                else assert(cycles(&c) == c.retired)

@test("instruction timing: skipped IT memory operations consume one cycle and make no access")
instruction_timing_it()
    for exec in [&run_match,&run_threaded,&run_single]
        var c: Cpu
        c.kind = Kind.V7em
        prepare(&c,[0x4280,0xbf0c,0x6811,0x6819],[],0,[])
        configure_instruction_timing(&c,true)
        c.r[2] = 0x100
        c.r[3] = 0x60000000
        set_limit(&c,NEVER)
        while c.stop == Stop.Budget do exec(&c)
        assert(c.stop == Stop.Breakpoint && c.retired == 4 && cycles(&c) == 5)

@test("instruction timing: an IT block's instructions charge as the core is timed, executed or skipped")
instruction_timing_it_modes()
    for kind in [Kind.V7em,Kind.V7emM7,Kind.V8mMain]
        for enabled in [false,true]
            for exec in [&run_match,&run_threaded,&run_single]
                var c: Cpu
                c.kind = kind
                // CMP r0,r0; IT EQ; LDREQ r1,[r2]; IT NE; LDRNE r3,[r3] (skipped, so no access).
                prepare(&c,[0x4280,0xbf08,0x6811,0xbf18,0x681b],[],0,[])
                configure_instruction_timing(&c,enabled)
                c.r[2] = 0x100
                c.r[3] = 0x60000000
                store32(&c,0x100,0x12345678)
                set_limit(&c,NEVER)
                while c.stop == Stop.Budget do exec(&c)
                assert(c.stop == Stop.Breakpoint && c.retired == 5 && c.r[1] == 0x12345678 && c.r[3] == 0x60000000)
                assert(cycles(&c) == (if enabled then 6u64 else 5u64), s"$kind $enabled")

@test("instruction timing: every operation's cost comes from the one table, and every operation has a handler")
instruction_timing_every_op()
    for kind in [Kind.V6m,Kind.M0,Kind.M3,Kind.M23,Kind.V7em,Kind.V7emM7,Kind.V8mMain]
        for enabled in [false,true]
            var c: Cpu
            c.kind = kind
            configure_instruction_timing(&c,enabled)
            for const v in Op::Variants
                val op = Op::Make(v, ())
                val want = if enabled then instruction_cycles(kind,op) else 1u8
                assert(c.cycle_costs[usize(u8(op))] == want, s"${v.name} on $kind")
                assert(handler_of[false](op) != null && handler_of[true](op) != null, v.name)
    assert(costed(Op.Ldrd) && costed(Op.Umull) && costed(Op.Mrs) && costed(Op.Bl))
    assert(!costed(Op.Eors) && !costed(Op.SpImm) && !costed(Op.Clrex) && !costed(Op.FpData))
