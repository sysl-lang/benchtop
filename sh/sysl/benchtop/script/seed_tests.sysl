module sh.sysl.benchtop.script
@tests

// A scripted run varied by `--seed` and the fault options (`run`'s `faults`): the same seed gives the
// same outcome, its line and its console, with `--timeout` ending it at the same board time; and a
// board that takes no turns refuses them.

import sh.sysl.benchtop.v6m.{Faults, no_faults}
import sysl.buf.{Buf, buf}

private varied(board: string, image: string, args: []const string, f: Faults) -> Outcome
    var all: Buf[string] = buf()
    all.push("--quiet")
    for a in args do all.push(a)
    run(board, image, parse(all.view()).unwrap(), setup(), f)

private seeded(seed: u64) -> Faults = Faults(true, seed, 0, 0, 0, 0)

@test("script: a seeded run replays its outcome, and its --timeout ends it at the same board time")
script_seed_replays()
    val args = ["--expect", "core 0: core 1 finished; total 30", "--timeout", "3000000cycles"]
    for seed in 1u64..3
        val o = varied("virt", "examples/virt/dual.elf", args[..], seeded(seed))
        assert(o.status == 0 && o.why.starts_with("passed"), o.why)
        val again = varied("virt", "examples/virt/dual.elf", args[..], seeded(seed))
        assert(again.why == o.why && again.console.view() == o.console.view(), s"seed $seed: ${again.why} against ${o.why}")

    // A text that never comes times out at the same time, seeded or not, faults or none (echo.elf waits
    // for its input for ever).
    val never = ["--expect", "never", "--timeout", "2000000cycles"]
    val plain = varied("virt", "examples/virt/echo.elf", never[..], no_faults())
    assert(plain.status == 124, plain.why)
    for f in [seeded(7), Faults(true, 7, 500, 3, 2000, 20)]
        val o = varied("virt", "examples/virt/echo.elf", never[..], f)
        assert(o.status == 124 && o.why == plain.why, o.why)
        val again = varied("virt", "examples/virt/echo.elf", never[..], f)
        assert(again.console.view() == o.console.view())

@test("script: the Pico 2 under a seed and faults passes as it does without, the same seed replaying it")
script_seed_pico2()
    val args = ["--expect", "hello, serial 2", "--timeout", "2s"]
    val f = Faults(true, 11, 300, 2, 1000, 0)
    val o = varied("pico2", "examples/pico2/hello_serial.elf", args[..], f)
    assert(o.status == 0, o.why)
    assert(varied("pico2", "examples/pico2/hello_serial.elf", args[..], f).why == o.why)

@test("script: the Hazard3 harts refuse --seed and the fault options, and take a run that asks for none")
script_seed_riscv_refused()
    val o = varied("pico2-riscv", "examples/pico2-riscv/blink.elf", ["--timeout", "1ms"][..], seeded(1))
    assert(o.status == FAILED && o.why.contains("Cortex-M cores"), o.why)
    val plain = varied("pico2-riscv", "examples/pico2-riscv/blink.elf", ["--timeout", "1ms"][..], no_faults())
    assert(plain.status == TIMED_OUT, plain.why)
