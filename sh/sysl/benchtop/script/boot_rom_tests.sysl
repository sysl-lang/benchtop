module sh.sysl.benchtop.script
@tests

import sh.sysl.benchtop.virt.SdChoice

// `benchtop run --boot rom` as a scripted run makes it: the Pico 2 booted through Raspberry Pi's boot ROM.

@test("script: --boot rom runs a Pico 2 flash image through the boot ROM to its expected output; the Pico, the RISC-V Pico 2 and a virtual board refuse it by name")
script_boot_rom()
    val rom = Setup(true, false, SdChoice.Described, false, true)
    val ok = run("pico2", "examples/pico2/hello_serial_flash.elf", parse(["--quiet", "--expect", "hello, serial 1", "--timeout", "1s"][..]).unwrap(), rom)
    assert(ok.status == 0, ok.why)
    val blank = run("pico2", "examples/pico2/hello_serial.elf", parse(["--quiet"][..]).unwrap(), rom)
    assert(blank.status == 1 && blank.why.contains("BOOTSEL's USB boot"), blank.why)
    for board in ["pico", "pico2-riscv"]
        val other = run(board, "examples/pico2/hello_serial_flash.elf", parse(["--quiet"][..]).unwrap(), rom)
        assert(other.status == 1 && other.why.contains("--boot rom is for a board of an RP2350's Cortex-M33 cores"), other.why)
    val virt_board = run("virt", "examples/pico2/hello_serial_flash.elf", parse(["--quiet"][..]).unwrap(), rom)
    assert(virt_board.status == 1 && virt_board.why.contains("--boot rom is for a board of an RP2350's Cortex-M33 cores"), virt_board.why)
