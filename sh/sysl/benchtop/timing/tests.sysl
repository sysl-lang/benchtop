module sh.sysl.benchtop.timing
@tests

@test("core pacing: arbitrary clocks share host time without sharing execution budgets")
pacer_clock_domains()
    for hz in [1u64,1000,2000000,125000000,150000000,240000000,480000000,1000000000]
        val p = pacer(hz,1234,77)
        assert(target(p,1234) == 77)
        assert(target(p,1233) == 77,"backwards host samples add no time")
        assert(target(p,1235) == 77 + hz / 1000000)
        assert(target(p,1001234) == 77 + hz)
        assert(wait_us(p,77 + hz,1001234) == 0)
        assert(late_us(p,77,1001234) == 1000000)
        assert(late_us(p,77 + hz,1001234) == 0)
        assert(wait_us(p,77 + 2 * hz,1001234) == 1000000)
        assert(wait_us(p,78,1234) == (1000000 + hz - 1) / hz)
        assert(target(p,1234 + 2592000000000) == 77 + 2592000 * hz,"long sessions avoid timestamp multiplication overflow")
        assert(p.interval >= 1 && p.interval <= 1000000)
    val a = pacer(125000000,0,0)
    val b = pacer(330000000,0,0)
    assert(target(a,1000) == 125000 && target(b,1000) == 330000)
    assert(wait_us(a,250000,1000) == 1000)
    assert(wait_us(b,330000,1000) == 0,"one domain's wait cannot change another's target")

@test("core pacing: checkpoints bound bursts and a resumed epoch excludes paused wall time")
pacer_pause_epoch()
    var p = pacer(100000000,0,0,400000)
    assert(p.interval == 100000 && p.next_check == 100000)
    checkpoint(&p,100001)
    assert(p.next_check == 200001)
    val resumed = pacer(100000000,10000000,500000)
    assert(target(resumed,10000000) == 500000)
    assert(target(resumed,10001000) == 600000)
    assert(wait_us(resumed,500000,10000000) == 0)
