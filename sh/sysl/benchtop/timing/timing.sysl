module sh.sysl.benchtop.timing

import sysl.math.{min,max}

// A clock reading that never comes: the due time of a device or core with nothing scheduled.
const NEVER: u64 = 0xffffffffffffffff

/** ISA-independent pacing of one clock domain against host monotonic time.
 * Clock values include time spent asleep; no CPU registers or instruction-set
 * identities are part of this policy. Comparisons occur at most once per batch.
 */
struct CorePacer
    hz: u64
    host_origin_us: u64
    guest_origin: u64
    interval: u64
    next_check: u64

pacer(hz: u64, host_us: u64, guest_clock: u64, max_batch: u64 = 1000000) -> CorePacer
    require hz > 0 && hz <= 1000000000 && max_batch > 0, "valid clock and checkpoint budget"
    val interval = min(max_batch,max(1u64,hz / 1000))
    CorePacer(hz,host_us,guest_clock,interval,guest_clock + interval)

/** Split seconds/fraction so a long-running session does not multiply the
 * complete host timestamp by a GHz clock. A backwards host sample adds no time.
 */
target(p: CorePacer, host_us: u64) -> u64
    val elapsed = if host_us > p.host_origin_us then host_us - p.host_origin_us else 0
    p.guest_origin + (elapsed / 1000000) * p.hz + ((elapsed % 1000000) * p.hz) / 1000000

/** Wait only when ahead. Ceil to a host microsecond, never truncate a positive
 * guest lead into a zero wait. No other core participates in this calculation.
 */
wait_us(p: CorePacer, guest_clock: u64, host_us: u64) -> u64
    val due = target(p,host_us)
    if guest_clock <= due then return 0
    val ahead = guest_clock - due
    (ahead / p.hz) * 1000000 + ((ahead % p.hz) * 1000000 + p.hz - 1) / p.hz

checkpoint(p: *CorePacer, guest_clock: u64) = p.next_check = guest_clock + p.interval

/** How far a domain's published clock trails its host-time target. */
late_us(p: CorePacer, guest_clock: u64, host_us: u64) -> u64
    val due = target(p,host_us)
    if guest_clock >= due then return 0
    val behind = due - guest_clock
    (behind / p.hz) * 1000000 + ((behind % p.hz) * 1000000) / p.hz
