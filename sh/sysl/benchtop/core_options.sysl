module sh.sysl.benchtop

import sh.sysl.benchtop.v6m.{default_priority_bits, has_fixed_dsp, is_baseline, is_v81m, model_named}
import sh.sysl.parsing.{Report, error}
import sysl.buf.{Buf, buf}
import sh.sysl.benchtop.riscv.{model_named as riscv_model_named, implemented}

/** Defaults describe the implemented integer cores, preserving plain-name board descriptions. */
core_default(name: string, option: string) -> Setting = option match
    "instruction-timing" -> Text("unit")
    "fpu" | "security" | "mve" -> Text("none")
    "mpu-regions" -> Whole(0)
    "nvic-priority-bits" -> model_named(name) match
        Some(model) -> Whole(long(default_priority_bits(model.kind)))
        None -> Whole(4)
    "dsp" -> model_named(name) match
        Some(model) -> Flag(has_fixed_dsp(model.kind))
        None -> Flag(false)
    _ -> Flag(false)

/** A selected value, or this model's default where the description omits it. */
core_option(c: Core, name: string) -> Setting = param_named(c.options, name) match
    Some(p) -> p.value
    None -> core_default(c.name, name)

// The hardware choices this core can describe; emulation availability is checked separately.
private option_specs(name: string) -> Buf[ParamSpec]
    var out: Buf[ParamSpec] = buf()
    var fp: Buf[string] = buf()
    var security: Buf[string] = buf()

    val model = model_named(name).unwrap()
    fp.push("none")
    if model.fpu != "none" then fp.push("sp")
    if model.fpu == "dp" then fp.push("dp")
    security.push("none")
    if model.security then security.push("trustzone")

    var timing: Buf[string] = buf()
    timing.push("unit")
    timing.push("estimated")
    out.push(param("instruction-timing", PChoice(timing)))
    out.push(param("clock-hz", PWhole(1, 1000000000)))
    out.push(param("dsp", PFlag))
    out.push(param("fpu", PChoice(fp)))
    out.push(param("mpu-regions", PWhole(0, model.mpu_max)))
    out.push(param("security", PChoice(security)))
    out.push(param("icache", PFlag))
    out.push(param("dcache", PFlag))
    out.push(param("nvic-priority-bits", if is_baseline(model.kind) then PWhole(2, 2) else PWhole(3, 8)))
    if is_v81m(model.kind)
        var vector: Buf[string] = buf()
        for v in ["none", "integer", "float"] do vector.push(v)
        out.push(param("mve", PChoice(vector)))
        out.push(param("low-overhead-loops", PFlag))
        if name == "cortex-m52" || name == "cortex-m85" then out.push(param("pacbti", PFlag))

    out
end option_specs

/** Type, range and model checks; no unimplemented feature is silently ignored by run. */
check_core_options(c: Core, r: *Report)
    val model = model_named(c.name) match
        Some(m) -> m
        None ->
            // A caller may supply a custom registry. A known name without a catalog model
            // still checks as before, but has no declared options.
            for option in c.options do r.add(error(option.name_span, s"`${c.name}` has no option `${option.name}`"))
            return

    val specs = option_specs(c.name)
    var known: Buf[string] = buf()

    for spec in specs do known.push(spec.name)

    for option in c.options
        var found = false

        for spec in specs
            if spec.name != option.name then continue
            found = true
            check_param(s"`${c.name}.${option.name}`", option, spec, r)

        if !found
            r.add(guessed(error(option.name_span, s"`${c.name}` has no option `${option.name}`"), option.name, known)
                .with_note(s"its options are ${listing(known)}"))
            continue

        option.value match
            Flag(true) ->
                if (option.name == "dsp" && !model.dsp) ||
                    (option.name == "icache" && !model.icache) || (option.name == "dcache" && !model.dcache) then
                    r.add(error(option.span, s"`${c.name}` does not support `${option.name}`"))
            Flag(false) ->
                if option.name == "dsp" && has_fixed_dsp(model.kind) then
                    r.add(error(option.span, s"`${c.name}` always has the DSP extension"))
            Whole(n) ->
                if option.name == "mpu-regions" && n >= 0 && n <= model.mpu_max
                    val valid = if model.mpu_step == 0 then n == 0 else n % model.mpu_step == 0

                    if !valid then r.add(error(option.span, s"`${c.name}.mpu-regions` has an invalid region count: $n"))
            _ -> ()
    end for
end check_core_options

/** A valid requested feature the emulator cannot run yet; priority width, integer DSP and the
 * floating-point unit are implemented.
 */
unemulated_core_option(c: Core) -> Option[string]
    riscv_model_named(c.name) match
        Some(model) ->
            if !implemented(model) then return Some(s"benchtop does not yet emulate all extensions of `${model.name}` (${model.isa})")
        None -> ()

    for option in c.options
        if option.name == "instruction-timing" || option.name == "clock-hz" || option.name == "nvic-priority-bits" || option.name == "dsp" || option.name == "fpu" then continue

        val enabled = option.value match
            Flag(on) -> on
            Whole(n) -> n != 0
            Text(s) -> s != "none"
            _ -> true

        if enabled then return Some(s"benchtop does not emulate `${c.name}.${option.name} = ${setting_text(option.value)}`")

    None
end unemulated_core_option
