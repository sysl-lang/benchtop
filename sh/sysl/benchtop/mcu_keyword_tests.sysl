module sh.sysl.benchtop
@tests

import sh.sysl.parsing.source_of

@test("MCU syntax: named and inline definitions round trip with mcu")
mcu_keyword()
    for text in [
        "mcu = virt\n",
        "mcu { name = custom, cores = [cortex-m0plus], pins { GP = 32 } }\n",
        "board { name = custom, mcu = virt }\n",
        "board { name = custom, mcu { name = controller, cores = [cortex-m0plus], pins { GP = 32 } } }\n"]
        val src = source_of("mcu.hocon", text)
        val parsed = load(src, library())
        assert(!parsed.report.has_errors(), parsed.report.render(src))
        val written = description_text(parsed.description)
        assert(written.contains("mcu") && !written.contains("chip"))
        val again = load(source_of("again.hocon", written), library())
        assert(!again.report.has_errors() && description_text(again.description) == written)

@test("MCU syntax: chip spelling is rejected instead of silently accepted as an alias")
reject_chip_keyword()
    for text in [
        "chip = virt\n",
        "chip { name = custom, cores = [cortex-m0plus] }\n",
        "board { name = custom, chip = virt }\n",
        "board { name = custom, mcu = virt, chip = virt }\n"]
        val parsed = load(source_of("old.hocon", text), library())
        assert(parsed.report.has_errors(), text)
