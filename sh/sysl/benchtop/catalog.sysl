module sh.sysl.benchtop

import sysl.buf.{Buf, buf}

/** Physical identity and defaults are separate from the reusable behavior model. */
struct CatalogPart
    name: string
    manufacturer: string
    number: string
    model: string
    defaults: Buf[(string, Setting)]

catalog_parts() -> Buf[CatalogPart]
    var out: Buf[CatalogPart] = buf()
    var passive: Buf[(string, Setting)] = buf()
    passive.push(("kind", Text("passive")))
    out.push(CatalogPart("PS1240P02BT", "TDK", "PS1240P02BT", "buzzer", passive))
    out.push(CatalogPart("DS3231", "Analog Devices / Maxim", "DS3231", "ds3231", buf()))
    out.push(CatalogPart("DS3231SN", "Analog Devices / Maxim", "DS3231SN", "ds3231", buf()))
    out.push(CatalogPart("ST7789V", "Sitronix", "ST7789V", "st7789", buf()))
    out.push(CatalogPart("microbit-v2-led-matrix", "Micro:bit Educational Foundation", "micro:bit V2 LED matrix", "led-matrix-5x5", buf()))
    out.push(CatalogPart("SSD1306", "Solomon Systech", "SSD1306", "ssd1306", buf()))
    out.push(CatalogPart("HD44780U", "Hitachi", "HD44780U", "hd44780", buf()))
    out

catalog_part(name: string) -> Option[CatalogPart]
    for entry in catalog_parts() do if entry.name == name then return Some(entry)
    None

part_model(p: Part) -> string = catalog_part(p.kind) match
    Some(entry) -> entry.model
    None -> p.kind

catalog_default(name: string, parameter: string) -> Option[Setting]
    catalog_part(name) match
        Some(entry) -> for (key, value) in entry.defaults do if key == parameter then return Some(value)
        None -> ()
    None

/** Instance overrides take precedence; defaults never rewrite the selected physical part. */
part_setting(p: Part, name: string) -> Option[Setting] = param_named(p.params, name) match
    Some(value) -> Some(value.value)
    None -> catalog_default(p.kind, name)

part_flag(p: Part, name: string, fallback: bool) -> bool = part_setting(p, name) match
    Some(Flag(value)) -> value
    _ -> fallback

part_text(p: Part, name: string, fallback: string) -> string = part_setting(p, name) match
    Some(Text(value)) -> value
    _ -> fallback
