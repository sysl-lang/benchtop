module sh.sysl.benchtop
@tests

import sh.sysl.parsing.source_of
import sysl.raw.str_cast
import sysl.text.{replace_all, Search}

private val AUDIO_BOARD = str_cast(embed("../../../boards/workbench.hocon"))

@test("real part catalog: physical identities reuse generic models, defaults validate and round trips preserve part numbers")
real_parts()
    val got = load(source_of("parts.hocon",AUDIO_BOARD),library())
    assert(!got.report.has_errors(), got.report.render(source_of("parts.hocon",AUDIO_BOARD)))
    val buzzer = part_named(got.description.board.parts,"buzzer").unwrap()
    assert(buzzer.kind == "PS1240P02BT" && part_model(buzzer) == "buzzer" && part_text(buzzer,"kind","") == "passive")
    assert(catalog_part(buzzer.kind).unwrap().manufacturer == "TDK")
    val written = description_text(got.description)
    assert(written.contains("part = PS1240P02BT") && written.contains("part = DS3231SN"))
    val again = load(source_of("again.hocon",written),library())
    assert(!again.report.has_errors() && description_text(again.description) == written)
    val generic = replace_all(AUDIO_BOARD,"part = PS1240P02BT","part = buzzer")
    assert(load(source_of("generic.hocon",generic),library()).report.has_errors(), "generic buzzer still requires its kind")
    val invalid = replace_all(AUDIO_BOARD,"part = PS1240P02BT","part = PS1240P02BT, kind = active")
    assert(load(source_of("wrong-kind.hocon",invalid),library()).report.has_errors(), "physical part identity fixes its drive type")
    val explicit = replace_all(AUDIO_BOARD,"gain = 12","gain = 8")
    val selected = load(source_of("override.hocon",explicit),library())
    assert(!selected.report.has_errors())
    assert(part_whole(part_named(selected.description.board.parts,"buzzer").unwrap(),"gain",0) == 8)
