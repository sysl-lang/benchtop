module sh.sysl.benchtop.parts.sd_card
@tests

import sysl.buf.{Buf,buf}

private exchange(c: &Card, value: u8, selected: bool = true) -> u8
    var result: u8 = 0
    for bit in 0u32..<8
        val high = value & (0x80u8 >> bit) != 0
        result = (result << 1) | (if observe(c,selected,true,high,1000000) then 1 else 0)
        observe(c,selected,false,high,1000000)
    result
private cmd(c: &Card, index: u8, arg: u32, checksum: u8 = 1) -> u8
    exchange(c,0xff,false)
    exchange(c,0x40 | index)
    exchange(c,u8(arg >> 24))
    exchange(c,u8(arg >> 16))
    exchange(c,u8(arg >> 8))
    exchange(c,u8(arg))
    exchange(c,checksum)
    for i in 0..<10
        val r = exchange(c,0xff)
        if r != 0xff then return r
    0xff

@test("SDHC SPI: pin-level initialization, capacity, sector round trip, CRC rejection and protection")
protocol()
    val bytes: Buf[u8] = buf()
    for i in 0..<512 do bytes.push(0)
    val media = Media((sector,out) ->
        for i in 0usize..<512 do out[i] = bytes[i]
        true,
        (sector,input) ->
            for i in 0usize..<512 do bytes[i] = input[i]
            true,
        () -> true, () -> true)
    val c = card(media,32768,program_ticks = 0)
    assert(cmd(c,0,0,0x95) == 0xff,"power-up clocks are required")
    for i in 0..<10 do exchange(c,0xff,false)
    assert(cmd(c,0,0,0x95) == 1)
    assert(cmd(c,8,0x1aa,0x87) == 1)
    assert(exchange(c,0xff) == 0 && exchange(c,0xff) == 0 && exchange(c,0xff) == 1 && exchange(c,0xff) == 0xaa)
    assert(cmd(c,41,0x40000000) == 5,"ACMD41 requires CMD55")
    assert(cmd(c,55,0) == 1)
    assert(cmd(c,41,0x40000000) == 0)
    assert(cmd(c,58,0) == 0)
    assert(exchange(c,0xff) == 0xc0)
    assert(cmd(c,9,0) == 0)
    while exchange(c,0xff) != 0xfe do ()
    var csd: [16]u8 = [0;16]
    for i in 0..<16 do csd[i] = exchange(c,0xff)
    assert(csd[0] == 0x40 && csd[9] == 31)
    assert(cmd(c,17,32768) == 0x20,"range checked before media access")
    assert(cmd(c,24,3) == 0)
    exchange(c,0xfe)
    for i in 0..<512 do exchange(c,0)
    exchange(c,0)
    exchange(c,0)
    assert(exchange(c,0xff) & 31 == 5)
    assert(c.stats.writes == 1)
    assert(cmd(c,17,3) == 0)
    while exchange(c,0xff) != 0xfe do ()
    for i in 0..<514 do assert(exchange(c,0xff) == 0)
    c.spi.crc = true
    // A valid CMD24 CRC, generated independently in the driver tests, is not
    // needed here: temporarily stage a block to test data CRC rejection alone.
    c.spi.write_stage = StartToken
    c.spi.reply.clear()
    exchange(c,0xfe)
    for i in 0..<512 do exchange(c,0)
    exchange(c,0)
    exchange(c,1)
    assert(exchange(c,0xff) & 31 == 11)
    assert(c.stats.writes == 1)
    reset(c)
    c.protected = true
    c.spi.idle = false
    assert(cmd(c,24,0) == 0x40)
    assert(bytes[0] == 0 && c.stats.writes == 0)

private media_of(sectors: Buf[u8]) -> Media = Media((sector,out) ->
    for i in 0..<512 do out[i] = sectors[i]
    true,
    (sector,input) ->
        for i in 0..<512 do sectors[i] = input[i]
        true,
    () -> true, () -> true)

@test("SD reset: a reset mid-block returns every link field to power-on, including the half-received block")
reset_mid_block()
    val bytes: Buf[u8] = buf()
    for i in 0..<512 do bytes.push(0)
    val c = card(media_of(bytes),32768,program_ticks = 0)
    for i in 0..<10 do exchange(c,0xff,false)
    assert(cmd(c,0,0,0x95) == 1)
    assert(cmd(c,55,0) == 1)
    assert(cmd(c,41,0x40000000) == 0)
    assert(cmd(c,24,9) == 0)
    exchange(c,0xfe)
    for i in 0..<100 do exchange(c,0x5a)
    assert(c.spi.write_stage == Block && c.spi.data_count == 100 && c.spi.write_sector == 9)
    reset(c)
    assert(c.spi.write_stage == NoWrite)
    assert(c.spi.data_count == 0)
    assert(c.spi.write_sector == 0)
    for i in 0..<514 do assert(c.spi.data[i] == 0)
    assert(c.spi.reply.is_empty())
    assert(c.spi.output == 0xff && c.spi.idle && !c.spi.crc && c.spi.clocks == 0)
    assert(c.busy_until == 0 && c.stats.commands == 0 && c.stats.writes == 0)
    assert(c.sectors == 32768 && c.program_ticks == 0,"the configuration survives a reset")

@test("SD reset: after a reset mid-block the card answers a fresh command, not the stale block")
reset_then_command()
    val bytes: Buf[u8] = buf()
    for i in 0..<512 do bytes.push(0)
    val c = card(media_of(bytes),32768,program_ticks = 0)
    for i in 0..<10 do exchange(c,0xff,false)
    assert(cmd(c,0,0,0x95) == 1)
    assert(cmd(c,55,0) == 1)
    assert(cmd(c,41,0x40000000) == 0)
    assert(cmd(c,24,9) == 0)
    exchange(c,0xfe)
    for i in 0..<100 do exchange(c,0x5a)
    reset(c)
    assert(cmd(c,0,0,0x95) == 0xff,"a reset card needs its power-up clocks again")
    for i in 0..<10 do exchange(c,0xff,false)
    assert(cmd(c,0,0,0x95) == 1)
    assert(c.stats.writes == 0 && bytes[0] == 0)

@test("SD SPI: a reply longer than one byte is drained in order and then reads busy or idle")
reply_drains_in_order()
    val bytes: Buf[u8] = buf()
    for i in 0..<512 do bytes.push(0)
    val c = card(media_of(bytes),32768,program_ticks = 0)
    for i in 0..<10 do exchange(c,0xff,false)
    assert(cmd(c,0,0,0x95) == 1)
    assert(cmd(c,8,0x1aa,0x87) == 1)
    assert(exchange(c,0xff) == 0)
    assert(exchange(c,0xff) == 0)
    assert(exchange(c,0xff) == 1)
    assert(exchange(c,0xff) == 0xaa)
    assert(exchange(c,0xff) == 0xff,"an empty reply reads idle")
    assert(c.spi.reply.is_empty())
