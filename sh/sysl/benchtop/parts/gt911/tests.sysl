module sh.sysl.benchtop.parts.gt911
@tests

private seek(t: &Touch, address: u16)
    start(t, false)
    assert(write(t, u8(address >> 8)))
    assert(write(t, u8(address)))
    start(t, true)

private status(t: &Touch) -> u8
    seek(t, 0x814E)
    read(t)

private ack(t: &Touch)
    seek(t, 0x814E)
    write(t, 0)

@test("GT911: register pointer, identity, little-endian contact report and explicit ready acknowledgement")
report()
    val t = touch(480, 320)
    seek(t, 0x8140)
    for byte in [u8('9'),u8('1'),u8('1'),0] do assert(read(t) == byte)
    assert(status(t) == 0)
    point(t, 999, 999, true)
    assert(status(t) == 0x81)
    val bytes: [8]u8 = [0,0xDF,1,0x3F,1,8,0,0]
    for byte in bytes do assert(read(t) == byte)
    point(t, 10, 20, false)
    assert(status(t) == 0x81, "unacknowledged report is stable")
    ack(t)
    assert(status(t) == 0x80, "release is a ready zero-contact report")
    ack(t)
    assert(status(t) == 0)

@test("GT911: quick taps survive redraws, drag reports coalesce and history remains bounded")
events()
    val t = touch()
    point(t, 10, 10, true)
    for x in 11..<100 do point(t, x, 10, true)
    assert(t.reports.len() == 2)
    assert(status(t) == 0x81)
    assert(read(t) == 0 && read(t) == 10)
    ack(t)
    assert(status(t) == 0x81)
    assert(read(t) == 0 && read(t) == 99)
    ack(t)
    point(t, -1, -1, false)
    assert(status(t) == 0x80)
    ack(t)
    for i in 0..<30 do point(t, i, i, (i & 1) == 0)
    assert(t.reports.len() == 8 && !t.physical.down)
    for i in 0..<7 do ack(t)
    assert(status(t) == 0x80, "overflow still delivers the final release")

@test("GT911: a full queue drops its oldest report, and the newest eight arrive in order")
queue_drops_oldest()
    val t = touch()
    for i in 0..<10 do point(t, i, 0, (i & 1) == 0)
    assert(t.reports.len() == 8)
    for i in 2..<10
        assert(status(t) == (if (i & 1) == 0 then 0x81 else 0x80), s"report $i")
        ack(t)
    assert(status(t) == 0, "the queue is empty")

@test("GT911: a boot drops pending reports and the contact, and keeps the configured size")
boot_keeps_configuration()
    val t = touch(320, 200)
    point(t, 5, 5, true)
    point(t, 5, 5, false)
    seek(t, 0x8047)
    boot(t)
    assert(t.reports.is_empty() && t.pointer == 0 && t.address_bytes == 0 && !t.physical.down)
    assert(t.width == 320 && t.height == 200 && t.config[1] == 64)
    assert(status(t) == 0)

@test("GT911: checksummed configuration changes coordinate range; invalid configuration is ignored")
configuration()
    val t = touch()
    var sum: u32 = 0
    seek(t, 0x8047)
    for i in 0..<185 do sum += u32(read(t))
    assert((sum & 255) == 0)
    var config = t.config
    config[1] = 64
    config[2] = 1 // Width 320.
    sum = 0
    for i in 0..<184 do sum += u32(config[i])
    config[184] = u8(0u32 - sum)
    config[185] = 1
    seek(t, 0x8047)
    for byte in config do write(t, byte)
    assert(t.width == 320 && t.config[185] == 0)
    config[1] = 99 // Deliberately stale checksum.
    seek(t, 0x8047)
    for byte in config do write(t, byte)
    assert(t.width == 320)
