module sh.sysl.benchtop.parts.gt911

import sysl.container.ring.InlineRing
import sysl.math.{min, max}

// The GT911's registers (Goodix's programming guide).
const COMMAND: u16 = 0x8040
const COMMAND_SCREEN_OFF: u8 = 5
// The configuration block, CONFIG_VERSION through CONFIG_FRESH: 184 bytes of settings, the checksum
// that makes them sum to zero, and the flag that applies them.
const CONFIG_FIRST: u16 = 0x8047
const CONFIG_LAST: u16 = 0x8100
const CONFIG_FRESH: u16 = 0x8100
const CONFIG_BYTES: usize = 186
const CONFIG_CHECKSUM: usize = 184
const CONFIG_FRESH_INDEX: usize = 185
// Settings within the block: the version, the X and Y output maxima (little-endian) and the
// number of touch points.
const CONFIG_VERSION: usize = 0
const X_OUTPUT_MAX: usize = 1
const Y_OUTPUT_MAX: usize = 3
const TOUCH_NUMBER: usize = 5
const VERSION: u8 = 0x41
// PRODUCT_ID, four ASCII bytes, and the firmware version, low byte first.
const PRODUCT_ID: u16 = 0x8140
const PRODUCT_ID_LAST: u16 = 0x8143
const FIRMWARE_LOW: u16 = 0x8144
const FIRMWARE_HIGH: u16 = 0x8145
const FIRMWARE: u16 = 0x1060
// STATUS: bit 7 says a report is ready (the host writes 0 to take it), bits 3:0 count its points.
const STATUS: u16 = 0x814e
const STATUS_READY: u8 = 0x80
// The first point's record: track id, X and Y little-endian, and the contact size.
const POINT1_TRACK_ID: u16 = 0x814f
const POINT1_X_LOW: u16 = 0x8150
const POINT1_X_HIGH: u16 = 0x8151
const POINT1_Y_LOW: u16 = 0x8152
const POINT1_Y_HIGH: u16 = 0x8153
const POINT1_SIZE_LOW: u16 = 0x8154
// The size reported for every contact.
const CONTACT_SIZE: u8 = 8

struct Contact
    down: bool
    x: int
    y: int

/** GT911 polling profile: big-endian register addresses, little-endian coordinates,
 * ready/ack report buffer, product ID and checksummed configuration memory.
 */
struct Touch
    width: int
    height: int
    pointer: u16
    address_bytes: int
    config: [186]u8
    reports: InlineRing[Contact, 8]
    physical: Contact
    command: u8

touch(width: int = 240, height: int = 240) -> Touch
    require width > 0 && width <= 4096 && height > 0 && height <= 4096, "valid touch dimensions"
    var t: Touch
    t.width = width
    t.height = height
    t.config[CONFIG_VERSION] = VERSION
    t.config[X_OUTPUT_MAX] = u8.wrap(width)
    t.config[X_OUTPUT_MAX + 1] = u8(width >> 8)
    t.config[Y_OUTPUT_MAX] = u8.wrap(height)
    t.config[Y_OUTPUT_MAX + 1] = u8(height >> 8)
    t.config[TOUCH_NUMBER] = 1 // The model reports one contact.
    var sum: u32 = 0
    for i in 0..<CONFIG_CHECKSUM do sum += u32(t.config[i])
    // The checksum byte makes the configuration's bytes sum to 0 mod 256.
    t.config[CONFIG_CHECKSUM] = u8.wrap(0 -% sum)
    t

/** What the controller loses when its host boots: the register pointer, a half-sent address, the
 * pending reports and the contact. Its configuration memory, and the size it sets, are kept.
 */
boot(t: *Touch)
    t.pointer = 0
    t.address_bytes = 0
    t.reports.clear()
    t.physical = Contact(false, 0, 0)

/** Preserve press/release transitions while coalescing pending drag positions.
 * Reports stay stable until the host clears STATUS (0x814e). The bounded queue prevents
 * quick desktop clicks from disappearing during an SPI redraw.
 */
point(t: *Touch, x: int, y: int, down: bool)
    val next = Contact(down, max(0, min(t.width - 1, x)), max(0, min(t.height - 1, y)))
    if next.down == t.physical.down && (!down || (next.x == t.physical.x && next.y == t.physical.y)) then return
    t.physical = next
    val pending = t.reports.len()
    if pending > 1 && t.reports[pending - 1].down == down
        t.reports[pending - 1] = next
        return
    t.reports.overwrite(next)

start(t: *Touch, reading: bool)
    if !reading then t.address_bytes = 0

// The register pointer after an access: it auto-increments, wrapping from 0xffff to 0x0000.
private following(at: u16) -> u16 = at +% 1

private config_index(address: u16) -> int = int(address - CONFIG_FIRST)

write(t: *Touch, byte: u8) -> bool
    if t.address_bytes < 2
        t.pointer = if t.address_bytes == 0 then u16(byte) << 8 else t.pointer | u16(byte)
        t.address_bytes += 1
        return true
    val address = t.pointer
    t.pointer = following(address)
    if address == STATUS && byte == 0 then t.reports.pop_front()
    elif address == COMMAND then t.command = byte
    elif address >= CONFIG_FIRST && address <= CONFIG_LAST
        t.config[config_index(address)] = byte
        if address == CONFIG_FRESH && byte == 1
            var sum: u32 = 0
            for i in 0..<CONFIG_FRESH_INDEX do sum += u32(t.config[i])
            val w = int(t.config[X_OUTPUT_MAX]) | (int(t.config[X_OUTPUT_MAX + 1]) << 8)
            val h = int(t.config[Y_OUTPUT_MAX]) | (int(t.config[Y_OUTPUT_MAX + 1]) << 8)
            if sum & 255 == 0 && w > 0 && w <= 4096 && h > 0 && h <= 4096
                t.width = w
                t.height = h
                t.config[CONFIG_FRESH_INDEX] = 0
    true

read(t: *Touch) -> u8
    val address = t.pointer
    t.pointer = following(address)
    if address >= CONFIG_FIRST && address <= CONFIG_LAST then return t.config[config_index(address)]
    if address >= PRODUCT_ID && address <= PRODUCT_ID_LAST
        val id: [4]u8 = [u8('9'), u8('1'), u8('1'), 0]
        return id[int(address - PRODUCT_ID)]
    if address == FIRMWARE_LOW then return u8(FIRMWARE & 0xff)
    if address == FIRMWARE_HIGH then return u8(FIRMWARE >> 8)
    if address == COMMAND then return t.command
    if t.command == COMMAND_SCREEN_OFF then return 0
    val report = t.reports.first() match
        Some(r) -> r
        None -> return 0
    if address == STATUS then return if report.down then STATUS_READY | 1 else STATUS_READY
    if !report.down then return 0
    address match
        POINT1_TRACK_ID -> 0
        POINT1_X_LOW -> u8.wrap(report.x)
        POINT1_X_HIGH -> u8(report.x >> 8)
        POINT1_Y_LOW -> u8.wrap(report.y)
        POINT1_Y_HIGH -> u8(report.y >> 8)
        POINT1_SIZE_LOW -> CONTACT_SIZE
        _ -> 0
