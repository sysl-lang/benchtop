module sh.sysl.benchtop.parts.ws2812
@tests

// A clock whose ticks are nanoseconds.
private const NS: u64 = 1000000000

// A bit sent from `at`: high for `high` ns, then low for the rest of a 1.25 µs bit. Answers where it ends.
private bit(c: *Chain, at: u64, high: u64) -> u64
    edge(c, true, at, NS)
    edge(c, false, at + high, NS)
    at + 1250

// The 24 bits of `grb`, most significant first, as pico-examples' ws2812.pio times them at 800 kHz: a 0
// high for 2 of its 10 cycles and a 1 for 7.
private word(c: *Chain, at: u64, grb: u32) -> u64
    var t = at
    for i in 0..<24
        t = bit(c, t, if (grb >> u32(23 - i)) & 1 != 0 then 875 else 250)
    t

@test("WS2812: a frame of one word shows once the line has been low for a reset, in RGB from the wire's GRB, and not before")
one_led()
    var c = chain(1)
    // Its last bit is a 0, which falls 1 µs before the bit's end.
    val fell = word(&c, 1000, 0x10FF20) - 1000
    settle(&c, fell + 49999, NS)
    assert(c.colors[0] == 0, "a low 1 ns short of a reset latches nothing")
    settle(&c, fell + 50000, NS)
    assert(c.colors[0] == 0xFF1020, s"${c.colors[0]}")

@test("WS2812: a high of 599 ns is a 0 and of 600 ns a 1, and a high longer than a reset is no bit")
sample_boundary()
    var c = chain(1)
    var t: u64 = 1000
    for i in 0..<23 do t = bit(&c, t, 599)
    t = bit(&c, t, 600)
    settle(&c, t + 60000, NS)
    assert(c.colors[0] == 0x000001, s"${c.colors[0]}")
    var d = chain(1)
    t = 1000
    edge(&d, true, t, NS)
    edge(&d, false, t + 60000, NS)
    t = word(&d, t + 61000, 0x000080)
    settle(&d, t + 60000, NS)
    assert(d.colors[0] == 0x000080, s"the long high took no bit: ${d.colors[0]}")

@test("WS2812: a chain of three takes a word each, nearest first; words past its end are passed on, and a rise after a reset starts a new frame at the first LED")
chain_of_three()
    var c = chain(3)
    var t = word(&c, 1000, 0xFF0000)
    t = word(&c, t, 0x00FF00)
    t = word(&c, t, 0x0000FF)
    t = word(&c, t, 0xFFFFFF)
    // The next frame begins with a rise after the reset: it latches the first.
    t = word(&c, t + 50000, 0x800000)
    assert(c.colors[0] == 0x00FF00 && c.colors[1] == 0xFF0000 && c.colors[2] == 0x0000FF, s"${c.colors[0]} ${c.colors[1]} ${c.colors[2]}")
    settle(&c, t + 50000, NS)
    assert(c.colors[0] == 0x008000 && c.colors[1] == 0xFF0000 && c.colors[2] == 0x0000FF, s"${c.colors[0]}")

@test("WS2812: a short frame changes only the LEDs that took a whole word; a part-word is dropped at the latch")
short_frame()
    var c = chain(3)
    var t = word(&c, 1000, 0x0000FF)
    t = word(&c, t, 0x0000FF)
    t = word(&c, t, 0x0000FF)
    settle(&c, t + 50000, NS)
    t = word(&c, t + 60000, 0xFF0000)
    for i in 0..<12 do t = bit(&c, t, 875)
    settle(&c, t + 50000, NS)
    assert(c.colors[0] == 0x00FF00 && c.colors[1] == 0x0000FF && c.colors[2] == 0x0000FF, s"${c.colors[0]} ${c.colors[1]}")
    // The part-word is gone: the next frame starts on a word boundary.
    t = word(&c, t + 60000, 0x00FF00)
    settle(&c, t + 50000, NS)
    assert(c.colors[0] == 0xFF0000, s"${c.colors[0]}")

@test("WS2812: edges are timed by the clock they come with, and power-on is dark with nothing taken")
clock_and_restart()
    // 150 MHz: 90 cycles high is 600 ns, a 1; 89 is 593 ns, a 0.
    var c = chain(1)
    var t: u64 = 1000
    for i in 0..<24
        edge(&c, true, t, 150000000)
        edge(&c, false, t + (if i == 23 then 90 else 89), 150000000)
        t += 188
    settle(&c, t + 7500, 150000000)
    assert(c.colors[0] == 1, s"${c.colors[0]}")
    restart(&c)
    assert(c.colors[0] == 0 && c.words.is_empty() && c.bits == 0 && !c.high)
    edge(&c, true, 10, 150000000)
    edge(&c, true, 20, 150000000)
    assert(c.rose == 10, "a level that does not change is no edge")
