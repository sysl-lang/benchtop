module sh.sysl.benchtop.parts.dvi
@tests

import sh.sysl.benchtop.peripheral.rp2350.tmds_encode

// The DVI monitor's decoder against the encoder HSTX and the SIO share: every byte at every balance the
// encoder can reach decodes to itself, and the four control tokens never come out of the encoder.

@test("TMDS decode (DVI 1.0 figure 3-6) inverts the encoder for all 256 bytes at each balance a run reaches; no data symbol is a control token")
dvi_tmds_round_trip()
    var balance: i32 = 0
    var seen_low: i32 = 0
    var seen_high: i32 = 0
    for round in 0u32..<64
        for v in 0u32..<256
            val d = (v * 167 + round * 29) & 0xFF
            val s = tmds_encode(&balance, u8(d))
            assert(s < 0x400 && tmds_decode(s) == d, s"0x$d at round $round: symbol 0x$s")
            assert(s != 0x354 && s != 0x0AB && s != 0x154 && s != 0x2AB, s"0x$d encoded as a control token")
            if balance < seen_low then seen_low = balance
            if balance > seen_high then seen_high = balance
    assert(seen_low < 0 && seen_high > 0, "both signs reached")
    assert(tmds_decode(0x100) == 0 && tmds_decode(0x3FF) == 0 && tmds_decode(0x200) == 0xFF && tmds_decode(0x1F0) == 0x10)

@test("the monitor locks onto the first control token and measures nothing until a whole frame has passed")
dvi_fresh()
    val m = dvi([0, 1, 2], 3, 4, 2)
    assert(m.frames == 0 && m.width == 0 && m.errors == 0 && m.clock_period == 0)
    // Random-looking levels with no token in them leave it unlocked.
    for i in 0u32..<20 do m.hstx_cycle(0, 0)
    assert(!m.locked)
