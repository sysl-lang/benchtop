module sh.sysl.benchtop.parts.ft6x06
@tests

private select(t: *Touch, register: u8)
    start(t,false)
    assert(write(t,register))
    start(t,true)

@test("FT6206: one-byte addressing, stable reports, two contact IDs, coordinate bounds and release")
focal_reports()
    var t = touch()
    select(&t,0xa8)
    assert(read(&t) == 0x11)
    point(&t,799,479,true)
    point(&t,-1,999,true,1)
    select(&t,2)
    assert(read(&t) == 2)
    assert(read(&t) == 3 && read(&t) == 31)
    point(&t,0,0,false)
    assert(read(&t) == 1 && read(&t) == 223,"a read transaction must retain its original snapshot")
    assert(read(&t) == 8 && read(&t) == 0x10)
    assert(read(&t) == 0 && read(&t) == 0)
    assert(read(&t) == 0x11 && read(&t) == 223)
    select(&t,2)
    assert(read(&t) == 1)
    assert(read(&t) == 0x80 && read(&t) == 0)
    assert(read(&t) == 0x11 && read(&t) == 223)
    point(&t,0,0,false,1)
    select(&t,2)
    assert(read(&t) == 0)

@test("FT6206: configuration readback, hibernate, read-only ID and address wrap")
focal_registers()
    var t = touch()
    start(&t,false)
    assert(write(&t,0xa8) && write(&t,0))
    select(&t,0xa8)
    assert(read(&t) == 0x11)
    start(&t,false)
    assert(write(&t,0xa5) && write(&t,3))
    point(&t,10,20,true)
    select(&t,2)
    assert(read(&t) == 0)
    start(&t,false)
    assert(write(&t,0xa5) && write(&t,0))
    select(&t,2)
    assert(read(&t) == 1)
    select(&t,255)
    assert(read(&t) == 0 && t.pointer == 0)
