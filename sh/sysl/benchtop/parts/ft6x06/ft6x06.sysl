module sh.sysl.benchtop.parts.ft6x06

import sysl.math.{min,max}

/** FT6206 polling subset: 8-bit I2C register pointer and a consistent two-contact
 * report latched for each read transaction. Gestures and interrupt output are
 * not implemented. Coordinate/contact layout follows ST's ft6x06 component.
 */
struct Contact
    down: bool
    x: int
    y: int
    event: u8

struct Touch
    width: int
    height: int
    pointer: u8
    addressing: bool
    registers: [256]u8
    report: [15]u8
    contacts: [2]Contact

touch(width: int = 800, height: int = 480) -> &Touch
    require width > 0 && width <= 4096 && height > 0 && height <= 4096, "12-bit touch coordinates"
    val t: &Touch = Touch(width,height,0,true,[0;256],[0;15],[Contact(false,0,0,0);2])
    t.registers[0xa8] = 0x11
    t.registers[0x88] = 10
    t

point(t: &Touch, x: int, y: int, down: bool, id: int = 0)
    require id >= 0 && id < 2, "two FT6206 contacts"
    val old = t.contacts[id]
    t.contacts[id] = Contact(down,max(0,min(t.width - 1,x)),max(0,min(t.height - 1,y)),if down then (if old.down then 2 else 0) else 1)

start(t: &Touch, reading: bool)
    if !reading
        t.addressing = true
        return
    t.report = [0;15]
    if t.registers[0xa5] == 3 then return
    var count = 0
    for id in 0..<2
        val p = t.contacts[id]
        if !p.down then continue
        val at = 3 + count * 6
        t.report[at] = (p.event << 6) | u8(p.x >> 8)
        t.report[at + 1] = u8(p.x)
        t.report[at + 2] = (u8(id) << 4) | u8(p.y >> 8)
        t.report[at + 3] = u8(p.y)
        t.report[at + 4] = 8
        t.report[at + 5] = 0x10
        count += 1
        t.contacts[id].event = 2
    t.report[2] = u8(count)

write(t: &Touch, byte: u8) -> bool
    if t.addressing
        t.pointer = byte
        t.addressing = false
    else
        val at = t.pointer
        if at == 0 || (at >= 0x80 && at <= 0x96) || at == 0xa4 || at == 0xa5 then t.registers[at] = byte
        t.pointer += 1
    true

read(t: &Touch) -> u8
    val at = t.pointer
    t.pointer += 1
    if at > 0 && at < 15 then t.report[at] else t.registers[at]
