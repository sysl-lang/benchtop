module sh.sysl.benchtop.parts.ft6x06

import sysl.math.{min,max}

/** FT6206 polling subset: 8-bit I2C register pointer and a consistent two-contact
 * report latched for each read transaction. Gestures and interrupt output are
 * not implemented. Coordinate/contact layout follows ST's ft6x06 component.
 */

// The FT6x06's registers (FocalTech's application note, ST's ft6x06_reg.h names).
const DEV_MODE: u8 = 0x00
const TD_STATUS: u8 = 0x02
// The touch report: TD_STATUS, then one six-byte record per contact from P1_XH.
const P1_XH: u8 = 0x03
const REPORT_BYTES: u8 = 15
// A contact record's bytes, from its XH: XH carries the event flag in bits 7:6, YH the touch id in
// bits 7:4.
const P_XL: usize = 1
const P_YH: usize = 2
const P_YL: usize = 3
const P_WEIGHT: usize = 4
const P_MISC: usize = 5
const CONTACT_BYTES: usize = 6
const EVENT_SHIFT: u8 = 6
const ID_SHIFT: u8 = 4
// What the model reports for every contact: a pressure of 8 and an area of 1 (MISC bits 7:4).
const WEIGHT: u8 = 8
const AREA: u8 = 0x10
// The event flag: put down, lifted, or in contact since the last report.
const EVENT_DOWN: u8 = 0
const EVENT_UP: u8 = 1
const EVENT_CONTACT: u8 = 2
// The threshold and timing block the host may write, TH_GROUP through the last timing register.
const TH_GROUP: u8 = 0x80
const CONFIG_LAST: u8 = 0x96
const PERIOD_ACTIVE: u8 = 0x88
const G_MODE: u8 = 0xa4
const POWER_MODE: u8 = 0xa5
const POWER_HIBERNATE: u8 = 3
const CHIP_ID: u8 = 0xa8
const FT6206_ID: u8 = 0x11

struct Contact
    down: bool
    x: int
    y: int
    event: u8

struct Touch
    width: int
    height: int
    pointer: u8
    addressing: bool
    registers: [256]u8
    report: [15]u8
    contacts: [2]Contact

touch(width: int = 800, height: int = 480) -> &Touch
    require width > 0 && width <= 4096 && height > 0 && height <= 4096, "12-bit touch coordinates"
    val t: &Touch = Touch(width,height,0,true,[0;256],[0;15],[Contact(false,0,0,0);2])
    t.registers[CHIP_ID] = FT6206_ID
    t.registers[PERIOD_ACTIVE] = 10
    t

point(t: &Touch, x: int, y: int, down: bool, id: int = 0)
    require id >= 0 && id < 2, "two FT6206 contacts"
    val old = t.contacts[id]
    val event = if down then (if old.down then EVENT_CONTACT else EVENT_DOWN) else EVENT_UP
    t.contacts[id] = Contact(down,max(0,min(t.width - 1,x)),max(0,min(t.height - 1,y)),event)

start(t: &Touch, reading: bool)
    if !reading
        t.addressing = true
        return
    t.report = [0;15]
    if t.registers[POWER_MODE] == POWER_HIBERNATE then return
    var count: usize = 0
    for id in 0..<2
        val p = t.contacts[id]
        if !p.down then continue
        val at = usize(P1_XH) + count * CONTACT_BYTES
        t.report[at] = (p.event << EVENT_SHIFT) | u8(p.x >> 8)
        t.report[at + P_XL] = u8.wrap(p.x)
        t.report[at + P_YH] = (u8(id) << ID_SHIFT) | u8(p.y >> 8)
        t.report[at + P_YL] = u8.wrap(p.y)
        t.report[at + P_WEIGHT] = WEIGHT
        t.report[at + P_MISC] = AREA
        count += 1
        t.contacts[id].event = EVENT_CONTACT
    t.report[TD_STATUS] = u8(count)

// The register pointer after an access: it auto-increments, wrapping from 0xff to 0x00.
private following(at: u8) -> u8 = at +% 1

write(t: &Touch, byte: u8) -> bool
    if t.addressing
        t.pointer = byte
        t.addressing = false
    else
        val at = t.pointer
        if at == DEV_MODE || (at >= TH_GROUP && at <= CONFIG_LAST) || at == G_MODE || at == POWER_MODE then t.registers[at] = byte
        t.pointer = following(at)
    true

read(t: &Touch) -> u8
    val at = t.pointer
    t.pointer = following(at)
    if at > DEV_MODE && at < REPORT_BYTES then t.report[at] else t.registers[at]
