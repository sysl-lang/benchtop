module sh.sysl.benchtop.parts.ssd1306
@tests

private commands(d: *Display, bytes: []const u8)
    for byte in bytes do write(d, false, byte)

@test("SSD1306 OLED: horizontal and vertical windows wrap columns and pages in controller memory")
windows()
    var d = display()
    commands(&d, [0x20,0,0x21,10,11,0x22,2,3])
    for byte in [1u8,2,3,4] do write(&d, true, byte)
    assert(d.ram[266] == 1 && d.ram[267] == 2 && d.ram[394] == 3 && d.ram[395] == 4)
    assert(d.column == 10 && d.page == 2)
    commands(&d, [0x20,1])
    for byte in [5u8,6,7,8] do write(&d, true, byte)
    assert(d.ram[266] == 5 && d.ram[394] == 6 && d.ram[267] == 7 && d.ram[395] == 8)
    assert(d.column == 10 && d.page == 2)
    commands(&d, [0x21,127,0,0x22,7,8,0x20,3]) // Invalid limits and mode leave valid configuration intact.
    assert(d.first_column == 10 && d.last_column == 11 && d.first_page == 2 && d.last_page == 3 && d.mode == 1)

@test("SSD1306 OLED: page addressing accepts high and low column commands, wraps at 127 and retains page")
page_mode()
    var d = display()
    commands(&d, [0xB7,0x17,0x0F])
    write(&d, true, 0xA5)
    write(&d, true, 0x5A)
    assert(d.ram[1023] == 0xA5 && d.ram[896] == 0x5A && d.page == 7 && d.column == 1)

@test("SSD1306 OLED: display on, inverse, all-on, segment remap, COM scan, start line and offset affect pixels")
pixels()
    var d = display()
    write(&d, true, 1)
    assert(!pixel(d, 0, 0))
    commands(&d, [0xAF])
    assert(pixel(d, 0, 0) && !pixel(d, 1, 0))
    commands(&d, [0xA1])
    assert(pixel(d, 127, 0) && !pixel(d, 0, 0))
    commands(&d, [0xC8])
    assert(pixel(d, 127, 63))
    commands(&d, [0xA0,0xC0,0x41])
    assert(pixel(d, 0, 63) && !pixel(d, 0, 0))
    commands(&d, [0xD3,1])
    assert(pixel(d, 0, 0))
    commands(&d, [0xA7])
    assert(!pixel(d, 0, 0) && pixel(d, 1, 0))
    commands(&d, [0xA5])
    assert(pixel(d, 0, 0) && pixel(d, 127, 63))
    commands(&d, [0xAE])
    assert(!pixel(d, 1, 0))
    assert(!pixel(d, -1, 0) && !pixel(d, 128, 0) && !pixel(d, 0, 64))

@test("SSD1306 OLED: hardware reset retains GDDRAM, clears pending commands, and restores power-up controls")
reset_controls()
    var d = display()
    commands(&d, [0xAF,0x81,200,0xA8,31])
    write(&d, true, 255)
    assert(d.contrast == 200 && d.multiplex == 31 && !pixel(d, 0, 32))
    commands(&d, [0x21,3])
    assert(d.needed == 2 && d.count == 1)
    reset(&d)
    assert(d.ram[0] == 255 && !d.enabled && d.mode == 2 && d.needed == 0 && d.multiplex == 63)
    commands(&d, [0xAF])
    assert(pixel(d, 0, 0))

@test("SSD1306 OLED: setup and unsupported scrolling parameters are consumed without becoming commands")
command_arguments()
    var d = display()
    commands(&d, [0xAF,0x26,0xAE,0xAE,0xAE,0xAE,0xAE,0xAE,0x8D,0x14,0xD5,0xAE,0xDA,0xAE,0xD9,0xAE,0xDB,0xAE])
    assert(d.enabled && d.needed == 0)
    commands(&d, [0x81])
    write(&d, true, 0xA5) // D/C data always goes to GDDRAM, including between command parameters.
    commands(&d, [55])
    assert(d.contrast == 55 && d.ram[0] == 0xA5)
