module sh.sysl.benchtop.parts.ssd1306

/** Controller memory and command decoding, independent of transport and UI. */
struct Display
    ram: [1024]u8
    enabled: bool
    inverse: bool
    entire: bool
    remap: bool
    reverse: bool
    start: u8
    offset: u8
    multiplex: u8
    contrast: u8
    mode: u8
    column: u8
    page: u8
    first_column: u8
    last_column: u8
    first_page: u8
    last_page: u8
    command: u8
    needed: int
    count: int
    arguments: [6]u8

/** Power-up RAM is deterministically blank. RES resets configuration, retaining RAM. */
display() -> Display = Display([0; 1024], false, false, false, false, false, 0, 0, 63, 127,
    2, 0, 0, 0, 127, 0, 7, 0, 0, 0, [0; 6])

reset(d: *Display)
    val ram = d.ram
    *d = display()
    d.ram = ram

write(d: *Display, data: bool, byte: u8)
    if data
        d.ram[usize(d.page) * 128 + usize(d.column)] = byte
        if d.mode == 1
            if d.page < d.last_page then d.page += 1
            else
                d.page = d.first_page
                d.column = if d.column < d.last_column then d.column + 1 else d.first_column
        elif d.mode == 0
            if d.column < d.last_column then d.column += 1
            else
                d.column = d.first_column
                d.page = if d.page < d.last_page then d.page + 1 else d.first_page
        else d.column = (d.column + 1) & 127
        return
    if d.needed > 0
        d.arguments[d.count] = byte
        d.count += 1
        if d.count == d.needed
            d.needed = 0
            arguments(d)
        return
    d.command = byte
    d.count = 0
    d.needed = byte match
        0x20 | 0x81 | 0x8D | 0xA8 | 0xD3 | 0xD5 | 0xD9 | 0xDA | 0xDB -> 1
        0x21 | 0x22 | 0xA3 -> 2
        0x26 | 0x27 -> 6
        0x29 | 0x2A -> 5
        _ -> 0
    if d.needed > 0 then return
    if byte <= 15 then d.column = (d.column & 0x70) | byte
    elif byte <= 31 then d.column = (d.column & 15) | ((byte & 7) << 4)
    elif byte >= 0x40 && byte <= 0x7F then d.start = byte & 63
    elif byte >= 0xB0 && byte <= 0xB7 then d.page = byte & 7
    else byte match
        0xA0 -> d.remap = false
        0xA1 -> d.remap = true
        0xA4 -> d.entire = false
        0xA5 -> d.entire = true
        0xA6 -> d.inverse = false
        0xA7 -> d.inverse = true
        0xAE -> d.enabled = false
        0xAF -> d.enabled = true
        0xC0 -> d.reverse = false
        0xC8 -> d.reverse = true
        _ -> ()

private arguments(d: *Display)
    val a = d.arguments[0]
    val b = d.arguments[1]
    d.command match
        0x20 -> if (a & 3) != 3 then d.mode = a & 3
        0x21 -> if a <= b && b < 128
            d.first_column = a
            d.last_column = b
            d.column = a
        0x22 -> if a <= b && b < 8
            d.first_page = a
            d.last_page = b
            d.page = a
        0x81 -> d.contrast = a
        0xA8 -> if a >= 15 && a < 64 then d.multiplex = a
        0xD3 -> d.offset = a & 63
        _ -> () // Electrical setup and unimplemented scrolling consume their arguments.

pixel(d: Display, x: int, y: int) -> bool
    if !d.enabled || x < 0 || x >= 128 || y < 0 || y >= 64 || y > int(d.multiplex) then return false
    if d.entire then return true
    val column = if d.remap then 127 - x else x
    val line = if d.reverse then int(d.multiplex) - y else y
    val row = (line + int(d.start) + 64 - int(d.offset)) % 64
    val bit = (d.ram[usize(row / 8) * 128 + usize(column)] & (1u8 << u32(row % 8))) != 0
    bit != d.inverse
