module sh.sysl.benchtop.parts.wm8994

// WM8994 control-port and AIF1 DAC2 speaker/DMIC1 ADC1 capture subset. Register addresses and
// bit definitions follow ST's WM8994 component driver. Analog stages are ideal;
// no pop delays, charge-pump/DC-servo physics, PDM bitstream, codec HPF, EQ or DRC simulation.

// The registers, by the names in Wolfson's data sheet (and ST's wm8994.h).
const SOFTWARE_RESET: u16 = 0x00
const POWER_MANAGEMENT_1: u16 = 0x01
const POWER_MANAGEMENT_2: u16 = 0x02
const POWER_MANAGEMENT_3: u16 = 0x03
const POWER_MANAGEMENT_4: u16 = 0x04
const POWER_MANAGEMENT_5: u16 = 0x05
const POWER_MANAGEMENT_6: u16 = 0x06
const LEFT_OUTPUT_VOLUME: u16 = 0x1c
const RIGHT_OUTPUT_VOLUME: u16 = 0x1d
const SPKMIXL_ATTENUATION: u16 = 0x22
const SPKMIXR_ATTENUATION: u16 = 0x23
const SPEAKER_VOLUME_LEFT: u16 = 0x26
const SPEAKER_VOLUME_RIGHT: u16 = 0x27
const OUTPUT_MIXER_1: u16 = 0x2d
const OUTPUT_MIXER_2: u16 = 0x2e
const SPEAKER_MIXER: u16 = 0x36
const ANTIPOP_2: u16 = 0x39
const CHARGE_PUMP_1: u16 = 0x4c
const CLASS_W_1: u16 = 0x51
const DC_SERVO_1: u16 = 0x54
const ANALOGUE_HP_1: u16 = 0x60
const CHIP_REVISION: u16 = 0x100
// Written by ST's driver as part of the start-up sequence; it has no name in the data sheet.
const WRITE_SEQUENCER_0: u16 = 0x102
const WRITE_SEQUENCER_CTRL_1: u16 = 0x110
const WRITE_SEQUENCER_CTRL_2: u16 = 0x111
const AIF1_CLOCKING_1: u16 = 0x200
const AIF1_CLOCKING_2: u16 = 0x201
const CLOCKING_1: u16 = 0x208
const CLOCKING_2: u16 = 0x209
const AIF1_RATE: u16 = 0x210
const AIF1_CONTROL_1: u16 = 0x300
const AIF1_CONTROL_2: u16 = 0x301
const AIF1_MASTER_SLAVE: u16 = 0x302
const AIF1_BCLK: u16 = 0x303
const AIF1ADC_LRCLK: u16 = 0x304
const AIF1DAC_LRCLK: u16 = 0x305
const AIF1_ADC1_LEFT_VOLUME: u16 = 0x400
const AIF1_ADC1_RIGHT_VOLUME: u16 = 0x401
const AIF1_DAC1_LEFT_VOLUME: u16 = 0x402
const AIF1_DAC1_RIGHT_VOLUME: u16 = 0x403
const AIF1_DAC2_LEFT_VOLUME: u16 = 0x406
const AIF1_DAC2_RIGHT_VOLUME: u16 = 0x407
const AIF1_ADC1_FILTERS: u16 = 0x410
const AIF1_DAC1_FILTERS_1: u16 = 0x420
const AIF1_DAC2_FILTERS_1: u16 = 0x422
const DAC1_LEFT_MIXER_ROUTING: u16 = 0x601
const DAC1_RIGHT_MIXER_ROUTING: u16 = 0x602
const DAC2_LEFT_MIXER_ROUTING: u16 = 0x604
const DAC2_RIGHT_MIXER_ROUTING: u16 = 0x605
const AIF1_ADC1_LEFT_MIXER_ROUTING: u16 = 0x606
const AIF1_ADC1_RIGHT_MIXER_ROUTING: u16 = 0x607
const DAC1_LEFT_VOLUME: u16 = 0x610
const DAC1_RIGHT_VOLUME: u16 = 0x611
const DAC2_LEFT_VOLUME: u16 = 0x612
const DAC2_RIGHT_VOLUME: u16 = 0x613
const GPIO_1: u16 = 0x700
// Written by ST's driver as an errata work-around; it has no name in the data sheet.
const ERRATA_817: u16 = 0x817

// What SOFTWARE_RESET reads: the device ID.
const DEVICE_ID: u16 = 0x8994
// Every volume register's VU bit: a write with it set updates the pair together.
const VOLUME_UPDATE: u16 = 0x100
// Output PGA volumes: a 6-bit gain and MUTE_N, set to play.
const PGA_VOLUME: u16 = 63
const PGA_UNMUTED: u16 = 0x40
// Digital volumes: an 8-bit gain (0xc0 is 0 dB) and, on the DAC volumes, DAC_MUTE.
const DIGITAL_VOLUME: u16 = 255
const DIGITAL_0DB: u16 = 0xc0
const DAC_MUTE: u16 = 0x200
const DAC_VOLUME_RESET: u16 = DAC_MUTE | DIGITAL_0DB
// AIF1_DACn_FILTERS_1 AIF1DACn_MUTE, set from reset.
const AIF1DAC_MUTE: u16 = 0x200

// POWER_MANAGEMENT_1: BIAS_ENA and VMID_SEL's normal setting, the outputs' enables.
const BIAS_AND_VMID: u16 = 0x3
const SPKOUTL_ENA_SHIFT: u32 = 12
const HPOUT1L_ENA: u16 = 0x200
const HPOUT1R_ENA: u16 = 0x100
// POWER_MANAGEMENT_3: the speaker PGAs (SPKLVOL_ENA at bit 8) and the output mixers.
const SPKLVOL_ENA_SHIFT: u32 = 8
const MIXOUTL_ENA: u16 = 0x20
const MIXOUTR_ENA: u16 = 0x10
// POWER_MANAGEMENT_4: AIF1 ADC1 and DMIC1, per channel.
const AIF1ADC1L_ENA: u16 = 0x200
const AIF1ADC1R_ENA: u16 = 0x100
const DMIC1L_ENA: u16 = 0x8
const DMIC1R_ENA: u16 = 0x4
// POWER_MANAGEMENT_5: the AIF1 DAC paths and the DACs.
const AIF1DAC2L_ENA: u16 = 0x800
const AIF1DAC2R_ENA: u16 = 0x400
const AIF1DAC1L_ENA: u16 = 0x200
const AIF1DAC1R_ENA: u16 = 0x100
const DAC2L_ENA: u16 = 0x8
const DAC2R_ENA: u16 = 0x4
const DAC1L_ENA: u16 = 0x2
const DAC1R_ENA: u16 = 0x1
// SPKMIXx_ATTENUATION DAC2x_SPKMIXx_VOL: 6 dB of attenuation into the speaker mixer.
const DAC2_SPKMIX_VOL: u16 = 0x40
// OUTPUT_MIXER_n: DAC1 straight to HPOUT1, or DAC1 into MIXOUT.
const DAC1_TO_HPOUT1: u16 = 0x100
const DAC1_TO_MIXOUT: u16 = 0x1
// SPEAKER_MIXER: DAC2L_TO_SPKMIXL and DAC2R_TO_SPKMIXR.
const DAC2L_TO_SPKMIXL: u16 = 0x200
const DAC2R_TO_SPKMIXR: u16 = 0x100
// CHARGE_PUMP_1 CP_ENA.
const CP_ENA: u16 = 0x8000
// ANALOGUE_HP_1: per side, RMV_SHORT, OUTP and DLY — the output stage fully up.
const HPOUT1L_STAGES: u16 = 0xe0
const HPOUT1R_STAGES: u16 = 0x0e
// AIF1_CLOCKING_1 AIF1CLK_ENA; CLOCKING_1 AIF1DSPCLK_ENA and SYSDSPCLK_ENA.
const AIF1CLK_ENA: u16 = 0x1
const DSP_CLOCKS: u16 = 0xa
// Mixer routing: AIF1DAC1x_TO_DAC1x, AIF1DAC2x_TO_DAC2x, ADC1x_TO_AIF1ADC1x.
const AIF1DAC1_TO_DAC1: u16 = 0x1
const AIF1DAC2_TO_DAC2: u16 = 0x2
const ADC1_TO_AIF1ADC1: u16 = 0x2
// AIF1_RATE AIF1_SR, bits 7:4: 8 is 48 kHz, the only rate this subset plays. It resets to 48 kHz
// with AIF1CLK_RATE 3 (256 fs).
const AIF1_SR_SHIFT: u32 = 4
const AIF1_SR_48K: u16 = 8
const AIF1_RATE_RESET: u16 = 0x83
// AIF1_CONTROL_1: AIF1_WL (bits 6:5: 16, 20, 24 or 32 bits), AIF1_FMT (bits 4:3: 0 right-justified,
// 1 left-justified, 2 I2S, 3 DSP) and AIF1_BCLK_INV. It resets to 16-bit I2S.
const AIF1_WL_SHIFT: u32 = 5
const AIF1_FMT_SHIFT: u32 = 3
const AIF1_FMT_I2S: u16 = 2
const AIF1_BCLK_INV: u16 = 0x100
const AIF1_CONTROL_1_RESET: u16 = 0x10

struct Codec
    regs: [4096]u16
    pointer: u16
    stage: u32
    high: u8
    read_low: bool
    speaker: [2]u16
    dac: [2]u16
    aif: [2]u16
    adc: [2]u16
    headphone: [2]u16
    dac1: [2]u16
    aif1: [2]u16

codec() -> &Codec
    val c: &Codec = Codec([0;4096],0,0,0,false,[0;2],[DAC_VOLUME_RESET;2],[DIGITAL_0DB;2],[DIGITAL_0DB;2],[0;2],
        [DAC_VOLUME_RESET;2],[DIGITAL_0DB;2])
    reset(c)
    c

reset(c: &Codec)
    for i in 0..<c.regs.len do c.regs[i] = 0
    c.regs[SOFTWARE_RESET] = DEVICE_ID
    c.regs[CHIP_REVISION] = 0
    c.regs[AIF1_RATE] = AIF1_RATE_RESET
    c.regs[AIF1_CONTROL_1] = AIF1_CONTROL_1_RESET
    c.regs[AIF1_DAC2_LEFT_VOLUME] = DIGITAL_0DB
    c.regs[AIF1_DAC2_RIGHT_VOLUME] = DIGITAL_0DB
    c.regs[AIF1_DAC2_FILTERS_1] = AIF1DAC_MUTE
    c.regs[DAC2_LEFT_VOLUME] = DAC_VOLUME_RESET
    c.regs[DAC2_RIGHT_VOLUME] = DAC_VOLUME_RESET
    c.pointer = 0
    c.stage = 0
    c.high = 0
    c.read_low = false
    c.speaker = [0;2]
    c.dac = [DAC_VOLUME_RESET;2]
    c.aif = [DIGITAL_0DB;2]
    c.adc = [DIGITAL_0DB;2]
    c.regs[AIF1_ADC1_LEFT_VOLUME] = DIGITAL_0DB
    c.regs[AIF1_ADC1_RIGHT_VOLUME] = DIGITAL_0DB
    c.headphone = [0;2]
    c.dac1 = [DAC_VOLUME_RESET;2]
    c.aif1 = [DIGITAL_0DB;2]
    c.regs[DAC1_LEFT_VOLUME] = DAC_VOLUME_RESET
    c.regs[DAC1_RIGHT_VOLUME] = DAC_VOLUME_RESET
    c.regs[AIF1_DAC1_LEFT_VOLUME] = DIGITAL_0DB
    c.regs[AIF1_DAC1_RIGHT_VOLUME] = DIGITAL_0DB
    c.regs[AIF1_DAC1_FILTERS_1] = AIF1DAC_MUTE

private known(reg: u16) -> bool = reg match
    SOFTWARE_RESET | POWER_MANAGEMENT_1 | POWER_MANAGEMENT_2 | POWER_MANAGEMENT_3 | POWER_MANAGEMENT_4 |
    POWER_MANAGEMENT_5 | POWER_MANAGEMENT_6 | LEFT_OUTPUT_VOLUME | RIGHT_OUTPUT_VOLUME | SPKMIXL_ATTENUATION |
    SPKMIXR_ATTENUATION | SPEAKER_VOLUME_LEFT | SPEAKER_VOLUME_RIGHT | OUTPUT_MIXER_1 | OUTPUT_MIXER_2 |
    SPEAKER_MIXER | ANTIPOP_2 | CHARGE_PUMP_1 | CLASS_W_1 | DC_SERVO_1 | ANALOGUE_HP_1 | CHIP_REVISION |
    WRITE_SEQUENCER_0 | WRITE_SEQUENCER_CTRL_1 | WRITE_SEQUENCER_CTRL_2 | AIF1_CLOCKING_1 | AIF1_CLOCKING_2 |
    CLOCKING_1 | CLOCKING_2 | AIF1_RATE | AIF1_CONTROL_1 | AIF1_CONTROL_2 | AIF1_MASTER_SLAVE | AIF1_BCLK |
    AIF1ADC_LRCLK | AIF1DAC_LRCLK | AIF1_DAC1_LEFT_VOLUME | AIF1_DAC1_RIGHT_VOLUME | AIF1_ADC1_LEFT_VOLUME |
    AIF1_ADC1_RIGHT_VOLUME | AIF1_ADC1_FILTERS | AIF1_ADC1_LEFT_MIXER_ROUTING | AIF1_ADC1_RIGHT_MIXER_ROUTING |
    AIF1_DAC2_LEFT_VOLUME | AIF1_DAC2_RIGHT_VOLUME | AIF1_DAC1_FILTERS_1 | AIF1_DAC2_FILTERS_1 |
    DAC1_LEFT_MIXER_ROUTING | DAC1_RIGHT_MIXER_ROUTING | DAC2_LEFT_MIXER_ROUTING | DAC2_RIGHT_MIXER_ROUTING |
    DAC1_LEFT_VOLUME | DAC1_RIGHT_VOLUME | DAC2_LEFT_VOLUME | DAC2_RIGHT_VOLUME | GPIO_1 | ERRATA_817 -> true
    _ -> false

// A volume pair's left and right registers, latched together when a write to either sets VU.
private latched(reg: u16, value: u16, left: u16) -> bool =
    (reg == left || reg == left + 1) && value & VOLUME_UPDATE != 0

write_register(c: &Codec, reg: u16, value: u16) -> bool
    if !known(reg) then return false
    if reg == SOFTWARE_RESET
        reset(c)
        return true
    if reg == CHIP_REVISION then return true // Chip revision is read-only.
    // First playback subset: 48kHz.
    if reg == AIF1_RATE && (value >> AIF1_SR_SHIFT) & 15 != AIF1_SR_48K then return false
    if reg == AIF1_MASTER_SLAVE && value != 0 then return false // Codec is an audio slave.
    // I2S or DSP framing only, with the bit clock not inverted.
    if reg == AIF1_CONTROL_1 && ((value >> AIF1_FMT_SHIFT) & 3 < AIF1_FMT_I2S || value & AIF1_BCLK_INV != 0) then return false
    if reg == AIF1_ADC1_FILTERS && value != 0 then return false // Codec HPF is outside this subset.
    c.regs[reg] = value
    if latched(reg,value,SPEAKER_VOLUME_LEFT) then c.speaker = [c.regs[SPEAKER_VOLUME_LEFT],c.regs[SPEAKER_VOLUME_RIGHT]]
    if latched(reg,value,DAC2_LEFT_VOLUME) then c.dac = [c.regs[DAC2_LEFT_VOLUME],c.regs[DAC2_RIGHT_VOLUME]]
    if latched(reg,value,AIF1_DAC2_LEFT_VOLUME) then c.aif = [c.regs[AIF1_DAC2_LEFT_VOLUME],c.regs[AIF1_DAC2_RIGHT_VOLUME]]
    if latched(reg,value,LEFT_OUTPUT_VOLUME) then c.headphone = [c.regs[LEFT_OUTPUT_VOLUME],c.regs[RIGHT_OUTPUT_VOLUME]]
    if latched(reg,value,DAC1_LEFT_VOLUME) then c.dac1 = [c.regs[DAC1_LEFT_VOLUME],c.regs[DAC1_RIGHT_VOLUME]]
    if latched(reg,value,AIF1_DAC1_LEFT_VOLUME) then c.aif1 = [c.regs[AIF1_DAC1_LEFT_VOLUME],c.regs[AIF1_DAC1_RIGHT_VOLUME]]
    if latched(reg,value,AIF1_ADC1_LEFT_VOLUME) then c.adc = [c.regs[AIF1_ADC1_LEFT_VOLUME],c.regs[AIF1_ADC1_RIGHT_VOLUME]]
    true

start(c: &Codec, reading: bool)
    c.read_low = false
    if !reading then c.stage = 0

// 16-bit register address and 16-bit data, most-significant byte first. A
// repeated START for reading preserves the pointer; bursts increment by words.
write(c: &Codec, byte: u8) -> bool
    c.stage match
        0 ->
            c.pointer = u16(byte) << 8
            c.stage = 1
        1 ->
            c.pointer |= u16(byte)
            if !known(c.pointer) then return false
            c.stage = 2
        2 ->
            c.high = byte
            c.stage = 3
        _ ->
            val reg = c.pointer
            if !write_register(c,reg,(u16(c.high) << 8) | u16(byte)) then return false
            c.pointer = following(reg)
            c.stage = 2
    true

// The register address after a word: it auto-increments, wrapping from 0xffff to 0x0000.
private following(reg: u16) -> u16 = u16((u32(reg) + 1) & 0xffff)

read(c: &Codec) -> u8
    val value: u16 = if known(c.pointer) then c.regs[c.pointer] else 0
    val result = if c.read_low then u8(value & 255) else u8(value >> 8)
    if c.read_low then c.pointer = following(c.pointer)
    c.read_low = !c.read_low
    result

word_bits(c: &Codec) -> u32 = [16u32,20,24,32][usize((c.regs[AIF1_CONTROL_1] >> AIF1_WL_SHIFT) & 3)]

// The core of every path: VMID and bias up, AIF1's clock and the DSP clocks running.
private clocked(c: &Codec) -> bool =
    c.regs[POWER_MANAGEMENT_1] & BIAS_AND_VMID == BIAS_AND_VMID && c.regs[AIF1_CLOCKING_1] & AIF1CLK_ENA != 0 &&
        c.regs[CLOCKING_1] & DSP_CLOCKS == DSP_CLOCKS

// Q16 volume tables avoid host floating-point work (and FPSCR pollution) in
// CPU-side I2C callbacks. The host audio consumer performs float conversion.
private val SPEAKER_GAIN: [64]u32 = [
    93,104,117,131,147,165,185,207,233,261,293,328,
    369,414,464,521,584,655,735,825,926,1039,1165,1308,
    1467,1646,1847,2072,2325,2609,2927,3285,3685,4135,4640,5206,
    5841,6554,7353,8250,9257,10387,11654,13076,14672,16462,18471,20724,
    23253,26090,29274,32846,36854,41350,46396,52057,58409,65536,73533,82505,
    92572,103868,116541,130762,
]

private val DIGITAL_GAIN: [256]u32 = [
    0,17,18,19,20,20,21,22,23,24,25,26,
    28,29,30,31,33,34,36,37,39,41,43,44,
    46,48,51,53,55,58,60,63,66,68,71,75,
    78,81,85,89,93,97,101,105,110,115,120,125,
    131,137,143,149,155,162,169,177,185,193,201,210,
    220,229,239,250,261,272,284,297,310,324,338,353,
    369,385,402,419,438,457,478,499,521,544,568,593,
    619,646,674,704,735,768,802,837,874,912,953,995,
    1039,1085,1132,1182,1234,1289,1346,1405,1467,1532,1599,1670,
    1744,1821,1901,1985,2072,2164,2259,2359,2463,2572,2685,2804,
    2927,3057,3191,3332,3479,3633,3793,3960,4135,4317,4508,4707,
    4915,5131,5358,5594,5841,6099,6368,6649,6942,7248,7568,7902,
    8250,8614,8995,9391,9806,10238,10690,11162,11654,12168,12705,13266,
    13851,14462,15100,15766,16462,17188,17947,18738,19565,20428,21329,22270,
    23253,24279,25350,26469,27636,28856,30129,31458,32846,34295,35808,37388,
    39037,40760,42558,44435,46396,48443,50580,52812,55142,57574,60115,62767,
    65536,68427,71446,74598,77890,81326,84914,88660,92572,96656,100921,105373,
    110022,114876,119944,125236,130762,136531,142554,148844,155410,162267,169426,176901,
    184706,192855,201363,210247,219523,229208,239321,249879,260904,272414,284433,296982,
    310084,323765,338049,352964,368536,384795,401772,419498,438006,457330,477507,498574,
    520571,543538,567518,592557,618700,645996,674497,704255,735326,767768,801641,837009,
    873937,912494,952752,994787,
]

speaker_gains(c: &Codec) -> [2]u32
    var gains: [2]u32 = [0,0]
    if !clocked(c) || c.regs[AIF1_DAC2_FILTERS_1] & AIF1DAC_MUTE != 0 then return gains
    for channel in 0usize..<2
        // Channel 0 requires DAC2's right-hand enables and channel 1 its left-hand ones.
        val power = if channel == 0 then AIF1DAC2R_ENA | DAC2R_ENA else AIF1DAC2L_ENA | DAC2L_ENA
        val mixer = if channel == 0 then DAC2L_TO_SPKMIXL else DAC2R_TO_SPKMIXR
        val output = c.regs[POWER_MANAGEMENT_1] & (1u16 << (SPKOUTL_ENA_SHIFT + u32(channel)))
        if output == 0 || c.regs[POWER_MANAGEMENT_3] & (1u16 << (SPKLVOL_ENA_SHIFT + u32(channel))) == 0 then continue
        if c.regs[POWER_MANAGEMENT_5] & power != power || c.regs[SPEAKER_MIXER] & mixer == 0 then continue
        if c.regs[DAC2_LEFT_MIXER_ROUTING + u16(channel)] & AIF1DAC2_TO_DAC2 == 0 then continue
        if c.speaker[channel] & PGA_UNMUTED == 0 || c.dac[channel] & DAC_MUTE != 0 then continue
        var gain = (u64(SPEAKER_GAIN[usize(c.speaker[channel] & PGA_VOLUME)]) * u64(DIGITAL_GAIN[usize(c.dac[channel] & DIGITAL_VOLUME)])) >> 16
        gain = (gain * u64(DIGITAL_GAIN[usize(c.aif[channel] & DIGITAL_VOLUME)])) >> 16
        if c.regs[SPKMIXL_ATTENUATION + u16(channel)] & DAC2_SPKMIX_VOL != 0 then gain >>= 1
        gains[channel] = u32(gain)
    gains

// DMIC1 -> AIF1 ADC1, left/right in slots0/2. Mono host input feeds both
// microphone channels after ideal PDM decimation; no bitstream/analog model.
capture_gains(c: &Codec) -> [2]u32
    var gains: [2]u32 = [0,0]
    if !clocked(c) then return gains
    for channel in 0usize..<2
        val power = if channel == 0 then AIF1ADC1L_ENA | DMIC1L_ENA else AIF1ADC1R_ENA | DMIC1R_ENA
        if c.regs[POWER_MANAGEMENT_4] & power != power then continue
        if c.regs[AIF1_ADC1_LEFT_MIXER_ROUTING + u16(channel)] & ADC1_TO_AIF1ADC1 == 0 then continue
        gains[channel] = DIGITAL_GAIN[usize(c.adc[channel] & DIGITAL_VOLUME)]
    gains

// DAC1 -> HPOUT1, direct or through MIXOUT. Analog stages are idealized;
// firmware must still enable the charge pump, servo, stages and remove clamps.
headphone_gains(c: &Codec) -> [2]u32
    var gains: [2]u32 = [0,0]
    if !clocked(c) || c.regs[AIF1_DAC1_FILTERS_1] & AIF1DAC_MUTE != 0 || c.regs[CHARGE_PUMP_1] & CP_ENA == 0 then return gains
    for channel in 0usize..<2
        val power = if channel == 0 then AIF1DAC1L_ENA | DAC1L_ENA else AIF1DAC1R_ENA | DAC1R_ENA
        val analog = if channel == 0 then HPOUT1L_STAGES else HPOUT1R_STAGES
        val mixer = if channel == 0 then MIXOUTL_ENA else MIXOUTR_ENA
        val output = if channel == 0 then HPOUT1L_ENA else HPOUT1R_ENA
        if c.regs[POWER_MANAGEMENT_1] & output == 0 || c.regs[POWER_MANAGEMENT_5] & power != power then continue
        if c.regs[DAC1_LEFT_MIXER_ROUTING + u16(channel)] & AIF1DAC1_TO_DAC1 == 0 then continue
        // DC_SERVO_1 DCS_ENA_CHAN_0 and _1, one bit per side.
        if c.regs[ANALOGUE_HP_1] & analog != analog || c.regs[DC_SERVO_1] & (1u16 << u32(channel)) == 0 then continue
        val route = c.regs[OUTPUT_MIXER_1 + u16(channel)]
        if route & DAC1_TO_HPOUT1 == 0 && (route & DAC1_TO_MIXOUT == 0 || c.regs[POWER_MANAGEMENT_3] & mixer == 0) then continue
        if c.headphone[channel] & PGA_UNMUTED == 0 || c.dac1[channel] & DAC_MUTE != 0 then continue
        var gain = (u64(SPEAKER_GAIN[usize(c.headphone[channel] & PGA_VOLUME)]) * u64(DIGITAL_GAIN[usize(c.dac1[channel] & DIGITAL_VOLUME)])) >> 16
        gain = (gain * u64(DIGITAL_GAIN[usize(c.aif1[channel] & DIGITAL_VOLUME)])) >> 16
        gains[channel] = u32(gain)
    gains
