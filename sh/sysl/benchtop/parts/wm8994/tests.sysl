module sh.sysl.benchtop.parts.wm8994
@tests

private powered() -> &Codec
    val c = codec()
    for pair in [(1u16,0x3003u16),(3,0x300),(5,0xc0c),(0x200,1),(0x208,10),(0x604,2),(0x605,2),(0x36,0x300),(0x612,0x1c0),(0x613,0x1c0),(0x26,0x179),(0x27,0x179),(0x422,0x10)] do assert(write_register(c,pair.0,pair.1))
    c

@test("WM8994: big-endian register addressing, repeated START, bursts, ID, reset and incomplete writes")
codec_bus()
    val c = codec()
    start(c,false)
    assert(write(c,0) && write(c,0))
    start(c,true)
    assert(read(c) == 0x89 && read(c) == 0x94)
    start(c,false)
    for byte in [0u8,1,0x30,3,0x12,0x34] do assert(write(c,byte))
    assert(c.regs[1] == 0x3003 && c.regs[2] == 0x1234)
    start(c,false)
    for byte in [0u8,1,0xff] do assert(write(c,byte))
    start(c,true)
    assert(read(c) == 0x30 && read(c) == 3,"an incomplete data word cannot alter a register")
    assert(write_register(c,0,0) && c.regs[0] == 0x8994 && c.regs[1] == 0)
    assert(!write_register(c,0xffff,1) && !write_register(c,0x210,0x73) && !write_register(c,0x302,0x4000))

@test("WM8994: a read burst past the last address wraps the pointer to 0x0000")
codec_pointer_wraps()
    val c = codec()
    c.pointer = 0xffff
    start(c,true)
    assert(read(c) == 0 && read(c) == 0)
    assert(c.pointer == 0)
    assert(read(c) == 0x89 && read(c) == 0x94,"the wrapped pointer reads register 0")

@test("WM8994: a software reset mid-write returns every register, latched volume and bus stage to power-on")
codec_reset_matches_power_on()
    val fresh = codec()
    val c = powered()
    for pair in [(0x1cu16,0x179u16),(0x1d,0x179),(0x610,0x1c0),(0x611,0x1c0),(0x402,0x1c0),(0x403,0x1c0),(0x400,0x1c0),(0x401,0x1c0),(0x406,0x1c0),(0x407,0x1c0)] do assert(write_register(c,pair.0,pair.1))
    start(c,false)
    for byte in [0u8,1,0x30] do assert(write(c,byte))
    assert(c.stage == DataLow)
    assert(write_register(c,0,0))
    for i in 0..<4096 do assert(c.regs[i] == fresh.regs[i],s"register $i")
    assert(c.speaker == fresh.speaker && c.dac == fresh.dac && c.aif == fresh.aif && c.adc == fresh.adc)
    assert(c.headphone == fresh.headphone && c.dac1 == fresh.dac1 && c.aif1 == fresh.aif1)
    assert(c.stage == AddressHigh && c.pointer == 0 && !c.read_low)
    assert(fresh.dac == [0x2c0u16,0x2c0] && fresh.aif == [0xc0u16,0xc0] && fresh.speaker == [0u16,0])

@test("WM8994: speaker power, AIF clock, mixer routing and mute each gate playback")
codec_path()
    val c = powered()
    assert(speaker_gains(c) == [65536u32,65536u32])
    for pair in [(1u16,0x3003u16),(3,0x300),(5,0xc0c),(0x200,1),(0x208,10),(0x604,2),(0x605,2),(0x36,0x300)]
        assert(write_register(c,pair.0,0))
        assert(speaker_gains(c) != [65536u32,65536u32])
        assert(write_register(c,pair.0,pair.1))
    assert(write_register(c,0x422,0x200) && speaker_gains(c) == [0u32,0u32])
    assert(write_register(c,0x422,0x10) && speaker_gains(c) == [65536u32,65536u32])

@test("WM8994: power management 5's left DAC2 enables power the left speaker channel only")
codec_left_power()
    val c = powered()
    assert(write_register(c,5,0x808) && speaker_gains(c) == [65536u32,0u32])
    assert(write_register(c,5,0x800) && speaker_gains(c) == [0u32,0u32],"AIF1DAC2L without DAC2L")
    assert(write_register(c,5,0x8) && speaker_gains(c) == [0u32,0u32],"DAC2L without AIF1DAC2L")

@test("WM8994: power management 5's right DAC2 enables power the right speaker channel only")
codec_right_power()
    val c = powered()
    assert(write_register(c,5,0x404) && speaker_gains(c) == [0u32,65536u32])
    assert(write_register(c,5,0x400) && speaker_gains(c) == [0u32,0u32],"AIF1DAC2R without DAC2R")
    assert(write_register(c,5,0x4) && speaker_gains(c) == [0u32,0u32],"DAC2R without AIF1DAC2R")

@test("WM8994: paired volume update latches atomically, digital gain and word length are modeled")
codec_volume()
    val c = powered()
    assert(write_register(c,0x26,0x40 | 51))
    assert(speaker_gains(c)[0] == 65536,"VU not written yet")
    assert(write_register(c,0x27,0x100 | 0x40 | 51))
    val quieter = speaker_gains(c)
    assert(quieter[0] > 32000 && quieter[0] < 34000 && quieter[0] == quieter[1])
    assert(write_register(c,0x612,0x300 | 192) && speaker_gains(c)[0] == 0)
    for i in 0u32..<4
        assert(write_register(c,0x300,u16(0x10 | (i << 5))))
        assert(word_bits(c) == [16u32,20,24,32][usize(i)])

@test("WM8994: DMIC1 capture power, clock, channel routing and latched ADC volume")
codec_capture_path()
    val c = powered()
    assert(capture_gains(c) == [0u32,0u32])
    for pair in [(4u16,0x30cu16),(0x606,2),(0x607,2)] do assert(write_register(c,pair.0,pair.1))
    assert(capture_gains(c) == [65536u32,65536u32])
    for pair in [(1u16,0x3003u16),(4,0x30c),(0x200,1),(0x208,10),(0x606,2),(0x607,2)]
        assert(write_register(c,pair.0,0))
        assert(capture_gains(c) != [65536u32,65536u32])
        assert(write_register(c,pair.0,pair.1))
    assert(write_register(c,0x400,176))
    assert(capture_gains(c)[0] == 65536)
    assert(write_register(c,0x401,0x1b0))
    assert(capture_gains(c) == [32846u32,32846u32])
    assert(write_register(c,0x400,0x100) && capture_gains(c)[0] == 0)
    assert(!write_register(c,0x410,0x1800),"unsupported codec HPF cannot be silently enabled")
    reset(c)
    assert(capture_gains(c) == [0u32,0u32] && c.adc == [0xc0u16,0xc0u16])

private headphones_powered() -> &Codec
    val c = powered()
    for pair in [(1u16,0x3303u16),(3,0x330),(5,0xf0f),(0x601,1),(0x602,1),(0x2d,1),(0x2e,1),(0x610,0x1c0),(0x611,0x1c0),(0x1c,0x179),(0x1d,0x179),(0x4c,0x9f25),(0x54,0x33),(0x60,0xee),(0x420,0x10)] do assert(write_register(c,pair.0,pair.1))
    c

@test("WM8994 headphones: DAC1 routing, clocks, analog gates, channel mute, volume update and independent speaker output")
codec_headphone_path()
    val c = headphones_powered()
    assert(headphone_gains(c) == [65536u32,65536u32] && speaker_gains(c) == [65536u32,65536u32])
    for pair in [(1u16,0x3303u16),(3,0x330),(5,0xf0f),(0x200,1),(0x208,10),(0x601,1),(0x602,1),(0x2d,1),(0x2e,1),(0x4c,0x9f25),(0x54,0x33),(0x60,0xee),(0x420,0x10)]
        assert(write_register(c,pair.0,if pair.0 == 0x420 then 0x200 else 0))
        assert(headphone_gains(c) != [65536u32,65536u32])
        assert(write_register(c,pair.0,pair.1))
    assert(write_register(c,0x1c,0x40 | 51) && headphone_gains(c)[0] == 65536)
    assert(write_register(c,0x1d,0x100 | 0x40 | 51))
    assert(headphone_gains(c) == [32846u32,32846u32])
    assert(speaker_gains(c) == [65536u32,65536u32],"headphone volume cannot change the DAC2 speaker path")
    assert(write_register(c,0x610,0x3c0) && headphone_gains(c)[0] == 0 && headphone_gains(c)[1] > 0)
    assert(write_register(c,0x610,0x1c0))
    assert(write_register(c,3,0) && write_register(c,0x2d,0x100) && write_register(c,0x2e,0x100))
    assert(headphone_gains(c)[0] > 0 && headphone_gains(c)[1] > 0,"direct DAC1 route bypasses MIXOUT")
    reset(c)
    assert(headphone_gains(c) == [0u32,0u32])
