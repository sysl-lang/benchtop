module sh.sysl.benchtop.parts.pins

/** One terminal of a part, as the part sees it: whether anything drives it, and the level there.
 *
 * A part never sees the MCU's pin space. The board's adapter resolves each terminal's wiring — a
 * GPIO of whatever port, or nothing — into a `Line`, so a part works the same wired to `GP5` or to
 * `PI8`, and a terminal wired to nothing is `floating()`.
 */
struct Line
    driven: bool
    high: bool

/** A terminal nothing drives: wired to nothing, or to a pin that is an input. */
floating() -> Line = Line(false, false)

/** Driven, at `high`. */
driven(high: bool) -> Line = Line(true, high)

/** Driven high. */
asserted(l: Line) -> bool = l.driven && l.high

/** Driven low. */
pulled_low(l: Line) -> bool = l.driven && !l.high
