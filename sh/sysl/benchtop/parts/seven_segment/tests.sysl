module sh.sysl.benchtop.parts.seven_segment
@tests

import sh.sysl.benchtop.parts.pins.{Line, driven, floating}

// The tests wire segment bit i to bit i of a 16-bit port and digit i's common to bit 8 + i; `gpio`
// is that wiring's adapter, handing the display its own terminals and nothing else.
private gpio(d: *Display, levels: u32, drives: u32, time: u64, missing_dp: bool = false)
    var segments: [8]Line = [floating(); 8]
    var commons: [8]Line = [floating(); 8]
    for i in 0..<8
        segments[i] = at(levels, drives, i)
        commons[i] = at(levels, drives, 8 + i)
    if missing_dp then segments[7] = floating()
    observe(d, segments, commons, time)

private at(levels: u32, drives: u32, bit: int) -> Line =
    if drives & 1 << u32(bit) == 0 then floating() else driven(levels & 1 << u32(bit) != 0)

@test("seven-segment: common-cathode terminals, decimal point and continuously driven output")
cathode()
    var d = display(4, false, 100)
    gpio(&d, 0x0E00 | 0xDB, 0x0FFF, 10) // digit0 enabled; a,b,d,e,g,dp.
    assert(read(d, 0, 10) == 0xDB)
    assert(read(d, 0, 1000000) == 0xDB, "static GPIO output stays lit without refresh writes")
    for i in 1..<4 do assert(read(d, i, 10) == 0)
    gpio(&d, 0x0FFF, 0, 20)
    assert(d.enabled == 0, "input/high impedance pins cannot drive the LEDs")
    assert(read(d, 0, 121) == 0)
    assert(read(d, -1, 100) == 0 && read(d, 4, 100) == 0)

@test("seven-segment: common-anode reverses both segments and common selection")
anode()
    var d = display(4, true, 100)
    gpio(&d, 0x0200 | (0xFF ^ 0x66), 0x0FFF, 1)
    assert(read(d, 1, 1) == 0x66)
    assert(read(d, 0, 1) == 0 && read(d, 2, 1) == 0 && read(d, 3, 1) == 0)
    gpio(&d, 0x0200 | (0xFF ^ 0x06), 0x0FFF, 2)
    assert(read(d, 1, 2) == 0x06, "changing shared segment lines changes the selected digit")

@test("seven-segment: multiplexed digits retain physical segment patterns and expire on guest time")
multiplex()
    var d = display(4, false, 100)
    val patterns: [4]u8 = [0x5B, 0x3F, 0x66, 0x7F]
    for i in 0..<4
        val now = u64(i) * 10
        gpio(&d, 0x0F00, 0x0FFF, now)
        gpio(&d, 0x0F00 & ~(1 << u32(8 + i)) | u32(patterns[i]), 0x0FFF, now + 1)
    for i in 0..<4 do assert(read(d, i, 40) == patterns[i])
    gpio(&d, 0x0F00, 0x0FFF, 50)
    for i in 0..<4 do assert(read(d, i, 151) == 0)
    reset(&d)
    for i in 0..<4 do assert(read(d, i, 0) == 0)

@test("seven-segment: multiple commons, individual segment direction and missing decimal point")
physical_pins()
    var d = display(8, false, 100)
    gpio(&d, 0xFC00 | 0xFF, 0xFFFF & ~4, 10, missing_dp = true)
    assert(read(d, 0, 10) == 0x7B && read(d, 1, 10) == 0x7B)
    for i in 2..<8 do assert(read(d, i, 10) == 0)
    gpio(&d, 0xFC00 | 0xFF, 0xFFFF, 9, missing_dp = true)
    assert(d.time == 10 && read(d, 0, 9) == 0x7F, "a second core cannot rewind the component clock")

@test("seven-segment: a terminal driven to the dark level, or left floating, lights nothing")
dark_and_floating()
    var d = display(1, false, 100)
    var segments: [8]Line = [driven(true); 8]
    var commons: [8]Line = [floating(); 8]
    commons[0] = driven(true)
    observe(&d, segments, commons, 1)
    assert(d.enabled == 0, "a cathode driven high is off")
    commons[0] = driven(false)
    segments[3] = floating()
    observe(&d, segments, commons, 2)
    assert(read(d, 0, 2) == 0xF7, "a floating segment is dark")
