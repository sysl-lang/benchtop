module sh.sysl.benchtop.parts.seven_segment
@tests

private val segments: [8]int = [0, 1, 2, 3, 4, 5, 6, 7]
private val commons: [8]int = [8, 9, 10, 11, 12, 13, 14, 15]

@test("seven-segment: common-cathode terminals, decimal point and continuously driven output")
cathode()
    var d = display(4, false, 100, segments, commons)
    observe(&d, 0x0E00 | 0xDB, 0x0FFF, 10) // digit0 enabled; a,b,d,e,g,dp.
    assert(read(d, 0, 10) == 0xDB)
    assert(read(d, 0, 1000000) == 0xDB, "static GPIO output stays lit without refresh writes")
    for i in 1..<4 do assert(read(d, i, 10) == 0)
    observe(&d, 0x0FFF, 0, 20)
    assert(d.enabled == 0, "input/high impedance pins cannot drive the LEDs")
    assert(read(d, 0, 121) == 0)
    assert(read(d, -1, 100) == 0 && read(d, 4, 100) == 0)

@test("seven-segment: common-anode reverses both segments and common selection")
anode()
    var d = display(4, true, 100, segments, commons)
    observe(&d, 0x0200 | (0xFF ^ 0x66), 0x0FFF, 1)
    assert(read(d, 1, 1) == 0x66)
    assert(read(d, 0, 1) == 0 && read(d, 2, 1) == 0 && read(d, 3, 1) == 0)
    observe(&d, 0x0200 | (0xFF ^ 0x06), 0x0FFF, 2)
    assert(read(d, 1, 2) == 0x06, "changing shared segment lines changes the selected digit")

@test("seven-segment: multiplexed digits retain physical segment patterns and expire on guest time")
multiplex()
    var d = display(4, false, 100, segments, commons)
    val patterns: [4]u8 = [0x5B, 0x3F, 0x66, 0x7F]
    for i in 0..<4
        val now = u64(i) * 10
        observe(&d, 0x0F00, 0x0FFF, now)
        observe(&d, (0x0F00 & ~(1u32 << u32(8 + i))) | u32(patterns[i]), 0x0FFF, now + 1)
    for i in 0..<4 do assert(read(d, i, 40) == patterns[i])
    observe(&d, 0x0F00, 0x0FFF, 50)
    for i in 0..<4 do assert(read(d, i, 151) == 0)
    reset(&d)
    for i in 0..<4 do assert(read(d, i, 0) == 0)

@test("seven-segment: multiple commons, individual segment direction and missing decimal point")
physical_pins()
    var pins = segments
    pins[7] = -1
    var d = display(8, false, 100, pins, commons)
    observe(&d, 0xFC00 | 0xFF, 0xFFFF & ~4u32, 10)
    assert(read(d, 0, 10) == 0x7B && read(d, 1, 10) == 0x7B)
    for i in 2..<8 do assert(read(d, i, 10) == 0)
    observe(&d, 0xFC00 | 0xFF, 0xFFFF, 9)
    assert(d.time == 10 && read(d, 0, 9) == 0x7F, "a second core cannot rewind the component clock")
