module sh.sysl.benchtop.parts.seven_segment

// A pin-driven LED component. Bits a..g,dp are 0..7; no numeric value is accepted.
// Visual persistence is measured in guest cycles and never changes guest-visible state.
struct Display
    digits: int
    common_anode: bool
    persistence: u64
    segments: [8]int
    commons: [8]int
    latched: [8]u8
    seen_at: [8]u64
    seen: u32
    enabled: u32
    pattern: u8
    time: u64
    energy: [64]u64
    previous_energy: [64]u64
    epoch: u64

display(digits: int, common_anode: bool, persistence: u64, segments: [8]int, commons: [8]int) -> Display
    require digits >= 1 && digits <= 8 && persistence > 0, "valid seven-segment configuration"
    Display(digits, common_anode, persistence, segments, commons, [0; 8], [0; 8], 0, 0, 0, 0, [0; 64], [0; 64], 0)

reset(d: *Display)
    d.latched = [0; 8]
    d.seen_at = [0; 8]
    d.seen = 0
    d.enabled = 0
    d.pattern = 0
    d.time = 0
    d.energy = [0; 64]
    d.previous_energy = [0; 64]
    d.epoch = 0

private level(pin: int, levels: u32, driven: u32, active_high: bool) -> bool
    if pin < 0 || pin >= 32 then return false
    val bit = 1u32 << u32(pin)
    (driven & bit) != 0 && (((levels & bit) != 0) == active_high)

/** Called at every GPIO output/direction transition, including digit blanking. */
observe(d: *Display, levels: u32, driven: u32, time: u64)
    val now = if time < d.time then d.time else time
    integrate(d, now)
    // The old pins remained driven right up to this transition.
    for i in 0..<d.digits
        if (d.enabled & (1u32 << u32(i))) != 0
            d.latched[i] = d.pattern
            d.seen_at[i] = now
            d.seen |= 1u32 << u32(i)
    var pattern: u8 = 0
    for i in 0..<8
        if level(d.segments[i], levels, driven, !d.common_anode) then pattern |= 1u8 << u32(i)
    var enabled: u32 = 0
    for i in 0..<d.digits
        if level(d.commons[i], levels, driven, d.common_anode)
            enabled |= 1u32 << u32(i)
            d.latched[i] = pattern
            d.seen_at[i] = now
            d.seen |= 1u32 << u32(i)
    d.enabled = enabled
    d.pattern = pattern
    d.time = now

/** A continuously driven digit stays lit; scanned digits persist briefly after deselection. */
read(d: Display, digit: int, time: u64) -> u8
    if digit < 0 || digit >= d.digits then return 0
    val bit = 1u32 << u32(digit)
    if (d.enabled & bit) != 0 then return d.pattern
    val now = if time < d.time then d.time else time
    if (d.seen & bit) != 0 && now - d.seen_at[digit] <= d.persistence then d.latched[digit] else 0

/** Accumulate real GPIO on-time over the current and preceding display windows.
 * Large guest-time jumps cost at most two windows, regardless of elapsed time.
 */
private integrate(d: *Display, now: u64)
    if now <= d.time then return
    if now - d.time > d.persistence * 2
        d.energy = [0; 64]
        d.previous_energy = [0; 64]
        d.epoch = (now / d.persistence - 1) * d.persistence
        d.time = d.epoch
    while d.time < now
        val boundary = d.epoch + d.persistence
        val end = if now < boundary then now else boundary
        val duration = end - d.time
        for row in 0..<d.digits
            if (d.enabled & (1u32 << u32(row))) == 0 then continue
            for col in 0..<8
                if (d.pattern & (1u8 << u32(col))) != 0 then d.energy[row * 8 + col] += duration
        d.time = end
        if end == boundary
            d.previous_energy = d.energy
            d.energy = [0; 64]
            d.epoch = boundary

/** Linear 0..255 brightness from guest-cycle duty, including scan blanking and high impedance.
 * Reads advance a copy so rendering frequency cannot affect simulated hardware.
 */
brightness(d: Display, time: u64) -> [64]u8
    var copy = d
    integrate(&copy, time)
    val duration = (if copy.epoch == 0 then 0u64 else copy.persistence) + copy.time - copy.epoch
    var out: [64]u8 = [0; 64]
    if duration == 0 then return out
    for i in 0..<64
        out[i] = u8((copy.energy[i] + copy.previous_energy[i]) * 255 / duration)
    out
