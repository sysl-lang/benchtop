module sh.sysl.benchtop.parts.seven_segment

// A pin-driven LED component. Bits a..g,dp are 0..7; no numeric value is accepted.
// Visual persistence is measured in guest cycles and never changes guest-visible state.
struct Display
    digits: int
    common_anode: bool
    persistence: u64
    segments: [8]int
    commons: [8]int
    latched: [8]u8
    seen_at: [8]u64
    seen: u32
    enabled: u32
    pattern: u8
    time: u64

display(digits: int, common_anode: bool, persistence: u64, segments: [8]int, commons: [8]int) -> Display
    require digits >= 1 && digits <= 8 && persistence > 0, "valid seven-segment configuration"
    Display(digits, common_anode, persistence, segments, commons, [0; 8], [0; 8], 0, 0, 0, 0)

reset(d: *Display)
    d.latched = [0; 8]
    d.seen_at = [0; 8]
    d.seen = 0
    d.enabled = 0
    d.pattern = 0
    d.time = 0

private level(pin: int, levels: u32, driven: u32, active_high: bool) -> bool
    if pin < 0 || pin >= 32 then return false
    val bit = 1u32 << u32(pin)
    (driven & bit) != 0 && (((levels & bit) != 0) == active_high)

/** Called at every GPIO output/direction transition, including digit blanking. */
observe(d: *Display, levels: u32, driven: u32, time: u64)
    val now = if time < d.time then d.time else time
    // The old pins remained driven right up to this transition.
    for i in 0..<d.digits
        if (d.enabled & (1u32 << u32(i))) != 0
            d.latched[i] = d.pattern
            d.seen_at[i] = now
            d.seen |= 1u32 << u32(i)
    var pattern: u8 = 0
    for i in 0..<8
        if level(d.segments[i], levels, driven, !d.common_anode) then pattern |= 1u8 << u32(i)
    var enabled: u32 = 0
    for i in 0..<d.digits
        if level(d.commons[i], levels, driven, d.common_anode)
            enabled |= 1u32 << u32(i)
            d.latched[i] = pattern
            d.seen_at[i] = now
            d.seen |= 1u32 << u32(i)
    d.enabled = enabled
    d.pattern = pattern
    d.time = now

/** A continuously driven digit stays lit; scanned digits persist briefly after deselection. */
read(d: Display, digit: int, time: u64) -> u8
    if digit < 0 || digit >= d.digits then return 0
    val bit = 1u32 << u32(digit)
    if (d.enabled & bit) != 0 then return d.pattern
    val now = if time < d.time then d.time else time
    if (d.seen & bit) != 0 && now - d.seen_at[digit] <= d.persistence then d.latched[digit] else 0
