module sh.sysl.benchtop.parts.seven_segment

import sh.sysl.benchtop.parts.pins.Line
import sysl.math.{min, max}

// A pin-driven LED component. Bits a..g,dp are 0..7; no numeric value is accepted.
// Visual persistence is measured in guest cycles and never changes guest-visible state.
struct Display
    digits: int
    common_anode: bool
    persistence: u64
    latched: [8]u8
    seen_at: [8]u64
    seen: u32
    enabled: u32
    pattern: u8
    time: u64
    energy: [64]u64
    previous_energy: [64]u64
    epoch: u64

/** A dark display of `digits` digits. */
display(digits: int, common_anode: bool, persistence: u64) -> Display
    require digits >= 1 && digits <= 8 && persistence > 0, "valid seven-segment configuration"
    var d: Display
    d.digits = digits
    d.common_anode = common_anode
    d.persistence = persistence
    d

reset(d: *Display) = *d = display(d.digits, d.common_anode, d.persistence)

// Whether `l` is driven to the level that lights: high for an anode, low for a cathode.
private lit(l: Line, active_high: bool) -> bool = l.driven && l.high == active_high

/** Called at every GPIO output/direction transition, including digit blanking: `segments[i]` is
 * segment bit `i` (a..g, dp), `commons[i]` digit `i`'s common terminal, a terminal wired to nothing
 * undriven.
 */
observe(d: *Display, segments: [8]Line, commons: [8]Line, time: u64)
    val now = max(time, d.time)
    integrate(d, now)
    // The old pins remained driven right up to this transition.
    for i in 0..<d.digits
        if d.enabled & 1 << u32(i) != 0
            d.latched[i] = d.pattern
            d.seen_at[i] = now
            d.seen |= 1 << u32(i)
    var pattern: u8 = 0
    for i in 0..<8
        if lit(segments[i], !d.common_anode) then pattern |= 1 << u32(i)
    var enabled: u32 = 0
    for i in 0..<d.digits
        if lit(commons[i], d.common_anode)
            enabled |= 1 << u32(i)
            d.latched[i] = pattern
            d.seen_at[i] = now
            d.seen |= 1 << u32(i)
    d.enabled = enabled
    d.pattern = pattern
    d.time = now

/** A continuously driven digit stays lit; scanned digits persist briefly after deselection. */
read(d: Display, digit: int, time: u64) -> u8
    if digit < 0 || digit >= d.digits then return 0
    val bit = 1 << u32(digit)
    if d.enabled & bit != 0 then return d.pattern
    val now = max(time, d.time)
    if d.seen & bit != 0 && now - d.seen_at[digit] <= d.persistence then d.latched[digit] else 0

/** Accumulate real GPIO on-time over the current and preceding display windows.
 * Large guest-time jumps cost at most two windows, regardless of elapsed time.
 */
private integrate(d: *Display, now: u64)
    if now <= d.time then return
    if now - d.time > d.persistence * 2
        d.energy = [0; 64]
        d.previous_energy = [0; 64]
        d.epoch = (now / d.persistence - 1) * d.persistence
        d.time = d.epoch
    while d.time < now
        val boundary = d.epoch + d.persistence
        val end = min(now, boundary)
        val duration = end - d.time
        for row in 0..<d.digits
            if d.enabled & 1 << u32(row) == 0 then continue
            for col in 0..<8
                if d.pattern & 1 << u32(col) != 0 then d.energy[row * 8 + col] += duration
        d.time = end
        if end == boundary
            d.previous_energy = d.energy
            d.energy = [0; 64]
            d.epoch = boundary

/** Linear 0..255 brightness from guest-cycle duty, including scan blanking and high impedance.
 * Reads advance a copy so rendering frequency cannot affect simulated hardware.
 */
brightness(d: Display, time: u64) -> [64]u8
    var copy = d
    integrate(&copy, time)
    val duration = (if copy.epoch == 0 then 0u64 else copy.persistence) + copy.time - copy.epoch
    var out: [64]u8 = [0; 64]
    if duration == 0 then return out
    for i in 0..<64
        out[i] = u8((copy.energy[i] + copy.previous_energy[i]) * 255 / duration)
    out
