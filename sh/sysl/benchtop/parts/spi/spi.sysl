module sh.sysl.benchtop.parts.spi

/** Reusable active-low-CS, MSB-first, mode-0 GPIO SPI receiver. */
struct Receiver
    cs: int
    clock: int
    mosi: int
    selected: bool
    high: bool
    bits: int
    value: u8

receiver(cs: int, clock: int, mosi: int) -> Receiver
    require cs >= 0 && cs < 32 && clock >= 0 && clock < 32 && mosi >= 0 && mosi < 32, "SPI GPIOs are 0..31"
    Receiver(cs, clock, mosi, false, false, 0, 0)

reset(r: *Receiver)
    r.selected = false
    r.high = false
    r.bits = 0
    r.value = 0

observe(r: *Receiver, levels: u32, driven: u32) -> Option[u8]
    val cs = 1u32 << u32(r.cs)
    val clock = 1u32 << u32(r.clock)
    val data = 1u32 << u32(r.mosi)
    val required = cs | clock | data
    if (driven & required) != required || (levels & cs) != 0
        reset(r)
        return None
    val high = (levels & clock) != 0
    if !r.selected
        r.selected = true
        r.high = high
        return None
    val rising = high && !r.high
    r.high = high
    if !rising then return None
    r.value = (r.value << 1) | (if (levels & data) != 0 then 1 else 0)
    r.bits += 1
    if r.bits != 8 then return None
    val byte = r.value
    r.bits = 0
    r.value = 0
    Some(byte)

/** Four-wire display framing shared by OLED and TFT controller adapters. */
struct Port
    bus: Receiver
    dc: int
    reset_pin: int
    data: bool
    resetting: bool

enum Transfer
    Idle
    Reset
    Byte(data: bool, value: u8)

port(cs: int, clock: int, mosi: int, dc: int, reset_pin: int) -> Port
    require dc >= 0 && dc < 32 && reset_pin >= 0 && reset_pin < 32, "display control GPIOs are 0..31"
    Port(receiver(cs, clock, mosi), dc, reset_pin, false, false)

restart(p: *Port)
    reset(&p.bus)
    p.data = false
    p.resetting = false

transfer(p: *Port, levels: u32, driven: u32) -> Transfer
    val reset_bit = 1u32 << u32(p.reset_pin)
    val dc = 1u32 << u32(p.dc)
    if (driven & reset_bit) == 0 || (levels & reset_bit) == 0
        val first = !p.resetting
        p.resetting = true
        reset(&p.bus)
        return if first then Reset else Idle
    p.resetting = false
    val data = (levels & dc) != 0
    if (driven & dc) == 0 || (p.bus.bits != 0 && data != p.data)
        reset(&p.bus)
        return Idle
    if p.bus.bits == 0 then p.data = data
    observe(&p.bus, levels, driven) match
        Some(byte) -> Byte(p.data, byte)
        None -> Idle
