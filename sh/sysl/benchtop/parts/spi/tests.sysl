module sh.sysl.benchtop.parts.spi
@tests

private send(r: *Receiver, byte: u8) -> Option[u8]
    var result: Option[u8] = None
    observe(r, 0, 7)
    for bit in 0..<8
        val pins: u32 = if (byte & (128u8 >> u32(bit))) != 0 then 4 else 0
        observe(r, pins, 7)
        val sampled = observe(r, pins | 2, 7)
        if sampled.is_some() then result = sampled
        observe(r, pins, 7)
    result

@test("GPIO SPI: mode-zero MSB-first framing receives every byte and consecutive bytes under one selection")
bytes()
    var r = receiver(0, 1, 2)
    for n in 0..<256
        assert(send(&r, u8(n)) == Some(u8(n)))
        assert(r.bits == 0 && r.value == 0)
    observe(&r, 1, 7)
    assert(!r.selected)

@test("GPIO SPI: deselection and undriven pins abort partial frames, repeated levels do not clock data")
framing()
    var r = receiver(0, 1, 2)
    observe(&r, 0, 7)
    observe(&r, 6, 7)
    assert(r.bits == 1)
    observe(&r, 6, 7)
    observe(&r, 2, 7)
    assert(r.bits == 1)
    observe(&r, 1, 7)
    assert(r.bits == 0)
    assert(send(&r, 0xA5) == Some(0xA5u8))
    observe(&r, 2, 7)
    observe(&r, 0, 3) // MOSI not driven.
    assert(r.bits == 0 && !r.selected)
    observe(&r, 2, 7) // Selecting with clock high does not invent an edge.
    assert(r.bits == 0)
    assert(send(&r, 0x5A) == Some(0x5Au8))

private idle(t: Transfer) -> bool = t match
    Idle -> true
    _ -> false

@test("GPIO SPI: four-wire display ports isolate shared clock/data by mcu select and share reset safely")
shared_ports()
    var a = port(0,1,2,3,4)
    var b = port(5,1,2,6,4)
    // Reset is active low and is reported once while held.
    transfer(&a, 0, 127) match
        Reset -> ()
        _ -> assert(false)
    assert(idle(transfer(&a, 0, 127)))
    assert(idle(transfer(&a, 16 | 1 | 32, 127)))
    assert(idle(transfer(&b, 16 | 1 | 32, 127)))
    for select_a in [true, false]
        val base: u32 = 16 | (if select_a then 32 | 8 else 1 | 64)
        val value: u8 = if select_a then 0xA5 else 0x5A
        var received = false
        for bit in 0..<8
            val pins = base | (if (value & (128u8 >> u32(bit))) != 0 then 4 else 0)
            for levels in [pins, pins | 2, pins]
                val ta = transfer(&a, levels, 127)
                val tb = transfer(&b, levels, 127)
                val active = if select_a then ta else tb
                assert(idle(if select_a then tb else ta))
                active match
                    Byte(data, byte) ->
                        assert(data && byte == value && !received)
                        received = true
                    Idle -> ()
                    Reset -> assert(false)
        assert(received)
        transfer(&a, 16 | 1 | 32, 127)
        transfer(&b, 16 | 1 | 32, 127)

@test("GPIO SPI: changing DC or losing a driver discards a partial display byte")
control_framing()
    var p = port(0,1,2,3,4)
    transfer(&p, 16, 31)
    transfer(&p, 16 | 2, 31)
    assert(p.bus.bits == 1)
    assert(idle(transfer(&p, 16 | 8, 31)) && p.bus.bits == 0)
    transfer(&p, 16, 31)
    transfer(&p, 16 | 2, 31)
    assert(idle(transfer(&p, 16, 23)) && p.bus.bits == 0)
