module sh.sysl.benchtop.parts.spi
@tests

private send(r: *Receiver, byte: u8) -> Option[u8]
    var result: Option[u8] = None
    observe(r, 0, 7)
    for bit in 0..<8
        val pins: u32 = if (byte & (128u8 >> u32(bit))) != 0 then 4 else 0
        observe(r, pins, 7)
        val sampled = observe(r, pins | 2, 7)
        if sampled.is_some() then result = sampled
        observe(r, pins, 7)
    result

@test("GPIO SPI: mode-zero MSB-first framing receives every byte and consecutive bytes under one selection")
bytes()
    var r = receiver(0, 1, 2)
    for n in 0..<256
        assert(send(&r, u8(n)) == Some(u8(n)))
        assert(r.bits == 0 && r.value == 0)
    observe(&r, 1, 7)
    assert(!r.selected)

@test("GPIO SPI: deselection and undriven pins abort partial frames, repeated levels do not clock data")
framing()
    var r = receiver(0, 1, 2)
    observe(&r, 0, 7)
    observe(&r, 6, 7)
    assert(r.bits == 1)
    observe(&r, 6, 7)
    observe(&r, 2, 7)
    assert(r.bits == 1)
    observe(&r, 1, 7)
    assert(r.bits == 0)
    assert(send(&r, 0xA5) == Some(0xA5u8))
    observe(&r, 2, 7)
    observe(&r, 0, 3) // MOSI not driven.
    assert(r.bits == 0 && !r.selected)
    observe(&r, 2, 7) // Selecting with clock high does not invent an edge.
    assert(r.bits == 0)
    assert(send(&r, 0x5A) == Some(0x5Au8))
