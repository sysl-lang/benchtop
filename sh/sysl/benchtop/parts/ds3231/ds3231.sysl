module sh.sysl.benchtop.parts.ds3231

/** DS3231 registers and I2C state, independent of the MCU and any firmware driver. */
struct Rtc
    registers: [19]u8
    latched: [7]u8
    pointer: u8
    expecting_pointer: bool
    hz: u64
    time: u64
    remainder: u64
    temperature: int
    conversion_due: u64

bcd(n: int) -> u8 = u8((n / 10) * 16 + n % 10)
unbcd(n: u8) -> int = int(n >> 4) * 10 + int(n & 15)

rtc(hz: u64 = 12000000, year: int = 2026, month: int = 1, day: int = 1, temperature: int = 100) -> &Rtc
    require hz > 0 && year >= 2000 && year <= 2199 && month >= 1 && month <= 12 && day >= 1 && day <= days(year, month), "valid RTC epoch"
    var registers: [19]u8 = [0; 19]
    registers[3] = 1 // Day-of-week numbering is user-defined by this device.
    registers[4] = bcd(day)
    registers[5] = bcd(month) | (if year >= 2100 then 128 else 0)
    registers[6] = bcd(year % 100)
    registers[14] = 0x1C
    registers[15] = 0x88
    val r: &Rtc = Rtc(registers, [0; 7], 0, true, hz, 0, 0, temperature, 0)
    temperature_registers(r)
    latch(r)
    r

days(year: int, month: int) -> int
    if month == 2 then return if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) then 29 else 28
    if month == 4 || month == 6 || month == 9 || month == 11 then 30 else 31

private hours(value: u8) -> int
    if (value & 64) == 0 then return unbcd(value & 63)
    unbcd(value & 31) % 12 + (if (value & 32) != 0 then 12 else 0)

private encode_hour(value: int, mode: u8) -> u8
    if (mode & 64) == 0 then return bcd(value)
    64 | (if value >= 12 then 32 else 0) | bcd(if value % 12 == 0 then 12 else value % 12)

private temperature_registers(r: &Rtc)
    // Quarter-degree temperature, including negative values, as the chip's signed 10-bit result.
    val raw = u16(i16(r.temperature * 64))
    r.registers[17] = u8(raw >> 8)
    r.registers[18] = u8(raw & 0xC0)

private latch(r: &Rtc)
    for i in 0..<7 do r.latched[i] = r.registers[i]

/** An MCU reset rebases guest cycles but leaves this battery-backed part's registers intact. */
rebase(r: &Rtc, time: u64)
    val remaining = if r.conversion_due > r.time then r.conversion_due - r.time else 0
    r.time = time
    if r.conversion_due != 0 then r.conversion_due = if remaining > 0 then time + remaining else time

advance(r: &Rtc, time: u64)
    if time < r.time
        rebase(r, time)
        return
    val elapsed = time - r.time
    r.time = time
    r.remainder += elapsed
    while r.remainder >= r.hz
        r.remainder -= r.hz
        tick(r)
    if r.conversion_due != 0 && time >= r.conversion_due
        r.conversion_due = 0
        r.registers[14] &= ~32u8
        r.registers[15] &= ~4u8
        temperature_registers(r)

private tick(r: &Rtc)
    var sec = unbcd(r.registers[0]) + 1
    if sec == 60
        sec = 0
        var minute = unbcd(r.registers[1]) + 1
        if minute == 60
            minute = 0
            var hour = hours(r.registers[2]) + 1
            if hour == 24
                hour = 0
                r.registers[3] = if r.registers[3] == 7 then 1 else r.registers[3] + 1
                var day = unbcd(r.registers[4]) + 1
                var month = unbcd(r.registers[5] & 31)
                var year = 2000 + unbcd(r.registers[6]) + (if (r.registers[5] & 128) != 0 then 100 else 0)
                if day > days(year, month)
                    day = 1
                    month += 1
                    if month == 13
                        month = 1
                        year += 1
                        if year == 2200 then year = 2000
                    r.registers[5] = bcd(month) | (if year >= 2100 then 128 else 0)
                    r.registers[6] = bcd(year % 100)
                r.registers[4] = bcd(day)
            r.registers[2] = encode_hour(hour, r.registers[2])
        r.registers[1] = bcd(minute)
    r.registers[0] = bcd(sec)
    if alarm(r, 7, true) then r.registers[15] |= 1
    if sec == 0 && alarm(r, 11, false) then r.registers[15] |= 2

private alarm(r: &Rtc, base: int, seconds: bool) -> bool
    var at = base
    if seconds
        val s = r.registers[at]
        if (s & 128) == 0 && (s & 127) != r.registers[0] then return false
        at += 1
    val m = r.registers[at]
    val h = r.registers[at + 1]
    val d = r.registers[at + 2]
    if (m & 128) == 0 && (m & 127) != r.registers[1] then return false
    if (h & 128) == 0 && hours(h & 127) != hours(r.registers[2]) then return false
    if (d & 128) == 0
        val actual = if (d & 64) != 0 then r.registers[3] else r.registers[4]
        if (d & 63) != actual then return false
    true

interrupt(r: &Rtc) -> bool = (r.registers[14] & 4) != 0 && (r.registers[14] & r.registers[15] & 3) != 0

start(r: &Rtc, reading: bool, time: u64)
    advance(r, time)
    latch(r) // START/repeated START captures a coherent time/date snapshot.
    r.expecting_pointer = !reading

write(r: &Rtc, byte: u8, time: u64) -> bool
    advance(r, time)
    if r.expecting_pointer
        r.pointer = byte % 19
        r.expecting_pointer = false
        return true
    val at = r.pointer
    var value = byte
    var valid = true
    if at == 0 || at == 1
        value &= 127
        valid = (value & 15) <= 9 && unbcd(value) <= 59
    elif at == 2
        value &= 127
        val n = unbcd(value & (if (value & 64) != 0 then 31 else 63))
        valid = (value & 15) <= 9 && (if (value & 64) != 0 then n >= 1 && n <= 12 else n <= 23)
    elif at == 3
        value &= 7
        valid = value >= 1 && value <= 7
    elif at == 4
        value &= 63
        valid = (value & 15) <= 9 && unbcd(value) >= 1 && unbcd(value) <= 31
    elif at == 5
        value &= 159
        valid = (value & 15) <= 9 && unbcd(value & 31) >= 1 && unbcd(value & 31) <= 12
    elif at == 6
        valid = (value & 15) <= 9 && (value >> 4) <= 9
    if at < 14 || at == 16
        if valid then r.registers[at] = value
        if at == 0 then r.remainder = 0
    elif at == 14
        r.registers[14] = value
        if (value & 32) != 0
            r.registers[15] |= 4
            r.conversion_due = time + r.hz / 5 + 1
    elif at == 15
        val old = r.registers[15]
        r.registers[15] = (old & value & 0x83) | (value & 8) | (old & 4)
    // Temperature result is read-only.
    r.pointer = (at + 1) % 19
    if r.pointer == 0 then latch(r)
    true

read(r: &Rtc, time: u64) -> u8
    advance(r, time)
    val at = r.pointer
    val value = if at < 7 then r.latched[at] else r.registers[at]
    r.pointer = (at + 1) % 19
    if r.pointer == 0 then latch(r)
    value
