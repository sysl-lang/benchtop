module sh.sysl.benchtop.parts.ds3231
@tests

private set(r: *Rtc, address: u8, bytes: []const u8, time: u64 = 0)
    start(r, false, time)
    write(r, address, time)
    for byte in bytes do write(r, byte, time)

private get(r: *Rtc, address: u8, time: u64 = 0) -> u8
    set(r, address, [], time)
    start(r, true, time)
    read(r, time)

@test("DS3231 RTC: repeated START snapshots prevent torn time reads and register pointers wrap")
rtc_snapshot()
    var r = rtc(100)
    set(&r, 0, [0x59,0x59,0x23,7,0x31,0x12,0x26])
    set(&r, 0, [], 99)
    start(&r, true, 99)
    assert(read(&r, 101) == 0x59 && read(&r, 101) == 0x59 && read(&r, 101) == 0x23)
    assert(get(&r, 0, 101) == 0 && get(&r, 4, 101) == 1 && get(&r, 5, 101) == 1 && get(&r, 6, 101) == 0x27)
    set(&r, 18, [], 101)
    start(&r, true, 101)
    read(&r, 101)
    assert(r.pointer == 0 && read(&r, 101) == 0)

@test("DS3231 RTC: the chip's every-fourth-year rule gives 2100 a 29 February, as the real part does")
chip_leap_years()
    for year in [2100, 2196]
        var r = rtc(1, year, 2, 28)
        set(&r, 0, [0x59,0x59,0x23])
        advance(&r, 1)
        assert(unbcd(r.registers[4]) == 29, s"$year has the chip's 29 February")
        assert(unbcd(r.registers[5] & 31) == 2)
    val epoch = rtc(1, 2100, 2, 29)
    assert(unbcd(epoch.registers[4]) == 29, "29 February 2100 is a date the chip can hold")
    assert(days(2101, 2) == 28)

@test("DS3231 RTC: leap years, century rollover, 12-hour noon and midnight, day-of-week and battery-backed reset")
calendar()
    for year in [2024,2025]
        var r = rtc(1,year,2,28)
        set(&r, 0, [0x59,0x59,0x23])
        advance(&r, 1)
        assert(unbcd(r.registers[4]) == (if year == 2024 then 29 else 1))
        assert(unbcd(r.registers[5] & 31) == (if year == 2024 then 2 else 3))
    var r = rtc(1,2099,12,31)
    set(&r, 0, [0x59,0x59,0x23,7])
    advance(&r,1)
    assert(r.registers[5] == 0x81 && r.registers[6] == 0 && r.registers[3] == 1)
    set(&r,0,[0x59,0x59,0x51],1) // 11:59:59 AM.
    advance(&r,2)
    assert(r.registers[2] == 0x72)
    set(&r,0,[0x59,0x59,0x71],2) // 11:59:59 PM.
    advance(&r,3)
    assert(r.registers[2] == 0x52)
    val date = r.registers[4]
    rebase(&r,0)
    assert(r.registers[4] == date && r.registers[2] == 0x52)

@test("DS3231 RTC: alarm masks and write-zero-clear flags, read-only temperature and conversion busy behavior")
alarms_temperature()
    var r = rtc(1000,temperature = -1)
    assert(get(&r,17) == 255 && get(&r,18) == 0xC0)
    set(&r,17,[0,0])
    assert(get(&r,17) == 255)
    set(&r,7,[0x80,0x80,0x80,0x80])
    set(&r,14,[5])
    advance(&r,1000)
    assert(interrupt(&r) && (r.registers[15] & 1) != 0)
    set(&r,15,[0x88],1000)
    assert(!interrupt(&r) && (r.registers[15] & 1) == 0)
    set(&r,15,[0xFF],1000)
    assert((r.registers[15] & 1) == 0, "software cannot set alarm flags")
    set(&r,14,[0x24],1000)
    assert((r.registers[15] & 4) != 0)
    advance(&r,1201)
    assert((r.registers[15] & 4) == 0 && (r.registers[14] & 32) == 0)
    set(&r,0,[0x99],1201)
    assert(unbcd(r.registers[0]) < 60)
