module sh.sysl.benchtop.parts.hd44780

/** The GPIO each bus terminal is wired to; a number outside 0..<32 is a terminal wired to nothing,
 * which never drives the bus. `rw` is `None` on a write-only module whose RW is tied low.
 */
struct Pins
    rs: int
    rw: Option[int]
    e: int
    d: [4]int // D4, D5, D6, D7

/** Write-side HD44780 bus, DDRAM and CGRAM. GPIO time is in guest cycles. */
struct Lcd
    columns: int
    rows: int
    pins: Pins
    instruction_cycles: u64
    clear_cycles: u64
    ram: [128]u8
    cgram: [64]u8
    address: u8
    cg: bool
    four_bit: bool
    half: bool
    high: u8
    high_rs: bool
    enabled: bool
    increment: bool
    entry_shift: bool
    shift: int
    cursor: bool
    blink: bool
    previous_e: bool
    until: u64
    time: u64

/** A module at power-on: DDRAM full of spaces, cursor moving right, 8-bit interface, display off. */
lcd(columns: int, rows: int, pins: Pins, instruction_cycles: u64 = 444, clear_cycles: u64 = 18240) -> Lcd
    require columns >= 1 && columns <= 40 && rows >= 1 && rows <= 2, "supported LCD geometry"
    var d: Lcd
    d.columns = columns
    d.rows = rows
    d.pins = pins
    d.instruction_cycles = instruction_cycles
    d.clear_cycles = clear_cycles
    d.ram = [32; 128]
    d.increment = true
    d

reset(d: *Lcd)
    *d = lcd(d.columns, d.rows, d.pins, d.instruction_cycles, d.clear_cycles)

private high(p: int, levels: u32) -> bool = p >= 0 && p < 32 && levels & 1 << u32(p) != 0

/** Whether every terminal the bus needs is driven; an RW tied low needs no driver. */
private bus_driven(p: Pins, driven: u32) -> bool
    if !high(p.rs, driven) || !high(p.e, driven) then return false
    if p.rw.is_some() && !high(p.rw.unwrap(), driven) then return false
    for d in p.d do if !high(d, driven) then return false
    true

/** Only falling E edges with every bus terminal driven can latch a write. */
observe(d: *Lcd, levels: u32, driven: u32, time: u64)
    val now = if time < d.time then d.time else time
    d.time = now
    val enabled = high(d.pins.e, levels) && high(d.pins.e, driven)
    val falling = d.previous_e && !enabled
    d.previous_e = enabled
    if !falling then return
    if !bus_driven(d.pins, driven)
        d.half = false
        return
    if d.pins.rw.is_some() && high(d.pins.rw.unwrap(), levels)
        d.half = false
        return // Write-side model: RW reads do not change display memory.
    if now < d.until then return
    val rs = high(d.pins.rs, levels)
    var nibble: u8 = 0
    for bit in 0..<4 do if high(d.pins.d[bit], levels) then nibble |= 1 << u32(bit)
    if !d.four_bit
        execute(d, rs, nibble << 4, now)
    elif !d.half
        d.high = nibble << 4
        d.high_rs = rs
        d.half = true
    else
        d.half = false
        if rs == d.high_rs then execute(d, rs, d.high | nibble, now)

private step_address(d: *Lcd, right: bool)
    if d.cg
        d.address = if right then (d.address + 1) & 63 else (d.address + 63) & 63
    elif right
        d.address = if d.address == 0x27 then 0x40 elif d.address == 0x67 then 0 else (d.address + 1) & 127
    else
        d.address = if d.address == 0 then 0x67 elif d.address == 0x40 then 0x27 else (d.address + 127) & 127

private execute(d: *Lcd, rs: bool, value: u8, now: u64)
    d.until = now + d.instruction_cycles
    if rs
        if d.cg then d.cgram[d.address & 63] = value & 31
        else d.ram[d.address & 127] = value
        step_address(d, d.increment)
        if d.entry_shift && !d.cg then d.shift = (d.shift + (if d.increment then 1 else 39)) % 40
    elif (value & 128) != 0
        d.address = value & 127
        d.cg = false
    elif (value & 64) != 0
        d.address = value & 63
        d.cg = true
    elif (value & 32) != 0
        d.four_bit = (value & 16) == 0
        d.half = false
    elif (value & 16) != 0
        val right = (value & 4) != 0
        if (value & 8) != 0 then d.shift = (d.shift + (if right then 39 else 1)) % 40
        else step_address(d, right)
    elif (value & 8) != 0
        d.enabled = (value & 4) != 0
        d.cursor = (value & 2) != 0
        d.blink = (value & 1) != 0
    elif (value & 4) != 0
        d.increment = (value & 2) != 0
        d.entry_shift = (value & 1) != 0
    elif (value & 2) != 0
        d.address = 0
        d.cg = false
        d.shift = 0
        d.until = now + d.clear_cycles
    elif value == 1
        d.ram = [32; 128]
        d.address = 0
        d.cg = false
        d.shift = 0
        d.increment = true
        d.until = now + d.clear_cycles

character(d: Lcd, column: int, row: int) -> u8
    if !d.enabled || column < 0 || column >= d.columns || row < 0 || row >= d.rows then return 32
    d.ram[usize((if row == 0 then 0 else 64) + (column + d.shift) % 40)]

/** Dot columns use bit zero for the top row. ASCII shapes are independent of the host font. */
glyph(d: Lcd, code: u8) -> [5]u8
    if code < 16
        var columns: [5]u8 = [0; 5]
        for row in 0..<8
            val bits = d.cgram[usize(code & 7) * 8 + usize(row)]
            for col in 0..<5 do if (bits & (1u8 << u32(4 - col))) != 0 then columns[col] |= 1u8 << u32(row)
        return columns
    ascii(code)

private ascii(code: u8) -> [5]u8 = code match
    32 -> [0,0,0,0,0]
    33 -> [0,0,95,0,0]
    34 -> [0,7,0,7,0]
    35 -> [20,127,20,127,20]
    36 -> [36,42,127,42,18]
    37 -> [35,19,8,100,98]
    38 -> [54,73,85,34,80]
    39 -> [0,5,3,0,0]
    40 -> [0,28,34,65,0]
    41 -> [0,65,34,28,0]
    42 -> [20,8,62,8,20]
    43 -> [8,8,62,8,8]
    44 -> [0,80,48,0,0]
    45 -> [8,8,8,8,8]
    46 -> [0,96,96,0,0]
