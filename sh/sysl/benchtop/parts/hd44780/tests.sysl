module sh.sysl.benchtop.parts.hd44780
@tests

import sh.sysl.benchtop.parts.pins.{Line, driven, floating}

// Which bit of a test port each terminal is wired to; a bit outside 0..<32 is wired to nothing, and
// `rw` is None for a module with RW tied low. `gpio` is this wiring's adapter: the module sees only
// its own terminals.
private struct Wiring
    rs: int
    rw: Option[int]
    e: int
    d: [4]int

private val WIRED = Wiring(0, Some(1), 2, [3, 4, 5, 6])

private fresh() -> Lcd = lcd(20, 2, 1, 5)

private at(levels: u32, drives: u32, bit: int) -> Line =
    if bit < 0 || bit >= 32 || drives & 1 << u32(bit) == 0 then floating() else driven(levels & 1 << u32(bit) != 0)

private gpio(d: *Lcd, levels: u32, drives: u32, time: u64, w: Wiring = WIRED)
    val rw: Option[Line] = w.rw match
        Some(bit) -> Some(at(levels, drives, bit))
        None -> None
    val data = [at(levels, drives, w.d[0]), at(levels, drives, w.d[1]), at(levels, drives, w.d[2]), at(levels, drives, w.d[3])]
    observe(d, Bus(at(levels, drives, w.rs), rw, at(levels, drives, w.e), data), time)

private pulse(d: *Lcd, nibble: u8, rs: bool, time: u64, mask: u32 = 127, rw: bool = false, w: Wiring = WIRED)
    val pins = u32(nibble) << 3 | (if rs then 1 else 0) | (if rw then 2 else 0)
    gpio(d, pins, mask, time, w)
    gpio(d, pins | 4, mask, time, w)
    gpio(d, pins, mask, time, w)

private send(d: *Lcd, byte: u8, rs: bool, time: u64)
    pulse(d, byte >> 4, rs, time)
    pulse(d, byte & 15, rs, time + 1)

private initialized() -> Lcd
    var d = fresh()
    pulse(&d, 3, false, 0)
    pulse(&d, 3, false, 10)
    pulse(&d, 3, false, 20)
    pulse(&d, 2, false, 30)
    send(&d, 0x28, false, 40)
    send(&d, 0x0C, false, 50)
    send(&d, 0x06, false, 60)
    d

@test("HD44780 LCD: power-up nibble sequence selects four-bit writes and data is latched on falling enable")
initialization()
    var d = fresh()
    assert(!d.four_bit && !d.enabled && character(d, 0, 0) == 32)
    d = initialized()
    assert(d.four_bit && d.enabled && d.increment)
    val pins: u32 = 4 << 3 | 1
    gpio(&d, pins, 127, 80)
    gpio(&d, pins | 4, 127, 80)
    assert(!d.half && d.ram[0] == 32)
    gpio(&d, pins, 127, 80)
    assert(d.half && d.ram[0] == 32)
    pulse(&d, 1, true, 81)
    assert(character(d, 0, 0) == 65 && d.address == 1 && !d.half)

@test("HD44780 LCD: DDRAM row addressing, wrap, decrement, display shift and display off")
addressing()
    var d = initialized()
    send(&d, 0x80, false, 80)
    send(&d, 65, true, 90)
    send(&d, 66, true, 100)
    send(&d, 0xC0, false, 110)
    send(&d, 67, true, 120)
    assert(character(d, 0, 0) == 65 && character(d, 1, 0) == 66 && character(d, 0, 1) == 67)
    send(&d, 0x18, false, 130)
    assert(character(d, 0, 0) == 66)
    send(&d, 0x1C, false, 140)
    assert(character(d, 0, 0) == 65)
    send(&d, 0xA7, false, 150)
    send(&d, 68, true, 160)
    assert(d.address == 0x40)
    send(&d, 0x04, false, 170)
    send(&d, 69, true, 180)
    assert(d.address == 0x27)
    send(&d, 0x08, false, 190)
    assert(character(d, 0, 0) == 32 && d.ram[0] == 65)
    send(&d, 0x0C, false, 200)
    assert(character(d, 0, 0) == 65)
    assert(character(d, -1, 0) == 32 && character(d, 20, 0) == 32 && character(d, 0, 2) == 32)

@test("HD44780 LCD: busy commands ignore early writes, clear and home have long timing, reset drops partial nibbles")
timing_reset()
    var d = initialized()
    send(&d, 65, true, 80)
    send(&d, 0x01, false, 90)
    assert(d.until == 96 && d.ram[0] == 32)
    pulse(&d, 4, true, 92)
    assert(!d.half)
    send(&d, 66, true, 100)
    send(&d, 0x02, false, 110)
    assert(d.until == 116 && d.address == 0 && d.ram[0] == 66)
    pulse(&d, 4, true, 120)
    assert(d.half)
    reset(&d)
    assert(!d.half && !d.four_bit && !d.enabled && d.ram[0] == 32 && d.until == 0)

@test("HD44780 LCD: RW reads, missing output drivers and mismatched RS cannot write display memory")
bus_controls()
    var d = initialized()
    pulse(&d, 4, true, 80, rw = true)
    pulse(&d, 1, true, 81, rw = true)
    assert(d.ram[0] == 32 && !d.half)
    pulse(&d, 4, true, 90, mask = 127 & ~8)
    assert(!d.half)
    pulse(&d, 4, true, 100)
    pulse(&d, 1, false, 101)
    assert(!d.half && d.ram[0] == 32 && d.address == 0)
    send(&d, 65, true, 110)
    assert(d.ram[0] == 65)
    gpio(&d, 0, 0, 109)
    assert(d.time == 111)

@test("HD44780 LCD: a module with RW tied low latches writes with GPIO 1 undriven and high")
rw_tied_low()
    val tied = Wiring(0, None, 2, [3, 4, 5, 6])
    var d = fresh()
    pulse(&d, 3, false, 0, mask = 127 & ~2, w = tied)
    pulse(&d, 3, false, 10, mask = 127 & ~2, rw = true, w = tied)
    pulse(&d, 3, false, 20, mask = 127 & ~2, w = tied)
    pulse(&d, 2, false, 30, mask = 127 & ~2, w = tied)
    assert(d.four_bit,"RW is not a bus terminal of a write-only module")
    pulse(&d, 4, true, 40, rw = true, w = tied)
    pulse(&d, 1, true, 41, rw = true, w = tied)
    assert(d.ram[0] == 65,"GPIO 1 is not RW here, so its level reads nothing")

@test("HD44780 LCD: a terminal wired to no GPIO never lets the bus latch")
unwired_terminal()
    for w in [Wiring(-1, Some(1), 2, [3, 4, 5, 6]), Wiring(0, Some(1), 2, [3, 4, -1, 6]), Wiring(0, Some(40), 2, [3, 4, 5, 6])]
        var d = fresh()
        pulse(&d, 3, false, 0, w = w)
        pulse(&d, 2, false, 10, w = w)
        pulse(&d, 2, false, 20, w = w)
        assert(!d.four_bit && !d.half)
    var e = fresh()
    pulse(&e, 2, false, 0, w = Wiring(0, Some(1), -1, [3, 4, 5, 6]))
    assert(!e.four_bit,"no E, no edge")

@test("HD44780 LCD: the module sees only its own terminals, however the board numbers them")
own_terminals()
    // The same writes on a wiring that uses high bits of a port latch exactly as on the low ones.
    val high = Wiring(31, Some(30), 29, [28, 27, 26, 25])
    var d = fresh()
    for (nibble, time) in [(3u8, 0u64), (3, 10), (3, 20), (2, 30)]
        var levels: u32 = 0
        for bit in 0..<4 do if nibble >> u32(bit) & 1 != 0 then levels |= 1 << u32(28 - bit)
        gpio(&d, levels, 0xFE000000, time, high)
        gpio(&d, levels | 1 << 29, 0xFE000000, time, high)
        gpio(&d, levels, 0xFE000000, time, high)
    assert(d.four_bit)

@test("HD44780 LCD: custom glyph RAM is masked, wraps and is distinct from display memory")
custom_glyph()
    var d = initialized()
    send(&d, 0x40, false, 80)
    send(&d, 255, true, 90)
    send(&d, 17, true, 100)
    assert(d.cgram[0] == 31 && d.cgram[1] == 17 && d.ram[0] == 32)
    val dots = glyph(d, 0)
    assert(dots[0] == 3 && dots[1] == 1 && dots[4] == 3)
    send(&d, 0x7F, false, 110)
    send(&d, 4, true, 120)
    assert(d.address == 0 && d.cgram[63] == 4)
    send(&d, 0x80, false, 130)
    send(&d, 0, true, 140)
    assert(character(d, 0, 0) == 0 && glyph(d, 8) == glyph(d, 0))
