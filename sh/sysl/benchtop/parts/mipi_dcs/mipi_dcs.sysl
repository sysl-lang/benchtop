module sh.sysl.benchtop.parts.mipi_dcs

import sysl.buf.{Buf, buf}
import sysl.math.{min, max}

/** The controller behind the DCS core: which vendor commands, beyond the MIPI DCS set, it
 * accepts and how many parameter bytes each takes. A vendor command's parameters are consumed and
 * otherwise ignored (gamma, porches, power and voltage settings do not change the pixels shown).
 */
enum Controller
    Dcs // the MIPI DCS command set only; a DSI packet carries its own length
    St7789

/** Parameter bytes the write-side DCS commands this model acts on take. */
private dcs_arguments(command: u8) -> int = command match
    0x2A | 0x2B -> 4 // CASET, RASET
    0x36 | 0x3A -> 1 // MADCTL, COLMOD
    _ -> 0

/** Parameter bytes of the Sitronix ST7789 vendor commands (datasheet section 9.2). */
private st7789_arguments(command: u8) -> int = command match
    0xB7 | 0xBB | 0xC0 | 0xC3 | 0xC4 | 0xC5 | 0xC6 -> 1 // GCTRL, VCOMS, LCMCTRL, VRHS, VDVS, VCMOFSET, FRCTRL2
    0xB0 | 0xC2 | 0xD0 -> 2 // RAMCTRL, VDVVRHEN, PWCTRL1
    0xB2 -> 5 // PORCTRL
    0xE0 | 0xE1 -> 14 // PVGAMCTRL, NVGAMCTRL
    _ -> 0

/** How many parameter bytes `command` takes on `controller`. */
arguments_of(controller: Controller, command: u8) -> int
    val dcs = dcs_arguments(command)
    if dcs != 0 then return dcs
    controller match
        Dcs -> 0
        St7789 -> st7789_arguments(command)

/** Everything the controller forgets on a reset: modes, the memory window and cursor, and the
 * command being received. The display memory is not among it.
 */
struct State
    sleeping: bool
    enabled: bool
    inverse: bool
    madctl: u8
    format: u8
    left: int
    right: int
    top: int
    bottom: int
    column: int
    row: int
    command: u8
    needed: int
    count: int
    arguments: [16]u8
    writing: bool
    bytes: int
    components: [3]u8

/** The power-on state of a `width` by `height` controller: asleep, display off, 18-bit pixels, the
 * window the whole memory.
 */
private power_on(width: int, height: int) -> State
    var s: State
    s.sleeping = true
    s.format = 6
    s.right = width - 1
    s.bottom = height - 1
    s

/** Common write-side DCS TFT controller: memory windows, RGB pixels and orientation. */
struct Display
    controller: Controller
    width: int
    height: int
    ram: Buf[u32] // RGB888, reference-owned so GPIO edges never copy the framebuffer.
    state: State

display(width: int, height: int, controller: Controller = Dcs) -> &Display
    require width >= 1 && width <= 800 && height >= 1 && height <= 800, "bounded TFT controller memory"
    var ram: Buf[u32] = buf()
    for i in 0..<(width * height) do ram.push(0)
    Display(controller, width, height, ram, power_on(width, height))

/** Controller reset retains display memory; a new board gets a fresh controller. */
reset(d: &Display)
    d.state = power_on(d.width, d.height)

write(d: &Display, data: bool, byte: u8)
    if data
        if d.state.needed > 0
            d.state.arguments[d.state.count] = byte
            d.state.count += 1
            if d.state.count == d.state.needed
                d.state.needed = 0
                arguments(d)
        elif d.state.writing
            d.state.components[d.state.bytes] = byte
            d.state.bytes += 1
            if d.state.bytes == (if d.state.format == 5 then 2 else 3)
                store_pixel(d)
                d.state.bytes = 0
        return
    d.state.command = byte
    d.state.count = 0
    d.state.bytes = 0
    d.state.writing = false
    d.state.needed = arguments_of(d.controller, byte)
    byte match
        0x01 -> reset(d)
        0x10 -> d.state.sleeping = true
        0x11 -> d.state.sleeping = false
        0x20 -> d.state.inverse = false
        0x21 -> d.state.inverse = true
        0x28 -> d.state.enabled = false
        0x29 -> d.state.enabled = true
        0x2C ->
            d.state.column = d.state.left
            d.state.row = d.state.top
            d.state.writing = true
        0x3C -> d.state.writing = true
        _ -> ()

private arguments(d: &Display)
    val a = (int(d.state.arguments[0]) << 8) | int(d.state.arguments[1])
    val b = (int(d.state.arguments[2]) << 8) | int(d.state.arguments[3])
    val swapped = d.state.madctl & 32 != 0
    d.state.command match
        0x2A -> if a <= b && b < (if swapped then d.height else d.width)
            d.state.left = a
            d.state.right = b
        0x2B -> if a <= b && b < (if swapped then d.width else d.height)
            d.state.top = a
            d.state.bottom = b
        0x36 -> d.state.madctl = d.state.arguments[0]
        0x3A ->
            val format = d.state.arguments[0] & 7
            if format == 5 || format == 6 then d.state.format = format
        _ -> ()

private expand5(n: u32) -> u32 = (n << 3) | (n >> 2)
private expand6(n: u32) -> u32 = (n << 2) | (n >> 4)

private store_pixel(d: &Display)
    val a = u32(d.state.components[0])
    val b = u32(d.state.components[1])
    val color = if d.state.format == 5
        val value = (a << 8) | b
        (expand5(value >> 11) << 16) | (expand6((value >> 5) & 63) << 8) | expand5(value & 31)
    else
        (expand6(a >> 2) << 16) | (expand6(b >> 2) << 8) | expand6(u32(d.state.components[2]) >> 2)
    var x = if d.state.madctl & 32 != 0 then d.state.row else d.state.column
    var y = if d.state.madctl & 32 != 0 then d.state.column else d.state.row
    if d.state.madctl & 64 != 0 then x = d.width - 1 - x
    if d.state.madctl & 128 != 0 then y = d.height - 1 - y
    if x >= 0 && x < d.width && y >= 0 && y < d.height then d.ram.set(usize(y * d.width + x), color)
    if d.state.column < d.state.right then d.state.column += 1
    else
        d.state.column = d.state.left
        d.state.row = if d.state.row < d.state.bottom then d.state.row + 1 else d.state.top

/** What the glass shows at (x, y): the stored color as `look` turns it, and black off the memory. */
pixel(d: &Display, x: int, y: int) -> u32
    if x < 0 || x >= d.width || y < 0 || y >= d.height then return 0
    shown(look(d), d.ram.at(usize(y * d.width + x)))

/** How the controller turns stored RGB into what the glass shows: dark while asleep or off, the red
 * and blue swapped by MADCTL's BGR bit, and inverted. Read once beside a copy of the memory, so the
 * copy can be converted away from whatever lock guards the controller.
 */
struct Look
    lit: bool
    bgr: bool
    inverse: bool

look(d: &Display) -> Look = Look(!d.state.sleeping && d.state.enabled, d.state.madctl & 8 != 0, d.state.inverse)

/** What the glass shows for the stored `color` under `look`. */
shown(look: Look, color: u32) -> u32
    if !look.lit then return 0
    var c = color
    if look.bgr then c = ((c & 255) << 16) | (c & 0xFF00) | (c >> 16)
    if look.inverse then c ^= 0xFFFFFF
    c

/** The part of a window that lies on the controller's memory, in the window's own coordinates: columns
 * `left..<right` of rows `top..<bottom`. The glass is black everywhere else.
 */
struct Inside
    left: int
    right: int
    top: int
    bottom: int

/** Append the stored colors of the `width` by `height` window whose top left is (x, y), row by row,
 * with 0 wherever the window leaves the memory, and answer where it lies on the memory: a copy of
 * whole rows, so a lock is held only as long as the copy takes. `show` then turns the copy into what
 * the glass shows.
 */
copy_window(d: &Display, x: int, y: int, width: int, height: int, into: *Buf[u32]) -> Inside
    val left = max(x, 0)
    val right = min(x + width, d.width)
    for row in y..<y + height
        if row < 0 || row >= d.height || left >= right
            for i in 0..<width do into.push(0)
            continue
        for i in x..<left do into.push(0)
        val start = usize(row * d.width)
        into.extend(d.ram.view()[start + usize(left)..<start + usize(right)])
        for i in right..<x + width do into.push(0)
    if left >= right then return Inside(0, 0, 0, 0)
    Inside(left - x, right - x, max(y, 0) - y, max(min(y + height, d.height) - y, max(y, 0) - y))

/** Turn a copied window `width` wide into what the glass shows under `look`, in place. */
show(look: Look, inside: Inside, width: int, pixels: *Buf[u32])
    for row in inside.top..<inside.bottom
        for column in inside.left..<inside.right
            val i = usize(row * width + column)
            pixels.set(i, shown(look, pixels.at(i)))
