module sh.sysl.benchtop.parts.qspi_flash

import sysl.fmt.hex

// A serial NOR flash on a QSPI bus, as the Pico 2 fits one: Winbond's W25Q32RV, 4 MB in 4 KB
// sectors and 256-byte pages (Winbond's data sheet, section 8, "Instructions"); or the Pico's W25Q16JV
// (`w25q16jv`), the same instruction set at 2 MB, which differs only in the capacity its IDs give. It
// is what the RP2350's QMI talks to on chip select 0, and the RP2040's SSI, one byte at a time
// (`exchange`) between a `select` and a `deselect`.
//
// **The array is the board's, not the part's.** The bytes are the ones the cores execute in place, so
// the part reaches them through the connection its board gives it (`connect`) and keeps the range it
// has changed since it was last asked (`take_changed`), so the board can forget code decoded from it.
//
// **What it runs:** the reads (03h, 0Bh, 3Bh, 6Bh, BBh and EBh, with EBh's continuous read mode and
// its exit), the IDs (9Fh JEDEC, 90h, ABh, 4Bh unique ID), status registers 1 to 3 (05h/35h/15h to read,
// 01h/31h/11h to write, after 06h or the volatile 50h), write enable and disable, page program (02h and
// 32h), sector, block and chip erase (20h, 52h, D8h, C7h/60h), power-down (B9h, ABh), the software
// reset (66h then 99h), and FFh, which does nothing outside continuous read mode.
//
// **Fidelity:** a program or erase completes when chip select rises, so BUSY (WIP) never reads 1; the
// interface width a byte travels at does not matter, so QE is stored and does not gate the quad
// instructions. Every other instruction, and a program or erase with block protection set, is refused
// by name.

/** The W25Q32RV's JEDEC ID: Winbond, the W25Q family, 4 MB (2^22 bytes). */
const MANUFACTURER: u8 = 0xEF
const MEMORY_TYPE: u8 = 0x40
const CAPACITY: u8 = 0x16
/** The W25Q16JV's capacity byte: 2 MB (2^21 bytes). The device ID 90h and ABh answer is one less than
 * the capacity byte, on both parts.
 */
const CAPACITY_W25Q16: u8 = 0x15
/** The 64-bit unique ID 4Bh answers, the same on every benchtop board. */
val UNIQUE_ID: [8]u8 = [0xE6, 0x60, 0x58, 0x38, 0x83, 0x2B, 0x4A, 0x2E]
const PAGE_BYTES: u32 = 256
const SECTOR_BYTES: u32 = 4096

// Status register 1: BUSY (WIP), WEL, and the protection bits BP0-2, TB and SEC; BUSY and WEL are
// read-only to 01h.
const SR1_WEL: u8 = 0x02
const SR1_WRITABLE: u32 = 0xFC
const SR1_PROTECTION: u8 = 0x7C
// Status register 2: CMP, which with the BP bits protects the complement.
const SR2_CMP: u8 = 0x40

struct QspiFlash
    // The array, and its size in bytes, a power of two; 0 for none.
    bytes: *u8
    size: u32
    // The JEDEC ID's capacity byte, which names the part.
    capacity: u8
    status: [3]u8
    // The volatile status-register write enable (50h), good for the next status write.
    volatile_write: bool
    powered_down: bool
    // 66h was the last instruction, so 99h resets.
    reset_enabled: bool
    // EBh's continuous read mode: the next frame starts at the address.
    continuous: bool
    // The frame in progress: whether chip select is low, its instruction, how many bytes have gone
    // (the instruction is byte 0), the address it gathers and then reads from (or the status bytes a
    // status write gathers), and whether every byte so far was FFh.
    selected: bool
    instruction: u8
    count: u32
    address: u32
    all_ff: bool
    // A page program's bytes, gathered until chip select rises; FFh programs nothing.
    page: [256]u8
    // The lowest and highest byte changed since `take_changed`, none where `changed_low > changed_high`.
    changed_low: u32
    changed_high: u32

    /** Connect the array the part reads and writes: `size` bytes from `bytes`. */
    connect(*self, bytes: *u8, size: u32)
        require size != 0 && size & (size - 1) == 0, "a flash array is a power of two in size"
        self.bytes = bytes
        self.size = size

    /** Power-on: no frame, write disabled, status registers cleared; the connection kept. */
    reset(*self)
        self.status = [0, 0, 0]
        self.volatile_write = false
        self.powered_down = false
        self.reset_enabled = false
        self.continuous = false
        self.selected = false
        self.instruction = 0
        self.count = 0
        self.address = 0
        self.changed_low = 1
        self.changed_high = 0

    /** Whether an array is connected. */
    connected(self) -> bool = self.size != 0

    /** The byte at `a`, wrapped to the array, as the device ignores the address bits above it. */
    byte(self, a: u32) -> u8 = if self.size == 0 then 0xFF else self.bytes[usize(a & (self.size - 1))]

    /** The range programs and erases have changed since the last call: offset and length. */
    take_changed(*self) -> Option[(u32, u32)]
        if self.changed_low > self.changed_high then return None
        val got = (self.changed_low, self.changed_high - self.changed_low + 1)
        self.changed_low = 1
        self.changed_high = 0
        Some(got)

    /** Chip select falls: a frame begins. In continuous read mode it starts at the address. */
    select(*self)
        if self.selected then return
        self.selected = true
        self.all_ff = true
        self.address = 0
        self.count = if self.continuous then 1 else 0
        self.instruction = if self.continuous then 0xEB else 0

    /** One byte out to the device while chip select is low, and the byte it answers. */
    exchange(*self, out: u8) -> Result[u8, string]
        if !self.selected then return Err("a byte was clocked to the flash with its chip select high")
        if out != 0xFF then self.all_ff = false
        val i = self.count
        self.count += 1
        if i > 0 then return Ok(self.next(i, out))
        self.instruction = out
        if self.powered_down then return Ok(0xFF)
        if !known(out) then return Err(s"instruction 0x${hex(u32(out), 2)} is not one the flash runs")
        if out == 0x02 || out == 0x32 then self.page = [0xFF; 256]
        Ok(0xFF)

    // Byte `i` (from 1) of the frame: what the device drives back.
    private next(*self, i: u32, out: u8) -> u8
        val op = self.instruction
        if self.powered_down && op != 0xAB then return 0xFF
        if addressed(op) && i <= 3
            self.address = (self.address << 8) | u32(out)
            return 0xFF
        op match
            0x03 -> self.read_next()
            0x0B | 0x3B | 0x6B | 0xBB -> if i == 4 then 0xFF else self.read_next()
            0xEB ->
                // The mode byte (M5-4 = 10b keeps continuous read mode), two dummy bytes, then data.
                if i == 4 then self.continuous = out & 0x30 == 0x20
                if i <= 6 then 0xFF else self.read_next()
            0x9F -> if i == 1 then MANUFACTURER elif i == 2 then MEMORY_TYPE elif i == 3 then self.capacity else 0xFF
            0x90 -> if i % 2 == 0 then MANUFACTURER else self.capacity - 1
            0xAB -> if i >= 4 then self.capacity - 1 else 0xFF
            0x4B -> if i >= 5 && i <= 12 then UNIQUE_ID[usize(i - 5)] else 0xFF
            0x05 -> self.status[0]
            0x35 -> self.status[1]
            0x15 -> self.status[2]
            0x02 | 0x32 ->
                // Bytes past the page's end wrap to its start, as the device's page buffer does.
                val at = usize((self.address + i - 4) & (PAGE_BYTES - 1))
                self.page[at] &= out
                0xFF
            0x01 | 0x31 | 0x11 ->
                // Kept until chip select rises; 01h takes status register 1 and then 2.
                if i <= 2 then self.address = (self.address << 8) | u32(out)
                0xFF
            _ -> 0xFF
    end next

    // The byte at the read address, which then moves on, wrapping at the array's end.
    private read_next(*self) -> u8
        val b = self.byte(self.address)
        self.address = (self.address + 1) & (self.size - 1)
        b

    /** Chip select rises: the frame's instruction takes effect, or is refused by name. */
    deselect(*self) -> Result[unit, string]
        if !self.selected then return Ok(())
        self.selected = false
        val op = self.instruction
        val n = self.count
        // A frame of FFh in continuous read mode, ending before the mode byte, takes the device out of it.
        if self.continuous && op == 0xEB && n <= 4 && self.all_ff
            self.continuous = false
            return Ok(())
        if n == 0 then return Ok(())
        if self.powered_down
            if op == 0xAB then self.powered_down = false
            return Ok(())
        self.take_effect(op, n)?
        self.reset_enabled = op == 0x66
        Ok(())

    // What instruction `op`, `n` bytes long with its own, does as chip select rises.
    private take_effect(*self, op: u8, n: u32) -> Result[unit, string]
        val wel = self.status[0] & SR1_WEL != 0
        op match
            0x06 -> self.status[0] |= SR1_WEL
            0x04 -> self.status[0] &= ~SR1_WEL
            0x50 -> self.volatile_write = true
            0xB9 -> self.powered_down = true
            0x99 ->
                if self.reset_enabled
                    self.status[0] &= ~SR1_WEL
                    self.volatile_write = false
                    self.continuous = false
            0x01 ->
                if (wel || self.volatile_write) && n >= 2
                    // One byte is status register 1; two are 1 and then 2.
                    if n == 2
                        self.status[0] = u8(self.address & SR1_WRITABLE)
                    else
                        self.status[0] = u8((self.address >> 8) & SR1_WRITABLE)
                        self.status[1] = u8(self.address & 0xFF)
                    self.after_write()
            0x31 | 0x11 ->
                if (wel || self.volatile_write) && n >= 2
                    self.status[if op == 0x31 then 1 else 2] = u8(self.address & 0xFF)
                    self.after_write()
            0x02 | 0x32 ->
                if wel && n >= 5
                    self.unprotected("program")?
                    val base = self.address & ~(PAGE_BYTES - 1) & (self.size - 1)
                    for k in 0u32..<PAGE_BYTES
                        val at = usize(base + k)
                        self.bytes[at] = self.bytes[at] & self.page[usize(k)]
                    self.changed(base, PAGE_BYTES)
                    self.after_write()
            0x20 | 0x52 | 0xD8 ->
                if wel && n == 4
                    self.unprotected("erase")?
                    val span: u32 = if op == 0x20 then SECTOR_BYTES elif op == 0x52 then 32768 else 65536
                    self.erase(self.address & ~(span - 1) & (self.size - 1), span)
                    self.after_write()
            0xC7 | 0x60 ->
                if wel && n == 1
                    self.unprotected("chip erase")?
                    self.erase(0, self.size)
                    self.after_write()
            _ -> ()
        Ok(())
    end take_effect

    // The protection bits guard what benchtop programs and erases; with any set, it refuses.
    private unprotected(self, what: string) -> Result[unit, string]
        if self.status[0] & SR1_PROTECTION != 0 || self.status[1] & SR2_CMP != 0
            return Err(s"a flash $what with block protection set (status registers 0x${hex(u32(self.status[0]), 2)}, 0x${hex(u32(self.status[1]), 2)}) is not modelled")
        Ok(())

    // A block larger than a small array erases all of it.
    private erase(*self, at: u32, block: u32)
        val span = if block > self.size then self.size else block
        val from = at & ~(span - 1)
        for k in 0u32..<span do self.bytes[usize(from + k)] = 0xFF
        self.changed(from, span)

    // A program, erase or status write has completed: WEL clears, as does the volatile enable.
    private after_write(*self)
        self.status[0] &= ~SR1_WEL
        self.volatile_write = false

    private changed(*self, from: u32, span: u32)
        val last = from + span - 1
        if self.changed_low > self.changed_high
            self.changed_low = from
            self.changed_high = last
            return
        if from < self.changed_low then self.changed_low = from
        if last > self.changed_high then self.changed_high = last
end QspiFlash

/** A flash with no array connected yet, at power-on. */
qspi_flash() -> QspiFlash
    var f: QspiFlash
    f.bytes = null
    f.size = 0
    f.capacity = CAPACITY
    f.reset()
    f

/** The Pico's W25Q16JV, 2 MB, with no array connected yet, at power-on. */
w25q16jv() -> QspiFlash
    var f = qspi_flash()
    f.capacity = CAPACITY_W25Q16
    f

// The instructions the part runs.
private known(op: u8) -> bool = op match
    0x03 | 0x0B | 0x3B | 0x6B | 0xBB | 0xEB | 0x9F | 0x90 | 0xAB | 0x4B | 0x05 | 0x35 | 0x15 -> true
    0x01 | 0x31 | 0x11 | 0x06 | 0x04 | 0x50 | 0x02 | 0x32 | 0x20 | 0x52 | 0xD8 | 0xC7 | 0x60 -> true
    0xB9 | 0x66 | 0x99 | 0xFF -> true
    _ -> false

// The instructions that send a 24-bit address after themselves.
private addressed(op: u8) -> bool = op match
    0x03 | 0x0B | 0x3B | 0x6B | 0xBB | 0xEB | 0x90 | 0x02 | 0x32 | 0x20 | 0x52 | 0xD8 -> true
    _ -> false
