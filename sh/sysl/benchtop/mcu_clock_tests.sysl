module sh.sysl.benchtop
@tests

import sh.sysl.parsing.source_of
import sysl.raw.str_cast
import sysl.text.replace_all

private clock_board(hz: string) -> string = replace_all(
    str_cast(embed("../../../boards/touch.hocon")), "clock-hz = 150000000", s"clock-hz = $hz")

@test("MCU clock: valid frequency survives description round trips; invalid rates are rejected")
mcu_clock_description()
    for hz in ["1", "12000000", "150000000", "1000000000"]
        val got = load(source_of("clock.hocon", clock_board(hz)), library())
        assert(!got.report.has_errors())
        val text = description_text(got.description)
        val again = load(source_of("roundtrip.hocon", text), library())
        assert(!again.report.has_errors())
        assert(description_text(again.description) == text)
    for hz in ["0", "-1", "1000000001", "true", "fast"]
        assert(load(source_of("clock.hocon", clock_board(hz)), library()).report.has_errors())
    val legacy = replace_all(clock_board("150000000"), "clock-hz = 150000000", "")
    val got = load(source_of("legacy.hocon", legacy), library())
    assert(!got.report.has_errors() && got.description.board.chip.clock_hz.is_none())

