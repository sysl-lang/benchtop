module sh.sysl.benchtop
@tests

// The example firmware directories are excluded from this package (sysl.hocon), and the tests embed
// ELF images built from them, so nothing else would notice a source that no longer compiles. Each
// test here builds one example for the target its `build.sh` names, as an archive in a scratch
// directory; the link step needs only `arm-none-eabi-ld` and is not repeated. The build is `-O0`,
// which type-checks and generates every function without the cost of optimizing it.

import sysl.fs.{current_dir, make_temp_dir, remove_dir_all, is_dir}
import sysl.path.{join, parent}
import sysl.process.capture
import sysl.buf.{Buf, buf}

private build(example: string, target: string, features: string = "", libc_headers: string = "") -> string
    val root = current_dir().unwrap()
    val dir = join(root, join("examples", example))
    assert(is_dir(dir), s"$dir is not the example directory; run the suite from the repository root")
    val scratch = make_temp_dir("benchtop-example").unwrap()
    defer remove_dir_all(scratch).unwrap()
    var args: Buf[string] = buf()
    args.push("build-c")
    args.push("--target")
    args.push(target)
    args.push("-O0")
    args.push("--lib")
    args.push(join(root, "examples/shared"))
    if !features.is_empty()
        args.push("--features")
        args.push(features)
    if !libc_headers.is_empty()
        args.push("--include-path")
        args.push(libc_headers)
        args.push("-DNDEBUG")
    args.push("-o")
    args.push(join(scratch, "firmware.a"))
    args.push(dir)
    val out = capture("sysl", args.view(), stderr = true).unwrap()
    if out.status.ok() then "" else s"examples/$example: ${out.err.unwrap_or("")}"

// The headers of the Arm bare-metal C library, which the touch firmware includes. Empty when the
// toolchain is not installed.
private arm_headers() -> string
    val found = capture("arm-none-eabi-gcc", ["-print-file-name=libc.a"]) match
        Ok(o) -> o
        Err(_) -> return ""
    val libc = found.text.trim()
    if libc.is_empty() || !libc.contains("/") then return ""
    join(parent(libc).unwrap(), "../include")

@test("example firmware: the visual demo builds for the RP2040")
visual_example_builds()
    assert_eq(build("visual", "thumbv6m-freestanding"), "")

@test("example firmware: the matrix demo builds for the RP2040")
matrix_example_builds()
    assert_eq(build("matrix", "thumbv6m-freestanding"), "")

@test("example firmware: the audio demo builds for the RP2040")
audio_example_builds()
    assert_eq(build("audio", "thumbv6m-freestanding"), "")

@test("example firmware: the SAI/DMA demo builds for the Cortex-M4")
sai_dma_example_builds()
    assert_eq(build("sai-dma", "thumbv7em-freestanding"), "")

@test("example firmware: every touch firmware variant builds for its core")
touch_example_builds()
    val headers = arm_headers()
    if headers.is_empty() then return
    assert_eq(build("touch", "thumb-freestanding", "", headers), "")
    assert_eq(build("touch", "thumb-freestanding", "joystick", headers), "")
    assert_eq(build("touch", "thumb-freestanding", "gpio_spi", headers), "")
    assert_eq(build("touch", "thumb-freestanding", "full_redraw", headers), "")
    val h7 = "h7_cores"
    assert_eq(build("touch", "thumbv7em-freestanding", h7, headers), "")
    assert_eq(build("touch", "thumbv7em-freestanding", s"$h7,dsi", headers), "")
    assert_eq(build("touch", "thumbv7em-freestanding", s"$h7,dsi,audio", headers), "")
    assert_eq(build("touch", "thumbv7em-freestanding", s"$h7,dsi,audio,microphone", headers), "")
    assert_eq(build("touch", "thumbv7em-freestanding", s"$h7,dsi,audio,microphone,delay", headers), "")
    assert_eq(build("touch", "thumbv7em-freestanding", s"$h7,dsi,audio,microphone,delay,storage", headers), "")
    assert_eq(build("touch", "thumbv7em-freestanding", s"$h7,dsi,audio,microphone,delay,storage,sdmmc", headers), "")
