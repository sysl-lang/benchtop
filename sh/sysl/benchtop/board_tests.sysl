module sh.sysl.benchtop
@tests

// The description format: every form it reads, every mistake it reports with its exact text and the
// line and column it points at, the descriptions built into benchtop, and a description written back
// reading as itself.
//
// **A fixture marks where each diagnostic points with `‸`**, just before the character the caret is
// under. The marks are taken out before the text is read, and `@1`, `@2`, ... in the expected text
// become the line and column of the first, second, ... mark, so no position is counted by hand.

import sh.sysl.parsing.{Source, Span, source_of}
import sysl.raw.str_cast
import sysl.buf.{Buf, buf}
import sysl.text.{replace_all, str_builder}

val MARK = "‸"

// `marked` with each mark taken out, and the place of each, as `line:col`, in order.
private unmark(marked: string) -> (string, Buf[string])
    var plain = str_builder()
    var offsets: Buf[usize] = buf()
    var rest = marked
    var at: usize = 0

    loop
        rest.index_of(MARK) match
            Some(i) ->
                plain.push(rest[0..<i])
                at += i
                offsets.push(at)
                rest = rest[(i + MARK.bytes.len)..]
            None ->
                plain.push(rest)
                break
    end loop

    val text = plain.finish()
    val src = source_of("t.hocon", text)
    var places: Buf[string] = buf()

    for o in offsets do places.push(s"${src.locate(o)}")

    (text, places)
end unmark

// `want` with `@1`, `@2`, ... replaced by the places of the marks.
private placed(want: string, places: Buf[string]) -> string
    var out = want
    var k = places.len()

    while k > 0
        out = replace_all(out, s"@$k", places.at(k - 1))
        k -= 1

    out
end placed

// Every diagnostic `text` gets, a line each: where it points, then what it says.
private diags_in(text: string, reg: Registry, shelf: Shelf) -> string
    val src = source_of("t.hocon", text)
    val got = load(src, reg, shelf)
    var out = str_builder()

    for i in 0..<got.report.len()
        val d = got.report.at(i)

        out.push(s"${src.locate(d.span.start)} ${d.message}\n")

    out.finish()

private diags_with(text: string, reg: Registry) -> string = diags_in(text, reg, built_in_shelf())

private diags(text: string) -> string = diags_with(text, library())

// The diagnostics of a marked fixture are `want`, its `@N` the places of the marks.
private expect_in(marked: string, want: string, reg: Registry, shelf: Shelf)
    val (text, places) = unmark(marked)
    val wanted = placed(want, places)
    val got = diags_in(text, reg, shelf)

    assert(got == wanted, s"for\n$text\nwanted\n${wanted}got\n$got")

private expect(marked: string, want: string) = expect_in(marked, want, library(), built_in_shelf())

// A board on the RP2040 whose parts are `lines`; `more` follows them inside the board.
private kit(lines: string, more: string = "") -> string =
    s"board {\n  name = t, chip = rp2040\n  parts {\n$lines  }\n$more}\n"

// A board of two M0+ cores whose parts are `lines`.
private cores(lines: string) -> string =
    s"board {\n  name = v, cores = [cortex-m0plus, cortex-m0plus]\n  parts {\n$lines  }\n}\n"

// A product of the boards `boards` whose own parts are `lines`; `more` follows them inside it.
private product(boards: string, lines: string, more: string = "") -> string =
    s"product {\n  name = k\n  boards {\n$boards  }\n  parts {\n$lines  }\n$more}\n"

val PICO = "    pico { board = pico }\n"

// The description a text reads to, which must check clean.
private clean_in(text: string, shelf: Shelf) -> Description
    val got = load(source_of("t.hocon", text), library(), shelf)

    assert(!got.report.has_errors(), diags_in(text, library(), shelf))
    got.description

private clean(text: string) -> Description = clean_in(text, built_in_shelf())

private clean_board(text: string) -> Board = clean(text).board

// A description read, written, read and written again: the two writings are the same text.
private round_trip(text: string, reg: Registry) -> string
    val once = description_text(load(source_of("a.hocon", text), reg).description)
    val again = load(source_of("b.hocon", once), reg)

    assert(!again.report.has_errors(), s"the written description does not check:\n$once")

    val twice = description_text(again.description)

    assert(once == twice, s"once:\n${once}twice:\n$twice")
    once

private bundled(name: string) -> string
    for (n, text) in bundled_descriptions()
        if n == name then return text

    assert(false, s"no bundled `$name`")
    ""

// A shelf of the descriptions built in, and of files that are `files`' (path, text) pairs.
private shelf_with(files: Buf[(string, string)]) -> Shelf =
    Shelf(bundled_descriptions(), file ->
        var found: Result[string, string] = Err("no such file")

        for (path_name, text) in files
            if path_name == file then found = Ok(text)

        found)

private files(xs: []const (string, string)) -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    out.extend(xs)
    out

// -- the marks themselves --------------------------------------------------------------------------

@test("a mark is taken out of a fixture and stands for the line and column of what follows it")
marks()
    val (text, places) = unmark("ab\n‸cd ‸ef\n✓✓‸g")

    assert(text == "ab\ncd ef\n✓✓g", text)
    assert(places.len() == 3 && places.at(0) == "2:1" && places.at(1) == "2:4" && places.at(2) == "3:3", places.at(2))
    assert(placed("@1 x @3\n@2\n", places) == "2:1 x 3:3\n2:4\n")

// -- the descriptions built in ---------------------------------------------------------------------

@test("every description built into benchtop checks clean, and so does the moved-console example")
bundled_clean()
    var names: Buf[string] = buf()

    for (name, text) in bundled_descriptions()
        names.push(name)
        expect(text, "")

    assert(listing(names) == "`virt`, `virt4`, `virt7`, `virt33`, `virt0`, `virt1`, `virt3`, `virt23`, `virt35p`, `virt52`, `virt55`, `virt85`, `pico`, `pico2w` and `pico-breadboard-kit`", listing(names))
    expect(str_cast(embed("../../../examples/virt/moved.hocon")), "")

@test("virt reads as two M0+ cores, a 1M RAM at 0, the console at 0x40000000 on IRQ 0, and the SIO")
bundled_virt_model()
    val b = clean_board(bundled("virt"))

    assert(b.name == "virt" && b.chip.is_empty() && b.cores.len() == 2)
    assert(b.cores.at(0).name == "cortex-m0plus" && b.cores.at(1).name == "cortex-m0plus")
    assert(b.parts.len() == 3 && b.exposed_pins.is_empty() && b.exposed_buses.is_empty())

    val ram = b.parts.at(0)

    assert(ram.kind == "ram" && ram.at.unwrap().n == 0 && ram.size.unwrap().n == 1048576 && ram.irq.is_none())
    assert(ram.size.unwrap().written == "1M" && ram.at.unwrap().written == "0x00000000")

    val console = b.parts.at(1)

    assert(console.kind == "debug-console" && console.at.unwrap().n == 0x40000000 && console.irq.unwrap().n == 0)
    assert(b.parts.at(2).at.unwrap().n == 0xD0000000 && b.parts.at(2).irq.unwrap().n == 1)

@test("the pico exposes its header's pins and its buses, and keeps GP23 to GP25 and GP29 to itself")
bundled_pico_model()
    for name in ["pico", "pico2w"]
        val b = clean_board(bundled(name))
        var pins: Buf[int] = buf()

        for e in b.exposed_pins do pins.push(e.pin)

        assert(pin_ranges(pins) == "GP0 to GP22 and GP26 to GP28", pin_ranges(pins))
        assert(b.exposed_buses.len() == 6 && b.exposed_buses.at(0).name == "spi0" && b.exposed_buses.at(5).name == "uart1")

@test("the kit is a product around one pico, its parts wired to the pico's pins and buses")
bundled_kit_model()
    val d = clean(bundled("pico-breadboard-kit"))

    assert(d.form == ProductForm)

    val p = d.product

    assert(p.name == "Pico Breadboard Kit" && p.boards.len() == 1)

    val pico = p.boards.at(0)

    assert(pico.name == "pico" && pico.of == "pico" && pico.found && pico.board.name == "Raspberry Pi Pico")
    assert(p.parts.len() == 10 && p.buses.len() == 3 && p.buses.at(0).board == "pico" && p.buses.at(0).name == "spi0")
    assert(target_text(p.parts.at(0).wires.at(0).to) == "pico.spi0")
    assert(p.view.elements.len() == 12 && p.keys.len() == 6 && p.pointers.len() == 1)

    // The screen's size is its glass's, turned a quarter.
    val screen = p.view.elements.at(4)

    assert(screen.name == "screen" && screen.natural && screen.w == 480 && screen.h == 320)

@test("each description built in, written back, reads as itself; virt keeps how its places were written")
bundled_round_trip()
    val reg = library()
    val virt = round_trip(bundled("virt"), reg)

    assert(virt == """
        board {
          name = "virt"
          cores = [cortex-m0plus, cortex-m0plus]
          parts {
            ram {
              part = ram
              at = 0x00000000
              size = 1M
            }
            console {
              part = debug-console
              at = 0x40000000
              irq = 0
            }
            sio {
              part = virt-sio
              at = 0xD0000000
              irq = 1
            }
          }
        }
        """, virt)

    for (_, text) in bundled_descriptions() do round_trip(text, reg)

@test("benchtop check's summary of each description built in")
bundled_summary()
    val reg = library()
    val v = summary(clean(bundled("virt")), reg)

    assert(v == """
        virt: two cortex-m0plus cores
          ram      ram            0x00000000 to 0x000fffff
          console  debug-console  0x40000000 to 0x4000000f, IRQ 0
          sio      virt-sio       0xd0000000 to 0xd000017f, IRQ 1
        """, v)

    val p = summary(clean(bundled("pico2w")), reg)

    assert(p == """
        Raspberry Pi Pico 2 W: the rp2350 (Raspberry Pi RP2350A: two Cortex-M33 at 150 MHz)
          wifi  cyw43439  wl_on = GP23, data = GP24, cs = GP25, clock = GP29 (not modelled)
          led   led       anode = wifi.gpio0, color = green (driven through `wifi`, which is not modelled)
          exposes GP0 to GP22 and GP26 to GP28; spi0, spi1, i2c0, i2c1, uart0, uart1
          view 168 x 408, 5 elements
        """, p)

    val k = summary(clean(bundled("pico-breadboard-kit")), reg)

    assert(k.starts_with("Pico Breadboard Kit: a product of 1 board\n  board pico  pico: the rp2040 (Raspberry Pi RP2040: two Cortex-M0+ at 133 MHz)\n"), k)
    assert(k.contains("  lcd       st7796    spi = pico.spi0, cs = pico.GP5, dc = pico.GP6, reset = pico.GP7, width = 320, height = 480, invert = true\n"), k)
    assert(k.contains("  bus pico.spi0: sck = GP2, tx = GP3\n"), k)
    assert(k.ends_with("  view 922 x 499, 12 elements\n  input: 6 keys, 1 pointer binding\n"), k)

// -- the forms a description takes ----------------------------------------------------------------

@test("a one-liner is a board built into benchtop, read, checked, summarised and written back as its name")
form_one_liner()
    val d = clean("board = pico2w\n")

    assert(d.form == BoardForm && d.named == "pico2w" && d.board.name == "Raspberry Pi Pico 2 W")
    assert(summary(d, library()) == summary(clean(bundled("pico2w")), library()))
    assert(round_trip("board = pico2w\n", library()) == "board = pico2w\n")
    assert(round_trip("board: \"virt\"  // quoted\n", library()) == "board = virt\n")

@test("a one-liner may name a file, found from the directory of the file that names it")
form_one_liner_path()
    val mine = "board {\n  name = mine\n  cores = [cortex-m0plus]\n}\n"
    val shelf = shelf_with(files([("boards/mine.hocon", mine), ("/abs/x.hocon", mine)]))

    for text in ["board = \"mine.hocon\"\n", "board = \"./mine.hocon\"\n"]
        val got = load(source_of("boards/top.hocon", text), library(), shelf)

        assert(!got.report.has_errors() && got.description.board.name == "mine", text)

    val abs = load(source_of("boards/top.hocon", "board = \"/abs/x.hocon\"\n"), library(), shelf)

    assert(!abs.report.has_errors() && abs.description.board.name == "mine")
    expect_in("board = ‸\"nope.hocon\"\n", "@1 cannot read `nope.hocon`: no such file\n", library(), shelf)

@test("a name is a file when it has a `/` or ends in `.hocon`, and otherwise is built in")
form_name_or_path()
    assert(!is_path("virt") && !is_path("pico-breadboard-kit"))
    assert(is_path("./virt") && is_path("boards/x") && is_path("x.hocon") && is_path("/tmp/x"))

    val shelf = shelf_with(files([("virt", "board = pico\n")]))

    // `virt` is the built-in board even where a file of that name could be read; `./virt` is the file.
    open_description(shelf, "virt", "", Span(0, 0)) match
        Ok(src) -> assert(src.name == "virt" && str_cast(src.bytes).contains("cores = [cortex-m0plus, cortex-m0plus]"))
        Err(_) -> assert(false, "virt")

    open_description(shelf, "./virt", "", Span(0, 0)) match
        Ok(src) -> assert(src.name == "virt" && str_cast(src.bytes) == "board = pico\n", src.name)
        Err(d) -> assert(false, d.message)

    open_description(shelf, "./vrit", "", Span(0, 0)) match
        Ok(_) -> assert(false, "./vrit")
        Err(d) -> assert(d.message == "cannot read `vrit`: no such file", d.message)

    open_description(shelf, "pico3", "", Span(0, 0)) match
        Ok(_) -> assert(false, "pico3")
        Err(d) -> assert(d.message == "unknown board `pico3`" && d.label == "did you mean `pico`?", d.message)

@test("a board written out: blocks, dotted keys, quoted keys, both comments, `:` and `=`, hex, K and M")
form_board()
    val b = clean_board("""
        # a hash comment
        board: {
          name: "every form", chip = rp2040   // a slash comment
          parts {
            d1 { part = led, color = red, wire { anode = GP16 } }
            d2.part = led
            d2.wire.anode = GP17
            "btn 1" { part = button, active = low
                      wire { pin = GP15 } }
            touch { part = gt911, address = 0x5d, wire { i2c = i2c0 } }
          }
          buses { i2c0 { sda = GP8, scl = GP9 } }
          exposes.pins = [GP0, GP1]
          exposes { buses = [spi0] }
          view {
            size = [100, 60]
            elements {
              d1 { show = d1, at = [0, 0], size = [10, 10] }
              caption { text = "D1", at = [20, 0], size = [30, 10] }
              fill { box = "#202020", at = [0, 20], size = [100, 40], look { color = "#20c040" } }
            }
          }
          input { keys { "1" = "btn 1" }, pointer { fill = touch } }
        }
        """)

    assert(b.name == "every form" && b.chip == "rp2040")
    assert(b.parts.len() == 4)
    assert(b.parts.at(1).name == "d2" && b.parts.at(1).kind == "led" && target_text(b.parts.at(1).wires.at(0).to) == "GP17")
    assert(b.parts.at(2).name == "btn 1")
    assert(b.exposed_pins.len() == 2 && b.exposed_buses.len() == 1)

    param_named(b.parts.at(3).params, "address") match
        Some(p) -> assert(setting_text(p.value) == "93", setting_text(p.value))
        None -> assert(false, "no address")

    // A key naming a part with one control drives that control, which the checker fills in.
    assert(b.keys.len() == 1 && b.keys.at(0).key == "1" && b.keys.at(0).part == "btn 1")
    assert(b.keys.at(0).control == "press", b.keys.at(0).control)
    assert(b.view.elements.len() == 3)

    b.view.elements.at(1).shows match
        Caption(t) -> assert(t == "D1")
        _ -> assert(false, "the caption")

@test("a size is decimal, hexadecimal, or K or M of 1024 and 1048576 bytes")
form_sizes()
    for size in ["1M", "1024K", "0x100000", "1048576"]
        val b = clean_board(cores(s"    ram { part = ram, at = 0, size = $size }\n"))

        assert(b.parts.at(0).size.unwrap().n == 1048576, size)
        assert(b.parts.at(0).size.unwrap().written == size, size)

    assert(clean_board(cores("    ram { part = ram, at = 0, size = 4K }\n")).parts.at(0).size.unwrap().n == 4096)

@test("unicode in names, labels and captions reads, checks, and is written back as it was")
form_unicode()
    val text = """
        board {
          name = "Ünïcødé board ✓", chip = rp2040
          parts { "дёнь" { part = led, wire { anode = GP16 } } }
          view {
            size = [100, 100]
            elements { "λ" { show = "дёнь", at = [0, 0], size = [10, 10], label = "温度 ✓" } }
          }
        }
        """
    val b = clean_board(text)

    assert(b.name == "Ünïcødé board ✓" && b.parts.at(0).name == "дёнь")
    assert(b.view.elements.at(0).label == "温度 ✓")

    val written = round_trip(text, library())

    assert(written.contains("\"温度 ✓\"") && written.contains("\"Ünïcødé board ✓\""), written)

@test("a diagnostic after unicode points at the column a person counts, in characters")
form_unicode_column()
    // Counted: two spaces, `name = `, the four characters of `"✓✓"`, `, chip = `: column 23.
    val text = "board {\n  name = \"✓✓\", chip = ‸rp2041\n}\n"

    expect(text, "@1 unknown chip `rp2041`\n")
    expect(text, "2:23 unknown chip `rp2041`\n")

@test("comments anywhere change nothing, and are not written back")
form_comments()
    val plain = cores("    ram { part = ram, at = 0, size = 1M }\n")

    // HOCON has no block comments: the reader refuses the text, and the description reports it.
    assert(!diags("board { name = v, cores = [cortex-m0plus, /* no */ cortex-m0plus] }\n").is_empty())

    val with_comments = """
        // before
        board {  # the board
          name = v // its name
          cores = [cortex-m0plus, cortex-m0plus]
          parts {
            // the RAM
            ram { part = ram, at = 0, size = 1M }  # 1 MB
          }
        }
        // after
        """

    assert(round_trip(with_comments, library()) == round_trip(plain, library()))

// -- the top of a file -----------------------------------------------------------------------------

@test("a file is a board or a product: neither, both, or something else at the top is a mistake")
top_level()
    expect("", "1:1 the description is neither a board nor a product\n")
    expect("// nothing but a comment\n", "1:1 the description is neither a board nor a product\n")
    expect("board = pico\n‸product { name = k, boards { p { board = pico } } }\n", "@1 the description is both a board and a product\n")
    expect("product { name = k, boards { p { board = pico } } }\n‸board = pico\n", "@1 the description is both a board and a product\n")
    expect("‸parts {}\n", "@1 `parts` belongs inside `board { ... }` or `product { ... }`\n1:1 the description is neither a board nor a product\n")
    expect("board = pico\n‸panel {}\n", "@1 unknown section `panel`\n")
    expect("board = ‸1\n", "@1 `board` must be a block, or the name of a board, not a number\n")
    expect("board = ‸pico3\n", "@1 unknown board `pico3`\n")
    expect("board = ‸pico-breadboard-kit\n", "@1 `pico-breadboard-kit` is a product, and only a board is named here\n")
    expect("product = ‸1\n", "@1 the `product` section must be a block, not a number\n")
    expect("‸[1, 2]\n", "@1 a description is `board { ... }` or `product { ... }`, not an array\n")

// -- a board ---------------------------------------------------------------------------------------

@test("the board block: a name, and exactly one of a chip and cores")
board_section()
    expect("‸board { chip = rp2040 }\n", "@1 the board has no name\n")
    expect("‸board { name = t }\n", "@1 the board names neither a chip nor its cores\n")
    expect("board { name = v, chip = rp2040, cores = ‸[cortex-m0plus] }\n", "@1 the board names both a chip and cores\n")
    expect("board { name = t, chip = rp2040 }\n", "")
    expect("board { name = t, chip = rp2040, ‸panel { size = [1, 1] } }\n", "@1 unknown setting `panel` in `board`\n")

@test("cores: a list of names or option blocks, each a core the library knows")
board_cores()
    expect("board { name = v, cores = ‸cortex-m0plus }\n", "@1 `board.cores` must be a list of cores, not a string\n")
    expect("board { name = v, cores = ‸[] }\n", "@1 `board.cores` names no core\n")
    expect("board { name = v, cores = [‸1] }\n", "@1 a core is named by a word or a block, not a number\n")
    expect("board { name = v, cores = [‸cortex-m2, cortex-m0plus] }\n", "@1 unknown core `cortex-m2`\n")
    expect("board { name = v, cores = [cortex-m33] }\n", "")

@test("an unknown chip, and a setting the board does not have")
board_unknown()
    expect("board { name = t, chip = ‸rp2041 }\n", "@1 unknown chip `rp2041`\n")
    expect("board { name = t, chip = rp2040, ‸clock = 1 }\n", "@1 unknown setting `clock` in `board`\n")
    expect("board { name = ‸[1], chip = rp2040 }\n", "@1 `board.name` must be a word or a quoted string, not an array\n")

// -- exposure --------------------------------------------------------------------------------------

@test("a board exposes pins of its chip and buses it has, each once; a board with no chip exposes nothing")
board_exposes()
    expect(kit("", "  exposes { pins = [GP0, ‸GP30] }\n"), "@1 GP30 is not a pin of the rp2040\n")
    expect(kit("", "  exposes { pins = [GP0, ‸GP0] }\n"), "@1 GP0 is exposed twice\n")
    expect(kit("", "  exposes { pins = [GP0, ‸X1, ‸2] }\n"),
        "@1 `exposes.pins` lists pins such as `GP15`, and `X1` is not one\n@2 `exposes.pins` lists pins such as `GP15`, and `a number` is not one\n")
    expect(kit("", "  exposes { buses = [spi0, ‸spi9, ‸spi0] }\n"), "@1 the rp2040 has no bus `spi9`\n@2 `spi0` is exposed twice\n")
    expect(kit("", "  exposes { pins = ‸GP0 }\n"), "@1 `exposes.pins` must be a list, not a string\n")
    expect(kit("", "  exposes { buses = [‸[spi0]] }\n"), "@1 `exposes.buses` lists buses such as `spi0`, not an array\n")
    expect(kit("", "  exposes = ‸1\n"), "@1 `exposes` must be a block, not a number\n")
    expect(kit("", "  exposes { ‸pin = [GP0] }\n"), "@1 unknown setting `pin` in `exposes`\n")
    expect("board {\n  name = v, cores = [cortex-m0plus]\n  ‸exposes { pins = [GP0] }\n}\n", "@1 a board with no chip has no pins or buses to expose\n")
    // A pin the board wires itself may still be exposed, as an Arduino's D13 is its LED's.
    expect(kit("    d1 { part = led, wire { anode = GP25 } }\n", "  exposes { pins = [GP25] }\n"), "")

// -- the cores' bus --------------------------------------------------------------------------------

@test("a mapped part needs an address, aligned to what the part needs")
mapped_at()
    expect(cores("    ‸c { part = debug-console }\n"), "@1 `c` has no address\n")
    expect(cores("    c { part = debug-console, at = ‸0x40000004 }\n"), "@1 `c.at` is not aligned: a debug-console's base is a multiple of 0x10\n")
    expect(cores("    s { part = virt-sio, at = ‸0xD0000100 }\n"), "@1 `s.at` is not aligned: a virt-sio's base is a multiple of 0x1000\n")
    expect(cores("    c { part = debug-console, at = ‸zero }\n"), "@1 `c.at` must be a whole number such as `7` or `0x40000000`\n")
    expect(cores("    c { part = debug-console, at = ‸-16 }\n"), "@1 `c.at` must be a whole number such as `7` or `0x40000000`\n")

@test("a mapped part's size: fixed for some parts, required and more than 0 for a RAM, in one of the size forms")
mapped_size()
    expect(cores("    c { part = debug-console, at = 0x40000000, ‸size = 32 }\n"), "@1 the size of a debug-console is fixed, at 16 bytes (0x10)\n")
    expect(cores("    ram { part = ram, at = 0, size = ‸0 }\n"), "@1 `ram.size` must be more than 0\n")
    expect(cores("    ‸ram { part = ram, at = 0 }\n"), "@1 `ram` has no size\n")
    expect(cores("    ram { part = ram, at = 0, size = ‸1G }\n"), "@1 `ram.size` must be a whole number such as `4096`, `0x1000`, `64K` or `1M`\n")
    expect(cores("    ram { part = ram, at = 0, size = ‸M }\n"), "@1 `ram.size` must be a whole number such as `4096`, `0x1000`, `64K` or `1M`\n")

@test("an IRQ: only on a part that raises one, within the cores' count, and never two parts on one")
mapped_irq()
    expect(cores("    ram { part = ram, at = 0, size = 1M, ‸irq = 3 }\n"), "@1 a ram raises no interrupt, so `ram.irq` means nothing\n")
    expect(cores("    c { part = debug-console, at = 0x40000000, irq = ‸32 }\n"), "@1 IRQ 32 is beyond the cortex-m0plus's 32 interrupts\n")
    expect(cores("    c { part = debug-console, at = 0x40000000, irq = 31 }\n"), "")
    expect(cores("    c { part = debug-console, at = 0x40000000, irq = 5 }\n    s { part = virt-sio, at = 0xD0000000, irq = ‸5 }\n"),
        "@1 IRQ 5 is used twice\n")
    expect(cores("    c { part = debug-console, at = 0x40000000, irq = 5 }\n    s { part = virt-sio, at = 0xD0000000, irq = 6 }\n"), "")
    // A core sets the count: an M33 takes 480.
    expect("board {\n  name = v, cores = [cortex-m33]\n  parts { c { part = debug-console, at = 0x40000000, irq = 100 } }\n}\n", "")

@test("windows that meet overlap, whichever comes first; windows that touch do not")
mapped_overlap()
    expect(cores("    ram { part = ram, at = 0, size = 1M }\n    c { part = debug-console, at = ‸0x000FFFF0 }\n"),
        "@1 `c` (0x000ffff0 to 0x000fffff) overlaps `ram` (0x00000000 to 0x000fffff)\n")
    expect(cores("    c { part = debug-console, at = 0x000FFFF0 }\n    ram { part = ram, at = ‸0, size = 1M }\n"),
        "@1 `ram` (0x00000000 to 0x000fffff) overlaps `c` (0x000ffff0 to 0x000fffff)\n")
    expect(cores("    ram { part = ram, at = 0, size = 1M }\n    c { part = debug-console, at = 0x00100000 }\n"), "")
    expect(cores("    a { part = debug-console, at = 0x40000000 }\n    b { part = debug-console, at = ‸0x40000000 }\n"),
        "@1 `b` (0x40000000 to 0x4000000f) overlaps `a` (0x40000000 to 0x4000000f)\n")
    expect(cores("    a { part = debug-console, at = 0x40000000 }\n    b { part = debug-console, at = 0x40000010 }\n"), "")

@test("a window over the cores' own block, or past the top of the address space, is refused")
mapped_reserved()
    expect(cores("    c { part = debug-console, at = ‸0xE000E000 }\n"),
        "@1 `c` (0xe000e000 to 0xe000e00f) overlaps the cores' own private peripheral bus\n")
    expect(cores("    c { part = debug-console, at = ‸0xE00FFFF0 }\n"),
        "@1 `c` (0xe00ffff0 to 0xe00fffff) overlaps the cores' own private peripheral bus\n")
    expect(cores("    c { part = debug-console, at = 0xE0100000 }\n    d { part = debug-console, at = 0xDFFFFFF0 }\n"), "")
    expect(cores("    ram { part = ram, at = ‸0xFFFFF000, size = 64K }\n"),
        "@1 `ram` runs past the end of the address space: 65536 bytes from 0xfffff000 end beyond 0xffffffff\n")
    expect(cores("    ram { part = ram, at = 0xFFFFF000, size = 4K }\n"), "")

@test("a part off the cores' bus has no address, size or IRQ")
mapped_unmapped()
    expect(kit("    d1 { part = led, ‸at = 0x40000000, ‸size = 4, ‸irq = 2, wire { anode = GP16 } }\n"),
        "@1 a led is not on the cores' bus, so `d1.at` means nothing\n" +
        "@2 a led is not on the cores' bus, so `d1.size` means nothing\n" +
        "@3 a led is not on the cores' bus, so `d1.irq` means nothing\n")

// -- parts and wiring ------------------------------------------------------------------------------

@test("parts: a block of blocks, each naming its library part")
parts_shape()
    expect("board {\n  name = t, chip = rp2040\n  parts = ‸1\n}\n", "@1 `parts` must be a block, not a number\n")
    expect(kit("    d1 = ‸led\n"), "@1 the part `d1` must be a block, not a string\n")
    expect(kit("    ‸d1 { wire { anode = GP16 } }\n"), "@1 `d1` names no part\n")
    expect(kit("    d1 { part = ‸lde, wire { anode = GP16 } }\n"), "@1 unknown part `lde`\n")
    expect(kit("    d1 { part = led, color = ‸[1], wire { anode = GP16 } }\n"), "@1 `d1.color` must be a single value, not an array\n")

@test("wires: to a pin of the chip, once each")
wires_pins()
    expect(kit("    d1 { part = led, wire { anode = GP16 } }\n    d2 { part = led, wire { anode = ‸GP16 } }\n"), "@1 GP16 is wired twice\n")
    expect(kit("    d1 { part = led, wire { anode = ‸GP30 } }\n"), "@1 GP30 is not a pin of the rp2040\n")
    expect(kit("    ‸d1 { part = led, wire { ‸cathode = GP16 } }\n"), "@2 `d1` (led) has no port `cathode`\n@1 `d1.anode` is not wired\n")
    expect(kit("    ‸d1 { part = led }\n"), "@1 `d1.anode` is not wired\n")
    expect(kit("    ‸d1 { part = led, wire { anode = ‸[1] } }\n"),
        "@2 `d1.wire.anode` must be a pin, a bus or a part's port, not an array\n@1 `d1.anode` is not wired\n")
    expect(kit("    d1 { part = led, wire { anode = ‸spi0 } }\n"), "@1 `d1.anode` takes a pin, and `spi0` is a bus\n")

@test("an ADC port takes a pin with an ADC channel")
wires_adc()
    expect(kit("    j { part = joystick, wire { x = ‸GP2, y = GP27 } }\n"), "@1 `j.x` takes an ADC pin, and GP2 has no ADC channel\n")

val WIFI = "    w { part = cyw43439, wire { wl_on = GP23, data = GP24, cs = GP25, clock = GP29 } }\n"

@test("a pin another part offers: wired once, by a pin port, and only where it is offered")
wires_offered()
    expect(kit(s"$WIFI    j { part = joystick, wire { x = ‸w.gpio0, y = GP27 } }\n"), "@1 `j.x` takes an ADC pin, and `w.gpio0` is a part's port\n")
    expect(kit(s"$WIFI    a { part = led, wire { anode = w.gpio0 } }\n    b { part = led, wire { anode = ‸w.gpio0 } }\n"), "@1 `w.gpio0` is wired twice\n")
    expect(kit("    d1 { part = led, wire { anode = ‸x.gpio0 } }\n"), "@1 `x` is not a part\n")
    expect(kit(s"$WIFI    d1 { part = led, wire { anode = ‸w.gpio9 } }\n"), "@1 `w` (cyw43439) has no port `gpio9`\n")
    expect(kit(s"$WIFI    d1 { part = led, wire { anode = ‸w.cs } }\n"), "@1 `w.cs` is not a pin another part can be wired to\n")
    expect(kit("    w { part = cyw43439, wire { wl_on = GP23, data = GP24, cs = GP25, clock = GP29, ‸gpio0 = GP2 } }\n"),
        "@1 `w.gpio0` is a pin `w` offers to other parts\n")

@test("a bus port takes a bus of its kind that `buses` wires")
wires_buses()
    expect(kit("    c { part = terminal, wire { uart = ‸GP0 } }\n"), "@1 `c.uart` takes a UART bus, and `GP0` is not one\n")
    expect(kit("    c { part = terminal, wire { uart = ‸uart9 } }\n"), "@1 the rp2040 has no bus `uart9`\n")
    expect(kit("    c { part = terminal, wire { uart = ‸spi0 } }\n", "  buses { spi0 { sck = GP2 } }\n"), "@1 `c.uart` takes a UART bus, and `spi0` is an SPI bus\n")
    expect(kit("    c { part = terminal, wire { uart = ‸uart0 } }\n"), "@1 `c.uart` uses `uart0`, which `buses` does not wire\n")

@test("buses: the chip's controllers, their signals, on pins that can carry them")
buses_section()
    expect(kit("", "  buses { ‸spi9 { sck = GP2 } }\n"), "@1 the rp2040 has no bus `spi9`\n")
    expect(kit("", "  buses { spi0 { ‸clk = GP2 } }\n"), "@1 `spi0` has no signal `clk`\n")
    expect(kit("", "  buses { spi0 { sck = ‸GP3 } }\n"), "@1 GP3 cannot carry `spi0.sck`\n")
    expect(kit("", "  buses { spi0 { sck = ‸X2 } }\n"), "@1 `spi0.sck` must be a pin such as `GP2`\n")
    expect(kit("    ‸spi0 { part = led, wire { anode = GP16 } }\n", "  buses { spi0 { sck = GP2 } }\n"), "@1 duplicate name `spi0`\n")
    expect(kit("", "  buses { spi0 { sck = GP2 }, i2c1 { sda = ‸GP2 } }\n"), "@1 GP2 is wired twice\n")

@test("parameters: known to the part, of its type and range, and the required ones given")
params()
    expect(kit("    d1 { part = led, ‸colour = red, wire { anode = GP16 } }\n"), "@1 `d1` (led) has no parameter `colour`\n")
    expect(kit("    b { part = buzzer, kind = passive, tone = ‸5, wire { pin = GP13 } }\n"), "@1 `b.tone` must be from 20 to 20000, not 5\n")
    expect(kit("    b { part = buzzer, kind = passive, tone = ‸high, wire { pin = GP13 } }\n"), "@1 `b.tone` must be a whole number, not `high`\n")
    expect(kit("    d1 { part = led, color = ‸purple, wire { anode = GP16 } }\n"),
        "@1 `d1.color` must be one of `red`, `green`, `blue`, `yellow`, `orange` and `white`, not `purple`\n")
    expect(kit("    ‸b { part = buzzer, wire { pin = GP13 } }\n"), "@1 `b` (buzzer) needs `kind`\n")
    expect(kit("    l { part = st7796, width = 320, height = 480, invert = ‸maybe, wire { spi = spi0, cs = GP5, dc = GP6 } }\n",
        "  buses { spi0 { sck = GP2, tx = GP3 } }\n"),
        "@1 `l.invert` must be `true` or `false`, not `maybe`\n")

@test("a number and a text parameter, through a registry of the test's own")
params_own_registry()
    var reg = library()
    var ps: Buf[ParamSpec] = buf()

    ps.push(ParamSpec("gain", PNumber, false))
    ps.push(ParamSpec("tag", PText, false))
    reg.parts.push(PartSpec("probe", "a part for this test", true, false, ps, buf(), buf(), None))

    expect_in(kit("    p { part = probe, gain = 1.5, tag = x }\n"), "", reg, built_in_shelf())
    expect_in(kit("    p { part = probe, gain = ‸high }\n"), "@1 `p.gain` must be a number, not `high`\n", reg, built_in_shelf())
    expect_in(kit("    p { part = probe, tag = ‸7 }\n"), "@1 `p.tag` must be text, not `7`\n", reg, built_in_shelf())

// -- the view and input ----------------------------------------------------------------------------

val LED = "    d1 { part = led, wire { anode = GP16 } }\n"

@test("the view: a size, and elements that draw one thing each, placed and sized in it")
view()
    expect(kit("", "  ‸view { background = black }\n"), "@1 the view has no size\n")
    expect(kit("", "  ‸view { size = [0, 10] }\n"), "@1 the view's size must be positive, not 0 × 10\n")
    expect(kit("", "  view { size = ‸[10] }\n"), "@1 `view.size` must be [width, height], two whole numbers\n")
    expect(kit("", "  view { size = [9, 9], ‸colour = red }\n"), "@1 unknown setting `colour` in `view`\n")
    expect(kit(LED, "  view { size = [100, 100], elements { ‸e { at = [0, 0] } } }\n"),
        "@1 the element `e` does not say what it draws\n@1 the element `e` has no size\n")
    expect(kit(LED, "  view { size = [100, 100], elements { ‸e { show = d1, text = x, at = [0, 0], size = [1, 1] } } }\n"),
        "@1 the element `e` says both `show` and `text`\n")
    expect(kit(LED, "  view { size = [100, 100], elements { ‸e { show = d1, size = [1, 1] } } }\n"), "@1 the element `e` has no place in the view\n")
    expect(kit(LED, "  view { size = [100, 100], elements { e { ‸show = nope, at = [0, 0], size = [1, 1] } } }\n"),
        "@1 the element `e` shows `nope`, which is not a part\n")
    expect(kit(LED, "  view { size = [100, 100], elements { ‸e { show = d1, at = [0, 0] } } }\n"), "@1 the element `e` has no size\n")
    expect(kit(LED, "  view { size = [100, 100], elements { ‸e { show = d1, at = [0, 0], size = [0, 5] } } }\n"),
        "@1 the element `e` must have a positive size, not 0 × 5\n")
    expect(kit(LED, "  view { size = [100, 100], elements { ‸e { show = d1, at = [95, 0], size = [10, 10] } } }\n"),
        "@1 the element `e` lies outside the view\n")
    expect(kit(LED, "  view { size = [100, 100], elements { e { show = d1, at = [90, 90], size = [10, 10], ‸spin = 1 } } }\n"),
        "@1 unknown setting `spin` in the element `e`\n")

@test("an element's look: a colour, a shape, a quarter-turn rotation, and nothing else")
view_look()
    val at = "  view { size = [100, 100], elements { e { show = d1, at = [0, 0], size = [9, 9], look { "

    expect(kit(LED, s"${at}color = ‸5 } } } }\n"), "@1 `e.look.color` must be a colour, as \"#20c040\" or `green`\n")
    expect(kit(LED, s"${at}shape = ‸oval } } } }\n"), "@1 `e.look.shape` must be `round` or `square`, not `oval`\n")
    expect(kit(LED, s"${at}rotate = ‸45 } } } }\n"), "@1 `e.look.rotate` must be 0, 90, 180 or 270, not `45`\n")
    expect(kit(LED, s"${at}‸colr = red } } } }\n"), "@1 unknown look `colr` in the element `e`\n")
    expect(kit(LED, s"${at}color = \"#20c040\", shape = round, rotate = 270 } } } }\n"), "")

val KEYS = "    j { part = joystick, wire { x = GP26, y = GP27 } }\n    d1 { part = led, wire { anode = GP16 } }\n"

@test("input: each key a known key driving a control of a part; each pointer an element over a part that takes a point")
input()
    expect(kit(KEYS, "  input { keys { ‸upp = j.up } }\n"), "@1 unknown key `upp`\n")
    expect(kit(KEYS, "  input { keys { up = ‸nope } }\n"), "@1 `nope` is not a part\n")
    expect(kit(KEYS, "  input { keys { up = ‸d1 } }\n"), "@1 `d1` (led) has no control a key can drive\n")
    expect(kit(KEYS, "  input { keys { up = ‸j } }\n"), "@1 `j` has several controls: name one, as `j.up`\n")
    expect(kit(KEYS, "  input { keys { up = ‸j.upp } }\n"), "@1 `j` (joystick) has no control `upp`\n")
    expect(kit(KEYS, "  input { keys { up = j.up, ‸up = j.down } }\n"), "@1 the key `up` is bound twice\n")
    expect(kit(KEYS, "  input { pointer { ‸nope = ‸d1 } }\n"),
        "@1 `nope` is not an element of the view\n@2 `d1` (led) cannot be driven by the pointer: it takes no `point`\n")
    expect(kit(KEYS, "  input { ‸mouse { } }\n"), "@1 unknown setting `mouse` in `input`\n")

@test("a name written twice is one mistake, pointed at the second, however much the two copies hold")
repeats()
    expect(kit(s"$LED    ‸d1 { part = led, wire { anode = GP17 } }\n"), "@1 duplicate name `d1`\n")
    // The two copies both set `part`, `color` and `wire.anode`: still the one mistake.
    expect(kit("    d1 { part = led, color = red, wire { anode = GP16 } }\n    ‸d1 { part = led, color = red, wire { anode = GP17 } }\n"),
        "@1 duplicate name `d1`\n")
    expect(kit("    d1 { part = led, color = red, ‸color = red, wire { anode = GP16 } }\n"), "@1 `d1.color` is set twice\n")
    expect(kit("    d1 { part = led, wire { anode = GP16, ‸anode = GP17 } }\n"), "@1 `d1.anode` is wired twice\n")
    expect("board { name = t, ‸name = u, chip = rp2040 }\n", "@1 `board.name` is set twice\n")
    expect(kit("", "  buses { spi0 { sck = GP2 }, ‸spi0 { tx = GP3 } }\n"), "@1 duplicate name `spi0`\n")
    expect(kit(LED, "  view { size = [9, 9], elements { e { text = a, at = [0, 0], size = [1, 1] }, ‸e { text = b, at = [0, 0], size = [1, 1] } } }\n"),
        "@1 duplicate name `e`\n")

// -- a product -------------------------------------------------------------------------------------

@test("a product: a name and at least one board, each naming the board it is")
product_section()
    expect("‸product { boards { p { board = pico } } }\n", "@1 the product has no name\n")
    expect("‸product { name = k }\n", "@1 the product has no boards\n")
    expect("product { name = k, ‸boards {} }\n", "@1 the product has no boards\n")
    expect("product { name = k, boards { ‸p {} } }\n", "@1 `p` names no board\n")
    expect("product { name = k, boards { p = ‸pico } }\n", "@1 the board `p` must be a block, not a string\n")
    expect("product { name = k, boards { p { board = pico, ‸chip = rp2040 } } }\n", "@1 unknown setting `chip` in the board `p`\n")
    expect("product { name = k, boards { p { board = ‸pico3 } } }\n", "@1 unknown board `pico3`\n")
    expect("product { name = k, boards { p { board = ‸pico-breadboard-kit } } }\n", "@1 `pico-breadboard-kit` is a product, and only a board is named here\n")
    expect("product { name = k, boards { p { board = pico } }, ‸exposes {} }\n", "@1 unknown setting `exposes` in `product`\n")
    expect(product(PICO, ""), "")

@test("two boards of one kind, under names of their own, each wired separately, with a part on each")
product_two_boards()
    val text = product("    left { board = pico }\n    right { board = pico }\n",
        "    a { part = led, wire { anode = left.GP15 } }\n" +
        "    b { part = led, wire { anode = right.GP15 } }\n" +
        "    ca { part = terminal, wire { uart = left.uart0 } }\n" +
        "    cb { part = terminal, wire { uart = right.uart1 } }\n",
        "  buses { left.uart0 { tx = GP0, rx = GP1 }, right.uart1 { tx = GP4, rx = GP5 } }\n")
    val p = clean(text).product

    assert(p.boards.len() == 2 && p.boards.at(0).name == "left" && p.boards.at(1).name == "right")
    assert(p.boards.at(0).found && p.boards.at(1).found && p.boards.at(0).board.name == p.boards.at(1).board.name)
    assert(p.buses.len() == 2 && p.buses.at(1).board == "right" && p.buses.at(1).name == "uart1")

    val s = summary(clean(text), library())

    assert(s.contains("  board left   pico: the rp2040") && s.contains("  board right  pico: the rp2040"), s)
    assert(s.contains("  bus left.uart0: tx = GP0, rx = GP1\n  bus right.uart1: tx = GP4, rx = GP5\n"), s)
    round_trip(text, library())

    // Each board's pins are its own: the same pin of the other board is wired, and the bus one board
    // routes is not the other's.
    expect(product("    left { board = pico }\n    right { board = pico }\n",
        "    a { part = led, wire { anode = left.GP15 } }\n    b { part = led, wire { anode = ‸left.GP15 } }\n"),
        "@1 `left.GP15` is wired twice\n")
    expect(product("    left { board = pico }\n    right { board = pico }\n",
        "    c { part = terminal, wire { uart = ‸right.uart0 } }\n", "  buses { left.uart0 { tx = GP0 } }\n"),
        "@1 `c.uart` uses `right.uart0`, which `buses` does not wire\n")

@test("a product's part is wired to what a board exposes, once across the product")
product_wiring()
    val led = "    d1 { part = led, wire { anode = "

    expect(product(PICO, s"${led}‸pico.GP25 } }\n"), "@1 `pico` does not expose GP25\n")
    expect(product(PICO, s"${led}‸pico.GP99 } }\n"), "@1 `pico` does not expose GP99\n")
    expect(product(PICO, s"${led}pico.GP15 } }\n    d2 { part = led, wire { anode = ‸pico.GP15 } }\n"), "@1 `pico.GP15` is wired twice\n")
    expect(product(PICO, s"${led}‸pcio.GP15 } }\n"), "@1 `pcio` is neither a board nor a part of the product\n")
    expect(product(PICO, s"${led}‸GP15 } }\n"), "@1 `d1.anode` names `GP15` without its board\n")
    expect(product(PICO, s"${led}‸pico.spi0 } }\n"), "@1 `d1.anode` takes a pin, and `pico.spi0` is not one\n")
    expect(product(PICO, "    j { part = joystick, wire { x = ‸pico.GP2, y = pico.GP27 } }\n"), "@1 `j.x` takes an ADC pin, and `pico.GP2` has no ADC channel\n")
    expect(product(PICO, "    c { part = terminal, wire { uart = ‸uart0 } }\n"), "@1 `c.uart` names `uart0` without its board\n")
    expect(product(PICO, "    c { part = terminal, wire { uart = ‸pico.uart0 } }\n"), "@1 `c.uart` uses `pico.uart0`, which `buses` does not wire\n")
    expect(product(PICO, "    c { part = terminal, wire { uart = ‸pico.spi0 } }\n", "  buses { pico.spi0 { sck = GP2 } }\n"),
        "@1 `c.uart` takes a UART bus, and `pico.spi0` is an SPI bus\n")
    expect(product(PICO, "    c { part = terminal, wire { uart = ‸pico.GP0 } }\n"), "@1 `c.uart` takes a UART bus, and `pico.GP0` is not one\n")
    expect(product(PICO, "    w { part = cyw43439, wire { wl_on = pico.GP16, data = pico.GP17, cs = pico.GP18, clock = pico.GP19 } }\n" +
        "    c { part = terminal, wire { uart = ‸w.gpio0 } }\n"), "@1 `c.uart` takes a UART bus, and `w.gpio0` is not one\n")
    expect(product(PICO, "    c { part = terminal, ‸at = 0x40000000, wire { uart = pico.uart0 } }\n", "  buses { pico.uart0 { tx = GP0 } }\n"),
        "@1 `c` is outside the product's boards, so `c.at` means nothing\n")
    expect(product(PICO, "    ‸pico { part = led, wire { anode = pico.GP15 } }\n"), "@1 duplicate name `pico`\n")
    // A part of the product may still be wired to a pin another of its parts offers.
    expect(product(PICO, "    w { part = cyw43439, wire { wl_on = pico.GP16, data = pico.GP17, cs = pico.GP18, clock = pico.GP19 } }\n" +
        s"${led}w.gpio0 } }\n    d2 { part = led, wire { anode = ‸w.gpio0 } }\n"), "@1 `w.gpio0` is wired twice\n")

@test("a pin the board wires itself is not the product's to wire again")
product_board_pins()
    val wired = "board {\n  name = b, chip = rp2040\n  parts { d { part = led, wire { anode = GP15 } } }\n  exposes { pins = [GP15, GP16] }\n}\n"
    val shelf = shelf_with(files([("b.hocon", wired)]))

    expect_in(product("    b { board = \"b.hocon\" }\n", "    d1 { part = led, wire { anode = ‸b.GP15 } }\n    d2 { part = led, wire { anode = b.GP16 } }\n"),
        "@1 `b.GP15` is wired twice\n", library(), shelf)

@test("a product's buses: a board's exposed bus, its signals on exposed pins that can carry them, each pin once")
product_buses()
    val c = "    c { part = terminal, wire { uart = pico.uart0 } }\n"

    expect(product(PICO, c, "  buses { pico.uart0 { tx = GP0, rx = GP1 } }\n"), "")
    expect(product(PICO, c, "  buses { pico.uart0 { tx = ‸GP2 } }\n"), "@1 GP2 cannot carry `pico.uart0.tx`\n")
    expect(product(PICO, c, "  buses { pico.uart0 { ‸clk = GP0 } }\n"), "@1 `pico.uart0` has no signal `clk`\n")
    expect(product(PICO, c, "  buses { pico.uart0 { tx = GP0 }, pico.i2c0 { sda = ‸GP0 } }\n"), "@1 `pico.GP0` is wired twice\n")
    expect(product(PICO, c, "  buses { pico.uart0 { tx = GP0 }, ‸pcio.i2c0 { sda = GP4 } }\n"), "@1 `pcio` is neither a board nor a part of the product\n")
    // The buses are routed first, so the part is the second to want the pin.
    expect(product(PICO, "    d1 { part = led, wire { anode = ‸pico.GP0 } }\n", "  buses { pico.uart0 { tx = GP0 } }\n"), "@1 `pico.GP0` is wired twice\n")
    expect(product(PICO, "", "  buses { pico.uart0 { tx = GP0 }, pico.‸uart0 { tx = GP12 } }\n"), "@1 duplicate name `pico.uart0`\n")
    expect(product(PICO, "", "  buses { pico { uart0 { tx = GP0 } }, pico { ‸uart0 { tx = GP12 } } }\n"), "@1 duplicate name `pico.uart0`\n")
    expect(product(PICO, "", "  buses { pico.uart0 { tx = ‸X0 } }\n"), "@1 `pico.uart0.tx` must be a pin such as `GP2`\n")
    expect(product(PICO, "", "  buses { pico = ‸1 }\n"), "@1 the buses of `pico` must be a block, not a number\n")
    expect(product(PICO, "", "  buses { pico.uart0 = ‸1 }\n"), "@1 the bus `pico.uart0` must be a block, not a number\n")
    expect(product(PICO, "", "  buses { pico.‸spi9 { sck = GP2 } }\n"), "@1 `pico` does not expose `spi9`\n")

    // A board that exposes neither the bus nor the pin.
    val narrow = "board {\n  name = n, chip = rp2040\n  exposes { pins = [GP0], buses = [uart0] }\n}\n"
    val shelf = shelf_with(files([("n.hocon", narrow)]))

    expect_in(product("    n { board = \"n.hocon\" }\n", "", "  buses { n.uart0 { tx = GP0, rx = ‸GP1 }, n.‸i2c0 { sda = GP0 } }\n"),
        "@1 `n` does not expose GP1\n@2 `n` does not expose `i2c0`\n", library(), shelf)

@test("a product's view shows its parts, and its boards' as `pico.led`")
product_view()
    val v = "  view { size = [50, 50], elements { e { ‸show = "

    expect(product(PICO, replace_all(LED, "GP16", "pico.GP16"),"  view { size = [50, 50], elements { e { show = pico.led, at = [0, 0], size = [9, 9] }, f { show = d1, at = [9, 0], size = [9, 9] } } }\n"), "")
    expect(product(PICO, "", s"${v}pico.nope, at = [0, 0], size = [9, 9] } } }\n"), "@1 the element `e` shows `pico.nope`, which is not a part\n")
    expect(product(PICO, "", s"${v}led, at = [0, 0], size = [9, 9] } } }\n"), "@1 the element `e` shows `led`, which is not a part\n")

@test("overrides: a board's part's parameters, set by the product, and nothing else")
product_overrides()
    val text = product("    pico { board = pico, parts.led.color = red, parts { led { active = low } } }\n", "")
    val inst = clean(text).product.boards.at(0)

    assert(inst.overrides.len() == 2)

    val led = part_named(inst.board.parts, "led").unwrap()

    assert(setting_text(param_named(led.params, "color").unwrap().value) == "red")
    assert(setting_text(param_named(led.params, "active").unwrap().value) == "low")
    assert(round_trip(text, library()).contains("pico {\n      board = pico\n      parts {\n        led {\n          color = red\n          active = low\n        }\n      }\n    }\n"),
        round_trip(text, library()))

    // The board built in is untouched by a product's overrides.
    assert(setting_text(param_named(part_named(clean_board(bundled("pico")).parts, "led").unwrap().params, "color").unwrap().value) == "green")

    val o = "    pico { board = pico, parts { "

    expect(product(s"$o‸ledd { color = red } } }\n", ""), "@1 `pico` (pico) has no part `ledd`\n")
    expect(product(s"${o}led { ‸colour = red } } }\n", ""), "@1 `pico.parts.led` (led) has no parameter `colour`\n")
    expect(product(s"${o}led { color = ‸purple } } }\n", ""),
        "@1 `pico.parts.led.color` must be one of `red`, `green`, `blue`, `yellow`, `orange` and `white`, not `purple`\n")
    expect(product(s"${o}led { ‸wire { anode = GP15 } } } }\n", ""), "@1 `pico.parts.led.wire` cannot be overridden\n")
    expect(product(s"${o}led { ‸at = 0 } } }\n", ""), "@1 `pico.parts.led.at` cannot be overridden\n")
    expect(product(s"${o}led = ‸red } }\n", ""), "@1 `pico.parts.led` must be a block, not a string\n")
    expect(product(s"${o}led { color = red, ‸color = blue } } }\n", ""), "@1 `pico.parts.led.color` is set twice\n")

@test("a product's board may be a file, found from the product's directory")
product_board_file()
    val mine = "board {\n  name = mine, chip = rp2040\n  parts { d { part = led, wire { anode = GP25 } } }\n  exposes { pins = [GP15] }\n}\n"
    val broken = "board {\n  name = broken, chip = rp2041\n}\n"
    val shelf = shelf_with(files([("kits/mine.hocon", mine), ("kits/broken.hocon", broken), ("kits/loop.hocon", "board = \"loop.hocon\"\n")]))
    val text = "product {\n  name = k\n  boards { m { board = \"mine.hocon\" } }\n  parts { d1 { part = led, wire { anode = m.GP15 } } }\n}\n"
    val got = load(source_of("kits/p.hocon", text), library(), shelf)

    assert(!got.report.has_errors() && got.description.product.boards.at(0).board.name == "mine")

    val bad = load(source_of("kits/p.hocon", "product {\n  name = k\n  boards { m { board = \"broken.hocon\" } }\n}\n"), library(), shelf)

    assert(bad.report.len() == 1 && bad.report.at(0).message == "the board `broken.hocon` has mistakes", bad.report.at(0).message)
    assert(bad.report.at(0).note.contains("unknown chip `rp2041`"), bad.report.at(0).note)

    val circle = load(source_of("kits/p.hocon", "board = \"loop.hocon\"\n"), library(), shelf)

    assert(circle.report.len() == 1 && circle.report.at(0).message == "the board `loop.hocon` has mistakes")
    assert(circle.report.at(0).note.contains("`loop.hocon` is not a board: the boards name each other in a circle"), circle.report.at(0).note)

@test("a product's names written twice: a board, a bus, a board's own setting")
product_repeats()
    expect("product { name = k, boards { p { board = pico }, ‸p { board = pico } } }\n", "@1 duplicate name `p`\n")
    expect("product { name = k, boards { p { board = pico, ‸board = pico } } }\n", "@1 `p.board` is set twice\n")

// -- an unknown section ----------------------------------------------------------------------------

@test("an unknown section is named, with the nearest one")
unknown_section()
    expect("board = pico\n‸boardd {}\n", "@1 unknown section `boardd`\n")
    expect(kit("", "  ‸boards {}\n"), "@1 unknown setting `boards` in `board`\n")

// -- a large board ---------------------------------------------------------------------------------

@test("a board of 2000 LEDs on a 4000-pin chip, each drawn, checks clean and writes back as itself")
large_board()
    var reg = library()
    var pins: Buf[int] = buf()

    reg.chips.push(ChipSpec("big", "a chip with 4000 pins", "cortex-m0plus", 4000, pins, buf()))

    var text = str_builder()

    text.push("board {\n  name = big, chip = big\n  parts {\n")

    for i in 0..<2000 do text.push(s"    d$i { part = led, color = red, wire { anode = GP${i * 2} } }\n")

    text.push("  }\n  view {\n    size = [2000, 100]\n    elements {\n")

    for i in 0..<2000 do text.push(s"      e$i { show = d$i, at = [$i, 0], size = [1, 1] }\n")

    text.push("    }\n  }\n}\n")

    val src = text.finish()

    assert(diags_with(src, reg) == "", diags_with(src, reg))

    val written = round_trip(src, reg)

    assert(written.contains("d1999 {") && written.contains("anode = GP3998"))

    // One more LED on a pin already taken is the one mistake.
    val wrong = replace_all(src, "anode = GP3998", "anode = ‸GP0")

    expect_in(wrong, "@1 GP0 is wired twice\n", reg, built_in_shelf())
