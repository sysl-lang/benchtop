module sh.sysl.benchtop
@tests

// The drawing of a checked view: a view that shows no board whole is drawn as written, and a board
// shown whole is drawn in place — its background, then its elements named as the product names them,
// moved and turned with it — at every turn, for an empty board, a large one, and every bundled board.

import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// A product of `boards` whose view, `size` big, holds `elements`.
private showing(boards: string, elements: string, size: string = "[440, 440]") -> string =
    s"product {\n  name = k\n  boards {\n$boards  }\n  view {\n    size = $size\n    elements {\n$elements    }\n  }\n}\n"

// The built-in descriptions, and the file `b.hocon` holding `board`.
private shelf_of(board: string) -> Shelf =
    Shelf(bundled_descriptions(), bundled_chips(), file ->
        var found: Result[string, string] = Err("no such file")

        if file == "b.hocon" then found = Ok(board)

        found)

// The product `text` reads to, which must check clean.
private product_of(text: string, shelf: Shelf = built_in_shelf()) -> Product
    val src = source_of("t.hocon", text)
    val got = load(src, library(), shelf)

    assert(!got.report.has_errors(), got.report.render(src))
    got.description.product

private drawn(p: Product) -> View = drawing(p.view, Scope(p.parts, p.boards))

private named(v: View, name: string) -> Element
    for e in v.elements do if e.name == name then return e

    assert(false, s"no element `$name`")
    v.elements.at(0)

private names(v: View) -> string
    var out = str_builder()

    for e in v.elements
        if !out.is_empty then out.push(" ")
        out.push(e.name)

    out.finish()

private shown(e: Element) -> string = e.shows match
    ShowPart(n) -> s"part $n"
    ShowBoard(n) -> s"board $n"
    Caption(t) -> s"text $t"
    Fill(c) -> s"box $c"

private has(xs: Buf[string], x: string) -> bool
    for y in xs do if y == x then return true

    false

private kit() -> string
    for (n, text) in bundled_descriptions() do if n == "pico-breadboard-kit" then return text

    assert(false, "no bundled kit")
    ""

private box(e: Element) -> (int, int, int, int) = (e.x, e.y, e.w, e.h)

// Every element after the first lies in the first's box: a board's elements in the board.
private inside_board(v: View)
    val b = v.elements.at(0)

    for e in v.elements
        assert(e.x >= b.x && e.y >= b.y && e.x + e.w <= b.x + b.w && e.y + e.h <= b.y + b.h,
            s"`${e.name}` at ${e.x}, ${e.y} (${e.w} × ${e.h}) is outside `${b.name}`")

@test("a view that shows no board whole is drawn as written, and an empty one draws nothing")
drawing_as_written()
    val kit = product_of(kit())
    val d = drawn(kit)

    assert(d.width == kit.view.width && d.height == kit.view.height && d.background == kit.view.background)
    assert(d.elements.len() == kit.view.elements.len())

    for i in 0..<d.elements.len()
        val a = d.elements.at(i)
        val b = kit.view.elements.at(i)

        assert(a.name == b.name && shown(a) == shown(b) && box(a) == box(b) && a.label == b.label && a.look.len() == b.look.len())

    val empty = drawn(product_of(showing("    pico { board = pico }\n", "")))

    assert(empty.elements.is_empty() && empty.width == 440)

    val none = drawn(product_of("product {\n  name = k\n  boards { pico { board = pico } }\n}\n"))

    assert(none.elements.is_empty() && none.width == 0 && none.height == 0)

@test("a board shown whole: its background, then its elements in place, named and showing as the product names them")
drawing_whole_board()
    val p = product_of(showing("    pico { board = pico }\n", "      p { show = pico, at = [10, 5], label = Pico }\n"))
    val d = drawn(p)

    assert(names(d) == "p pico.usb pico.led pico.bootsel pico.mcu", names(d))
    assert(shown(d.elements.at(0)) == "board pico" && box(d.elements.at(0)) == (10, 5, 168, 408) && d.elements.at(0).label == "Pico")
    assert(shown(named(d, "pico.led")) == "part pico.led" && box(named(d, "pico.led")) == (38, 21, 16, 10))
    assert(shown(named(d, "pico.usb")) == "box #c0c0c0" && box(named(d, "pico.usb")) == (62, 5, 64, 40))
    assert(named(d, "pico.mcu").label == "RP2040")

    // The part it shows is the board's, as the product's scope finds it.
    val scope = Scope(p.parts, p.boards)

    assert(scope.find("pico.led").unwrap().kind == "led")
    inside_board(d)

@test("a board shown whole turns with its `rotate`, each element moved and turned within it")
drawing_turned_board()
    val led = [(0, (38, 21, 16, 10)), (90, (392, 33, 10, 16)), (180, (134, 387, 16, 10)), (270, (26, 129, 10, 16))]

    for (turn, want) in led
        val d = drawn(product_of(showing("    pico { board = pico }\n", s"      p { show = pico, at = [10, 5], look { rotate = $turn } }\n")))

        assert(box(named(d, "pico.led")) == want, s"at $turn: ${box(named(d, "pico.led"))}")
        inside_board(d)

    // Four quarter turns, or a quarter and three, put a box back where it was.
    var b = (3, 4, 5, 6)

    for _ in 0..<4 do b = turned(b.0, b.1, b.2, b.3, if b.2 == 5 then 20 else 30, if b.2 == 5 then 30 else 20, 90)

    assert(b == (3, 4, 5, 6), s"$b")

    val q = turned(3, 4, 5, 6, 20, 30, 90)

    assert(turned(q.0, q.1, q.2, q.3, 30, 20, 270) == (3, 4, 5, 6))
    assert(turned(3, 4, 5, 6, 20, 30, 180) == (12, 20, 5, 6))

@test("an element's own `rotate` adds to its board's, and the board's view is left as it was")
drawing_turn_adds()
    val board = "board {\n  name = b, mcu = rp2040\n  parts { led { part = led, color = red, wire { anode = GP25 } } }\n  view {\n    size = [40, 20]\n    elements { l { show = led, at = [2, 3], size = [10, 6], look { rotate = 90, color = blue } } }\n  }\n}\n"
    val wants = [(0, 90), (90, 180), (180, 270), (270, 0)]

    for (turn, want) in wants
        val p = product_of(showing("    b { board = \"b.hocon\" }\n", s"      w { show = b, at = [0, 0], look { rotate = $turn } }\n"), shelf_of(board))
        val l = named(drawn(p), "b.l")

        assert(rotation(l) == want, s"at $turn: ${rotation(l)}")
        assert(param_named(l.look, "color").is_some())
        // A turn of 0 is written as none.
        assert(param_named(l.look, "rotate").is_some() == (want != 0))
        assert(rotation(p.boards.at(0).board.view.elements.at(0)) == 90)

@test("a board shown whole with no elements draws only its background")
drawing_empty_board()
    val board = "board {\n  name = b, mcu = rp2040\n  view { size = [30, 20] }\n}\n"
    val d = drawn(product_of(showing("    b { board = \"b.hocon\" }\n", "      w { show = b, at = [7, 8] }\n"), shelf_of(board)))

    assert(names(d) == "w" && box(d.elements.at(0)) == (7, 8, 30, 20))

@test("a board of 2000 LEDs shown whole draws every one of them, each the board's part")
drawing_large_board()
    var text = str_builder()

    text.push("board {\n  name = big\n  mcu { name = big, cores = [cortex-m0plus], pins { GP = 4000 } }\n  parts {\n")

    for i in 0..<2000 do text.push(s"    d$i { part = led, color = red, wire { anode = GP${i * 2} } }\n")

    text.push("  }\n  view {\n    size = [2000, 100]\n    elements {\n")

    for i in 0..<2000 do text.push(s"      e$i { show = d$i, at = [$i, 0], size = [1, 1] }\n")

    text.push("    }\n  }\n}\n")

    val p = product_of(showing("    big { board = \"b.hocon\" }\n", "      w { show = big, at = [5, 5] }\n", "[2010, 110]"), shelf_of(text.finish()))
    val d = drawn(p)
    val scope = Scope(p.parts, p.boards)

    assert(d.elements.len() == 2001)

    val last = d.elements.at(2000)

    assert(last.name == "big.e1999" && shown(last) == "part big.d1999" && box(last) == (2004, 5, 1, 1))
    assert(scope.find("big.d1999").is_some())
    inside_board(d)

@test("every bundled board with a view, shown whole, draws each of its elements, every part found")
drawing_every_bundled_board()
    var kinds: Buf[string] = buf()
    var boards = 0
    var files: Buf[string] = buf()

    for (name, _) in bundled_descriptions() do files.push(name)

    files.extend(["\"boards/joystick.hocon\"", "\"boards/matrix.hocon\"", "\"boards/touch.hocon\"", "\"boards/audio.hocon\""])

    for which in files
        val src = source_of("t.hocon", showing(s"    b { board = $which }\n", ""))
        val got = load(src, library())

        // A product is not a board, and a board with no view has nothing to show whole.
        if got.report.has_errors() then continue

        val bv = got.description.product.boards.at(0).board.view

        if bv.width == 0 then continue

        val size = s"[${bv.width + 20}, ${bv.height + 20}]"
        val p = product_of(showing(s"    b { board = $which }\n", "      w { show = b, at = [10, 10] }\n", size))
        val d = drawn(p)
        val scope = Scope(p.parts, p.boards)

        assert(d.elements.len() == bv.elements.len() + 1, which)
        inside_board(d)

        for e in d.elements
            e.shows match
                ShowPart(n) ->
                    val part = scope.find(n)

                    assert(part.is_some(), s"$which: `$n` is not found")

                    if !has(kinds, part.unwrap().kind) then kinds.push(part.unwrap().kind)
                _ -> ()

        boards += 1
    end for

    assert(boards >= 10, s"$boards")

    var all = str_builder()

    for k in kinds do all.push(s"$k ")

    val seen = all.finish()

    for k in ["led", "button", "switch", "potentiometer", "joystick", "seven-segment", "hd44780", "ssd1306", "st7789", "mipi-dcs-display", "microbit-v2-led-matrix", "speaker"]
        assert(has(kinds, k), s"no bundled board shows a `$k`: $seen")
