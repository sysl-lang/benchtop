module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.Shows
import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m.Stop
import sh.sysl.png as png
import sh.sysl.sdl3 as sdl
import sh.sysl.ui as ui
import sysl.fs.{make_temp_dir, read_bytes}
import sysl.text.Search

private val GUEST = embed("../../../../examples/visual/demo.elf")

private ready() -> &Desktop
    val d = desktop(open_scene("workbench").unwrap(), true)
    val m = d.session.board()
    assert(virt.board_named(m, "workbench").is_ok())
    virt.open_console(m)
    virt.capture_bounded(m, 256)
    virt.boot(m, virt.image_of(m, GUEST).unwrap().view())
    d

/** Change the desktop's view state as an event handler would. */
private hold(d: &Desktop, key: string, down: bool) -> bool
    var st = d.current.read()
    val matched = key_input(d.scene, &st, key, down)
    d.current.set(st)
    matched

@test("visual workbench: real firmware heartbeat and both keyboard buttons drive GPIO LEDs")
firmware_buttons()
    val d = ready()
    var low = false
    var high = false
    // Startup now services several display and audio drivers; observe a transition within a bounded run.
    for i in 0..<240
        advance(d)
        if (virt.panel_outputs(d.session.board()) & 1) != 0 then high = true else low = true
        if low && high then break
    assert(low && high && !d.session.stopped && d.session.instructions > 0)
    assert(hold(d, "1", true))
    advance(d)
    assert((virt.panel_outputs(d.session.board()) & 2) != 0 && (virt.panel_outputs(d.session.board()) & 4) == 0)
    assert(hold(d, "2", true))
    advance(d)
    assert((virt.panel_outputs(d.session.board()) & 6) == 6)
    hold(d, "1", false)
    advance(d)
    assert((virt.panel_outputs(d.session.board()) & 6) == 4)
    edit(d, st -> release_inputs(st))
    advance(d)
    assert((virt.panel_outputs(d.session.board()) & 6) == 0)
    assert(virt.core0(d.session.board()).stop == Stop.Running && d.session.status == virt.RunStatus.Running)

@test("visual workbench: mouse and keyboard holds compose, focus loss releases, pause and step preserve execution boundaries")
input_and_execution()
    val d = ready()
    val cpu = virt.core0(d.session.board())
    advance(d)
    edit(d, st -> st.mouse_part = "button1")
    hold(d, "1", true)
    advance(d)
    edit(d, st -> st.mouse_part = "")
    advance(d)
    assert((virt.panel_outputs(d.session.board()) & 2) != 0)
    d.session.paused = true
    val before = cpu.retired
    hold(d, "1", false)
    advance(d)
    assert(cpu.retired == before && (virt.panel_levels(d.session.board()) & (1 << 8)) != 0 && d.session.status == virt.RunStatus.Paused)
    advance(d, true)
    assert(cpu.retired == before + 1 && d.session.paused)
    edit(d, st -> release_inputs(st))
    d.session.paused = false
    advance(d)
    assert((virt.panel_outputs(d.session.board()) & 2) == 0)
    virt.boot(d.session.board(), virt.image_of(d.session.board(), GUEST).unwrap().view())
    assert(cpu.retired == 0 && virt.panel_outputs(d.session.board()) == 0)

@test("visual workbench: multiple keys bound to the same button are independent")
multiple_bindings()
    // Copy a checked scene and use its actual key-binding records with a second key.
    val d = ready()
    var second = d.scene.keys.at(0)
    second.key = "a"
    d.scene.keys.push(second)
    hold(d, "1", true)
    hold(d, "a", true)
    hold(d, "1", false)
    advance(d)
    assert((virt.panel_levels(d.session.board()) & (1 << 8)) == 0)
    hold(d, "a", false)
    advance(d)
    assert((virt.panel_levels(d.session.board()) & (1 << 8)) != 0)
    assert(!hold(d, "unknown", true))

@test("visual geometry: fixed board scale, clipped hit testing and reverse paint order at multiple sizes")
geometry()
    val s = open_scene("workbench").unwrap()
    for r in [ui.Rect(24, 150, 760, 500), ui.Rect(10, 10, 360, 220), ui.Rect(0, 0, 1500, 1000)]
        val t = board_transform(r)
        assert(t.scale == 1.0 && t.x == f32(r.x) && t.y == f32(r.y))
        val x = r.x + 567
        val y = r.y + 192
        assert(part_at(s, r, x, y) == (if r.holds(x, y) then "button1" else ""))
        assert(part_at(s, r, -100, -100) == "")
    val fit1 = fit(WIDTH, HEIGHT, 2400, 1520)
    assert(fit1.scale == 2.0 && fit1.x == 0.0 && fit1.y == 0.0)
    val fit2 = fit(WIDTH, HEIGHT, 2400, 760)
    assert(fit2.scale == 1.0 && fit2.x == 600.0)
    var overlapping = s.view.elements.at(17)
    overlapping.x = 540
    overlapping.y = 165
    overlapping.w = 54
    overlapping.h = 54
    overlapping.shows = Shows.Fill("red")
    s.view.elements.push(overlapping)
    val r = ui.Rect(0, 0, s.view.width, s.view.height)
    assert(part_at(s, r, 567, 192) == "")

@test("visual rendering: syslUI PlutoVG renders boards and products, PNG matches the surface")
render_and_png()
    for name in ["workbench", "pico2", "pico2w", "pico-breadboard-kit", "virt"]
        val d = desktop(open_scene(name).unwrap(), false)
        val surf = rasterize(d).unwrap()
        assert(surf.data()[0] == 32 && surf.data()[1] == 20 && surf.data()[2] == 13 && surf.data()[3] == 255)
        assert(d.board_rect.read().w > 0)
    assert(open_scene("no-such-board").is_err())
    assert(open_scene("mcus/rp2350.hocon").is_err())
    val d = desktop(open_scene("workbench").unwrap(), false)
    val dir = make_temp_dir("benchtop-png").unwrap()
    val path = s"$dir/frame.png"
    save_desktop(d, path).unwrap()
    val image = png.decode(read_bytes(path).unwrap()).unwrap()
    assert(image.width == usize(WIDTH) && image.height == usize(HEIGHT))
    val pixel = image.at(0, 0)
    assert(pixel.r == 13 && pixel.g == 20 && pixel.b == 32 && pixel.a == 255)
    assert(save_desktop(d, s"$dir/missing/frame.png").is_err())
    assert(rasterize(d, 0, 0).is_err())

@test("visual rendering: real guest GPIO changes PlutoVG LED pixels without animation")
framebuffer()
    assert(parse_color("#Ab90Ff") == 0xAB90FF && parse_color("no", 123) == 123)
    assert(parse_color("#12345g", 123) == 123)
    val d = ready()
    advance(d)
    val first = rasterize(d).unwrap()
    val t = board_transform(d.board_rect.read())
    val x = int(t.x + 96.0 * t.scale)
    val y = int(t.y + 226.0 * t.scale)
    val at = usize(y * first.stride() + x * 4)
    val before = first.data()[at]
    hold(d, "1", true)
    advance(d)
    val second = rasterize(d).unwrap()
    assert(second.data()[at] > before)
    assert(frame_count("0").is_err() && frame_count("-1").is_err() && frame_count("no").is_err())
    assert(frame_count("2").unwrap() == 2)

@test("visual desktop: toolkit toolbar actions pause, step, reset and request screenshots")
toolbar()
    val d = ready()
    val tree: &ui.View = Workbench(d, true)
    var c = ui.recorder()
    ui.render(tree, &c, ui.Rect(0, 0, WIDTH, HEIGHT))
    assert(c.taps.len() >= 4)
    // The toolbar's actual layout-generated regions drive its real callbacks.
    val pause_box = c.taps.items.at(0).r
    c.point(pause_box.x + 2, pause_box.y + 2, true)
    c.release(pause_box.x + 2, pause_box.y + 2)
    assert(d.session.paused)
    val before = virt.core0(d.session.board()).retired
    val step_box = c.taps.items.at(1).r
    assert(c.taps.tap(step_box.x + 2, step_box.y + 2))
    val count = ui.signal(0u64)
    desktop_tick(d, virt.image_of(d.session.board(), GUEST).unwrap().view(), 0, count, "unused.png")
    assert(d.session.paused && virt.core0(d.session.board()).retired == before + 1 && d.session.status.label() == "PAUSED")
    val reset_box = c.taps.items.at(2).r
    assert(c.taps.tap(reset_box.x + 2, reset_box.y + 2) && d.resetting.read())
    desktop_tick(d, virt.image_of(d.session.board(), GUEST).unwrap().view(), 0, count, "unused.png")
    assert(!d.session.paused && !d.resetting.read())
    val save_box = c.taps.items.at(3).r
    assert(c.taps.tap(save_box.x + 2, save_box.y + 2) && d.saving.read())

@test("visual desktop: toolkit pointer geometry drives buttons and responsive layout fits")
pointer_and_resize()
    val d = ready()
    val tree: &ui.View = Workbench(d, true)
    var c = ui.recorder()
    for size in [ui.Size(1200, 760), ui.Size(700, 900), ui.Size(1500, 1000)]
        ui.render(tree, &c, ui.Rect(0, 0, size.w, size.h))
        val r = d.board_rect.read()
        assert(r.x >= 0 && r.y >= 0 && r.right() <= size.w && r.bottom() <= size.h)
        val t = board_transform(r)
        val x = int(t.x + 567.0 * t.scale)
        val y = int(t.y + 192.0 * t.scale)
        d.pointer_live.set(true)
        c.point(x, y, true)
        ui.render(tree, &c, ui.Rect(0, 0, size.w, size.h))
        assert(d.current.read().mouse_part == (if r.holds(x, y) then "button1" else ""))
        if r.holds(x, y) then assert(d.current.read().selected == "button1")
        advance(d)
        assert(((virt.panel_outputs(d.session.board()) & 2) != 0) == r.holds(x, y))
        d.pointer_live.set(false)
        c.point(x, y, false)
        ui.render(tree, &c, ui.Rect(0, 0, size.w, size.h))
        assert(d.current.read().mouse_part == "")

@test("visual desktop: inspector scrolls and dragging from outside never presses GPIO")
scroll_and_origin()
    val d = desktop(open_scene("pico-breadboard-kit").unwrap(), false)
    val tree: &ui.View = Workbench(d, true)
    var c = ui.recorder()
    ui.render(tree, &c, ui.Rect(0, 0, WIDTH, HEIGHT))
    c.point(1050, 400)
    c.spin(0.0, -120.0)
    ui.render(tree, &c, ui.Rect(0, 0, WIDTH, HEIGHT))
    val scrolled = d.scroll.read()
    assert(scrolled > 0)
    // A rendering to a PNG lays the inspector out with a copy of the scroll position.
    rasterize(d).unwrap()
    assert(d.scroll.read() == scrolled)
    val live = ready()
    val s = live.scene
    val board: &ui.View = BoardView(live, true)
    val r = ui.Rect(0, 0, s.view.width, s.view.height)
    live.pointer_live.set(true)
    c.point(-10, -10, true)
    c.point(567, 192, true)
    ui.render(board, &c, r)
    assert(live.current.read().mouse_part == "")

@test("seven-segment firmware: knob values become multiplexed GPIO patterns with no console output")
pot_firmware()
    val d = ready()
    val counter = ui.signal(0u64)
    val image = virt.image_of(d.session.board(), GUEST).unwrap()
    desktop_tick(d, image.view(), 0, counter, "unused.png")
    assert_display(d, [0x5B, 0x3F, 0x66, 0x7F])
    for sample in [
        (0, [0x3Fu8, 0x3F, 0x3F, 0x3F]),
        (2500, [0x06u8, 0x3F, 0x5B, 0x66]),
        (7500, [0x4Fu8, 0x3F, 0x07, 0x06]),
        (10000, [0x66u8, 0x3F, 0x6F, 0x6D])
    ]
        d.pots.at(0).position.set(sample.0)
        desktop_tick(d, image.view(), 0, counter, "unused.png")
        assert_display(d, sample.1)
    assert(!d.session.stopped && virt.output(d.session.board()).view().len == 0)
    d.resetting.set(true)
    desktop_tick(d, image.view(), 0, counter, "unused.png")
    assert(d.pots.at(0).position.read() == 10000 && virt.output(d.session.board()).view().len == 0)
    assert_display(d, [0x66, 0x3F, 0x6F, 0x6D])

private assert_display(d: &Desktop, expected: [4]u8)
    val actual = virt.display_segments(d.session.board(), "readout")
    for i in 0..<4 do assert(actual[i] == expected[i], s"digit $i: expected ${expected[i]}, got ${actual[i]}")

@test("pot ADC: toolkit rotary drag and slider state share the same external analogue source")
pot_knob()
    val d = ready()
    val s = d.scene
    val board: &ui.View = BoardView(d, true)
    var c = ui.recorder()
    val area = ui.Rect(0, 0, s.view.width, s.view.height)
    d.pointer_live.set(true)
    c.point(369, 330, true)
    ui.render(board, &c, area)
    assert(d.pots.at(0).position.read() == 5000)
    c.point(390, 378, true)
    ui.render(board, &c, area)
    assert(d.pots.at(0).position.read() == 10000)
    advance(d)
    assert(virt.analog_level(d.session.board(), 26) == 3300000 && d.session.position("volume") == 10000)
    c.point(348, 378, true)
    ui.render(board, &c, area)
    assert(d.pots.at(0).position.read() == 0)
    assert(knob_position(ui.Rect(0, 0, 60, 60), 30, 30, 1234) == 1234)

@test("canonical_key: SDL's capitalised scancode names become the lowercase names the key handler matches")
canonical_key_lowercases()
    assert_eq(canonical_key(sdl.SCANCODE_SPACE), "space")
    assert_eq(canonical_key(sdl.SCANCODE_ESCAPE), "escape")
    assert_eq(canonical_key(sdl.SCANCODE_R), "r")
    assert_eq(canonical_key(-1), "")
