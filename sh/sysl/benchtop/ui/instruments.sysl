module sh.sysl.benchtop.ui

import sh.sysl.ui as ui
import sh.sysl.benchtop.instrument as plot
import sh.sysl.benchtop.virt as virt
import sh.sysl.hocon as hocon
import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}
import sysl.text.{Search, parse_long, from_utf8_lossy}
import sysl.fs.read_bytes
import sysl.math.{min, max}
import sysl.slices.contains

struct Instrument
    name: string
    title: string
    part: string
    plot: &plot.Plot
    opening: bool
    window: Option[&InstrumentWindow]
    window_id: u32

/** Bind only side-effect-free observations, never MMIO reads or guest instructions. */
instrument_source(s: Scene, name: string, units: string) -> Result[plot.Source, string]
    for p in s.peripherals
        val prefix = s"${s.chip}.${p.name}."
        if !name.starts_with(prefix) then continue
        val register = name[prefix.bytes.len..]
        if p.kind == "virt-adc"
            val offset: u32 = register match
                "CTRL" -> 0
                "CHANNEL" -> 4
                "STATUS" -> 8
                "RESULT" -> 12
                "IRQ_ENABLE" -> 16
                "IRQ_STATUS" -> 20
                "VREF" -> 24
                "RESOLUTION" -> 28
                "CONVERSION_CYCLES" -> 32
                _ -> return Err(s"unknown ADC observation: $name")
            return Ok(plot.Source(name, units, () -> virt.peek_adc(offset) match
                Some(n) -> Some(real(n))
                None -> None))
        if p.kind == "panel-gpio"
            if register == "IN" then return Ok(plot.Source(name, units, () -> Some(real(virt.panel_levels()))))
            if register == "OUT" then return Ok(plot.Source(name, units, () -> Some(real(virt.panel_output_latch()))))
            if register == "OE" then return Ok(plot.Source(name, units, () -> Some(real(virt.panel_drive_mask()))))
    for core in 0..<2
        val prefix = s"cpu$core."
        if !name.starts_with(prefix) then continue
        val register = name[prefix.bytes.len..]
        if register == "pc" then return Ok(plot.Source(name, units, () -> Some(real(virt.observe_core(core).pc))))
        if register == "retired" then return Ok(plot.Source(name, units, () -> Some(real(virt.observe_core(core).retired))))
        for reg in 0..<16
            if register == s"r$reg" then return Ok(plot.Source(name, units, () -> Some(real(virt.observe_core(core).registers[reg]))))
    for width in [1, 2, 4]
        val prefix = s"ram.u${width * 8}."
        if !name.starts_with(prefix) then continue
        val address = parse_long(name[prefix.bytes.len..]) match
            Ok(n) -> n
            Err(_) -> return Err("RAM observation needs a decimal byte offset")
        if address < 0 || address > long(virt.ram_size()) - long(width) then return Err("RAM observation is outside emulated backing RAM")
        return Ok(plot.Source(name, units, () -> virt.ram_peek(usize(width), usize(address)) match
            Some(n) -> Some(real(n))
            None -> None))
    Err(s"unknown numeric observation: $name")

private text_field(v: hocon.Value, key: string, fallback: string) -> Result[string, string]
    v.get(key) match
        None -> Ok(fallback)
        Some(x) -> x.as_text() match
            Some(t) -> Ok(t)
            None -> Err(s"instrument $key must be text")

private number_field(v: hocon.Value, key: string, fallback: real) -> Result[real, string]
    v.get(key) match
        None -> Ok(fallback)
        Some(x) -> x.as_real() match
            Some(n) -> Ok(n)
            None -> Err(s"instrument $key must be numeric")

private count_field(v: hocon.Value, key: string, fallback: long, lo: long, hi: long) -> Result[long, string]
    val n = v.get(key) match
        None -> fallback
        Some(x) -> x.as_long() match
            Some(n) -> n
            None -> return Err(s"instrument $key must be an integer")
    if n < lo || n > hi then return Err(s"instrument $key must be from $lo to $hi, not $n")
    Ok(n)

// The fields an instrument may set.
private val KNOWN_FIELDS = ["instrument", "title", "source", "units", "part", "min", "max", "capacity", "window-cycles", "sample-cycles"]

instruments(s: Scene, text: string) -> Result[Buf[&Instrument], string]
    val src = source_of("instruments.hocon", text)
    val doc = hocon.parse(src) match
        Ok(d) -> d
        Err(e) -> return Err(e.render(src))
    if doc.repeats.len() > 0 then return Err("duplicate instrument field")
    val root = doc.root.get("instruments") match
        Some(v) -> v
        None -> return Err("instrument configuration needs an instruments object")
    root.kind match
        Obj(_) -> ()
        _ -> return Err("instruments must be an object")
    var out: Buf[&Instrument] = buf()
    for field in root.fields()
        val v = field.value
        v.kind match
            Obj(_) -> ()
            _ -> return Err("each instrument must be an object")
        for f in v.fields() do if !contains(KNOWN_FIELDS[..], f.key) then return Err(s"unknown instrument field: ${f.key}")
        if text_field(v, "instrument", "plot")? != "plot" then return Err("unknown instrument kind")
        val name = text_field(v, "source", "")?
        val part = text_field(v, "part", "")?
        if !part.is_empty() && s.scope.find(part).is_none() then return Err(s"unknown instrument part: $part")
        val source = instrument_source(s, name, text_field(v, "units", "")?)?
        val history = plot.plot(source,
            usize(count_field(v, "capacity", 1024, long(plot.MIN_CAPACITY), long(plot.MAX_CAPACITY))?),
            u64(count_field(v, "window-cycles", 20000000, 1, 1000000000000)?),
            u64(count_field(v, "sample-cycles", 20000, 1, 1000000000000)?),
            number_field(v, "min", 0.0)?, number_field(v, "max", 4095.0)?)?
        out.push(Instrument(field.key, text_field(v, "title", field.key)?, part, history, false, None, 0))
    Ok(out)

load_instruments(s: Scene, file: string) -> Result[Buf[&Instrument], string]
    val bytes = read_bytes(file) match
        Ok(b) -> b
        Err(why) -> return Err(s"$file: $why")
    instruments(s, from_utf8_lossy(bytes))

private[ui] instrument_tick(d: &Desktop)
    val time = virt.observation_time()
    for i in d.instruments do plot.sample(i.plot, time)

private[ui] clear_instruments(d: &Desktop)
    for i in d.instruments do plot.clear(i.plot)

private[ui] instrument_icon(box: ui.Rect) -> ui.Rect = ui.Rect(box.right() + 4, box.y, 22, 22)

private[ui] part_instruments(d: &Desktop, c: *ui.Canvas, r: ui.Rect, interactive: bool)
    val t = board_transform(r)
    val (mx, my) = c.pointer()
    val context = d.context_requested.read()
    if context then d.context_requested.set(false)
    for e in d.scene.view.elements
        e.shows match
            ShowPart(name) ->
                for i in d.instruments
                    if i.part != name then continue
                    val (x, y, w, h) = coords(t, e)
                    val box = ui.Rect(x, y, w, h)
                    val icon = instrument_icon(box)
                    c.fill(icon, ICON_FILL, 5)
                    c.stroke(icon, ACCENT, 1, 5)
                    c.fill(ui.Rect(icon.x + 4, icon.y + 12, 5, 2), ACCENT)
                    c.fill(ui.Rect(icon.x + 8, icon.y + 6, 2, 8), ACCENT)
                    c.fill(ui.Rect(icon.x + 9, icon.y + 6, 7, 2), ACCENT)
                    if !interactive then continue
                    if c.tapped(icon) || (context && box.holds(mx, my)) then i.opening = true
            _ -> ()

struct PlotView
    instrument: &Instrument

impl ui.View for PlotView
    measure(&self, c: *ui.Canvas, avail: ui.Size) -> ui.Size = avail
    paint(&self, c: *ui.Canvas, r: ui.Rect)
        val i = self.instrument
        val p = i.plot
        c.fill(r, CARD, 10)
        c.stroke(r, EDGE, 1, 10)
        label(c, ui.Rect(r.x + 14, r.y + 10, r.w - 28, 23), i.title, ACCENT, 16)
        if r.w >= 340
            val controls = ui.row([
                ui.button(if p.held then "Resume" else "Hold", () -> plot.hold(p, !p.held), ui.Role.Secondary, ui.Variant.Soft),
                ui.button("Clear", () -> plot.clear(p), ui.Role.Secondary, ui.Variant.Outline)
            ], 8)
            controls.paint(c, ui.Rect(r.right() - 168, r.y + 10, 154, 34))
        val latest = if p.samples.len() == 0 then None else plot.at(p, p.samples.len() - 1).value
        val value = latest match
            Some(n) -> f"$n%.0f ${p.source.units}"
            None -> "No sample"
        label(c, ui.Rect(r.x + 14, r.y + 36, r.w - 28, 20), s"$value${if p.held then " · HELD" else ""}", INK, 13)
        val chart = ui.Rect(r.x + 54, r.y + 67, max(1, r.w - 72), max(1, r.h - 115))
        c.fill(chart, GROUND, 3)
        for tick in 0..4
            val y = chart.y + tick * (chart.h - 1) / 4
            c.fill(ui.Rect(chart.x, y, chart.w, 1), EDGE)
        label(c, ui.Rect(r.x + 5, chart.y - 4, 46, 17), f"${p.maximum}%.0f", MUTED, 10)
        label(c, ui.Rect(r.x + 5, chart.bottom() - 12, 46, 17), f"${p.minimum}%.0f", MUTED, 10)
        c.clip(chart)
        var previous: Option[(int, int)] = None
        if p.samples.len() > 0
            val now = plot.at(p, p.samples.len() - 1).time
            for index in 0..<p.samples.len()
                val point = plot.at(p, index)
                val age = now - point.time
                if age > p.window then continue
                point.value match
                    Some(value) ->
                        val x = chart.right() - 1 - int(real(age) / real(p.window) * real(chart.w - 1))
                        val bounded = max(p.minimum, min(value, p.maximum))
                        val y = chart.bottom() - 1 - int((bounded - p.minimum) / (p.maximum - p.minimum) * real(chart.h - 1))
                        previous match
                            Some((px, py)) ->
                                c.fill(ui.Rect(px, py - 1, max(1, x - px), 2), ACCENT)
                                c.fill(ui.Rect(x - 1, min(py, y), 2, max(2, max(py, y) - min(py, y))), ACCENT)
                            None -> c.fill(ui.Rect(x - 1, y - 1, 2, 2), ACCENT)
                        previous = Some((x, y))
                    None -> previous = None
        c.unclip()
        label(c, ui.Rect(chart.x, chart.bottom() + 3, chart.w, 17), s"← ${p.window} guest cycles     now", MUTED, 10)
        label(c, ui.Rect(r.x + 14, r.bottom() - 24, r.w - 28, 18),
            s"${p.source.name} · Space hold · C clear", MUTED, 11)
