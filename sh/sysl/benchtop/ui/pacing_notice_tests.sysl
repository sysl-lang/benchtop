module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m.Stop

@test("pacing notices: identify the delayed core without hiding diagnostics or warning while paused")
pacing_notice_priority()
    val core = virt.CoreObservation(0,0,0,[0;16],false,Stop.Budget,0)
    var snapshot = virt.WorkerObservation([core,core],true,true,[0,0])
    var st = state(true)
    snapshot.cores[1].late_us = 7000
    pacing_notice(&st,snapshot)
    assert(st.notice == "Emulation speed: core 1 is 7 ms behind real time")
    snapshot.cores[0].late_us = 9000
    pacing_notice(&st,snapshot)
    assert(st.notice == "Emulation speed: core 0 is 9 ms behind real time")
    st.paused = true
    pacing_notice(&st,snapshot)
    assert(st.notice.is_empty())
    st.paused = false
    st.notice = "Firmware build failed"
    pacing_notice(&st,snapshot)
    assert(st.notice == "Firmware build failed")
