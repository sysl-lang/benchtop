module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m.Stop

@test("pacing notices: identify the delayed core without hiding diagnostics or warning while paused")
pacing_notice_priority()
    val core = virt.CoreObservation(0,0,0,[0;16],false,Stop.Budget,0)
    var snapshot = virt.WorkerObservation([core,core],true,true,[0,0])
    var st = state()
    snapshot.cores[1].late_us = 7000
    pacing_notice(&st,false,snapshot)
    assert(st.notice.text == "Emulation speed: core 1 is 7 ms behind real time" && st.notice.kind == NoticeKind.Pacing)
    snapshot.cores[0].late_us = 9000
    pacing_notice(&st,false,snapshot)
    assert(st.notice.text == "Emulation speed: core 0 is 9 ms behind real time")
    pacing_notice(&st,true,snapshot)
    assert(st.notice.text.is_empty() && st.notice.kind == NoticeKind.Empty)
    st.notice = Notice(NoticeKind.Stop, "the guest exited with 1")
    pacing_notice(&st,false,snapshot)
    assert(st.notice.text == "the guest exited with 1")
    // A reload or save notice gives way to the speed warning; a failure or an instrument's does not.
    for (kind, yields) in [(NoticeKind.Reloaded, true), (NoticeKind.Saved, true), (NoticeKind.SaveFailed, false), (NoticeKind.Audio, false), (NoticeKind.Instrument, false)]
        st.notice = Notice(kind, "other")
        pacing_notice(&st,false,snapshot)
        assert((st.notice.kind == NoticeKind.Pacing) == yields)
    // Catching up clears only the session's own notice.
    snapshot.cores[0].late_us = 0
    snapshot.cores[1].late_us = 0
    pacing_notice(&st,false,snapshot)
    assert(st.notice.text == "other")
    st.notice = Notice(NoticeKind.Pacing, "Emulation speed: core 0 is 9 ms behind real time")
    pacing_notice(&st,false,snapshot)
    assert(st.notice.kind == NoticeKind.Empty)
