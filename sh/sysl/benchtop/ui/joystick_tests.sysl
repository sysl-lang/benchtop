module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.ui as ui
import sh.sysl.elf as elf
import sh.sysl.benchtop.{load, library}
import sh.sysl.parsing.source_of
import sysl.raw.str_cast
import sysl.text.replace_all

private val JOYSTICK_GUEST = embed("../../../../examples/touch/joystick.elf")

@test("joystick: captured drag drives both ADCs, guest firmware moves a circle over SPI, release and focus loss centre the stick")
joystick_demo_test()
    assert(virt.board_named("boards/joystick.hocon").is_ok())
    virt.open_console()
    virt.capture_bounded(256)
    virt.boot(virt.core0(),virt.image_of(JOYSTICK_GUEST).unwrap().view())
    assert(virt.core0().instruction_timing,"the joystick board must use estimated per-instruction cycle costs")
    val d = desktop(open_scene("boards/joystick.hocon").unwrap(),true)
    d.board_rect.set(ui.Rect(0,0,720,490))
    val executable = elf.read(JOYSTICK_GUEST).unwrap()
    val position = u32(executable.symbol_named("joystick_position").unwrap().unwrap().value)
    assert(virt.analog_level(26) == 1650000 && virt.analog_level(27) == 1650000)
    assert(virt.pump_board(virt.core0(),20000000),virt.stop_message(virt.core0()))
    assert(cpu.load32(virt.core0(),position) == 120 && cpu.load32(virt.core0(),position + 4) == 120)
    pointer_touch(d,515,235,true,true)
    pointer_touch(d,900,-100,true)
    assert(d.touch_capture.read() == Capture.Joystick("stick") && d.session.axes("stick") == (10000, 0))
    d.session.apply_inputs()
    assert(virt.analog_level(26) == 3300000 && virt.analog_level(27) == 0)
    assert(virt.pump_board(virt.core0(),10000000),virt.stop_message(virt.core0()))
    assert(cpu.load32(virt.core0(),position) == 220 && cpu.load32(virt.core0(),position + 4) == 20)
    val frame = virt.tft_frame("screen").unwrap()
    assert(frame.pixels.at(usize(20 * 240 + 220)) != frame.pixels.at(usize(120 * 240 + 120)),"circle travelled through guest SPI, not a host overlay")
    pointer_touch(d,900,-100,false)
    assert(d.touch_capture.read() == Capture.Free)
    d.session.apply_inputs()
    assert(virt.analog_level(26) == 1650000 && virt.analog_level(27) == 1650000)
    assert(virt.pump_board(virt.core0(),10000000),virt.stop_message(virt.core0()))
    assert(cpu.load32(virt.core0(),position) == 120 && cpu.load32(virt.core0(),position + 4) == 120)
    pointer_touch(d,461,181,true,true)
    release_touch(d)
    d.session.apply_inputs()
    assert(virt.analog_level(26) == 1650000 && virt.analog_level(27) == 1650000)
    val filled = virt.tft_frame("screen").unwrap().pixels.at(usize(126 * 240 + 126))
    pointer_touch(d,480,350,true,true)
    pointer_touch(d,480,350,true) // Holding is not another toggle.
    pointer_touch(d,480,350,false)
    release_touch(d) // Focus loss must not open a maintained contact.
    d.session.apply_inputs()
    assert(cpu.load32(virt.core0(),0x50000004) & (1 << 8) == 0)
    assert(virt.pump_board(virt.core0(),10000000),virt.stop_message(virt.core0()))
    val outlined = virt.tft_frame("screen").unwrap().pixels.at(usize(126 * 240 + 126))
    assert(filled != outlined,"the firmware must redraw the circle after reading the switch GPIO")
    pointer_touch(d,480,350,true,true)
    pointer_touch(d,480,350,false)
    d.session.apply_inputs()
    assert(cpu.load32(virt.core0(),0x50000004) & (1 << 8) != 0)
    assert(virt.pump_board(virt.core0(),10000000),virt.stop_message(virt.core0()))
    assert(virt.tft_frame("screen").unwrap().pixels.at(usize(126 * 240 + 126)) == filled)
    assert(virt.output().view().len == 0)

@test("switch: initial open/closed contacts and both GPIO polarities persist after releasing transient inputs")
switch_polarities()
    assert(virt.board_named("boards/joystick.hocon").is_ok())
    virt.boot(virt.core0(),virt.image_of(JOYSTICK_GUEST).unwrap().view())
    val description = str_cast(embed("../../../../boards/joystick.hocon"))
    for active in ["low", "high"]
        for closed in [false, true]
            val text = replace_all(description,"active = low, closed = false",s"active = $active, closed = $closed")
            val got = load(source_of("switch.hocon",text),library())
            assert(!got.report.has_errors())
            val s = scene(got.description).unwrap()
            val session = virt.session(s.scope.parts, s.chip, true)
            session.apply_inputs()
            val high = if active == "high" then closed else !closed
            assert((cpu.load32(virt.core0(),0x50000004) & (1 << 8) != 0) == high)
            session.toggle("mode")
            session.release_buttons()
            session.apply_inputs()
            assert((cpu.load32(virt.core0(),0x50000004) & (1 << 8) != 0) != high)
            assert(session.closed("mode") == !closed)
