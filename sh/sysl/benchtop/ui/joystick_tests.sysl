module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.ui as ui
import sh.sysl.elf as elf

private val JOYSTICK_GUEST = embed("../../../../examples/touch/joystick.elf")

@test("joystick: captured drag drives both ADCs, guest firmware moves a circle over SPI, release and focus loss centre the stick")
joystick_demo_test()
    assert(virt.board_named("boards/joystick.hocon").is_ok())
    virt.open_console()
    virt.capture_bounded(256)
    virt.boot(virt.core0(),virt.image_of(JOYSTICK_GUEST).unwrap().view())
    val d = desktop(open_scene("boards/joystick.hocon").unwrap(),state(true))
    d.board_rect.set(ui.Rect(0,0,720,490))
    val executable = elf.read(JOYSTICK_GUEST).unwrap()
    val position = u32(executable.symbol_named("joystick_position").unwrap().unwrap().value)
    assert(virt.analog_level(26) == 1650000 && virt.analog_level(27) == 1650000)
    assert(virt.pump_board(virt.core0(),20000000),virt.stop_message(virt.core0()))
    assert(cpu.load32(virt.core0(),position) == 120 && cpu.load32(virt.core0(),position + 4) == 120)
    pointer_touch(d,515,235,true,true)
    pointer_touch(d,900,-100,true)
    var st = d.current.read()
    sync_pots(d,&st)
    sample_inputs(d.scene,st)
    assert(virt.analog_level(26) == 3300000 && virt.analog_level(27) == 0)
    assert(virt.pump_board(virt.core0(),10000000),virt.stop_message(virt.core0()))
    assert(cpu.load32(virt.core0(),position) == 220 && cpu.load32(virt.core0(),position + 4) == 20)
    val frame = virt.tft_frame("screen").unwrap()
    assert(frame.pixels.at(usize(20 * 240 + 220)) != frame.pixels.at(usize(120 * 240 + 120)),"circle travelled through guest SPI, not a host overlay")
    pointer_touch(d,900,-100,false)
    sync_pots(d,&st)
    sample_inputs(d.scene,st)
    assert(virt.analog_level(26) == 1650000 && virt.analog_level(27) == 1650000)
    assert(virt.pump_board(virt.core0(),10000000),virt.stop_message(virt.core0()))
    assert(cpu.load32(virt.core0(),position) == 120 && cpu.load32(virt.core0(),position + 4) == 120)
    pointer_touch(d,461,181,true,true)
    release_touch(d)
    sync_pots(d,&st)
    sample_inputs(d.scene,st)
    assert(virt.analog_level(26) == 1650000 && virt.analog_level(27) == 1650000)
    assert(virt.output().len == 0)
