module sh.sysl.benchtop.ui

import sysl.buf.{Buf, buf}
import sysl.fs.write_bytes
import sh.sysl.png as png

// The same RGBA framebuffer is uploaded to SDL and encoded to PNG. No window server is
// needed for rendering, and UI geometry/pixels can be tested without a graphics driver.
struct Canvas
    width: int
    height: int
    pixels: Buf[u8]

canvas(width: int, height: int) -> Canvas
    require width > 0 && height > 0 && long(width) * long(height) <= 16777216, "framebuffer size"
    var pixels: Buf[u8] = buf()
    for i in 0..<(usize(width) * usize(height) * 4) do pixels.push(0)
    Canvas(width, height, pixels)

fill(c: Canvas, x: int, y: int, width: int, height: int, color: u32)
    if width <= 0 || height <= 0 then return
    val left = if x < 0 then 0 else x
    val top = if y < 0 then 0 else y
    val right = if long(x) + long(width) > long(c.width) then c.width else x + width
    val bottom = if long(y) + long(height) > long(c.height) then c.height else y + height
    val data = c.pixels.view()
    for row in top..<bottom
        for col in left..<right
            val at = (usize(row) * usize(c.width) + usize(col)) * 4
            data[at] = u8(color >> 16)
            data[at + 1] = u8(color >> 8)
            data[at + 2] = u8(color)
            data[at + 3] = 255

outline(c: Canvas, x: int, y: int, width: int, height: int, color: u32, line: int = 1)
    fill(c, x, y, width, line, color)
    fill(c, x, y + height - line, width, line, color)
    fill(c, x, y, line, height, color)
    fill(c, x + width - line, y, line, height, color)

circle(c: Canvas, x: int, y: int, radius: int, color: u32)
    for row in -radius..(radius + 1)
        for col in -radius..(radius + 1)
            if col * col + row * row <= radius * radius then fill(c, x + col, y + row, 1, 1, color)

private glyph(code: u8) -> [5]u8
    val c = if code >= 97 && code <= 122 then code - 32 else code
    c match
        32 -> [0,0,0,0,0]
        65 -> [126,17,17,17,126]
        66 -> [127,73,73,73,54]
        67 -> [62,65,65,65,34]
        68 -> [127,65,65,34,28]
        69 -> [127,73,73,73,65]
        70 -> [127,9,9,9,1]
        71 -> [62,65,73,73,122]
        72 -> [127,8,8,8,127]
        73 -> [0,65,127,65,0]
        74 -> [32,64,65,63,1]
        75 -> [127,8,20,34,65]
        76 -> [127,64,64,64,64]
        77 -> [127,2,12,2,127]
        78 -> [127,4,8,16,127]
        79 -> [62,65,65,65,62]
        80 -> [127,9,9,9,6]
        81 -> [62,65,81,33,94]
        82 -> [127,9,25,41,70]
        83 -> [70,73,73,73,49]
        84 -> [1,1,127,1,1]
        85 -> [63,64,64,64,63]
        86 -> [31,32,64,32,31]
        87 -> [63,64,56,64,63]
        88 -> [99,20,8,20,99]
        89 -> [7,8,112,8,7]
        90 -> [97,81,73,69,67]
        48 -> [62,81,73,69,62]
        49 -> [0,66,127,64,0]
        50 -> [66,97,81,73,70]
        51 -> [33,65,69,75,49]
        52 -> [24,20,18,127,16]
        53 -> [39,69,69,69,57]
        54 -> [60,74,73,73,48]
        55 -> [1,113,9,5,3]
        56 -> [54,73,73,73,54]
        57 -> [6,73,73,41,30]
        45 -> [8,8,8,8,8]
        46 -> [0,96,96,0,0]
        58 -> [0,54,54,0,0]
        47 -> [32,16,8,4,2]
        95 -> [64,64,64,64,64]
        61 -> [20,20,20,20,20]
        40 -> [0,28,34,65,0]
        41 -> [0,65,34,28,0]
        91 -> [0,127,65,65,0]
        93 -> [0,65,65,127,0]
        43 -> [8,8,62,8,8]
        62 -> [0,65,34,20,8]
        60 -> [8,20,34,65,0]
        35 -> [20,127,20,127,20]
        _ -> [2,1,81,9,6]

text(c: Canvas, x: int, y: int, value: string, color: u32, scale: int = 1, max_chars: int = 200)
    var at = x
    var count = 0
    for char in value.bytes
        if count >= max_chars then break
        val bits = glyph(char)
        for col in 0..<5
            for row in 0..<7
                if ((bits[col] >> u32(row)) & 1) != 0 then fill(c, at + col * scale, y + row * scale, scale, scale, color)
        at += 6 * scale
        count += 1

parse_color(value: string, fallback: u32 = 0x17283B) -> u32
    value match
        "black" -> return 0x070C13
        "white" -> return 0xFFFFFF
        "red" -> return 0xF25468
        "green" -> return 0x59E6A0
        "blue" -> return 0x62AFFF
        "yellow" -> return 0xFFCF66
        "orange" -> return 0xFF9A50
        "gray" | "grey" -> return 0x6D7F93
        _ -> ()
    if value.bytes.len != 7 || value.bytes[0] != u8('#') then return fallback
    var result: u32 = 0
    for i in 1..<7
        val b = value.bytes[i]
        val n: u32 = if b >= 48 && b <= 57 then u32(b - 48) elif b >= 65 && b <= 70 then u32(b - 65) + 10 elif b >= 97 && b <= 102 then u32(b - 97) + 10 else 255
        if n == 255 then return fallback
        result = result * 16 + n
    result

dim(color: u32) -> u32 = ((color & 0xFCFCFC) >> 2)

save_png(c: Canvas, path: string) -> Result[unit, string]
    val img = png.image(usize(c.width), usize(c.height), 6, 8, c.pixels.view()) match
        Ok(img) -> img
        Err(why) -> return Err(s"$why")
    var options = png.options()
    options.level = 1
    val file = png.encode(img, options) match
        Ok(file) -> file
        Err(why) -> return Err(s"$why")
    write_bytes(path, file.view()) match
        Ok(_) -> Ok(())
        Err(why) -> Err(s"$why")
