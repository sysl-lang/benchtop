module sh.sysl.benchtop.ui

import sh.sysl.sdl3 as sdl
import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.host as host
import sysl.buf.{Buf, buf}
import sysl.fs.read_bytes
import sysl.raw.str_cast
import sh.sysl.ui as toolkit
import sh.sysl.ui_sdl as driver
import sysl.text.{parse_long, from_utf8_lossy}

private val DEMO = embed("../../../../examples/visual/demo.elf")

frame_count(value: string) -> Result[u64, string]
    val n = parse_long(value) match
        Ok(n) -> n
        Err(_) -> return Err("--frames needs a positive integer")
    if n < 1 || n > 100000 then return Err("--frames must be between 1 and 100000")
    Ok(u64(n))

/** Boot `image` and start the desktop over: nothing held, no notice. */
private restart(d: &Desktop, image: []const u8)
    d.session.restart(image)
    edit(d, st ->
        release_inputs(st)
        st.notice = no_notice())

/** One frame of the guest: the desktop's controls go to the session, which runs the board or
 * observes its workers. A paused frame advances no guest instructions.
 */
advance(d: &Desktop, step: bool = false, budget: u64 = virt.FALLBACK_BUDGET)
    sample_inputs(d)
    val session = d.session
    val was_stopped = session.stopped
    session.advance(step, budget) match
        Some(snapshot) -> edit(d, st -> pacing_notice(st, session.paused, snapshot))
        None -> ()
    if session.stopped && !was_stopped then say(d, NoticeKind.Stop, session.message)

/** How `launch` runs: a demo or a firmware file, for how many frames, where its PNG goes, whether
 * it opens a window, the host build workflow, an instrument file, and whether the cores share one
 * thread.
 */
struct LaunchOptions
    demo: bool
    frames: u64
    screenshot: string
    headless: bool
    develop: host.Config
    instrument_file: string
    deterministic: bool

launch_options(demo: bool = false, frames: u64 = 0, screenshot: string = "", headless: bool = false, develop: host.Config = host.config(), instrument_file: string = "", deterministic: bool = false) -> LaunchOptions =
    LaunchOptions(demo = demo, frames = frames, screenshot = screenshot, headless = headless, develop = develop, instrument_file = instrument_file, deterministic = deterministic)

/** The instructions one frame gives the guest when the UI thread runs it: the paced share of a
 * frame's wall time at the session's clock, or a fixed slice for a board with no clock to pace by.
 */
private frame_budget(source: virt.PacingSource, pacer: &GuestPacer, dt: real) -> u64 = source match
    BoardClock(hz) -> pacer.budget(dt, hz)
    SoundClock(hz) -> audio_budget(dt, hz)
    TouchClock -> audio_budget(dt, source.hz())
    Fixed -> virt.FALLBACK_BUDGET

/** Load/check before opening a window. Both modes use the same syslUI tree. */
launch(which: string, file: string, o: LaunchOptions = launch_options()) -> Result[int, string]
    val develop = o.develop
    host.validate(develop, file)?
    val s = open_scene(which)?
    val live = o.demo || !file.is_empty()
    var image: Buf[u8] = buf()
    var original: []const u8 = []
    if live
        virt.board_named(which) match
            Err(why) -> return Err(why)
            Ok(_) -> ()
        val bytes: []const u8 = if o.demo then DEMO else read_bytes(file) match
            Ok(bytes) -> bytes
            Err(why) -> if develop.program.is_empty() then return Err(s"$file: $why") else []
        if bytes.len == 0 && develop.program.is_empty() then return Err("firmware is empty")
        if bytes.len > 0
            val parsed = if host.enabled(develop) then host.checked_image(bytes) else virt.image_of(bytes)
            parsed match
                Ok(i) ->
                    image = i
                    original = bytes
                Err(why) -> if develop.program.is_empty() then return Err(why)
    val d = desktop(s, live)
    val session = d.session
    if live && image.len() > 0 then restart(d, image.view())
    elif live then session.await_build()
    d.parallel = !o.deterministic && !o.headless
    if !o.instrument_file.is_empty() then d.instruments = load_instruments(s, o.instrument_file)?
    elif o.demo then d.instruments = instruments(s, from_utf8_lossy(embed("../../../../instruments/workbench.hocon")))?
    defer close_instruments(d)
    val active = toolkit.signal(image)
    if host.enabled(develop)
        d.workflow = Some(host.open(develop, file, original)?)
        if !develop.program.is_empty() then d.console_tab.set(1)
    defer close_workflow(d)
    if o.headless
        val count = if o.frames == 0 then 1 else o.frames
        val count_signal = toolkit.signal(0u64)
        for frame in 0u64..<count
            host_tick(d, active, true)
            desktop_tick(d, active.read().view(), 0, count_signal, "benchtop.png")
        if !o.screenshot.is_empty() then save_desktop(d, o.screenshot)?
        if live && session.status == virt.RunStatus.Fault then return Err(session.message)
        if session.status == virt.RunStatus.WaitingForBuild then return Err("no firmware loaded before --frames ended")
        d.workflow match
            Some(w) ->
                if w.building || w.build_requested then return Err("build did not finish before --frames ended")
                if w.failed then return Err(w.status)
            None -> ()
        return Ok(0)
    val path = if o.screenshot.is_empty() then "benchtop.png" else o.screenshot
    val count = toolkit.signal(0u64)
    sdl.set_main_ready()
    val player = audio_player()
    defer close_audio(player)
    if !player.error.is_empty() then say(d, NoticeKind.Audio, s"Audio unavailable: ${player.error}")
    val touch = !d.scene.pointers.is_empty()
    if live then session.start(d.parallel, virt.pacing_source(touch).hz())?
    defer session.stop()
    val rates = cpu_rate_trace()
    val pacing = guest_pacer()
    driver.run(driver.app(s"Benchtop - ${s.name}", () -> Workbench(d, true), () -> GROUND,
        width = WIDTH, height = HEIGHT, size = 14,
        on_event = e -> desktop_event(d, e),
        on_frame = dt ->
            host_tick(d, active)
            desktop_tick(d, active.read().view(), o.frames, count, path,
                if session.background then 0u64 else frame_budget(virt.pacing_source(touch), pacing, dt))
            if session.background
                rates match
                    Some(trace) -> trace.sample()
                    None -> ()
            audio_frame(player, d)
            instrument_windows(d)))?
    if !o.screenshot.is_empty() then save_desktop(d, o.screenshot)?
    if live && session.status == virt.RunStatus.Fault then return Err(session.message)
    Ok(0)

private close_workflow(d: &Desktop)
    d.workflow match
        Some(w) -> host.close(w)
        None -> ()

/** Poll host work and apply a completed image only between guest slices. */
private[ui] host_tick(d: &Desktop, active: &toolkit.Signal[Buf[u8]], wait: bool = false)
    d.workflow match
        Some(w) ->
            host.poll(w, wait)
            host.take_image(w) match
                Some(image) ->
                    active.set(image)
                    restart(d, image.view())
                    clear_instruments(d)
                    say(d, NoticeKind.Reloaded, "Firmware reloaded")
                None -> ()
        None -> ()

private[ui] desktop_tick(d: &Desktop, image: []const u8, frames: u64, count: &toolkit.Signal[u64], path: string, budget: u64 = virt.FALLBACK_BUDGET)
    if d.resetting.read()
        if image.len > 0 then restart(d, image)
        clear_instruments(d)
        release_touch(d)
        d.resetting.set(false)
    val step = d.stepping.read()
    d.stepping.set(false)
    advance(d, step, budget)
    if d.session.live then instrument_tick(d)
    if d.saving.read()
        d.saving.set(false)
        save_desktop(d, path) match
            Ok(_) -> say(d, NoticeKind.Saved, s"Saved $path")
            Err(why) -> say(d, NoticeKind.SaveFailed, s"Save failed: $why")
    count.set(count.read() + 1)
    if frames != 0 && count.read() >= frames then driver.stop()

/** Leave pointer coordinates and widget events to syslUI's density-aware SDL driver. */
private desktop_event(d: &Desktop, e: sdl.Event) -> bool
    if instrument_event(d, e) then return true
    val session = d.session
    e.kind() match
        WindowCloseRequested -> driver.stop()
        WindowFocusLost ->
            release_touch(d)
            edit(d, st -> release_inputs(st))
            d.pointer_live.set(false)
        MouseButtonDown ->
            if e.mouse_button() == sdl.MouseButton.Right
                d.context_requested.set(true)
                return true
            if e.mouse_button() != sdl.MouseButton.Left then return true
            d.pointer_live.set(true)
            touch_event(d, e, true, true)
        MouseMotion ->
            if d.pointer_live.read() then touch_event(d, e, true)
        MouseButtonUp ->
            if e.mouse_button() != sdl.MouseButton.Left then return true
            touch_event(d, e, false)
            edit(d, st -> st.mouse_part = "")
            d.pointer_live.set(false)
        KeyDown | KeyUp ->
            val down = e.kind() == sdl.EventKind.KeyDown
            if down && e.key_repeat() then return true
            val key = canonical_key(e.key_scancode())
            var st = d.current.read()
            if key_input(d.scene, &st, key, down)
                if session.live then d.current.set(st)
                return true
            if !down then return false
            key match
                "escape" -> driver.stop()
                "space" -> pause(d)
                "r" -> if session.live then d.resetting.set(true)
                "n" -> if session.live && !session.stopped then d.stepping.set(true)
                "s" -> d.saving.set(true)
                "b" -> d.workflow match
                    Some(w) -> host.request_build(w)
                    None -> ()
                _ -> return false
            return true
        _ -> ()
    false

private canonical_key(scancode: i32) -> string
    var bytes: Buf[u8] = buf()
    for b in sdl.scancode_name(scancode).bytes do bytes.push(b.to_lower())
    str_cast(bytes.view())

/** CLI for demo/view/render; run --window uses launch directly. */
command(args: []string) -> Result[int, string]
    val cmd = args[1]
    var which = if cmd == "demo" then "workbench" else ""
    var screenshot = ""
    var frames: u64 = 0
    var headless = false
    var instrument_file = ""
    var i: usize = 2
    while i < args.len
        val arg = args[i]
        if arg == "--frames" || arg == "--screenshot" || arg == "--instruments"
            if i + 1 >= args.len then return Err(s"$arg needs a value")
            if arg == "--frames" then frames = frame_count(args[i + 1])?
            elif arg == "--instruments" then instrument_file = args[i + 1]
            else screenshot = args[i + 1]
            i += 2
        elif arg == "--headless"
            headless = true
            i += 1
        elif arg.starts_with("--") then return Err(s"unknown option: $arg")
        elif which.is_empty()
            which = arg
            i += 1
        elif cmd == "render" && screenshot.is_empty()
            screenshot = arg
            i += 1
        else return Err(s"unexpected argument: $arg")
    if which.is_empty() then return Err(s"usage: benchtop $cmd <board | file.hocon>" )
    if cmd == "render"
        if screenshot.is_empty() then return Err("usage: benchtop render <board | file.hocon> <output.png>")
        return launch(which, "", launch_options(frames = 1, screenshot = screenshot, headless = true, instrument_file = instrument_file))
    launch(which, "", launch_options(demo = cmd == "demo", frames = frames, screenshot = screenshot, headless = headless, instrument_file = instrument_file))

/** Say how far behind real time the slower core is while the session runs, unless another notice
 * that is not the session's own (a stop, a failure) holds the footer.
 */
pacing_notice(st: *State, paused: bool, snapshot: virt.WorkerObservation)
    val own = st.notice.kind == NoticeKind.Pacing
    if paused || !snapshot.running
        if own then st.notice = no_notice()
        return
    val k = if snapshot.launched && snapshot.cores[1].late_us > snapshot.cores[0].late_us then 1 else 0
    val lag = snapshot.cores[k].late_us
    if lag > 5000
        val kind = st.notice.kind
        if st.notice.text.is_empty() || kind == NoticeKind.Pacing || kind == NoticeKind.Reloaded || kind == NoticeKind.Saved then
            st.notice = Notice(NoticeKind.Pacing, s"Emulation speed: core $k is ${lag / 1000} ms behind real time")
    elif own then st.notice = no_notice()
