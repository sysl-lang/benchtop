module sh.sysl.benchtop.ui

import sh.sysl.sdl3 as sdl
import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.host as host
import sh.sysl.benchtop.v6m.{Cpu, Stop}
import sysl.buf.{Buf, buf}
import sysl.fs.read_bytes
import sysl.raw.str_cast
import sh.sysl.ui as toolkit
import sh.sysl.ui_sdl as driver
import sysl.text.parse_long

private val DEMO = embed("../../../../examples/visual/demo.elf")

frame_count(value: string) -> Result[u64, string]
    val n = parse_long(value) match
        Ok(n) -> n
        Err(_) -> return Err("--frames needs a positive integer")
    if n < 1 || n > 100000 then return Err("--frames must be between 1 and 100000")
    Ok(u64(n))

private restart(cpu: *Cpu, image: []const u8, st: *State)
    virt.open_console()
    virt.capture_bounded(8192)
    virt.boot(cpu, image)
    release_inputs(st)
    st.paused = false
    st.stopped = false
    st.status = "RUNNING"
    st.notice = ""
    st.instructions = 0
    st.pc = cpu.pc

/** One frame's real guest execution. A paused frame advances no guest instructions. */
advance(s: Scene, st: *State, cpu: *Cpu, step: bool = false)
    sample_inputs(s, *st)
    if !st.live || st.stopped then return
    if st.paused && !step
        st.status = "PAUSED"
        return
    let_running(virt.pump_board(cpu, if step then 1 else 20000), st, cpu)
    st.pc = cpu.pc
    st.instructions = cpu.retired + virt.core1().retired
    if step then st.paused = true
    if !st.stopped then st.status = if st.paused then "PAUSED" elif cpu.sleeping then "WAITING" else "RUNNING"

private let_running(running: bool, st: *State, cpu: *Cpu)
    if running then return
    st.stopped = true
    st.paused = true
    val stopped = if cpu.stop != Stop.Budget then cpu else virt.core1()
    st.status = stopped.stop match
        Breakpoint -> "BREAKPOINT"
        Exit -> s"EXIT ${stopped.exit_code}"
        Reset -> "RESET REQUEST"
        _ -> "GUEST FAULT"
    st.notice = virt.stop_message(stopped)

/** Load/check before opening a window. Both modes use the same syslUI tree. */
launch(which: string, file: string, demo: bool = false, frames: u64 = 0, screenshot: string = "", headless: bool = false, develop: host.Config = host.config()) -> Result[int, string]
    host.validate(develop, file)?
    val s = open_scene(which)?
    val live = demo || !file.is_empty()
    var image: Buf[u8] = buf()
    var original: []const u8 = []
    if live
        virt.board_named(which) match
            Err(why) -> return Err(why)
            Ok(_) -> ()
        val bytes: []const u8 = if demo then DEMO else read_bytes(file) match
            Ok(bytes) -> bytes
            Err(why) -> if develop.program.is_empty() then return Err(s"$file: $why") else []
        if bytes.len == 0 && develop.program.is_empty() then return Err("firmware is empty")
        if bytes.len > 0
            val parsed = if host.enabled(develop) then host.checked_image(bytes) else virt.image_of(bytes)
            parsed match
                Ok(i) ->
                    image = i
                    original = bytes
                Err(why) -> if develop.program.is_empty() then return Err(why)
    var st = state(live)
    val cpu = virt.core0()
    if live && image.len() > 0 then restart(cpu, image.view(), &st)
    elif live
        st.stopped = true
        st.paused = true
        st.status = "WAITING FOR BUILD"
    val d = desktop(s, st)
    val active = toolkit.signal(image)
    if host.enabled(develop)
        d.workflow = Some(host.open(develop, file, original)?)
        if !develop.program.is_empty() then d.console_tab.set(1)
    defer close_workflow(d)
    if headless
        val count = if frames == 0 then 1 else frames
        val count_signal = toolkit.signal(0u64)
        for frame in 0u64..<count
            host_tick(d, cpu, active, true)
            desktop_tick(d, cpu, active.read().view(), 0, count_signal, "benchtop.png")
        st = d.current.read()
        if !screenshot.is_empty() then save_desktop(d, screenshot)?
        if live && st.status == "GUEST FAULT" then return Err(st.notice)
        if st.status == "WAITING FOR BUILD" then return Err("no firmware loaded before --frames ended")
        d.workflow match
            Some(w) ->
                if w.building || w.build_requested then return Err("build did not finish before --frames ended")
                if w.failed then return Err(w.status)
            None -> ()
        return Ok(0)
    val path = if screenshot.is_empty() then "benchtop.png" else screenshot
    val count = toolkit.signal(0u64)
    sdl.set_main_ready()
    driver.run(driver.app(s"Benchtop - ${s.name}", () -> Workbench(d), () -> GROUND,
        width = WIDTH, height = HEIGHT, size = 14,
        on_event = e -> desktop_event(d, e),
        on_frame = dt ->
            host_tick(d, cpu, active)
            desktop_tick(d, cpu, active.read().view(), frames, count, path)))?
    if !screenshot.is_empty() then save_desktop(d, screenshot)?
    val final = d.current.read()
    if live && final.status == "GUEST FAULT" then return Err(final.notice)
    Ok(0)

private close_workflow(d: &Desktop)
    d.workflow match
        Some(w) -> host.close(w)
        None -> ()

/** Poll host work and apply a completed image only between guest slices. */
private[ui] host_tick(d: &Desktop, cpu: *Cpu, active: &toolkit.Signal[Buf[u8]], wait: bool = false)
    d.workflow match
        Some(w) ->
            host.poll(w, wait)
            host.take_image(w) match
                Some(image) ->
                    active.set(image)
                    var st = d.current.read()
                    restart(cpu, image.view(), &st)
                    st.notice = "Firmware reloaded"
                    d.current.set(st)
                None -> ()
        None -> ()

private[ui] desktop_tick(d: &Desktop, cpu: *Cpu, image: []const u8, frames: u64, count: &toolkit.Signal[u64], path: string)
    var st = d.current.read()
    sync_pots(d, &st)
    if d.resetting.read()
        if image.len > 0 then restart(cpu, image, &st)
        d.resetting.set(false)
    val step = d.stepping.read()
    d.stepping.set(false)
    if st.live then advance(d.scene, &st, cpu, step)
    d.current.set(st)
    if d.saving.read()
        d.saving.set(false)
        save_desktop(d, path) match
            Ok(_) -> st.notice = s"Saved $path"
            Err(why) -> st.notice = s"Save failed: $why"
        d.current.set(st)
    count.set(count.read() + 1)
    if frames != 0 && count.read() >= frames then driver.stop()

/** Leave pointer coordinates and widget events to syslUI's density-aware SDL driver. */
private desktop_event(d: &Desktop, e: sdl.Event) -> bool
    var st = d.current.read()
    e.kind() match
        WindowCloseRequested -> driver.stop()
        WindowFocusLost ->
            release_inputs(&st)
            d.pointer_live.set(false)
            d.current.set(st)
        MouseButtonDown ->
            if e.mouse_button() != sdl.MouseButton.Left then return true
            d.pointer_live.set(true)
        MouseButtonUp ->
            if e.mouse_button() != sdl.MouseButton.Left then return true
            st.mouse_part = ""
            d.pointer_live.set(false)
            d.current.set(st)
        KeyDown | KeyUp ->
            val down = e.kind() == sdl.EventKind.KeyDown
            if down && e.key_repeat() then return true
            val key = canonical_key(e.key_scancode())
            if key_input(d.scene, &st, key, down)
                d.current.set(st)
                return true
            if !down then return false
            key match
                "escape" -> driver.stop()
                "space" -> pause(d)
                "r" -> if st.live then d.resetting.set(true)
                "n" -> if st.live && !st.stopped then d.stepping.set(true)
                "s" -> d.saving.set(true)
                "b" -> d.workflow match
                    Some(w) -> host.request_build(w)
                    None -> ()
                _ -> return false
            return true
        _ -> ()
    false

private canonical_key(scancode: i32) -> string
    var bytes: Buf[u8] = buf()
    for b in sdl.scancode_name(scancode).bytes do bytes.push(b.to_lower())
    str_cast(bytes.view())

/** CLI for demo/view/render; run --window uses launch directly. */
command(args: []string) -> Result[int, string]
    val cmd = args[1]
    var which = if cmd == "demo" then "workbench" else ""
    var screenshot = ""
    var frames: u64 = 0
    var headless = false
    var i: usize = 2
    while i < args.len
        val arg = args[i]
        if arg == "--frames" || arg == "--screenshot"
            if i + 1 >= args.len then return Err(s"$arg needs a value")
            if arg == "--frames" then frames = frame_count(args[i + 1])? else screenshot = args[i + 1]
            i += 2
        elif arg == "--headless"
            headless = true
            i += 1
        elif arg.starts_with("--") then return Err(s"unknown option: $arg")
        elif which.is_empty()
            which = arg
            i += 1
        elif cmd == "render" && screenshot.is_empty()
            screenshot = arg
            i += 1
        else return Err(s"unexpected argument: $arg")
    if which.is_empty() then return Err(s"usage: benchtop $cmd <board | file.hocon>" )
    if cmd == "render"
        if screenshot.is_empty() then return Err("usage: benchtop render <board | file.hocon> <output.png>")
        return launch(which, "", false, 1, screenshot, true)
    launch(which, "", cmd == "demo", frames, screenshot, headless)
