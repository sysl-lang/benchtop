module sh.sysl.benchtop.ui

import sh.sysl.sdl3 as sdl
import sh.sysl.benchtop.virt as virt
import sysl.math.{min, max}
import sysl.env.get
import sysl.math.Float

/** `trace` (from `BENCHTOP_AUDIO_TRACE=1`) prints the stream's state every 30 frames. */
struct AudioPlayer
    stream: Option[&sdl.AudioStream]
    recording: Option[&sdl.AudioStream]
    epoch: u64
    paused: bool
    driver: string
    error: string
    channels: int
    trace: bool
    frames: u64

private[ui] audio_player() -> &AudioPlayer
    val player: &AudioPlayer = AudioPlayer(stream = None, recording = None, epoch = virt.sound_epoch(), paused = false, driver = "", error = "",
        channels = virt.sound_channels(), trace = get("BENCHTOP_AUDIO_TRACE") == Some("1"), frames = 0)
    if !virt.sound_available() then return player
    if !sdl.init_audio()
        player.error = sdl.error()
        return player
    if virt.microphone_available()
        player.recording = sdl.open_recording_stream(48000)
        if player.recording.is_none() then player.error = s"Microphone unavailable: ${sdl.error()}"
    player.stream = sdl.open_audio_stream(48000, player.channels)
    if player.stream.is_none() then player.error = sdl.error()
    else
        player.driver = sdl.current_audio_driver().unwrap_or("")
        prime(player.stream.unwrap(), player.channels)
    player

private prime(stream: &sdl.AudioStream, channels: int)
    var quiet: [4096]f32 = [0.0; 4096]
    stream.put(quiet[..<usize(2048 * channels)])

private[ui] close_audio(player: &AudioPlayer)
    player.recording = None
    player.stream = None
    if virt.sound_available() then sdl.quit_audio()

/** Playback uses a paced guest clock; stalls never create an unbounded audio backlog. */
private[ui] audio_budget(dt: real, hz: u64) -> u64 = u64(max(0.0, min(0.05, dt)) * real(hz))

private[ui] audio_frame(player: &AudioPlayer, d: &Desktop)
    if !virt.sound_available() then return
    val time = virt.observation_time()
    val samples = virt.take_sound(time, u32(player.channels))
    val session = d.session
    val paused = session.paused || session.stopped || d.sound_muted.read()
    var capture_peak: f32 = 0.0
    var captured: usize = 0
    player.recording match
        Some(recording) ->
            if player.epoch != virt.sound_epoch() || session.paused || session.stopped
                recording.clear()
                virt.clear_audio_host()
            else
                var input: [4096]f32 = [0.0;4096]
                // Drop old capture after a host stall instead of replaying stale input.
                var discarded = 0
                while recording.available() > 4096 * 4 && discarded < 8
                    recording.read(input[..])
                    discarded += 1
                if recording.available() > 4096 * 4 then recording.clear()
                recording.read(input[..]) match
                    Some(count) ->
                        captured = count
                        for sample in input[..<count] do capture_peak = max(capture_peak, sample.abs())
                        virt.feed_microphone(input[..<count])
                    None -> player.error = sdl.error()
        None -> ()
    player.stream match
        Some(stream) ->
            if player.epoch != virt.sound_epoch() || paused != player.paused
                stream.clear()
                if paused then stream.pause()
                else
                    prime(stream, player.channels)
                    stream.resume()
            player.epoch = virt.sound_epoch()
            player.paused = paused
            if paused then return
            if long(stream.queued()) + long(samples.len()) * 4 > 48000 * 4 * player.channels / 10 then stream.clear()
            if !stream.put(samples.view()) then player.error = sdl.error()
        None -> ()
    if player.stream.is_none()
        player.epoch = virt.sound_epoch()
        player.paused = paused
    if player.trace
        player.frames += 1
        if player.frames % 30 == 0
            var peak: f32 = 0.0
            for sample in samples do peak = max(peak, sample.abs())
            print(s"audio driver=${player.driver} time=$time samples=${samples.len()} peak=$peak captured=$captured mic=$capture_peak gpio=${virt.panel_levels()} output=${virt.panel_output_latch()} muted=${d.sound_muted.read()} error=${player.error}")
