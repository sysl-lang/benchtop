module sh.sysl.benchtop.ui

import sh.sysl.sdl3 as sdl
import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m.clock
import sysl.buf.{Buf, buf}
import sysl.math.{min, max}
import sysl.text.from_cstring

extern "SDL_GetCurrentAudioDriver" current_audio_driver() -> *u8

struct AudioPlayer
    stream: Option[&sdl.AudioStream]
    recording: Option[&sdl.AudioStream]
    epoch: u64
    paused: bool
    driver: string
    error: string

private[ui] audio_player() -> &AudioPlayer
    val player: &AudioPlayer = AudioPlayer(None, None, virt.sound_epoch, false, "", "")
    if !virt.sound_available() then return player
    if !sdl.init_audio()
        player.error = sdl.error()
        return player
    if virt.microphone_available()
        player.recording = sdl.open_recording_stream(48000)
        if player.recording.is_none() then player.error = s"Microphone unavailable: ${sdl.error()}"
    player.stream = sdl.open_audio_stream(48000)
    if player.stream.is_none() then player.error = sdl.error()
    else
        player.driver = from_cstring(current_audio_driver()).unwrap_or("")
        prime(player.stream.unwrap())
    player

private prime(stream: &sdl.AudioStream)
    var quiet: [2048]f32 = [0.0; 2048]
    stream.put(quiet[..])

private[ui] close_audio(player: &AudioPlayer)
    player.recording = None
    player.stream = None
    if virt.sound_available() then sdl.quit_audio()

/** Playback uses a paced guest clock; stalls never create an unbounded audio backlog. */
private[ui] audio_budget(dt: real, hz: u64) -> u64 = u64(max(0.0, min(0.05, dt)) * real(hz))

private[ui] audio_frame(player: &AudioPlayer, d: &Desktop)
    if !virt.sound_available() then return
    val cpu = virt.core0()
    val time = clock(cpu, cpu.retired)
    val samples = virt.take_sound(time)
    val st = d.current.read()
    val paused = st.paused || st.stopped || d.sound_muted.read()
    player.recording match
        Some(recording) ->
            if player.epoch != virt.sound_epoch || st.paused || st.stopped
                recording.clear()
                virt.clear_audio_host()
            else
                var input: [4096]f32 = [0.0;4096]
                // Drop old capture after a host stall instead of replaying stale input.
                var discarded = 0
                while recording.available() > 4096 * 4 && discarded < 8
                    recording.read(input[..])
                    discarded += 1
                if recording.available() > 4096 * 4 then recording.clear()
                recording.read(input[..]) match
                    Some(count) -> virt.feed_microphone(input[..<count])
                    None -> player.error = sdl.error()
        None -> ()
    player.stream match
        Some(stream) ->
            if player.epoch != virt.sound_epoch || paused != player.paused
                stream.clear()
                if paused then stream.pause()
                else
                    prime(stream)
                    stream.resume()
            player.epoch = virt.sound_epoch
            player.paused = paused
            if paused then return
            if long(stream.queued()) + long(samples.len()) * 4 > 48000 * 4 / 10 then stream.clear()
            if !stream.put(samples.view()) then player.error = sdl.error()
        None -> ()
    if player.stream.is_none()
        player.epoch = virt.sound_epoch
        player.paused = paused
