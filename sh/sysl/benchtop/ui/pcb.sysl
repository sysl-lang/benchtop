module sh.sysl.benchtop.ui

import sh.sysl.ui as ui
import sh.sysl.benchtop.{PcbArt, PcbShape, PcbAlign, pcb_art, turned}
import sysl.math.min

// A board's printed circuit as the window paints it: the drawing a view names (`sh.sysl.benchtop.pcb_art`)
// item by item, turned with the element showing the board, or a plain board where it names none.

/** A board's printed circuit in `r`: the drawing `pcb` names on a `background` solder mask, turned
 * `turn` degrees clockwise, or, where `pcb` names none, the background with rounded corners and an
 * edge.
 */
private[ui] draw_board(c: *ui.Canvas, r: ui.Rect, pcb: string, background: string, turn: int)
    pcb_art(pcb) match
        Some(art) -> draw_pcb_art(c, r, art, parse_color(background), turn)
        None -> draw_pcb(c, r, background)

/** The drawing `art` in `r`, on a `mask` coloured solder mask, turned `turn` degrees clockwise. The
 * pads' names and the silkscreen's words are drawn upright or upside down only: turned a quarter, the
 * names would lie across one another, so the board is drawn without them.
 */
private[ui] draw_pcb_art(c: *ui.Canvas, r: ui.Rect, art: PcbArt, mask: u32, turn: int)
    val upright = turn % 180 == 0

    for item in art.items
        val (x, y, w, h) = turned(item.x, item.y, item.w, item.h, art.width, art.height, turn)
        val b = ui.Rect(r.x + x, r.y + y, w, h)
        val round = min(w, h) / 2

        item.shape match
            SolderMask ->
                c.fill(b, mask, 4)
                c.stroke(b, PCB_EDGE, 1, 4)
            AntennaKeepout -> c.fill(b, blend_color(mask, PCB_SILK, 0.25), 2)
            Castellation -> c.fill(b, PCB_GOLD, 2)
            CopperPad -> c.fill(b, PCB_GOLD, round)
            DrillHole -> c.fill(b, PCB_HOLE, round)
            IcPackage ->
                c.fill(b, PCB_PACKAGE, 1)
                if !item.text.is_empty() then pcb_text(c, b, item.text, PCB_MARKING, 8, PcbAlign.AlignMiddle)
            ChipPassive -> c.fill(b, PCB_PASSIVE, 1)
            PowerInductor ->
                c.fill(b, PCB_INDUCTOR, 3)
                c.stroke(b, PCB_TIN_SHADE, 1, 3)
            TinPlate -> c.fill(b, PCB_TIN, 1)
            TinShade -> c.fill(b, PCB_TIN_SHADE, 1)
            ShieldCan ->
                c.fill(b, PCB_TIN, 2)
                c.stroke(b, PCB_TIN_SHADE, 1, 2)
                c.stroke(ui.Rect(b.x + 3, b.y + 3, b.w - 6, b.h - 6), PCB_TIN_SHADE, 1, 1)
            CrystalBase -> c.fill(b, PCB_CERAMIC, 1)
            ButtonCap -> c.fill(b, PCB_SILK, round)
            CathodeBand -> c.fill(b, PCB_MARKING, 0)
            SilkOutline -> c.stroke(b, PCB_SILK, 1, 1)
            SilkText -> if upright then pcb_text(c, b, item.text, PCB_SILK, 9, PcbAlign.AlignMiddle)
    end for

    if upright
        for l in art.labels
            val (x, y, w, h) = turned(l.x, l.y, l.w, l.h, art.width, art.height, turn)
            val align = if turn == 0 then l.align else l.align match
                AlignStart -> PcbAlign.AlignEnd
                AlignEnd -> PcbAlign.AlignStart
                AlignMiddle -> PcbAlign.AlignMiddle

            pcb_text(c, ui.Rect(r.x + x, r.y + y, w, h), l.text, pin_color(l.text), l.size, align)
end draw_pcb_art

/** The colour a pad's name is printed in: grounds muted, the supply and control pins in the warning
 * colour, and the GPIO and debug pins in ink.
 */
private[ui] pin_color(name: string) -> u32 = name match
    "GND" | "AGND" -> MUTED
    "VBUS" | "VSYS" | "3V3" | "3V3_EN" | "ADC_VREF" | "RUN" -> WARN
    _ -> INK

// `value` in `color`, `size` pixels high, centred down `r` and kept to the side of it `align` says.
private pcb_text(c: *ui.Canvas, r: ui.Rect, value: string, color: u32, size: int, align: PcbAlign)
    c.push_font_size(real(size))
    val s = c.text_size(value)
    val x = align match
        AlignStart -> r.x
        AlignMiddle -> r.x + (r.w - s.w) / 2
        AlignEnd -> r.right() - s.w
    c.ink(color)
    c.text(ui.Rect(x, r.y + (r.h - s.h) / 2, s.w + 1, s.h), value)
    c.unink()
    c.pop_font_size()
