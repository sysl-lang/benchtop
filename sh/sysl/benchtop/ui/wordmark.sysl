module sh.sysl.benchtop.ui

import sh.sysl.ui as ui

/** The original five-column, seven-row BENCHTOP lettering. */
struct Wordmark
end Wordmark

impl ui.View for Wordmark
    measure(&self, c: *ui.Canvas, avail: ui.Size) -> ui.Size = ui.Size(235, 35)
    paint(&self, c: *ui.Canvas, r: ui.Rect)
        val glyphs: [8][5]u8 = [
            [127,73,73,73,54], [127,73,73,73,65], [127,4,8,16,127], [62,65,65,65,34],
            [127,8,8,8,127], [1,1,127,1,1], [62,65,65,65,62], [127,9,9,9,6]]
        val scale = if r.w >= 235 then 5 else 3
        for letter in 0..<8
            for col in 0..<5
                for row in 0..<7
                    if (glyphs[letter][col] & (1u8 << row)) != 0
                        c.fill(ui.Rect(r.x + (letter * 6 + col) * scale, r.y + row * scale, scale, scale), ACCENT)
