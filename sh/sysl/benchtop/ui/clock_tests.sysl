module sh.sysl.benchtop.ui
@tests

@test("MCU pacing: requested rates, fractional ticks, negative deltas and bounded catch-up")
clock_pacing()
    val p = guest_pacer()
    assert(p.budget(0.016,150000000) == 2400000)
    assert(p.budget(0.016,12000000) == 192000)
    assert(p.budget(-1.0,150000000) == 0)
    assert(p.budget(0.0,150000000) == 0)
    assert(p.budget(10.0,150000000) == 7500000)
    val slow = guest_pacer()
    for i in 0..<3 do assert(slow.budget(0.03125,8) == 0)
    assert(slow.budget(0.03125,8) == 1)
    assert(slow.fraction == 0.0)
