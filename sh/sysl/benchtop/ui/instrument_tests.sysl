module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.instrument as plot
import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.ui as ui
import sysl.text.{from_utf8_lossy, Search}

private val INSTRUMENTS = embed("../../../../instruments/workbench.hocon")
private val FIRMWARE = embed("../../../../examples/visual/demo.elf")

private[ui] instrument_desktop() -> &Desktop
    assert(virt.board_named("workbench").is_ok())
    virt.boot(virt.core0(), virt.image_of(FIRMWARE).unwrap().view())
    val s = open_scene("workbench").unwrap()
    val d = desktop(s, state(true))
    d.instruments = instruments(s, from_utf8_lossy(INSTRUMENTS)).unwrap()
    d

@test("plot instrument: ADC observes firmware results without changing guest execution, register state or IRQ")
adc_observation()
    val d = instrument_desktop()
    val p = d.instruments.at(0).plot
    val count = ui.signal(0u64)
    for position in [0, 5000, 10000]
        d.pots.at(0).position.set(position)
        for frame in 0..<3 do desktop_tick(d, virt.core0(), [], 0, count, "unused.png")
        val value = (p.source.read)().unwrap()
        assert(value == (if position == 0 then 0.0 elif position == 5000 then 2048.0 else 4095.0))
        val retired = virt.core0().retired
        val cycles = cpu.clock(virt.core0(), retired)
        val before = virt.machine.devices.adc.converter
        for observation in 0..<10 do assert((p.source.read)() == Some(value))
        assert(virt.core0().retired == retired && cpu.clock(virt.core0(), retired) == cycles)
        assert(virt.machine.devices.adc.converter.result == before.result && virt.machine.devices.adc.converter.pending == before.pending && virt.machine.devices.adc.converter.busy == before.busy && virt.machine.devices.adc.converter.ready == before.ready && virt.machine.devices.adc.converter.due == before.due)
    var st = d.current.read()
    st.paused = true
    d.current.set(st)
    val last = p.last
    val length = p.samples.len()
    desktop_tick(d, virt.core0(), [], 0, count, "unused.png")
    assert(p.last == last && p.samples.len() == length)
    d.resetting.set(true)
    desktop_tick(d, virt.core0(), virt.image_of(FIRMWARE).unwrap().view(), 0, count, "unused.png")
    assert(p.samples.len() == 1)

@test("plot instrument: sources bind named peripherals, CPU registers, GPIO and bounded backing RAM")
sources()
    val d = instrument_desktop()
    val s = d.scene
    virt.core0().r[3] = 1234
    assert((instrument_source(s, "cpu0.r3", "").unwrap().read)() == Some(1234.0))
    assert((instrument_source(s, "cpu0.pc", "").unwrap().read)() == Some(real(virt.core0().pc)))
    assert((instrument_source(s, "cpu1.retired", "").unwrap().read)() == Some(real(virt.core1().retired)))
    assert((instrument_source(s, "controller.gpio.IN", "").unwrap().read)() == Some(real(virt.panel_levels())))
    assert((instrument_source(s, "controller.gpio.OUT", "").unwrap().read)() == Some(real(virt.panel_output_latch())))
    assert((instrument_source(s, "controller.gpio.OE", "").unwrap().read)() == Some(real(virt.panel_drive_mask())))
    val ram = virt.machine.memory
    ram.ram[100] = 0x78
    ram.ram[101] = 0x56
    ram.ram[102] = 0x34
    ram.ram[103] = 0x12
    assert((instrument_source(s, "ram.u8.100", "").unwrap().read)() == Some(120.0))
    assert((instrument_source(s, "ram.u16.100", "").unwrap().read)() == Some(22136.0))
    assert((instrument_source(s, "ram.u32.100", "").unwrap().read)() == Some(305419896.0))
    assert(instrument_source(s, "ram.u32.1048573", "").is_err())
    assert(instrument_source(s, "ram.u8.-1", "").is_err())
    assert(instrument_source(s, "ram.u32.bad", "").is_err())
    assert(instrument_source(s, "other.adc.RESULT", "").is_err())
    assert(instrument_source(s, "controller.adc.UNKNOWN", "").is_err())
    assert(instrument_source(s, "cpu0.r16", "").is_err())

@test("plot instrument: separate HOCON configuration validates types, references and sampling bounds")
configuration()
    val s = open_scene("workbench").unwrap()
    assert(instruments(s, from_utf8_lossy(INSTRUMENTS)).unwrap().len() == 1)
    for text in [
        "instruments = 1", "instruments { x = 2 }", "{}",
        "instruments { x { source = cpu0.pc, mystery = 1 } }",
        "instruments { x { source = cpu0.pc, part = missing } }",
        "instruments { x { source = cpu0.pc, min = 5, max = 1 } }",
        "instruments { x { source = cpu0.pc, capacity = 1 } }",
        "instruments { x { source = cpu0.pc, capacity = 2.5 } }",
        "instruments { x { source = cpu0.pc, sample-cycles = 0 } }",
        "instruments { x { source = cpu0.pc, title = 2 } }",
        "instruments { x { source = cpu0.pc, instrument = missing } }",
        "instruments { x { source = missing } }"]
        assert(instruments(s, text).is_err(), text)

@test("plot instrument: hovering a part does not raise a tooltip or open an instrument")
no_hover_preview()
    val d = instrument_desktop()
    var st = d.current.read()
    advance(d.scene, &st, virt.core0())
    d.current.set(st)
    instrument_tick(d)
    val retired = virt.core0().retired
    val p = d.instruments.at(0).plot
    val count = p.samples.len()
    val tree: &ui.View = Workbench(d)
    var c = ui.recorder()
    ui.render(tree, &c, ui.Rect(0, 0, WIDTH, HEIGHT))
    val t = board_transform(d.scene, d.board_rect.read())
    val x = int(t.x + 369.0 * t.scale)
    val y = int(t.y + 357.0 * t.scale)
    c.point(x, y)
    ui.render(tree, &c, ui.Rect(0, 0, WIDTH, HEIGHT))
    var preview = false
    for op in c.ops do if op.starts_with("raise ") then preview = true
    assert(!preview && virt.core0().retired == retired && p.samples.len() == count)
    assert(!d.instruments.at(0).opening && d.instruments.at(0).window.is_none())

@test("visual desktop: guest and build tabs stay available for the quiet seven-segment demo")
quiet_log_tabs()
    val d = instrument_desktop()
    val tree: &ui.View = Workbench(d)
    var c = ui.recorder()
    ui.render(tree, &c, ui.Rect(0, 0, WIDTH, HEIGHT))
    var guest = false
    var build = false
    for op in c.ops
        if op.contains("Guest") then guest = true
        if op.contains("Build") then build = true
    assert(guest && build)
    d.console_tab.set(1)
    ui.render(tree, &c, ui.Rect(0, 0, WIDTH, HEIGHT))
    var empty = false
    for op in c.ops do if op.contains("No build command configured.") then empty = true
    assert(empty && virt.output().len == 0)
