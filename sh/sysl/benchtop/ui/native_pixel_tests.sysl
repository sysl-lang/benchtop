module sh.sysl.benchtop.ui
@tests

import sh.sysl.ui as ui
import sh.sysl.plutovg as vg
import sh.sysl.ui_sdl as driver

@test("native display pixels: exact source colors and dimensions survive Retina and fractional DPI with clipping")
native_raster_pixels()
    val font = vg.font(driver.system_font()).unwrap()
    val source = vg.surface(3,2).unwrap()
    val colors = [0xFFFF0000u32,0xFF00FF00u32,0xFF7B7B7Bu32,0xFF0000FFu32,0xFFB5B5B5u32,0xFFFFFFFFu32]
    val bytes = source.data()
    for i in 0..<6
        for byte in 0..<4 do bytes[i * 4 + byte] = u8((colors[i] >> (byte * 8)) & 255)
    val image: &ui.Image = ui.Image(source)
    for density in [1.0f32,1.5f32,2.0f32,3.0f32]
        val target = vg.surface(80,80).unwrap()
        target.clear(0,0,0)
        val canvas = vg.canvas(target).unwrap()
        canvas.scale(density,density)
        var c = ui.pluto_canvas(canvas,font,14)
        assert(c.pixel_scale() == real(density))
        c.draw_native_image(10,10,image)
        val start = int(10.0 * real(density))
        val pixels = target.data()
        for y in 0..<80
            for x in 0..<80
                val inside = x >= start && x < start + 3 && y >= start && y < start + 2
                val expected = if inside then colors[(y - start) * 3 + x - start] else 0xFF000000u32
                val at = y * target.stride() + x * 4
                val actual = u32(pixels[at]) | (u32(pixels[at + 1]) << 8) | (u32(pixels[at + 2]) << 16) | (u32(pixels[at + 3]) << 24)
                assert(actual == expected,"native raster pixels must be copied exactly without interpolation or DPI enlargement")
        c.clip(ui.Rect(10,10,1,1))
        c.draw_native_image(10,10,image)
        c.unclip()
        c.fill(ui.Rect(0,0,1,1),0x123456)
        val offset = target.stride() + 4
        if density >= 2.0 then assert(pixels[offset] == 0x56,"native painting must restore the original canvas transform")
