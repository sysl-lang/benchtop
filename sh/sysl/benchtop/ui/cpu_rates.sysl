module sh.sysl.benchtop.ui

import sh.sysl.benchtop.virt as virt
import sysl.env.get
import sysl.time.monotonic

/** Opt-in wall-time diagnostics. Reads published snapshots once per frame,
 * formats at most once per second, and adds no work to guest instruction paths.
 */
struct CpuRateTrace
    at: long
    retired: [2]u64
    frames: u64
    time: [2]u64

    sample(*self)
        val snapshot = virt.workers_observe()
        val now = monotonic().us
        self.frames += 1
        if self.at == 0 || snapshot.cores[0].retired < self.retired[0] || snapshot.cores[1].retired < self.retired[1]
            self.at = now
            self.retired = [snapshot.cores[0].retired,snapshot.cores[1].retired]
            self.time = [snapshot.cores[0].time,snapshot.cores[1].time]
            self.frames = 0
            return
        val elapsed = now - self.at
        if elapsed < 1000000 then return
        val first = real(snapshot.cores[0].retired - self.retired[0]) / real(elapsed)
        val second = real(snapshot.cores[1].retired - self.retired[1]) / real(elapsed)
        val clock0 = real(snapshot.cores[0].time - self.time[0]) / real(virt.clock_divisors()[0]) / real(elapsed)
        val clock1 = real(snapshot.cores[1].time - self.time[1]) / real(virt.clock_divisors()[1]) / real(elapsed)
        val fps = real(self.frames) * 1000000.0 / real(elapsed)
        print(s"cpu-rate core0=$first MIPS core1=$second MIPS core1-launched=${snapshot.launched} clock0-MHz=$clock0 clock1-MHz=$clock1 late0-us=${snapshot.cores[0].late_us} late1-us=${snapshot.cores[1].late_us} frames-per-second=$fps wall-us=$elapsed")
        self.time = [snapshot.cores[0].time,snapshot.cores[1].time]
        self.at = now
        self.retired = [snapshot.cores[0].retired,snapshot.cores[1].retired]
        self.frames = 0

cpu_rate_trace() -> Option[&CpuRateTrace] =
    if get("BENCHTOP_CPU_TRACE") == Some("1") then Some(CpuRateTrace(0,[0,0],0,[0,0])) else None
