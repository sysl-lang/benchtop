module sh.sysl.benchtop.ui

import sh.sysl.ui as ui
import sh.sysl.ui_sdl as driver
import sh.sysl.sdl3 as sdl
import sh.sysl.sdl3.c as native
import sh.sysl.benchtop.{Element, Part, ShowPart, part_whole, rotation}
import sh.sysl.benchtop.virt as virt
import sysl.math.{min, max}

/** What a drag that began on the board holds: nothing, a joystick, or a touch screen's glass (by
 * its view element).
 */
enum Capture derives Eq
    Free
    Joystick(part: string)
    Glass(element: string)

private[ui] release_touch(d: &Desktop)
    d.session.guest.lift_touches()
    for (_, p) in window_parts(d.scene) do if look_of(p) == PartLook.Stick then d.session.set_part_input(p.name, virt.PartInput.Axes(virt.POSITION_CENTRE, virt.POSITION_CENTRE))
    d.touch_capture.set(Capture.Free)

/** Pointer capture keeps drags continuous, including release outside the glass.
 * The bezel never generates touches. Event handling also preserves fast clicks
 * whose down and up arrive before the next paint.
 */
private[ui] pointer_touch(d: &Desktop, x: int, y: int, down: bool, begin: bool = false)
    val session = d.session
    if !session.live || session.paused || session.stopped || !down
        release_touch(d)
        return
    val board = d.board_rect.read()
    if begin && board.holds(x, y)
        d.scene.scope.find(part_at(d.scene, board, x, y)) match
            Some(p) ->
                if look_of(p) == PartLook.Toggle
                    session.toggle(p.name)
                    session.apply_inputs()
                    return
            None -> ()
    val transform = board_transform(d.scene, board)
    for element in d.scene.view.elements
        element.shows match
            ShowPart(name) -> d.scene.scope.find(name) match
                Some(p) ->
                    if look_of(p) != PartLook.Stick then continue
                    val (ex, ey, ew, eh) = coords(transform, element)
                    val box = ui.Rect(ex, ey, ew, eh)
                    val held = Capture.Joystick(name)
                    if d.touch_capture.read() == Capture.Free && begin && board.holds(x, y) && box.holds(x, y) then d.touch_capture.set(held)
                    if d.touch_capture.read() != held then continue
                    val (ax, ay) = stick_position(box, x, y)
                    session.set_part_input(p.name, virt.PartInput.Axes(ax, ay))
                    return
                None -> ()
            _ -> ()
    for binding in d.scene.pointers
        for element in d.scene.view.elements
            if element.name != binding.element then continue
            element.shows match
                ShowPart(name) -> d.scene.scope.find(name) match
                    Some(part) ->
                        if look_of(part) != PartLook.Tft then continue
                        val screen = glass_at(transform, element, part, d.pixel_scale.read())
                        if screen.w <= 0 || screen.h <= 0 then continue
                        val held = Capture.Glass(element.name)
                        if d.touch_capture.read() == Capture.Free
                            if !begin || !board.holds(x, y) || !screen.holds(x, y) then continue
                            d.touch_capture.set(held)
                        if d.touch_capture.read() != held then continue
                        d.scene.scope.find(binding.part) match
                            Some(touch) ->
                                // The session runs a board's part under the board's own name for it.
                                val (width, height) = session.guest.touch_size(touch.name).unwrap_or((int(part_whole(touch, "width", 240)), int(part_whole(touch, "height", 240))))
                                val (tx, ty) = touched_at(x - screen.x, y - screen.y, screen.w, screen.h, width, height, rotation(element))
                                session.guest.touch(touch.name, tx, ty, true)
                            None -> ()
                    None -> ()
                _ -> ()

/** Where panel `p`'s glass, shown by element `e`, lands on the canvas: found in the board's own
 * coordinates, as the panel is drawn, and placed by the board's transform.
 */
private[ui] glass_at(t: Transform, e: Element, p: Part, density: real) -> ui.Rect
    val box = element_box(e)
    placed(t, if bare_glass(p) then box else tft_screen(native_tft_frame(box, p, density), p, density))

/** The touch controller's point, in its `width` by `height` range, for a pointer at (u, v) of a glass
 * shown `w` by `h` and turned `turn` degrees clockwise; a drag past the glass's edge is held to it.
 */
private[ui] touched_at(u: int, v: int, w: int, h: int, width: int, height: int, turn: int) -> (int, int)
    if turn != 90 && turn != 180 && turn != 270
        return (max(0, min(width - 1, u * width / w)), max(0, min(height - 1, v * height / h)))
    val sideways = turn != 180
    val (gw, gh) = if sideways then (h, w) else (w, h)
    val (gx, gy) = unturned_pixel(max(0, min(w - 1, u)), max(0, min(h - 1, v)), gw, gh, turn)
    (max(0, min(width - 1, gx * width / gw)), max(0, min(height - 1, gy * height / gh)))

private[ui] touch_event(d: &Desktop, e: sdl.Event, down: bool, begin: bool = false)
    // Only the event's window id is held here, so its size and scale are read through the borrowed
    // handle; a `sdl.Window` would own (and destroy) the driver's window.
    val window = native.get_window_from_id(e.window_id())
    if window == null then return
    var ww: i32 = 0
    var wh: i32 = 0
    var pw: i32 = 0
    var ph: i32 = 0
    if !native.get_window_size(window, &ww, &wh) || !native.get_window_size_in_pixels(window, &pw, &ph) then return
    val scale = driver.point_scale(ww, pw, driver.scale_of(native.get_window_display_scale(window)))
    pointer_touch(d, int(real(e.mouse_x()) * scale), int(real(e.mouse_y()) * scale), down, begin)
