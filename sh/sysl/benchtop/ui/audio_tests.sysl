module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.sdl3 as sdl
import sh.sysl.ui as ui
import sysl.env.vars
import sysl.math.Float

private val AUDIO_GUEST = embed("../../../../examples/visual/demo.elf")

private audio_desktop() -> &Desktop
    val d = desktop(open_scene("workbench").unwrap(), true)
    val m = d.session.board()
    assert(virt.board_named(m, "workbench").is_ok())
    virt.open_console(m)
    virt.capture_bounded(m, 256)
    virt.boot(m, virt.image_of(m, AUDIO_GUEST).unwrap().view())
    d

@test("audio firmware: PWM follows knob pitch, button gates sound, samples are bounded, and MCU reset preserves RTC")
firmware_audio()
    val d = audio_desktop()
    val m = d.session.board()
    val count = ui.signal(0u64)
    val image = virt.image_of(m, AUDIO_GUEST).unwrap()
    var st = d.current.read()
    key_input(d.scene, &st, "1", true)
    d.current.set(st)
    for frame in 0..<10 do desktop_tick(d, image.view(), 0, count, "")
    assert(!d.session.stopped, d.current.read().notice.text)
    assert(m.devices.pwm.live.with(s -> s.channel).enabled && m.devices.pwm.live.with(s -> s.channel).period == 3000 + ((4095 - 2048) << 2))
    val samples = virt.take_sound(m, cpu.clock(virt.core0(m), virt.core0(m).retired))
    var loud = false
    for sample in samples do if sample.abs() > 0.02 then loud = true
    assert(loud && samples.len() <= 4096)
    d.pots.at(0).position.set(10000)
    desktop_tick(d, image.view(), 0, count, "")
    assert(m.devices.pwm.live.with(s -> s.channel).period == 3000)
    st = d.current.read()
    key_input(d.scene, &st, "1", false)
    d.current.set(st)
    desktop_tick(d, image.view(), 0, count, "")
    assert(!m.devices.pwm.live.with(s -> s.channel).enabled)
    m.devices.i2c.live.with(s -> s.rtcs.at(0).model.registers[1] = 0x34)
    virt.boot(m, image.view())
    assert(m.devices.i2c.live.with(s -> s.rtcs.at(0).model.registers[1]) == 0x34 &&!m.devices.pwm.live.with(s -> s.channel).enabled)

@test("native audio: SDL queue plays firmware PWM and clears on mute, pause and reset")
native_playback()
    var live = false
    for entry in vars() do if entry.0 == "BENCHTOP_AUDIO_LIVE" && entry.1 == "1" then live = true
    sdl.set_main_ready()
    assert(sdl.set_hint("SDL_AUDIO_DRIVER", if live then "coreaudio" else "dummy"))
    val d = audio_desktop()
    val player = audio_player(d.session.board())
    assert(player.stream.is_some(), player.error)
    if live then assert(player.driver == "coreaudio")
    exercise_playback(d, player, live)
    close_audio(d.session.board(), player)

private[ui] exercise_playback(d: &Desktop, player: &AudioPlayer, live: bool)
    val count = ui.signal(0u64)
    var st = d.current.read()
    key_input(d.scene, &st, "1", true)
    d.current.set(st)
    for frame in 0..<60
        desktop_tick(d, [], 0, count, "", 120000)
        audio_frame(player, d)
        if live then sdl.delay(10)
    assert(!d.session.stopped, d.current.read().notice.text)
    assert(player.error.is_empty())
    assert(player.stream.unwrap().queued() <= 4 * (4800 + 4096))
    d.sound_muted.set(true)
    audio_frame(player, d)
    assert(player.paused && player.stream.unwrap().queued() == 0)
    d.sound_muted.set(false)
    audio_frame(player, d)
    assert(!player.paused)
    d.session.paused = true
    audio_frame(player, d)
    assert(player.paused && player.stream.unwrap().queued() == 0)
    assert(audio_budget(1.0, 12000000) == 600000 && audio_budget(-1.0, 12000000) == 0)
