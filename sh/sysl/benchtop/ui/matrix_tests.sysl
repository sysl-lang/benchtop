module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.parts.seven_segment as scan
import sh.sysl.benchtop.{load, library, part_named, part_model, description_text}
import sh.sysl.parsing.source_of
import sysl.raw.str_cast
import sh.sysl.ui as ui

@test("LED matrix: all 25 intersections require a driven high row and driven low column")
matrix_intersections()
    val columns: [8]int = [5,6,7,8,9,-1,-1,-1]
    val rows: [8]int = [0,1,2,3,4,-1,-1,-1]
    var model = scan.display(5, true, 100, columns, rows)
    for row in 0..<5
        for col in 0..<5
            scan.reset(&model)
            val levels = ((31u32 ^ (1u32 << u32(col))) << 5) | (1u32 << u32(row))
            scan.observe(&model, levels, 1023, 1)
            for y in 0..<5
                assert(scan.read(model, y, 10000) == (if y == row then 1u8 << u32(col) else 0))
            scan.observe(&model, levels, 1023 & ~(1u32 << u32(col + 5)), 2)
            assert(scan.read(model, row, 103) == 0, "floating cathode cannot sink current")
            scan.reset(&model)
            scan.observe(&model, levels, 1023 & ~(1u32 << u32(row)), 1)
            assert(scan.read(model, row, 1) == 0, "floating anode cannot source current")

@test("LED matrix: physical catalog identity and required row and column connections validate")
matrix_description()
    val text = str_cast(embed("../../../../boards/matrix.hocon"))
    val parsed = load(source_of("matrix.hocon", text), library())
    assert(!parsed.report.has_errors(), parsed.report.render(source_of("matrix.hocon", text)))
    assert(part_model(part_named(parsed.description.board.parts, "matrix").unwrap()) == "led-matrix-5x5")
    val written = description_text(parsed.description)
    assert(written.contains("microbit-v2-led-matrix"))
    assert(!load(source_of("again.hocon", written), library()).report.has_errors())

@test("LED matrix firmware: GPIO scanning produces a heart and diagonal without stopping the MCU")
matrix_firmware()
    assert(virt.board_named("boards/matrix.hocon").is_ok())
    virt.open_console()
    virt.capture_bounded(256)
    val image = virt.image_of(embed("../../../../examples/matrix/demo.elf")).unwrap()
    virt.boot(virt.core0(), image.view())
    val d = desktop(open_scene("boards/matrix.hocon").unwrap(), state(true))
    val count = ui.signal(0u64)
    var saw_heart = false
    var saw_diagonal = false
    for frame in 0..<160
        desktop_tick(d, virt.core0(), image.view(), 0, count, "unused.png")
        val rows = virt.display_segments("matrix")
        if rows[0] == 10 && rows[1] == 31 && rows[2] == 31 && rows[3] == 14 && rows[4] == 4 then saw_heart = true
        if rows[0] == 1 && rows[1] == 2 && rows[2] == 4 && rows[3] == 8 && rows[4] == 16 then saw_diagonal = true
    assert(!d.current.read().stopped, d.current.read().notice)
    assert(saw_heart && saw_diagonal, s"heart=$saw_heart diagonal=$saw_diagonal")
    virt.boot(virt.core0(), image.view())
    val blank = virt.display_segments("matrix")
    for row in 0..<5 do assert(blank[row] == 0)

@test("LED matrix: GPIO PWM brightness follows 0, 25, 50, 75 and 100 percent on-time")
matrix_duty()
    val columns: [8]int = [5,6,7,8,9,-1,-1,-1]
    val rows: [8]int = [0,1,2,3,4,-1,-1,-1]
    for duty in [0u64,25u64,50u64,75u64,100u64]
        var model = scan.display(5, true, 100, columns, rows)
        if duty > 0 then scan.observe(&model, 1 | (30 << 5), 1023, 0)
        scan.observe(&model, 31 << 5, 1023, duty)
        val levels = scan.brightness(model, 100)
        assert(levels[0] == u8(duty * 255 / 100), s"duty=$duty brightness=${levels[0]}")
        for i in 1..<64 do assert(levels[i] == 0)
        assert(scan.brightness(model, 100)[0] == levels[0], "UI reads do not alter the duty calculation")
        assert(scan.brightness(model, 1000)[0] == 0, "stopped refresh eventually goes dark")
    var continuous = scan.display(5, true, 100, columns, rows)
    scan.observe(&continuous, 1 | (30 << 5), 1023, 0)
    assert(scan.brightness(continuous, 1000000)[0] == 255, "continuous drive survives large time jumps")
    scan.observe(&continuous, 31 << 5, 1023, 1000000)
    assert(scan.brightness(continuous, 1000200)[0] == 0)
    scan.reset(&continuous)
    assert(scan.brightness(continuous, 0)[0] == 0)
