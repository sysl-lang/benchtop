module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.sdl3 as sdl

@test("headphone playback: SDL receives stereo frames and mute clears both queued channels")
stereo_playback()
    sdl.set_main_ready()
    assert(sdl.set_hint("SDL_AUDIO_DRIVER", "dummy"))
    val d = desktop(open_scene("boards/stm32h747-disco.hocon").unwrap(), true)
    val m = d.session.board()
    assert(virt.board_named(m, "stm32h747-disco").is_ok())
    val guest = embed("../../../../examples/touch/delay-disco.elf")
    virt.boot(m, virt.image_of(m, guest).unwrap().view())
    virt.start_workers(m).unwrap()
    defer virt.stop_workers(m)
    virt.submit_workers(m,150000000)
    virt.wait_workers(m)
    val player = audio_player(m)
    defer close_audio(m, player)
    assert(player.channels == 2 && player.stream.is_some() && player.recording.is_some(), player.error)
    for i in 0..<8
        virt.submit_workers(m,2400000)
        virt.wait_workers(m)
        audio_frame(player, d)
    assert(player.error.is_empty())
    assert(player.stream.unwrap().queued() <= 48000 * 2 * 4 / 10)
    d.sound_muted.set(true)
    audio_frame(player, d)
    assert(player.paused && player.stream.unwrap().queued() == 0)
