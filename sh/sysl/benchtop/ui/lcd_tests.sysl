module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.parts.hd44780 as lcd
import sh.sysl.ui as ui

private val LCD_GUEST = embed("../../../../examples/visual/demo.elf")

@test("LCD firmware: real GPIO nibbles write Hello from Benchtop while ADC and seven-segment keep working")
lcd_firmware()
    val d = desktop(open_scene("workbench").unwrap(), true)
    val m = d.session.board()
    assert(virt.board_named(m, "workbench").is_ok())
    virt.open_console(m)
    virt.capture_bounded(m, 256)
    val image = virt.image_of(m, LCD_GUEST).unwrap()
    virt.boot(m, image.view())
    val count = ui.signal(0u64)
    for frame in 0..<120 do desktop_tick(d, image.view(), 0, count, "unused.png")
    assert(!d.session.stopped, d.current.read().notice.text)
    val model = virt.lcd_state(m, "lcd").unwrap()
    assert(model.enabled, s"LCD off: four=${model.four_bit}, half=${model.half}, address=${model.address}, time=${model.time}, until=${model.until}, GPIO=${virt.panel_output_latch(m)}")
    val message = "Hello from Benchtop!".bytes
    for col in 0..<20
        assert(lcd.character(model, col, 0) == message[usize(col)], s"LCD column $col: ${lcd.character(model, col, 0)}")

    assert(!d.session.stopped &&virt.output(m).view().len == 0)
    d.pots.at(0).position.set(10000)
    for frame in 0..<3 do desktop_tick(d, image.view(), 0, count, "unused.png")
    val segments = virt.display_segments(m, "readout")
    assert(segments[0] == 0x66 && segments[1] == 0x3F && segments[2] == 0x6F && segments[3] == 0x6D)
    virt.boot(m, image.view())
    val reset = virt.lcd_state(m, "lcd").unwrap()
    assert(!reset.enabled && reset.ram[0] == 32 && !reset.four_bit)
