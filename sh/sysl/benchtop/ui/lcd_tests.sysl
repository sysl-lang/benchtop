module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.parts.hd44780 as lcd
import sh.sysl.ui as ui

private val LCD_GUEST = embed("../../../../examples/visual/demo.elf")

@test("LCD firmware: real GPIO nibbles write Hello from Benchtop while ADC and seven-segment keep working")
lcd_firmware()
    assert(virt.board_named("workbench").is_ok())
    virt.open_console()
    virt.capture_bounded(256)
    val image = virt.image_of(LCD_GUEST).unwrap()
    virt.boot(virt.core0(), image.view())
    val d = desktop(open_scene("workbench").unwrap(), state(true))
    val count = ui.signal(0u64)
    for frame in 0..<120 do desktop_tick(d, virt.core0(), image.view(), 0, count, "unused.png")
    assert(!d.current.read().stopped, d.current.read().notice)
    val model = virt.lcd_state("lcd").unwrap()
    assert(model.enabled, s"LCD off: four=${model.four_bit}, half=${model.half}, address=${model.address}, time=${model.time}, until=${model.until}, GPIO=${virt.panel_output_latch()}")
    val message = "Hello from Benchtop!".bytes
    for col in 0..<20
        assert(lcd.character(model, col, 0) == message[usize(col)], s"LCD column $col: ${lcd.character(model, col, 0)}")
        assert(lcd.character(model, col, 1) == 32)
    assert(!d.current.read().stopped && virt.output().len == 0)
    d.pots.at(0).position.set(10000)
    for frame in 0..<3 do desktop_tick(d, virt.core0(), image.view(), 0, count, "unused.png")
    val segments = virt.display_segments("readout")
    assert(segments[0] == 0x66 && segments[1] == 0x3F && segments[2] == 0x6F && segments[3] == 0x6D)
    virt.boot(virt.core0(), image.view())
    val reset = virt.lcd_state("lcd").unwrap()
    assert(!reset.enabled && reset.ram[0] == 32 && !reset.four_bit)
