module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.parts.ssd1306 as oled
import sh.sysl.benchtop.parts.hd44780 as lcd
import sh.sysl.ui as ui

private val OLED_GUEST = embed("../../../../examples/visual/demo.elf")

@test("SSD1306 OLED firmware: SPI pixels show knob input while ADC, LCD and scanned digits keep running")
oled_firmware()
    val d = desktop(open_scene("workbench").unwrap(), true)
    val m = d.session.board()
    assert(virt.board_named(m, "workbench").is_ok())
    virt.open_console(m)
    virt.capture_bounded(m, 256)
    val image = virt.image_of(m, OLED_GUEST).unwrap()
    virt.boot(m, image.view())
    val count = ui.signal(0u64)
    for frame in 0..<300 do desktop_tick(d, image.view(), 0, count, "unused.png")
    assert(!d.session.stopped, d.current.read().notice.text)
    var model = virt.oled_state(m, "oled").unwrap()
    assert(model.enabled && model.mode == 0)
    assert(oled.pixel(model, 4, 30) && oled.pixel(model, 123, 30))
    assert(oled.pixel(model, 20, 35) && !oled.pixel(model, 100, 35))
    val title = model.ram[180] // 'K' in KNOB, first column of page 1.
    assert(title == 127)
    for position in [0, 10000]
        d.pots[0].position.set(position)
        for frame in 0..<150 do desktop_tick(d, image.view(), 0, count, "unused.png")
        assert(!d.session.stopped, d.current.read().notice.text)
        model = virt.oled_state(m, "oled").unwrap()
        assert(oled.pixel(model, 20, 35) == (position != 0))
        assert(oled.pixel(model, 100, 35) == (position != 0))
        assert(model.ram[180] == title)
    val greeting = virt.lcd_state(m, "lcd").unwrap()
    for col in 0..<20 do assert(lcd.character(greeting, col, 0) == "Hello from Benchtop!".bytes[usize(col)])
    val digits = virt.display_segments(m, "readout")
    assert(digits[0] == 0x66 && digits[1] == 0x3F && digits[2] == 0x6F && digits[3] == 0x6D)
    assert(virt.output(m).view().len == 0)
    virt.boot(m, image.view())
    assert(!virt.oled_state(m, "oled").unwrap().enabled && virt.oled_state(m, "oled").unwrap().ram[180] == 0)

@test("SSD1306 OLED look: a lit glass is one solid block of its colour at whole and fractional steps, each pixel's edges on whole image pixels")
oled_raster_has_no_seams()
    var d = oled.display()
    d.enabled = true
    d.entire = true
    for step in [1.0, 2.0, 1.98, 2.77, 0.66]
        val (width, height) = (int((128.0 * step).ceil()), int((64.0 * step).ceil()))
        val image = oled_raster(d, width, height, step).unwrap()
        val bytes = image.pixels.data()
        val covered = (int(128.0 * step), int(64.0 * step))
        for y in 0..<covered.1
            for x in 0..<covered.0
                val i = usize(y * image.width() + x) * 4
                assert(bytes[i] == 0xFF && bytes[i + 1] == 0xE9 && bytes[i + 2] == 0x9B && bytes[i + 3] == 255, s"step $step: a seam at ($x, $y)")
    // One lit pixel covers exactly its own block and nothing beside it.
    d.entire = false
    d.ram[0] = 1
    val image = oled_raster(d, 256, 128, 2.0).unwrap()
    val bytes = image.pixels.data()
    for (x, y, lit) in [(0, 0, true), (1, 1, true), (2, 0, false), (0, 2, false)]
        assert((bytes[usize(y * image.width() + x) * 4 + 3] == 255) == lit, s"($x, $y)")
