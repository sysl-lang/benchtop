module sh.sysl.benchtop.ui

import sh.sysl.ui as ui
import sh.sysl.benchtop.{Part, part_whole}
import sh.sysl.benchtop.parts.hd44780 as lcd
import sh.sysl.benchtop.virt as virt
import sysl.math.{min, max}

private[ui] draw_lcd(c: *ui.Canvas, r: ui.Rect, p: Part, name: string, live: bool)
    c.fill(r, 0x183F36, 5)
    c.stroke(r, 0x668C6F, 1, 5)
    val screen = ui.Rect(r.x + 10, r.y + 12, max(1, r.w - 20), max(1, r.h - 24))
    c.fill(screen, 0xA5BE63, 3)
    val columns = int(part_whole(p, "columns", 20))
    val rows = int(part_whole(p, "rows", 2))
    val state = if live then virt.lcd_state(name) else None
    val cell_w = max(1, (screen.w - 8) / columns)
    val cell_h = max(1, (screen.h - 6) / rows)
    val dot = max(1, min(cell_w / 5, cell_h / 8))
    c.clip(screen)
    for row in 0..<rows
        for col in 0..<columns
            val glyph = state match
                Some(d) -> lcd.glyph(d, lcd.character(d, col, row))
                None -> [0u8; 5]
            val x = screen.x + 4 + col * cell_w + max(0, (cell_w - 5 * dot) / 2)
            val y = screen.y + 3 + row * cell_h
            for gx in 0..<5
                for gy in 0..<8
                    c.fill(ui.Rect(x + gx * dot, y + gy * dot, max(1, dot - 1), max(1, dot - 1)),
                        if (glyph[gx] & (1u8 << u32(gy))) != 0 then 0x253A21 else 0x9BB65D)
    c.unclip()
    label(c, ui.Rect(r.x + 8, r.y - 13, r.w, 13), s"${p.reference} · HD44780", MUTED, 9)
