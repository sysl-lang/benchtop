module sh.sysl.benchtop.ui
@tests

// The window's words for each board: the subtitle is the board's name, the inspector's first two lines
// name the chip and its cores (a product's those of its boards), and the footer lists only the
// controls the board has before the keys every board has.

import sh.sysl.benchtop.{library, load}
import sh.sysl.parsing.source_of

private val ALWAYS = "Space pause · N step · R reset · S save"

// A product of a Pico and a Pico 2, neither shown whole.
private val MIXED = """
    product {
      name = "Mixed"
      boards {
        a { board = pico }
        b { board = pico2 }
      }
      view {
        size = [200, 100]
        elements {
          title { text = "Mixed", at = [10, 10], size = [100, 20] }
        }
      }
    }
    """

private scene_of(text: string) -> Scene
    val got = load(source_of("t.hocon", text), library())
    assert(!got.report.has_errors(), got.report.render(source_of("t.hocon", text)))
    scene(got.description, "t.hocon").unwrap()

@test("window text: a board's inspector names its chip and cores, and its subtitle is the board's name")
board_heading()
    val pico2 = open_scene("pico2").unwrap()
    assert(pico2.name == "Raspberry Pi Pico 2", pico2.name)
    assert(pico2.heading == "rp2350" && pico2.detail == "cortex-m33 + cortex-m33", s"${pico2.heading} / ${pico2.detail}")
    val disco = open_scene("stm32h747-disco").unwrap()
    assert(disco.name == "STM32H747I-DISCO", disco.name)
    assert(disco.heading == "STM32H747XIH6", disco.heading)
    assert(disco.detail == "cortex-m7 + cortex-m4", disco.detail)

@test("window text: a product's inspector names its board's chip and cores, or its boards' chips and names")
product_heading_lines()
    val kit = open_scene("boards/pico-breadboard-kit.hocon").unwrap()
    assert(kit.name == "Pico Breadboard Kit", kit.name)
    assert(kit.heading == "rp2040" && kit.detail == "cortex-m0plus + cortex-m0plus", s"${kit.heading} / ${kit.detail}")
    val clock = open_scene("testdata/rp-parts/pico2-oled-clock.hocon").unwrap()
    assert(clock.heading == "rp2350" && clock.detail == "cortex-m33 + cortex-m33", s"${clock.heading} / ${clock.detail}")
    val mixed = scene_of(MIXED)
    assert(mixed.heading == "rp2040 + rp2350", mixed.heading)
    assert(mixed.detail == "Raspberry Pi Pico + Raspberry Pi Pico 2", mixed.detail)
    for s in [kit, clock, mixed]
        assert(!s.heading.contains("PRODUCT") && !s.detail.contains("BOARD"), s"${s.heading} / ${s.detail}")

@test("window text: a board with no inputs lists only the keys every board has")
hint_without_inputs()
    for which in ["pico2", "pico2w", "pico-plus2"]
        val hint = controls_hint(open_scene(which).unwrap(), 0)
        assert(hint == ALWAYS, s"$which: $hint")

@test("window text: buttons are listed with the keys bound to them, a dial and an instrument with theirs")
hint_with_buttons()
    val bench = open_scene("workbench").unwrap()
    val plain = controls_hint(bench, 0)
    assert(plain == s"Hold 1 / 2 or click a button · Drag a dial to turn it · $ALWAYS", plain)
    val plotted = controls_hint(bench, 1)
    assert(plotted == s"Hold 1 / 2 or click a button · Drag a dial to turn it · The plot icon opens an instrument · $ALWAYS", plotted)
    val disco = controls_hint(open_scene("stm32h747-disco").unwrap(), 0)
    assert(disco == s"Hold 1 / 2 or click a button · Click the screen to touch it · $ALWAYS", disco)

@test("window text: a joystick is listed with its keys, or without where none is bound, and a touch screen after it")
hint_with_joystick_and_touch()
    val kit = controls_hint(open_scene("boards/pico-breadboard-kit.hocon").unwrap(), 0)
    assert(kit == s"Hold 1 / 2 or click a button · Drag the joystick or use up / down / left / right · Click the screen to touch it · $ALWAYS", kit)
    val stick = controls_hint(open_scene("boards/joystick.hocon").unwrap(), 0)
    assert(stick.starts_with("Drag the joystick · ") && stick.ends_with(ALWAYS), stick)
