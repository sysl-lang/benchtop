module sh.sysl.benchtop.ui

import sysl.math.{min, max}

/** Wall-time pacing, retaining fractional ticks. Stalls are capped rather than
 * producing unbounded catch-up work. Headless pumping stays deterministic.
 */
struct GuestPacer
    fraction: real

    budget(*self, elapsed: real, hz: u64) -> u64
        val due = elapsed.min(0.05).max(0.0) * real(hz) + self.fraction
        val ticks = u64(due)
        self.fraction = due - real(ticks)
        ticks

guest_pacer() -> &GuestPacer = GuestPacer(0.0)
