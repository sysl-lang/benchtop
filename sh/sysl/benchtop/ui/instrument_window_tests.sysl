module sh.sysl.benchtop.ui
@tests

import sh.sysl.sdl3 as sdl
import sh.sysl.sdl3.c as native
import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.instrument as plot
import sysl.raw.ptr_cast

private child_key(id: u32, scan: i32) -> sdl.Event
    var e = native.KeyboardEvent(sdl.EVENT_KEY_DOWN, 0, 0, id, 0, scan, 0, 0, 0, true, false, [0; 90])
    val p: *native.Event = ptr_cast(&e)
    sdl.Event(p[0])

private child_close(id: u32) -> sdl.Event
    var e = native.WindowEvent(sdl.EVENT_WINDOW_CLOSE_REQUESTED, 0, 0, id, 0, 0, [0; 100])
    val p: *native.Event = ptr_cast(&e)
    sdl.Event(p[0])

@test("plot instrument: native windows resize, isolate controls, close and reopen without stopping firmware")
native_window()
    sdl.set_main_ready()
    assert(sdl.set_hint(sdl.HINT_VIDEO_DRIVER, "dummy"))
    assert(sdl.init(sdl.INIT_VIDEO))
    exercise_native_window()
    sdl.quit()

private exercise_native_window()
    val d = instrument_desktop()
    val i = d.instruments.at(0)
    instrument_tick(d)
    val retired = virt.core0().retired
    val length = i.plot.samples.len()
    i.opening = true
    instrument_windows(d)
    assert(i.window.is_some() && !i.opening)
    val w = i.window.unwrap()
    val first = w.window.id()
    assert(w.width > 0 && w.height > 0)
    assert(w.window.set_size(720, 400))
    instrument_windows(d)
    assert(w.width == 720 && w.height == 400)
    assert(instrument_event(d, child_key(first, sdl.SCANCODE_SPACE)))
    assert(i.plot.held && !d.current.read().paused)
    assert(!instrument_event(d, child_key(first + 100, sdl.SCANCODE_SPACE)))
    assert(instrument_event(d, child_key(first, sdl.SCANCODE_SPACE)))
    assert(!i.plot.held)
    assert(instrument_event(d, child_close(first)))
    assert(i.window.is_none() && !d.current.read().stopped)
    assert(i.plot.samples.len() == length && virt.core0().retired == retired)
    i.opening = true
    instrument_windows(d)
    assert(i.window.is_some() && i.window.unwrap().window.id() != first)
    val second = i.window.unwrap().window.id()
    assert(instrument_event(d, child_key(second, sdl.SCANCODE_C)))
    assert(i.plot.samples.len() == 0)
    close_instruments(d)
    assert(i.window.is_none())
