module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.parts.ssd1306 as oled
import sh.sysl.benchtop.parts.hd44780 as lcd
import sh.sysl.ui as ui

private val TFT_GUEST = embed("../../../../examples/visual/demo.elf")

private frame_pixel(frame: virt.TftFrame, x: int, y: int) -> u32 = frame.pixels.at(usize(y * frame.width + x))

@test("ST7789 TFT firmware: RGB565 graphic and partial knob updates share SPI with OLED while other parts keep running")
tft_firmware()
    val d = desktop(open_scene("workbench").unwrap(), true)
    val m = d.session.board()
    assert(virt.board_named(m, "workbench").is_ok())
    virt.open_console(m)
    virt.capture_bounded(m, 256)
    val image = virt.image_of(m, TFT_GUEST).unwrap()
    virt.boot(m, image.view())
    val count = ui.signal(0u64)
    for frame in 0..<2200 do desktop_tick(d, image.view(), 0, count, "unused.png")
    assert(!d.session.stopped, d.current.read().notice.text)
    var frame = virt.tft_frame(m, "tft").unwrap()
    assert(frame.width == 240 && frame.height == 240)
    assert(frame_pixel(frame, 20, 90) == 0xFF0000 && frame_pixel(frame, 70, 90) == 0xFFFF00 && frame_pixel(frame, 105, 90) == 0x00FF00)
    assert(frame_pixel(frame, 239, 239) == 0x080818, "the first complete frame reaches its final pixel")
    assert(frame_pixel(frame, 40, 160) == 0xFF0000 && frame_pixel(frame, 200, 160) == 0x080818)
    for position in [0, 10000]
        d.pots.at(0).position.set(position)
        for sample in 0..<700 do desktop_tick(d, image.view(), 0, count, "unused.png")
        assert(!d.session.stopped, d.current.read().notice.text)
        frame = virt.tft_frame(m, "tft").unwrap()
        assert(frame_pixel(frame, 200, 160) == (if position == 0 then 0x080818u32 else 0x00FF00))
        assert(frame_pixel(frame, 20, 90) == 0xFF0000, "partial windows preserve color bars")
        assert(oled.pixel(virt.oled_state(m, "oled").unwrap(), 100, 35) == (position != 0))
    val greeting = virt.lcd_state(m, "lcd").unwrap()
    for col in 0..<20 do assert(lcd.character(greeting, col, 0) == "Hello from Benchtop!".bytes[usize(col)])
    val digits = virt.display_segments(m, "readout")
    assert(digits[0] == 0x66 && digits[1] == 0x3F && digits[2] == 0x6F && digits[3] == 0x6D)
    assert(virt.output(m).view().len == 0)
    // Frame snapshots own their pixels and are stable across a subsequent board reset.
    virt.boot(m, image.view())
    assert(frame_pixel(frame, 20, 90) == 0xFF0000)
    assert(frame_pixel(virt.tft_frame(m, "tft").unwrap(), 20, 90) == 0)
