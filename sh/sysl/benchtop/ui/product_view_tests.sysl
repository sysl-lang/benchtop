module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.{library, load}
import sh.sysl.parsing.source_of
import sh.sysl.plutovg as vg
import sh.sysl.ui as ui
import sysl.fs.make_dir_all

// Two Picos in one product: one shown whole as it stands, one turned a quarter, beside a caption.
private val TWO_PICOS = """
    product {
      name = "Two Picos"
      boards {
        a { board = pico }
        b { board = pico }
      }
      view {
        size = [648, 448]
        background = black
        elements {
          left  { show = a, at = [20, 20], label = Upright }
          right { show = b, at = [220, 20], look { rotate = 90 } }
          title { text = "Two Picos", at = [220, 300], size = [200, 24] }
        }
      }
    }
    """

private two_picos() -> &Desktop
    val got = load(source_of("t.hocon", TWO_PICOS), library())
    assert(!got.report.has_errors(), got.report.render(source_of("t.hocon", TWO_PICOS)))
    desktop(scene(got.description, "t.hocon").unwrap(), false)

// The colour at `x, y` of the board panel's own pixels.
private at(s: &vg.Surface, r: ui.Rect, x: int, y: int) -> u32
    val t = board_transform(r)
    val i = usize(int(t.y + f32(y) * t.scale) * s.stride() + int(t.x + f32(x) * t.scale) * 4)
    val bytes = s.data()
    u32(bytes[i]) | (u32(bytes[i + 1]) << 8) | (u32(bytes[i + 2]) << 16)

@test("visual product view: a board shown whole is drawn as its own view, upright or turned, and its parts are hit")
product_view_pixels()
    val d = two_picos()
    val s = rasterize(d).unwrap()
    val r = d.board_rect.read()

    // The product's own background, then each Pico's board and the USB socket at its top edge. The
    // board is 40 px in from its drawing's left edge and 7 px down; the point 4 mm in and 40 mm down
    // is bare solder mask, and the socket's shell is 8 mm in and 1.6 mm down.
    val mask = parse_color("#2f7a45")

    assert(at(s, r, 10, 10) == parse_color("black"), s"${at(s, r, 10, 10)}")
    assert(at(s, r, 20 + 40 + 20, 20 + 7 + 200) == mask, s"${at(s, r, 80, 227)}")
    assert(at(s, r, 20 + 40 + 40, 20 + 7 + 8) == PCB_TIN, s"${at(s, r, 100, 35)}")

    // Turned clockwise, the right Pico lies on its side with the USB socket on its right edge: the
    // drawing's point x, y is at 283 - y, x.
    assert(at(s, r, 220 + 283 - 207, 20 + 60) == mask, s"${at(s, r, 296, 80)}")
    assert(at(s, r, 220 + 283 - 15, 20 + 80) == PCB_TIN, s"${at(s, r, 488, 100)}")
    assert(at(s, r, 220 + 283 - 207, 20 + 80) != PCB_TIN)

    // A click on a board's LED finds the board's part, as the product names it.
    assert(part_at(d.scene, r, int(board_transform(r).x) + 20 + 64, int(board_transform(r).y) + 20 + 31) == "a.led")
    assert(part_at(d.scene, r, int(board_transform(r).x) + 80, int(board_transform(r).y) + 227) == "")

private window_names(s: Scene) -> string
    var out = ""
    for (name, _) in window_parts(s)
        if !out.is_empty() then out += " "
        out += name
    out

private knob_names(d: &Desktop) -> string
    var out = ""
    for (e, part) in knob_elements(d.scene, pot_names(d))
        if !out.is_empty() then out += " "
        out += s"${e.name}=$part"
    out

// The scene of a product with no view, whose boards are `boards` and which ends with `more`.
private viewless_scene(boards: string, more: string = "") -> Result[Scene, string]
    val text = s"product {\n  name = k\n  boards {\n$boards  }\n$more}\n"
    val got = load(source_of("kit.hocon", text), library())
    assert(!got.report.has_errors(), got.report.render(source_of("kit.hocon", text)))
    scene(got.description, "kit.hocon")

@test("visual product view: a product with no view shows its boards side by side, and one whose boards have none is refused by file")
product_side_by_side_scene()
    val s = viewless_scene("    p { board = pico }\n    w { board = workbench }\n").unwrap()
    assert(s.view.width == 24 + 185 + 24 + 720 + 24 && s.view.height == 24 + 770 + 24 && s.view.background == "black")
    val d = desktop(s, false)
    val surface = rasterize(d).unwrap()
    val r = d.board_rect.read()
    val t = board_transform(r)

    // The margin is the product's black, the first board starts 24 px in, and its LED is hit there.
    assert(at(surface, r, 10, 10) == parse_color("black") && at(surface, r, 24 + 60, 24 + 207) == parse_color("#2f7a45"), s"${at(surface, r, 84, 231)}")
    assert(part_at(d.scene, r, int(t.x) + 24 + 60 + 4, int(t.y) + 24 + 29 + 2) == "p.led")
    for e in s.view.elements do if e.name == "w.button1" then assert(e.x == 24 + 185 + 24 + 537 && e.y == 24 + 162)

    val why = viewless_scene("    a { board = virt }\n    b { board = virt4 }\n").unwrap_err()
    assert(why.contains("kit.hocon") && why.contains("the product `k` has no view, and none of its boards has one"), why)

@test("visual product view: a board's key presses that board's button; the product's own binding of the key wins")
product_board_keys()
    val d = desktop(viewless_scene("    w { board = workbench }\n").unwrap(), false)
    var st = state()
    assert(key_input(d.scene, &st, "2", true))
    press_inputs(d.scene, st, d.session)
    assert(d.session.pressed("button2") && !d.session.pressed("button1"))

    // The product takes "2" for the first button: the board's binding of it is gone.
    val own = desktop(viewless_scene("    w { board = workbench }\n", "  input { keys { \"2\" = w.button1 } }\n").unwrap(), false)
    var held = state()
    assert(key_input(own.scene, &held, "2", true))
    press_inputs(own.scene, held, own.session)
    assert(own.session.pressed("button1") && !own.session.pressed("button2"))
    assert(key_input(own.scene, &held, "1", true))

@test("visual product view: a board shown whole brings its potentiometer and its parts to the panel; the product wins a name or a region")
product_board_pots()
    // The workbench's volume, as the product names it, turns the board's own input.
    val d = desktop(viewless_scene("    w { board = workbench }\n").unwrap(), false)
    assert(d.pots.len() == 1 && d.pots[0].name == "w.volume" && d.pots[0].part == "volume")
    d.pots[0].position.set(1234)
    sample_inputs(d)
    assert(d.session.position("volume") == 1234, s"${d.session.position("volume")}")
    val names = window_names(d.scene)
    assert(names.contains("w.volume") && names.contains("w.button1"), names)
    assert(knob_names(d) == "w.volume=w.volume", knob_names(d))

    // The product's own `volume` takes the name: the board's is left out of the knobs and the panel.
    val pot = "  parts { volume { part = potentiometer, wire { wiper = pico.GP26 } } }\n"
    val clash = desktop(viewless_scene("    w { board = workbench }\n    pico { board = pico }\n", pot).unwrap(), false)
    assert(clash.pots.len() == 1 && clash.pots[0].name == "volume", s"${clash.pots.len()}")
    assert(!window_names(clash.scene).contains("w.volume") && window_names(clash.scene).contains("w.button1"), window_names(clash.scene))

    // The product's own knob over the board's: the region is the product's. Clear of it, both turn.
    val rv = "  parts { rv { part = potentiometer, wire { wiper = pico.GP26 } } }\n"
    for (at, want) in [("[330, 320]", "knob=rv"), ("[720, 720]", "knob=rv w.volume=w.volume")]
        val view = s"  view { size = [800, 800], elements { w { show = w, at = [0, 0] }, knob { show = rv, at = $at } } }\n"
        val region = desktop(viewless_scene("    w { board = workbench }\n    pico { board = pico }\n", rv + view).unwrap(), false)
        assert(knob_names(region) == want, knob_names(region))

@test("visual board: the Pico 2 W is drawn from its mechanical drawing, its pads gold with holes, the RP2350 black, the radio under its can and the antenna's keep-out at the far end")
board_pico2w_pixels()
    val d = desktop(open_scene("pico2w").unwrap(), false)
    val s = rasterize(d).unwrap()
    val r = d.board_rect.read()
    val mask = parse_color("#2f7a45")

    make_dir_all("target").unwrap()
    save_desktop(d, "target/pico2w-board.png").unwrap()

    // Pin 1's castellated pad, gold from the board's edge, with its hole 1.61 mm in.
    assert(at(s, r, 42, 14) == PCB_GOLD && at(s, r, 48, 14) == PCB_HOLE, s"${at(s, r, 42, 14)} ${at(s, r, 48, 14)}")
    // The RP2350, 7 mm square, 7 mm in and 20.5 mm down; bare mask beside it.
    assert(at(s, r, 78, 113) == PCB_PACKAGE && at(s, r, 60, 130) == mask, s"${at(s, r, 78, 113)} ${at(s, r, 60, 130)}")
    // The CYW43439's shield can, 4.4 to 16.6 mm across and 32.6 to 43 mm down.
    assert(at(s, r, 92, 196) == PCB_TIN, s"${at(s, r, 92, 196)}")
    // The antenna's keep-out, bare of copper, from under the can to the far edge.
    assert(at(s, r, 125, 230) == blend_color(mask, PCB_SILK, 0.25), s"${at(s, r, 125, 230)}")
    // Under the board, the panel: the Pico 2 W has no debug pads on its bottom edge.
    assert(at(s, r, 92, 262 + 4) != mask)
