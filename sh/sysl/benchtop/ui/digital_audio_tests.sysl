module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.sdl3 as sdl
import sh.sysl.ui as ui
import sysl.env.vars
import sysl.math.Float
import sysl.buf.buf

private val DIGITAL_GUEST = embed("../../../../examples/audio/demo.elf")

private digital_desktop() -> &Desktop
    val d = desktop(open_scene("boards/audio.hocon").unwrap(), true)
    val m = d.session.board()
    assert(virt.board_named(m, "boards/audio.hocon").is_ok())
    virt.open_console(m)
    virt.capture_bounded(m, 256)
    virt.boot(m, virt.image_of(m, DIGITAL_GUEST).unwrap().view())
    d

// The sound `m` has played up to its core 0's clock.
private sound_now(m: *virt.Machine) -> sysl.buf.Buf[f32] = virt.take_sound(m, cpu.clock(virt.core0(m), virt.core0(m).retired))

@test("digital audio firmware: button plays PCM, synthetic microphone drives GPIO meter, and reset clears audio")
digital_firmware()
    val d = digital_desktop()
    val m = d.session.board()
    val count = ui.signal(0u64)
    var st = d.current.read()
    key_input(d.scene, &st, "1", true)
    d.current.set(st)
    var loud = false
    var meter = false
    val input: [800]f32 = [0.75;800]
    for frame in 0..<30
        virt.feed_microphone(m, input[..])
        desktop_tick(d, [], 0, count, "", 120000)
        for sample in sound_now(m)
            if sample.abs() > 0.01 then loud = true
        if (virt.panel_output_latch(m) & 61) == 61 then meter = true
    assert(!d.session.stopped, d.current.read().notice.text)
    assert(loud && meter, s"speaker=$loud meter=$meter")
    st = d.current.read()
    key_input(d.scene, &st, "1", false)
    d.current.set(st)
    for frame in 0..<5 do desktop_tick(d, [], 0, count, "", 120000)
    val image = virt.image_of(m, DIGITAL_GUEST).unwrap()
    virt.boot(m, image.view())
    assert(m.devices.i2s.controller.with(c -> c.tx.is_empty() && c.rx.is_empty() && c.input.is_empty()))

@test("digital audio MMIO: word alignment, unknown registers and frame FIFO state")
digital_registers()
    val d = digital_desktop()
    val first = d.session.board()
    val c = virt.core0(first)
    cpu.store32(c, 0x50000400, 3)
    virt.feed_microphone(first, [0.5f32])
    c.retired = 250
    assert(cpu.load32(c, 0x50000418) == 1)
    assert(cpu.load32(c, 0x5000040C) == 0x40000000)
    cpu.store8(c, 0x50000408, 1)
    assert(c.stop == cpu.Stop.Fault)
    val again = digital_desktop()
    val fresh = virt.core0(again.session.board())
    cpu.load32(fresh, 0x50000420)
    assert(fresh.stop == cpu.Stop.Unmapped)

@test("native microphone: SDL recording reaches firmware input and clears stale capture on pause")
native_capture()
    var live = false
    for entry in vars() do if entry.0 == "BENCHTOP_MIC_LIVE" && entry.1 == "1" then live = true
    sdl.set_main_ready()
    assert(sdl.set_hint("SDL_AUDIO_DRIVER", if live then "coreaudio" else "dummy"))
    val d = digital_desktop()
    val m = d.session.board()
    val player = audio_player(m)
    defer close_audio(m, player)
    assert(player.recording.is_some(), player.error)
    if live then assert(player.driver == "coreaudio")
    sdl.delay(80)
    assert(player.recording.unwrap().available() > 0, "recording stream supplies PCM frames")
    audio_frame(player, d)
    assert(m.devices.i2s.controller.with(c -> !c.input.is_empty()))
    d.session.paused = true
    audio_frame(player, d)
    assert(m.devices.i2s.controller.with(c -> c.input.is_empty()))

@test("native PCM speaker: SDL plays guest samples and clears its queue on mute, pause and reset")
native_pcm()
    var live = false
    for entry in vars() do if entry.0 == "BENCHTOP_AUDIO_LIVE" && entry.1 == "1" then live = true
    sdl.set_main_ready()
    assert(sdl.set_hint("SDL_AUDIO_DRIVER", if live then "coreaudio" else "dummy"))
    val d = digital_desktop()
    val player = audio_player(d.session.board())
    defer close_audio(d.session.board(), player)
    assert(player.stream.is_some(), player.error)
    if live then assert(player.driver == "coreaudio")
    exercise_playback(d, player, live)

@test("digital audio controls: button caption is a hold target and microphone meter responds below saturation")
caption_and_meter()
    val d = digital_desktop()
    val m = d.session.board()
    val board = ui.Rect(0, 0, 720, 690)
    assert(part_at(d.scene, board, 140, 350) == "play", "the visible HOLD 1 TO PLAY caption operates the button")
    assert(part_at(d.scene, board, 140, 300) == "play", "the physical button still operates")
    var st = d.current.read()
    st.mouse_part = part_at(d.scene, board, 140, 350)
    d.current.set(st)
    val count = ui.signal(0u64)
    var sounded = false
    val background: [800]f32 = [0.006;800]
    for frame in 0..<15
        virt.feed_microphone(m, background[..])
        desktop_tick(d, [], 0, count, "", 120000)
        for sample in sound_now(m)
            if sample.abs() > 0.05 then sounded = true
    assert(sounded, "mouse hold produces an audible PCM level")
    assert(virt.panel_output_latch(m) == 1, "ordinary background input leaves headroom in the meter")
    val voice: [800]f32 = [0.1;800]
    for frame in 0..<10
        virt.feed_microphone(m, voice[..])
        desktop_tick(d, [], 0, count, "", 120000)
    assert(virt.panel_output_latch(m) == 13, "voice raises the first three meter LEDs")
    st = d.current.read()
    st.mouse_part = ""
    d.current.set(st)
    val quiet: [800]f32 = [0.0;800]
    var checked_silence: usize = 0
    for frame in 0..<30
        virt.feed_microphone(m, quiet[..])
        desktop_tick(d, [], 0, count, "", 120000)
        val samples = sound_now(m)
        if frame >= 25
            for sample in samples do assert(sample == 0.0, "releasing the button stops PCM output")
            checked_silence += samples.len()
    assert(checked_silence > 0)
    assert(virt.panel_output_latch(m) == 0, "the meter decays after sound stops")

@test("PCM tone quality: firmware produces a 480Hz sine without TX starvation or harmonic noise")
sine_quality()
    val d = digital_desktop()
    val m = d.session.board()
    var st = d.current.read()
    key_input(d.scene, &st, "1", true)
    d.current.set(st)
    val count = ui.signal(0u64)
    for frame in 0..<10
        desktop_tick(d, [], 0, count, "", 120000)
        sound_now(m)
    cpu.store32(virt.core0(m), 0x50000404, 60)
    var samples = buf[f32]()
    for frame in 0..<12
        desktop_tick(d, [], 0, count, "", 120000)
        for sample in sound_now(m) do samples.push(sample)
    assert(samples.len() >= 4800)
    var energy = 0.0
    var sine = 0.0
    var cosine = 0.0
    for i in 0..<4800
        val sample = real(samples.at(usize(i)))
        val angle = real(i) * 6.283185307179586 / 100.0
        energy += sample * sample
        sine += sample * angle.sin()
        cosine += sample * angle.cos()
    val fundamental = 2.0 * (sine * sine + cosine * cosine) / 4800.0
    assert(energy > 1.0 && fundamental / energy > 0.9999, s"480Hz sine purity=${fundamental / energy}")
    assert((cpu.load32(virt.core0(m), 0x50000404) & 4) == 0, "sample generation must keep up with the I2S clock")
