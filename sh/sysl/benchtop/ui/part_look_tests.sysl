module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.*
import sh.sysl.benchtop.virt as virt
import sh.sysl.ui as ui
import sh.sysl.plutovg as vg
import sysl.buf.{Buf, buf}

@test("part looks: every model the board view draws resolves to its own look, and anything else is generic")
plk_models()
    val d = desktop(open_scene("workbench").unwrap(), false)
    for p in d.scene.scope.parts
        val got = look_of(p)
        val expected = p.kind match
            "led" -> PartLook.Lamp(true)
            "button" -> PartLook.Key
            "potentiometer" -> PartLook.Knob
            "seven-segment" -> PartLook.Segments
            "hd44780" -> PartLook.Lcd
            "ssd1306" -> PartLook.Oled
            "st7789" -> PartLook.Tft
            _ -> got
        assert(got == expected, p.kind)
    val stick = desktop(open_scene("boards/joystick.hocon").unwrap(), false)
    assert(look_of(stick.scene.scope.find("stick").unwrap()) == PartLook.Stick && look_of(stick.scene.scope.find("mode").unwrap()) == PartLook.Toggle)
    var odd = d.scene.scope.parts[0]
    odd.kind = "no-such-model"
    assert(look_of(odd) == PartLook.Generic)
    odd.kind = "ws2812"
    assert(look_of(odd) == PartLook.Lamp(false))

@test("part looks: a joystick's drawn knob and the position a pointer asks for invert each other over the whole travel")
plk_stick_geometry()
    val r = ui.Rect(100, 50, 140, 120)
    for (x, y) in [(0, 0), (virt.POSITION_MAX, virt.POSITION_MAX), (5000, 5000), (2500, 7500)]
        val (px, py) = stick_point(r, x, y)
        val (ax, ay) = stick_position(r, px, py)
        assert(ax / 100 == x / 100 && ay / 100 == y / 100, s"$x, $y -> $ax, $ay")
    assert(stick_position(r, -1000, -1000) == (0, 0) && stick_position(r, 9000, 9000) == (virt.POSITION_MAX, virt.POSITION_MAX))
    assert(element_label(ui.Rect(10, 20, 40, 30)) == ui.Rect(10, 55, 100, 22) && element_label(ui.Rect(0, 0, 150, 10)).w == 150)

/** The pixel at (`x`, `y`) of a surface as 0xRRGGBB and its alpha. */
plk_pixel(s: &vg.Surface, x: real, y: real) -> (u32, u32)
    val bytes = s.data()
    val at = int(y) * s.stride() + int(x) * 4
    ((u32(bytes[at + 2]) << 16) | (u32(bytes[at + 1]) << 8) | u32(bytes[at]), u32(bytes[at + 3]))

@test("seven-segment look: lit segments are drawn in the part's colour, unlit ones near the face, the joints and the corner are open")
plk_segment_pixels()
    // Three times a 0.56" digit, so a joint is several pixels wide rather than one.
    val surface = vg.surface(189, 285).unwrap()
    val cv = vg.canvas(surface).unwrap()
    val unlit = blend_color(SEGMENT_FACE, SEGMENT_RED, 0.10)
    val l = digit_layout(189, 285, 3.0 * 0.56 * 25.4 * 5.0)
    var masks = [0u8; 8]
    masks[0] = 0x87
    paint_digits(cv, l, 1, masks, SEGMENT_RED, unlit)
    for bit in 0..<7
        val (x, y) = segment_centre(l, 0, bit)
        val (color, alpha) = plk_pixel(surface, x, y)
        assert(alpha == 255 && color == (if bit < 3 then SEGMENT_RED else unlit), s"segment $bit: $color")
    val (dx, dy, _) = point_dot(l, 0)
    assert(plk_pixel(surface, dx, dy) == (SEGMENT_RED, 255), "the decimal point is lit")
    // Where d and e meet at the lower left: the middle of their joint is a gap, and neither is lit.
    val t = l.stroke + l.gap
    val (jx, jy) = digit_point(l, 0, t / 2.0, l.h - t / 2.0)
    assert(plk_pixel(surface, jx, jy).1 == 0, "the joint between d and e is open")
    // The decimal point is round: the corner of its bounding square is off it.
    val (_, _, radius) = point_dot(l, 0)
    assert(plk_pixel(surface, dx + radius * 0.85, dy + radius * 0.85).1 < 255, "the decimal point's corner is not filled")
    // Unlit is barely off the face: within a tenth of the way to the lit colour.
    assert(unlit != SEGMENT_FACE && ((unlit >> 16) & 255) - ((SEGMENT_FACE >> 16) & 255) < 24)

@test("seven-segment look: a 0.6:1 digit leaned forward 10 degrees, inside its own cell at every digit height")
plk_segment_geometry()
    val l = digit_layout(63, 95, 0.56 * 25.4 * 5.0)
    assert((l.w / l.h - 0.6).abs() < 1e-9 && (l.stroke * 7.5 - l.w).abs() < 1e-9 && (l.gap * 3.0 - l.stroke).abs() < 1e-9)
    val (ax, ay) = segment_centre(l, 0, 0)
    val (gx, gy) = segment_centre(l, 0, 6)
    val (dx, dy) = segment_centre(l, 0, 3)
    assert(ay < gy && gy < dy, "a above g above d")
    val lean = (ax - dx) / (dy - ay)
    assert((lean - 0.17632698).abs() < 0.01, s"the top bar sits right of the bottom one by tan 10°: $lean")
    assert(segment_centre(l, 0, 1).0 > ax && segment_centre(l, 0, 5).0 < ax, "b is right of a, f left of it")
    for inches in [0.36, 0.56, 0.8]
        var p = desktop(open_scene("workbench").unwrap(), false).scene.scope.find("readout").unwrap()
        p.params.push(Param("digit-height", p.params[0].span, Number(inches), p.params[0].span))
        val (height, cw, ch) = digit_cell(p)
        assert((height - inches * 25.4 * 5.0).abs() < 1e-9, s"$height")
        val m = digit_layout(cw, ch, height)
        val (rx, _) = digit_point(m, 0, m.w, 0.0)
        val (px, _, pr) = point_dot(m, 0)
        assert(m.x >= 0.0 && m.y >= 0.0 && m.y + m.h <= real(ch) && rx <= real(cw) && px + pr <= real(cw), s"$inches\" in $cw x $ch")
        assert(m.pitch == real(cw) && (digit_point(m, 1, 0.0, m.h).0 - digit_point(m, 0, 0.0, m.h).0 - real(cw)).abs() < 1e-9, "digits are a cell apart")

@test("seven-segment look: the same part draws the same pixels on two boards, the Pico 2's one digit and the first of the workbench's four")
plk_segment_same_on_every_board()
    var crops: Buf[Buf[u32]] = buf()
    for (file, name) in [("testdata/rp-parts/pico2-parts.hocon", "digit"), ("workbench", "readout")]
        val d = desktop(open_scene(file).unwrap(), false)
        val surface = rasterize(d).unwrap()
        val board = d.board_rect.read()
        var crop: Buf[u32] = buf()
        for e in d.scene.view.elements
            if e.name != name then continue
            assert(e.w == 63 * int(part_whole(d.scene.scope.find(name).unwrap(), "digits", 1)) && e.h == 95, s"$name: ${e.w} × ${e.h}")
            // One cell, clear of the module's rounded corners and rim.
            for y in 6..<89
                for x in 6..<57
                    val (color, _) = plk_pixel(surface, real(board.x + e.x + x), real(board.y + e.y + y))
                    crop.push(color)
        assert(crop.len() == 83 * 51, s"$name: ${crop.len()}")
        crops.push(crop)
    var differ = 0
    for i in 0..<crops[0].len() do if crops[0][i] != crops[1][i] then differ += 1
    assert(differ == 0, s"$differ pixels differ")

/** A part of model `kind` with only `settings`, every other parameter left to its default. */
plk_part(kind: string, settings: []const (string, Setting)) -> Part
    var p = desktop(open_scene("workbench").unwrap(), false).scene.scope.find("readout").unwrap()
    p.kind = kind
    p.params = buf()
    for (name, value) in settings do p.params.push(Param(name, p.name_span, value, p.name_span))
    p

@test("part sizes: every drawn part is its real body at 5 px/mm, and a size variant is a parameter")
plk_part_sizes()
    assert(part_size(plk_part("led", [])) == (25, 25), "a 5 mm LED by default")
    assert(part_size(plk_part("led", [("package", Text("3mm"))])) == (15, 15))
    assert(part_size(plk_part("led", [("package", Text("0805"))])) == (10, 6))
    assert(part_size(plk_part("led", [("package", Text("0603"))])) == (8, 4))
    assert(part_size(plk_part("ws2812", [])) == (25, 25))
    assert(part_size(plk_part("button", [])) == (30, 30) && part_size(plk_part("button", [("body", Text("12mm"))])) == (60, 60))
    assert(part_size(plk_part("reset-button", [])) == (30, 30) && part_size(plk_part("reset-button", [("body", Text("12mm"))])) == (60, 60))
    assert(part_size(plk_part("switch", [])) == (43, 18))
    assert(part_size(plk_part("potentiometer", [])) == (80, 80) && part_size(plk_part("potentiometer", [("body", Text("9mm"))])) == (45, 45))
    assert(part_size(plk_part("joystick", [])) == (130, 130))
    assert(part_size(plk_part("buzzer", [])) == (60, 60) && part_size(plk_part("PS1240P02BT", [])) == (60, 60))
    assert(part_size(plk_part("speaker", [])) == (200, 200) && part_size(plk_part("speaker", [("diameter", Whole(28))])) == (140, 140))
    assert(part_size(plk_part("MAX98357A", [])) == (95, 89) && part_size(plk_part("INMP441", [])) == (89, 64))
    assert(part_size(plk_part("DS3231SN", [])) == (190, 110) && part_size(plk_part("microbit-v2-led-matrix", [])) == (120, 120))
    assert(part_size(plk_part("hd44780", [("columns", Whole(16)), ("rows", Whole(2))])) == (343, 104), "an LCD1602")
    assert(part_size(plk_part("hd44780", [("columns", Whole(20)), ("rows", Whole(2))])) == (414, 104), "an LCD2002")
    assert(part_size(plk_part("hd44780", [("columns", Whole(16)), ("rows", Whole(1))])) == (343, 74), "an LCD1601")
    assert(part_size(plk_part("ssd1306", [])) == (272, 144), "a 0.96\" OLED, two view pixels to a panel pixel")
    assert(part_size(plk_part("ssd1306", [("diagonal", Number(1.3))])) == (363, 189), "a 1.3\" OLED, larger in proportion")
    assert(part_size(plk_part("st7789", [])) == (252, 266) && part_size(plk_part("st7789", [("width", Whole(240)), ("height", Whole(320))])) == (252, 346))
    assert(part_size(plk_part("mipi-dcs-display", [("width", Whole(800)), ("height", Whole(480))])) == (812, 506))
    assert(part_size(plk_part("st7796", [("width", Whole(320)), ("height", Whole(480))])) == (320, 480))
    assert(part_size(plk_part("GT911", [])) == (112, 52) && part_size(plk_part("cyw43439", [])) == (112, 52), "a part with no drawing is a tag")

@test("part sizes: a board's view places each part at the part's own size, the same on every board it is on")
plk_views_use_part_sizes()
    for file in ["workbench", "bench/guest/workbench-ram.hocon", "boards/audio.hocon", "boards/joystick.hocon", "boards/touch.hocon",
                 "boards/h747-cores.hocon", "boards/matrix.hocon", "boards/pico.hocon", "boards/pico2.hocon", "boards/pico2w.hocon",
                 "boards/pico2-riscv.hocon", "boards/pico-breadboard-kit.hocon", "boards/stm32h747-disco.hocon",
                 "boards/stm32h747-spi-sd.hocon", "testdata/rp-parts/pico-parts.hocon", "testdata/rp-parts/pico2-parts.hocon"]
        val d = desktop(open_scene(file).unwrap(), false)
        for e in d.scene.view.elements
            e.shows match
                ShowPart(name) ->
                    val (w, h) = part_size(d.scene.scope.find(name).unwrap())
                    val turned = rotation(e) == 90 || rotation(e) == 270
                    assert((e.w, e.h) == (if turned then (h, w) else (w, h)), s"$file: $name is ${e.w} × ${e.h}, not $w × $h")
                _ -> ()
    // The same LED on the Pico's own view and on the breadboard kit that carries a Pico.
    val pico = desktop(open_scene("boards/pico.hocon").unwrap(), false).scene.view.elements
    val kit = desktop(open_scene("boards/pico-breadboard-kit.hocon").unwrap(), false).scene.view.elements
    for e in pico do if e.name == "led" then assert(e.w == 8 && e.h == 4)
    var kit_leds = 0
    for e in kit
        if e.name == "pico.led"
            assert(e.w == 8 && e.h == 4)
            kit_leds += 1
    assert(kit_leds == 1, "the kit shows its Pico whole, and the Pico's LED with it")

@test("seven-segment look: a convex polygon shrinks evenly by its inset whichever way it winds")
plk_inset()
    val corners = [(0.0, 0.0), (10.0, 0.0), (10.0, 10.0), (0.0, 10.0)]
    for flip in [false, true]
        var p: Buf[(real, real)] = buf()
        for i in 0..<4 do p.push(corners[if flip then 3 - i else i])
        val q = inset_polygon(p, 1.0)
        for i in 0..<4
            val (x, y) = q[i]
            assert((x - 1.0).abs() < 1e-9 || (x - 9.0).abs() < 1e-9, s"$x")
            assert((y - 1.0).abs() < 1e-9 || (y - 9.0).abs() < 1e-9, s"$y")

@test("TFT rasters: one per display, reused at its size and replaced in place when the frame's size changes")
plk_raster_cache()
    var cache: Buf[TftRaster] = buf()
    val first = raster_for(&cache, "a", 4, 3).unwrap()
    assert(raster_for(&cache, "a", 4, 3).unwrap() === first && cache.len() == 1)
    raster_for(&cache, "b", 4, 3).unwrap()
    val resized = raster_for(&cache, "a", 8, 6).unwrap()
    assert(cache.len() == 2 && resized.width() == 8 && cache[0].image === resized && cache[1].name == "b")
    for size in 1..20 do raster_for(&cache, "a", size, size)
    assert(cache.len() == 2)

@test("rendering to a PNG: the live desktop's interaction state, density and joystick position survive")
plk_render_snapshot()
    val d = desktop(open_scene("boards/joystick.hocon").unwrap(), true)
    assert(virt.board_named(d.session.board(), "boards/joystick.hocon").is_ok())
    d.pixel_scale.set(2.0)
    d.session.set_part_input("stick", virt.PartInput.Axes(9000, 1000))
    edit(d, st -> st.mouse_part = "x")
    rasterize(d).unwrap()
    assert(d.pixel_scale.read() == 2.0 && d.session.axes("stick") == (9000, 1000) && d.current.read().mouse_part == "x" && d.board_rect.read().w > 0)
