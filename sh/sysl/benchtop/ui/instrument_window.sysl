module sh.sysl.benchtop.ui

import sh.sysl.ui as ui
import sh.sysl.ui_sdl as driver
import sh.sysl.sdl3 as sdl
import sh.sysl.plutovg as vg
import sh.sysl.benchtop.instrument as plot
import sysl.slices.as_ptr

/** Native windows share the main SDL pump; closing one never stops the guest. */
struct InstrumentWindow
    window: &sdl.Window
    renderer: &sdl.Renderer
    surface: &vg.Surface
    canvas: &vg.Canvas
    texture: &sdl.Texture
    ui: ui.PlutoCanvas
    width: int
    height: int

private open_instrument(i: &Instrument) -> Result[&InstrumentWindow, string]
    val w = sdl.create_window(s"Benchtop · ${i.title}", 620, 340, sdl.WINDOW_RESIZABLE | sdl.WINDOW_HIGH_PIXEL_DENSITY) match
        Some(w) -> w
        None -> return Err(sdl.error())
    val renderer = w.create_renderer() match
        Some(r) -> r
        None -> return Err(sdl.error())
    val surface = vg.surface(1, 1).expect("instrument surface")
    val canvas = vg.canvas(surface).expect("instrument canvas")
    val texture = renderer.create_texture(sdl.PixelFormat.Argb8888, sdl.TextureAccess.Streaming, 1, 1).expect("instrument texture")
    val face = vg.font(driver.system_font()).expect("instrument font")
    Ok(InstrumentWindow(w, renderer, surface, canvas, texture, ui.pluto_canvas(canvas, face, 14), 0, 0))

private[ui] instrument_windows(d: &Desktop)
    for i in d.instruments
        if i.opening
            i.opening = false
            i.window match
                Some(w) -> w.window.raise()
                None -> open_instrument(i) match
                    Ok(w) ->
                        i.window = Some(w)
                        i.window_id = w.window.id()
                    Err(why) ->
                        var st = d.current.read()
                        st.notice = s"Instrument window failed: $why"
                        d.current.set(st)
        i.window match
            Some(w) -> paint_instrument(i, w)
            None -> ()

private paint_instrument(i: &Instrument, w: &InstrumentWindow)
    val (pw, ph) = w.window.size_in_pixels()
    if pw <= 0 || ph <= 0 then return
    if w.width != int(pw) || w.height != int(ph)
        w.surface = vg.surface(int(pw), int(ph)).expect("instrument surface")
        w.canvas = vg.canvas(w.surface).expect("instrument canvas")
        w.texture = w.renderer.create_texture(sdl.PixelFormat.Argb8888, sdl.TextureAccess.Streaming, pw, ph).expect("instrument texture")
        w.ui = ui.pluto_canvas(w.canvas, w.ui.face, 14)
        w.width = int(pw)
        w.height = int(ph)
    val k = driver.scale_of(w.window.display_scale())
    w.canvas.reset_transform()
    w.canvas.scale(f32(k), f32(k))
    w.surface.clear(13.0 / 255.0, 20.0 / 255.0, 32.0 / 255.0)
    w.ui.tick(0.0)
    w.ui.taps.reset()
    val view: &ui.View = PlotView(i)
    ui.render(view, &w.ui, ui.Rect(0, 0, int(real(pw) / k), int(real(ph) / k)))
    w.texture.update(as_ptr(w.surface.data()), i32(w.surface.stride()))
    w.renderer.clear()
    w.renderer.copy(w.texture)
    w.renderer.present()

/** Consume child window events before the single-window syslUI driver sees them. */
private[ui] instrument_event(d: &Desktop, e: sdl.Event) -> bool
    val id = e.window_id()
    if id == 0 then return false
    for i in d.instruments
        if i.window_id != id then continue
        i.window match
            Some(w) ->
                val (ww, wh) = w.window.size()
                val (pw, ph) = w.window.size_in_pixels()
                val k = driver.scale_of(w.window.display_scale())
                val scale = driver.point_scale(int(ww), int(pw), k)
                e.kind() match
                    WindowCloseRequested -> i.window = None
                    WindowFocusLost -> w.ui.point(-1, -1, false)
                    MouseMotion -> w.ui.point(int(real(e.mouse_x()) * scale), int(real(e.mouse_y()) * scale), w.ui.down)
                    MouseButtonDown -> if e.mouse_button() == sdl.MouseButton.Left
                        w.ui.point(int(real(e.mouse_x()) * scale), int(real(e.mouse_y()) * scale), true)
                    MouseButtonUp -> if e.mouse_button() == sdl.MouseButton.Left
                        w.ui.release(int(real(e.mouse_x()) * scale), int(real(e.mouse_y()) * scale))
                    KeyDown -> if !e.key_repeat()
                        val key = sdl.scancode_name(e.key_scancode())
                        if key == "Space" then plot.hold(i.plot, !i.plot.held)
                        elif key == "C" then plot.clear(i.plot)
                        elif key == "Escape" then i.window = None
                    _ -> ()
            None -> ()
        return true
    false

private[ui] close_instruments(d: &Desktop)
    for i in d.instruments do i.window = None
