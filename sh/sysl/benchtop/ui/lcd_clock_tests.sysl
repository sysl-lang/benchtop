module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.parts.hd44780 as lcd
import sh.sysl.ui as ui

private val CLOCK_GUEST = embed("../../../../examples/visual/demo.elf")

@test("RTC LCD firmware: setting time through I2C updates the LCD, then the RTC advances from that value and survives MCU reset")
clock_display()
    val d = desktop(open_scene("workbench").unwrap(), true)
    val m = d.session.board()
    assert(virt.board_named(m, "workbench").is_ok())
    val image = virt.image_of(m, CLOCK_GUEST).unwrap()
    virt.boot(m, image.view())
    val count = ui.signal(0u64)
    for frame in 0..<300 do desktop_tick(d, image.view(), 0, count, "")
    var st = d.current.read()
    key_input(d.scene, &st, "2", true)
    d.current.set(st)
    desktop_tick(d, image.view(), 0, count, "")
    st = d.current.read()
    key_input(d.scene, &st, "2", false)
    d.current.set(st)
    for frame in 0..<150 do desktop_tick(d, image.view(), 0, count, "")
    var display = virt.lcd_state(m, "lcd").unwrap()
    val expected = "RTC 12:34:56".bytes
    for col in 0..<12 do assert(lcd.character(display, col, 1) == expected[usize(col)], s"LCD clock column $col")
    for frame in 0..<700 do desktop_tick(d, image.view(), 0, count, "")
    display = virt.lcd_state(m, "lcd").unwrap()
    assert(lcd.character(display, 11, 1) != u8('6'), "time continues after being set")
    val minute = virt.rtc_snapshot(m, "rtc").unwrap()[1]
    d.resetting.set(true)
    desktop_tick(d, image.view(), 0, count, "")
    assert(virt.rtc_snapshot(m, "rtc").unwrap()[1] == minute)
    assert(!d.session.stopped, d.current.read().notice.text)
