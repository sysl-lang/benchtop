module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.parts.hd44780 as lcd
import sh.sysl.ui as ui

private val CLOCK_GUEST = embed("../../../../examples/visual/demo.elf")

@test("RTC LCD firmware: setting time through I2C updates the LCD, then the RTC advances from that value and survives MCU reset")
clock_display()
    assert(virt.board_named("workbench").is_ok())
    val image = virt.image_of(CLOCK_GUEST).unwrap()
    virt.boot(virt.core0(),image.view())
    val d = desktop(open_scene("workbench").unwrap(),state(true))
    val count = ui.signal(0u64)
    for frame in 0..<300 do desktop_tick(d,virt.core0(),image.view(),0,count,"")
    var st = d.current.read()
    key_input(d.scene,&st,"2",true)
    d.current.set(st)
    desktop_tick(d,virt.core0(),image.view(),0,count,"")
    st = d.current.read()
    key_input(d.scene,&st,"2",false)
    d.current.set(st)
    for frame in 0..<150 do desktop_tick(d,virt.core0(),image.view(),0,count,"")
    var display = virt.lcd_state("lcd").unwrap()
    val expected = "RTC 12:34:56".bytes
    for col in 0..<12 do assert(lcd.character(display,col,1) == expected[usize(col)], s"LCD clock column $col")
    for frame in 0..<700 do desktop_tick(d,virt.core0(),image.view(),0,count,"")
    display = virt.lcd_state("lcd").unwrap()
    assert(lcd.character(display,11,1) != u8('6'), "time continues after being set")
    val minute = virt.rtc_snapshot("rtc").unwrap()[1]
    d.resetting.set(true)
    desktop_tick(d,virt.core0(),image.view(),0,count,"")
    assert(virt.rtc_snapshot("rtc").unwrap()[1] == minute)
    assert(!d.current.read().stopped,d.current.read().notice)
