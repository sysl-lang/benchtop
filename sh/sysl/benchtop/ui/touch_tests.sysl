module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.benchtop.{part_named, load, library, description_text}
import sh.sysl.parsing.source_of
import sh.sysl.elf as elf
import sh.sysl.ui as ui
import sysl.raw.str_cast
import sysl.fs.make_dir_all

private val TOUCH_GUEST = embed("../../../../examples/touch/demo.elf")

// A desktop over the touch board with the firmware booted, and the address of the firmware's
// `touch_count` symbol.
private touch_desktop() -> (&Desktop, u32)
    assert(virt.board_named("boards/touch.hocon").is_ok())
    virt.open_console()
    virt.capture_bounded(256)
    virt.boot(virt.core0(), virt.image_of(TOUCH_GUEST).unwrap().view())
    val executable = elf.read(TOUCH_GUEST).unwrap()
    val address = u32(executable.symbol_named("touch_count").unwrap().unwrap().value)
    val d = desktop(open_scene("boards/touch.hocon").unwrap(), true)
    d.board_rect.set(ui.Rect(0, 0, 720, 690))
    (d, address)

private run_touch(cycles: u64 = 10000000)
    assert(virt.pump_board(virt.core0(), cycles), virt.stop_message(virt.core0()))

@test("touch mapping: native glass stays fixed across viewport sizes and Retina density, drags clamp and release outside")
touch_geometry()
    val (d, state) = touch_desktop()
    val display = part_named(d.scene.scope.parts, "screen").unwrap()
    for density in [1.0, 2.0]
      for viewport in [ui.Rect(0, 0, 720, 690), ui.Rect(0, 0, 1440, 1380)]
        d.pixel_scale.set(density)
        d.board_rect.set(viewport)
        val reserved = ui.Rect(234, 105, 252, 266)
        val screen = tft_screen(native_tft_frame(reserved, display, density), display, density)
        assert(real(screen.w) * density == 240.0 && real(screen.h) * density == 240.0)
        pointer_touch(d, screen.x, screen.y - 3, true, true)
        assert(d.touch_capture.read() == Capture.Free)
        pointer_touch(d, screen.x + screen.w / 2, screen.y + screen.h / 2, true, true)
        assert(d.touch_capture.read() == Capture.Glass("display"))
        val touch = &virt.machine.devices.i2c.live
        assert(touch.with(s -> s.touches.at(0).model.physical.down && s.touches.at(0).model.physical.x == 120 && s.touches.at(0).model.physical.y == 120))
        pointer_touch(d, screen.right() + 30, screen.y - 30, true)
        assert(touch.with(s -> s.touches.at(0).model.physical.x == 239 && s.touches.at(0).model.physical.y == 0))
        pointer_touch(d, 0, 0, false)
        assert(!touch.with(s -> s.touches.at(0).model.physical.down) && d.touch_capture.read() == Capture.Free)

@test("touch description: physical identities, routed I2C pins and pointer binding round trip")
touch_description()
    val text = str_cast(embed("../../../../boards/touch.hocon"))
    val src = source_of("touch.hocon", text)
    val parsed = load(src, library())
    assert(!parsed.report.has_errors(), parsed.report.render(src))
    val written = description_text(parsed.description)
    val again = load(source_of("again.hocon", written), library())
    assert(!again.report.has_errors() && description_text(again.description) == written)
    assert(again.description.board.pointers.len() == 1)

@test("touch rounded widgets: native firmware curves have antialiased corners and preserve the square touch target")
rounded_firmware_pixels()
    val (d, count) = touch_desktop()
    run_touch(40000000)
    val frame = virt.tft_frame("screen").unwrap()
    val background = frame.pixels.at(0)
    val face = frame.pixels.at(usize(50 * 240 + 24))
    assert(frame.pixels.at(usize(40 * 240 + 12)) == background)
    assert(face != background)
    var blended = 0
    for y in 40..<48
        for x in 12..<20
            val color = frame.pixels.at(usize(y * 240 + x))
            if color != background && color != face then blended += 1
    assert(blended > 0, "rounded corners must contain real guest-generated coverage antialiasing")
    virt.touch_point("touch", 12, 40, true)
    run_touch()
    virt.touch_point("touch", 12, 40, false)
    run_touch()
    assert(cpu.load32(virt.core0(), count) == 1, "rounding must preserve the rectangular touch target")
    make_dir_all("target").unwrap()
    save_desktop(d, "target/touch-rounded.png").unwrap()
