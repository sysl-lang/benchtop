module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.benchtop.{part_named, load, library, description_text}
import sh.sysl.parsing.source_of
import sh.sysl.elf as elf
import sh.sysl.ui as ui
import sysl.raw.str_cast
import sysl.fs.make_dir_all

private val TOUCH_GUEST = embed("../../../../examples/touch/demo.elf")

// A desktop over the touch board with the firmware booted, and the address of the firmware's
// `touch_count` symbol.
private touch_desktop() -> (&Desktop, u32)
    val d = desktop(open_scene("boards/touch.hocon").unwrap(), true)
    val m = d.session.board()
    assert(virt.board_named(m, "boards/touch.hocon").is_ok())
    virt.open_console(m)
    virt.capture_bounded(m, 256)
    virt.boot(m, virt.image_of(m, TOUCH_GUEST).unwrap().view())
    val executable = elf.read(TOUCH_GUEST).unwrap()
    val address = u32(executable.symbol_named("touch_count").unwrap().unwrap().value)
    d.board_rect.set(ui.Rect(0, 0, 720, 690))
    (d, address)

private run_touch(m: *virt.Machine, cycles: u64 = 10000000)
    assert(virt.pump_board(m, cycles), virt.stop_message(virt.core0(m)))

@test("touch mapping: native glass follows the board's scale at every Retina density, drags clamp and release outside")
touch_geometry()
    val (d, state) = touch_desktop()
    val display = part_named(d.scene.scope.parts, "screen").unwrap()
    var element = d.scene.view.elements[0]
    for e in d.scene.view.elements do if e.name == "display" then element = e
    assert(element.name == "display")
    for density in [1.0, 2.0]
      for viewport in [ui.Rect(0, 0, 720, 690), ui.Rect(0, 0, 1440, 1380), ui.Rect(16, 8, 1080, 1100)]
        d.pixel_scale.set(density)
        d.board_rect.set(viewport)
        val t = board_transform(d.scene, viewport)
        val screen = glass_at(t, element, display, density)
        // The glass covers its 240 pixels at the board's scale in device pixels.
        assert((real(screen.w) * density - 240.0 * real(t.scale)).abs() <= density && (real(screen.h) * density - 240.0 * real(t.scale)).abs() <= density, s"${screen.w} at ${t.scale}")
        pointer_touch(d, screen.x, screen.y - 3, true, true)
        assert(d.touch_capture.read() == Capture.Free)
        pointer_touch(d, screen.x + screen.w / 2, screen.y + screen.h / 2, true, true)
        assert(d.touch_capture.read() == Capture.Glass("display"))
        val touch = &d.session.board().devices.i2c.live
        assert(touch.with(s -> s.parts.touches[0].model.physical.down && s.parts.touches[0].model.physical.x == 120 && s.parts.touches[0].model.physical.y == 120))
        pointer_touch(d, screen.right() + 30, screen.y - 30, true)
        assert(touch.with(s -> s.parts.touches[0].model.physical.x == 239 && s.parts.touches[0].model.physical.y == 0))
        pointer_touch(d, 0, 0, false)
        assert(!touch.with(s -> s.parts.touches[0].model.physical.down) && d.touch_capture.read() == Capture.Free)

@test("touch description: physical identities, routed I2C pins and pointer binding round trip")
touch_description()
    val text = str_cast(embed("../../../../boards/touch.hocon"))
    val src = source_of("touch.hocon", text)
    val parsed = load(src, library())
    assert(!parsed.report.has_errors(), parsed.report.render(src))
    val written = description_text(parsed.description)
    val again = load(source_of("again.hocon", written), library())
    assert(!again.report.has_errors() && description_text(again.description) == written)
    assert(again.description.board.pointers.len() == 1)

@test("touch rounded widgets: native firmware curves have antialiased corners and preserve the square touch target")
rounded_firmware_pixels()
    val (d, count) = touch_desktop()
    val m = d.session.board()
    run_touch(m, 40000000)
    val frame = virt.tft_frame(m, "screen").unwrap()
    val background = frame.pixels[0]
    val face = frame.pixels[usize(50 * 240 + 24)]
    assert(frame.pixels[usize(40 * 240 + 12)] == background)
    assert(face != background)
    var blended = 0
    for y in 40..<48
        for x in 12..<20
            val color = frame.pixels[usize(y * 240 + x)]
            if color != background && color != face then blended += 1
    assert(blended > 0, "rounded corners must contain real guest-generated coverage antialiasing")
    virt.touch_point(m, "touch", 12, 40, true)
    run_touch(m)
    virt.touch_point(m, "touch", 12, 40, false)
    run_touch(m)
    assert(cpu.load32(virt.core0(m), count) == 1, "rounding must preserve the rectangular touch target")
    make_dir_all("target").unwrap()
    save_desktop(d, "target/touch-rounded.png").unwrap()

@test("a turned glass: each quarter turn puts a pixel where turning clockwise puts it and unturning gives it back; a touch maps through the turn, held to the glass past its edge, and unturned as before")
turned_glass_mapping()
    for turn in [0, 90, 180, 270]
        for (x, y) in [(0, 0), (319, 0), (0, 479), (319, 479), (17, 300)]
            val (tx, ty) = turned_pixel(x, y, 320, 480, turn)
            assert(unturned_pixel(tx, ty, 320, 480, turn) == (x, y), s"$turn: ($x, $y) -> ($tx, $ty)")
    // The glass's top-left corner, turned clockwise: to the top right, the bottom right, the bottom left.
    assert(turned_pixel(0, 0, 320, 480, 90) == (479, 0))
    assert(turned_pixel(0, 0, 320, 480, 180) == (319, 479))
    assert(turned_pixel(0, 0, 320, 480, 270) == (0, 319))
    // A 480 x 320 box over the glass turned 90: its top-right corner is the glass's first pixel, its
    // bottom-left its last; a drag past the edge is held to it.
    assert(touched_at(479, 0, 480, 320, 320, 480, 90) == (0, 0))
    assert(touched_at(0, 319, 480, 320, 320, 480, 90) == (319, 479))
    assert(touched_at(-5, 400, 480, 320, 320, 480, 90) == (319, 479))
    // Shown at half size, the touch controller's range is still the whole glass.
    assert(touched_at(239, 0, 240, 160, 320, 480, 90) == (0, 0))
    // Unturned, the mapping is the window's as before, scaling and holding to the range.
    assert(touched_at(10, 20, 120, 120, 240, 240, 0) == (20, 40))
    assert(touched_at(-3, 500, 120, 120, 240, 240, 0) == (0, 239))
