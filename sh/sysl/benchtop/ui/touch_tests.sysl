module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.benchtop.{part_named, load, library, description_text}
import sh.sysl.parsing.source_of
import sh.sysl.elf as elf
import sh.sysl.ui as ui
import sysl.raw.str_cast
import sysl.text.replace_all

private val TOUCH_GUEST = embed("../../../../examples/touch/demo.elf")

private touch_desktop() -> (&Desktop, u32)
    assert(virt.board_named("boards/touch.hocon").is_ok())
    virt.open_console()
    virt.capture_bounded(256)
    virt.boot(virt.core0(), virt.image_of(TOUCH_GUEST).unwrap().view())
    val executable = elf.read(TOUCH_GUEST).unwrap()
    val address = u32(executable.symbol_named("touch_app").unwrap().unwrap().value)
    val d = desktop(open_scene("boards/touch.hocon").unwrap(), state(true))
    d.board_rect.set(ui.Rect(0,0,720,690))
    (d, address)

private run_touch(cycles: u64 = 3000000)
    assert(virt.pump_board(virt.core0(), cycles), virt.stop_message(virt.core0()))

@test("touch imui firmware: GT911 click changes a guest counter and pixels, toggle drives GPIO, slider reaches both endpoints")
firmware_ui()
    val (d, state) = touch_desktop()
    run_touch(30000000)
    assert(cpu.load32(virt.core0(), state) == 0)
    assert(cpu.load8(virt.core0(), state + 4) == 1 && (virt.panel_output_latch() & 32) != 0)
    val before = virt.tft_frame("screen").unwrap()
    virt.touch_point("touch", 120, 60, true)
    run_touch()
    assert(cpu.load32(virt.core0(), state) == 0, "button activates on release")
    virt.touch_point("touch", 120, 60, false)
    run_touch()
    assert(cpu.load32(virt.core0(), state) == 1)
    val after = virt.tft_frame("screen").unwrap()
    var changed = false
    for i in 0..<after.pixels.len() do if before.pixels.at(i) != after.pixels.at(i) then changed = true
    assert(changed, "imui count redraw traveled through actual GPIO SPI")
    virt.touch_point("touch", 200, 125, true)
    run_touch()
    virt.touch_point("touch", 200, 125, false)
    run_touch()
    assert(cpu.load8(virt.core0(), state + 4) == 0 && (virt.panel_output_latch() & 32) == 0)
    val toggled = virt.tft_frame("screen").unwrap()
    assert(toggled.pixels.at(usize(125 * 240 + 180)) == 0xE7EBEF, "imui paints the new knob position in the same release frame")
    virt.touch_point("touch", 120, 180, true)
    run_touch()
    virt.touch_point("touch", 239, 180, true)
    run_touch()
    assert(cpu.load32(virt.core0(), state + 8) == 100)
    virt.touch_point("touch", 0, 180, true)
    run_touch()
    assert(cpu.load32(virt.core0(), state + 8) == 0)
    release_touch(d)
    run_touch()

@test("touch mapping: glass excludes bezel, scaled pointer capture clamps drags and releases outside")
touch_geometry()
    val (d, state) = touch_desktop()
    val display = part_named(d.scene.scope.parts, "screen").unwrap()
    for scale in [1, 2]
        d.board_rect.set(ui.Rect(0,0,720 * scale,690 * scale))
        val screen = tft_screen(ui.Rect(160 * scale,105 * scale,400 * scale,430 * scale), display)
        pointer_touch(d, screen.x, screen.y - 3, true, true)
        assert(d.touch_capture.read().is_empty())
        pointer_touch(d, screen.x + screen.w / 2, screen.y + screen.h / 2, true, true)
        assert(d.touch_capture.read() == "display")
        val model = virt.touch_bindings.at(0).model
        assert(model.physical.down && model.physical.x == 120 && model.physical.y == 120)
        pointer_touch(d, screen.right() + 30, screen.y - 30, true)
        assert(model.physical.x == 239 && model.physical.y == 0)
        pointer_touch(d, 0, 0, false)
        assert(!model.physical.down && d.touch_capture.read().is_empty())

@test("touch imui firmware: a queued quick click survives the initial full-screen SPI redraw")
quick_click()
    val (d, state) = touch_desktop()
    virt.touch_point("touch", 120, 60, true)
    virt.touch_point("touch", 120, 60, false)
    run_touch(40000000)
    assert(cpu.load32(virt.core0(), state) == 1)

@test("touch description: physical identities, routed I2C pins and pointer binding round trip")
touch_description()
    val text = str_cast(embed("../../../../boards/touch.hocon"))
    val src = source_of("touch.hocon", text)
    val parsed = load(src, library())
    assert(!parsed.report.has_errors(), parsed.report.render(src))
    val written = description_text(parsed.description)
    val again = load(source_of("again.hocon", written), library())
    assert(!again.report.has_errors() && description_text(again.description) == written)
    assert(again.description.board.pointers.len() == 1)

@test("touch I2C: GT911 address selection and an RTC share one controller without bypassing device protocols")
shared_i2c()
    val text = str_cast(embed("../../../../boards/touch.hocon"))
    val shared = replace_all(text, "parts {", "parts { rtc { part = DS3231SN, ref = U2, i2c = i2c0, initial-time = fixed }")
    assert(virt.board_from("shared.hocon", shared.bytes).is_ok())
    virt.boot(virt.core0(), virt.image_of(TOUCH_GUEST).unwrap().view())
    val c = virt.core0()
    cpu.store32(c, 0x50000300, 0x68)
    cpu.store32(c, 0x50000308, 1)
    cpu.store32(c, 0x50000304, 0)
    cpu.store32(c, 0x50000308, 4)
    cpu.store32(c, 0x50000308, 3)
    cpu.store32(c, 0x50000308, 2)
    assert(cpu.load32(c, 0x50000304) == 0 && (cpu.load32(c, 0x5000030C) & 2) == 0)
    cpu.store32(c, 0x50000308, 8)
    virt.touch_point("touch", 12, 34, true)
    run_touch(40000000)
    assert(c.stop == cpu.Stop.Budget)
    val alternate = replace_all(text, "part = GT911", "part = GT911, address = 20")
    assert(virt.board_from("alternate.hocon", alternate.bytes).is_ok(), "the real part supports either strap-selected address")
    val invalid = replace_all(text, "part = GT911", "part = GT911, address = 21")
    assert(load(source_of("invalid.hocon", invalid), library()).report.has_errors())
