module sh.sysl.benchtop.ui

import sh.sysl.ui as ui
import sh.sysl.benchtop.Part
import sh.sysl.benchtop.parts.ssd1306 as oled
import sh.sysl.benchtop.virt as virt
import sh.sysl.plutovg as vg
import sysl.math.{min, max}

private[ui] draw_oled(c: *ui.Canvas, r: ui.Rect, p: Part, name: string, g: &virt.Guest, live: bool)
    draw_module(c, r, OLED_FILL, OLED_RIM)
    val k = (real(max(1, r.w - 16)) / 128.0).min(real(max(1, r.h - 16)) / 64.0)
    val width = int(k * 128.0)
    val height = int(k * 64.0)
    val x = r.x + (r.w - width) / 2
    val y = r.y + (r.h - height) / 2
    val screen = ui.Rect(x, y, width, height)
    c.fill(screen, OLED_GLASS, 2)
    if live
        g.oled(name) match
            Some(d) ->
                // The glass's pixels go down as a native image at the display's density: each pixel
                // a whole block of device pixels at any board scale, with no seam between rows.
                val density = c.pixel_scale()
                val step = k * density
                val image = oled_raster(d, int((real(width) * density).ceil()), int((real(height) * density).ceil()), step) match
                    Some(image) -> image
                    None -> return
                c.clip(screen)
                c.draw_native_image(x, y, image)
                c.unclip()
            None -> ()
    label(c, ui.Rect(r.x + 5, r.y - 14, r.w, 14), s"${p.reference} · SSD1306 · GPIO SPI", MUTED, 10)

// The lit pixels of `d` on a clear `width` by `height` image, pixel (col, row) covering the image's
// pixels from `step` times its corner to `step` times the next one, each edge on a whole pixel.
private[ui] oled_raster(d: oled.Display, width: int, height: int, step: real) -> Option[&ui.Image]
    val surface = vg.surface(max(1, width), max(1, height)) match
        Some(surface) -> surface
        None -> return None
    val image: &ui.Image = ui.Image(surface)
    val bytes = image.pixels.data()
    val stride = image.width()
    for row in 0..<64
        val top = int(real(row) * step)
        val bottom = min(height, max(top + 1, int(real(row + 1) * step)))
        for col in 0..<128
            if !oled.pixel(d, col, row) then continue
            val left = int(real(col) * step)
            val right = min(width, max(left + 1, int(real(col + 1) * step)))
            for py in top..<bottom
                for px in left..<right
                    val i = usize(py * stride + px) * 4
                    bytes[i] = u8(OLED_PIXEL & 255)
                    bytes[i + 1] = u8((OLED_PIXEL >> 8) & 255)
                    bytes[i + 2] = u8((OLED_PIXEL >> 16) & 255)
                    bytes[i + 3] = 255
    Some(image)
