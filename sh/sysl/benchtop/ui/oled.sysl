module sh.sysl.benchtop.ui

import sh.sysl.ui as ui
import sh.sysl.benchtop.Part
import sh.sysl.benchtop.parts.ssd1306 as oled
import sh.sysl.benchtop.virt as virt
import sysl.math.{min, max}

private[ui] draw_oled(c: *ui.Canvas, r: ui.Rect, p: Part, name: string, live: bool)
    draw_module(c, r, OLED_FILL, OLED_RIM)
    val k = min(real(max(1, r.w - 16)) / 128.0, real(max(1, r.h - 16)) / 64.0)
    val width = int(k * 128.0)
    val height = int(k * 64.0)
    val x = r.x + (r.w - width) / 2
    val y = r.y + (r.h - height) / 2
    val screen = ui.Rect(x, y, width, height)
    c.fill(screen, OLED_GLASS, 2)
    if live
        virt.oled_state(name) match
            Some(d) ->
                c.clip(screen)
                // Coalesce adjacent lit pixels into spans instead of issuing 8192 rectangles.
                for row in 0..<64
                    var first = -1
                    for col in 0..128
                        val on = col < 128 && oled.pixel(d, col, row)
                        if on && first < 0 then first = col
                        if !on && first >= 0
                            val left = x + int(real(first) * k)
                            val right = x + int(real(col) * k)
                            val top = y + int(real(row) * k)
                            val bottom = y + int(real(row + 1) * k)
                            c.fill(ui.Rect(left, top, max(1, right - left), max(1, bottom - top)), OLED_PIXEL)
                            first = -1
                c.unclip()
            None -> ()
    label(c, ui.Rect(r.x + 5, r.y - 14, r.w, 14), s"${p.reference} · SSD1306 · GPIO SPI", MUTED, 10)
