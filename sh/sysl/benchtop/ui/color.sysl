module sh.sysl.benchtop.ui

parse_color(value: string, fallback: u32 = 0x17283B) -> u32
    value match
        "black" -> return 0x070C13
        "white" -> return 0xFFFFFF
        "red" -> return 0xF25468
        "green" -> return 0x59E6A0
        "blue" -> return 0x62AFFF
        "yellow" -> return 0xFFCF66
        "orange" -> return 0xFF9A50
        "gray" | "grey" -> return 0x6D7F93
        _ -> ()
    if value.bytes.len != 7 || value.bytes[0] != u8('#') then return fallback
    var result: u32 = 0
    for i in 1..<7
        val b = value.bytes[i]
        val n: u32 = if b >= 48 && b <= 57 then u32(b - 48) elif b >= 65 && b <= 70 then u32(b - 65) + 10 elif b >= 97 && b <= 102 then u32(b - 97) + 10 else 255
        if n == 255 then return fallback
        result = result * 16 + n
    result

dim(color: u32) -> u32 = ((color & 0xFCFCFC) >> 2)
