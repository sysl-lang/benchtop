module sh.sysl.benchtop.ui

import sh.sysl.ui as ui
import sh.sysl.benchtop.{Part, part_whole}
import sh.sysl.benchtop.virt as virt
import sysl.math.{min, max}

private[ui] draw_tft(c: *ui.Canvas, r: ui.Rect, p: Part, name: string, live: bool)
    c.fill(r, 0x172C3D, 5)
    c.stroke(r, 0x638399, 1, 5)
    val width = int(part_whole(p, "width", 240))
    val height = int(part_whole(p, "height", 240))
    val k = min(real(max(1, r.w - 12)) / real(width), real(max(1, r.h - 26)) / real(height))
    val x = r.x + (r.w - int(real(width) * k)) / 2
    val y = r.y + 17 + (r.h - 26 - int(real(height) * k)) / 2
    val screen = ui.Rect(x, y, int(real(width) * k), int(real(height) * k))
    c.fill(screen, 0)
    if live
        virt.tft_frame(name) match
            Some(frame) ->
                c.clip(screen)
                for row in 0..<frame.height
                    var first = 0
                    while first < frame.width
                        val color = frame.pixels.at(usize(row * frame.width + first))
                        var end = first + 1
                        while end < frame.width && frame.pixels.at(usize(row * frame.width + end)) == color do end += 1
                        val left = x + int(real(first) * k)
                        val right = x + int(real(end) * k)
                        val top = y + int(real(row) * k)
                        val bottom = y + int(real(row + 1) * k)
                        c.fill(ui.Rect(left, top, max(1, right - left), max(1, bottom - top)), color)
                        first = end
                c.unclip()
            None -> ()
    label(c, ui.Rect(r.x + 6, r.y + 3, r.w - 12, 12), s"${p.reference} · ST7789", MUTED, 9)
