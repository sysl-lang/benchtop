module sh.sysl.benchtop.ui

import sh.sysl.ui as ui
import sh.sysl.plutovg as vg
import sysl.buf.Buf
import sh.sysl.benchtop.{Part, part_whole, part_model}
import sh.sysl.benchtop.virt as virt
import sysl.math.{min, max, Float}

/** The image a display's frame is copied into, one per display, replaced when the frame's size changes. */
struct TftRaster
    name: string
    image: &ui.Image

/** The named display's raster, sized `width` × `height`: the cached one, or a new one in its place. */
private[ui] raster_for(cache: *Buf[TftRaster], name: string, width: int, height: int) -> Option[&ui.Image]
    var slot: Option[usize] = None
    for i in 0..<cache.len()
        if cache[i].name != name then continue
        val image = cache[i].image
        if image.width() == width && image.height() == height then return Some(image)
        slot = Some(i)
    val surface = vg.surface(width, height) match
        Some(surface) -> surface
        None -> return None
    val image: &ui.Image = ui.Image(surface)
    slot match
        Some(i) -> cache[i] = TftRaster(name, image)
        None -> cache.push(TftRaster(name, image))
    Some(image)

/** Display pixels stay native; the surrounding desktop remains DPI-aware. */
private[ui] native_tft_frame(r: ui.Rect, p: Part, density: real) -> ui.Rect
    val scale = density.max(1.0)
    val w = int((real(part_whole(p, "width", 240)) / scale).ceil()) + 12
    val h = int((real(part_whole(p, "height", 240)) / scale).ceil()) + 26
    ui.Rect(r.x + (r.w - w) / 2, r.y + (r.h - h) / 2, w, h)

/** Whether panel `p` is its glass alone, the view's element its size (an ST7796's), rather than a module
 * with a rim and a caption around the glass (an ST7789's, a DSI panel's).
 */
private[ui] bare_glass(p: Part) -> bool = part_model(p) == "st7796"

private[ui] draw_tft(c: *ui.Canvas, reserved: ui.Rect, p: Part, name: string, g: &virt.Guest, live: bool, cache: *Buf[TftRaster], turn: int = 0)
    if bare_glass(p) then return draw_glass(c, reserved, name, g, live, cache, turn)
    val density = c.pixel_scale().max(1.0)
    val r = native_tft_frame(reserved, p, density)
    draw_module(c, r, TFT_FILL, TFT_RIM)
    val screen = tft_screen(r, p, density)
    c.fill(screen,0)
    if live
        g.frame(name) match
            Some(frame) ->
                val raster = raster_for(cache, name, frame.width, frame.height) match
                    Some(image) -> image
                    None -> return
                val bytes = raster.pixels.data()
                for i in 0..<frame.pixels.len()
                    val color = frame.pixels[i]
                    bytes[i * 4] = u8(color & 255)
                    bytes[i * 4 + 1] = u8((color >> 8) & 255)
                    bytes[i * 4 + 2] = u8((color >> 16) & 255)
                    bytes[i * 4 + 3] = 255
                c.clip(screen)
                c.draw_native_image(screen.x, screen.y, raster)
                c.unclip()
            None -> ()
    label(c, ui.Rect(r.x + 6, r.y + 3, r.w - 12, 12), s"${p.reference} · ${if part_model(p) == "mipi-dcs-display" then "DSI / DCS" else "ST7789"}", MUTED, 9)

/** Where the glass's pixel (x, y), of a `width` by `height` glass, lands once the glass is turned `turn`
 * degrees clockwise.
 */
private[ui] turned_pixel(x: int, y: int, width: int, height: int, turn: int) -> (int, int) = turn match
    90 -> (height - 1 - y, x)
    180 -> (width - 1 - x, height - 1 - y)
    270 -> (y, width - 1 - x)
    _ -> (x, y)

/** The glass's pixel that lands at (x, y) of the turned glass: `turned_pixel` undone. */
private[ui] unturned_pixel(x: int, y: int, width: int, height: int, turn: int) -> (int, int) = turn match
    90 -> (y, height - 1 - x)
    180 -> (width - 1 - x, height - 1 - y)
    270 -> (width - 1 - y, x)
    _ -> (x, y)

// A panel that is its glass alone, filling `r`, turned `turn` degrees clockwise as its element says.
private draw_glass(c: *ui.Canvas, r: ui.Rect, name: string, g: &virt.Guest, live: bool, cache: *Buf[TftRaster], turn: int)
    c.fill(r, GLASS)
    if !live then return
    val frame = g.frame(name) match
        Some(f) -> f
        None -> return
    val sideways = turn == 90 || turn == 270
    val (w, h) = if sideways then (frame.height, frame.width) else (frame.width, frame.height)
    val raster = raster_for(cache, name, w, h) match
        Some(image) -> image
        None -> return
    val bytes = raster.pixels.data()
    for y in 0..<frame.height
        for x in 0..<frame.width
            val color = frame.pixels[usize(y * frame.width + x)]
            val (tx, ty) = turned_pixel(x, y, frame.width, frame.height, turn)
            val i = usize(ty * w + tx) * 4
            bytes[i] = u8(color & 255)
            bytes[i + 1] = u8((color >> 8) & 255)
            bytes[i + 2] = u8((color >> 16) & 255)
            bytes[i + 3] = 255
    c.draw_image(r, raster)

/** The active glass rectangle is shared by rendering and touch coordinate mapping. */
private[ui] tft_screen(r: ui.Rect, p: Part, density: real = 1.0) -> ui.Rect
    val width = int(part_whole(p, "width", 240))
    val height = int(part_whole(p, "height", 240))
    val k = (1.0 / density.max(1.0)).min((real(max(1, r.w - 12)) / real(width)).min(real(max(1, r.h - 26)) / real(height)))
    val x = r.x + (r.w - int((real(width) * k).ceil())) / 2
    val y = r.y + 17 + (r.h - 26 - int((real(height) * k).ceil())) / 2
    ui.Rect(x, y, int((real(width) * k).ceil()), int((real(height) * k).ceil()))
