module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sysl.fs.{write_text, make_dir_all}
import sysl.text.str_builder

@test("touch rendering performance: report guest stage costs for the real firmware pipeline")
touch_stage_costs()
    assert(virt.board_named("boards/touch.hocon").is_ok())
    var out = str_builder()
    var expected: [8]u32
    val guests = [embed("../../../../examples/touch/full.elf"), embed("../../../../examples/touch/demo.elf")]
    var reference = true
    for guest in guests
        virt.boot(virt.core0(), virt.image_of(guest).unwrap().view())
        val symbols = elf.read(guest).unwrap()
        val frames = u32(symbols.symbol_named("touch_frames").unwrap().unwrap().value)
        val profile = u32(symbols.symbol_named("touch_profile").unwrap().unwrap().value)
        assert(virt.pump_board(virt.core0(), 40000000))
        val events = [("idle-down", 1, 1, true), ("idle-up", 1, 1, false),
            ("button-down", 120, 60, true), ("button-up", 120, 60, false),
            ("slider-down", 120, 180, true), ("slider-drag", 180, 180, true), ("slider-steady", 60, 180, true), ("slider-up", 60, 180, false)]
        var event = 0
        for (label, x, y, down) in events
            val before = cpu.load32(virt.core0(), frames)
            virt.touch_point("touch", x, y, down)
            var loops = 0
            while cpu.load32(virt.core0(), frames) == before && loops < 50
                assert(virt.pump_board(virt.core0(), 500000))
                loops += 1
            assert(cpu.load32(virt.core0(), frames) > before)
            val render = cpu.load32(virt.core0(), profile)
            val flush = cpu.load32(virt.core0(), profile + 4)
            val spi = cpu.load32(virt.core0(), profile + 8)
            val bytes = cpu.load32(virt.core0(), profile + 12)
            val pixels = cpu.load32(virt.core0(), profile + 16)
            val frame = virt.tft_frame("screen").unwrap()
            var hash: u32 = 2166136261
            for i in 0..<frame.pixels.len()
                hash = (hash ^ frame.pixels.at(i)) * 16777619
            if reference then expected[event] = hash
            else assert(hash == expected[event], "damage replay must match the full-rendering reference")
            event += 1
            if !reference && (label == "button-down" || label == "button-up")
                assert(render + flush < 2500000, "rounded buttons must fit a 60 Hz guest-frame budget at 150 MHz")
            if !reference && label == "button-down"
                assert(spi >= bytes * 32 && spi < 750000, "PL022 timing must honor the divider while beating GPIO bit-banging")
                assert(render < 1000000 && flush - spi < 400000, "adding a focus outline must not repaint unrelated widgets")
            if !reference && label == "slider-steady"
                assert(render + flush < 1500000, "steady slider updates must stay within their guest tick budget")
            if !reference && (label == "idle-down" || label == "idle-up")
                assert(render < 100000 && flush == 0 && pixels == 0, "unchanged frames must skip rasterization and SPI")
            out.push(s"${if reference then "full" else "damage"} $label hash=$hash render=$render scan=${flush - spi} spi=$spi bytes=$bytes pixels=$pixels\n")
        reference = false
    make_dir_all("target").unwrap()
    write_text("target/touch-performance.txt", out.finish()).unwrap()
