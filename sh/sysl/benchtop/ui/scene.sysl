module sh.sysl.benchtop.ui

import sh.sysl.benchtop.*
import sh.sysl.benchtop.virt.{part_pin, panel_levels, panel_drive_mask, panel_inputs, set_analog_pin, pot_voltage}
import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

const WIDTH: int = 1200
const HEIGHT: int = 760
const INK: u32 = 0xE4EEF8
const MUTED: u32 = 0x8DA3BA
const ACCENT: u32 = 0x60E5B6
const EDGE: u32 = 0x283D54
const CARD: u32 = 0x121F2E

struct Scene
    name: string
    chip: string
    cores: string
    view: View
    scope: Scope
    keys: Buf[KeyBinding]
    peripherals: Buf[Peripheral]

struct State
    live: bool
    paused: bool
    stopped: bool
    status: string
    pc: u32
    instructions: u64
    selected: string
    mouse_part: string
    held: Buf[string]
    notice: string
    pots: Buf[(string, int)]

state(live: bool) -> State = State(live, false, false, if live then "RUNNING" else "LAYOUT PREVIEW", 0, 0, "", "", buf(), "", buf())

open_scene(which: string) -> Result[Scene, string]
    val src = open_description(built_in_shelf(), which, "", Span(0, 0)) match
        Ok(s) -> s
        Err(d) -> return Err(d.message)
    val got = load(src, library())
    if got.report.has_errors() then return Err(got.report.render(src))
    scene(got.description)

scene(d: Description) -> Result[Scene, string]
    if d.form == ChipForm then return Err("choose a board or product to see its layout; a chip has no view")
    if d.form == ProductForm then return Ok(Scene(d.product.name, "PRODUCT", s"${d.product.boards.len()} BOARD(S)", d.product.view, Scope(d.product.parts, d.product.boards), d.product.keys, buf()))
    val b = d.board
    var cores = ""
    for c in b.chip.cores
        if !cores.is_empty() then cores += " + "
        cores += c.name
    Ok(Scene(b.name, b.chip.name, cores, b.view, Scope(b.parts, buf()), b.keys, b.chip.peripherals))

/** Fit any window size with letterboxing; the same transform is used for pointer input. */
struct Transform
    scale: f32
    x: f32
    y: f32

fit(width: int, height: int, into_width: int, into_height: int, x: int = 0, y: int = 0) -> Transform
    val sx = f32(into_width) / f32(width)
    val sy = f32(into_height) / f32(height)
    val scale = if sx < sy then sx else sy
    Transform(scale, f32(x) + (f32(into_width) - f32(width) * scale) / 2.0, f32(y) + (f32(into_height) - f32(height) * scale) / 2.0)

private[ui] coords(t: Transform, e: Element) -> (int, int, int, int) =
    (int(t.x + f32(e.x) * t.scale), int(t.y + f32(e.y) * t.scale), int(f32(e.w) * t.scale), int(f32(e.h) * t.scale))

private[ui] param(p: Part, key: string, fallback: string) -> string
    param_named(p.params, key) match
        Some(p) -> p.value match
            Text(value) -> value
            _ -> fallback
        None -> fallback

private[ui] look(e: Element, key: string, fallback: string) -> string
    param_named(e.look, key) match
        Some(p) -> p.value match
            Text(value) -> value
            _ -> fallback
        None -> fallback

private[ui] lit(st: State, p: Part, chip: string = "") -> bool
    val pin = part_pin(p, chip)
    if !st.live || pin < 0 || (panel_drive_mask() & (1u32 << u32(pin))) == 0 then return false
    val high = (panel_levels() & (1u32 << u32(pin))) != 0
    if param(p, "active", "high") == "low" then !high else high

release_inputs(st: *State)
    st.mouse_part = ""
    st.held.clear()

/** Key names are the description's canonical names (lower-case, e.g. "1", "up"). */
key_input(s: Scene, st: *State, key: string, down: bool) -> bool
    var matched = false
    for binding in s.keys
        if binding.key != key then continue
        matched = true
        if !st.live then continue
        val token = s"$key:${binding.part}"
        // Store key identity, so two keys bound to the same part remain independent.
        var index: usize = 0
        var found = false
        while index < st.held.len()
            if st.held.at(index) == token
                found = true
                break
            index += 1
        if down && !found then st.held.push(token)
        if !down && found then st.held.remove(index)
    matched

// Keyboard tokens keep the key prefix; resolve them only when sampling part state.
private[ui] pressed(s: Scene, st: State, name: string) -> bool
    if st.mouse_part == name then return true
    for binding in s.keys
        if binding.part != name then continue
        for token in st.held do if token == s"${binding.key}:$name" then return true
    false

sample_inputs(s: Scene, st: State)
    if !st.live then return
    var levels: u32 = 0xFFFFFFFF
    for p in s.scope.parts
        if p.kind != "button" then continue
        val pin = part_pin(p, s.chip)
        if pin < 0 then continue
        val high = if param(p, "active", "low") == "low" then !pressed(s, st, p.name) else pressed(s, st, p.name)
        if high then levels |= 1u32 << u32(pin) else levels &= ~(1u32 << u32(pin))
    panel_inputs(levels)
    for p in s.scope.parts
        if p.kind != "potentiometer" then continue
        val pin = part_pin(p, s.chip)
        if pin >= 0 then set_analog_pin(pin, pot_voltage(p, pot_position(st, p)))

private[ui] target(t: Target) -> string = t match
    Pin(name) -> name
    Bus(name) -> name
    Port(p, port) -> s"$p.$port"

private[ui] pot_position(st: State, p: Part) -> int
    for entry in st.pots do if entry.0 == p.name then return entry.1
    int(part_whole(p, "position", 50)) * 100

private[ui] set_pot(st: *State, name: string, value: int)
    val position = if value < 0 then 0 elif value > 10000 then 10000 else value
    for i in 0..<st.pots.len()
        if st.pots.at(i).0 == name
            st.pots.set(i, (name, position))
            return
    st.pots.push((name, position))
