module sh.sysl.benchtop.ui

import sh.sysl.benchtop.*
import sh.sysl.benchtop.virt.{part_pin, panel_levels, panel_drive_mask, panel_inputs}
import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

const WIDTH: int = 1200
const HEIGHT: int = 760
const INK: u32 = 0xE4EEF8
const MUTED: u32 = 0x8DA3BA
const ACCENT: u32 = 0x60E5B6
const EDGE: u32 = 0x283D54
const CARD: u32 = 0x121F2E

struct Scene
    name: string
    chip: string
    cores: string
    view: View
    scope: Scope
    keys: Buf[KeyBinding]

struct State
    live: bool
    paused: bool
    stopped: bool
    status: string
    pc: u32
    instructions: u64
    selected: string
    mouse_part: string
    held: Buf[string]
    notice: string

state(live: bool) -> State = State(live, false, false, if live then "RUNNING" else "LAYOUT PREVIEW", 0, 0, "", "", buf(), "")

open_scene(which: string) -> Result[Scene, string]
    val src = open_description(built_in_shelf(), which, "", Span(0, 0)) match
        Ok(s) -> s
        Err(d) -> return Err(d.message)
    val got = load(src, library())
    if got.report.has_errors() then return Err(got.report.render(src))
    scene(got.description)

scene(d: Description) -> Result[Scene, string]
    if d.form == ChipForm then return Err("choose a board or product to see its layout; a chip has no view")
    if d.form == ProductForm then return Ok(Scene(d.product.name, "PRODUCT", s"${d.product.boards.len()} BOARD(S)", d.product.view, Scope(d.product.parts, d.product.boards), d.product.keys))
    val b = d.board
    var cores = ""
    for c in b.chip.cores
        if !cores.is_empty() then cores += " + "
        cores += c.name
    Ok(Scene(b.name, b.chip.name, cores, b.view, Scope(b.parts, buf()), b.keys))

/** Fit any window size with letterboxing; the same transform is used for pointer input. */
struct Transform
    scale: f32
    x: f32
    y: f32

fit(width: int, height: int, into_width: int, into_height: int, x: int = 0, y: int = 0) -> Transform
    val sx = f32(into_width) / f32(width)
    val sy = f32(into_height) / f32(height)
    val scale = if sx < sy then sx else sy
    Transform(scale, f32(x) + (f32(into_width) - f32(width) * scale) / 2.0, f32(y) + (f32(into_height) - f32(height) * scale) / 2.0)

layout(s: Scene) -> Transform
    val w = if s.view.width > 0 then s.view.width else 640
    val h = if s.view.height > 0 then s.view.height else 380
    fit(w, h, 748, 452, 54, 181)

private coords(t: Transform, e: Element) -> (int, int, int, int) =
    (int(t.x + f32(e.x) * t.scale), int(t.y + f32(e.y) * t.scale), int(f32(e.w) * t.scale), int(f32(e.h) * t.scale))

private param(p: Part, key: string, fallback: string) -> string
    param_named(p.params, key) match
        Some(p) -> p.value match
            Text(value) -> value
            _ -> fallback
        None -> fallback

private look(e: Element, key: string, fallback: string) -> string
    param_named(e.look, key) match
        Some(p) -> p.value match
            Text(value) -> value
            _ -> fallback
        None -> fallback

private lit(st: State, p: Part) -> bool
    val pin = part_pin(p)
    if !st.live || pin < 0 || (panel_drive_mask() & (1u32 << u32(pin))) == 0 then return false
    val high = (panel_levels() & (1u32 << u32(pin))) != 0
    if param(p, "active", "high") == "low" then !high else high

release_inputs(st: *State)
    st.mouse_part = ""
    st.held.clear()

/** Key names are the description's canonical names (lower-case, e.g. "1", "up"). */
key_input(s: Scene, st: *State, key: string, down: bool) -> bool
    var matched = false
    for binding in s.keys
        if binding.key != key then continue
        matched = true
        if !st.live then continue
        val token = s"$key:${binding.part}"
        // Store key identity, so two keys bound to the same part remain independent.
        var index: usize = 0
        var found = false
        while index < st.held.len()
            if st.held.at(index) == token
                found = true
                break
            index += 1
        if down && !found then st.held.push(token)
        if !down && found then st.held.remove(index)
    matched

// Keyboard tokens keep the key prefix; resolve them only when sampling part state.
private pressed(s: Scene, st: State, name: string) -> bool
    if st.mouse_part == name then return true
    for binding in s.keys
        if binding.part != name then continue
        for token in st.held do if token == s"${binding.key}:$name" then return true
    false

sample_inputs(s: Scene, st: State)
    if !st.live then return
    var levels: u32 = 0xFFFFFFFF
    for p in s.scope.parts
        if p.kind != "button" then continue
        val pin = part_pin(p)
        if pin < 0 then continue
        val high = if param(p, "active", "low") == "low" then !pressed(s, st, p.name) else pressed(s, st, p.name)
        if high then levels |= 1u32 << u32(pin) else levels &= ~(1u32 << u32(pin))
    panel_inputs(levels)

/** Reverse traversal matches drawing order when elements overlap. */
hit_part(s: Scene, x: int, y: int) -> string
    val t = layout(s)
    var i = s.view.elements.len()
    while i > 0
        i -= 1
        val e = s.view.elements.at(i)
        val (ex, ey, w, h) = coords(t, e)
        if x < ex || y < ey || x >= ex + w || y >= ey + h then continue
        e.shows match
            ShowPart(name) -> return name
            _ -> return "" // A box/caption painted on top occludes parts behind it.
    ""

/** Toolbar buttons, in fixed framebuffer coordinates. */
action_at(x: int, y: int) -> string
    if y < 88 || y >= 124 then return ""
    if x >= 28 && x < 158 then return "pause"
    if x >= 170 && x < 270 then return "step"
    if x >= 282 && x < 382 then return "reset"
    if x >= 394 && x < 534 then return "save"
    ""

private button(c: Canvas, x: int, width: int, label: string, enabled: bool, primary: bool = false)
    val bg = if enabled && primary then ACCENT else 0x1C3044
    fill(c, x, 88, width, 36, bg)
    outline(c, x, 88, width, 36, if enabled then 0x47647F else EDGE)
    text(c, x + 12, 101, label, if enabled && primary then 0x10251F elif enabled then INK else 0x657B90, 1)

private part(c: Canvas, s: Scene, st: State, e: Element, p: Part, name: string, t: Transform)
    val (x, y, w, h) = coords(t, e)
    val r = if w < h then w / 2 else h / 2
    val selected = st.selected == name
    if selected then outline(c, x - 4, y - 4, w + 8, h + 8, ACCENT, 2)
    p.kind match
        "led" | "ws2812" ->
            val color = parse_color(look(e, "color", param(p, "color", "green")))
            val on = p.kind == "led" && lit(st, p)
            circle(c, x + w / 2, y + h / 2, r + 3, if on then dim(color) else 0x263342)
            circle(c, x + w / 2, y + h / 2, if r > 2 then r - 1 else r, if on then color else dim(color))
            if on && r > 4 then circle(c, x + w / 2 - r / 3, y + h / 2 - r / 3, r / 4, 0xE9FFF5)
        "button" ->
            val down = st.live && pressed(s, st, name)
            fill(c, x, y, w, h, 0x0B111A)
            outline(c, x, y, w, h, if down then ACCENT else 0x768DA2, 2)
            fill(c, x + 5, y + 5, w - 10, h - 10, if down then 0x388C75 else 0x33495E)
            circle(c, x + w / 2, y + h / 2, if r > 8 then r - 8 else 2, if down then ACCENT else 0x526B81)
        "st7796" ->
            fill(c, x, y, w, h, 0x080E16)
            outline(c, x, y, w, h, 0x3E5266)
            for row in 0..<5 do fill(c, x + 12, y + h / 2 - 25 + row * 12, w - 24, 1, 0x152333)
            text(c, x + 16, y + h / 2 - 3, "DISPLAY NOT EMULATED", MUTED, 1, (w - 32) / 6)
        "joystick" ->
            circle(c, x + w / 2, y + h / 2, r, 0x304151)
            circle(c, x + w / 2, y + h / 2, r * 3 / 4, 0x111C27)
            circle(c, x + w / 2, y + h / 2, r / 3, 0x607B90)
        "buzzer" ->
            circle(c, x + w / 2, y + h / 2, r, 0x384957)
            circle(c, x + w / 2, y + h / 2, r * 3 / 4, 0x182433)
            text(c, x + 8, y + h / 2, "AUDIO OFF", MUTED, 1, (w - 16) / 6)
        _ ->
            fill(c, x, y, w, h, 0x344357)
            outline(c, x, y, w, h, 0x73889C)
            text(c, x + 7, y + h / 2 - 4, p.kind, INK, 1, (w - 14) / 6)
    if !e.label.is_empty()
        if p.kind == "led" then text(c, x + w + 7, y + h / 2 - 3, e.label, INK, 1, 24)
        else text(c, x, y + h + 7, e.label, INK, 1, 32)

private target(t: Target) -> string = t match
    Pin(name) -> name
    Bus(name) -> name
    Port(p, port) -> s"$p.$port"

private console(c: Canvas, bytes: []const u8)
    import sysl.raw.str_cast
    var start: usize = bytes.len
    var lines = 0
    while start > 0
        start -= 1
        if bytes[start] == 10
            lines += 1
            if lines == 7
                start += 1
                break
    var row = 0
    var at = start
    for i in start..bytes.len
        if i == bytes.len || bytes[i] == 10
            if row < 7 then text(c, 876, 552 + row * 14, str_cast(bytes[at..<i]), 0xA8D5BF, 1, 46)
            row += 1
            at = i + 1

render(c: Canvas, s: Scene, st: State, output: []const u8 = [])
    fill(c, 0, 0, WIDTH, HEIGHT, 0x0B1420)
    fill(c, 24, 22, 30, 30, ACCENT)
    text(c, 33, 30, "B", 0x0B2A22, 2)
    text(c, 70, 24, s.name, INK, 3, 39)
    text(c, 71, 57, if st.live then "FIRMWARE WORKBENCH" else "BOARD LAYOUT", MUTED, 1)
    fill(c, 971, 25, 205, 30, 0x172E2B)
    circle(c, 987, 40, 4, if st.live && !st.paused && !st.stopped then ACCENT else 0xE8C16A)
    text(c, 1001, 37, if st.live then st.status else "LAYOUT PREVIEW", if st.live then ACCENT else 0xE8C16A, 1, 27)
    button(c, 28, 130, if st.paused then "RESUME" else "PAUSE", st.live && !st.stopped, true)
    button(c, 170, 100, "STEP", st.live && !st.stopped)
    button(c, 282, 100, "RESET", st.live)
    button(c, 394, 140, "SAVE PNG", true)
    text(c, 560, 101, if st.live then "SPACE PAUSE   N STEP   R RESET" else "CLICK A PART TO INSPECT ITS WIRING", MUTED, 1, 80)
    fill(c, 24, 144, 808, 530, CARD)
    outline(c, 24, 144, 808, 530, EDGE)
    text(c, 43, 159, "BOARD", MUTED)
    val t = layout(s)
    if s.view.width > 0
        val w = int(f32(s.view.width) * t.scale)
        val h = int(f32(s.view.height) * t.scale)
        fill(c, int(t.x) + 5, int(t.y) + 7, w, h, 0x070D14)
        fill(c, int(t.x), int(t.y), w, h, parse_color(s.view.background))
        outline(c, int(t.x), int(t.y), w, h, 0x426450)
        for e in s.view.elements
            val (x, y, ew, eh) = coords(t, e)
            e.shows match
                Fill(color) ->
                    if look(e, "shape", "rect") == "round" then circle(c, x + ew / 2, y + eh / 2, (if ew < eh then ew else eh) / 2, parse_color(color))
                    else fill(c, x, y, ew, eh, parse_color(color))
                    if !e.label.is_empty()
                        val count = if int(e.label.bytes.len) < (ew - 8) / 6 then int(e.label.bytes.len) else (ew - 8) / 6
                        text(c, x + (ew - count * 6) / 2, y + eh / 2 - 3, e.label, INK, 1, count)
                Caption(value) -> text(c, x, y + 2, value, INK, if eh >= 21 then 2 else 1, ew / (if eh >= 21 then 12 else 6))
                ShowPart(name) ->
                    s.scope.find(name) match
                        Some(p) -> part(c, s, st, e, p, name, t)
                        None -> ()
    else
        fill(c, 182, 296, 490, 180, 0x1A2C3F)
        outline(c, 182, 296, 490, 180, 0x52728E)
        text(c, 206, 333, s.chip, INK, 3, 24)
        text(c, 206, 391, "NO BOARD LAYOUT SUPPLIED", MUTED, 1)
    fill(c, 856, 144, 320, 530, CARD)
    outline(c, 856, 144, 320, 530, EDGE)
    text(c, 876, 161, if st.live then "LIVE SESSION" else "DESCRIPTION PREVIEW", ACCENT, 2, 23)
    text(c, 876, 194, s.chip, INK, 1, 46)
    text(c, 876, 215, s.cores, MUTED, 1, 46)
    fill(c, 876, 240, 280, 1, EDGE)
    text(c, 876, 257, if st.live then f"PC   0x${st.pc}%08X" else "FIRMWARE IS NOT RUNNING", INK, 1)
    text(c, 876, 278, if st.live then s"RETIRED   ${st.instructions}" else "DEVICE STATES ARE NOT SIMULATED", MUTED, 1, 46)
    text(c, 876, 309, if st.selected.is_empty() then "PARTS / SIGNALS" else st.selected, ACCENT, 1, 46)
    s.scope.find(st.selected) match
        Some(p) ->
            text(c, 876, 332, p.kind, INK, 2)
            var row = 0
            for wire in p.wires
                if row >= 5 then break
                text(c, 876, 361 + row * 18, s"${wire.port} -> ${target(wire.to)}", MUTED, 1, 46)
                row += 1
            text(c, 876, 466, if st.live then "CONNECTED TO VIRTUAL GPIO" else "LAYOUT ONLY", if st.live then ACCENT else 0xE8C16A, 1)
        None ->
            var row = 0
            for p in s.scope.parts
                if row >= 7 then break
                text(c, 876, 334 + row * 21, p.name, INK, 1, 22)
                text(c, 1030, 334 + row * 21, if st.live && p.kind == "led" then (if lit(st, p) then "ON" else "OFF") else p.kind, if st.live && lit(st, p) then ACCENT else MUTED, 1, 20)
                row += 1
    fill(c, 868, 510, 296, 149, 0x080F18)
    text(c, 876, 525, if st.live then "GUEST CONSOLE" else "PREVIEW", MUTED)
    if st.live then console(c, output)
    else
        text(c, 876, 553, "LIVE FIRMWARE:", INK)
        text(c, 876, 578, "BENCHTOP DEMO", ACCENT, 2)
        text(c, 876, 616, "PICO BOOT / DEVICES ARE NEXT", MUTED, 1)
    text(c, 28, 700, if st.live then "HOLD 1 / 2 OR CLICK A BUTTON. LED STATES COME FROM GUEST WRITES." else "LAYOUT PREVIEW: REAL-BOARD PERIPHERALS AND BOOT ARE NOT EMULATED YET.", MUTED, 1, 165)
    text(c, 28, 724, if st.notice.is_empty() then "S SAVE PNG    ESC CLOSE" else st.notice, if st.notice.is_empty() then MUTED else ACCENT, 1, 165)
