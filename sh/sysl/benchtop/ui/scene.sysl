module sh.sysl.benchtop.ui

import sh.sysl.benchtop.*
import sh.sysl.benchtop.virt as virt
import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

const WIDTH: int = 1200
const HEIGHT: int = 760
const INK: u32 = 0xE4EEF8
const MUTED: u32 = 0x8DA3BA
const ACCENT: u32 = 0x60E5B6
const EDGE: u32 = 0x283D54
const CARD: u32 = 0x121F2E
const GROUND: u32 = 0x0D1420
const WARN: u32 = 0xE9BD72
const FAIL: u32 = 0xF25468
const CONSOLE_INK: u32 = 0xB6DCC9
const STATUS_FILL: u32 = 0x192E30
const SECONDARY: u32 = 0xA7B8CA
const ON_FILL: u32 = 0x102C24
const PANEL: u32 = 0x192C3B
const PCB_EDGE: u32 = 0x487160
const ICON_FILL: u32 = 0x193B40

// The parts' own colours: the surfaces, bezels and knobs of the controls and modules on a board.
const SURFACE: u32 = 0x17232E
const BEZEL: u32 = 0x507386
const WELL: u32 = 0x0C1C29
const KNOB: u32 = 0x38586B
const CONE: u32 = 0x314957
const BUZZER_BODY: u32 = 0x1A222B
const BUZZER_RIM: u32 = 0x657889
const BUZZER_SLOT: u32 = 0x070C12
const LED_SOCKET: u32 = 0x21353D
const GLINT: u32 = 0xE8FFF5
const KEY_BODY: u32 = 0x13232D
const KEY_IDLE: u32 = 0x536D7E
const KEY_RIM: u32 = 0x7B92A3
const GLASS: u32 = 0x080F17
const GLASS_RIM: u32 = 0x445A6C
const UNKNOWN_PART: u32 = 0x34475A
const SEGMENT_FILL: u32 = 0x100D13
const SEGMENT_RIM: u32 = 0x51303A
const TFT_FILL: u32 = 0x172C3D
const TFT_RIM: u32 = 0x638399
const OLED_FILL: u32 = 0x152C42
const OLED_RIM: u32 = 0x557E9A
const OLED_GLASS: u32 = 0x020A12
const OLED_PIXEL: u32 = 0x9BE9FF
const LCD_FILL: u32 = 0x183F36
const LCD_RIM: u32 = 0x668C6F
const LCD_GLASS: u32 = 0xA5BE63
const LCD_DOT_ON: u32 = 0x253A21
const LCD_DOT_OFF: u32 = 0x9BB65D

struct Scene
    name: string
    chip: string
    cores: string
    view: View
    scope: Scope
    keys: Buf[KeyBinding]
    pointers: Buf[PointerBinding]
    peripherals: Buf[Peripheral]

/** Who put a notice in the footer, so that one owner never clears another's. */
enum NoticeKind
    Empty
    Stop
    Reloaded
    Saved
    SaveFailed
    Pacing
    Audio
    Instrument

struct Notice
    kind: NoticeKind
    text: string

private[ui] no_notice() -> Notice = Notice(NoticeKind.Empty, "")

/** A key held down, and the part it is bound to. */
struct Held derives Eq
    key: string
    part: string

/** The desktop's view state: what is selected, and what the mouse and keyboard are holding. The run
 * state and the parts' controls belong to the session (`virt.Session`).
 */
struct State
    selected: string
    mouse_part: string
    held: Buf[Held]
    notice: Notice

state() -> State = State(selected = "", mouse_part = "", held = buf(), notice = no_notice())

open_scene(which: string) -> Result[Scene, string]
    val src = open_description(built_in_shelf(), which, "", Span(0, 0)) match
        Ok(s) -> s
        Err(d) -> return Err(d.message)
    val got = load(src, library())
    if got.report.has_errors() then return Err(got.report.render(src))
    scene(got.description, src.name)

/** The scene the description `d`, read from `file`, shows. A product with no view lays its boards side
 * by side, and the boards it shows whole bring their key and pointer bindings with them.
 */
scene(d: Description, file: string) -> Result[Scene, string]
    if d.form == ChipForm then return Err("choose a board or product to see its layout; a mcu has no view")
    if d.form == ProductForm
        val p = d.product
        val scope = Scope(p.parts, p.boards)
        val written = if p.view.width > 0 then p.view else side_by_side(p.boards) match
            Some(v) -> v
            None -> return Err(s"$file: the product `${p.name}` has no view, and none of its boards has one to lay out side by side")
        val view = drawing(written, scope)
        return Ok(Scene(p.name, "PRODUCT", s"${p.boards.len()} BOARD(S)", view, scope, window_keys(view, scope, p.keys), window_pointers(view, scope, p.pointers), buf()))
    val b = d.board
    var cores = ""
    for c in b.chip.cores
        if !cores.is_empty() then cores += " + "
        cores += c.name
    Ok(Scene(b.name, b.chip.name, cores, b.view, Scope(b.parts, buf()), b.keys, b.pointers, b.chip.peripherals))

/** A scale and an origin. The board is drawn at scale 1 from its panel's corner (`board_transform`),
 * and the same transform maps pointer input back to the board; `fit` letterboxes a size into another.
 */
struct Transform
    scale: f32
    x: f32
    y: f32

fit(width: int, height: int, into_width: int, into_height: int, x: int = 0, y: int = 0) -> Transform
    val sx = f32(into_width) / f32(width)
    val sy = f32(into_height) / f32(height)
    val scale = if sx < sy then sx else sy
    Transform(scale, f32(x) + (f32(into_width) - f32(width) * scale) / 2.0, f32(y) + (f32(into_height) - f32(height) * scale) / 2.0)

private[ui] coords(t: Transform, e: Element) -> (int, int, int, int) =
    (int(t.x + f32(e.x) * t.scale), int(t.y + f32(e.y) * t.scale), int(f32(e.w) * t.scale), int(f32(e.h) * t.scale))

private[ui] param(p: Part, key: string, fallback: string) -> string
    param_named(p.params, key) match
        Some(p) -> p.value match
            Text(value) -> value
            _ -> fallback
        None -> fallback

private[ui] look(e: Element, key: string, fallback: string) -> string
    param_named(e.look, key) match
        Some(p) -> p.value match
            Text(value) -> value
            _ -> fallback
        None -> fallback

release_inputs(st: *State)
    st.mouse_part = ""
    st.held.clear()

/** Key names are the description's canonical names (lower-case, e.g. "1", "up"). A key held is
 * remembered with its part, so two keys bound to the same part stay independent.
 */
key_input(s: Scene, st: *State, key: string, down: bool) -> bool
    var matched = false
    for binding in s.keys
        if binding.key != key then continue
        matched = true
        val held = Held(key, binding.part)
        var index: usize = 0
        while index < st.held.len() && st.held.at(index) != held do index += 1
        val found = index < st.held.len()
        if down && !found then st.held.push(held)
        if !down && found then st.held.remove(index)
    matched

/** Whether the mouse or a key is holding the named part down. */
private[ui] pressed(st: State, name: string) -> bool
    if st.mouse_part == name then return true
    for held in st.held do if held.part == name then return true
    false

/** The parts the window drives, each with the name the window gives it: a board's own, or a product's
 * and those of each board its view shows whole (`pico.btn`, which the session runs as `btn`). The
 * session knows a part by its own name, so where a board's part has the name of one already here —
 * the product's own, or an earlier board's — the first is the one driven, and the board's is left out.
 */
private[ui] window_parts(s: Scene) -> Buf[(string, Part)]
    var out: Buf[(string, Part)] = buf()
    for p in s.scope.parts do out.push((p.name, p))
    for e in s.view.elements
        e.shows match
            ShowBoard(name) -> s.scope.board(name) match
                Some(inst) ->
                    for p in inst.board.parts
                        var taken = false
                        for (_, q) in out do if q.name == p.name then taken = true
                        if !taken then out.push((s"$name.${p.name}", p))
                None -> ()
            _ -> ()
    out

private[ui] pot_names(d: &Desktop) -> Buf[string]
    var out: Buf[string] = buf()
    for control in d.pots do out.push(control.name)
    out

/** The elements a drag turns a knob by, each with the knob's window name: the product's own first,
 * then those of the boards it shows whole, less any one an element of the product's own knobs
 * overlaps — there the region is the product's.
 */
private[ui] knob_elements(s: Scene, knobs: Buf[string]) -> Buf[(Element, string)]
    var own: Buf[(Element, string)] = buf()
    var boards: Buf[(Element, string)] = buf()
    for e in s.view.elements
        e.shows match
            ShowPart(part) ->
                var knob = false
                for k in knobs do if k == part then knob = true
                if !knob then continue
                if on_board(s.view, e.name) then boards.push((e, part)) else own.push((e, part))
            _ -> ()
    var out: Buf[(Element, string)] = buf()
    for k in own do out.push(k)
    for (e, part) in boards
        var covered = false
        for (o, _) in own do if o.x < e.x + e.w && e.x < o.x + o.w && o.y < e.y + e.h && e.y < o.y + o.h then covered = true
        if !covered then out.push((e, part))
    out

// Whether the element `name` of the drawn view `v` is one of a board's shown whole (`pico.volume`).
private on_board(v: View, name: string) -> bool
    for e in v.elements
        e.shows match
            ShowBoard(b) -> if name.starts_with(s"$b.") then return true
            _ -> ()
    false

/** The parts the session holds: those the window drives, by the names the session runs them under. */
private[ui] session_parts(s: Scene) -> Buf[Part]
    var out: Buf[Part] = buf()
    for (_, p) in window_parts(s) do out.push(p)
    out

/** Report every button's state to the session: pressed while the mouse or a bound key holds it. */
private[ui] press_inputs(s: Scene, st: State, session: &virt.Session)
    for (name, p) in window_parts(s) do if p.kind == "button" || p.kind == "reset-button" then session.set_part_input(p.name, virt.PartInput.Pressed(pressed(st, name)))

private[ui] target(t: Target) -> string = t match
    Pin(name) -> name
    Bus(name) -> name
    Port(p, port) -> s"$p.$port"
