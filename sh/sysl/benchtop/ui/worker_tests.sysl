module sh.sysl.benchtop.ui
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.ui as ui
import sysl.time.{monotonic,millis}
import sysl.threads.current

@test("desktop CPU workers: UI reads snapshots while execution continues, then pauses, steps and resets safely")
desktop_worker_controls()
    val d = instrument_desktop()
    val c = virt.core0()
    val image = virt.image_of(embed("../../../../examples/visual/demo.elf")).unwrap()
    virt.start_workers(c,true,12000000).unwrap()
    defer virt.stop_workers()
    d.background = true
    d.parallel = true
    val count = ui.signal(0u64)
    desktop_tick(d,c,image.view(),0,count,"",500000000)
    val until = monotonic() + millis(25)
    while monotonic() < until do ()
    desktop_tick(d,c,image.view(),0,count,"",500000000)
    assert(d.current.read().instructions > 0)
    val ids = virt.workers_observe().worker_ids
    assert(ids[0] != current().id && ids[1] != current().id)
    assert(rasterize(d).is_ok(),"live UI rendering must safely observe independently running devices")
    pause(d)
    desktop_tick(d,c,image.view(),0,count,"")
    val paused = virt.workers_observe().cores[0].retired
    assert(d.current.read().paused && d.current.read().instructions == paused)
    d.stepping.set(true)
    desktop_tick(d,c,image.view(),0,count,"")
    assert(d.current.read().paused && virt.workers_observe().cores[0].retired == paused + 1)
    d.resetting.set(true)
    desktop_tick(d,c,image.view(),0,count,"")
    pause(d)
    assert(virt.workers_observe().worker_ids == ids)
    assert(!d.current.read().stopped)
