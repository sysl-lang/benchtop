module sh.sysl.benchtop

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// What the window draws for a checked view. A board's view is drawn as written; a product's may show
// a board whole (`pico { show = pico, at = [124, 54] }`), and that board's own view is drawn in place,
// so the window never has to know a board can sit inside a product.

/** The view `v` with every board it shows whole drawn in place, every element in the view's own pixels
 * and in drawing order. The element that shows a board stays, as `ShowBoard`, and draws the board's
 * background; the board's elements follow it, named as the product names them (`pico.led`, showing
 * `pico.led`), moved to where the board sits and turned with it. Each one's `rotate` is its own turn
 * plus the board's, so a screen in a board turned 90° is turned 90° more.
 */
drawing(v: View, scope: Scope) -> View
    var out: Buf[Element] = buf()

    for e in v.elements
        out.push(e)

        e.shows match
            ShowBoard(name) -> scope.board(name) match
                Some(inst) -> place_board(&out, e, inst.board.view, name)
                None -> ()
            _ -> ()

    View(v.width, v.height, v.background, out, v.span)

// The board view `bv` drawn into the element `at`, which the checker has sized to the board turned.
private place_board(out: *Buf[Element], at: Element, bv: View, board: string)
    val turn = rotation(at)

    for e in bv.elements
        val (x, y, w, h) = turned(e.x, e.y, e.w, e.h, bv.width, bv.height, turn)
        val shows = e.shows match
            ShowPart(p) -> ShowPart(s"$board.$p")
            other -> other

        out.push(Element(s"$board.${e.name}", e.name_span, shows, e.shows_span, at.x + x, at.y + y, w, h,
            e.has_size, e.natural, e.label, turned_look(e.look, (rotation(e) + turn) % 360), e.span))
    end for
end place_board

/** The box `x, y, w, h` in a `width × height` view, after the view is turned `turn` degrees clockwise
 * (0, 90, 180 or 270) and its corner put back at the origin.
 */
turned(x: int, y: int, w: int, h: int, width: int, height: int, turn: int) -> (int, int, int, int) = turn match
    90 -> (height - y - h, x, h, w)
    180 -> (width - x - w, height - y - h, w, h)
    270 -> (y, width - x - w, h, w)
    _ -> (x, y, w, h)

// A copy of `look` whose `rotate` is `turn`, and which has none where `turn` is 0.
private turned_look(look: Buf[Param], turn: int) -> Buf[Param]
    var out: Buf[Param] = buf()

    for l in look do if l.name != "rotate" then out.push(l)

    if turn != 0 then out.push(Param("rotate", Span(0, 0), Whole(turn), Span(0, 0)))

    out
