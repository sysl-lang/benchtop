module sh.sysl.benchtop

import sh.sysl.parsing.Span
import sysl.buf.{Buf, buf}

// What the window draws for a checked view. A board's view is drawn as written; a product's may show
// a board whole (`pico { show = pico, at = [124, 54] }`), and that board's own view is drawn in place,
// so the window never has to know a board can sit inside a product.

/** The view `v` with every board it shows whole drawn in place, every element in the view's own pixels
 * and in drawing order. The element that shows a board stays, as `ShowBoard`, and draws the board's
 * background; the board's elements follow it, named as the product names them (`pico.led`, showing
 * `pico.led`), moved to where the board sits and turned with it. Each one's `rotate` is its own turn
 * plus the board's, so a screen in a board turned 90° is turned 90° more.
 */
drawing(v: View, scope: Scope) -> View
    var out: Buf[Element] = buf()

    for e in v.elements
        out.push(e)

        e.shows match
            ShowBoard(name) -> scope.board(name) match
                Some(inst) -> place_board(&out, e, inst.board.view, name)
                None -> ()
            _ -> ()

    View(v.width, v.height, v.background, out, v.span)

/** The gap between two boards a product with no view lays side by side, and the margin around them. */
val SIDE_BY_SIDE_GAP = 24

/** The view of a product that writes none: each of its boards with a view of its own shown whole, left
 * to right in the order they are written, tops aligned, `SIDE_BY_SIDE_GAP` apart and as far from the
 * edge, on black. A board with no view is left out; `None` where no board has one.
 */
side_by_side(boards: Buf[Instance]) -> Option[View]
    var out: Buf[Element] = buf()
    var x = SIDE_BY_SIDE_GAP
    var tallest = 0

    for inst in boards
        val bv = inst.board.view

        if !inst.found || bv.width <= 0 || bv.height <= 0 then continue

        out.push(Element(inst.name, inst.name_span, ShowBoard(inst.name), inst.name_span, x, SIDE_BY_SIDE_GAP,
            bv.width, bv.height, true, true, "", buf(), inst.name_span))
        x += bv.width + SIDE_BY_SIDE_GAP
        if bv.height > tallest then tallest = bv.height
    end for

    if out.is_empty() then return None

    Some(View(x, tallest + 2 * SIDE_BY_SIDE_GAP, "black", out, Span(0, 0)))
end side_by_side

// The boards the drawn view `v` shows whole, in drawing order.
private shown_whole(v: View, scope: Scope) -> Buf[Instance]
    var out: Buf[Instance] = buf()

    for e in v.elements
        e.shows match
            ShowBoard(name) -> scope.board(name) match
                Some(inst) -> out.push(inst)
                None -> ()
            _ -> ()

    out

/** The key bindings a product's window holds: the product's own, then those of each board the drawn
 * view `v` shows whole, naming the board's part as the product names it (`pico.btn`). A key the
 * product binds is the product's alone, so a board's binding of the same key is left out.
 */
window_keys(v: View, scope: Scope, own: Buf[KeyBinding]) -> Buf[KeyBinding]
    var out: Buf[KeyBinding] = buf()

    for k in own do out.push(k)

    for inst in shown_whole(v, scope)
        for k in inst.board.keys
            var taken = false

            for o in own do if o.key == k.key then taken = true

            if !taken then out.push(KeyBinding(k.key, k.key_span, s"${inst.name}.${k.part}", k.control, k.span))
    end for

    out
end window_keys

/** The pointer bindings a product's window holds: the product's own, then those of each board the
 * drawn view `v` shows whole, naming the board's element and part as the product names them
 * (`pico.screen`, `pico.touch`), so each is hit where the board sits. Where an element the product
 * binds overlaps the board's, the region is the product's, and the board's binding is left out.
 */
window_pointers(v: View, scope: Scope, own: Buf[PointerBinding]) -> Buf[PointerBinding]
    var out: Buf[PointerBinding] = buf()

    for pb in own do out.push(pb)

    for inst in shown_whole(v, scope)
        for pb in inst.board.pointers
            val element = s"${inst.name}.${pb.element}"
            var taken = false

            for o in own do if overlap(v, o.element, element) then taken = true

            if !taken then out.push(PointerBinding(element, pb.element_span, s"${inst.name}.${pb.part}", pb.span))
    end for

    out
end window_pointers

/** The pointer binding of `bindings` an event at `x, y` in the view's pixels reaches: the first whose
 * element holds the point, as the window tries them, or `None`.
 */
pointer_at(v: View, bindings: Buf[PointerBinding], x: int, y: int) -> Option[PointerBinding]
    for pb in bindings
        element_named(v, pb.element) match
            Some(e) -> if x >= e.x && y >= e.y && x < e.x + e.w && y < e.y + e.h then return Some(pb)
            None -> ()

    None

private element_named(v: View, name: string) -> Option[Element]
    for e in v.elements do if e.name == name then return Some(e)

    None

// Whether the elements `a` and `b` of `v` cover some pixel in common.
private overlap(v: View, a: string, b: string) -> bool
    val ea = element_named(v, a) match
        Some(e) -> e
        None -> return false
    val eb = element_named(v, b) match
        Some(e) -> e
        None -> return false

    ea.x < eb.x + eb.w && eb.x < ea.x + ea.w && ea.y < eb.y + eb.h && eb.y < ea.y + ea.h

// The board view `bv` drawn into the element `at`, which the checker has sized to the board turned.
private place_board(out: *Buf[Element], at: Element, bv: View, board: string)
    val turn = rotation(at)

    for e in bv.elements
        val (x, y, w, h) = turned(e.x, e.y, e.w, e.h, bv.width, bv.height, turn)
        val shows = e.shows match
            ShowPart(p) -> ShowPart(s"$board.$p")
            other -> other

        out.push(Element(s"$board.${e.name}", e.name_span, shows, e.shows_span, at.x + x, at.y + y, w, h,
            e.has_size, e.natural, e.label, turned_look(e.look, (rotation(e) + turn) % 360), e.span))
    end for
end place_board

/** The box `x, y, w, h` in a `width × height` view, after the view is turned `turn` degrees clockwise
 * (0, 90, 180 or 270) and its corner put back at the origin.
 */
turned(x: int, y: int, w: int, h: int, width: int, height: int, turn: int) -> (int, int, int, int) = turn match
    90 -> (height - y - h, x, h, w)
    180 -> (width - x - w, height - y - h, w, h)
    270 -> (y, width - x - w, h, w)
    _ -> (x, y, w, h)

// A copy of `look` whose `rotate` is `turn`, and which has none where `turn` is 0.
private turned_look(look: Buf[Param], turn: int) -> Buf[Param]
    var out: Buf[Param] = buf()

    for l in look do if l.name != "rotate" then out.push(l)

    if turn != 0 then out.push(Param("rotate", Span(0, 0), Whole(turn), Span(0, 0)))

    out
