module sh.sysl.benchtop
@tests

import sh.sysl.parsing.source_of

private options_board(cores: string) -> string = s"chip { name = options, cores = [$cores] }"

private read_options(cores: string) -> Loaded = load(source_of("options.hocon", options_board(cores)), library())

private option_error(cores: string, message: string)
    val got = read_options(cores)
    assert(got.report.has_errors(), cores)
    assert(got.report.render(source_of("options.hocon", options_board(cores))).contains(message), message)

@test("plain names and explicit core blocks share suitable defaults; partial overrides preserve them")
core_options_defaults()
    for name in ["cortex-m0plus", "cortex-m4", "cortex-m7", "cortex-m33"]
        val got = read_options(s"$name, { core = $name }, { core = $name, fpu = none }")
        assert(!got.report.has_errors(), name)
        for c in got.description.chip.cores
            assert(setting_text(core_option(c, "fpu")) == "none")
            assert(setting_text(core_option(c, "dsp")) == (if name == "cortex-m4" || name == "cortex-m7" then "true" else "false"), name)
            assert(setting_text(core_option(c, "mpu_regions")) == "0")
            assert(setting_text(core_option(c, "security")) == "none")
            assert(setting_text(core_option(c, "icache")) == "false" && setting_text(core_option(c, "dcache")) == "false")
            assert(setting_text(core_option(c, "nvic_priority_bits")) == (if name == "cortex-m0plus" then "2" else "4"))
            assert(unemulated_core_option(c).is_none())
end core_options_defaults

@test("core options round-trip, retain independent per-core values and appear in the summary")
core_options_round_trip()
    val got = read_options("{ core = cortex-m7, nvic_priority_bits = 3 }, { core = cortex-m7, fpu = dp, mpu_regions = 16, icache = true, dcache = true }")
    assert(!got.report.has_errors())
    val text = description_text(got.description)
    val again = load(source_of("again.hocon", text), library())
    assert(!again.report.has_errors() && description_text(again.description) == text, text)
    assert(setting_text(core_option(again.description.chip.cores.at(0), "nvic_priority_bits")) == "3")
    assert(setting_text(core_option(again.description.chip.cores.at(1), "nvic_priority_bits")) == "4")
    val shown = summary(got.description, library())
    assert(shown.contains("nvic_priority_bits = 3") && shown.contains("fpu = dp"), shown)
end core_options_round_trip

@test("valid hardware features can be described while unsupported emulation is explicit")
core_options_describe_features()
    for configured in ["core = cortex-m4, dsp = true, fpu = sp, mpu_regions = 8",
                       "core = cortex-m33, security = trustzone, mpu_regions = 12",
                       "core = cortex-m7, fpu = dp, icache = true, dcache = true"]
        val got = read_options(s"{ $configured }")
        assert(!got.report.has_errors(), configured)
        assert(unemulated_core_option(got.description.chip.cores.at(0)).is_some(), configured)
end core_options_describe_features

@test("core option diagnostics cover unknown names, wrong types, invalid models and range boundaries")
core_options_diagnostics()
    option_error("{}", "a core configuration names no core")
    option_error("{ core = 7 }", "must be a word or a quoted string")
    option_error("{ core = cortex-m7, typo = true }", "has no option `typo`")
    option_error("{ core = cortex-m7, dsp = yes }", "must be `true` or `false`")
    option_error("{ core = cortex-m7, fpu = true }", "must be one of")
    option_error("{ core = cortex-m4, fpu = dp }", "must be one of")
    option_error("{ core = cortex-m0plus, dsp = true }", "does not support `dsp`")
    option_error("{ core = cortex-m4, dsp = false }", "`cortex-m4` always has the DSP extension")
    option_error("{ core = cortex-m7, dsp = false }", "`cortex-m7` always has the DSP extension")
    option_error("{ core = cortex-m33, icache = true }", "does not support `icache`")
    option_error("{ core = cortex-m4, security = trustzone }", "must be one of")
    option_error("{ core = cortex-m7, mpu_regions = 7 }", "invalid region count")
    option_error("{ core = cortex-m33, mpu_regions = 6 }", "invalid region count")
    option_error("{ core = cortex-m7, mpu_regions = 17 }", "must be from 0 to 16")
    option_error("{ core = cortex-m7, mpu_regions = -1 }", "must be from 0 to 16")
    option_error("{ core = cortex-m7, nvic_priority_bits = 2 }", "must be from 3 to 8")
    option_error("{ core = cortex-m7, nvic_priority_bits = 9 }", "must be from 3 to 8")
    option_error("{ core = cortex-m0plus, nvic_priority_bits = 3 }", "must be from 2 to 2")
    option_error("{ core = cortex-m7, fpu = [] }", "must be a single value")
end core_options_diagnostics

@test("duplicate settings inside a core array retain their source location and are not merged silently")
core_options_duplicates()
    option_error("{ core = cortex-m7, fpu = none, fpu = sp }", "core setting `fpu` is set twice")
    option_error("{ core = cortex-m4, core = cortex-m7 }", "core setting `core` is set twice")
    val got = read_options("{ core = cortex-m7, fpu = none }, { core = cortex-m7, fpu = none }")
    assert(!got.report.has_errors(), "separate cores are not duplicate definitions")
end core_options_duplicates
