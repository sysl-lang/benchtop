module sh.sysl.benchtop
@tests

import sh.sysl.parsing.source_of
import sysl.raw.str_cast
import sysl.text.replace_all

private val LCD_BOARD = str_cast(embed("../../../boards/workbench.hocon"))

@test("LCD description: catalog LCD terminals and dimensions validate and round trip")
lcd_description()
    val src = source_of("lcd.hocon", LCD_BOARD)
    val got = load(src, library())
    assert(!got.report.has_errors(), got.report.render(src))
    val p = got.description.board.parts.at(7)
    assert(p.kind == "hd44780" && p.reference == "DS2" && p.wires.len() == 7)
    val written = description_text(got.description)
    val again = load(source_of("again.hocon", written), library())
    assert(!again.report.has_errors() && description_text(again.description) == written)
    for pair in [
        ("columns = 20", "columns = 41"),
        ("rows = 2", "rows = 4"),
        ("rs = controller.GP3", "rs = controller.GP33"),
        ("rw = controller.GP5,", ""),
        ("columns = 20", "instruction-cycles = 0, columns = 20")]
        val invalid = source_of("bad.hocon", replace_all(LCD_BOARD, pair.0, pair.1))
        assert(load(invalid, library()).report.has_errors(), pair.1)
