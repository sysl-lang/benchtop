module sh.sysl.benchtop.host
@requires(posix)
@tests

import sysl.buf.{Buf, buf}
import sysl.fs.{File, is_file}
import sysl.io.Reader
import sysl.process.{pipe, spawn, Stdio}
import sysl.raw.str_cast
import sysl.testing.skip

// What a guest prints reaches its destination line by line, whatever the destination is.

// The next `n` bytes arriving on `r`, read one at a time (a file read fills its buffer, so a bigger
// buffer would wait for more than has been sent).
private arrived(r: File, n: usize) -> string
    var reader = r
    val got: Buf[u8] = buf()
    var chunk: []u8 = [0; 1]
    while got.len() < n
        val some = reader.read(chunk)
        if some.len == 0 then break
        got.push(some[0])
    str_cast(got.view())

// `show_console` over a pipe whose writer stays open: each completed line is readable at once, an
// unfinished line is not sent, and `last` sends what is left. The pipe's writer is a buffered `File`,
// so a missing `push` leaves these reads waiting for good.
@test("show_console: each completed line reaches an open pipe, the unfinished one waits for its end")
show_console_sends_lines_to_an_open_pipe()
    val (r, w) = pipe().unwrap()
    var out = w
    val text = "one\r\ntwo\r\nthr"
    val put: &Fn([]const u8) -> unit = b -> out.write(b)
    val push: &Fn() -> unit = () -> out.flush().unwrap()

    var shown = show_console(text.bytes, 0, false, put, push)
    assert_eq(shown, 10)
    assert_eq(arrived(r, 10), "one\r\ntwo\r\n")

    shown = show_console(text.bytes, shown, false, put, push)
    assert_eq(shown, 10)

    val more = "one\r\ntwo\r\nthree\r\nfo"
    shown = show_console(more.bytes, shown, false, put, push)
    assert_eq(shown, 17)
    assert_eq(arrived(r, 7), "three\r\n")

    shown = show_console(more.bytes, shown, true, put, push)
    assert_eq(shown, 19)
    assert_eq(arrived(r, 2), "fo")

    out.close().unwrap()
    var reader = r
    reader.close().unwrap()

// The same through the `benchtop` command itself: `run` on the pico2 `hello_serial` program, which
// prints a line every 100 ms of guest time and never ends, with its stdout a pipe. Needs the binary
// `sysl build .` writes beside the manifest; the test above is the one that always runs.
@test("benchtop run: guest console lines reach a pipe while the guest still runs")
console_lines_reach_a_pipe_before_exit()
    if !is_file("benchtop") || !is_file("examples/pico2/hello_serial.elf")
        skip("needs ./benchtop built with `sysl build .`")

    val (r, w) = pipe().unwrap()
    val child = spawn("./benchtop", ["run", "--board", "pico2", "examples/pico2/hello_serial.elf"],
                      stdout = Stdio.ToFile(w)).unwrap()

    var closing = w
    closing.close().unwrap()

    val got = arrived(r, 34)
    child.kill().unwrap()
    child.wait().unwrap()
    var reader = r
    reader.close().unwrap()

    assert_eq(got, "hello, serial 0\r\nhello, serial 1\r\n")
