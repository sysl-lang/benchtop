module sh.sysl.benchtop.host
@requires(posix)
@tests

import sysl.fs.is_file
import sysl.io.Reader
import sysl.process.{pipe, spawn, Stdio}
import sysl.raw.str_cast
import sysl.buf.{Buf, buf}

// What a guest prints reaches stdout line by line, whatever stdout is. `benchtop run` is started on
// the pico2 `hello_serial` program, which prints a line every 100 ms of guest time and never ends,
// with its stdout a pipe. The first line has to arrive while benchtop is still running: a console
// buffered until exit would leave this read waiting for good. Needs the `benchtop` binary that
// `sysl build .` writes beside the manifest, so it says so and passes when there is none.
@test("benchtop run: guest console lines reach a pipe while the guest still runs")
console_lines_reach_a_pipe_before_exit()
    if !is_file("benchtop") || !is_file("examples/pico2/hello_serial.elf")
        print("console_pipe_tests: no ./benchtop built here, so the pipe is not driven")
        return

    val (r, w) = pipe().unwrap()
    val child = spawn("./benchtop", ["run", "--board", "pico2", "examples/pico2/hello_serial.elf"],
                      stdout = Stdio.ToFile(w)).unwrap()

    var closing = w
    closing.close().unwrap()

    var reader = r
    val got: Buf[u8] = buf()
    // A file read fills its buffer, so one byte at a time is how a pipe is read as it arrives.
    var chunk: []u8 = [0; 1]
    var lines = 0
    while lines < 2
        val some = reader.read(chunk)
        if some.len == 0 then break
        got.push(some[0])
        if some[0] == 10 then lines += 1

    child.kill().unwrap()
    child.wait().unwrap()
    reader.close().unwrap()

    assert_eq(str_cast(got.view()), "hello, serial 0\r\nhello, serial 1\r\n")
