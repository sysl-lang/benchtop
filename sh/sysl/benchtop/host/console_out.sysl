module sh.sysl.benchtop.host

// Write the guest's console text from index `shown` on through `put`, then `push` it on to wherever
// it is going, so it reaches a pipe or file as promptly as a terminal. Until `last`, only up to the
// final newline goes out: a line is the unit, and the unfinished one waits for its end. Returns how
// much of `text` has been written. `put` and `push` are stdout's `putbytes` and `flush` in the
// `run` command; a test hands in a pipe's.
show_console(text: []const u8, shown: usize, last: bool, put: &Fn([]const u8) -> unit,
             push: &Fn() -> unit) -> usize
    var upto = text.len
    if !last
        upto = shown
        for i in shown..<text.len do if text[i] == 10 then upto = i + 1
    if upto > shown
        put(text[shown..<upto])
        push()
    upto
