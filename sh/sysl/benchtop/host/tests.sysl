module sh.sysl.benchtop.host
@tests

import sysl.fs.{make_temp_dir, write_bytes, write_text, rename, read_bytes}
import sysl.posix.time.monotonic
import sysl.time.{millis, Duration}
import sysl.text.Search
import sysl.raw.str_cast
import sysl.buf.buf

private firmware(value: u8) -> []const u8 = [0, 0, 16, 0, 9, 0, 0, 0, value, 32, 254, 231]

private wait_for(w: &Workflow, condition: &Fn() -> bool, limit: Duration = millis(4000)) -> bool
    val end = monotonic() + limit
    while monotonic() < end
        poll(w, true)
        if condition() then return true
    false

private drive(w: &Workflow, time: Duration)
    val end = monotonic() + time
    while monotonic() < end do poll(w, true)

@test("host workflow: atomic firmware replacement reloads once, identical bytes do not reset")
watch_replace()
    val dir = make_temp_dir("benchtop-watch").unwrap()
    val file = s"$dir/firmware.bin"
    write_bytes(file, firmware(1)).unwrap()
    var c = config()
    c.watch = true
    val w = open(c, file, firmware(1)).unwrap()
    defer close(w).unwrap()
    drive(w, millis(200))
    write_bytes(s"$dir/new.bin", firmware(2)).unwrap()
    rename(s"$dir/new.bin", file).unwrap()
    assert(wait_for(w, () -> w.pending.is_some()), str_cast(w.log.view()))
    val image = take_image(w).unwrap()
    assert(image.at(8) == 2 && w.reloads == 1)
    write_bytes(s"$dir/new.bin", firmware(2)).unwrap()
    rename(s"$dir/new.bin", file).unwrap()
    drive(w, millis(600))
    assert(w.pending.is_none() && w.reloads == 1)
    write_bytes(s"$dir/new.bin", firmware(3)).unwrap()
    rename(s"$dir/new.bin", file).unwrap()
    assert(wait_for(w, () -> w.pending.is_some()))
    assert(take_image(w).unwrap().at(8) == 3 && w.reloads == 2)

@test("host workflow: malformed reload keeps the last working image and a later save recovers")
invalid_then_repair()
    val dir = make_temp_dir("benchtop-reload").unwrap()
    val file = s"$dir/firmware.bin"
    write_bytes(file, firmware(1)).unwrap()
    var c = config()
    c.watch = true
    val w = open(c, file, firmware(1)).unwrap()
    defer close(w).unwrap()
    drive(w, millis(200))
    write_bytes(file, [0]).unwrap()
    assert(wait_for(w, () -> w.failed))
    assert(w.pending.is_none() && w.last_good[8] == 1)
    assert(str_cast(w.log.view()).contains("keeping the running firmware"))
    write_bytes(file, firmware(4)).unwrap()
    assert(wait_for(w, () -> w.pending.is_some()))
    assert(take_image(w).unwrap().at(8) == 4 && !w.failed)
    assert(checked_image([]).is_err() && checked_image([0; 12]).is_err())

@test("host workflow: build stdout and stderr stream before exit and successful output reloads")
build_streams()
    val dir = make_temp_dir("benchtop-build").unwrap()
    val file = s"$dir/firmware.bin"
    val source = s"$dir/input.bin"
    write_bytes(file, firmware(1)).unwrap()
    write_bytes(source, firmware(5)).unwrap()
    var c = config()
    c.program = "/bin/sh"
    c.args.push("-c")
    c.args.push(s"printf 'stdout ready\\n'; printf 'stderr ready\\n' >&2; sleep 0.2; cp '$source' '$file'")
    val w = open(c, file, firmware(1)).unwrap()
    defer close(w).unwrap()
    assert(wait_for(w, () -> str_cast(w.log.view()).contains("stderr ready")))
    assert(w.building && str_cast(w.log.view()).contains("stdout ready"))
    assert(wait_for(w, () -> w.pending.is_some()), str_cast(w.log.view()))
    assert(take_image(w).unwrap().at(8) == 5 && w.builds == 1 && !w.failed)
    assert(w.readers.len() == 0)

@test("host workflow: failed builds preserve firmware, retry succeeds, diagnostics are bounded")
build_failure_retry()
    val dir = make_temp_dir("benchtop-retry").unwrap()
    val file = s"$dir/firmware.bin"
    write_bytes(file, firmware(1)).unwrap()
    var c = config()
    c.program = "/bin/sh"
    c.args.push("-c")
    c.args.push("printf 'broken build\\n' >&2; exit 7")
    val w = open(c, file, firmware(1)).unwrap()
    defer close(w).unwrap()
    assert(wait_for(w, () -> w.failed))
    assert(w.status == "Build failed (exit 7)" && w.pending.is_none() && w.last_good[8] == 1)
    w.config.args = buf()
    w.config.args.push("-c")
    w.config.args.push("exit 0")
    request_build(w)
    assert(wait_for(w, () -> w.builds == 2 && !w.building && !w.failed))
    for i in 0..<1000 do note(w, "a bounded diagnostic line of text")
    assert(w.log.len() <= 16384)

@test("host workflow: source changes debounce, unrelated outputs do not rebuild, watcher survives rename")
source_debounce()
    val dir = make_temp_dir("benchtop-source").unwrap()
    val file = s"$dir/firmware.bin"
    val source = s"$dir/main.sysl"
    write_bytes(file, firmware(1)).unwrap()
    write_text(source, "first").unwrap()
    var c = config()
    c.program = "/usr/bin/true"
    c.sources.push(source)
    val w = open(c, file, firmware(1)).unwrap()
    defer close(w).unwrap()
    assert(wait_for(w, () -> w.builds >= 1 && w.status == "Firmware unchanged"), str_cast(w.log.view()))
    write_text(s"$dir/generated.a", "not a source").unwrap()
    drive(w, millis(350))
    assert(w.builds == 1)
    write_text(source, "second").unwrap()
    write_text(source, "third").unwrap()
    write_text(s"$dir/replacement", "fourth").unwrap()
    rename(s"$dir/replacement", source).unwrap()
    assert(wait_for(w, () -> w.builds == 2 && w.status == "Firmware unchanged"))
    drive(w, millis(400))
    assert(w.builds == 2)
    write_text(source, "fifth").unwrap()
    assert(wait_for(w, () -> w.builds == 3))

@test("host workflow: shutdown cancels active process and closes all libuv handles")
shutdown()
    val dir = make_temp_dir("benchtop-close").unwrap()
    val file = s"$dir/firmware.bin"
    write_bytes(file, firmware(1)).unwrap()
    var c = config()
    c.program = "/bin/sleep"
    c.args.push("10")
    val w = open(c, file, firmware(1)).unwrap()
    assert(wait_for(w, () -> w.process.is_some()))
    val before = monotonic()
    close(w).unwrap()
    assert(monotonic() - before < millis(1000))
    assert(w.closed && w.lp.running() == 0)
    close(w).unwrap()
    var bad = config()
    bad.args.push("orphan")
    assert(validate(bad, file).is_err())
    bad = config()
    bad.sources.push(file)
    assert(validate(bad, file).is_err())
    bad.program = "/usr/bin/true"
    assert(validate(bad, file).is_err())

@test("host workflow: edits during a build queue one follow-up and skip the stale image")
edit_during_build()
    val dir = make_temp_dir("benchtop-queued-build").unwrap()
    val file = s"$dir/firmware.bin"
    val source = s"$dir/source.bin"
    write_bytes(file, firmware(1)).unwrap()
    write_bytes(source, firmware(2)).unwrap()
    var c = config()
    c.program = "/bin/sh"
    c.args.push("-c")
    c.args.push(s"cp '$source' '$file'; printf 'captured\\n'; sleep 0.5")
    c.sources.push(source)
    val w = open(c, file, firmware(1)).unwrap()
    defer close(w).unwrap()
    assert(wait_for(w, () -> w.building && str_cast(w.log.view()).contains("captured")))
    write_bytes(source, firmware(3)).unwrap()
    write_bytes(source, firmware(4)).unwrap()
    assert(wait_for(w, () -> w.builds == 2 && w.pending.is_some()), str_cast(w.log.view()))
    assert(take_image(w).unwrap().at(8) == 4)
    drive(w, millis(300))
    assert(w.builds == 2 && w.reloads == 1)
