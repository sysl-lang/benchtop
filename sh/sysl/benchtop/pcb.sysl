module sh.sysl.benchtop

import sysl.buf.{Buf, buf}

// The printed circuits of the Raspberry Pi Pico boards, as a board's view draws them under its
// elements (`view { pcb = pico2 }`), and of the DS3231 module, as the window draws that part. Each is the board's real body at the parts' own scale,
// `PART_PX_PER_MM`, 5 px/mm, so a 21 × 51 mm board is 105 × 255 pixels. Positions are taken from
// Raspberry Pi's mechanical drawings, written here in hundredths of a millimetre from the board's
// top-left corner with the micro-USB connector at the top:
//
// - the Pico: *Raspberry Pi Pico Datasheet*, §2 "Mechanical specification", Figure 3, "The
//   dimensions of the Raspberry Pi Pico Rev3 board";
// - the Pico 2: *Raspberry Pi Pico 2 Datasheet*, §3 "Mechanical specification", Figure 3, "The
//   dimensions of the Raspberry Pi Pico 2 board";
// - the Pico 2 W: *Raspberry Pi Pico 2 W Datasheet*, §2 "Mechanical specification", Figure 3, "The
//   dimensions of the Pico 2 W".
//
// The drawings fix the outline, the 2.54 mm header grid 17.78 mm across, the four 2.1 mm holes
// 11.4 × 47 mm apart, the 8 mm USB connector overhanging the top edge by 1.3 mm, and the debug
// pads; the packages are placed where the drawings outline them. The small resistors and
// capacitors are the drawings' too, fewer of them. Each pad's name is printed beside it, in a
// gutter left and right of the board, as Raspberry Pi's pinout figures print them (the real board
// prints only pin numbers on its top side).

/** What one item of a printed circuit drawing is, which decides how the window paints it. */
enum PcbShape
    SolderMask
    AntennaKeepout
    Castellation
    CopperPad
    DrillHole
    IcPackage
    ChipPassive
    PowerInductor
    TinPlate
    TinShade
    ShieldCan
    CrystalBase
    ButtonCap
    CathodeBand
    ChipLed
    SilkOutline
    SilkText
end PcbShape

/** Which side of its box a pad's name keeps to. */
enum PcbAlign
    AlignStart
    AlignMiddle
    AlignEnd

/** One item of the drawing, in the view's pixels with the board upright; `text` is a package's
 * marking or the silkscreen's words.
 */
struct PcbItem
    shape: PcbShape
    x: int
    y: int
    w: int
    h: int
    text: string

/** One pad a wire can reach: its name (`GP0`, `GND`, `SWCLK`), its header pin number (1 to 40, or 0
 * for a debug pad), and the centre of its hole in the view's pixels.
 */
struct PcbPin
    name: string
    number: int
    x: int
    y: int

/** A pad's name, printed in the box `x, y, w, h`, `size` pixels high. */
struct PcbLabel
    text: string
    x: int
    y: int
    w: int
    h: int
    align: PcbAlign
    size: int

/** The drawing of one board: the view's size, where the board lies in it, what is drawn in order,
 * the pads with their names, and the centre of the LED's footprint, where the board's `led` part
 * is placed.
 */
struct PcbArt
    name: string
    width: int
    height: int
    board_x: int
    board_y: int
    board_w: int
    board_h: int
    items: Buf[PcbItem]
    pins: Buf[PcbPin]
    labels: Buf[PcbLabel]
    led_x: int
    led_y: int

/** The width of the gutter each side of the board that holds the pads' names. */
const PCB_GUTTER: int = 40

/** How far the board's top edge is from the view's: room for the USB connector's 1.3 mm overhang. */
const PCB_OVERHANG: int = 7

// The room under a board whose debug pads are on its bottom edge, for their names.
private const SWD_ROW: int = 22

/** The drawings there are, by the name a view's `pcb` gives. */
pcb_names() -> string = "pico, pico2, pico2w"

/** The drawing `name` names (`pico`, `pico2`, `pico2w`), or `None`. */
pcb_art(name: string) -> Option[PcbArt] = name match
    "pico" -> Some(pico(name, "RP2040", "Pico"))
    "pico2" -> Some(pico(name, "RP2350", "Pico 2"))
    "pico2w" -> Some(pico2w())
    _ -> None

// A board's hundredths of a millimetre as the view's pixels, rounded.
private mm(h: int) -> int = (h * 5 + 50) / 100

// An empty drawing of a 21 × 51 mm board with `below` pixels under it.
private board(name: string, below: int) -> PcbArt
    val w = mm(2100)
    val h = mm(5100)

    var a = PcbArt(name, PCB_GUTTER + w + PCB_GUTTER, PCB_OVERHANG + h + below, PCB_GUTTER, PCB_OVERHANG, w, h,
        buf(), buf(), buf(), 0, 0)

    put(&a, SolderMask, 0, 0, 2100, 5100)
    a

// The item `shape` over the board's `x, y, w, h` in hundredths of a millimetre.
private put(a: *PcbArt, shape: PcbShape, x: int, y: int, w: int, h: int, text: string = "")
    val left = a.board_x + mm(x)
    val top = a.board_y + mm(y)

    a.items.push(PcbItem(shape, left, top, a.board_x + mm(x + w) - left, a.board_y + mm(y + h) - top, text))

// The view's pixel at the board's `x, y` in hundredths of a millimetre.
private at(a: *PcbArt, x: int, y: int) -> (int, int) = (a.board_x + mm(x), a.board_y + mm(y))

/** The names down the board's left edge, pin 1 at the USB end, and down its right edge, pin 40 at the
 * USB end. Every Pico prints the same forty.
 */
val PICO_LEFT_PINS = ["GP0", "GP1", "GND", "GP2", "GP3", "GP4", "GP5", "GND", "GP6", "GP7",
                      "GP8", "GP9", "GND", "GP10", "GP11", "GP12", "GP13", "GND", "GP14", "GP15"]
val PICO_RIGHT_PINS = ["VBUS", "VSYS", "GND", "3V3_EN", "3V3", "ADC_VREF", "GP28", "AGND", "GP27", "GP26",
                       "RUN", "GP22", "GND", "GP21", "GP20", "GP19", "GP18", "GND", "GP17", "GP16"]

/** The debug pads' names, left to right with the USB connector at the top. */
val PICO_SWD_PINS = ["SWCLK", "GND", "SWDIO"]

// The 2 × 20 castellated header: pads 2.54 mm apart, the first 1.37 mm from the USB end, their
// holes 1.61 mm in from the long edges, each pad's name in the gutter beside it.
private header(a: *PcbArt)
    for i in 0..<20
        val y = 137 + 254 * i

        castellated(a, PICO_LEFT_PINS[i], i + 1, 161, y, true)
        castellated(a, PICO_RIGHT_PINS[i], 40 - i, 1939, y, false)

// A castellated pad: copper from the board's edge past a 1 mm hole at `x, y`.
private castellated(a: *PcbArt, name: string, number: int, x: int, y: int, left: bool)
    if left then put(a, Castellation, 0, y - 85, x + 90, 170) else put(a, Castellation, x - 90, y - 85, 2100 - x + 90, 170)
    put(a, DrillHole, x - 50, y - 50, 100, 100)

    val (cx, cy) = at(a, x, y)

    a.pins.push(PcbPin(name, number, cx, cy))

    if left
        a.labels.push(PcbLabel(name, 0, cy - 6, a.board_x - 3, 12, AlignEnd, 8))
    else
        a.labels.push(PcbLabel(name, a.board_x + a.board_w + 3, cy - 6, PCB_GUTTER - 3, 12, AlignStart, 8))
end castellated

// The four 2.1 mm holes, 4.8 mm in from the long edges and 2 mm from the short ones, each in a copper
// ring.
private mounting_holes(a: *PcbArt)
    for (x, y) in [(480, 200), (1620, 200), (480, 4900), (1620, 4900)]
        put(a, CopperPad, x - 170, y - 170, 340, 340)
        put(a, DrillHole, x - 105, y - 105, 210, 210)

// The micro-USB receptacle, 8 mm wide, centred on the top edge and overhanging it by 1.3 mm: its
// tinned shell, the lip of its mouth, and the shell's legs soldered either side.
private usb(a: *PcbArt)
    put(a, CopperPad, 520, 160, 140, 180)
    put(a, CopperPad, 1440, 160, 140, 180)
    put(a, TinPlate, 650, -130, 800, 590)
    put(a, TinShade, 650, -130, 800, 110)
    put(a, TinShade, 760, 300, 580, 40)

// The BOOTSEL switch: a square body with a round white actuator.
private bootsel(a: *PcbArt, y: int)
    put(a, IcPackage, 530, y, 340, 440)
    put(a, ButtonCap, 570, y + 90, 260, 260)

// A QFN package with its marking, the tinned ends of its pads showing round its edge.
private qfn(a: *PcbArt, x: int, y: int, size: int, marking: string)
    put(a, TinShade, x - 20, y - 20, size + 40, size + 40)
    put(a, IcPackage, x, y, size, size, marking)

// An ABM8 crystal: a ceramic base under a tinned lid.
private crystal(a: *PcbArt, x: int, y: int, w: int, h: int)
    put(a, CrystalBase, x, y, w, h)
    put(a, TinPlate, x + 30, y + 30, w - 60, h - 60)

// A diode with its cathode band at the end toward the board's bottom.
private diode(a: *PcbArt, x: int, y: int, w: int, h: int)
    put(a, IcPackage, x, y, w, h)
    put(a, CathodeBand, x, y + h - 70, w, 45)

// The small resistors and capacitors, each `x, y, w, h`.
private passives(a: *PcbArt, boxes: [](int, int, int, int))
    for (x, y, w, h) in boxes do put(a, ChipPassive, x, y, w, h)

// The Pico and the Pico 2, which share a layout: the switch-mode supply right of the USB connector,
// BOOTSEL under the LED, the flash left of the chip, the crystal under it, and the debug pads on the
// bottom edge.
private pico(name: string, chip: string, silk: string) -> PcbArt
    var a = board(name, SWD_ROW)
    val two = name == "pico2"

    header(&a)
    mounting_holes(&a)
    usb(&a)

    // The supply: the buck-boost's inductor and capacitors, its controller, and the VBUS diode.
    put(&a, PowerInductor, 1200, 970, 260, 250)
    put(&a, ChipPassive, 1550, 970, 200, 250)
    put(&a, ChipPassive, 1230, 780, 200, 120)
    put(&a, IcPackage, 1240, 1280, 200, 110)
    diode(&a, 1550, 490, 200, 330)
    put(&a, IcPackage, 1590, 1770, 180, 120)
    put(&a, ChipPassive, 1150, 1810, 200, 160)
    passives(&a, [(710, 630, 60, 100), (1355, 680, 60, 40), (1590, 1600, 50, 50), (1680, 1600, 50, 50),
        (1770, 1600, 50, 50), (530, 1580, 40, 60), (920, 2000, 50, 60), (1010, 2000, 50, 60),
        (1200, 2070, 110, 90), (1450, 1910, 50, 90), (1560, 2090, 50, 60), (1660, 2090, 50, 60),
        (1760, 2090, 50, 60), (530, 2240, 100, 50), (540, 2520, 60, 40), (580, 2730, 60, 40),
        (1480, 2320, 60, 40), (1510, 2550, 60, 50), (1700, 2550, 60, 50), (920, 3040, 50, 60),
        (1040, 3060, 50, 80), (1250, 3180, 60, 60), (1380, 3040, 50, 50)])

    bootsel(&a, 980)
    if two then put(&a, IcPackage, 520, 1760, 220, 290) else put(&a, IcPackage, 565, 1760, 210, 320)
    qfn(&a, 700, 2250, 700, chip)
    if two then crystal(&a, 595, 3180, 330, 250) else crystal(&a, 660, 3340, 325, 240)
    put(&a, SilkText, 300, 3900, 1500, 400, silk)

    // The three debug pads on the bottom edge, 2.54 mm apart, their names in the row under the board.
    val (row_x, row_y) = at(&a, 0, 5100)

    for i in 0..<3
        val x = 796 + 254 * i

        put(&a, Castellation, x - 85, 4840, 170, 260)
        put(&a, DrillHole, x - 50, 4890, 100, 100)

        val (cx, cy) = at(&a, x, 4940)

        a.pins.push(PcbPin(PICO_SWD_PINS[i], 0, cx, cy))
        // Each name keeps to its own pad: the outer two away from the middle on the first row, the
        // middle one centred under its pad on the second.
        val label = i match
            0 -> PcbLabel(PICO_SWD_PINS[i], row_x, row_y + 1, cx + 3 - row_x, 10, AlignEnd, 7)
            1 -> PcbLabel(PICO_SWD_PINS[i], cx - 9, row_y + 11, 18, 10, AlignMiddle, 7)
            _ -> PcbLabel(PICO_SWD_PINS[i], cx - 3, row_y + 1, row_x + a.board_w - cx + 3, 10, AlignStart, 7)
        a.labels.push(label)
    end for

    // The LED, an 0603 on the left of the USB connector (GP25).
    val (lx, ly) = at(&a, 475, 480)
    a.led_x = lx
    a.led_y = ly
    a
end pico

// The Pico 2 W: the Pico 2's chip moved 2 mm toward the USB end, the debug pads in the middle of the
// board, the CYW43439 under its shield can below them, and the antenna on the far end.
private pico2w() -> PcbArt
    var a = board("pico2w", 0)

    // The antenna's keep-out: no copper under the mask from below the can to the far edge.
    put(&a, AntennaKeepout, 320, 4380, 1460, 720)

    header(&a)
    mounting_holes(&a)
    usb(&a)

    put(&a, PowerInductor, 1070, 930, 420, 320)
    put(&a, ChipPassive, 1540, 960, 220, 240)
    put(&a, ChipPassive, 1140, 670, 200, 130)
    diode(&a, 1550, 470, 200, 260)
    put(&a, ChipPassive, 1150, 1400, 200, 110)
    put(&a, ChipPassive, 1150, 1570, 200, 130)
    put(&a, IcPackage, 1460, 1720, 170, 100)
    passives(&a, [(720, 630, 60, 40), (720, 750, 60, 40), (1450, 720, 40, 60), (1550, 760, 200, 60),
        (1000, 1320, 50, 40), (1120, 1320, 50, 40), (1230, 1320, 50, 40), (1510, 1420, 160, 70),
        (1520, 1580, 40, 90), (1640, 1560, 50, 40), (970, 1830, 40, 60), (1050, 1830, 40, 60),
        (1130, 1830, 40, 60), (1210, 1830, 40, 60), (1290, 1830, 80, 60), (1540, 1820, 50, 90),
        (560, 1910, 60, 40), (540, 2010, 80, 50), (570, 2120, 50, 40), (1640, 2000, 50, 40),
        (1490, 2090, 40, 40), (1640, 2340, 40, 60), (1500, 2510, 50, 50), (1670, 2510, 40, 60),
        (580, 2480, 50, 40), (1050, 2870, 50, 60), (1110, 2870, 50, 60), (800, 2950, 40, 70),
        (880, 3010, 40, 70), (800, 3100, 40, 60), (330, 4510, 40, 50), (320, 4630, 50, 40),
        (900, 4660, 100, 50), (1150, 4660, 100, 50), (900, 4970, 100, 50), (1150, 4970, 100, 50)])

    bootsel(&a, 960)
    put(&a, IcPackage, 570, 1570, 290, 210)
    qfn(&a, 700, 2050, 700, "RP2350")
    crystal(&a, 420, 2920, 330, 240)

    // The debug pads across the board under the chip, in their silkscreen box, SWCLK's pad square.
    put(&a, SilkOutline, 970, 2990, 780, 250)

    for i in 0..<3
        val x = 1110 + 254 * i

        put(&a, CopperPad, x - 80, 3030, 160, 160)
        if i == 0 then put(&a, Castellation, x - 80, 3030, 160, 160)
        put(&a, DrillHole, x - 50, 3060, 100, 100)

        val (cx, cy) = at(&a, x, 3110)

        a.pins.push(PcbPin(PICO_SWD_PINS[i], 0, cx, cy))
    end for

    // The pads are 2.54 mm apart between the chip and the can, with header pads either side, so there
    // is no room for each one's name; the board's own silkscreen word stands over them instead.
    put(&a, SilkText, 970, 2790, 780, 190, "DEBUG")

    // The radio's shield can.
    put(&a, ShieldCan, 440, 3260, 1220, 1040)
    put(&a, SilkText, 300, 4380, 1500, 240, "Pico 2 W")

    // The LED, an 0603 on the left of the USB connector, driven by the radio's GPIO 0.
    val (lx, ly) = at(&a, 475, 470)
    a.led_x = lx
    a.led_y = ly
    a
end pico2w

/** The names down the DS3231 module's six-pin header, top to bottom, and down its four-pin
 * pass-through header.
 */
val DS3231_LEFT_PINS = ["32K", "SQW", "SCL", "SDA", "VCC", "GND"]
val DS3231_RIGHT_PINS = ["SCL", "SDA", "VCC", "GND"]

/** The DS3231 part as the window draws it: the common ZS-042 breakout, a 38 × 22 mm board drawn
 * whole at 5 px/mm, 190 × 110 pixels, with the six-pin header down its left edge and the four-pin
 * pass-through for the next I2C device down its right, each pin's name printed beside it. Between
 * them are the DS3231SN in its 16-pin wide SOIC, the AT24C32 EEPROM in an 8-pin SOIC with its three
 * address jumpers and the I2C pull-up array under it, the power LED and its resistor, the charging
 * diode, and the decoupling capacitors. The CR2032 holder is on the back and is not drawn.
 * `reference` is printed over the chip, and nothing is where the part has none.
 */
ds3231_art(reference: string) -> PcbArt
    var a = PcbArt("ds3231", mm(3800), mm(2200), 0, 0, mm(3800), mm(2200), buf(), buf(), buf(), 0, 0)

    put(&a, SolderMask, 0, 0, 3800, 2200)

    // The headers: 1.7 mm pads round 1 mm holes, 2.54 mm apart and centred down the short edges.
    for i in 0..<6
        val y = 465 + 254 * i

        put(&a, CopperPad, 115, y - 85, 170, 170)
        put(&a, DrillHole, 150, y - 50, 100, 100)
        put(&a, SilkText, 330, y - 127, 560, 254, DS3231_LEFT_PINS[i])
    for i in 0..<4
        val y = 719 + 254 * i

        put(&a, CopperPad, 3515, y - 85, 170, 170)
        put(&a, DrillHole, 3550, y - 50, 100, 100)
        put(&a, SilkText, 2910, y - 127, 560, 254, DS3231_RIGHT_PINS[i])

    // The DS3231SN: a 10.3 × 7.5 mm body with eight gull-wing leads 1.27 mm apart along each long side.
    soic(&a, 1050, 720, 1030, 750, 8, "DS3231SN")
    if !reference.is_empty() then put(&a, SilkText, 1050, 260, 1030, 260, reference)

    // The AT24C32: a 4.9 × 3.9 mm body, four leads a side; its A0-A2 jumpers and the 4.7 kΩ pull-up
    // array below it.
    soic(&a, 2250, 520, 490, 390, 4, "24C32")
    for i in 0..<3
        val x = 2230 + 190 * i

        put(&a, TinPlate, x, 1150, 70, 90)
        put(&a, TinPlate, x + 90, 1150, 70, 90)
    resistor(&a, 2260, 1430, 320, 160)

    // The power LED and its resistor near the top right corner.
    put(&a, TinPlate, 2950, 230, 160, 80)
    put(&a, ChipLed, 2990, 230, 80, 80)
    resistor(&a, 3220, 230, 160, 80)

    // The charging circuit's glass diode, its cathode band to the left, and its resistor.
    put(&a, IcPackage, 1150, 1860, 360, 150)
    put(&a, CathodeBand, 1190, 1860, 50, 150)
    resistor(&a, 1650, 1895, 160, 80)

    // The decoupling and filter capacitors.
    for (x, y) in [(1960, 1895), (2260, 1895), (1080, 380), (2600, 1450)] do put(&a, ChipPassive, x, y, 160, 80)

    put(&a, SilkText, 2650, 1810, 900, 260, "ZS-042")
    a
end ds3231_art

// A small-outline package's `x, y, w, h` body with `leads` tinned leads along its top and bottom
// edges, 1.27 mm apart, and its marking.
private soic(a: *PcbArt, x: int, y: int, w: int, h: int, leads: int, marking: string)
    val first = x + (w - 127 * (leads - 1) - 42) / 2

    for i in 0..<leads
        put(a, TinPlate, first + 127 * i, y - 130, 42, 130)
        put(a, TinPlate, first + 127 * i, y + h, 42, 130)
    put(a, IcPackage, x, y, w, h, marking)

// A chip resistor: its body between two tinned ends.
private resistor(a: *PcbArt, x: int, y: int, w: int, h: int)
    put(a, TinPlate, x, y, w, h)
    put(a, IcPackage, x + w / 5, y, w - 2 * (w / 5), h)
