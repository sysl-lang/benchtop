module sh.sysl.benchtop
@tests

@test("registry: a peripheral states only what differs from the common case")
registry_peripheral_defaults()
    val lib = library()
    val ram = lib.peripheral("ram").unwrap()
    assert(ram.modelled && ram.window.sized && ram.window.size == 0 && ram.window.align == 4096 && ram.window.irqs == 0)
    assert(ram.bus == "" && ram.signals.is_empty() && ram.params.is_empty() && !ram.adc)
    val rom = lib.peripheral("rom").unwrap()
    assert(!rom.modelled && rom.window.sized)
    val sdmmc = lib.peripheral("stm32-sdmmc").unwrap()
    assert(sdmmc.window.size == 0x400 && !sdmmc.window.sized && sdmmc.window.irqs == 1 && sdmmc.bus == "sdmmc")
    assert(sdmmc.signals.len() == 6 && sdmmc.param("kernel-clock-hz").unwrap().required)
    val adc = lib.peripheral("virt-adc").unwrap()
    assert(adc.adc && adc.modelled && !adc.param("reference-uv").unwrap().required)
    val rp_adc = lib.peripheral("rp-adc").unwrap()
    assert(rp_adc.adc && rp_adc.modelled)

@test("registry: a part's ports are required and its parameters optional unless it says otherwise")
registry_part_defaults()
    val lib = library()
    val card = lib.part("sd-card").unwrap()
    for p in card.ports do assert(!p.required, p.name)
    assert(card.param("sectors").unwrap().required && !card.param("image").unwrap().required)
    val lcd = lib.part("hd44780").unwrap()
    assert(lcd.port("rs").unwrap().required && !lcd.port("rw").unwrap().required)
    val buzzer = lib.part("buzzer").unwrap()
    assert(buzzer.param("kind").unwrap().required && !buzzer.param("tone").unwrap().required)
    val tft = lib.part("st7796").unwrap()
    assert(tft.display && tft.modelled && !lib.part("st7789").unwrap().display)
    assert(!lib.part("cyw43439").unwrap().modelled)
    assert(lib.part("joystick").unwrap().controls.len() == 4 && lib.part("led").unwrap().controls.is_empty())
