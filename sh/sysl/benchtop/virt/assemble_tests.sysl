module sh.sysl.benchtop.virt
@tests

// `assemble` checks a whole description before it sets anything, so a refused one leaves the machine
// exactly as the last board made it: its memory map, its bus, its cores and its clock.

import sh.sysl.benchtop.v6m.Kind

// What a refusal must not change.
private struct Snapshot
    ram_at: u32
    ram_size: u32
    flash_at: u32
    flash_size: u32
    banks: usize
    attached: usize
    kinds: [2]Kind
    clock_hz: u64

private snapshot() -> Snapshot
    val map = memory_map()

    Snapshot(map.ram_at, map.ram_size, map.flash_at, map.flash_size, map.banks.len(), attached, core_kinds, clock_hz())

private same(a: Snapshot, b: Snapshot) -> bool =
    a.ram_at == b.ram_at && a.ram_size == b.ram_size && a.flash_at == b.flash_at && a.flash_size == b.flash_size &&
        a.banks == b.banks && a.attached == b.attached && a.kinds == b.kinds && a.clock_hz == b.clock_hz

// A board on an M7 + M4 chip with RAM in two banks at 0x24000000, flash at 0x08000000, a clock of
// `clock`, and `more` peripherals besides.
private h7_like(clock: string, more: string) -> string = s"""
    board {
      name = v
      mcu {
        name = v, cores = [cortex-m7, cortex-m4]$clock
        peripherals {
          ram   { peripheral = ram, at = 0x24000000, size = 64K }
          sram  { peripheral = ram, at = 0x30000000, size = 16K }
          flash { peripheral = flash, at = 0x08000000, size = 256K }
    $more
        }
      }
    }
    """

@test("a description refused by its bus, its clocks or a device leaves the machine as the last board made it")
asm_refusal_keeps_machine()
    assert(board_named("workbench").is_ok())

    val before = snapshot()

    assert(before.flash_size == 4194304 && before.flash_at == 0x10000000, "the workbench board is in place")

    val refused = [
        // The bus: two consoles, found after the memory map is planned.
        h7_like("", "      a { peripheral = debug-console, at = 0x40000000 }\n      b { peripheral = debug-console, at = 0x40000010 }\n"),
        // The clocks: a peripheral's timebase that is not the chip's.
        h7_like(", clock-hz = 480000000", "      i2c { peripheral = virt-i2c, at = 0x40000000, clock-hz = 12000000 }\n"),
        // A device: DSI needs the chip's clock, which only its configuration checks.
        h7_like("", "      dsi { peripheral = stm32-dsi, at = 0x50000000 }\n"),
    ]

    for text in refused
        board_from("refused.hocon", text.bytes) match
            Ok(_) -> assert(false, s"refused:\n$text")
            Err(_) -> ()
        assert(same(snapshot(), before), s"unchanged after refusing:\n$text")

    // The same description without its mistake is accepted, and changes all of it.
    assert(board_from("good.hocon", h7_like(", clock-hz = 480000000", "").bytes).is_ok())

    val after = snapshot()

    assert(after.ram_at == 0x24000000 && after.ram_size == 65536 && after.banks == 1, "RAM")
    assert(after.flash_at == 0x08000000 && after.flash_size == 262144, "flash")
    assert(after.kinds[0] == Kind.V7emM7 && after.kinds[1] == Kind.V7em && after.clock_hz == 480000000, "cores and clock")
    assert(board_named("virt").is_ok())

@test("the image a board loads is laid out by the map it was assembled with")
asm_image_follows_map()
    assert(board_from("good.hocon", h7_like("", "").bytes).is_ok())

    val image = image_of([1, 2, 3, 4]).unwrap()

    assert(image.len() == 1048576 + 262144, "RAM backing, then the board's flash")
    assert(image.at(1048576) == 1 && image.at(0) == 0, "a raw image goes into flash")
    assert(board_named("virt").is_ok())
    assert(image_of([1, 2, 3, 4]).unwrap().at(0) == 1, "and a RAM board takes it at 0")
