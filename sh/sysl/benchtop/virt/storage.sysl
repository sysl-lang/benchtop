module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board,Target,param_named,part_model,part_whole,part_text,part_flag}
import sh.sysl.benchtop.peripheral.{ContextModel, Model}
import sh.sysl.benchtop.peripheral.stm32_spi as hspi
import sh.sysl.benchtop.peripheral.stm32_gpio as gpio
import sh.sysl.benchtop.peripheral.spi as edge
import sh.sysl.benchtop.parts.sd_card as sd
import sh.sysl.benchtop.v6m.{Cpu,Stop,halt}
import sysl.buf.{Buf,buf,Frozen}
import sysl.math.max
import sysl.raw.str_cast
import sysl.slices.copy
import sysl.threads.{Mutex,Thread,Channel,channel,spawn}
import sysl.sync.*
import sysl.fs
import sysl.io.Reader

/** An STM32 GPIO bank (`stm32-gpio`) at `base`, named by its `bank` parameter. */
struct StorageGpio
    base: u32
    name: string
    model: gpio.Bank

/** The STM32 storage path: the SPI controller (`stm32-spi`), the GPIO banks, and the SD card on the
 * SPI or on the SDMMC (`is_native`). What the board fixes is here: `routed` whether the board wires the
 * SPI's bus, `gpio_index` the bank its pins are on, `detect` the bank and pin the card's detect switch
 * pulls low, and `has_card` whether a card is in the slot. The registers, the banks and the card on
 * the SPI change under `live`; a card on the SDMMC is the SDMMC's (sdmmc.sysl). The card's image is
 * `image`, which the card reaches through its media, with the file it was read from.
 */
struct StorageState
    gpio_index: usize
    detect: Option[(usize,u32)]
    is_native: bool
    has_card: bool
    sck: u32
    tx: u32
    rx: u32
    cs: u32
    af: u32
    present: bool
    routed: bool
    image: &sync SdImage
    live: Mutex[StorageLive]

/** What the cores' threads change on the storage path: the SPI controller, the `gpio_count` GPIO
 * banks, and the card where it is on the SPI.
 */
struct StorageLive
    spi: hspi.Controller[StorageLive]
    gpios: [16]StorageGpio
    gpio_count: usize
    card: Option[&sd.Card]

private storage_live() -> StorageLive = StorageLive(hspi.controller(), [StorageGpio(0,"",gpio.bank());16], 0, None)

/** No SPI, no GPIO bank and no card. */
// SPI1's default pins on GPIOA, which a board's routes replace: SCK PA5, MOSI PA7, MISO PA6, and
// PA4 as the card's chip select, all on alternate function 5 (SPI1, in the STM32H747 datasheet's
// alternate-function table).
private const DEFAULT_SCK: u32 = 5
private const DEFAULT_MOSI: u32 = 7
private const DEFAULT_MISO: u32 = 6
private const DEFAULT_CS: u32 = 4
private const AF_SPI1: u32 = 5

storage_state() -> StorageState = StorageState(0, None, false, false, DEFAULT_SCK, DEFAULT_MOSI, DEFAULT_MISO,
    DEFAULT_CS, AF_SPI1, false, false, sd_image_of(buf(), ""), Mutex.new(storage_live()))

/** A sector the image writer is to write to the image file. */
struct SectorWrite
    sector: u32
    bytes: [512]u8

/** What the image writer's thread is given: its queue, the image file's name, frozen, what it has
 * left to write and whether a write has failed (both atomic). The board's description holds the name
 * as a string, whose count is not atomic and which the thread that read the description lets go, so
 * the writer is handed its own read-only copy instead.
 */
struct DiskWriter
    queue: Channel[SectorWrite]
    path: &sync Frozen[u8]
    failed: u32
    pending: u32

/** An SD card's image: its bytes, which whichever core's thread the card is on reads and writes,
 * and, for an image read from a file, the thread that writes each changed sector back (`writer`),
 * which runs from `start_disk` to `stop_disk`. `slots` is the storage the writer's queue holds its
 * sectors in; no thread takes its lock, which is only how the image owns it.
 */
struct SdImage
    bytes: Mutex[Buf[u8]]
    has_file: bool
    writer: DiskWriter
    slots: Mutex[Buf[SectorWrite]]
    thread: Option[Thread]

private frozen_text(text: string) -> &sync Frozen[u8]
    var bytes: Buf[u8] = buf()
    for b in text.bytes do bytes.push(b)
    bytes.freeze()

// The image `bytes`, written back to `path` where it is not empty.
private[virt] sd_image_of(bytes: Buf[u8], path: string) -> &sync SdImage
    var slots: Buf[SectorWrite] = buf()
    for i in 0..<64 do slots.push(SectorWrite(0,[0;512]))
    val queue = channel(slots.view())
    SdImage(Mutex.new(bytes), !path.is_empty(), DiskWriter(queue, frozen_text(path), 0, 0), Mutex.new(slots), None)

private[virt] disk_body(writer: *DiskWriter)
    var file = fs.open_update(str_cast(writer.path.view()))
    loop
        val job = writer.queue.receive() match
            Some(job) -> job
            None -> break
        file match
            Ok(opened) ->
                var f = opened
                var failed = f.seek(long(job.sector) * 512).is_err()
                if !failed
                    f.write(job.bytes[..])
                    failed = f.failed() || f.flush().is_err()
                if failed then atomic_store(&writer.failed,1,Release)
                file = Ok(f)
            Err(_) -> atomic_store(&writer.failed,1,Release)
        atomic_sub(&writer.pending,1,AcqRel)
    file match
        Ok(opened) ->
            var f = opened
            if f.close().is_err() then atomic_store(&writer.failed,1,Release)
        Err(_) -> ()

// Let the image writer of `s` finish what it was given, and end it.
private[virt] stop_disk(s: *StorageState)
    val image = s.image
    if image.thread.is_some()
        image.writer.queue.close()
        image.thread.unwrap().join()
        image.thread = None

// Start the image writer of `s`, for a card read from a file. Where the host cannot give it a thread,
// the card's writes fail, as they do once a write to the file has.
private[virt] start_disk(s: *StorageState)
    val image = s.image
    atomic_store(&image.writer.failed,0,Release)
    atomic_store(&image.writer.pending,0,Release)
    if !image.has_file then return
    image.thread = spawn(&disk_body,&image.writer,1 << 20)
    if image.thread.is_none() then atomic_store(&image.writer.failed,1,Release)

private sector_read(bytes: *Buf[u8], sector: u32, out: []u8) -> bool
    val at = usize(sector) * 512
    if out.len != 512 || at + 512 > bytes.len() then return false
    for i in 0usize..<512 do out[i] = bytes.at(at + i)
    true
private sector_write(image: &sync SdImage, bytes: *Buf[u8], sector: u32, data: []const u8) -> bool
    val writer = &image.writer
    val at = usize(sector) * 512
    if data.len != 512 || at + 512 > bytes.len() || atomic_load(&writer.failed,Acquire) != 0 then return false
    if image.has_file
        var job = SectorWrite(sector,[0;512])
        for i in 0usize..<512 do job.bytes[i] = data[i]
        atomic_add(&writer.pending,1,AcqRel)
        // A full queue is host I/O latency, not a card fault: the guest's core waits for a slot,
        // which costs host time and no guest time. Only a stopped writer refuses the sector.
        if !writer.queue.try_send(job) && !writer.queue.send(job)
            atomic_sub(&writer.pending,1,AcqRel)
            return false
    for i in 0usize..<512 do bytes.view()[at + i] = data[i]
    true

// The media a card on `image` reads and writes it through.
private[virt] storage_media(image: &sync SdImage) -> sd.Media = sd.Media(
    (sector,out) -> image.bytes.with(bytes -> sector_read(bytes,sector,out)),
    (sector,data) -> image.bytes.with(bytes -> sector_write(image,bytes,sector,data)),
    () -> atomic_load(&image.writer.pending,Acquire) == 0, () -> atomic_load(&image.writer.failed,Acquire) == 0)

private[virt] local_pin(name: string, bank: string) -> Option[u32]
    for pin in 0u32..<16 do if name == s"$bank$pin" then return Some(pin)
    None

// The bank of `l` a pin such as `PA5` is on, and its number there.
private bank_pin(l: *StorageLive, name: string) -> Option[(usize,u32)]
    for i in 0..<l.gpio_count
        local_pin(name,l.gpios[i].name) match
            Some(n) -> return Some((i,n))
            None -> ()
    None

/** STM32 pin `name` (such as `PI12`): whether its bank drives it as an output, and the level it
 * drives; None where no bank of the chip's has the pin.
 */
private[virt] stm32_output(s: *StorageState, name: string) -> Option[(bool,bool)]
    s.live.with(l -> bank_pin(l,name) match
        Some((i,n)) -> Some((gpio.output_enabled(l.gpios[i].model,n), gpio.output_high(l.gpios[i].model,n)))
        None -> None)

/** Hold STM32 pin `name` at `level` (a button pressed onto its supply or ground), or let it go with
 * None. Whatever else holds the bank's other pins, a card's detect switch among them, stays. False
 * where no bank of the chip's has the pin.
 */
private[virt] stm32_hold(s: *StorageState, name: string, level: Option[bool]) -> bool
    s.live.with(l -> bank_pin(l,name) match
        Some((i,n)) ->
            val b = &l.gpios[i].model
            val bit = 1u32 << n
            val (low, high) = (b.held_low & ~bit, b.held_high & ~bit)
            level match
                Some(true) -> gpio.hold(b, low, high | bit)
                Some(false) -> gpio.hold(b, low | bit, high)
                None -> gpio.hold(b, low, high)
            true
        None -> false)

// The bank of `l` named `name`.
private[virt] gpio_named(l: *StorageLive, name: string) -> Option[usize]
    for i in 0..<l.gpio_count do if l.gpios[i].name == name then return Some(i)
    None
// Whether pin `pin` of the storage path's GPIO bank `bank` (an index among them) is in alternate
// function `af`.
private[virt] storage_gpio_alternate(s: *StorageState, bank: usize, pin: u32, af: u32) -> bool
    s.live.with(l -> bank < l.gpio_count && gpio.alternate(l.gpios[bank].model,pin,af))

// The storage path `b` makes on a chip whose clock is `clock_hz`, with its card's image read, and the
// card where it is on the SDMMC, which the SDMMC takes.
private[virt] check_storage(b: Board, clock_hz: u64) -> Result[(StorageState, Option[&sd.Card]),string]
    var s = storage_state()
    var l = storage_live()
    check_storage_into(b, clock_hz, &s, &l)?
    val native = if s.is_native then l.card else None
    if s.is_native then l.card = None
    s.live = Mutex.new(l)
    Ok((s, native))

private check_storage_into(b: Board, clock_hz: u64, s: *StorageState, l: *StorageLive) -> Result[unit,string]
    var spi_name = ""
    var native_name = ""
    var ratio: u32 = 8
    for p in b.chip.peripherals
        if p.kind == "stm32-gpio"
            if l.gpio_count == l.gpios.len then return Err("too many GPIO banks")
            var name = ""
            var reset: u32 = 0xffffffff
            for q in p.params do q.value match
                Text(value) -> if q.name == "bank" then name = value
                Whole(value) -> if q.name == "reset-mode" then reset = u32(value)
                _ -> ()
            if gpio_named(l, name).is_some() then return Err("duplicate STM32 GPIO bank")
            l.gpios[l.gpio_count] = StorageGpio(u32(p.at.unwrap().n),name,gpio.bank(reset))
            l.gpio_count += 1
        if p.kind == "stm32-sdmmc" then native_name = p.name
        if p.kind != "stm32-spi" then continue
        s.present = true
        spi_name = p.name
        for q in p.params
            if q.name != "kernel-clock-hz" then continue
            q.value match
                Whole(hz) ->
                    if clock_hz == 0 || u64(hz) > clock_hz || clock_hz % u64(hz) != 0 || clock_hz / u64(hz) > 1024 then return Err("SPI kernel clock must divide mcu.clock-hz within its supported ratio")
                    ratio = u32(clock_hz / u64(hz))
                _ -> ()
    l.spi = hspi.controller(ratio)
    // The SPI's pins are where the board's `buses` puts them, all on one bank; a board that does not
    // wire the bus leaves the SPI unrouted.
    for bus in b.buses
        if !s.present || bus.name != spi_name then continue
        var bank: Option[usize] = None
        for route in bus.signals
            val (i, pin) = bank_pin(l, route.pin) match
                Some(at) -> at
                None -> return Err("SPI signal needs its STM32 GPIO bank")
            if bank.is_some() && bank != Some(i) then return Err("SPI signals must share one GPIO bank")
            bank = Some(i)
            if route.name == "sck" then s.sck = pin
            elif route.name == "tx" then s.tx = pin
            elif route.name == "rx" then s.rx = pin
        if bus.signals.len() != 3 then return Err("SPI requires routed sck, tx and rx pins")
        s.gpio_index = bank.unwrap()
        s.routed = true
    for p in b.parts
        if part_model(p) != "sd-card" then continue
        if s.has_card then return Err("one SD card is currently supported")
        var spi = false
        var native = false
        var cs: Option[u32] = None
        for wire in p.wires do wire.to match
            Bus(name) ->
                if wire.port == "spi" && name == spi_name then spi = true
                if wire.port == "sdmmc" && name == native_name then native = true
            Pin(pin) -> if wire.port == "cs" && s.routed then cs = local_pin(pin,l.gpios[s.gpio_index].name)
            _ -> ()
        if spi == native then return Err("SD card needs exactly one SPI or SDMMC connection")
        s.is_native = native
        if spi
            if !s.routed then return Err("an SD card on the SPI needs the SPI's pins wired under `buses`")
            if cs.is_none() then return Err("SPI SD card needs a chip-select GPIO")
            s.cs = cs.unwrap()
            if s.cs == s.sck || s.cs == s.tx || s.cs == s.rx || s.sck == s.tx || s.sck == s.rx || s.tx == s.rx then return Err("SPI and CS pins must be distinct")
        for wire in p.wires
            if wire.port != "detect" then continue
            s.detect = wire.to match
                Pin(pin) -> bank_pin(l, pin)
                _ -> None
            if s.detect.is_none() then return Err("SD detect pin needs its STM32 GPIO bank")
        load_storage_card(s, l, p, clock_hz)?
    Ok(())

// Read the card `p` describes into `s` and `l`: its image, from the file it names or blank.
private load_storage_card(s: *StorageState, l: *StorageLive, p: sh.sysl.benchtop.Part, clock_hz: u64) -> Result[unit,string]
    val sectors = u64(part_whole(p,"sectors",32768))
    if sectors % 1024 != 0 then return Err("SDHC sectors must be a multiple of 1024")
    val path = part_text(p,"image","")
    var bytes: Buf[u8] = buf()
    if path.is_empty()
        for i in 0..<usize(sectors * 512) do bytes.push(0)
    else
        val loaded = fs.read_bytes(path) match
            Ok(read) -> read
            Err(_) -> return Err(s"cannot read SD image `$path`; create it with tools/mk-sd-image")
        for byte in loaded do bytes.push(byte)
        if bytes.len() != usize(sectors * 512) then return Err("SD image size must exactly match sectors * 512")
    s.image = sd_image_of(bytes, path)
    s.has_card = true
    l.card = Some(sd.card(storage_media(s.image),sectors,part_flag(p,"write-protected",false),max(1,clock_hz / 2000)))
    Ok(())

/** Wire the storage path: the SPI's pins to the card on them, and each GPIO bank to the levels the
 * board holds its pins at (the card's detect switch pulls its pin low where a card is in; the SPI's
 * idle MISO reads high on its own bank). Called once the devices are in place; the pins are driven
 * only under `live`, with the state the lock lends.
 */
private[virt] connect_storage(ds: *Devices)
    val s = &ds.storage
    s.live.with(l ->
        l.spi.engine.pins = (live,edge) -> storage_pins(s,live,edge.sck,edge.mosi,edge.time)
        for i in 0..<l.gpio_count
            var low: u32 = 0
            s.detect match
                Some((bank,pin)) -> if bank == i && s.has_card then low = 1u32 << pin
                None -> ()
            val high = if s.routed && i == s.gpio_index && !s.is_native then 1u32 << s.rx else 0
            gpio.hold(&l.gpios[i].model,low,high))

private[virt] boot_storage(s: *StorageState)
    s.live.with(l ->
        l.spi.reset()
        for i in 0..<l.gpio_count do l.gpios[i].model.reset()
        l.card match
            Some(c) -> sd.reset(c)
            None -> ())

private storage_pins(s: *StorageState, l: *StorageLive, sck: bool, mosi: bool, time: u64) -> bool
    if s.is_native then return true
    l.card match
        Some(c) ->
            val bank = l.gpios[s.gpio_index].model
            val routed = gpio.alternate(bank,s.sck,s.af) && gpio.alternate(bank,s.tx,s.af) && gpio.alternate(bank,s.rx,s.af)
            val selected = routed && gpio.output_enabled(bank,s.cs) && !gpio.output_high(bank,s.cs)
            sd.observe(c,selected,sck,mosi,time)
        None -> true
// Polling SPI advances lazily at MMIO, using timestamped SCK edges. There are
// no enabled interrupts or DMA requests in this initial register subset.
private[virt] storage_read(s: *StorageState, cpu: *Cpu, device: Device, address: u32, offset: u32, width: u32, n: u64) -> u32
    val time = board_time(cpu,n)
    s.live.with(l ->
        l.spi.advance(l,time)
        if device == H7Spi then l.spi.read(offset,width,time) else if width == 4 && offset & 3 == 0 then storage_gpio_read(l,address - offset,offset,time) else None) match
        Some(value) -> value
        None ->
            halt(cpu,Stop.Fault,address)
            0
private[virt] storage_write(s: *StorageState, cpu: *Cpu, device: Device, address: u32, offset: u32, width: u32, value: u32, n: u64)
    val time = board_time(cpu,n)
    val ok = s.live.with(l ->
        l.spi.advance(l,time)
        val ok = if device == H7Spi then l.spi.write(l,offset,width,value,time) else width == 4 && offset & 3 == 0 && storage_gpio_write(l,address - offset,offset,value,time)
        edge.drive(&l.spi.engine,l,time)
        ok)
    if !ok then halt(cpu,Stop.Fault,address)

/** A read-only copy of the SD card's image, as it is now. */
sd_image(m: *Machine) -> &sync Frozen[u8] = m.devices.storage.image.bytes.with(bytes ->
    var copy: Buf[u8] = buf()
    copy.extend(bytes.view())
    copy.freeze())

/** Put `bytes` on the SD card, in place of its image, which is as long. */
sd_seed_image(m: *Machine, bytes: []const u8)
    m.devices.storage.image.bytes.with(image -> seed(image, bytes))

private seed(image: *Buf[u8], bytes: []const u8)
    require bytes.len == image.len(), "matching SD image length"
    copy(image.view(), bytes)

/** Run `body` on the SD card, on the SPI or on the SDMMC, under the lock of whichever has it, and
 * answer what it answered: for a test or a debugger. The board has a card.
 */
with_sd_card[R](m: *Machine, body: &sd.Card -> R) -> R
    val s = &m.devices.storage
    if s.is_native
        m.devices.sdmmc.live.with(l -> body(l.host.wiring.card.unwrap().card))
    else
        s.live.with(l -> body(l.card.unwrap()))

private storage_gpio_read(l: *StorageLive, base: u32, offset: u32, time: u64) -> Option[u32]
    for i in 0..<l.gpio_count
        if l.gpios[i].base == base then return l.gpios[i].model.read(offset,4,time)
    None
private storage_gpio_write(l: *StorageLive, base: u32, offset: u32, value: u32, time: u64) -> bool
    for i in 0..<l.gpio_count
        if l.gpios[i].base == base then return l.gpios[i].model.write(offset,4,value,time)
    false
