module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.Stop
import sysl.time.monotonic
import sysl.fs.{write_text,make_dir_all}
import sysl.text.str_builder

/** Reuses the committed, independent-buffer dual CRC benchmark. No firmware
 * changes or UI-driven budgets are part of the measured execution interval.
 */
@test("CPU worker throughput: per-core wall-time rates for the dual Thumb-2 CRC workload")
worker_throughput()
    val guest = embed("../../../../bench/guest/dual33.elf")
    var report = str_builder()
    for board in ["virt33","virt7"]
        for round in 0..<3
            assert(board_named(board).is_ok())
            open_console()
            capture()
            boot(core0(),image_of(guest).unwrap().view())
            start_workers(core0()).unwrap()
            val before = workers_observe()
            val start = monotonic()
            submit_workers(1000000000)
            wait_workers()
            val elapsed = (monotonic() - start).us
            pause_workers()
            val after = workers_observe()
            assert(!after.running && after.cores[0].stop == Stop.Exit && core0().exit_code == 0)
            val first = after.cores[0].retired - before.cores[0].retired
            val second = after.cores[1].retired - before.cores[1].retired
            assert(elapsed > 0 && first > 100000000 && second > 100000000)
            val a = real(first) / real(elapsed)
            val b = real(second) / real(elapsed)
            report.push(s"$board round=${round + 1} wall-us=$elapsed core0-insns=$first core1-insns=$second core0-mips=$a core1-mips=$b total-mips=${a + b}\n")
            stop_workers()
    make_dir_all("target").unwrap()
    write_text("target/worker-throughput.txt",report.finish()).unwrap()
