module sh.sysl.benchtop.virt
@tests

// The board `virt33`: virt's devices with two Cortex-M33s, running the example programs built for
// the M33 (examples/virt/build.sh). crunch.c is checked against the same C built for and run on the
// host, so that output, not benchtop, is the oracle; the others say what they should print.

import sh.sysl.benchtop.v6m.{Cpu, Kind, Stop}
import sysl.raw.str_cast

val echo_m33 = embed("../../../../examples/virt/echo-m33.elf")
val dual_m33 = embed("../../../../examples/virt/dual-m33.elf")
val crunch_m33 = embed("../../../../examples/virt/crunch-m33.elf")
val crunch_m0 = embed("../../../../examples/virt/crunch.elf")
val exclusive_m33 = embed("../../../../examples/virt/exclusive-m33.elf")
val count_m33 = embed("../../../../examples/virt/count-m33.elf")
val crunch_host = embed("../../../../examples/virt/crunch.out")

// The board `name`, bundled, made on `m`.
on_bundled(m: *Machine, name: string)
    board_named(m, name) match
        Ok(_) -> ()
        Err(why) -> assert(false, why)

// `file` on `m` made the bundled board `name`, nothing typed and its output captured, each core on a
// thread of its own where `parallel` says so; run to its end, answering the core that stopped.
run_on(m: *Machine, name: string, file: []const u8, parallel: bool) -> *Cpu
    on_bundled(m, name)
    open_console(m)
    capture(m)
    type_in(m, [])

    image_of(m, file) match
        Ok(img) -> boot(m, img.view())
        Err(why) -> assert(false, why)

    if parallel then set_threads()
    run_board(m)

@test("virt33 boots both cores as M33s, and virt as M0+s")
m33_kinds()
    val board = machine()
    val m = &*board
    val cpu = core0(m)

    run_on(m,"virt33", echo_m33, false)
    assert(cpu.kind == Kind.V8mMain && core1(m).kind == Kind.V8mMain, "virt33")

    run_on(m,"virt", crunch_m0, false)
    assert(cpu.kind == Kind.V6m && core1(m).kind == Kind.V6m, "virt")

@test("echo.c built for the M33 greets as one on virt33, and echoes what is typed")
m33_echo()
    val board = machine()
    val m = &*board
    val cpu = core0(m)

    on_bundled(m, "virt33")
    open_console(m)
    capture(m)
    type_in(m, "one\ntwo\n".bytes)

    image_of(m, echo_m33) match
        Ok(img) -> boot(m, img.view())
        Err(why) -> assert(false, why)

    val stopped = run_board(m)
    val want = "hello from an M33 on benchtop's virtual board\ntype a line; Ctrl-D ends\n> one\n> two\n> \nbye after 2 lines\n"

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, stop_message(stopped))
    assert(output(m).view() == want.bytes, str_cast(output(m).view()))

@test("crunch.c built for the M33 prints on virt33 what the same C prints built for the host")
m33_crunch()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    val stopped = run_on(m,"virt33", crunch_m33, false)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, stop_message(stopped))
    assert(output(m).view() == crunch_host, str_cast(output(m).view()))

@test("crunch.c built for the M0+ prints on virt what the same C prints built for the host")
m33_crunch_m0()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    val stopped = run_on(m,"virt", crunch_m0, false)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, stop_message(stopped))
    assert(output(m).view() == crunch_host, str_cast(output(m).view()))

@test("dual.c built for the M33 holds the same conversation on virt33 as the M0+ build does on virt")
m33_dual()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    val stopped = run_on(m,"virt33", dual_m33, false)

    assert(stopped == cpu && cpu.stop == Stop.Exit && cpu.exit_code == 0, stop_message(stopped))

    // Each core's lines in its own order, and the total last. How the two cores' lines interleave
    // follows their instruction counts, which the M33 build changes; so does where core 1's stack
    // sits, which the line naming it says.
    val want = lines(DUAL_OUTPUT.bytes)
    val got = lines(output(m).view())

    assert(got.len() == want.len() && got.at(got.len() - 1) == want.at(want.len() - 1), str_cast(output(m).view()))

    for k in 0..<2
        val mine = said_by(got.view(), k)
        val theirs = said_by(want.view(), k)

        assert(mine.len() == theirs.len(), str_cast(output(m).view()))

        for i in 0..<mine.len()
            if !theirs.at(i).starts_with("core 1: up") then assert(mine.at(i) == theirs.at(i), mine.at(i))

@test("the exclusives keep two cores' unlocked atomic additions exact, word, halfword and byte, taking turns")
m33_exclusive_turns()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    val stopped = run_on(m,"virt33", exclusive_m33, false)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, str_cast(output(m).view()))
    assert(output(m).view() == "word 40000, half 40000, byte 64\n".bytes, str_cast(output(m).view()))

@test("the exclusives keep two cores' unlocked atomic additions exact with a thread each")
m33_exclusive_threads()
    val board = machine()
    val m = &*board
    val cpu = core0(m)

    for round in 0..<5
        val stopped = run_on(m,"virt33", exclusive_m33, true)

        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, str_cast(output(m).view()))

@test("count.c's spinlock excludes on virt33's cores with a thread each")
m33_count_threads()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    val stopped = run_on(m,"virt33", count_m33, true)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, str_cast(output(m).view()))

@test("a board of one M33 and one M0+ retains both declared core identities")
m33_mixed()
    val text = "board {\n  name = mixed\n  mcu { name = mixed, cores = [cortex-m33, cortex-m0plus], peripherals { ram { peripheral = ram, at = 0, size = 1M } } }\n}\n"

    val board = machine()
    val m = &*board
    assert(board_from(m, "mixed.hocon",text.bytes).is_ok())
    boot(m,[])
    assert(core0(m).kind == Kind.V8mMain && core1(m).kind == Kind.V6m)

val isa_m33 = embed("../../../../examples/virt/isa-m33.elf")
val isa_qemu = embed("../../../../examples/virt/isa.qemu")

@test("isa.c's 96 instructions, each on every pair of edge values from every flag state, hash on virt33 as on QEMU's M33")
m33_isa_qemu()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    val stopped = run_on(m,"virt33", isa_m33, false)

    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, stop_message(stopped))

    // Line by line, so a failure names the instruction.
    val want = lines(isa_qemu)
    val got = lines(output(m).view())

    assert(got.len() == want.len(), str_cast(output(m).view()))
    for i in 0..<want.len() do assert(got.at(i) == want.at(i), s"benchtop: ${got.at(i)}, QEMU: ${want.at(i)}")
