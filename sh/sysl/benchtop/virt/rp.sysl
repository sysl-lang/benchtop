module sh.sysl.benchtop.virt

// The RP2040's RESETS, TIMER and the watchdog's tick generator, where a chip puts them on the cores'
// bus (`rp-resets`, `rp-timer`, `rp-watchdog`). The register models are
// `sh.sysl.benchtop.peripheral.rp2040`'s; this is the board's half of them: their time, the reset
// RESETS fans out, the timer's interrupts, and the lock over them all.
//
// **The timer counts the watchdog's ticks, and clk_ref is the cores' clock.** benchtop models no
// CLOCKS block, so one clock, an instruction retired or skipped asleep, is one clk_ref cycle. A guest
// that sets the watchdog's CYCLES to 12, as the SDK does for its 12 MHz crystal, sees the timer count
// once every 12. Without a watchdog on the bus the timer never counts, as on a chip whose tick is never
// started.
//
// **The timer keeps the time of the latest core to touch it.** An access brings it to the clock of
// the instruction making it, so TIMELR reads the time it is read at. A core's interrupts are raised
// with the timer brought to that core's clock. A core's run ends where the next armed alarm fires, and
// the alarm's interrupt is taken at the first taken branch from there. A board whose cores all sleep
// skips to it, where its interrupt would wake one.
//
// **RESETS holds the timer in reset until the guest releases it**, as at power-on. While its bit is
// set the timer is held at its reset state, and an access to it stops the core at `Stop.Fault`, since
// what the bus does then is not something benchtop will guess at. A device released is reported done
// in RESET_DONE at once. A chip with no RESETS on its bus has its timer running from the start.
//
// An access the models refuse stops the core: one to no register at `Stop.Unmapped`, and one of a
// width, alignment or atomic alias the register does not take at `Stop.Fault`. The three devices are
// under one lock, which every access takes, whichever thread the core runs on.

import sh.sysl.benchtop.peripheral.rp2040 as rp
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.benchtop.v6m.{Cpu, Stop, IRQ0, could_wake, halt, lower_limit, raise}
import sh.sysl.rp2040.resets.RESET_TIMER_MASK
import sysl.math.min
import sysl.threads.Mutex

/** Which of the three devices the bus has and the IRQ each of the timer's four alarms raises (-1 for
 * none), which the board fixes, and under `live` the devices themselves.
 */
struct RpState
    has_resets: bool
    has_timer: bool
    timer_irqs: [4]int
    live: Mutex[RpLive]

/** The three devices, whether RESETS is on the bus (so it can hold the timer), the clock the timer
 * and the watchdog have been brought to, and the clock the timer's interrupt lines went up at (`NEVER`
 * while none is up).
 */
struct RpLive
    resets: rp.Resets
    timer: rp.Timer
    watchdog: rp.Watchdog
    has_resets: bool
    at: u64
    raised_at: u64

private rp_live(has_resets: bool) -> RpLive = RpLive(rp.resets(), rp.timer(), rp.watchdog(), has_resets, 0, NEVER)

/** None of the three on the bus. */
rp_state() -> RpState = RpState(false, false, [-1;4], Mutex.new(rp_live(false)))

// The devices a bus of `ds` has, with the IRQs the chip gives the timer's alarms.
private[virt] rp_of(ds: []const Mapped) -> RpState
    var has_resets = false
    var has_timer = false
    var irqs = [-1;4]

    for m in ds
        m.device match
            Resets -> has_resets = true
            Timer ->
                has_timer = true
                for k in 0..<4 do irqs[k] = m.irqs[k]
            _ -> ()
    RpState(has_resets, has_timer, irqs, Mutex.new(rp_live(has_resets)))

// The devices as at power-on, at clock 0.
private[virt] boot_rp(d: *RpState)
    d.live.with(s ->
        s.resets.reset()
        s.timer.reset()
        s.watchdog.reset()
        s.at = 0
        s.raised_at = NEVER)

private timer_held(s: *RpLive) -> bool = s.has_resets && s.resets.held & RESET_TIMER_MASK != 0

private timer_lines(s: *RpLive) -> u32 = if timer_held(s) then 0 else s.timer.irqs()

// Keep `raised_at` with the timer's lines: the clock `t` where they have just gone up, `NEVER` once
// they are all down.
private note_raised(s: *RpLive, t: u64)
    if timer_lines(s) == 0 then s.raised_at = NEVER
    elif s.raised_at == NEVER then s.raised_at = t

// Bring the watchdog and the timer to clock `t`, where they have not reached it already. An alarm
// that fires on the way fires at its own clock, not at `t`.
private bring(s: *RpLive, t: u64)
    if t <= s.at then return

    val fires = min(due(s), t)
    val ticks = s.watchdog.advance(t - s.at)

    if !timer_held(s) then s.timer.advance(ticks, 0)
    s.at = t
    note_raised(s, fires)

// The clock at which the timer's next armed alarm fires; `NEVER` where none will.
private due(s: *RpLive) -> u64
    if timer_held(s) then return NEVER

    val ticks = s.timer.next_alarm(0) match
        Some(n) -> n
        None -> return NEVER

    s.watchdog.cycles_to(ticks) match
        Some(c) -> s.at +| c
        None -> NEVER

/** The clock at which a run is to end for the timer's next alarm; `NEVER` where none will fire. */
private[virt] timer_due(d: *RpState) -> u64
    if !d.has_timer then return NEVER

    d.live.with(s -> due(s))

/** The clock at which the timer's interrupt wakes a sleeping `cpu`; `NEVER` where it will not. A line
 * already up, which another core's access may have brought the timer past an alarm to raise, wakes it
 * at the clock the line went up at; failing that, the next alarm whose interrupt is enabled wakes it
 * where it fires. An alarm that fires and raises nothing has still let the time pass.
 */
private[virt] timer_wake(d: *RpState, cpu: *Cpu) -> u64
    if !d.has_timer then return NEVER

    val (t, enabled, lines, raised) = d.live.with(s -> (due(s), s.timer.enable | s.timer.force, timer_lines(s), s.raised_at))
    var wake = NEVER

    for i in 0..<4
        val n = d.timer_irqs[i]
        val bit = 1u32 << u32(i)

        if n < 0 || !could_wake(cpu, IRQ0 + u32(n)) then continue
        if lines & bit != 0 then wake = min(wake, raised)
        elif enabled & bit != 0 then wake = min(wake, t)

    wake

/** Raise in `cpu` the timer's interrupts that are raised at its clock. */
private[virt] signal_rp(d: *RpState, cpu: *Cpu)
    if !d.has_timer then return

    val lines = d.live.with(s ->
        bring(s, board_time(cpu, cpu.retired))
        timer_lines(s))

    for i in 0..<4
        val n = d.timer_irqs[i]

        if n >= 0 && lines & (1 << u32(i)) != 0 then raise(cpu, u32(n))

// A device's half of an access the board's bus sent it, `n` instructions retired before the one
// making it.
private[virt] rp_read(st: *RpState, cpu: *Cpu, d: Device, a: u32, o: u32, width: u32, n: u64) -> u32
    val (held, got) = st.live.with(s ->
        bring(s, board_time(cpu, n))

        val held = d == Device.Timer && timer_held(s)
        (held, if held then Ok(0u32) else d match
            Resets -> s.resets.read(o, width)
            Watchdog -> s.watchdog.read(o, width)
            _ -> s.timer.read(o, width)))

    if held
        in_reset(cpu, a)
        return 0

    got match
        Ok(v) -> v
        Err(e) ->
            refused(cpu, a, e)
            0

private[virt] rp_write(st: *RpState, cpu: *Cpu, d: Device, a: u32, o: u32, width: u32, x: u32, n: u64)
    val (held, got, t) = st.live.with(s ->
        bring(s, board_time(cpu, n))

        val held = d == Device.Timer && timer_held(s)
        val got = if held then Ok(()) else d match
            Resets ->
                val r = s.resets.write(o, width, x)

                if timer_held(s) then s.timer.reset()
                s.resets.complete(rp.RESET_BITS)
                r
            Watchdog -> s.watchdog.write(o, width, x)
            _ -> s.timer.write(o, width, x)
        // A write may raise a line (an alarm set to the time, INTF) or clear one (INTR).
        note_raised(s, s.at)
        (held, got, due(s)))

    if held
        in_reset(cpu, a)
        return

    got match
        Ok(_) -> if t != NEVER then lower_limit(cpu, retirement_limit(cpu,t))
        Err(e) -> refused(cpu, a, e)

private refused(cpu: *Cpu, a: u32, e: rp.AccessError) = halt(cpu, if e == rp.AccessError.Unmapped then Stop.Unmapped else Stop.Fault, a)

private in_reset(cpu: *Cpu, a: u32) = halt(cpu, Stop.Fault, a)
