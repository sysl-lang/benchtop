module sh.sysl.benchtop.virt

import sh.sysl.sdl3 as sdl
import sh.sysl.benchtop.parts.ds3231 as rtc

// SDL's public SDL_DateTime layout; clock seeding is host policy, not part behavior.
struct HostDateTime
    year: int
    month: int
    day: int
    hour: int
    minute: int
    second: int
    nanosecond: int
    weekday: int
    utc_offset: int

@assert(sizeof(HostDateTime) == 36, "SDL_DateTime has nine 32-bit fields")
extern "SDL_GetCurrentTime" host_now(ticks: *long) -> bool
extern "SDL_TimeToDateTime" host_calendar(ticks: long, date: *HostDateTime, local: bool) -> bool

private[virt] seed_rtc_from_host(r: &rtc.Rtc) -> Result[unit, string]
    var ticks: long = 0
    var date: HostDateTime
    if !host_now(&ticks) || !host_calendar(ticks,&date,true) then return Err(sdl.error())
    if date.year < 2000 || date.year > 2199 then return Err("host time is outside the RTC's supported calendar")
    r.registers[0] = rtc.bcd(if date.second > 59 then 59 else int(date.second))
    r.registers[1] = rtc.bcd(int(date.minute))
    r.registers[2] = rtc.bcd(int(date.hour))
    r.registers[3] = u8(date.weekday + 1)
    r.registers[4] = rtc.bcd(int(date.day))
    r.registers[5] = rtc.bcd(int(date.month)) | (if date.year >= 2100 then 128 else 0)
    r.registers[6] = rtc.bcd(int(date.year % 100))
    r.registers[15] &= ~128u8
    r.remainder = u64(date.nanosecond) * r.hz / 1000000000
    rtc.start(r,true,0)
    Ok(())
