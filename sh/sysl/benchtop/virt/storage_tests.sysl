module sh.sysl.benchtop.virt
@tests
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sh.sysl.fat as fat
import sysl.raw.str_cast
import sysl.text.replace_all
import sysl.fs

private val STORAGE_GUEST = embed("../../../../examples/touch/storage-disco.elf")

@test("Discovery SD: flash firmware drives real SPI/GPIO, mounts FAT and saves settings without stopping M7 audio")
firmware_storage()
    val description = str_cast(embed("../../../../boards/stm32h747-sd.hocon"))
    var disk = fat.ram_device(32768)
    fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
    fs.write_bytes("target/storage-regression.img",disk.image()).unwrap()
    val file_board = replace_all(description,"target/disco-sd.img","target/storage-regression.img")
    board_from("sd-test.hocon",file_board.bytes) match
        Ok(_) -> ()
        Err(why) -> assert(false,why)
    boot(core0(),image_of(STORAGE_GUEST).unwrap().view())
    val executable = elf.read(STORAGE_GUEST).unwrap()
    val status = u32(executable.symbol_named("storage_status").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    val errors = u32(executable.symbol_named("audio_errors").unwrap().unwrap().value)
    val misses = u32(executable.symbol_named("audio_deadline_misses").unwrap().unwrap().value)
    start_workers(core0()).unwrap()
    defer stop_workers()
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core0()))
    assert(cpu.load32(core0(),status) == 1,s"storage status=${cpu.load32(core0(),status)} commands=${storage_card.unwrap().commands}")
    val before = cpu.load32(core0(),frames)
    touch_point("touch",342,332,true)
    submit_workers(20000000)
    wait_workers()
    touch_point("touch",342,332,false)
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core1()))
    assert(cpu.load32(core0(),status) == 2,s"save status=${cpu.load32(core0(),status)} writes=${storage_card.unwrap().writes}")
    assert(cpu.load32(core0(),frames) > before)
    assert(cpu.load32(core0(),errors) == 0 && cpu.load32(core0(),misses) == 0)
    val persisted = fs.read_bytes("target/storage-regression.img").unwrap()
    assert(persisted.len == sd_image().len)
    for i in 0..<persisted.len do assert(persisted[i] == sd_image()[i],"SAVED must mean queued file writes have completed")
    for sector in 0u64..<32768 do disk.write(sector,persisted[usize(sector)*512..<usize(sector+1)*512]).unwrap()
    var scratch: [512]u8 = [0;512]
    var volume = fat.mount(&disk,scratch[..]).unwrap()
    var file = volume.open("SETTINGS.TXT").unwrap()
    var text: [64]u8 = [0;64]
    val count = volume.read(&file,text[..]).unwrap()
    assert(str_cast(text[..<count]) == "feedback=35\nwet=035\n",str_cast(text[..<count]))
    assert(storage_card.unwrap().reads > 0 && storage_card.unwrap().writes > 0)

@test("Discovery SD: startup restores validated settings; malformed files keep both defaults")
firmware_storage_load()
    val description = replace_all(str_cast(embed("../../../../boards/stm32h747-sd.hocon")),"target/disco-sd.img","")
    val executable = elf.read(STORAGE_GUEST).unwrap()
    val status = u32(executable.symbol_named("storage_status").unwrap().unwrap().value)
    val control = u32(executable.symbol_named("audio_control").unwrap().unwrap().value)
    val examples: [8]string = ["feedback=57\nwet=063\n", "feedback=85\nwet=100\n",
        "feedback=00\nwet=000\n", "feedback=86\nwet=063\n", "feedback=57\nwet=101\n",
        "feedback=57\nwet=x63\n", "feedback=57\nwet=063", "feedback=57\nwet=063\nextra"]
    for index in 0..<examples.len
        var disk = fat.ram_device(32768)
        fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
        var scratch: [512]u8 = [0;512]
        var volume = fat.mount(&disk,scratch[..]).unwrap()
        var file = volume.create("SETTINGS.TXT").unwrap()
        volume.write(&file,examples[index].bytes).unwrap()
        volume.flush().unwrap()
        board_from("sd-load-test.hocon",description.bytes).unwrap()
        sd_seed_image(disk.image())
        boot(core0(),image_of(STORAGE_GUEST).unwrap().view())
        start_workers(core0()).unwrap()
        submit_workers(240000000)
        wait_workers()
        pause_workers()
        val running = workers_observe().running
        stop_workers()
        assert(running,stop_message(core1()))
        assert(cpu.load32(core0(),status) == (if index < 3 then 5u32 else 4u32),s"case $index status=${cpu.load32(core0(),status)}")
        val feedback: u32 = if index == 0 then 57 elif index == 1 then 85 elif index == 2 then 0 else 35
        val wet: u32 = if index == 0 then 63 elif index == 1 then 100 elif index == 2 then 0 else 35
        assert(cpu.load32(core0(),control + 16) == feedback,s"case $index feedback")
        assert(cpu.load32(core0(),control + 20) == wet,s"case $index wet")
