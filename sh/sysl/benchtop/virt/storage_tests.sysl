module sh.sysl.benchtop.virt
@tests
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sh.sysl.fat as fat
import sysl.raw.str_cast
import sysl.fs

private val STORAGE_GUEST = embed("../../../../examples/touch/storage-disco.elf")

@test("Discovery SD: flash firmware drives real SPI/GPIO, mounts FAT and saves settings without stopping M7 audio")
firmware_storage()
    val description = str_cast(embed("../../../../boards/stm32h747-sd.hocon"))
    val ram_board = description.replace("target/disco-sd.img","")
    board_from("sd-test.hocon",ram_board.bytes) match
        Ok(_) -> ()
        Err(why) -> assert(false,why)
    var disk = fat.ram_device(32768)
    fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
    sd_seed_image(disk.image())
    boot(core0(),image_of(STORAGE_GUEST).unwrap().view())
    val executable = elf.read(STORAGE_GUEST).unwrap()
    val status = u32(executable.symbol_named("storage_status").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    val errors = u32(executable.symbol_named("audio_errors").unwrap().unwrap().value)
    val misses = u32(executable.symbol_named("audio_deadline_misses").unwrap().unwrap().value)
    start_workers(core0()).unwrap()
    defer stop_workers()
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core0()))
    assert(cpu.load32(core0(),status) == 1,s"storage status=${cpu.load32(core0(),status)} commands=${storage_card.unwrap().commands}")
    val before = cpu.load32(core0(),frames)
    touch_point("touch",342,332,true)
    submit_workers(20000000)
    wait_workers()
    touch_point("touch",342,332,false)
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core1()))
    assert(cpu.load32(core0(),status) == 2,s"save status=${cpu.load32(core0(),status)} writes=${storage_card.unwrap().writes}")
    assert(cpu.load32(core0(),frames) > before)
    assert(cpu.load32(core0(),errors) == 0 && cpu.load32(core0(),misses) == 0)
    for sector in 0u64..<32768 do disk.write(sector,sd_image()[usize(sector)*512..<usize(sector+1)*512]).unwrap()
    var scratch: [512]u8 = [0;512]
    var volume = fat.mount(&disk,scratch[..]).unwrap()
    var file = volume.open("SETTINGS.TXT").unwrap()
    var text: [64]u8 = [0;64]
    val count = volume.read(&file,text[..]).unwrap()
    assert(str_cast(text[..<count]) == "feedback=35\nwet=035\n",str_cast(text[..<count]))
    assert(storage_card.unwrap().reads > 0 && storage_card.unwrap().writes > 0)
