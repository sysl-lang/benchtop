module sh.sysl.benchtop.virt
@tests
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sh.sysl.fat as fat
import sysl.raw.str_cast
import sysl.text.replace_all
import sysl.fs
import sysl.buf.{Buf, buf_filled}
import sysl.sync.*
import sysl.threads.spawn
import sysl.time.{sleep,millis}

// The image writer, started only after the guest has already filled its queue.
private drain_later(writer: *DiskWriter)
    sleep(millis(50))
    disk_body(writer)

@test("SD image: a full host write queue makes the guest wait for a slot, never a failed write")
host_backpressure()
    val dir = fs.make_temp_dir("benchtop-backpressure").unwrap()
    defer fs.remove_dir_all(dir).unwrap()
    val file = s"$dir/card.img"
    val bytes = buf_filled(80 * 512, u8(0))
    fs.write_bytes(file,bytes.view()).unwrap()
    val image = sd_image_of(bytes,file)
    val media = storage_media(image)
    val queued = image.slots.with(s -> s.len())
    var data: [512]u8 = [0;512]
    for sector in 0..<queued + 1
        if sector == queued then image.thread = spawn(&drain_later,&image.writer,1 << 20)
        data[0] = u8(sector + 1)
        assert((media.write)(u32(sector),data[..]),s"sector $sector is written, not refused")
    image.writer.queue.close()
    image.thread.unwrap().join()
    assert(atomic_load(&image.writer.failed,Acquire) == 0)
    val written = fs.read_bytes(file).unwrap()
    for sector in 0..<queued + 1 do assert(written[sector * 512] == u8(sector + 1),s"sector $sector reached the file")

private val STORAGE_GUEST = embed("../../../../examples/touch/storage-disco.elf")

// The bytes of a 16 MiB card (32768 sectors), which a test's `fat.ram_device` works over and the test
// keeps alive for as long as the device.
private[virt] blank_card() -> Buf[u8] = buf_filled(32768 * 512, u8(0))

@test("Discovery SD: flash firmware drives real SDMMC/IDMA, mounts FAT and saves settings without stopping M7 audio")
firmware_storage()
    val description = str_cast(embed("../../../../boards/stm32h747-sd.hocon"))
    val storage = blank_card()
    var disk = fat.ram_device(storage.view())
    fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
    val dir = fs.make_temp_dir("benchtop-storage").unwrap()
    defer fs.remove_dir_all(dir).unwrap()
    val card = s"$dir/storage-regression.img"
    fs.write_bytes(card,disk.image()).unwrap()
    val file_board = replace_all(description,"target/disco-sd.img",card)
    val board = machine()
    val m = &*board
    board_from(m, "sd-test.hocon",file_board.bytes) match
        Ok(_) -> ()
        Err(why) -> assert(false,why)
    boot(m,image_of(m, STORAGE_GUEST).unwrap().view())
    val executable = elf.read(STORAGE_GUEST).unwrap()
    val status = u32(executable.symbol_named("storage_status").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    val errors = u32(executable.symbol_named("audio_errors").unwrap().unwrap().value)
    val misses = u32(executable.symbol_named("audio_deadline_misses").unwrap().unwrap().value)
    start_workers(m).unwrap()
    defer stop_workers()
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core0(m)))
    assert(cpu.load32(core0(m),status) == 1,s"storage status=${cpu.load32(core0(m),status)} commands=${with_sd_card(m, c -> c.stats.commands)}")
    assert(m.devices.sdmmc.live.with(l -> l.host.wiring.card.is_some() && l.host.wiring.card.unwrap().width == 4 && l.host.stats.transfers > 0))
    val before = cpu.load32(core0(m),frames)
    touch_point(m, "touch",342,332,true)
    submit_workers(20000000)
    wait_workers()
    touch_point(m, "touch",342,332,false)
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core1(m)))
    assert(cpu.load32(core0(m),status) == 2,s"save status=${cpu.load32(core0(m),status)} writes=${with_sd_card(m, c -> c.stats.writes)}")
    assert(cpu.load32(core0(m),frames) > before)
    assert(cpu.load32(core0(m),errors) == 0 && cpu.load32(core0(m),misses) == 0)
    val persisted = fs.read_bytes(card).unwrap()
    val image = sd_image(m)
    assert(persisted.len == image.view().len)
    for i in 0..<persisted.len do assert(persisted[i] == image.view()[i],"SAVED must mean queued file writes have completed")
    for sector in 0u64..<32768 do disk.write(sector,persisted[usize(sector)*512..<usize(sector+1)*512]).unwrap()
    var scratch: [512]u8 = [0;512]
    var volume = fat.mount(&disk,scratch[..]).unwrap()
    var file = volume.open("SETTINGS.TXT").unwrap()
    var text: [64]u8 = [0;64]
    val count = volume.read(&file,text[..]).unwrap()
    assert(str_cast(text[..<count]) == "feedback=35\nwet=035\n",str_cast(text[..<count]))
    assert(with_sd_card(m, c -> c.stats.reads > 0 && c.stats.writes > 0))
    // A fresh board instance reloads the file that guest firmware saved to disk.
    stop_workers()
    board_from(m, "sd-restart-test.hocon",file_board.bytes).unwrap()
    boot(m,image_of(m, STORAGE_GUEST).unwrap().view())
    start_workers(m).unwrap()
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core1(m)))
    assert(cpu.load32(core0(m),status) == 5,"saved settings must load after reopening the image")

@test("Discovery SD: startup restores validated settings; malformed files keep both defaults")
firmware_storage_load()
    val description = replace_all(str_cast(embed("../../../../boards/stm32h747-sd.hocon")),"target/disco-sd.img","")
    val executable = elf.read(STORAGE_GUEST).unwrap()
    val status = u32(executable.symbol_named("storage_status").unwrap().unwrap().value)
    val control = u32(executable.symbol_named("audio_control").unwrap().unwrap().value)
    val examples: [8]string = ["feedback=57\nwet=063\n", "feedback=85\nwet=100\n",
        "feedback=00\nwet=000\n", "feedback=86\nwet=063\n", "feedback=57\nwet=101\n",
        "feedback=57\nwet=x63\n", "feedback=57\nwet=063", "feedback=57\nwet=063\nextra"]
    val board = machine()
    val m = &*board
    for index in 0..<examples.len
        val storage = blank_card()
        var disk = fat.ram_device(storage.view())
        fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
        var scratch: [512]u8 = [0;512]
        var volume = fat.mount(&disk,scratch[..]).unwrap()
        var file = volume.create("SETTINGS.TXT").unwrap()
        volume.write(&file,examples[index].bytes).unwrap()
        volume.flush().unwrap()
        board_from(m, "sd-load-test.hocon",description.bytes).unwrap()
        sd_seed_image(m, disk.image())
        boot(m,image_of(m, STORAGE_GUEST).unwrap().view())
        start_workers(m).unwrap()
        submit_workers(240000000)
        wait_workers()
        pause_workers()
        val running = workers_observe().running
        stop_workers()
        assert(running,stop_message(core1(m)))
        assert(cpu.load32(core0(m),status) == (if index < 3 then 5u32 else 4u32),s"case $index status=${cpu.load32(core0(m),status)}")
        val feedback: u32 = if index == 0 then 57 elif index == 1 then 85 elif index == 2 then 0 else 35
        val wet: u32 = if index == 0 then 63 elif index == 1 then 100 elif index == 2 then 0 else 35
        assert(cpu.load32(core0(m),control + 16) == feedback,s"case $index feedback")
        assert(cpu.load32(core0(m),control + 20) == wet,s"case $index wet")
        assert(cpu.load32(core0(m),control + 4) == 0,"restoring settings must leave monitor off")
