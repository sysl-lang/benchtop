module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{Cpu, Kind, Stop}
import sysl.raw.str_cast
import sysl.text.replace_all

val crunch_m7 = embed("../../../../examples/virt/crunch-m7.elf")
val dual_m7 = embed("../../../../examples/virt/dual-m7.elf")
val exclusive_m7 = embed("../../../../examples/virt/exclusive-m7.elf")
val isa_m7 = embed("../../../../examples/virt/isa-m7.elf")

@test("virt7 runs M7-tuned integer guests on both cores, in turns and on threads, then still boots the old models")
m7_guests()
    val cpu = core0()
    for parallel in [false, true]
        var stopped = run_on(cpu, "virt7", crunch_m7, parallel)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, "crunch exits")
        assert(output() == crunch_host, "crunch matches host")
        assert(cpu.kind == Kind.V7emM7 && core1().kind == Kind.V7emM7, "both M7s")
        stopped = run_on(cpu, "virt7", dual_m7, parallel)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, "dual exits")
        // The committed M7 ELF places core1_stack at 0x3D8; its 256 words end at 2008.
        val want = lines(replace_all(DUAL_OUTPUT, "stack top at 2392", "stack top at 2008").bytes)
        val got = lines(output())
        assert(got.len() == want.len(), str_cast(output()))
        assert(got.view()[0..<10] == want.view()[0..<10], "FIFO conversation")
        assert(got.at(got.len() - 1) == want.at(want.len() - 1), "final total")
        for k in 0..<2 do assert(said_by(got.view(), k).view() == said_by(want.view(), k).view(), "each core's lines in order")
        stopped = run_on(cpu, "virt7", exclusive_m7, parallel)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, "exclusives exit")
        assert(output() == "word 40000, half 40000, byte 64\n".bytes, "word, halfword and byte counters")
    end for

    for (board, image, kind) in [("virt4", crunch_m4, Kind.V7em), ("virt33", crunch_m33, Kind.V8mMain), ("virt", crunch_m0, Kind.V6m)]
        val stopped = run_on(cpu, board, image, false)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0 && output() == crunch_host, "old guest unchanged")
        assert(cpu.kind == kind && core1().kind == kind, "no model leaks between boots")
end m7_guests

@test("M7 shared ISA: 96 instructions over edge operands and flag states match the existing QEMU reference")
m7_isa()
    val cpu = core0()
    val stopped = run_on(cpu, "virt7", isa_m7, false)
    assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, stop_message(stopped))
    val want = lines(isa_qemu)
    val got = lines(output())
    assert(got.len() == want.len(), str_cast(output()))
    for i in 0..<want.len() do assert(got.at(i) == want.at(i), s"M7: ${got.at(i)}, QEMU: ${want.at(i)}")
end m7_isa

@test("M4 and M7 cannot be combined accidentally into a homogeneous virtual board")
m7_mixed_refused()
    val text = "board { name = mixed, chip { name = mixed, cores = [cortex-m4, cortex-m7], peripherals { ram { peripheral = ram, at = 0, size = 1M } } } }"
    board_from("mixed.hocon", text.bytes) match
        Ok(_) -> assert(false, "mixed models must be refused")
        Err(why) -> assert(why.contains("the mixed has cortex-m4, cortex-m7"), why)
end m7_mixed_refused
