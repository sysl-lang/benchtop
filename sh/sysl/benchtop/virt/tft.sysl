module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, part_whole}
import sh.sysl.benchtop.parts.mipi_dcs as tft
import sh.sysl.benchtop.parts.spi as spi
import sysl.buf.{Buf, buf}

struct TftBinding
    name: string
    model: &tft.Display
    port: spi.Port
    width: int
    height: int
    x: int
    y: int

struct TftFrame
    width: int
    height: int
    pixels: Buf[u32]

var tft_bindings: Buf[TftBinding] = buf()

private[virt] configure_tfts(b: Board)
    tft_bindings = buf()
    for p in b.parts
        if p.kind != "st7789" then continue
        tft_bindings.push(TftBinding(p.name, tft.display(240, 320),
            spi.port(terminal_pin(p, "cs", b.chip.name), terminal_pin(p, "sck", b.chip.name), terminal_pin(p, "mosi", b.chip.name),
                terminal_pin(p, "dc", b.chip.name), terminal_pin(p, "reset", b.chip.name)),
            int(part_whole(p, "width", 240)), int(part_whole(p, "height", 240)),
            int(part_whole(p, "column-offset", 0)), int(part_whole(p, "row-offset", 0))))

private[virt] reset_tfts()
    for i in 0..<tft_bindings.len()
        var b = tft_bindings.at(i)
        b.model = tft.display(240, 320)
        spi.restart(&b.port)
        tft_bindings.set(i, b)

private[virt] observe_tfts(levels: u32, driven: u32)
    for i in 0..<tft_bindings.len()
        var b = tft_bindings.at(i)
        spi.transfer(&b.port, levels, driven) match
            Reset -> tft.reset(b.model)
            Byte(data, byte) -> tft.write(b.model, data, byte)
            Idle -> ()
        tft_bindings.set(i, b)

/** Consistent RGB snapshot; no peripheral execution or framebuffer aliases escape the lock. */
tft_frame(name: string) -> Option[TftFrame]
    display_lock.lock()
    defer display_lock.unlock()
    for b in tft_bindings
        if b.name != name then continue
        var pixels: Buf[u32] = buf()
        for y in 0..<b.height
            for x in 0..<b.width do pixels.push(tft.pixel(b.model, x + b.x, y + b.y))
        return Some(TftFrame(b.width, b.height, pixels))
    None
