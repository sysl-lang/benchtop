module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, part_model, part_whole}
import sh.sysl.benchtop.parts.mipi_dcs as tft
import sh.sysl.benchtop.parts.spi as spi
import sysl.buf.{Buf, buf}

struct TftBinding
    name: string
    model: &tft.Display
    port: Option[spi.Port]
    width: int
    height: int
    x: int
    y: int
    dsi_channel: int

struct TftFrame
    width: int
    height: int
    pixels: Buf[u32]

// The MIPI DCS panels `b` has: on the DSI, or on SPI wired to its chip (an ST7789).
private[virt] tfts_of(b: Board) -> Buf[TftBinding]
    var tfts: Buf[TftBinding] = buf()
    for p in b.parts
        if part_model(p) == "mipi-dcs-display"
            val w = int(part_whole(p,"width",800))
            val h = int(part_whole(p,"height",480))
            tfts.push(TftBinding(p.name,tft.display(w,h),None,w,h,0,0,int(part_whole(p,"channel",0))))
            continue
        if part_model(p) != "st7789" then continue
        tfts.push(TftBinding(p.name, tft.display(240, 320),
            Some(spi.port(terminal_pin(p, "cs", b.chip.name), terminal_pin(p, "sck", b.chip.name), terminal_pin(p, "mosi", b.chip.name),
                terminal_pin(p, "dc", b.chip.name), terminal_pin(p, "reset", b.chip.name))),
            int(part_whole(p, "width", 240)), int(part_whole(p, "height", 240)),
            int(part_whole(p, "column-offset", 0)), int(part_whole(p, "row-offset", 0)), -1))
    tfts

private[virt] reset_tfts(s: *DisplayState)
    for i in 0..<s.tfts.len()
        var b = s.tfts.at(i)
        b.model = tft.display(if b.dsi_channel >= 0 then b.width else 240, if b.dsi_channel >= 0 then b.height else 320)
        b.port match
            Some(port) ->
                var wire = port
                spi.restart(&wire)
                b.port = Some(wire)
            None -> ()
        s.tfts.set(i, b)

private[virt] observe_tfts(s: *DisplayState, levels: u32, driven: u32)
    for i in 0..<s.tfts.len()
        var b = s.tfts.at(i)
        if b.port.is_none() then continue
        var wire = b.port.unwrap()
        spi.transfer(&wire, levels, driven) match
            Reset -> tft.reset(b.model)
            Byte(data, byte) -> tft.write(b.model, data, byte)
            Idle -> ()
        b.port = Some(wire)
        s.tfts.set(i, b)

/** Consistent RGB snapshot; no peripheral execution or framebuffer aliases escape the lock. The lock
 * is held for a copy of the panel's memory only, so the DSI worker applying packets, and a core
 * writing the panel over SPI, wait for a copy rather than for a conversion of every pixel; the
 * conversion runs after.
 */
tft_frame(name: string) -> Option[TftFrame]
    var pixels: Buf[u32] = buf()
    val into = &pixels
    val found = machine.devices.displays.live.with(s ->
        var found: Option[(int, int, tft.Look, tft.Inside)] = None
        for b in s.tfts
            if b.name != name then continue
            found = Some((b.width, b.height, tft.look(b.model), tft.copy_window(b.model, b.x, b.y, b.width, b.height, into)))
            break
        found)
    val (width, height, look, inside) = found?
    tft.show(look, inside, width, &pixels)
    Some(TftFrame(width, height, pixels))
