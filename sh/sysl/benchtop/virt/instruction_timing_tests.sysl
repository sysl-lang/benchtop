module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu

@test("instruction timing: per-core modes survive launch, reset and switching back to a unit board")
instruction_timing_configuration()
    val board = machine()
    val m = &*board
    val description = "board { name = timing, mcu { name = timing, cores = [{ core = cortex-m7, instruction-timing = estimated }, { core = cortex-m7, instruction-timing = unit }], peripherals { ram { peripheral = ram, at = 0, size = 1M } } } }"
    assert(board_from(m, "timing.hocon",description.bytes).is_ok())
    for round in 0..<2
        boot(m,[])
        launch(m,0,0x80000,0x201)
        assert(core0(m).instruction_timing && !core1(m).instruction_timing)
        cpu.store16(core0(m),0x100,0xe7fe)
        cpu.store16(core1(m),0x200,0xe7fe)
        core0(m).pc = 0x100
        for c in [core0(m),core1(m)]
            cpu.set_limit(c,1)
            cpu.run_threaded(c)
        assert(core0(m).retired == 1 && cpu.cycles(core0(m)) == 2)
        assert(core1(m).retired == 1 && cpu.cycles(core1(m)) == 1)
    assert(board_named(m, "virt").is_ok())
    boot(m,[])
    launch(m,0,0x80000,0x201)
    assert(!core0(m).instruction_timing && !core1(m).instruction_timing)
    assert(cpu.cycles(core0(m)) == 0 && cpu.cycles(core1(m)) == 0)
