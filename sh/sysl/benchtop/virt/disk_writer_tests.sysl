module sh.sysl.benchtop.virt
@tests

import sh.sysl.fat as fat
import sysl.fs as fs
import sysl.raw.str_cast
import sysl.text.replace_all

@test("SD image writer: a board read from a file starts its writer while the description is let go, again and again")
disk_writer_owns_its_path()
    val dir = fs.make_temp_dir("benchtop-disk-writer").unwrap()
    defer fs.remove_dir_all(dir).unwrap()
    val card = s"$dir/writer.img"
    val storage = blank_card()
    var disk = fat.ram_device(storage.view())
    fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
    fs.write_bytes(card,disk.image()).unwrap()
    val board = machine()
    val m = &*board
    for round in 0..<20
        // Each description is built, read and dropped here while the writer it started opens the file.
        val description = replace_all(str_cast(embed("../../../../boards/stm32h747-sd.hocon")),"target/disco-sd.img",card)
        board_from(m, "writer-test.hocon",description.bytes).unwrap()
        assert(str_cast(m.devices.storage.image.writer.path.view()) == card)
    assert(board_named(m, "stm32h747-disco").is_ok())
    assert(fs.read_bytes(card).unwrap().len == disk.image().len)
