module sh.sysl.benchtop.virt
@tests

import sysl.raw.str_cast
import sysl.text.replace_all

private clock_board(hz: string) -> string = replace_all(
    str_cast(embed("../../../../boards/touch.hocon")), "clock-hz = 150000000", s"clock-hz = $hz")

@test("MCU clock: peripheral guest timebases inherit the MCU clock and conflicting legacy values fail")
mcu_clock_timebases()
    val board = machine()
    val m = &*board
    val text = replace_all(clock_board("150000000"), "power { part", "rtc { part = DS3231, initial-time = fixed, wire { i2c = i2c0 } }\n    power { part")
    assert(board_from(m, "clock.hocon", text.bytes).is_ok())
    assert(clock_hz(m) == 150000000)
    assert(m.devices.pwm.live.with(s -> s.channel.hz) == 150000000 && m.devices.i2s.controller.with(c -> c.hz) == 150000000)
    assert(m.devices.i2c.live.with(s -> s.rtcs.at(0).model.hz) == 150000000)
    val conflicting = replace_all(text, "peripheral = virt-i2c,", "peripheral = virt-i2c, clock-hz = 12000000,")
    assert(board_from(m, "conflict.hocon", conflicting.bytes).is_err())
    assert(board_named(m, "virt").is_ok())
    assert(clock_hz(m) == 0, "an omitted clock preserves legacy pacing")

@test("core clocks: inheritance, invalid divisors, absent MCU clocks and range errors")
core_clock_validation()
    val board = machine()
    val m = &*board
    val base = clock_board("480000000")
    val mixed = replace_all(base,"{ core = cortex-m33, fpu = sp }, { core = cortex-m33, fpu = sp }",
        "{ core = cortex-m7, fpu = dp, clock-hz = 480000000 }, { core = cortex-m4, fpu = sp, clock-hz = 240000000 }")
    assert(board_from(m, "mixed.hocon",mixed.bytes).is_ok())
    assert(clock_divisors(m) == [1u64,2u64])
    for hz in ["0","-1","1000000001","960000000","250000000"]
        val bad = replace_all(mixed,"clock-hz = 240000000",s"clock-hz = $hz")
        assert(board_from(m, "invalid.hocon",bad.bytes).is_err(),hz)
    val absent = replace_all(mixed,"    clock-hz = 480000000\n","")
    assert(board_from(m, "absent.hocon",absent.bytes).is_err())
    assert(board_from(m, "inherited.hocon",base.bytes).is_ok())
    assert(clock_divisors(m) == [1u64,1u64])
    assert(board_named(m, "virt").is_ok())
    assert(clock_divisors(m) == [1u64,1u64])
