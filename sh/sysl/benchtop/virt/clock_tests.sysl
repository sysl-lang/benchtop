module sh.sysl.benchtop.virt
@tests

import sysl.raw.str_cast
import sysl.text.replace_all

private clock_board(hz: string) -> string = replace_all(
    str_cast(embed("../../../../boards/touch.hocon")), "clock-hz = 150000000", s"clock-hz = $hz")

@test("MCU clock: peripheral guest timebases inherit the MCU clock and conflicting legacy values fail")
mcu_clock_timebases()
    val text = replace_all(clock_board("150000000"), "power { part", "rtc { part = DS3231, i2c = i2c0, initial-time = fixed }\n    power { part")
    assert(board_from("clock.hocon", text.bytes).is_ok())
    assert(clock_hz() == 150000000)
    assert(pwm_channel.hz == 150000000 && digital_audio.hz == 150000000)
    assert(rtc_bindings.at(0).model.hz == 150000000)
    val conflicting = replace_all(text, "peripheral = virt-i2c,", "peripheral = virt-i2c, clock-hz = 12000000,")
    assert(board_from("conflict.hocon", conflicting.bytes).is_err())
    assert(board_named("virt").is_ok())
    assert(clock_hz() == 0, "an omitted clock preserves legacy pacing")
