module sh.sysl.benchtop.virt

import sh.sysl.benchtop.peripheral.dsi as dsi
import sysl.threads.{Thread,Mutex,Condvar,Channel,channel,spawn,current}
import sysl.buf.{Buf,buf}
import sysl.time.monotonic
import sysl.sync.*

// Fixed packet values cross the channel; no views, display references or CPU
// pointers cross domains. The existing bounded channel supplies the semaphore-
// style queue wakeups. CPU producers use try_send, never a blocking send.
private const DSI_QUEUE_CAPACITY: usize = 64

/** A DSI packet a core's write sends the DSI worker: its virtual channel, its kind, the read it
 * answers (if any), and its first `count` bytes.
 */
struct DsiPacket
    channel: u32
    kind: u32
    request: u64
    count: usize
    bytes: [1024]u8

/** What the DSI worker has been given and has done, the host time it has spent applying packets, and
 * its thread's id once it runs.
 */
struct DsiProgress
    outstanding: u64
    completed: u64
    busy_us: u64
    thread_id: u64

/** The DSI worker: the host thread that applies the packets the cores' writes send it to the
 * displays, which runs while the CPU workers do (`running`), its queue (`queue`, its packets held in
 * `slots`, whose lock no thread takes), how many packets are in the queue (`queued`, atomic, so a
 * core's status read asks it without the queue's lock), and its progress, which `changed` is notified
 * of. The scheduler owns it, and the worker's thread holds the queue's address, so it is reset in
 * place, never replaced.
 */
struct DsiWorker
    slots: Mutex[Buf[DsiPacket]]
    queue: Channel[DsiPacket]
    queued: usize
    handle: Option[Thread]
    progress: Mutex[DsiProgress]
    changed: Condvar
    running: bool

/** A DSI worker not started. */
dsi_worker() -> DsiWorker
    var slots: Buf[DsiPacket] = buf()
    for i in 0..<DSI_QUEUE_CAPACITY do slots.push(DsiPacket(0,0,0,0,[0;1024]))
    val queue = channel(slots.view())
    DsiWorker(Mutex.new(slots), queue, 0, None, Mutex.new(DsiProgress(0,0,0,0)), Condvar.new(), false)

struct DsiWorkerStatus
    worker_id: u64
    queued: usize
    outstanding: u64
    completed: u64
    busy_us: u64

dsi_worker_status() -> DsiWorkerStatus
    val w = &scheduler.dsi
    val queued = if w.running then atomic_load(&w.queued,Acquire) else 0
    w.progress.with(p -> DsiWorkerStatus(p.thread_id,queued,p.outstanding,p.completed,p.busy_us))

// Whether the DSI worker runs: a core's DSI write then queues its packet rather than applying it.
@inline
private[virt] dsi_async() -> bool = scheduler.dsi.running

private[virt] start_dsi_worker() -> Result[unit,string]
    if !machine.devices.dsi.present then return Ok(())
    val w = &scheduler.dsi
    w.queue = w.slots.with(slots -> channel(slots.view()))
    atomic_store(&w.queued,0,Release)
    w.progress.with(p -> *p = DsiProgress(0,0,0,0))
    w.running = true
    machine.devices.dsi.host.with(h -> (*h).defer_reads = true)
    w.handle = spawn(&dsi_device_body,w,1 << 20)
    if w.handle.is_none()
        w.running = false
        machine.devices.dsi.host.with(h -> (*h).defer_reads = false)
        return Err("cannot create the DSI device worker")
    val p = w.progress.lock_raw()
    while p.thread_id == 0 do w.changed.wait(&w.progress)
    w.progress.unlock_raw()
    Ok(())

// Only call with CPU producers parked. This is a control/debug barrier, never
// part of normal instruction execution or status polling.
private[virt] flush_dsi_worker()
    val w = &scheduler.dsi
    if !w.running then return
    loop
        val p = w.progress.lock_raw()
        while p.outstanding != 0 do w.changed.wait(&w.progress)
        w.progress.unlock_raw()
        // A previously full queue may have held a due hardware command busy.
        // Catch it up to the parked board clock before declaring the barrier.
        machine.devices.dsi.host.with(h ->
            advance_dsi(h,scheduler.now)
            publish_dsi_deadline(h))
        if w.progress.with(p -> p.outstanding == 0) then return

private[virt] stop_dsi_worker()
    val w = &scheduler.dsi
    if !w.running then return
    flush_dsi_worker()
    w.queue.close()
    w.handle.unwrap().join()
    w.handle = None
    w.running = false
    machine.devices.dsi.host.with(h -> (*h).defer_reads = false)
    w.progress.with(p -> p.thread_id = 0)

private[virt] dsi_queue_has_room() -> bool = !dsi_async() || atomic_load(&scheduler.dsi.queued,Acquire) < DSI_QUEUE_CAPACITY

// Under the host's lock: there is only one producer at a time, and advance_dsi
// already checked capacity. A full host queue leaves the command FIFO busy.
private[virt] enqueue_dsi_packet(vc: u32, kind: u32, bytes: []const u8, request: u64)
    val w = &scheduler.dsi
    var packet = DsiPacket(vc,kind,request,bytes.len,[0;1024])
    for i in 0..<bytes.len do packet.bytes[i] = bytes[i]
    w.progress.with(p -> p.outstanding += 1)
    atomic_add(&w.queued,1,AcqRel)
    assert(w.queue.try_send(packet),"DSI queue capacity checked under the host's lock")

private dsi_device_body(w: *DsiWorker)
    w.progress.with(p ->
        p.thread_id = current().id
        w.changed.notify_all())
    loop
        val packet = w.queue.receive() match
            Some(p) -> p
            None -> break
        val start = monotonic()
        atomic_sub(&w.queued,1,AcqRel)
        // Freeing a queue slot lets a due hardware command complete. Never
        // hold the queue lock while processing pixels or waiting for the UI.
        machine.devices.dsi.host.with(h -> publish_dsi_deadline(h))
        var response: Buf[u8] = buf()
        val into = &response
        machine.devices.displays.live.with(s -> apply_dsi_packet(s,packet.channel,packet.kind,packet.bytes[..<packet.count],into))
        if packet.kind == 6 || packet.kind == 4 || packet.kind == 0x14 || packet.kind == 0x24
            machine.devices.dsi.host.with(h ->
                dsi.complete_read(*h,packet.request,response.view())
                publish_dsi_deadline(h))
        val spent = u64((monotonic() - start).us)
        w.progress.with(p ->
            p.completed += 1
            p.outstanding -= 1
            p.busy_us += spent
            w.changed.notify_all())
