module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{mcu_clock_hz, Board, part_model, part_whole, part_text}
import sh.sysl.benchtop.parts.ds3231 as rtc
import sh.sysl.benchtop.peripheral.i2c as i2c
import sh.sysl.benchtop.v6m.{Cpu, Stop, halt}
import sysl.buf.{Buf, buf}
import sysl.threads.SleepLock
import sysl.math.max

struct RtcBinding
    name: string
    model: &rtc.Rtc

/** The I2C controller (`virt-i2c`, or `stm32-i2c` where `stm32` says so) and the parts on its bus:
 * real-time clocks and touch controllers. The codec on the bus is a device of its own (codec.sysl).
 * `v2_regs`, `v2_status` and `v2_left` are the STM32 controller's registers (i2c_v2.sysl).
 */
struct I2cState
    controller: i2c.Controller
    stm32: bool
    rtcs: Buf[RtcBinding]
    touches: Buf[TouchBinding]
    focals: Buf[FocalBinding]
    v2_regs: [8]u32
    v2_status: u32
    v2_left: u32

var rtc_lock = SleepLock.new()

/** No part on the I2C bus. */
i2c_state() -> I2cState = I2cState(i2c.controller(buf()), false, buf(), buf(), buf(), [0;8], 1, 0)

// The I2C bus `b` makes, with the codec on it.
private[virt] check_i2c(b: Board) -> Result[(I2cState, CodecState), string]
    var s = i2c_state()
    for p in b.chip.peripherals do if p.kind == "stm32-i2c" then s.stm32 = true
    var devices: Buf[i2c.Device] = buf()
    var hz: u64 = mcu_clock_hz(b.chip)
    for p in b.chip.peripherals
        if p.kind != "virt-i2c" then continue
        for q in p.params do q.value match
            Whole(n) -> if q.name == "clock-hz" then hz = u64(n)
            _ -> ()
    for p in b.parts
        if part_model(p) != "ds3231" then continue
        if !devices.is_empty() then return Err("two DS3231 parts share the fixed I2C address 0x68")
        val model = rtc.rtc(hz, int(part_whole(p, "initial-year", 2026)), int(part_whole(p, "initial-month", 1)), int(part_whole(p, "initial-day", 1)), int(part_whole(p, "temperature-quarter-c", 100)))
        if part_text(p,"initial-time","host") == "host" then seed_rtc_from_host(model)?
        s.rtcs.push(RtcBinding(p.name, model))
        devices.push(i2c.Device(0x68, (reading, time) -> rtc.start(model, reading, max(model.time, time)),
            (byte, time) -> rtc.write(model, byte, max(model.time, time)), time -> rtc.read(model, max(model.time, time))))
    check_touches(b, &s, &devices)?
    val codec = check_codec(b, &devices)?
    s.controller = i2c.controller(devices)
    Ok((s, codec))

private[virt] boot_i2c()
    val s = &machine.devices.i2c
    i2c.reset(&s.controller)
    boot_i2c_v2()
    boot_touches()
    boot_codecs()
    for b in s.rtcs do rtc.rebase(b.model, 0)

private[virt] signal_rtcs(cpu: *Cpu)
    val s = &machine.devices.i2c
    if s.rtcs.is_empty() then return
    rtc_lock.lock()
    defer rtc_lock.unlock()
    for b in s.rtcs do rtc.advance(b.model, max(b.model.time, board_time(cpu, cpu.retired)))

private[virt] i2c_read(cpu: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    val s = &machine.devices.i2c
    if s.stm32
        rtc_lock.lock()
        defer rtc_lock.unlock()
        return read_i2c_v2(cpu,address,offset,width,board_time(cpu,n))
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return 0
    rtc_lock.lock()
    defer rtc_lock.unlock()
    i2c.read(s.controller, offset) match
        Some(value) -> value
        None ->
            halt(cpu, Stop.Unmapped, address)
            0

private[virt] i2c_write(cpu: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    val s = &machine.devices.i2c
    if s.stm32
        rtc_lock.lock()
        defer rtc_lock.unlock()
        write_i2c_v2(cpu,address,offset,width,value,board_time(cpu,n))
        return
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return
    rtc_lock.lock()
    defer rtc_lock.unlock()
    if !i2c.write(&s.controller, offset, value, board_time(cpu, n)) then halt(cpu, Stop.Unmapped, address)

rtc_snapshot(name: string) -> Option[[7]u8]
    rtc_lock.lock()
    defer rtc_lock.unlock()
    for b in machine.devices.i2c.rtcs
        if b.name != name then continue
        var result: [7]u8 = [0; 7]
        for i in 0..<7 do result[i] = b.model.registers[i]
        return Some(result)
    None
