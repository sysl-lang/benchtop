module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.parts.ds3231 as rtc

@test("RTC host seed: local calendar is copied once and subsequent guest settings are independent of the host clock")
host_seed()
    val r = rtc.rtc()
    var ticks: long = 0
    var date: HostDateTime
    assert(host_now(&ticks) && host_calendar(ticks,&date,true))
    assert(seed_rtc_from_host(r).is_ok())
    assert(r.registers[6] == rtc.bcd(int(date.year % 100)))
    assert(r.registers[5] == rtc.bcd(int(date.month)) && r.registers[4] == rtc.bcd(int(date.day)))
    assert((r.registers[15] & 128) == 0)
    r.registers[0] = 0
    r.registers[1] = 0
    r.registers[2] = 0x03
    r.remainder = 0
    rtc.advance(r,12000000)
    assert(r.registers[2] == 3 && r.registers[0] == 1)
    r.remainder = 6000000
    rtc.rebase(r,0)
    rtc.advance(r,6000000)
    assert(r.registers[0] == 2, "an MCU reset does not reset the RTC's fractional second")
