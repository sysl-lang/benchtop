module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{mcu_clock_hz, Board, part_model, part_text, part_whole, pin_parts}
import sh.sysl.benchtop.peripheral.pwm as pwm
import sh.sysl.benchtop.audio as audio
import sh.sysl.benchtop.v6m.{Cpu, Stop, halt}
import sysl.buf.{Buf, buf}
import sysl.threads.Mutex
import sysl.math.{min, max}

struct BuzzerBinding
    name: string
    pin: int
    active: bool
    tone: u64
    synth: &audio.Synth
    level: bool
    driven: bool

/** The PWM channel (`virt-pwm`) and the buzzers on the board: whether the bus has the channel, its
 * clock and how many buzzers there are, which the board fixes; how many times the board has been
 * booted, which the host's audio starts over at each change of (the UI's thread alone boots and
 * reads it); and under `live` everything the cores and the host's audio change.
 */
struct PwmState
    present: bool
    hz: u64
    buzzer_count: usize
    epoch: u64
    live: Mutex[PwmLive]

/** The channel, each buzzer, and the clock their sound has been rendered to. */
struct PwmLive
    channel: pwm.Pwm
    buzzers: Buf[BuzzerBinding]
    time: u64

/** No PWM on the bus and no buzzer. */
pwm_state() -> PwmState = PwmState(false, 0, 0, 0, Mutex.new(PwmLive(pwm.pwm(), buf(), 0)))

/** How many times the board has been booted; the host's audio starts over each time it changes. */
sound_epoch() -> u64 = machine.devices.pwm.epoch

// The PWM and buzzers `b` makes, with the channel on the bus where `mapped` puts it there.
private[virt] check_pwm(b: Board, mapped: []const Mapped) -> Result[PwmState, string]
    var s = PwmLive(pwm.pwm(), buf(), 0)
    val present = mapped_irq(mapped, Pwm).0
    var hz: u64 = mcu_clock_hz(b.chip)
    var pin = 5
    for p in b.chip.peripherals
        if p.kind != "virt-pwm" then continue
        for q in p.params do q.value match
            Whole(n) -> if q.name == "clock-hz" then hz = u64(n)
            _ -> ()
        var found = false
        for route in p.signals
            if route.name != "out" then continue
            if route.pins.len() != 1 then return Err("virt-pwm needs exactly one output pin")
            pin_parts(route.pins.at(0).name) match
                Some((bank, number)) ->
                    if bank != "GP" || number < 0 || number >= 32 then return Err("virt-pwm output is GP0..GP31")
                    pin = number
                    found = true
                None -> ()
        if !found then return Err("virt-pwm needs signals { out = [GPn] }")
    s.channel = pwm.pwm(hz, pin)
    for p in b.parts
        if part_model(p) != "buzzer" then continue
        s.buzzers.push(BuzzerBinding(p.name, terminal_pin(p, "pin", b.chip.name), part_text(p, "kind", "passive") == "active",
            u64(part_whole(p, "tone", 4000)), audio.synth(hz, 48000, real(part_whole(p, "gain", 12)) / 100.0), false, false))
    Ok(PwmState(present, s.channel.hz, s.buzzers.len(), 0, Mutex.new(s)))

private[virt] boot_sound()
    val d = &machine.devices.pwm
    d.epoch += 1
    d.live.with(s ->
        pwm.reset(&s.channel)
        s.time = 0
        for i in 0..<s.buzzers.len()
            var b = s.buzzers.at(i)
            audio.clear(b.synth)
            b.driven = false
            b.level = false
            s.buzzers.set(i, b))

private waveform(s: *PwmLive, present: bool, b: BuzzerBinding) -> audio.Wave
    val channel = s.channel
    if present && channel.enabled && b.pin == channel.pin
        return audio.Wave(true, u64(channel.period), u64(channel.high), channel.origin, false)
    if b.active
        val period = channel.hz / b.tone
        return audio.Wave(b.driven && b.level, period, period / 2, 0, false)
    audio.Wave(b.driven, 0, 0, 0, b.level)

private render_sound(s: *PwmLive, present: bool, time: u64)
    val now = max(time, s.time)
    for b in s.buzzers do audio.advance(b.synth, now, waveform(s, present, b))
    s.time = now

/** Called only when a buzzer's own GPIO level/direction changed; display traffic is ignored. */
private[virt] sound_gpio(levels: u32, driven: u32, changed: u32, time: u64)
    val d = &machine.devices.pwm
    if d.buzzer_count == 0 then return
    val present = d.present
    d.live.with(s ->
        var relevant = false
        for b in s.buzzers do if (changed & (1u32 << u32(b.pin))) != 0 then relevant = true
        if relevant
            render_sound(s, present, time)
            for i in 0..<s.buzzers.len()
                var b = s.buzzers.at(i)
                val bit = 1u32 << u32(b.pin)
                b.level = (levels & bit) != 0
                b.driven = (driven & bit) != 0
                s.buzzers.set(i, b))

/** PWM supplies the selected pad independently of the GPIO output latch and OE register. */
pwm_pad(time: u64) -> (u32, u32)
    val d = &machine.devices.pwm
    if !d.present then return (0, 0)
    d.live.with(s ->
        val mask = 1u32 << u32(s.channel.pin)
        if !s.channel.enabled then (0, 0) else (mask, if pwm.level(s.channel, time) then mask else 0))

private[virt] pwm_read(cpu: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return 0
    machine.devices.pwm.live.with(s -> pwm.read(s.channel, offset, max(s.time, board_time(cpu, n)))) match
        Some(value) -> value
        None ->
            halt(cpu, Stop.Unmapped, address)
            0

private[virt] pwm_write(cpu: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return
    val present = machine.devices.pwm.present
    machine.devices.pwm.live.with(s ->
        val time = max(s.time, board_time(cpu, n))
        render_sound(s, present, time)
        if !pwm.write(&s.channel, offset, value, time) then halt(cpu, Stop.Unmapped, address))

sound_available() -> bool
    val d = &machine.devices
    d.pwm.buzzer_count != 0 || d.i2s.speaker || d.i2s.mic || d.codec.present || d.codec.mic
sound_clock_hz() -> u64 = if machine.devices.i2s.present then machine.devices.i2s.hz else machine.devices.pwm.hz

sound_active(name: string) -> bool
    val present = machine.devices.pwm.present
    machine.devices.pwm.live.with(s ->
        val channel = s.channel
        var active = false
        for b in s.buzzers do if b.name == name
            active = waveform(s, present, b).enabled && (if b.active then true else (channel.enabled && channel.high > 0 && channel.high < channel.period))
            break
        active)

sound_channels() -> int = if machine.devices.codec.headphones then 2 else 1

private mix_mono(mixed: *Buf[f32], samples: Buf[f32], channels: u32)
    while mixed.len() < samples.len() * usize(channels) do mixed.push(0.0)
    for i in 0..<samples.len()
        for channel in 0..<usize(channels)
            val at = i * usize(channels) + channel
            mixed.set(at,max(-1.0f32,min(1.0f32,mixed.at(at) + samples.at(i))))

take_sound(time: u64, channels: u32 = 1) -> Buf[f32]
    require channels == 1 || channels == 2, "mono or stereo output"
    val present = machine.devices.pwm.present
    var mixed: Buf[f32] = buf()
    val into = &mixed
    machine.devices.pwm.live.with(s ->
        render_sound(s, present, time)
        if machine.devices.i2s.present then mix_mono(into,take_digital_sound(time),channels)
        if machine.devices.codec.present
            val pcm = take_codec_sound(channels)
            while into.len() < pcm.len() do into.push(0.0)
            for i in 0..<pcm.len() do into.set(i,max(-1.0f32,min(1.0f32,into.at(i) + pcm.at(i))))
        for b in s.buzzers
            mix_mono(into,audio.take(b.synth),channels))
    mixed
