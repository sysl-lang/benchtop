module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.{load, library}
import sh.sysl.parsing.source_of
import sysl.raw.str_cast
import sysl.buf.buf

import sh.sysl.benchtop.v6m.{Stop, store32, load32, load16}

private val ADC_GUEST = embed("../../../../bench/guest/panel-ram.elf")

@test("pot ADC: mapped conversion latches the connected voltage and rejects invalid accesses")
adc_bus()
    assert(board_named("bench/guest/workbench-ram.hocon").is_ok())
    val cpu = core0()
    open_console()
    capture()
    boot(cpu, image_of(ADC_GUEST).unwrap().view())
    assert(analog_level(26) == 1650000)
    store32(cpu, 0x50000100, 3)
    set_analog_pin(26, 3300000)
    assert((load32(cpu, 0x50000108) & 1) != 0)
    cpu.retired = 32
    assert(load32(cpu, 0x5000010C) == 2048 && (load32(cpu, 0x50000108) & 2) != 0)
    store32(cpu, 0x50000100, 3)
    cpu.retired = 64
    assert(load32(cpu, 0x5000010C) == 4095)
    store32(cpu, 0x50000104, 31)
    store32(cpu, 0x50000100, 3)
    assert((load32(cpu, 0x50000108) & 4) != 0)
    load16(cpu, 0x50000100)
    assert(cpu.stop == Stop.Fault)
    cpu.stop = Stop.Budget
    load32(cpu, 0x50000124)
    assert(cpu.stop == Stop.Unmapped)

@test("pot ADC: conversion completion wakes WFI through the configured real IRQ handler")
adc_irq_guest()
    for parallel in [false, true]
        assert(board_named("bench/guest/workbench-ram.hocon").is_ok())
        val cpu = core0()
        open_console()
        capture()
        boot(cpu, image_of(ADC_GUEST).unwrap().view())
        cpu.pc = 0x100
        store32(cpu, 0x100, 0xE7FEBF30)
        store32(cpu, 0x4C, 0x201) // IRQ3 vector.
        store32(cpu, 0x200, 0xE7FEBE00)
        store32(cpu, 0xE000E100, 8)
        store32(cpu, 0x50000110, 1)
        store32(cpu, 0x50000100, 3)
        if parallel
            set_threads()
            run_board(cpu)
        else assert(!pump_board(cpu, 100))
        assert(cpu.stop == Stop.Breakpoint && cpu.ipsr == 19 && cpu.pc == 0x200)
        assert(load32(cpu, 0x5000010C) == 2048)

@test("pot ADC: an ADC-only chip can host a potentiometer without any GPIO peripheral")
adc_only()
    val got = load(source_of("adc-only.hocon", str_cast(embed("../../../../bench/guest/workbench-ram.hocon"))), library())
    assert(!got.report.has_errors())
    var b = got.description.board
    val volume = b.parts.at(5)
    b.parts = buf()
    b.parts.push(volume)
    val original = b.chip.peripherals
    b.chip.peripherals = buf()
    for p in original do if p.kind != "panel-gpio" then b.chip.peripherals.push(p)
    assert(assemble(b, library()).is_ok())
    val cpu = core0()
    open_console()
    capture()
    boot(cpu, image_of(ADC_GUEST).unwrap().view())
    store32(cpu, 0x50000100, 3)
    cpu.retired = 32
    assert(load32(cpu, 0x5000010C) == 2048)
    assert(pot_voltage(volume, -100) == 0 && pot_voltage(volume, 10100) == 3300000)
