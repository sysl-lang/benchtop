module sh.sysl.benchtop.virt
@tests

// What a terminal reading the console sees: the guest's output since a count it last saw, across a
// bounded capture and a reset; and keys sent without waiting or ending the input.

import sysl.buf.{Buf, buf}

private wrote(m: *Machine, s: string)
    for b in s.bytes do console_put(&m.console, b)

@test("console: output since a count is what the guest wrote after it, and the count is the total")
console_since()
    val board = machine()
    val m = &*board
    open_console(m)
    capture_bounded(m, 8192)
    wrote(m, "hello\nworld")
    val (all, n) = output_since(m, 0)
    assert(all.view() == "hello\nworld".bytes && n == 11)
    val (tail, _) = output_since(m, 6)
    assert(tail.view() == "world".bytes)
    val (none, same) = output_since(m, 11)
    assert(none.len() == 0 && same == 11)
    val (ahead, _) = output_since(m, 99)
    assert(ahead.len() == 0, "a count past the total is nothing new")

@test("console: past what a bounded capture kept, output since starts at the oldest byte kept")
console_since_bounded()
    val board = machine()
    val m = &*board
    open_console(m)
    capture_bounded(m, 128)
    for i in 0..<300 do console_put(&m.console, u8(48 + i % 10))
    val (kept, n) = output_since(m, 0)
    assert(n == 300 && kept.len() > 0 && kept.len() <= 128)
    assert(kept.view()[kept.len() - 1] == u8(48 + 299 % 10), "the newest byte is last")
    val (last, _) = output_since(m, 290)
    assert(last.view() == "0123456789".bytes)

@test("console: a reset starts the output again but not the count")
console_since_reset()
    val board = machine()
    val m = &*board
    open_console(m)
    capture(m)
    wrote(m, "before")
    open_console(m)
    capture(m)
    wrote(m, "after")
    assert(output(m).view() == "after".bytes, "the capture starts again, as before")
    val (fresh, n) = output_since(m, 6)
    assert(fresh.view() == "after".bytes && n == 11)

@test("console: keys are sent without ending the input, and refused once it has ended or is full")
console_type_keys()
    val board = machine()
    val m = &*board
    open_console(m)
    assert(type_keys(m, "ab".bytes))
    assert(console_take(&m.console) == Some(u8('a')))
    assert(console_take(&m.console) == Some(u8('b')))
    assert(console_take(&m.console) == None && !m.console.typed.is_closed())
    var many: Buf[u8] = buf()
    for i in 0..<5000 do many.push(u8('x'))
    assert(!type_keys(m, many.view()), "the input holds 4096 bytes")
    open_console(m)
    type_in(m, [])
    assert(!type_keys(m, "c".bytes))
    assert(type_keys(m, []), "nothing is nothing to refuse")
