module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{Cpu, Stop}
import sysl.threads.spawn

private const DSI_AT: u32 = 0x50000000
private const HAMMER: u32 = 200000

// One core's thread making register accesses to the DSI host as fast as it can: a write to a
// configuration register and a read of the version register, each a full access through the lock.
private hammer_dsi(c: *Cpu)
    for i in 0..<HAMMER
        dsi_write(c, DSI_AT + 4, 4, 4, i & 1, c.retired)
        assert(dsi_read(c, DSI_AT, 0, 4, c.retired) == 0x3133302a, "the version register reads back")

@test("DSI host: both cores' threads reaching its registers at once leave it whole")
dsi_two_threads()
    assert(board_named("stm32h747-disco").is_ok())
    boot(core0(), image_of(embed("../../../../examples/touch/disco.elf")).unwrap().view())
    val other = spawn(&hammer_dsi, core1(), 1 << 20).unwrap()
    hammer_dsi(core0())
    other.join()
    assert(core0().stop == Stop.Running && core1().stop == Stop.Running)
    assert(dsi_read(core0(), DSI_AT + 4, 4, 4, 0) <= 1)
    assert(dsi_read(core0(), DSI_AT, 0, 4, 0) == 0x3133302a)
