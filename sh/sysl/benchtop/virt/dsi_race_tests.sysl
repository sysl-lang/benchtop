module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{Cpu, Stop}
import sysl.threads.spawn

private const DSI_AT: u32 = 0x50000000
private const HAMMER: u32 = 200000

// One core's thread making register accesses to `m`'s DSI host as fast as it can: a write to a
// configuration register and a read of the version register, each a full access through the lock.
private hammer_dsi(m: *Machine, c: *Cpu)
    val s = &m.devices.dsi
    for i in 0..<HAMMER
        dsi_write(s, c, DSI_AT + 4, 4, 4, i & 1, c.retired)
        assert(dsi_read(s, c, DSI_AT, 0, 4, c.retired) == 0x3133302a, "the version register reads back")

private hammer_from_core1(m: *Machine) = hammer_dsi(m, core1(m))

@test("DSI host: both cores' threads reaching its registers at once leave it whole")
dsi_two_threads()
    val board = machine()
    val m = &*board
    val s = &m.devices.dsi
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m, image_of(m, embed("../../../../examples/touch/disco.elf")).unwrap().view())
    val other = spawn(&hammer_from_core1, m, 1 << 20).unwrap()
    hammer_dsi(m, core0(m))
    other.join()
    assert(core0(m).stop == Stop.Running && core1(m).stop == Stop.Running)
    assert(dsi_read(s, core0(m), DSI_AT + 4, 4, 4, 0) <= 1)
    assert(dsi_read(s, core0(m), DSI_AT, 0, 4, 0) == 0x3133302a)
