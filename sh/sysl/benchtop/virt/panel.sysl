module sh.sysl.benchtop.virt

// An explicitly virtual 32-pin GPIO block for interactive firmware prototypes. The pin
// levels are shared by the renderer, input controls and guest bus; no animated fake LEDs.
import sh.sysl.benchtop.{Board, Part, pin_parts, part_model}
import sh.sysl.benchtop.v6m.{Cpu, Stop, halt, raise, clock}
import sysl.sync.*
import sysl.threads.SleepLock

var panel_out: u32 = 0
var panel_oe: u32 = 0
var panel_in: u32 = 0xFFFFFFFF
var panel_edges: u32 = 0
var panel_mask: u32 = 0
var panel_irq: int = -1
var has_panel = false
var panel_lock = SleepLock.new()

private[virt] boot_panel()
    atomic_store(&panel_out, 0, Relaxed)
    atomic_store(&panel_oe, 0, Relaxed)
    atomic_store(&panel_in, 0xFFFFFFFF, Relaxed)
    atomic_store(&panel_edges, 0, Relaxed)
    atomic_store(&panel_mask, 0, Relaxed)
    reset_displays()

panel_levels() -> u32 = panel_levels_at(observe_core(0).time)

private[virt] panel_levels_at(time: u64) -> u32
    val oe = atomic_load(&panel_oe, Relaxed)
    val levels = (atomic_load(&panel_out, Relaxed) & oe) | (atomic_load(&panel_in, Relaxed) & ~oe)
    val (mask, output) = pwm_pad(time)
    val merged = (levels & ~mask) | output
    val (spi_mask, spi_output) = spi_pad()
    (merged & ~spi_mask) | spi_output

panel_drive_mask() -> u32 = panel_drive_mask_at(observe_core(0).time)

private[virt] panel_drive_mask_at(time: u64) -> u32 = atomic_load(&panel_oe, Relaxed) | pwm_pad(time).0 | spi_pad().0

panel_outputs() -> u32 = atomic_load(&panel_out, Relaxed) & atomic_load(&panel_oe, Relaxed)

/** Set all external input levels. Changes latch regardless of interrupt mask. */
panel_inputs(levels: u32)
    val old = atomic_load(&panel_in, Relaxed)
    atomic_store(&panel_in, levels, Relaxed)
    atomic_or(&panel_edges, old ^ levels, Relaxed)

private[virt] signal_panel(cpu: *Cpu)
    if has_panel && panel_irq >= 0 && (atomic_load(&panel_edges, Relaxed) & atomic_load(&panel_mask, Relaxed)) != 0 then raise(cpu, u32(panel_irq))

private[virt] panel_read(cpu: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return 0
    offset match
        0 -> atomic_load(&panel_out, Relaxed)
        4 ->
            panel_lock.lock()
            bring_spi(board_time(cpu,n))
            val levels = panel_levels_at(board_time(cpu,n))
            panel_lock.unlock()
            levels
        8 -> atomic_load(&panel_oe, Relaxed)
        12 -> atomic_load(&panel_edges, Relaxed)
        16 -> atomic_load(&panel_mask, Relaxed)
        20 -> atomic_load(&panel_edges, Relaxed) & atomic_load(&panel_mask, Relaxed)
        _ ->
            halt(cpu, Stop.Unmapped, address)
            0

private[virt] panel_write(cpu: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return
    panel_lock.lock()
    defer panel_lock.unlock()
    bring_spi(board_time(cpu,n))
    val old_levels = atomic_load(&panel_out, Relaxed)
    val old_driven = atomic_load(&panel_oe, Relaxed)
    val new_levels = if offset == 0 then value else old_levels
    val new_driven = if offset == 8 then value else old_driven
    sound_gpio(new_levels, new_driven, (old_levels ^ new_levels) | (old_driven ^ new_driven), board_time(cpu, n))
    offset match
        0 -> atomic_store(&panel_out, value, Relaxed)
        8 -> atomic_store(&panel_oe, value, Relaxed)
        12 -> atomic_and(&panel_edges, ~value, Relaxed)
        16 -> atomic_store(&panel_mask, value, Relaxed)
        4 | 20 -> () // Read-only registers.
        _ -> halt(cpu, Stop.Unmapped, address)
    observe_displays(panel_levels_at(board_time(cpu,n)), panel_drive_mask_at(board_time(cpu,n)), board_time(cpu,n))

/** A panel part's directly wired GP pin, or -1 for an unsupported connection. */
part_pin(p: Part, chip: string = "") -> int =
    terminal_pin(p, if p.kind == "led" then "anode" elif p.kind == "potentiometer" then "wiper" else "pin", chip)

/** Runnable external parts use the corresponding chip peripheral, independently. */
panel_parts(b: Board) -> bool
    var gpio = false
    var adc = false
    for p in b.chip.peripherals
        if p.kind == "panel-gpio" then gpio = true
        elif p.kind == "virt-adc" then adc = true
    for p in b.parts
        if part_model(p) == "headphones" || part_model(p) == "pdm-microphone" || part_model(p) == "wm8994" || part_model(p) == "ft6x06" || part_model(p) == "mipi-dcs-display" || part_model(p) == "gt911" || part_model(p) == "ds3231" || part_model(p) == "flash" || part_model(p) == "speaker" || part_model(p) == "i2s-amplifier" || part_model(p) == "i2s-microphone" then continue
        if part_model(p) == "led-matrix-5x5" || part_model(p) == "seven-segment" || part_model(p) == "hd44780" || part_model(p) == "ssd1306" || part_model(p) == "st7789"
            if !gpio then return false
            for wire in p.wires do if connection_pin(wire.to, b.chip.name) < 0 then return false
            continue
        if part_pin(p, b.chip.name) < 0 then return false
        if part_model(p) == "potentiometer"
            if !adc then return false
        elif part_model(p) == "led" || part_model(p) == "button" || part_model(p) == "buzzer"
            if !gpio then return false
        else return false
    true

/** Raw output latch, including pins currently configured as inputs. */
panel_output_latch() -> u32 = atomic_load(&panel_out, Relaxed)
