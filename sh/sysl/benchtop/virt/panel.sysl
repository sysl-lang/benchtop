module sh.sysl.benchtop.virt

// An explicitly virtual 32-pin GPIO block for interactive firmware prototypes. The pin
// levels are shared by the renderer, input controls and guest bus; no animated fake LEDs.
import sh.sysl.benchtop.{Board, Part, pin_parts, part_model}
import sh.sysl.benchtop.v6m.{Cpu, Stop, halt, raise, clock}
import sysl.sync.*

/** The panel GPIO (`panel-gpio`): its output latch, output enables, the levels the host drives on
 * its inputs, the edges latched since the guest cleared them, the edges that interrupt, and the IRQ
 * it raises (-1 for none). The registers are read and written atomically, by the guest and the host;
 * a guest's write is made under the SPI controller's lock, which keeps it in order with serial edges.
 */
struct PanelState
    out: u32
    oe: u32
    input: u32
    edges: u32
    mask: u32
    irq: int
    present: bool

/** No panel GPIO on the bus. */
panel_state() -> PanelState = PanelState(0, 0, 0xFFFFFFFF, 0, 0, -1, false)

// The panel GPIO a bus of `ds` has.
private[virt] panel_of(ds: []const Mapped) -> PanelState
    var s = panel_state()
    val (present, irq) = mapped_irq(ds, PanelGpio)
    s.present = present
    s.irq = irq
    s

// The panel is where the pins meet, so its functions are handed the machine's devices: the PWM and
// the SPI controller drive pads of its, and the displays watch its pins.

private[virt] boot_panel(ds: *Devices)
    val s = &ds.panel
    atomic_store(&s.out, 0, Relaxed)
    atomic_store(&s.oe, 0, Relaxed)
    atomic_store(&s.input, 0xFFFFFFFF, Relaxed)
    atomic_store(&s.edges, 0, Relaxed)
    atomic_store(&s.mask, 0, Relaxed)
    reset_displays(&ds.displays)

/** The levels on `m`'s panel pins, as core 0's clock last observed them. */
panel_levels(m: *Machine) -> u32 = panel_levels_at(&m.devices, observe_core(m, 0).time)

private[virt] panel_levels_at(ds: *Devices, time: u64) -> u32
    val s = &ds.panel
    val oe = atomic_load(&s.oe, Relaxed)
    val levels = (atomic_load(&s.out, Relaxed) & oe) | (atomic_load(&s.input, Relaxed) & ~oe)
    val (mask, output) = pwm_pad(&ds.pwm, time)
    val merged = (levels & ~mask) | output
    val (spi_mask, spi_output) = spi_pad(&ds.spi)
    (merged & ~spi_mask) | spi_output

/** Which of `m`'s panel pins something on the chip drives. */
panel_drive_mask(m: *Machine) -> u32 = panel_drive_mask_at(&m.devices, observe_core(m, 0).time)

private[virt] panel_drive_mask_at(ds: *Devices, time: u64) -> u32 = atomic_load(&ds.panel.oe, Relaxed) | pwm_pad(&ds.pwm, time).0 | spi_pad(&ds.spi).0

panel_outputs(m: *Machine) -> u32 = atomic_load(&m.devices.panel.out, Relaxed) & atomic_load(&m.devices.panel.oe, Relaxed)

/** Set all external input levels. Changes latch regardless of interrupt mask. */
panel_inputs(m: *Machine, levels: u32)
    val s = &m.devices.panel
    val old = atomic_load(&s.input, Relaxed)
    atomic_store(&s.input, levels, Relaxed)
    atomic_or(&s.edges, old ^ levels, Relaxed)

private[virt] signal_panel(s: *PanelState, cpu: *Cpu)
    if s.present && s.irq >= 0 && (atomic_load(&s.edges, Relaxed) & atomic_load(&s.mask, Relaxed)) != 0 then raise(cpu, u32(s.irq))

private[virt] panel_read(ds: *Devices, cpu: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return 0
    val s = &ds.panel
    offset match
        0 -> atomic_load(&s.out, Relaxed)
        4 -> ds.spi.serial.with(c ->
            bring_spi(&ds.spi,c,board_time(cpu,n))
            panel_levels_at(ds, board_time(cpu,n)))
        8 -> atomic_load(&s.oe, Relaxed)
        12 -> atomic_load(&s.edges, Relaxed)
        16 -> atomic_load(&s.mask, Relaxed)
        20 -> atomic_load(&s.edges, Relaxed) & atomic_load(&s.mask, Relaxed)
        _ ->
            halt(cpu, Stop.Unmapped, address)
            0

private[virt] panel_write(ds: *Devices, cpu: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return
    // The SPI controller's lock orders this write with the serial edges around it.
    ds.spi.serial.with(c ->
        val s = &ds.panel
        bring_spi(&ds.spi,c,board_time(cpu,n))
        val old_levels = atomic_load(&s.out, Relaxed)
        val old_driven = atomic_load(&s.oe, Relaxed)
        val new_levels = if offset == 0 then value else old_levels
        val new_driven = if offset == 8 then value else old_driven
        sound_gpio(&ds.pwm, new_levels, new_driven, (old_levels ^ new_levels) | (old_driven ^ new_driven), board_time(cpu, n))
        offset match
            0 -> atomic_store(&s.out, value, Relaxed)
            8 -> atomic_store(&s.oe, value, Relaxed)
            12 -> atomic_and(&s.edges, ~value, Relaxed)
            16 -> atomic_store(&s.mask, value, Relaxed)
            4 | 20 -> () // Read-only registers.
            _ -> halt(cpu, Stop.Unmapped, address)
        observe_displays(&ds.displays, panel_levels_at(ds, board_time(cpu,n)), panel_drive_mask_at(ds, board_time(cpu,n)), board_time(cpu,n)))

/** A panel part's directly wired GP pin, or -1 for an unsupported connection. */
part_pin(p: Part) -> int =
    terminal_pin(p, if p.kind == "led" then "anode" elif p.kind == "potentiometer" then "wiper" else "pin")

/** Runnable external parts use the corresponding chip peripheral, independently. */
panel_parts(b: Board) -> bool
    var gpio = false
    var adc = false
    for p in b.chip.peripherals
        if p.kind == "panel-gpio" then gpio = true
        elif p.kind == "virt-adc" then adc = true
    for p in b.parts
        if part_model(p) == "sd-card" || part_model(p) == "headphones" || part_model(p) == "pdm-microphone" || part_model(p) == "wm8994" || part_model(p) == "ft6x06" || part_model(p) == "mipi-dcs-display" || part_model(p) == "gt911" || part_model(p) == "ds3231" || part_model(p) == "flash" || part_model(p) == "speaker" || part_model(p) == "i2s-amplifier" || part_model(p) == "i2s-microphone" then continue
        if part_model(p) == "led-matrix-5x5" || part_model(p) == "seven-segment" || part_model(p) == "hd44780" || part_model(p) == "ssd1306" || part_model(p) == "st7789"
            if !gpio then return false
            for wire in p.wires do if connection_pin(wire.to) < 0 then return false
            continue
        if part_model(p) == "joystick"
            if !adc || terminal_pin(p,"x") < 0 || terminal_pin(p,"y") < 0 then return false
            continue
        if part_pin(p) < 0 then return false
        if part_model(p) == "potentiometer"
            if !adc then return false
        elif part_model(p) == "led" || part_model(p) == "button" || part_model(p) == "switch" || part_model(p) == "buzzer"
            if !gpio then return false
        else return false
    true

/** Raw output latch, including pins currently configured as inputs. */
panel_output_latch(m: *Machine) -> u32 = atomic_load(&m.devices.panel.out, Relaxed)
