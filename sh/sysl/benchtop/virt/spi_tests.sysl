module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf

@test("hardware SPI: original GPIO firmware remains buildable and produces identical button pixels")
gpio_firmware_preserved()
    var expected: u32 = 0
    var hardware = false
    for guest in [embed("../../../../examples/touch/gpio.elf"),embed("../../../../examples/touch/demo.elf")]
        assert(board_named("boards/touch.hocon").is_ok())
        boot(core0(),image_of(guest).unwrap().view())
        assert(pump_board(core0(),40000000))
        assert(machine.devices.spi.present)
        assert(machine.devices.spi.serial.with(c -> sh.sysl.benchtop.peripheral.spi.enabled(*c)) == hardware)
        touch_point("touch",120,60,true)
        assert(pump_board(core0(),8000000))
        touch_point("touch",120,60,false)
        assert(pump_board(core0(),8000000))
        val address = u32(elf.read(guest).unwrap().symbol_named("touch_count").unwrap().unwrap().value)
        assert(cpu.load32(core0(),address) == 1)
        val frame = tft_frame("screen").unwrap()
        var hash: u32 = 2166136261
        for i in 0..<frame.pixels.len() do hash = (hash ^ frame.pixels.at(i)) * 16777619
        if hardware then assert(hash == expected, "hardware and GPIO transports must show identical rounded pixels")
        else expected = hash
        hardware = true

@test("hardware SPI: MMIO routing, busy timing, byte width errors, loopback and disabled pin ownership")
spi_bus_registers()
    assert(board_named("boards/touch.hocon").is_ok())
    boot(core0(),image_of(embed("../../../../examples/touch/demo.elf")).unwrap().view())
    val at: u32 = 0x50001000
    assert(board_read(core0(),at + 12,4,0) == 3)
    board_write(core0(),at,4,7,0)
    board_write(core0(),at + 16,4,4,0)
    board_write(core0(),at + 4,4,3,0)
    assert((spi_pad().0 & 3) == 3)
    board_write(core0(),at + 8,2,0xA5,0)
    assert((board_read(core0(),at + 12,4,31) & 16) != 0)
    assert((board_read(core0(),at + 12,4,32) & 16) == 0)
    assert(board_read(core0(),at + 8,2,32) == 0xA5)
    board_write(core0(),at + 4,4,0,32)
    assert(spi_pad().0 == 0)
    board_write(core0(),at + 2,2,0,32)
    assert(core0().stop == cpu.Stop.Fault)
