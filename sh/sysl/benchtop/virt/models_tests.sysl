module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{Cpu, MODELS, Stop, model_named}
import sysl.raw.str_cast

val additional_guests: [8](string, []const u8, []const u8) = [
    ("virt0", embed("../../../../examples/virt/crunch-m0.elf"), embed("../../../../examples/virt/dual-m0.elf")),
    ("virt1", embed("../../../../examples/virt/crunch-m1.elf"), embed("../../../../examples/virt/dual-m1.elf")),
    ("virt3", embed("../../../../examples/virt/crunch-m3.elf"), embed("../../../../examples/virt/dual-m3.elf")),
    ("virt23", embed("../../../../examples/virt/crunch-m23.elf"), embed("../../../../examples/virt/dual-m23.elf")),
    ("virt35p", embed("../../../../examples/virt/crunch-m35p.elf"), embed("../../../../examples/virt/dual-m35p.elf")),
    ("virt52", embed("../../../../examples/virt/crunch-m52.elf"), embed("../../../../examples/virt/dual-m52.elf")),
    ("virt55", embed("../../../../examples/virt/crunch-m55.elf"), embed("../../../../examples/virt/dual-m55.elf")),
    ("virt85", embed("../../../../examples/virt/crunch-m85.elf"), embed("../../../../examples/virt/dual-m85.elf")),
]

@test("every new virtual core runs compiled arithmetic and dual-core firmware with either scheduler")
models_guests()
    val cpu = core0()
    for (board, crunch, dual) in additional_guests
        for parallel in [false, true]
            val stopped = run_on(cpu, board, crunch, parallel)
            assert(stopped.stop == Stop.Exit && stopped.exit_code == 0 && output() == crunch_host, s"$board: ${stop_message(stopped)} ${str_cast(output())}")
            val model = model_named(if board == "virt35p" then "cortex-m35p" else s"cortex-m${board[4..]}").unwrap()
            assert(cpu.kind == model.kind && core1().kind == model.kind, board)
            val other = run_on(cpu, board, dual, parallel)
            assert(other.stop == Stop.Exit && other.exit_code == 0, board)
            val got = lines(output())
            val want = lines(DUAL_OUTPUT.bytes)
            assert(got.len() == want.len() && got.at(0) == want.at(0), board)
            assert(got.at(got.len() - 1) == want.at(want.len() - 1), board)
            for k in 0..<2
                val mine = said_by(got.view(), k)
                val theirs = said_by(want.view(), k)
                assert(mine.len() == theirs.len(), board)
                for i in 0..<mine.len()
                    if theirs.at(i).starts_with("core 1: up")
                        assert(mine.at(i).starts_with("core 1: up, with stack top at "), board)
                    else
                        assert(mine.at(i) == theirs.at(i), s"$board: ${mine.at(i)}")
end models_guests

val additional_exclusives: [6](string, []const u8) = [
    ("virt3", embed("../../../../examples/virt/exclusive-m3.elf")),
    ("virt23", embed("../../../../examples/virt/exclusive-m23.elf")),
    ("virt35p", embed("../../../../examples/virt/exclusive-m35p.elf")),
    ("virt52", embed("../../../../examples/virt/exclusive-m52.elf")),
    ("virt55", embed("../../../../examples/virt/exclusive-m55.elf")),
    ("virt85", embed("../../../../examples/virt/exclusive-m85.elf")),
]

@test("new exclusive-capable cores preserve byte, halfword and word atomic counters on both schedulers")
models_exclusives()
    val cpu = core0()
    for (board, image) in additional_exclusives
        for parallel in [false, true]
            val stopped = run_on(cpu, board, image, parallel)
            assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, board)
            assert(output() == "word 40000, half 40000, byte 64\n".bytes, s"$board: ${str_cast(output())}")
end models_exclusives

val additional_isa: [5](string, []const u8) = [
    ("virt3", embed("../../../../examples/virt/isa-m3.elf")),
    ("virt35p", embed("../../../../examples/virt/isa-m35p.elf")),
    ("virt52", embed("../../../../examples/virt/isa-m52.elf")),
    ("virt55", embed("../../../../examples/virt/isa-m55.elf")),
    ("virt85", embed("../../../../examples/virt/isa-m85.elf")),
]

@test("all new Mainline models hash 96 shared instructions over edge operands and flags as QEMU does")
models_shared_isa()
    val cpu = core0()
    for (board, image) in additional_isa
        val stopped = run_on(cpu, board, image, false)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, board)
        val want = lines(isa_qemu)
        val got = lines(output())
        assert(got.len() == want.len(), board)
        for i in 0..<want.len() do assert(got.at(i) == want.at(i), s"$board: ${got.at(i)}, QEMU: ${want.at(i)}")
end models_shared_isa

val selects_v81 = embed("../../../../examples/virt/select-v81.elf")
val selects_qemu = embed("../../../../examples/virt/select.qemu")

@test("M52/M55/M85 conditional selects match QEMU's Cortex-M55 over 68 edge-value and flag hashes")
models_select_qemu()
    val cpu = core0()
    for board in ["virt52", "virt55", "virt85"]
        val stopped = run_on(cpu, board, selects_v81, false)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, board)
        val want = lines(selects_qemu)
        val got = lines(output())
        assert(got.len() == 68 && want.len() == 68, "full oracle, not an empty or truncated result")
        for i in 0..<want.len() do assert(got.at(i) == want.at(i), s"$board: ${got.at(i)}, QEMU: ${want.at(i)}")
end models_select_qemu

@test("runtime NVIC accepts architectural high IRQ routes and refuses out-of-range lines")
models_irq_limit()
    val text = "board { name = wide, mcu { name = wide, cores = [cortex-m55, cortex-m55], peripherals { ram { peripheral = ram, at = 0, size = 1M }, console { peripheral = debug-console, at = 0x40000000, irq = 479 } } } }"
    assert(board_from("wide.hocon",text.bytes).is_ok())
    assert(board_from("wide.hocon",sysl.text.replace_all(text,"irq = 479","irq = 480").bytes).is_err())
end models_irq_limit
