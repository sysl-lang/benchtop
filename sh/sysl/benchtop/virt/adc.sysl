module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, Part, Target, pin_parts, part_whole}
import sh.sysl.benchtop.peripheral.adc as adc
import sh.sysl.benchtop.v6m.{Cpu, Stop, IRQ0, NEVER, clock, could_wake, halt, raise, lower_limit}
import sysl.threads.SleepLock

var converter = adc.adc()
var has_adc = false
var adc_irq: int = -1
var analog_uv: [32]u32
var analog_driven: u32 = 0
var channel_pins: [32]int
var channel_count: u32 = 0
var adc_at: u64 = 0
var adc_lock = SleepLock.new()

/** Resolve a pin endpoint against the owning chip's name. Legacy bare pins remain accepted. */
connection_pin(t: Target, chip: string) -> int
    val name = t match
        Pin(n) -> n
        Port(owner, n) -> if owner == chip then n else ""
        _ -> ""
    pin_parts(name) match
        Some((bank, number)) -> if bank == "GP" && number >= 0 && number < 32 then number else -1
        None -> -1

terminal_pin(p: Part, terminal: string, chip: string) -> int
    for wire in p.wires do if wire.port == terminal then return connection_pin(wire.to, chip)
    -1

/** An ideal potentiometer: endpoints in microvolts, position in hundredths of a percent. */
pot_voltage(p: Part, position: int) -> u32
    val low = part_whole(p, "low-uv", 0)
    val high = part_whole(p, "high-uv", 3300000)
    val at = if position < 0 then 0 elif position > 10000 then 10000 else position
    u32(low + (high - low) * long(at) / 10000)

set_analog_pin(pin: int, uv: u32)
    require pin >= 0 && pin < 32, "analogue pin is GP0..GP31"
    adc_lock.lock()
    defer adc_lock.unlock()
    analog_uv[pin] = uv
    analog_driven |= 1u32 << u32(pin)

analog_level(pin: int) -> u32
    require pin >= 0 && pin < 32, "analogue pin is GP0..GP31"
    adc_lock.lock()
    defer adc_lock.unlock()
    analog_uv[pin]

private[virt] configure_adc(b: Board)
    adc_lock.lock()
    defer adc_lock.unlock()
    converter = adc.adc()
    analog_driven = 0
    analog_uv = [0; 32]
    channel_pins = [-1; 32]
    channel_count = 0
    for p in b.chip.peripherals
        if p.kind != "virt-adc" then continue
        var reference: u32 = 3300000
        var cycles: u64 = 32
        for q in p.params
            q.value match
                Whole(n) ->
                    if q.name == "reference-uv" then reference = u32(n)
                    elif q.name == "conversion-cycles" then cycles = u64(n)
                _ -> ()
        converter = adc.adc(reference, cycles)
        for ch in p.channels
            pin_parts(ch.name) match
                Some((bank, pin)) -> if bank == "GP" && pin >= 0 && pin < 32 && channel_count < 32
                    channel_pins[channel_count] = pin
                    channel_count += 1
                None -> ()
    for p in b.parts
        if p.kind != "potentiometer" then continue
        val pin = terminal_pin(p, "wiper", b.chip.name)
        if pin < 0 then continue
        analog_uv[pin] = pot_voltage(p, int(part_whole(p, "position", 50)) * 100)
        analog_driven |= 1u32 << u32(pin)

private[virt] boot_adc()
    adc.reset(&converter)
    adc_at = 0

private bring_adc(t: u64)
    if t > adc_at then adc_at = t
    adc.advance(&converter, adc_at)

private[virt] adc_due() -> u64
    adc_lock.lock()
    defer adc_lock.unlock()
    if has_adc && converter.busy then converter.due else NEVER

private[virt] adc_wake(cpu: *Cpu) -> u64
    if !has_adc || adc_irq < 0 || !could_wake(cpu, IRQ0 + u32(adc_irq)) then return NEVER
    adc_lock.lock()
    defer adc_lock.unlock()
    if converter.busy && (converter.mask & 1) != 0 then converter.due else NEVER

private[virt] signal_adc(cpu: *Cpu)
    if !has_adc then return
    adc_lock.lock()
    defer adc_lock.unlock()
    bring_adc(clock(cpu, cpu.retired))
    if adc_irq >= 0 && adc.irq(converter) then raise(cpu, u32(adc_irq))

private[virt] adc_read(cpu: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return 0
    adc_lock.lock()
    defer adc_lock.unlock()
    bring_adc(clock(cpu, n))
    adc.read(converter, offset) match
        Some(value) -> value
        None ->
            halt(cpu, Stop.Unmapped, address)
            0

private[virt] adc_write(cpu: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return
    adc_lock.lock()
    defer adc_lock.unlock()
    bring_adc(clock(cpu, n))
    val channel = converter.channel
    val pin = if channel < channel_count then channel_pins[channel] else -1
    val connected = pin >= 0 && (analog_driven & (1u32 << u32(pin))) != 0
    if !adc.write(&converter, offset, value, if connected then analog_uv[pin] else 0, connected, adc_at) then halt(cpu, Stop.Unmapped, address)
    if converter.busy then lower_limit(cpu, converter.due - cpu.slept)

/** Debug observation: no guest clock advancement, acknowledgement, or IRQ changes. */
peek_adc(offset: u32) -> Option[u32]
    adc_lock.lock()
    defer adc_lock.unlock()
    if !has_adc then return None
    adc.read(converter, offset)
