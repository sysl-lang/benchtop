module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, Part, Target, pin_parts, part_whole}
import sh.sysl.benchtop.peripheral.adc as adc
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.benchtop.v6m.{Cpu, Stop, IRQ0, could_wake, halt, raise, lower_limit}
import sysl.threads.Mutex

/** The ADC (`virt-adc`) and the analogue levels on the pins: whether the bus has it and the IRQ it
 * raises (-1 for none), which the board fixes, and under `live` everything that changes.
 */
struct AdcState
    present: bool
    irq: int
    live: Mutex[AdcLive]

/** The converter, each pin's level in microvolts and which pins something drives (the UI's thread
 * sets them), the pin of each of its `channel_count` channels, and the clock the converter has been
 * brought to.
 */
struct AdcLive
    converter: adc.Adc
    analog_uv: [32]u32
    analog_driven: u32
    channel_pins: [32]int
    channel_count: u32
    at: u64

private adc_live() -> AdcLive = AdcLive(adc.adc(), [0;32], 0, [-1;32], 0, 0)

/** No ADC on the bus, and nothing on the pins. */
adc_state() -> AdcState = AdcState(false, -1, Mutex.new(adc_live()))

/** The panel pin, GP0 to GP31, a wire goes to; -1 for anything else. A board's own pins are written
 * bare, so a pin is the only target that is one.
 */
connection_pin(t: Target) -> int = t match
    Pin(n) -> pin_parts(n) match
        Some((bank, number)) -> if bank == "GP" && number >= 0 && number < 32 then number else -1
        None -> -1
    _ -> -1

/** The panel pin `p`'s `terminal` is wired to, or -1. */
terminal_pin(p: Part, terminal: string) -> int
    for wire in p.wires do if wire.port == terminal then return connection_pin(wire.to)
    -1

/** An ideal potentiometer: endpoints in microvolts, position in hundredths of a percent. */
pot_voltage(p: Part, position: int) -> u32
    val low = part_whole(p, "low-uv", 0)
    val high = part_whole(p, "high-uv", 3300000)
    val at = if position < 0 then 0 elif position > 10000 then 10000 else position
    u32(low + (high - low) * long(at) / 10000)

/** Drive `m`'s panel pin `pin` to `uv` microvolts, as a part on it does. */
set_analog_pin(m: *Machine, pin: int, uv: u32)
    require pin >= 0 && pin < 32, "analogue pin is GP0..GP31"
    m.devices.adc.live.with(s ->
        s.analog_uv[pin] = uv
        s.analog_driven |= 1u32 << u32(pin))

/** The level on `m`'s panel pin `pin`, in microvolts. */
analog_level(m: *Machine, pin: int) -> u32
    require pin >= 0 && pin < 32, "analogue pin is GP0..GP31"
    m.devices.adc.live.with(s -> s.analog_uv[pin])

// The ADC a bus of `mapped` has, as `b` configures it, and the levels its parts put on the pins.
private[virt] check_adc(b: Board, mapped: []const Mapped) -> AdcState
    var s = adc_live()
    val (present, irq) = mapped_irq(mapped, Adc)
    for p in b.chip.peripherals
        if p.kind != "virt-adc" then continue
        var reference: u32 = 3300000
        var cycles: u64 = 32
        for q in p.params
            q.value match
                Whole(n) ->
                    if q.name == "reference-uv" then reference = u32(n)
                    elif q.name == "conversion-cycles" then cycles = u64(n)
                _ -> ()
        s.converter = adc.adc(reference, cycles)
        for ch in p.channels
            pin_parts(ch.name) match
                Some((bank, pin)) -> if bank == "GP" && pin >= 0 && pin < 32 && s.channel_count < 32
                    s.channel_pins[s.channel_count] = pin
                    s.channel_count += 1
                None -> ()
    for p in b.parts
        if p.kind == "joystick"
            for axis in ["x", "y"]
                val pin = terminal_pin(p, axis)
                if pin >= 0
                    s.analog_uv[pin] = pot_voltage(p, 5000)
                    s.analog_driven |= 1u32 << u32(pin)
        if p.kind != "potentiometer" then continue
        val pin = terminal_pin(p, "wiper")
        if pin < 0 then continue
        s.analog_uv[pin] = pot_voltage(p, int(part_whole(p, "position", 50)) * 100)
        s.analog_driven |= 1u32 << u32(pin)
    AdcState(present, irq, Mutex.new(s))

private[virt] boot_adc(d: *AdcState)
    d.live.with(s ->
        adc.reset(&s.converter)
        s.at = 0)

private bring_adc(s: *AdcLive, t: u64)
    if t > s.at then s.at = t
    adc.advance(&s.converter, s.at)

private[virt] adc_due(d: *AdcState) -> u64
    if !d.present then return NEVER
    d.live.with(s -> if s.converter.busy then s.converter.due else NEVER)

private[virt] adc_wake(d: *AdcState, cpu: *Cpu) -> u64
    if !d.present || d.irq < 0 || !could_wake(cpu, IRQ0 + u32(d.irq)) then return NEVER
    d.live.with(s -> if s.converter.busy && (s.converter.mask & 1) != 0 then s.converter.due else NEVER)

private[virt] signal_adc(d: *AdcState, cpu: *Cpu)
    if !d.present then return
    val irq = d.irq
    d.live.with(s ->
        bring_adc(s, board_time(cpu, cpu.retired))
        if irq >= 0 && adc.irq(s.converter) then raise(cpu, u32(irq)))

private[virt] adc_read(d: *AdcState, cpu: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return 0
    d.live.with(s ->
        bring_adc(s, board_time(cpu, n))
        adc.read(s.converter, offset)) match
        Some(value) -> value
        None ->
            halt(cpu, Stop.Unmapped, address)
            0

private[virt] adc_write(d: *AdcState, cpu: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return
    d.live.with(s ->
        bring_adc(s, board_time(cpu, n))
        val channel = s.converter.channel
        val pin = if channel < s.channel_count then s.channel_pins[channel] else -1
        val connected = pin >= 0 && (s.analog_driven & (1u32 << u32(pin))) != 0
        if !adc.write(&s.converter, offset, value, if connected then s.analog_uv[pin] else 0, connected, s.at) then halt(cpu, Stop.Unmapped, address)
        if s.converter.busy then lower_limit(cpu, retirement_limit(cpu,s.converter.due)))

/** The byte offset of the virtual ADC register called `name`. */
adc_register_offset(name: string) -> Option[u32] = adc.register_offset(name)

/** Debug observation: no guest clock advancement, acknowledgement, or IRQ changes. */
peek_adc(m: *Machine, offset: u32) -> Option[u32]
    val d = &m.devices.adc
    if !d.present then return None
    d.live.with(s -> adc.read(s.converter, offset))