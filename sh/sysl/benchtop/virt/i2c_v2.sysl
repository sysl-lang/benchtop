module sh.sysl.benchtop.virt

import sh.sysl.benchtop.peripheral.ContextModel
import sh.sysl.benchtop.v6m.{Cpu,Stop,halt}

// Polling STM32 I2C v2 register adapter. Reuses the existing byte-level I2C
// device catalog. Bus transfers complete functionally on data-register access;
// SCL timing, DMA, interrupts and slave mode are intentionally unsupported.
// Its registers are the I2C bus's (`I2cState.v2_regs`, `v2_status`, `v2_left`), reached under the
// bus's lock.

private[virt] boot_i2c_v2(s: *I2cState)
    s.v2_regs = [0;8]
    s.v2_status = 1
    s.v2_left = 0

// A command to the byte-level controller, which takes every one.
private bus_write(s: *I2cState, offset: u32, value: u32, time: u64) = s.controller.write(&s.parts,offset,4,value,time)

private i2c_v2_end(s: *I2cState, time: u64)
    s.v2_status &= ~6u32
    if s.v2_regs[1] & (1 << 24) != 0
        s.v2_status |= 1 << 7
    elif s.v2_regs[1] & (1 << 25) != 0
        bus_write(s,8,8,time)
        s.v2_status = (s.v2_status & ~(1u32 << 15)) | (1 << 5)
    else
        s.v2_status |= 1 << 6

private[virt] read_i2c_v2(s: *I2cState, c: *Cpu, address: u32, offset: u32, width: u32, time: u64) -> u32
    if (width != 4 && !(width == 1 && offset == 0x24)) || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return 0
    if offset < 0x18 then return s.v2_regs[offset / 4]
    if offset == 0x18 then return s.v2_status
    if offset == 0x24
        if s.v2_left == 0 || s.v2_status & 4 == 0 then return 0
        bus_write(s,8,2,time)
        val result = s.controller.read(4,4,time).unwrap()
        s.v2_left -= 1
        if s.v2_left == 0 then i2c_v2_end(s,time)
        return result
    halt(c,Stop.Unmapped,address)
    0

private[virt] write_i2c_v2(s: *I2cState, c: *Cpu, address: u32, offset: u32, width: u32, value: u32, time: u64)
    if (width != 4 && !(width == 1 && offset == 0x28)) || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return
    if offset == 0
        // PE only; requests for interrupt/DMA/slave/filter behavior are refused.
        if value & ~1u32 != 0
            halt(c,Stop.Fault,address)
            return
        s.v2_regs[0] = value
        if value & 1 == 0
            s.v2_status = 1
            s.v2_left = 0
            s.controller.reset()
        return
    if offset == 4
        if s.v2_regs[0] & 1 == 0 || value & ((1 << 11) | (1 << 12)) != 0
            halt(c,Stop.Fault,address)
            return
        s.v2_regs[1] = value & ~((1u32 << 13) | (1 << 14))
        if value & (1 << 14) != 0
            bus_write(s,8,8,time)
            s.v2_status = 1 | (1 << 5)
            s.v2_left = 0
            return
        if value & (1 << 13) != 0 || s.v2_status & (1 << 7) != 0
            val reading = value & (1 << 10) != 0
            if value & (1 << 13) != 0
                bus_write(s,0,(value >> 1) & 127,time)
                bus_write(s,8,if reading then 3 else 1,time)
            s.v2_left = (value >> 16) & 255
            s.v2_status = 1 | (1 << 15)
            if s.controller.selected < 0
                bus_write(s,8,8,time)
                s.v2_status = 1 | (1 << 4) | (1 << 5)
                s.v2_left = 0
            elif s.v2_left == 0 then i2c_v2_end(s,time)
            else s.v2_status |= if reading then 4 else 2
        return
    if offset == 0x1c
        s.v2_status &= ~(value & ((1 << 4) | (1 << 5)))
        return
    if offset == 0x28 && s.v2_left > 0 && s.v2_status & 2 != 0
        bus_write(s,4,value & 255,time)
        bus_write(s,8,4,time)
        s.v2_left -= 1
        if s.controller.status & 2 != 0
            s.v2_status |= 1 << 4
            s.v2_left = 0
        if s.v2_left == 0 then i2c_v2_end(s,time)
        return
    if offset == 0x10
        s.v2_regs[offset / 4] = value
        return
    halt(c,Stop.Unmapped,address)
