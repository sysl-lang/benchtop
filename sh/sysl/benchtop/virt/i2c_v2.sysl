module sh.sysl.benchtop.virt

import sh.sysl.benchtop.peripheral.i2c as bus
import sh.sysl.benchtop.v6m.{Cpu,Stop,halt}

// Polling STM32 I2C v2 register adapter. Reuses the existing byte-level I2C
// device catalog. Bus transfers complete functionally on data-register access;
// SCL timing, DMA, interrupts and slave mode are intentionally unsupported.
private var i2c_v2_regs: [8]u32 = [0;8]
private var i2c_v2_status: u32 = 1
private var i2c_v2_left: u32 = 0

private[virt] boot_i2c_v2()
    i2c_v2_regs = [0;8]
    i2c_v2_status = 1
    i2c_v2_left = 0

private i2c_v2_end(time: u64)
    i2c_v2_status &= ~6u32
    if i2c_v2_regs[1] & (1 << 24) != 0
        i2c_v2_status |= 1 << 7
    elif i2c_v2_regs[1] & (1 << 25) != 0
        bus.write(&i2c_controller,8,8,time)
        i2c_v2_status = (i2c_v2_status & ~(1u32 << 15)) | (1 << 5)
    else
        i2c_v2_status |= 1 << 6

private[virt] read_i2c_v2(c: *Cpu, address: u32, offset: u32, width: u32, time: u64) -> u32
    if (width != 4 && !(width == 1 && offset == 0x24)) || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return 0
    if offset < 0x18 then return i2c_v2_regs[offset / 4]
    if offset == 0x18 then return i2c_v2_status
    if offset == 0x24
        if i2c_v2_left == 0 || i2c_v2_status & 4 == 0 then return 0
        bus.write(&i2c_controller,8,2,time)
        val result = bus.read(i2c_controller,4).unwrap()
        i2c_v2_left -= 1
        if i2c_v2_left == 0 then i2c_v2_end(time)
        return result
    halt(c,Stop.Unmapped,address)
    0

private[virt] write_i2c_v2(c: *Cpu, address: u32, offset: u32, width: u32, value: u32, time: u64)
    if (width != 4 && !(width == 1 && offset == 0x28)) || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return
    if offset == 0
        // PE only; requests for interrupt/DMA/slave/filter behavior are refused.
        if value & ~1u32 != 0
            halt(c,Stop.Fault,address)
            return
        i2c_v2_regs[0] = value
        if value & 1 == 0
            boot_i2c_v2()
            bus.reset(&i2c_controller)
        return
    if offset == 4
        if i2c_v2_regs[0] & 1 == 0 || value & ((1 << 11) | (1 << 12)) != 0
            halt(c,Stop.Fault,address)
            return
        i2c_v2_regs[1] = value & ~((1u32 << 13) | (1 << 14))
        if value & (1 << 14) != 0
            bus.write(&i2c_controller,8,8,time)
            i2c_v2_status = 1 | (1 << 5)
            i2c_v2_left = 0
            return
        if value & (1 << 13) != 0 || i2c_v2_status & (1 << 7) != 0
            val reading = value & (1 << 10) != 0
            if value & (1 << 13) != 0
                bus.write(&i2c_controller,0,(value >> 1) & 127,time)
                bus.write(&i2c_controller,8,if reading then 3 else 1,time)
            i2c_v2_left = (value >> 16) & 255
            i2c_v2_status = 1 | (1 << 15)
            if i2c_controller.selected < 0
                bus.write(&i2c_controller,8,8,time)
                i2c_v2_status = 1 | (1 << 4) | (1 << 5)
                i2c_v2_left = 0
            elif i2c_v2_left == 0 then i2c_v2_end(time)
            else i2c_v2_status |= if reading then 4 else 2
        return
    if offset == 0x1c
        i2c_v2_status &= ~(value & ((1 << 4) | (1 << 5)))
        return
    if offset == 0x28 && i2c_v2_left > 0 && i2c_v2_status & 2 != 0
        bus.write(&i2c_controller,4,value & 255,time)
        bus.write(&i2c_controller,8,4,time)
        i2c_v2_left -= 1
        if i2c_controller.status & 2 != 0
            i2c_v2_status |= 1 << 4
            i2c_v2_left = 0
        if i2c_v2_left == 0 then i2c_v2_end(time)
        return
    if offset == 0x10
        i2c_v2_regs[offset / 4] = value
        return
    halt(c,Stop.Unmapped,address)
