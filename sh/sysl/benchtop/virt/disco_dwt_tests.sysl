module sh.sysl.benchtop.virt
@tests

// The DWT's cycle counter on the STM32H747I-DISCO's two cores, each its own (v6m/dwt.sysl).

import sh.sysl.benchtop.v6m as cpu

private val DWT_GUEST = embed("../../../../examples/touch/disco.elf")

private const DEMCR: u32 = 0xE000EDFC
private const DWT_CTRL: u32 = 0xE0001000
private const DWT_CYCCNT: u32 = 0xE0001004
private const DWT_LAR: u32 = 0xE0001FB0
private const DWT_LSR: u32 = 0xE0001FB4

@test("DISCO: the M7's CYCCNT counts the M7's own clock through rounds of real firmware, and the M4's is its own")
disco_dwt_per_core()
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m, image_of(m, DWT_GUEST).unwrap().view())
    val m7 = core0(m)
    val m4 = core1(m)
    assert(m7.kind == cpu.Kind.V7emM7 && m4.kind == cpu.Kind.V7em)
    assert(cpu.load32(m7, DWT_LSR) == 3 && cpu.load32(m4, DWT_LSR) == 0, "only the M7's DWT has the lock")

    cpu.store32(m7, DWT_LAR, 0xC5ACCE55)
    cpu.store32(m7, DEMCR, 0x01000000)
    cpu.store32(m7, DWT_CYCCNT, 0)
    cpu.store32(m7, DWT_CTRL, 1)
    val from = cpu.clock(m7, m7.retired)

    for r in 0..<20 do assert(round(m))

    val now = cpu.clock(m7, m7.retired)
    assert(now > from, "the M7 ran")
    assert(u64(cpu.load32(m7, DWT_CYCCNT)) == now - from, "the M7's CYCCNT is the M7's cycles since the enable")
    assert(cpu.load32(m4, DWT_CYCCNT) == 0 && cpu.load32(m4, DWT_CTRL) == 0x40000000 && cpu.load32(m4, DEMCR) == 0, "the M4's never started")
    assert(m7.stop == cpu.Stop.Running && m4.stop == cpu.Stop.Running)
