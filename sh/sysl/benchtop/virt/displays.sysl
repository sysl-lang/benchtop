module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, part_model, Part, part_whole, param_named}
import sh.sysl.benchtop.parts.seven_segment as seven
import sh.sysl.benchtop.parts.pins.{Line, floating}
import sh.sysl.benchtop.parts.spi as spi
import sysl.buf.{Buf, buf}
import sysl.threads.Mutex

/** A seven-segment display or LED matrix and the GPIO each of its terminals is wired to (-1 for none):
 * segment bit `i` (a..g, dp) or matrix column `i` at `segments[i]`, digit or row `i`'s common at
 * `commons[i]`.
 */
struct DisplayBinding
    name: string
    model: seven.Display
    segments: [8]int
    commons: [8]int

/** What a part's terminal wired to GPIO `pin` sees, from the GPIO's `levels` and the set of pins it
 * drives (`driven`): a terminal wired to nothing (`pin` -1) floats. This is where a part's terminals
 * meet the GPIO's pin numbers; the parts themselves see only their own `Line`s.
 */
line_at(pin: int, levels: u32, driven: u32) -> Line
    if pin < 0 || pin >= 32 then return floating()
    val bit = 1 << u32(pin)
    Line(driven & bit != 0, levels & bit != 0)

/** The GPIO each terminal of a four-wire SPI display port is wired to (-1 for none). */
struct PortPins
    cs: int
    sck: int
    mosi: int
    dc: int
    reset: int

// The port terminals `p` wires.
private[virt] port_pins(p: Part) -> PortPins =
    PortPins(terminal_pin(p, "cs"), terminal_pin(p, "sck"), terminal_pin(p, "mosi"), terminal_pin(p, "dc"), terminal_pin(p, "reset"))

// What a port wired to `pins` sees on the GPIO.
private[virt] port_wires(pins: PortPins, levels: u32, driven: u32) -> spi.Wires =
    spi.Wires(line_at(pins.cs, levels, driven), line_at(pins.sck, levels, driven), line_at(pins.mosi, levels, driven),
        line_at(pins.dc, levels, driven), line_at(pins.reset, levels, driven))

private lines(pins: [8]int, levels: u32, driven: u32) -> [8]Line
    var out: [8]Line = [floating(); 8]
    for i in 0..<8 do out[i] = line_at(pins[i], levels, driven)
    out

/** The displays on the board: whether it has any, which the board fixes, and the displays
 * themselves, which the cores drive and the host's renderer and the DSI worker read.
 */
struct Displays
    present: bool
    live: Mutex[DisplayState]

/** The displays on the board, each watching the pins it is wired to: seven-segment digits and LED
 * matrices, HD44780 LCDs (lcd.sysl), SSD1306 OLEDs (oled.sysl) and MIPI DCS panels (tft.sysl).
 */
struct DisplayState
    sevens: Buf[DisplayBinding]
    lcds: Buf[LcdBinding]
    oleds: Buf[OledBinding]
    tfts: Buf[TftBinding]

/** No display on the board. */
display_state() -> Displays = Displays(false, Mutex.new(DisplayState(buf(), buf(), buf(), buf())))

// The displays `b` wires to its chip.
private[virt] check_displays(b: Board) -> Displays
    var s = DisplayState(buf(), lcds_of(b), oleds_of(b), tfts_of(b))
    for p in b.parts
        if part_model(p) == "led-matrix-5x5"
            var columns: [8]int = [-1; 8]
            var rows: [8]int = [-1; 8]
            for i in 0..<5
                columns[i] = terminal_pin(p, s"col$i")
                rows[i] = terminal_pin(p, s"row$i")
            // Each row is a common anode; each column is an individual LED cathode.
            s.sevens.push(DisplayBinding(p.name, seven.display(5, true, u64(part_whole(p, "persistence-cycles", 50000))), columns, rows))
            continue
        if part_model(p) != "seven-segment" then continue
        var segments: [8]int = [-1; 8]
        var commons: [8]int = [-1; 8]
        val names = ["a", "b", "c", "d", "e", "f", "g", "dp"]
        for i in 0..<8
            segments[i] = terminal_pin(p, names[i])
            commons[i] = terminal_pin(p, s"digit$i")
        val anode = param_named(p.params, "common") match
            Some(q) -> q.value match
                Text(value) -> value == "anode"
                _ -> false
            None -> false
        val model = seven.display(int(part_whole(p, "digits", 1)), anode, u64(part_whole(p, "persistence-cycles", 50000)))
        s.sevens.push(DisplayBinding(p.name, model, segments, commons))
    val present = !s.sevens.is_empty() || !s.lcds.is_empty() || !s.oleds.is_empty() || !s.tfts.is_empty()
    Displays(present, Mutex.new(s))

private[virt] reset_displays(d: *Displays)
    d.live.with(s ->
        reset_lcds(s)
        reset_oleds(s)
        reset_tfts(s)
        for i in 0..<s.sevens.len()
            var binding = s.sevens.at(i)
            seven.reset(&binding.model)
            s.sevens.set(i, binding))

private[virt] observe_displays(d: *Displays, levels: u32, driven: u32, time: u64)
    if !d.present then return
    d.live.with(s ->
        observe_lcds(s, levels, driven, time)
        observe_oleds(s, levels, driven)
        observe_tfts(s, levels, driven)
        for i in 0..<s.sevens.len()
            var binding = s.sevens.at(i)
            seven.observe(&binding.model, lines(binding.segments, levels, driven), lines(binding.commons, levels, driven), time)
            s.sevens.set(i, binding))

/** The renderer reads only physical segment patterns derived from guest GPIO writes. */
display_segments(m: *Machine, name: string) -> [8]u8
    val now = observation_time(m)
    m.devices.displays.live.with(s ->
        var result: [8]u8 = [0; 8]
        for binding in s.sevens
            if binding.name != name then continue
            for i in 0..<binding.model.digits do result[i] = seven.read(binding.model, i, now)
        result)

/** Duty-cycle brightness for GPIO LED components; indices are row * 8 + column. */
display_brightness(m: *Machine, name: string) -> [64]u8
    val now = observation_time(m)
    m.devices.displays.live.with(s ->
        var result: [64]u8 = [0; 64]
        for binding in s.sevens
            if binding.name == name
                result = seven.brightness(binding.model, now)
                break
        result)
