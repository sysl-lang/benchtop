module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, part_model, Part, part_whole, param_named}
import sh.sysl.benchtop.parts.seven_segment as seven
import sh.sysl.benchtop.v6m.clock
import sysl.buf.{Buf, buf}
import sysl.threads.SleepLock

struct DisplayBinding
    name: string
    model: seven.Display

var display_bindings: Buf[DisplayBinding] = buf()
var display_lock = SleepLock.new()

private[virt] configure_displays(b: Board)
    display_bindings = buf()
    configure_lcds(b)
    configure_oleds(b)
    configure_tfts(b)
    for p in b.parts
        if part_model(p) != "seven-segment" then continue
        var segments: [8]int = [-1; 8]
        var commons: [8]int = [-1; 8]
        val names = ["a", "b", "c", "d", "e", "f", "g", "dp"]
        for i in 0..<8
            segments[i] = terminal_pin(p, names[i], b.chip.name)
            commons[i] = terminal_pin(p, s"digit$i", b.chip.name)
        val anode = param_named(p.params, "common") match
            Some(q) -> q.value match
                Text(value) -> value == "anode"
                _ -> false
            None -> false
        val model = seven.display(int(part_whole(p, "digits", 1)), anode, u64(part_whole(p, "persistence-cycles", 50000)), segments, commons)
        display_bindings.push(DisplayBinding(p.name, model))

private[virt] reset_displays()
    reset_lcds()
    reset_oleds()
    reset_tfts()
    for i in 0..<display_bindings.len()
        var binding = display_bindings.at(i)
        seven.reset(&binding.model)
        display_bindings.set(i, binding)

private[virt] observe_displays(levels: u32, driven: u32, time: u64)
    if display_bindings.is_empty() && lcd_bindings.is_empty() && oled_bindings.is_empty() && tft_bindings.is_empty() then return
    display_lock.lock()
    defer display_lock.unlock()
    observe_lcds(levels, driven, time)
    observe_oleds(levels, driven)
    observe_tfts(levels, driven)
    for i in 0..<display_bindings.len()
        var binding = display_bindings.at(i)
        seven.observe(&binding.model, levels, driven, time)
        display_bindings.set(i, binding)

/** The renderer reads only physical segment patterns derived from guest GPIO writes. */
display_segments(name: string) -> [8]u8
    var result: [8]u8 = [0; 8]
    display_lock.lock()
    defer display_lock.unlock()
    val first = clock(core0(), core0().retired)
    val second = clock(core1(), core1().retired)
    val now = if second > first then second else first
    for binding in display_bindings
        if binding.name != name then continue
        for i in 0..<binding.model.digits do result[i] = seven.read(binding.model, i, now)
    result
