module sh.sysl.benchtop.virt
@tests

// The board's two cores: the SIO as each core sees it, the boot ROM's launch sequence, the turns the
// cores take and exactly where one sees the other's writes, sleeping, stopping, and dual.c's whole
// conversation. The SIO's registers are reached from the host through a core, which is an access
// made by that core.

import sh.sysl.benchtop.v6m.{Cpu, Stop, NVIC_ICPR, NVIC_ISER, SYST_CSR, SYST_RVR, clock, load32, store16, store32}
import sysl.buf.{Buf, buf}

val dual = embed("../../../../examples/virt/dual.elf")

const IRQ1_PENDING: u64 = 1 << 17

// The SIO's registers where boards/virt.hocon puts it.
const SIO: u32 = 0xD0000000
const SIO_CPUID = SIO + CPUID
const SIO_FIFO_ST = SIO + FIFO_ST
const SIO_FIFO_WR = SIO + FIFO_WR
const SIO_FIFO_RD = SIO + FIFO_RD
const SIO_SPINLOCK_ST = SIO + SPINLOCK_ST
const SIO_SPINLOCK0 = SIO + SPINLOCK0
const SIO_SPINLOCK31 = SIO + SPINLOCK31

// An image of 16 KB: the vector table's SP and reset (core 0's code, at 0x100), and `parts`, each a
// run of halfwords at its address.
image(parts: [](u32, []const u16)) -> Buf[u8]
    var b: Buf[u8] = buf()

    for i in 0..<0x4000 do b.push(0)
    put32(&b, 0, 0x8000)
    put32(&b, 4, 0x101)

    for p in parts
        for i in 0..<p.1.len do put16(&b, p.0 + u32(i) * 2, p.1[i])

    b

put16(b: *Buf[u8], a: u32, x: u32)
    b.set(usize(a), u8(x & 0xFF))
    b.set(usize(a) + 1, u8(x >> 8))

put32(b: *Buf[u8], a: u32, x: u32)
    put16(b, a, x & 0xFFFF)
    put16(b, a + 2, x >> 16)

// `img` booted with nothing to type, its output captured.
started(cpu: *Cpu, img: []const u8)
    on_virt()
    open_console()
    capture()
    type_in([])
    boot(cpu, img)

// A board whose two cores both run `wfi; b wfi` with PRIMASK set, so a pending IRQ wakes a core and
// stays pending: core 0 at 0x100, core 1 at 0x200, launched before the first round.
asleep_pair(cpu: *Cpu)
    val sleep: [3]u16 = [0xB672, 0xBF30, 0xE7FD]

    started(cpu, image([(0x100, sleep[..]), (0x200, sleep[..])]).view())
    launch(0, 0x7000, 0x201)

    // Masked from the start, so an IRQ raised before the CPSID is not taken either.
    cpu.primask = 1
    core1().primask = 1

@test("CPUID answers 0 to core 0 and 1 to core 1")
dual_cpuid()
    var cpu: Cpu

    asleep_pair(&cpu)
    assert(load32(&cpu, SIO_CPUID) == 0)
    assert(load32(core1(), SIO_CPUID) == 1)

    // Written, it keeps its answer.
    store32(core1(), SIO_CPUID, 7)
    assert(load32(core1(), SIO_CPUID) == 1 && core1().stop == Stop.Budget)

@test("a spinlock is claimed by the first read, refused to the other core until released, and shown in SPINLOCK_ST")
dual_spinlocks()
    var cpu: Cpu

    asleep_pair(&cpu)
    assert(load32(&cpu, SIO_SPINLOCK_ST) == 0)

    // Core 0 claims lock 0 and lock 31; the answer is the lock's bit.
    assert(load32(&cpu, SIO_SPINLOCK0) == 1)
    assert(load32(&cpu, SIO_SPINLOCK31) == 0x80000000)
    assert(load32(&cpu, SIO_SPINLOCK_ST) == 0x80000001)

    // Core 1 is refused lock 0, and core 0 itself on a second claim.
    assert(load32(core1(), SIO_SPINLOCK0) == 0)
    assert(load32(&cpu, SIO_SPINLOCK0) == 0)

    // Core 1 claims lock 5, free.
    assert(load32(core1(), SIO_SPINLOCK0 + 20) == 32)
    assert(load32(core1(), SIO_SPINLOCK_ST) == 0x80000021)

    // Any write releases, from either core; then core 1's claim of lock 0 succeeds.
    store32(&cpu, SIO_SPINLOCK0, 0)
    assert(load32(&cpu, SIO_SPINLOCK_ST) == 0x80000020)
    assert(load32(core1(), SIO_SPINLOCK0) == 1)
    assert(load32(&cpu, SIO_SPINLOCK0) == 0)
    store32(core1(), SIO_SPINLOCK31, 1)
    assert(load32(&cpu, SIO_SPINLOCK_ST) == 0x21)

    // A boot clears every lock.
    asleep_pair(&cpu)
    assert(load32(&cpu, SIO_SPINLOCK_ST) == 0)

@test("the FIFO keeps order, holds 8 words, reports VLD, RDY, WOF and ROE, and a write of the bit clears an error")
dual_fifo()
    var cpu: Cpu

    asleep_pair(&cpu)
    assert(load32(&cpu, SIO_FIFO_ST) == RDY)
    assert(load32(core1(), SIO_FIFO_ST) == RDY)

    for x in 1..8 do store32(&cpu, SIO_FIFO_WR, u32(x) * 11)

    // Full one way: core 0 has no room, core 1 has a word; the other way is untouched.
    assert(load32(&cpu, SIO_FIFO_ST) == 0)
    assert(load32(core1(), SIO_FIFO_ST) == VLD | RDY)

    // A ninth word is lost, and core 0's WOF says so.
    store32(&cpu, SIO_FIFO_WR, 99)
    assert(load32(&cpu, SIO_FIFO_ST) == WOF)

    for x in 1..8 do assert(load32(core1(), SIO_FIFO_RD) == u32(x) * 11, s"word $x")

    assert(load32(core1(), SIO_FIFO_ST) == RDY)
    assert(load32(&cpu, SIO_FIFO_ST) == WOF | RDY)

    // Reading empty answers 0 and sets ROE.
    assert(load32(core1(), SIO_FIFO_RD) == 0)
    assert(load32(core1(), SIO_FIFO_ST) == ROE | RDY)

    // Writing ROE clears it and nothing else; writing WOF clears WOF.
    store32(core1(), SIO_FIFO_ST, ROE)
    assert(load32(core1(), SIO_FIFO_ST) == RDY)
    store32(&cpu, SIO_FIFO_ST, ROE)
    assert(load32(&cpu, SIO_FIFO_ST) == WOF | RDY)
    store32(&cpu, SIO_FIFO_ST, WOF)
    assert(load32(&cpu, SIO_FIFO_ST) == RDY)

    // The other way round, independently.
    store32(core1(), SIO_FIFO_WR, 5)
    store32(core1(), SIO_FIFO_WR, 6)
    assert(load32(&cpu, SIO_FIFO_ST) == VLD | RDY && load32(core1(), SIO_FIFO_ST) == RDY)
    assert(load32(&cpu, SIO_FIFO_RD) == 5 && load32(&cpu, SIO_FIFO_RD) == 6)

@test("the FIFO's IRQ 1 is raised in the reading core's NVIC only, and wakes that core's WFI")
dual_fifo_irq()
    var cpu: Cpu

    asleep_pair(&cpu)
    store32(&cpu, NVIC_ISER, 2)
    store32(core1(), NVIC_ISER, 2)

    // The round core 1 starts in; then a word for core 1. Core 1 is interrupted, and with the IRQ
    // pending wakes from every WFI; core 0 is not, and sleeps.
    assert(round(&cpu))
    store32(&cpu, SIO_FIFO_WR, 1)
    assert(round(&cpu))
    assert(core1().pending & IRQ1_PENDING != 0, "core 1 interrupted")
    assert(cpu.pending & IRQ1_PENDING == 0, "core 0 not")
    assert(core1().retired > 100 && cpu.sleeping && cpu.retired == 2, s"${core1().retired} ${cpu.retired}")

    // Drained, and the pending bit cleared: a word the other way interrupts core 0 alone.
    assert(load32(core1(), SIO_FIFO_RD) == 1)
    store32(core1(), NVIC_ICPR, 2)
    store32(core1(), SIO_FIFO_WR, 2)
    assert(round(&cpu))
    assert(cpu.pending & IRQ1_PENDING != 0 && core1().pending & IRQ1_PENDING == 0)
    assert(cpu.retired > 100)

    // An error raises it too: core 1 reading empty sets its ROE.
    assert(load32(&cpu, SIO_FIFO_RD) == 2)
    store32(&cpu, NVIC_ICPR, 2)
    assert(load32(core1(), SIO_FIFO_RD) == 0)
    assert(round(&cpu))
    assert(core1().pending & IRQ1_PENDING != 0 && cpu.pending & IRQ1_PENDING == 0)

    // A core that has not enabled IRQ 1 is not woken by it: with a word for core 1 and its IRQ 1
    // disabled, both sleep with nothing to wake them, and the board stops.
    store32(core1(), SIO_FIFO_ST, ROE)
    store32(core1(), NVIC_ICPR, 2)
    store32(core1(), 0xE000E180, 2)
    store32(&cpu, SIO_FIFO_WR, 3)
    assert(!round(&cpu))
    assert(core1().stop == Stop.Asleep && cpu.stop == Stop.Asleep)
    assert(core1().pending & IRQ1_PENDING != 0, "raised, but not enabled")

// Core 0 pushes `words`, as `launch_core1` does, and answers every echo the boot ROM sent back.
sequence(cpu: *Cpu, words: []const u32) -> Buf[u32]
    var echoes: Buf[u32] = buf()

    for w in words
        store32(cpu, SIO_FIFO_WR, w)

        while load32(cpu, SIO_FIFO_ST) & VLD != 0 do echoes.push(load32(cpu, SIO_FIFO_RD))

    echoes

@test("the boot ROM echoes the launch sequence and starts core 1 at ENTRY with SP and VTOR as sent")
dual_launch()
    var cpu: Cpu
    val words: [6]u32 = [0, 0, 1, 0x1000, 0x7000, 0x201]

    started(&cpu, image([]).view())
    assert(load32(&cpu, SIO_FIFO_ST) == RDY, "core 1's ROM always has room")

    // A wrong word restarts the sequence, and every word is echoed all the same.
    val wrong: [3]u32 = [0, 0, 2]

    assert(sequence(&cpu, wrong[..]).view() == wrong[..])
    assert(!running_both())

    val echoes = sequence(&cpu, words[..])

    assert(echoes.view() == words[..])
    assert(running_both())
    assert(core1().pc == 0x200 && core1().r[13] == 0x7000 && core1().vtor == 0x1000)
    assert(core1().stop == Stop.Budget && load32(core1(), SIO_CPUID) == 1)

@test("before the sequence ends core 1 has not started, and VTOR, SP and ENTRY may each be 0")
dual_launch_partial()
    var cpu: Cpu

    started(&cpu, image([]).view())

    // Zeros at the start keep the last two; a 1 then begins the addresses.
    val start: [5]u32 = [0, 0, 0, 0, 1]

    assert(sequence(&cpu, start[..]).len() == 5 && !running_both())

    val rest: [2]u32 = [0, 0]

    assert(sequence(&cpu, rest[..]).len() == 2 && !running_both())

    // ENTRY 0 has no Thumb bit: core 1 stops at Fault there, and the board ends on core 1.
    val entry: [1]u32 = [0]

    assert(sequence(&cpu, entry[..]).len() == 1 && running_both())
    assert(core1().stop == Stop.Fault && core1().stop_at == 0 && core1().pc == 0)
    assert(core1().r[13] == 0 && core1().vtor == 0)

    val stopped = run_board(&cpu)

    assert(stopped == core1() && cpu.stop == Stop.Budget)
    assert(stop_message(stopped) == "the guest stopped at a fault it cannot take, at 0x00000000 (core 1, pc 0x00000000, 0 instructions)", stop_message(stopped))

@test("a second launch sequence, once core 1 runs, is only data in core 1's FIFO")
dual_launch_twice()
    var cpu: Cpu
    val words: [6]u32 = [0, 0, 1, 0, 0x7000, 0x201]

    started(&cpu, image([]).view())
    assert(sequence(&cpu, words[..]).len() == 6 && running_both())

    val again: [6]u32 = [0, 0, 1, 0, 0x6000, 0x301]

    assert(sequence(&cpu, again[..]).len() == 0, "no echo")
    assert(core1().pc == 0x200 && core1().r[13] == 0x7000)

    for w in again do assert(load32(core1(), SIO_FIFO_RD) == w)

@test("SysTick and the NVIC are each core's own")
dual_own_exceptions()
    var cpu: Cpu

    asleep_pair(&cpu)
    store32(&cpu, NVIC_ISER, 5)
    store32(&cpu, SYST_RVR, 99)
    store32(&cpu, SYST_CSR, 7)
    assert(load32(&cpu, NVIC_ISER) == 5 && load32(&cpu, SYST_CSR) & 3 == 3)
    assert(load32(core1(), NVIC_ISER) == 0 && load32(core1(), SYST_RVR) == 0 && load32(core1(), SYST_CSR) & 3 == 0)

    store32(core1(), SYST_RVR, 49)
    assert(load32(&cpu, SYST_RVR) == 99 && load32(core1(), SYST_RVR) == 49)

    // Core 0's SysTick wakes core 0, and stays pending under PRIMASK; core 1 sleeps through every
    // round.
    for r in 0..<5 do assert(round(&cpu))

    assert(cpu.pending & (1 << 15) != 0 && core1().pending & (1 << 15) == 0)
    assert(cpu.retired > 3 && core1().retired == 2, s"${cpu.retired} ${core1().retired}")

// Core 1 at 0x200: count r0 to 200, then write it to EXIT.
// 0x200: movs r0, #0     0x202: adds r0, #1     0x204: cmp r0, #200    0x206: bne 0x202
// 0x208: ldr r1, [pc, #4]   0x20A: str r0, [r1]   0x20C: b .   0x210: EXIT
val COUNTER: [10]u16 = [0x2000, 0x3001, 0x28C8, 0xD1FC, 0x4901, 0x6008, 0xE7FE, 0, 0x0008, 0x4000]

// 0x100: wfi    0x102: b 0x100
val SLEEPER: [2]u16 = [0xBF30, 0xE7FD]

@test("core 0 asleep for good while core 1 runs keeps the board going, and core 1's EXIT ends it")
dual_one_asleep()
    var cpu: Cpu

    started(&cpu, image([(0x100, SLEEPER[..]), (0x200, COUNTER[..])]).view())
    launch(0, 0x7000, 0x201)

    // Six rounds, core 0 asleep at the end of every one. Core 1's turn in the sixth ends past 600:
    // its loop ends at 601, and the code after it has no taken branch before the EXIT.
    set_quantum(100)

    val stopped = run_board(&cpu)

    assert(stopped == core1())
    assert(stopped.stop == Stop.Exit && stopped.exit_code == 200 && stopped.stop_at == CONSOLE + EXIT)
    assert(cpu.stop == Stop.Budget && cpu.sleeping && cpu.retired == 1)
    assert(clock(&cpu, cpu.retired) == 600, s"core 0's clock ${clock(&cpu, cpu.retired)}")
    // movs, 200 times adds, cmp and bne, and ldr: the str stops on its access, not retired.
    assert(stopped.retired == 602, s"${stopped.retired}")

@test("both cores asleep with nothing to wake them stops the board at Asleep, on core 0")
dual_both_asleep()
    var cpu: Cpu

    started(&cpu, image([(0x100, SLEEPER[..]), (0x200, SLEEPER[..])]).view())
    launch(0, 0x7000, 0x201)

    val stopped = run_board(&cpu)

    assert(stopped == &cpu)
    assert(cpu.stop == Stop.Asleep && cpu.stop_at == 0x102 && cpu.retired == 1)
    assert(core1().stop == Stop.Asleep && core1().stop_at == 0x202 && core1().retired == 1)

@test("both asleep, the board skips to the first SysTick that wakes one")
dual_both_asleep_systick()
    var cpu: Cpu

    started(&cpu, image([(0x100, SLEEPER[..]), (0x200, SLEEPER[..])]).view())
    launch(0, 0x7000, 0x201)

    // Core 1's SysTick fires 50000 clocks on, with no handler: the vector is 0, a fault.
    store32(core1(), SYST_RVR, 49999)
    store32(core1(), SYST_CSR, 7)

    val stopped = run_board(&cpu)

    assert(stopped == core1() && stopped.stop == Stop.Fault && stopped.stop_at == 0x3C)
    assert(clock(stopped, stopped.retired) == 50000, s"${clock(stopped, stopped.retired)}")

// Core 0 at 0x100 writes 0, 1, 2… to 0x2000, three instructions an iteration; core 1 at 0x200 logs
// what it reads there to 0x3000 on, four an iteration.
// core 0: movs r0, #0x20; lsls r0, r0, #8; movs r1, #0; str r1, [r0]; adds r1, #1; b str
// core 1: movs r0, #0x20; lsls r0, r0, #8; movs r3, #0x30; lsls r3, r3, #8;
//         ldr r2, [r0]; str r2, [r3]; adds r3, #4; b ldr
val WRITER: [6]u16 = [0x2020, 0x0200, 0x2100, 0x6001, 0x3101, 0xE7FC]
val READER: [8]u16 = [0x2020, 0x0200, 0x2330, 0x021B, 0x6802, 0x601A, 0x3304, 0xE7FB]

@test("a word core 0 writes is seen by core 1 only after core 0's turn ends, exactly")
dual_quantum_boundary()
    var cpu: Cpu

    started(&cpu, image([(0x100, WRITER[..]), (0x200, READER[..])]).view())
    launch(0, 0x7000, 0x201)
    set_quantum(12)

    // The round core 1 starts in, then three of 12 clocks each.
    for r in 0..<4 do assert(round(&cpu))

    // Core 0 ends its turns having stored 2, 6 and 10; core 1 never sees 3, 4, 5, 7, 8 or 9.
    val want: [9]u32 = [2, 2, 6, 6, 6, 10, 10, 10, 0]

    for i in 0..<9 do assert(load32(&cpu, 0x3000 + u32(i) * 4) == want[i], s"log[$i] = ${load32(&cpu, 0x3000 + u32(i) * 4)}")

    assert(cpu.retired == 36 && core1().retired == 36)
    assert(cpu.pc == 0x106 && core1().pc == 0x208)

@test("code core 0 writes over code core 1 has run is decoded afresh when core 1 next runs it")
dual_shared_code()
    var cpu: Cpu
    // core 1: movs r2, #1; b .-2
    val looping: [2]u16 = [0x2201, 0xE7FD]

    started(&cpu, image([(0x100, SLEEPER[..]), (0x200, looping[..])]).view())
    launch(0, 0x7000, 0x201)

    for r in 0..<3 do assert(round(&cpu))
    assert(core1().r[2] == 1)

    // movs r2, #2, written by core 0.
    store16(&cpu, 0x200, 0x2202)
    assert(round(&cpu))
    assert(core1().r[2] == 2)

const DUAL_OUTPUT = """
    core 0: launching core 1
    core 1: up, with stack top at 2392
    core 1: squaring 1
    core 0: got back 1
    core 1: squaring 2
    core 0: got back 4
    core 1: squaring 3
    core 0: got back 9
    core 1: squaring 4
    core 0: got back 16
    core 0: line 1
    core 1: line 1
    core 0: line 2
    core 1: line 2
    core 1: line 3
    core 0: line 3
    core 0: core 1 finished; total 30
    """

@test("dual.elf launches core 1, trades squares through the FIFO, shares the console by a spinlock, and exits 0")
dual_example()
    var cpu: Cpu

    on_virt()
    open_console()
    capture()
    type_in([])

    image_of(dual) match
        Ok(img) -> boot(&cpu, img.view())
        Err(why) -> assert(false, why)

    val stopped = run_board(&cpu)

    assert(output() == DUAL_OUTPUT.bytes, str_cast(output()))
    assert(stopped == &cpu && cpu.stop == Stop.Exit && cpu.exit_code == 0)
    assert(core1().stop == Stop.Budget && core1().sleeping)

@test("dual.elf run twice gives the same output, and the same counts and pc on both cores")
dual_deterministic()
    var cpu: Cpu
    var seen: [2][4]u64

    for run in 0..<2
        on_virt()
        open_console()
        capture()
        type_in([])

        image_of(dual) match
            Ok(img) -> boot(&cpu, img.view())
            Err(why) -> assert(false, why)

        run_board(&cpu)
        assert(output() == DUAL_OUTPUT.bytes)
        seen[run] = [cpu.retired, u64(cpu.pc), core1().retired, u64(core1().pc)]

    assert(seen[0] == seen[1], s"${seen[0][0]} ${seen[1][0]} ${seen[0][2]} ${seen[1][2]}")
    assert(seen[0][2] > 0)
