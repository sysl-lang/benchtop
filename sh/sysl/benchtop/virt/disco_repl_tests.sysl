module sh.sysl.benchtop.virt
@tests

// The Forth in `examples/disco-repl` on the STM32H747I-DISCO: it brings USART1 up on PA9 and PA10, waits
// for typed characters in WFI with the receive interrupt on, and interprets each line. What is typed
// goes in through the console and what the firmware sends comes back out of it.

import sh.sysl.benchtop.v6m.Stop
import sysl.raw.str_cast

private val REPL = embed("../../../../examples/disco-repl/repl-disco.elf")

// The firmware booted on the DISCO with `keys` typed, run until it stops. Answers the machine.
private typed(keys: string) -> &Machine
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    open_console(m)
    capture(m)
    type_in(m, keys.bytes)
    boot(m, image_of(m, REPL).unwrap().view())
    run_board(m)
    board

private said(m: *Machine) -> string = str_cast(output(m).view())

// Whether `name` is a pin the chip drives low, as an LED's cathode is when it is lit.
private lit(m: *Machine, name: string) -> bool = stm32_output(&m.devices.storage, name) == Some((true, false))

@test("Discovery Forth: a banner, then each typed line echoed and interpreted, and the machine asleep when the input ends")
disco_forth_arithmetic()
    val board = typed("2 3 + .\n: SQ DUP * ; 7 SQ .\n")
    val m = &*board
    val text = said(m)
    assert(text.starts_with("forth on the STM32H747I-DISCO\n"), text)
    assert(text.contains("2 3 + .\n5  ok\n"), text)
    assert(text.contains(": SQ DUP * ; 7 SQ .\n49  ok\n"), text)
    assert(core0(m).stop == Stop.Asleep, s"${core0(m).stop}")

@test("Discovery Forth: backspace edits the line, and a word that is not defined is reported")
disco_forth_editing_and_faults()
    val board = typed("1 9\x08 2 + .\nNOPE\n")
    val m = &*board
    val text = said(m)
    assert(text.contains("\x08 \x08"), text)
    assert(text.contains("3  ok\n"), text)
    assert(text.contains("NOPE ?") || text.contains("NOPE"), text)
    assert(core0(m).stop == Stop.Asleep, s"${core0(m).stop}")

@test("Discovery Forth: `!` reaches the board, so LED-ON and LED-OFF light and darken LD1 to LD4, and BUTTON? reads B2")
disco_forth_leds_and_button()
    val on = typed("1 LED-ON 4 LED-ON\n")
    assert(lit(&*on, "PI12") && !lit(&*on, "PI13") && !lit(&*on, "PI14") && lit(&*on, "PI15"))
    val off = typed("1 LED-ON 2 LED-ON 1 LED-OFF\n")
    assert(!lit(&*off, "PI12") && lit(&*off, "PI13"))
    val released = typed("BUTTON? .\n")
    assert(said(&*released).contains("0  ok\n"), said(&*released))
