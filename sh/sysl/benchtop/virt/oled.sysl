module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, Part, part_model}
import sh.sysl.benchtop.parts.ssd1306 as oled
import sh.sysl.benchtop.parts.spi as spi
import sysl.buf.{Buf, buf}

struct OledBinding
    name: string
    model: oled.Display
    port: spi.Port
    pins: PortPins

// The SSD1306s `b` wires to its chip.
private[virt] oleds_of(b: Board) -> Buf[OledBinding]
    var oleds: Buf[OledBinding] = buf()
    for p in b.parts
        if part_model(p) != "ssd1306" then continue
        oleds.push(OledBinding(p.name, oled.display(), spi.port(), port_pins(p)))
    oleds

private[virt] reset_oleds(s: *DisplayState)
    for i in 0..<s.oleds.len()
        var b = s.oleds[i]
        b.model = oled.display()
        spi.restart(&b.port)
        s.oleds[i] = b

private[virt] observe_oleds(s: *DisplayState, levels: u32, driven: u32)
    for i in 0..<s.oleds.len()
        var b = s.oleds[i]
        hear_oled(&b, levels, driven)
        s.oleds[i] = b

// The OLED `b`'s port sees the GPIOs at `levels`, the chip driving those of `driven`.
private hear_oled(b: *OledBinding, levels: u32, driven: u32)
    spi.transfer(&b.port, port_wires(b.pins, levels, driven)) match
        Reset -> oled.reset(&b.model)
        Byte(data, byte) -> oled.write(&b.model, data, byte)
        Idle -> ()

/** An SSD1306 that hears its GPIOs as they change, for a chip other than benchtop's Cortex-M machine to
 * drive (`chip.RpParts`): the machine's model and port, held by reference so the chip's pin hook and
 * the window reach the one controller.
 */
struct Oled
    binding: OledBinding

impl Oled
    name(*self) -> string = self.binding.name
    /** The GPIO each terminal is wired to (-1 for none). */
    pins(*self) -> PortPins = self.binding.pins
    /** Power-on: the controller as at reset, its memory blank, the port idle. */
    restart(*self)
        self.binding.model = oled.display()
        spi.restart(&self.binding.port)
    /** The GPIOs at `levels`, the chip driving those of `driven`, bit n for GPIO n: GPIOs 0 to 31. */
    hear(*self, levels: u64, driven: u64) = hear_oled(&self.binding, u32.wrap(levels), u32.wrap(driven))
    /** The controller as it stands. */
    display(*self) -> oled.Display = self.binding.model

/** The SSD1306 `p` as an `Oled`; None for any other part. */
oled_of(p: Part) -> Option[&Oled]
    if part_model(p) != "ssd1306" then return None
    val o: &Oled = Oled(OledBinding(p.name, oled.display(), spi.port(), port_pins(p)))
    Some(o)

/** Renderer observes GDDRAM; firmware owns every pixel. */
oled_state(m: *Machine, name: string) -> Option[oled.Display]
    m.devices.displays.live.with(s ->
        var found: Option[oled.Display] = None
        for b in s.oleds do if b.name == name
            found = Some(b.model)
            break
        found)
