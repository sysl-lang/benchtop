module sh.sysl.benchtop.virt

import sh.sysl.benchtop.Board
import sh.sysl.benchtop.parts.ssd1306 as oled
import sh.sysl.benchtop.parts.spi as spi
import sysl.buf.{Buf, buf}

struct OledBinding
    name: string
    model: oled.Display
    bus: spi.Receiver
    dc: int
    reset: int
    data: bool
    resetting: bool

var oled_bindings: Buf[OledBinding] = buf()

private[virt] configure_oleds(b: Board)
    oled_bindings = buf()
    for p in b.parts
        if p.kind != "ssd1306" then continue
        oled_bindings.push(OledBinding(p.name, oled.display(),
            spi.receiver(terminal_pin(p, "cs", b.chip.name), terminal_pin(p, "sck", b.chip.name), terminal_pin(p, "mosi", b.chip.name)),
            terminal_pin(p, "dc", b.chip.name), terminal_pin(p, "reset", b.chip.name), false, false))

private[virt] reset_oleds()
    for i in 0..<oled_bindings.len()
        var b = oled_bindings.at(i)
        b.model = oled.display()
        spi.reset(&b.bus)
        b.resetting = false
        oled_bindings.set(i, b)

private[virt] observe_oleds(levels: u32, driven: u32)
    for i in 0..<oled_bindings.len()
        var b = oled_bindings.at(i)
        val reset = 1u32 << u32(b.reset)
        val dc = 1u32 << u32(b.dc)
        if (driven & reset) == 0 || (levels & reset) == 0
            if !b.resetting then oled.reset(&b.model)
            b.resetting = true
            spi.reset(&b.bus)
        else
            b.resetting = false
            val data = (levels & dc) != 0
            if (driven & dc) == 0 || (b.bus.bits != 0 && data != b.data)
                spi.reset(&b.bus)
            else
                if b.bus.bits == 0 then b.data = data
                spi.observe(&b.bus, levels, driven) match
                    Some(byte) -> oled.write(&b.model, b.data, byte)
                    None -> ()
        oled_bindings.set(i, b)

/** Renderer observes GDDRAM; firmware owns every pixel. */
oled_state(name: string) -> Option[oled.Display]
    display_lock.lock()
    defer display_lock.unlock()
    for b in oled_bindings do if b.name == name then return Some(b.model)
    None
