module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, part_model, part_whole}
import sh.sysl.benchtop.parts.hd44780 as lcd
import sysl.buf.{Buf, buf}

/** The GPIO each HD44780 terminal is wired to, -1 for none; `rw` is None where RW is not wired, which
 * on the module means tied low.
 */
struct LcdPins
    rs: int
    rw: Option[int]
    e: int
    d: [4]int // D4, D5, D6, D7

struct LcdBinding
    name: string
    model: lcd.Lcd
    pins: LcdPins

// The HD44780s `b` wires to its chip.
private[virt] lcds_of(b: Board) -> Buf[LcdBinding]
    var lcds: Buf[LcdBinding] = buf()
    for p in b.parts
        if part_model(p) != "hd44780" then continue
        val wired = (name: string) -> terminal_pin(p, name)
        val rw = wired("rw")
        val pins = LcdPins(wired("rs"), if rw < 0 then None else Some(rw), wired("e"),
            [wired("d4"), wired("d5"), wired("d6"), wired("d7")])
        lcds.push(LcdBinding(p.name, lcd.lcd(int(part_whole(p, "columns", 20)), int(part_whole(p, "rows", 2)),
            u64(part_whole(p, "instruction-cycles", 444)), u64(part_whole(p, "clear-cycles", 18240))), pins))
    lcds

// The bus `pins` see on the GPIO.
private lcd_bus(pins: LcdPins, levels: u32, driven: u32) -> lcd.Bus
    val line = (pin: int) -> line_at(pin, levels, driven)
    val rw = pins.rw match
        Some(pin) -> Some(line(pin))
        None -> None
    lcd.Bus(line(pins.rs), rw, line(pins.e), [line(pins.d[0]), line(pins.d[1]), line(pins.d[2]), line(pins.d[3])])

private[virt] reset_lcds(s: *DisplayState)
    for i in 0..<s.lcds.len()
        var binding = s.lcds.at(i)
        lcd.reset(&binding.model)
        s.lcds.set(i, binding)

private[virt] observe_lcds(s: *DisplayState, levels: u32, driven: u32, time: u64)
    for i in 0..<s.lcds.len()
        var binding = s.lcds.at(i)
        lcd.observe(&binding.model, lcd_bus(binding.pins, levels, driven), time)
        s.lcds.set(i, binding)

/** A snapshot of controller state, never a host-provided display string. */
lcd_state(m: *Machine, name: string) -> Option[lcd.Lcd]
    m.devices.displays.live.with(s ->
        var found: Option[lcd.Lcd] = None
        for b in s.lcds do if b.name == name
            found = Some(b.model)
            break
        found)
