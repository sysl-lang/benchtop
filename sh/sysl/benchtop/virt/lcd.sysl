module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, part_model, part_whole}
import sh.sysl.benchtop.parts.hd44780 as lcd
import sysl.buf.{Buf, buf}

struct LcdBinding
    name: string
    model: lcd.Lcd

var lcd_bindings: Buf[LcdBinding] = buf()

private[virt] configure_lcds(b: Board)
    lcd_bindings = buf()
    for p in b.parts
        if part_model(p) != "hd44780" then continue
        val names = ["rs", "rw", "e", "d4", "d5", "d6", "d7"]
        var pins: [7]int = [-1; 7]
        for i in 0..<7 do pins[i] = terminal_pin(p, names[i], b.chip.name)
        lcd_bindings.push(LcdBinding(p.name, lcd.lcd(int(part_whole(p, "columns", 20)), int(part_whole(p, "rows", 2)), pins,
            u64(part_whole(p, "instruction-cycles", 444)), u64(part_whole(p, "clear-cycles", 18240)))))

private[virt] reset_lcds()
    for i in 0..<lcd_bindings.len()
        var binding = lcd_bindings.at(i)
        lcd.reset(&binding.model)
        lcd_bindings.set(i, binding)

private[virt] observe_lcds(levels: u32, driven: u32, time: u64)
    for i in 0..<lcd_bindings.len()
        var binding = lcd_bindings.at(i)
        lcd.observe(&binding.model, levels, driven, time)
        lcd_bindings.set(i, binding)

/** A snapshot of controller state, never a host-provided display string. */
lcd_state(name: string) -> Option[lcd.Lcd]
    display_lock.lock()
    defer display_lock.unlock()
    for b in lcd_bindings do if b.name == name then return Some(b.model)
    None
