module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, part_model, part_whole}
import sh.sysl.benchtop.parts.hd44780 as lcd
import sysl.buf.{Buf, buf}

struct LcdBinding
    name: string
    model: lcd.Lcd

// The HD44780s `b` wires to its chip.
private[virt] lcds_of(b: Board) -> Buf[LcdBinding]
    var lcds: Buf[LcdBinding] = buf()
    for p in b.parts
        if part_model(p) != "hd44780" then continue
        val wired = (name: string) -> terminal_pin(p, name)
        val rw = wired("rw")
        val pins = lcd.Pins(wired("rs"), if rw < 0 then None else Some(rw), wired("e"),
            [wired("d4"), wired("d5"), wired("d6"), wired("d7")])
        lcds.push(LcdBinding(p.name, lcd.lcd(int(part_whole(p, "columns", 20)), int(part_whole(p, "rows", 2)), pins,
            u64(part_whole(p, "instruction-cycles", 444)), u64(part_whole(p, "clear-cycles", 18240)))))
    lcds

private[virt] reset_lcds(s: *DisplayState)
    for i in 0..<s.lcds.len()
        var binding = s.lcds.at(i)
        lcd.reset(&binding.model)
        s.lcds.set(i, binding)

private[virt] observe_lcds(s: *DisplayState, levels: u32, driven: u32, time: u64)
    for i in 0..<s.lcds.len()
        var binding = s.lcds.at(i)
        lcd.observe(&binding.model, levels, driven, time)
        s.lcds.set(i, binding)

/** A snapshot of controller state, never a host-provided display string. */
lcd_state(name: string) -> Option[lcd.Lcd]
    machine.devices.displays.live.with(s ->
        var found: Option[lcd.Lcd] = None
        for b in s.lcds do if b.name == name
            found = Some(b.model)
            break
        found)
