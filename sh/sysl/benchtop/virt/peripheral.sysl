module sh.sysl.benchtop.virt

// What the machine asks of its devices, as two traits. A `Peripheral` is a device of the machine's:
// what it does at power-on, the board clock it next needs a core to stop at, the clock an interrupt of
// its could wake a sleeping core at, and raising its interrupts in a core between runs. A `BusWindow`
// is a window of one on the cores' bus, which answers the accesses that land in it. Most devices are
// both; the SAI and DMA block, the STM32's SPI and GPIO, and the RP2040's resets, timer and watchdog
// each answer several windows from one state, so a window of theirs is a small value that says which.
//
// `attach` points the bus's windows and the machine's running devices at the devices a board has, so
// the cores' accesses, the scheduler's deadlines and the interrupts reach a device through these
// traits and nowhere else names every kind of device.

import sh.sysl.benchtop.timing.NEVER
import sh.sysl.benchtop.v6m.Cpu
import sysl.math.min

/** A device of the machine `m`'s, which each member is handed: a device keeps its own state in
 * itself, and reaches through `m` only what it shares with the rest of the board (another device a
 * pin or a bus joins it to, the other core). Each member has the default of a device that has no such
 * thing.
 */
trait Peripheral
    /** Put the device as at power-on (`boot`). */
    boot(*self, m: *Machine) = ()
    /** The board clock at which the device next changes on its own and `cpu` brings that change in
     * (a device's events are brought in by its driver, `drives_device`), `NEVER` for none.
     */
    due(*self, m: *Machine, cpu: *Cpu) -> u64 = NEVER
    /** The board clock at which the device could next wake `cpu` from a sleep, `NEVER` for none. */
    wake(*self, m: *Machine, cpu: *Cpu) -> u64 = NEVER
    /** Bring the device up to `cpu`'s clock and raise its interrupts in `cpu`. */
    signal(*self, m: *Machine, cpu: *Cpu) = ()

/** A window on machine `m`'s bus: an access by `cpu` to address `a`, register `o` from the window's
 * base, `width` bytes, made at the core's instruction count `n`.
 */
trait BusWindow
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64)

/** One window of a device that answers several from one state: which of them it is. */
struct AudioWindow
    kind: Device

struct StorageWindow
    kind: Device

struct RpWindow
    kind: Device

/** The windows of the devices that answer several. */
struct Windows
    sai: AudioWindow
    dma1: AudioWindow
    dma2: AudioWindow
    dmamux: AudioWindow
    spi: StorageWindow
    gpio: StorageWindow
    resets: RpWindow
    timer: RpWindow
    watchdog: RpWindow

private[virt] windows() -> Windows =
    Windows(AudioWindow(Device.Sai), AudioWindow(Device.Dma1), AudioWindow(Device.Dma2), AudioWindow(Device.Dmamux),
        StorageWindow(Device.H7Spi), StorageWindow(Device.Stm32Gpio),
        RpWindow(Device.Resets), RpWindow(Device.Timer), RpWindow(Device.Watchdog))

/** The devices a board has that run between the cores' accesses, each once, in the order their
 * interrupts are raised.
 */
struct Running
    devices: [16]*Peripheral
    count: usize

private[virt] no_running() -> Running = Running([null; 16], 0)

/** Point `m`'s bus windows at the devices that answer them, and its running devices at the devices
 * the board has. Called once a board's devices are in place, since the windows hold their addresses.
 */
private[virt] attach(m: *Machine)
    val d = &m.devices
    val bus = &d.bus

    for i in 0..<bus.attached
        bus.windows[i] = window_of(m, bus.mapped[i].device)

    var r = no_running()
    val ds = bus.mapped[0..<bus.attached]
    val has = (k: Device) -> mapped_irq(ds, k).0

    if has(Device.Console) then join(&r, &m.console)
    if has(Device.Sio) then join(&r, &d.sio)
    if has(Device.Resets) || has(Device.Timer) || has(Device.Watchdog) then join(&r, &d.rp)
    if has(Device.Sai) || has(Device.Dma1) || has(Device.Dma2) || has(Device.Dmamux) then join(&r, &d.audio)
    if has(Device.Dsi) then join(&r, &d.dsi)
    if has(Device.Spi) then join(&r, &d.spi)
    if has(Device.Sdmmc) then join(&r, &d.sdmmc)
    if has(Device.PanelGpio) then join(&r, &d.panel)
    if has(Device.Adc) then join(&r, &d.adc)
    if has(Device.I2c) then join(&r, &d.i2c)
    d.running = r
    connect_spi(d)
    connect_dsi(d, &m.scheduler.dsi)
    connect_sdmmc(d)
    connect_adc(d)
    connect_storage(d)
    connect_audio(d)

private join(r: *Running, p: *Peripheral)
    r.devices[r.count] = p
    r.count += 1

// The window that answers for a device of kind `k` on `m`'s bus.
private window_of(m: *Machine, k: Device) -> *BusWindow
    val d = &m.devices

    k match
        Console -> &m.console
        Sio -> &d.sio
        Resets -> &d.windows.resets
        Timer -> &d.windows.timer
        Watchdog -> &d.windows.watchdog
        PanelGpio -> &d.panel
        Adc -> &d.adc
        I2c -> &d.i2c
        Pwm -> &d.pwm
        DigitalAudio -> &d.i2s
        Spi -> &d.spi
        H7Rcc -> &d.rcc
        H7Spi -> &d.windows.spi
        Stm32Gpio -> &d.windows.gpio
        Sdmmc -> &d.sdmmc
        Dsi -> &d.dsi
        Sai -> &d.windows.sai
        Dma1 -> &d.windows.dma1
        Dma2 -> &d.windows.dma2
        Dmamux -> &d.windows.dmamux

/** Every device of `m`'s, present on its bus or not, in the order `boot` puts them at power-on. */
private[virt] every_device(m: *Machine) -> [13]*Peripheral
    val d = &m.devices

    [&d.audio, &d.dsi, &d.rcc, &d.rp, &d.spi, &d.storage, &d.sdmmc, &d.panel, &d.adc, &d.i2c, &d.pwm, &d.i2s, &d.sio]

/** The clock of the next device event `cpu` brings in, `NEVER` for none: its slice ends there. */
private[virt] device_due(m: *Machine, cpu: *Cpu) -> u64
    val r = &m.devices.running
    var due = NEVER

    for i in 0..<r.count do due = min(due, r.devices[i].due(m, cpu))
    due

/** The earliest clock at which a running device could wake `cpu`, `NEVER` for none. */
private[virt] device_wake(m: *Machine, cpu: *Cpu) -> u64
    val r = &m.devices.running
    var due = NEVER

    for i in 0..<r.count do due = min(due, r.devices[i].wake(m, cpu))
    due

// Each device's half of the two traits, which its own file's functions do on the device itself, or,
// where the device reaches another (the panel's pads, the SDMMC's GPIO, the codec on the I2C bus and
// the SAI, the other core an interrupt or a launch reaches), on the machine's devices.

impl Peripheral for RpState
    override boot(*self, m: *Machine) = boot_rp(self)
    override due(*self, m: *Machine, cpu: *Cpu) -> u64 = timer_due(self)
    override wake(*self, m: *Machine, cpu: *Cpu) -> u64 = timer_wake(self, cpu)
    override signal(*self, m: *Machine, cpu: *Cpu) = signal_rp(self, cpu)

impl BusWindow for RpWindow
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = rp_read(&m.devices.rp, cpu, self.kind, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = rp_write(&m.devices.rp, cpu, self.kind, a, o, width, x, n)

impl Peripheral for AudioState
    override boot(*self, m: *Machine) = boot_sai_dma(self)
    override due(*self, m: *Machine, cpu: *Cpu) -> u64 = sai_dma_due_for(self, cpu)
    override wake(*self, m: *Machine, cpu: *Cpu) -> u64 = sai_dma_wake(self, cpu)
    override signal(*self, m: *Machine, cpu: *Cpu) = signal_sai_dma(m, cpu)

impl BusWindow for AudioWindow
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = sai_dma_read(m, cpu, self.kind, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = sai_dma_write(m, cpu, self.kind, a, o, width, x, n)

impl Peripheral for StorageState
    override boot(*self, m: *Machine) = boot_storage(self)

impl BusWindow for StorageWindow
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = storage_read(&m.devices.storage, cpu, self.kind, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = storage_write(&m.devices.storage, cpu, self.kind, a, o, width, x, n)

impl Peripheral for DsiState
    override boot(*self, m: *Machine) = boot_dsi(self)
    override due(*self, m: *Machine, cpu: *Cpu) -> u64 = dsi_due_for(self, cpu)
    // The DSI raises no interrupt a core sleeps for; its deadline is the wake.
    override wake(*self, m: *Machine, cpu: *Cpu) -> u64 = dsi_due_for(self, cpu)
    override signal(*self, m: *Machine, cpu: *Cpu) = signal_dsi(self, cpu)

impl BusWindow for DsiState
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = dsi_read(self, cpu, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = dsi_write(self, cpu, a, o, width, x, n)

impl Peripheral for RccState
    override boot(*self, m: *Machine) = boot_h7(self)

impl BusWindow for RccState
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = h7_rcc_read(self, cpu, a, o, width)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = h7_rcc_write(m, cpu, a, o, width, x)

impl Peripheral for SpiState
    override boot(*self, m: *Machine) = boot_spi(self)
    override due(*self, m: *Machine, cpu: *Cpu) -> u64 = spi_due(self)
    override wake(*self, m: *Machine, cpu: *Cpu) -> u64 = spi_wake(self, cpu)
    override signal(*self, m: *Machine, cpu: *Cpu) = signal_spi(&m.devices, cpu)

impl BusWindow for SpiState
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = spi_read(&m.devices, cpu, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = spi_write(&m.devices, cpu, a, o, width, x, n)

impl Peripheral for SdmmcState
    override boot(*self, m: *Machine) = boot_sdmmc(self)
    override due(*self, m: *Machine, cpu: *Cpu) -> u64 = sdmmc_due(self)
    override wake(*self, m: *Machine, cpu: *Cpu) -> u64 = sdmmc_wake(self, cpu)
    override signal(*self, m: *Machine, cpu: *Cpu) = signal_sdmmc(&m.devices, cpu)

impl BusWindow for SdmmcState
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = sdmmc_read(&m.devices, cpu, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = sdmmc_write(&m.devices, cpu, a, o, width, x, n)

impl Peripheral for PanelState
    override boot(*self, m: *Machine) = boot_panel(&m.devices)
    override signal(*self, m: *Machine, cpu: *Cpu) = signal_panel(self, cpu)

impl BusWindow for PanelState
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = panel_read(&m.devices, cpu, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = panel_write(&m.devices, cpu, a, o, width, x, n)

impl Peripheral for AdcState
    override boot(*self, m: *Machine) = boot_adc(self)
    override due(*self, m: *Machine, cpu: *Cpu) -> u64 = adc_due(self)
    override wake(*self, m: *Machine, cpu: *Cpu) -> u64 = adc_wake(self, cpu)
    override signal(*self, m: *Machine, cpu: *Cpu) = signal_adc(self, cpu)

impl BusWindow for AdcState
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = adc_read(self, cpu, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = adc_write(self, cpu, a, o, width, x, n)

impl Peripheral for I2c
    override boot(*self, m: *Machine) = boot_i2c(&m.devices)
    override signal(*self, m: *Machine, cpu: *Cpu) = signal_rtcs(self, cpu)

impl BusWindow for I2c
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = i2c_read(self, cpu, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = i2c_write(self, cpu, a, o, width, x, n)

impl Peripheral for PwmState
    override boot(*self, m: *Machine) = boot_sound(self)

impl BusWindow for PwmState
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = pwm_read(self, cpu, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = pwm_write(self, cpu, a, o, width, x, n)

impl Peripheral for I2sState
    override boot(*self, m: *Machine) = boot_digital_audio(self)

impl BusWindow for I2sState
    read(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, n: u64) -> u32 = digital_read(self, cpu, a, o, width, n)
    write(*self, m: *Machine, cpu: *Cpu, a: u32, o: u32, width: u32, x: u32, n: u64) = digital_write(self, cpu, a, o, width, x, n)
