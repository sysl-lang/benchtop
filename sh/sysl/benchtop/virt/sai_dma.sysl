module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board,param_named}
import sh.sysl.benchtop.peripheral.sai as sai
import sh.sysl.benchtop.peripheral.dma as dma
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.benchtop.v6m.{Cpu,Stop,halt,lower_limit}
import sh.sysl.benchtop.v6m as memory
import sysl.buf.{Buf,buf}
import sysl.container.ring.{Ring,ring}
import sysl.math.min
import sysl.threads.Mutex
import sysl.sync.*

// The audio devices' interrupt lines: the SAI's, then each of the two DMA controllers' eight streams.
private const IRQ_LINES: usize = 17

/** The SAI (`stm32-sai`), the two DMA controllers (`stm32-dma`) and the DMAMUX (`stm32-dmamux`):
 * which of them the bus has, the SAI's base, the DMA request each of its blocks makes and the IRQ
 * each interrupt line raises (the SAI's, then each DMA stream's; -1 for none), which the board fixes;
 * `next` and `irq_levels`, published for the cores to read without the lock; `driver`, the core that
 * brings the slots in (`claim_device`); and under `live` the
 * models and the queues that carry samples to and from the host.
 */
struct AudioState
    sai_present: bool
    dma_present: [2]bool
    mux_present: bool
    sai_at: u32
    requests: [2]u32
    irq_routes: [IRQ_LINES]int
    next: u64
    irq_levels: u32
    driver: u32
    live: Mutex[AudioLive]

/** The SAI's blocks, the DMA controllers and the DMAMUX; and, per block, the frames played so far,
 * the packets played and not yet taken by the host, and the words the host has given it to record
 * (`debug_input` once a test has fed it directly). Each queue keeps the newest values;
 * `output_slots` and `input_slots` are the storage the rings lay over, empty where the bus has no
 * SAI to fill them. `settled` holds once the DMA has moved everything the SAI's FIFOs request, so
 * servicing it again would change nothing.
 *
 * **The DMA is a bus master of its own, not either core.** Its reads and writes of RAM go to the
 * memory both cores share, and a store it makes invalidates both cores' exclusive reservations and
 * decoded code (`memory.device_store`); its interrupt lines reach both cores' NVICs. What a core
 * contributes is only the host thread the work runs on — `via` below, passed down explicitly — and
 * nothing the DMA does depends on which core that is.
 *
 * **Device time.** The SAI and DMA run at one clock that never goes backwards: each access first
 * brings them to the accessing core's time. The two cores run loosely coupled, so a core that lags
 * the other sees the devices as of the other's later time — exactly as it sees RAM the other wrote —
 * and its own earlier time never rewinds them (`bring_audio` advances only).
 */
struct AudioLive
    blocks: [2]&sai.Block
    units: [2]&dma.Controller
    mux: &dma.Mux
    frame_number: [2]u64
    output: [2]Ring[SaiPacket]
    input: [2]Ring[u32]
    debug_input: [2]bool
    output_slots: [2]Buf[SaiPacket]
    input_slots: [2]Buf[u32]
    settled: bool

// What the SAI's blocks played and what they are given to record, crossing to and from the host.
struct SaiPacket
    frame: u64
    word: u32
    slot: u32
    slots: u32
    bits: u32
    gain: u32

private const OUTPUT_RING: usize = 16384
private const INPUT_RING: usize = 4096

private slots[T](size: usize, value: T) -> Buf[T]
    var b: Buf[T] = buf()
    for i in 0..<size do b.push(value)
    b

// The models for a chip clocked at `hz` with the SAI's kernel clock at `kernel`, and the host's
// queues where the bus has an SAI to fill them.
private audio_live(hz: u64 = 480000000, kernel: u64 = 12288000, sai_present: bool = false) -> AudioLive
    val packets = if sai_present then OUTPUT_RING else 0
    val words = if sai_present then INPUT_RING else 0
    val output_slots = [slots(packets,SaiPacket(0,0,0,0,0,0)),slots(packets,SaiPacket(0,0,0,0,0,0))]
    val input_slots = [slots(words,0u32),slots(words,0u32)]
    AudioLive(blocks = [sai.block(hz,kernel),sai.block(hz,kernel)], units = [dma.controller(),dma.controller()],
        mux = dma.mux(), frame_number = [0,0],
        output = [ring(output_slots[0].view()),ring(output_slots[1].view())],
        input = [ring(input_slots[0].view()),ring(input_slots[1].view())], debug_input = [false,false],
        output_slots = output_slots, input_slots = input_slots, settled = false)

// The DMAMUX1 request lines of SAI1's blocks (RM0399, table "DMAMUX1: assignment of multiplexer
// inputs to resources"), which a board's `request-a`/`request-b` replace.
private const DMAMUX_SAI1_A: u32 = 87
private const DMAMUX_SAI1_B: u32 = 88

/** No SAI, DMA or DMAMUX on the bus. */
audio_state() -> AudioState =
    AudioState(false, [false,false], false, 0, [DMAMUX_SAI1_A,DMAMUX_SAI1_B], [-1;IRQ_LINES], NEVER, 0, 0, Mutex.new(audio_live()))

// The SAI and DMA `b` makes on a chip whose clock is `clock_hz`, with the DMA controllers where
// `mapped` puts them: which controller each is was read once, into its device.
private[virt] check_audio(b: Board, mapped: []const Mapped, clock_hz: u64) -> Result[AudioState,string]
    var s = audio_state()
    for m in mapped
        val index: usize = m.device match
            Dma1 -> 0
            Dma2 -> 1
            _ -> continue
        s.dma_present[index] = true
        for k in 0..<8 do if m.irqs[k] >= 0 then s.irq_routes[1 + index * 8 + k] = m.irqs[k]
    var kernel = sai.DEFAULT_KERNEL_HZ
    for p in b.chip.peripherals
        if p.kind == "stm32-sai"
            if s.sai_present then return Err("one STM32 SAI instance is currently supported")
            if clock_hz == 0 then return Err("stm32-sai requires mcu.clock-hz")
            if !p.irqs.is_empty() then s.irq_routes[0] = int(p.irqs.at(0).n)
            s.sai_present = true
            s.sai_at = u32(p.at.unwrap().n)
            for q in p.params
                q.value match
                    Whole(n) ->
                        if q.name == "kernel-clock-hz" then kernel = u64(n)
                        elif q.name == "request-a" then s.requests[0] = u32(n)
                        elif q.name == "request-b" then s.requests[1] = u32(n)
                    _ -> ()
        elif p.kind == "stm32-dmamux" then s.mux_present = true
    if s.requests[0] == s.requests[1] then return Err("SAI A and B need distinct DMA request IDs")
    s.live = Mutex.new(audio_live(if clock_hz == 0 then sai.DEFAULT_HZ else clock_hz,kernel,s.sai_present))
    Ok(s)

private[virt] boot_sai_dma(d: *AudioState)
    d.live.with(s ->
        for i in 0..<2
            sai.reset(s.blocks[i])
            dma.reset(s.units[i])
        dma.reset_mux(s.mux)
        s.frame_number = [0,0]
        s.debug_input = [false,false]
        for i in 0..<2
            s.output[i].clear()
            s.input[i].clear()
        s.settled = false)
    atomic_store(&d.next,NEVER,Release)
    atomic_store(&d.irq_levels,0,Release)
    atomic_store(&d.driver,0,Release)

// These debug/codec-facing queues never advance guest time or take UI locks.
/** Give `m`'s SAI block `block` `words` to receive, in place of what the codec records. */
sai_feed_input(m: *Machine, block: usize, words: []const u32)
    require block < 2, "SAI block index"
    m.devices.audio.live.with(s ->
        s.debug_input[block] = true
        for word in words do s.input[block].overwrite(word))

/** What `m`'s SAI block `block` has sent since this was last asked. */
sai_take_output(m: *Machine, block: usize) -> Buf[u32]
    var words: Buf[u32] = buf()
    for packet in sai_take_packets(&m.devices.audio, block) do words.push(packet.word)
    words

private[virt] sai_take_packets(d: *AudioState, block: usize) -> Buf[SaiPacket]
    require block < 2, "SAI block index"
    var packets: Buf[SaiPacket] = buf()
    val into = &packets
    d.live.with(s ->
        for packet in s.output[block] do into.push(packet)
        s.output[block].clear())
    packets

private input_word(s: *AudioLive, block: usize) -> u32 = s.input[block].pop_front().unwrap_or(0)

private output_word(ds: *Devices, s: *AudioLive, block: usize, slot: u32, word: u32)
    if slot == 0 then s.frame_number[block] += 1
    val b = s.blocks[block]
    val bits = sai.sample_bits(b)
    val count = sai.slots(b)
    val gain = codec_slot_gain(&ds.codec,block,slot,count,bits)
    s.output[block].overwrite(SaiPacket(s.frame_number[block],word,slot,count,bits,gain))

private data_block(d: *AudioState, address: u32) -> int
    if !d.sai_present then return -1
    if address == d.sai_at + sai.data_register(0) then 0 elif address == d.sai_at + sai.data_register(1) then 1 else -1

// The DMA's own reads and writes: the SAI's data registers, or the RAM both cores share, reached on
// `via`'s thread.
private audio_bus_read(d: *AudioState, s: *AudioLive, via: *Cpu, address: u32, width: u32) -> Option[u32]
    val block = data_block(d,address)
    if block >= 0 then return sai.read(s.blocks[block],sai.DR)
    val page = memory.page_for(via,address,width)
    if page == 0 then None else Some(memory.host_read(page,address,width))

private audio_bus_write(d: *AudioState, s: *AudioLive, via: *Cpu, address: u32, width: u32, value: u32) -> bool
    val block = data_block(d,address)
    if block >= 0 then return sai.write(s.blocks[block],sai.DR,value)
    memory.device_store(via,address,width,value)

// One beat of `stream` on DMA controller `unit`, made on the bus directly (no callback to allocate on
// the path every slot and register access takes). False when the stream had nothing to move or the bus
// failed it.
private audio_beat(d: *AudioState, s: *AudioLive, via: *Cpu, unit: usize, stream: usize) -> bool
    val controller = s.units[unit]
    dma.next_beat(controller,stream) match
        None -> false
        Some(b) ->
            var ok = dma.aligned(b)
            if ok
                audio_bus_read(d,s,via,b.source,b.width) match
                    Some(value) -> ok = audio_bus_write(d,s,via,b.target,b.width,value & dma.width_mask(b.width))
                    None -> ok = false
            dma.finish_beat(controller,stream,ok)

// Let the DMA answer every request the SAI's FIFOs make, on `via`'s thread. `settled` records whether
// every stream stopped because nothing more was asked of it or it could not go on; one that used its
// whole bound may have more to move, and the next access services it again.
private service_audio_dma(d: *AudioState, s: *AudioLive, via: *Cpu)
    s.settled = true
    if !d.mux_present || !d.sai_present then return
    for unit in 0..<2
        if !d.dma_present[unit] then continue
        for stream in 0..<8
            for block in 0..<2
                if !dma.routed(s.mux,unit * 8 + stream,d.requests[block]) then continue
                // Bounded even for a misconfigured circular PAR which does not
                // service the selected FIFO. No bus callbacks recurse into MMIO.
                var stopped = false
                for beat in 0..<8
                    if !sai.dma_request(s.blocks[block]) || !audio_beat(d,s,via,unit,stream)
                        stopped = true
                        break
                if !stopped then s.settled = false

private input_slot(ds: *Devices, s: *AudioLive, block: usize, slot: u32) -> u32
    val b = s.blocks[block]
    val source = if s.debug_input[block] then None else codec_input_word(&ds.codec,block,slot,sai.slots(b),sai.sample_bits(b))
    source match
        Some(word) -> word
        None -> if sai.slot_enabled(b,slot) then input_word(s,block) else 0

private audio_slot(ds: *Devices, s: *AudioLive, block: usize, slot: u32, word: u32, time: u64) -> u32
    val b = s.blocks[block]
    var input: u32 = 0
    if sai.receiving(b)
        input = input_slot(ds,s,block,slot)
    else output_word(ds,s,block,slot,word)
    val peer = 1 - block
    val other = s.blocks[peer]
    if sai.enabled(other) && sai.synchronous(other.cr1)
        other.time = time
        val sample = if sai.receiving(other) then input_slot(ds,s,peer,other.slot) else 0
        val peer_slot = other.slot
        val output = sai.clock_slot(other,sample)
        if !sai.receiving(other) then output_word(ds,s,peer,peer_slot,output)
    // RX data for the autonomous block is committed by sai.advance after this
    // callback. Its DMA is serviced immediately afterwards by bring_audio.
    input

// An interrupt line reaches both cores' NVICs: `via`'s own directly, the other's from this thread.
private deliver_audio_irq(m: *Machine, via: *Cpu, irq: u32)
    memory.raise(via,irq)
    memory.cut(via)
    if scheduler.launched then memory.poke(&m.cores[1 - via.core],irq)

private publish_audio(m: *Machine, s: *AudioLive, via: *Cpu)
    val d = &m.devices.audio
    atomic_store(&d.next,if d.sai_present then audio_event(s) else NEVER,Release)
    var levels: u32 = if d.sai_present && (sai.irq(s.blocks[0]) || sai.irq(s.blocks[1])) then 1 else 0
    for unit in 0..<2
        if !d.dma_present[unit] then continue
        for stream in 0..<8
            if dma.irq(s.units[unit],stream) then levels |= 1 << u32(1 + unit * 8 + stream)
    val rising = levels & ~atomic_swap(&d.irq_levels,levels,AcqRel)
    for k in 0..<IRQ_LINES
        routed_irq(d,rising,k) match
            Some(n) -> deliver_audio_irq(m,via,n)
            None -> ()

// The IRQ interrupt line `k` raises where `levels` has it high and the board routes it; None otherwise.
@inline
private routed_irq(d: *AudioState, levels: u32, k: usize) -> Option[u32] =
    if levels & (1 << u32(k)) == 0 || d.irq_routes[k] < 0 then None else Some(u32(d.irq_routes[k]))

// The earlier of the two blocks' next slots (NEVER for none).
private audio_event(s: *AudioLive) -> u64 = min(s.blocks[0].due, s.blocks[1].due)

private bring_audio(m: *Machine, s: *AudioLive, c: *Cpu, time: u64)
    service_audio_dma(&m.devices.audio,s,c)
    val due = audio_event(s)
    if due != NEVER && due <= time then clock_audio(m,s,c,time)
    for b in s.blocks
        if time > b.time then b.time = time
    publish_audio(m,s,c)

// Every slot due by `time`, with the DMA serviced after each.
private clock_audio(m: *Machine, s: *AudioLive, c: *Cpu, time: u64)
    val ds = &m.devices
    val endpoint_a: sai.Endpoint = (slot,word,at) -> audio_slot(ds,s,0,slot,word,at)
    val endpoint_b: sai.Endpoint = (slot,word,at) -> audio_slot(ds,s,1,slot,word,at)
    loop
        val first = s.blocks[0].due
        val second = s.blocks[1].due
        val due = min(first, second)
        if due == NEVER || due > time then break
        // Interleave DMA between slots even when a caller advances a large
        // interval, so batching cannot create artificial FIFO underruns.
        if first <= second then sai.advance(s.blocks[0],due,endpoint_a)
        else sai.advance(s.blocks[1],due,endpoint_b)
        service_audio_dma(&ds.audio,s,c)

private[virt] sai_dma_due(d: *AudioState) -> u64 = atomic_load(&d.next,Acquire)

private audio_raise_levels(d: *AudioState, c: *Cpu)
    val levels = atomic_load(&d.irq_levels,Acquire)
    if levels == 0 then return
    for k in 0..<IRQ_LINES
        routed_irq(d,levels,k) match
            Some(n) -> if !memory.exception_active(c,memory.IRQ0 + n) then memory.raise(c,n)
            None -> ()

// The next slot, for the core that brings the slots in; NEVER for the other.
private[virt] sai_dma_due_for(d: *AudioState, c: *Cpu) -> u64 = if drives_device(&d.driver,c) then sai_dma_due(d) else NEVER

private[virt] signal_sai_dma(m: *Machine, c: *Cpu)
    val d = &m.devices.audio
    if d.sai_present && drives_device(&d.driver,c)
        val due = sai_dma_due(d)
        val time = board_time(c,c.retired)
        if due != NEVER && time >= due then d.live.with(s -> bring_audio(m,s,c,time))
    audio_raise_levels(d,c)

private[virt] sai_dma_wake(d: *AudioState, c: *Cpu) -> u64
    val levels = atomic_load(&d.irq_levels,Acquire)
    if levels != 0
        for k in 0..<IRQ_LINES
            routed_irq(d,levels,k) match
                Some(n) -> if memory.could_wake(c,memory.IRQ0 + n) then return board_time(c,c.retired)
                None -> ()
    sai_dma_due_for(d,c)

private valid_audio_access(device: Device, offset: u32, width: u32) -> bool
    if device == Device.Sai && (offset == sai.data_register(0) || offset == sai.data_register(1)) then return width == 1 || width == 2 || width == 4
    width == 4 && offset & 3 == 0

private audio_register_read(s: *AudioLive, device: Device, offset: u32) -> Option[u32] = device match
    Dma1 -> dma.read(s.units[0],offset)
    Dma2 -> dma.read(s.units[1],offset)
    Dmamux -> dma.read_mux(s.mux,offset)
    Sai ->
        if sai.global_register(offset) then Some(0)
        elif sai.block_index(offset) >= 0 then sai.read(s.blocks[usize(sai.block_index(offset))],sai.block_register(offset))
        else None
    _ -> None

private audio_register_write(s: *AudioLive, device: Device, offset: u32, value: u32) -> bool = device match
    Dma1 -> dma.write(s.units[0],offset,value)
    Dma2 -> dma.write(s.units[1],offset,value)
    Dmamux -> dma.write_mux(s.mux,offset,value)
    Sai ->
        if sai.global_register(offset) then value == 0
        elif sai.block_index(offset) >= 0
            val index = usize(sai.block_index(offset))
            val reg = sai.block_register(offset)
            val b = s.blocks[index]
            // Internal synchronous blocks must use the driving block's frame.
            if reg == sai.CR1 && value & sai.ENABLE != 0 && sai.synchronous(value)
                val peer = s.blocks[1 - index]
                if b.frcr != peer.frcr || sai.slots(b) != sai.slots(peer) then return false
            sai.write(b,reg,value)
        else false
    _ -> false

// Whether a read of `offset` at `time` can answer from the devices' current state: every earlier
// access ended with the DMA serviced and the state published, no slot is due by `time`, the DMA has
// nothing left to move, and the register is not a data register, whose read takes from the FIFO.
private quiet_audio_read(s: *AudioLive, device: Device, offset: u32, time: u64) -> bool =
    s.settled && time < audio_event(s) && !(device == Device.Sai && (offset == sai.data_register(0) || offset == sai.data_register(1)))

private[virt] sai_dma_read(m: *Machine, c: *Cpu, device: Device, address: u32, offset: u32, width: u32, n: u64) -> u32
    if !valid_audio_access(device,offset,width)
        halt(c,Stop.Fault,address)
        return 0
    val d = &m.devices.audio
    val result = d.live.with(s ->
        val time = board_time(c,n)
        if quiet_audio_read(s,device,offset,time)
            // No slot falls due by `time` and the DMA has nothing left to move, so bringing the
            // devices to `time` would only move their clocks, and the state the last access published
            // is the state at `time`; a read that changes nothing needs neither a service nor a publish.
            for b in s.blocks
                if time > b.time then b.time = time
            audio_register_read(s,device,offset)
        else
            bring_audio(m,s,c,time)
            val result = audio_register_read(s,device,offset)
            // Reading RX DR may release space; always publish the resulting request state.
            service_audio_dma(d,s,c)
            publish_audio(m,s,c)
            result)
    result match
        Some(value) -> if width == 4 then value else value & ((1u32 << (width * 8)) - 1)
        None ->
            halt(c,Stop.Unmapped,address)
            0

private[virt] sai_dma_write(m: *Machine, c: *Cpu, device: Device, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if !valid_audio_access(device,offset,width)
        halt(c,Stop.Fault,address)
        return
    val d = &m.devices.audio
    claim_device(&d.driver,c)
    d.live.with(s ->
        bring_audio(m,s,c,board_time(c,n))
        val word = if width == 4 then value else value & ((1u32 << (width * 8)) - 1)
        if !audio_register_write(s,device,offset,word) then halt(c,Stop.Fault,address)
        service_audio_dma(d,s,c)
        publish_audio(m,s,c))
    val due = sai_dma_due(d)
    if due != NEVER then lower_limit(c,retirement_limit(c,due))
