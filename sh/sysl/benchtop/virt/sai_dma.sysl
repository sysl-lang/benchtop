module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board,param_named}
import sh.sysl.benchtop.peripheral.sai as sai
import sh.sysl.benchtop.peripheral.dma as dma
import sh.sysl.benchtop.v6m.{Cpu,Stop,NEVER,halt,lower_limit}
import sh.sysl.benchtop.v6m as memory
import sysl.buf.{Buf,buf}
import sysl.container.ring.{Ring,ring}
import sysl.threads.Mutex
import sysl.sync.*

/** The SAI (`stm32-sai`), the two DMA controllers (`stm32-dma`) and the DMAMUX (`stm32-dmamux`):
 * which of them the bus has, the SAI's base, the DMA request each of its blocks makes and the IRQ
 * each interrupt line raises (the SAI's, then each DMA stream's; -1 for none), which the board fixes;
 * `next` and `irq_levels`, published for the cores to read without the lock; and under `live` the
 * models and the queues that carry samples to and from the host.
 */
struct AudioState
    sai_present: bool
    dma_present: [2]bool
    mux_present: bool
    sai_at: u32
    requests: [2]u32
    irq_routes: [17]int
    next: u64
    irq_levels: u32
    live: Mutex[AudioLive]

/** The SAI's blocks, the DMA controllers and the DMAMUX; `core`, the core whose access is being
 * served (its number rather than a borrowed MMIO callback pointer); and, per block, the frames
 * played so far, the packets played and not yet taken by the host, and the words the host has given
 * it to record (`debug_input` once a test has fed it directly). Each queue keeps the newest values;
 * `output_slots` and `input_slots` are the storage the rings lay over, empty where the bus has no
 * SAI to fill them.
 */
struct AudioLive
    blocks: [2]&sai.Block
    units: [2]&dma.Controller
    mux: &dma.Mux
    core: u32
    frame_number: [2]u64
    output: [2]Ring[SaiPacket]
    input: [2]Ring[u32]
    debug_input: [2]bool
    output_slots: [2]Buf[SaiPacket]
    input_slots: [2]Buf[u32]

// What the SAI's blocks played and what they are given to record, crossing to and from the host.
struct SaiPacket
    frame: u64
    word: u32
    slot: u32
    slots: u32
    bits: u32
    gain: u32

private const OUTPUT_RING: usize = 16384
private const INPUT_RING: usize = 4096

private slots[T](size: usize, value: T) -> Buf[T]
    var b: Buf[T] = buf()
    for i in 0..<size do b.push(value)
    b

// The models for a chip clocked at `hz` with the SAI's kernel clock at `kernel`, and the host's
// queues where the bus has an SAI to fill them.
private audio_live(hz: u64 = 480000000, kernel: u64 = 12288000, sai_present: bool = false) -> AudioLive
    val packets = if sai_present then OUTPUT_RING else 0
    val words = if sai_present then INPUT_RING else 0
    val output_slots = [slots(packets,SaiPacket(0,0,0,0,0,0)),slots(packets,SaiPacket(0,0,0,0,0,0))]
    val input_slots = [slots(words,0u32),slots(words,0u32)]
    AudioLive(blocks = [sai.block(hz,kernel),sai.block(hz,kernel)], units = [dma.controller(),dma.controller()],
        mux = dma.mux(), core = 0, frame_number = [0,0],
        output = [ring(output_slots[0].view()),ring(output_slots[1].view())],
        input = [ring(input_slots[0].view()),ring(input_slots[1].view())], debug_input = [false,false],
        output_slots = output_slots, input_slots = input_slots)

/** No SAI, DMA or DMAMUX on the bus. */
audio_state() -> AudioState =
    AudioState(false, [false,false], false, 0, [87,88], [-1;17], NEVER, 0, Mutex.new(audio_live()))

private audio_cpu(s: *AudioLive) -> *Cpu = if s.core == 0 then core0() else core1()

// The SAI and DMA `b` makes on a chip whose clock is `clock_hz`.
private[virt] check_audio(b: Board, clock_hz: u64) -> Result[AudioState,string]
    var s = audio_state()
    var kernel: u64 = 12288000
    for p in b.chip.peripherals
        if p.kind == "stm32-sai"
            if s.sai_present then return Err("one STM32 SAI instance is currently supported")
            if clock_hz == 0 then return Err("stm32-sai requires mcu.clock-hz")
            if !p.irqs.is_empty() then s.irq_routes[0] = int(p.irqs.at(0).n)
            s.sai_present = true
            s.sai_at = u32(p.at.unwrap().n)
            for q in p.params
                q.value match
                    Whole(n) ->
                        if q.name == "kernel-clock-hz" then kernel = u64(n)
                        elif q.name == "request-a" then s.requests[0] = u32(n)
                        elif q.name == "request-b" then s.requests[1] = u32(n)
                    _ -> ()
        elif p.kind == "stm32-dma"
            var index: usize = 0
            param_named(p.params,"controller") match
                Some(q) -> q.value match
                    Whole(n) -> index = usize(n - 1)
                    _ -> ()
                None -> ()
            s.dma_present[index] = true
            for k in 0..<p.irqs.len() do s.irq_routes[1 + index * 8 + k] = int(p.irqs.at(k).n)
        elif p.kind == "stm32-dmamux" then s.mux_present = true
    if s.requests[0] == s.requests[1] then return Err("SAI A and B need distinct DMA request IDs")
    s.live = Mutex.new(audio_live(if clock_hz == 0 then 480000000 else clock_hz,kernel,s.sai_present))
    Ok(s)

private[virt] boot_sai_dma()
    val d = &machine.devices.audio
    d.live.with(s ->
        for i in 0..<2
            sai.reset(s.blocks[i])
            dma.reset(s.units[i])
        dma.reset_mux(s.mux)
        s.core = 0
        s.frame_number = [0,0]
        s.debug_input = [false,false]
        for i in 0..<2
            s.output[i].clear()
            s.input[i].clear())
    atomic_store(&d.next,NEVER,Release)
    atomic_store(&d.irq_levels,0,Release)

// These debug/codec-facing queues never advance guest time or take UI locks.
sai_feed_input(block: usize, words: []const u32)
    require block < 2, "SAI block index"
    machine.devices.audio.live.with(s ->
        s.debug_input[block] = true
        for word in words do s.input[block].overwrite(word))

sai_take_output(block: usize) -> Buf[u32]
    var words: Buf[u32] = buf()
    for packet in sai_take_packets(block) do words.push(packet.word)
    words

private[virt] sai_take_packets(block: usize) -> Buf[SaiPacket]
    require block < 2, "SAI block index"
    var packets: Buf[SaiPacket] = buf()
    val into = &packets
    machine.devices.audio.live.with(s ->
        for packet in s.output[block] do into.push(packet)
        s.output[block].clear())
    packets

private input_word(s: *AudioLive, block: usize) -> u32 = s.input[block].pop_front().unwrap_or(0)

private output_word(s: *AudioLive, block: usize, slot: u32, word: u32)
    if slot == 0 then s.frame_number[block] += 1
    val b = s.blocks[block]
    val bits = sai.sample_bits(b)
    val count = sai.slots(b)
    val gain = codec_slot_gain(block,slot,count,bits)
    s.output[block].overwrite(SaiPacket(s.frame_number[block],word,slot,count,bits,gain))

private data_block(address: u32) -> int
    val d = &machine.devices.audio
    if !d.sai_present then return -1
    if address == d.sai_at + 0x20 then 0 elif address == d.sai_at + 0x40 then 1 else -1

private audio_bus_read(s: *AudioLive, address: u32, width: u32) -> Option[u32]
    val block = data_block(address)
    if block >= 0 then return sai.read(s.blocks[block],sai.DR)
    val page = memory.page_for(audio_cpu(s),address,width)
    if page == 0 then None else Some(memory.host_read(page,address,width))

private audio_bus_write(s: *AudioLive, address: u32, width: u32, value: u32) -> bool
    val block = data_block(address)
    if block >= 0 then return sai.write(s.blocks[block],sai.DR,value)
    memory.device_store(audio_cpu(s),address,width,value)

private service_audio_dma(s: *AudioLive)
    val d = &machine.devices.audio
    if !d.mux_present || !d.sai_present then return
    val read_bus: dma.BusRead = (address,width) -> audio_bus_read(s,address,width)
    val write_bus: dma.BusWrite = (address,width,value) -> audio_bus_write(s,address,width,value)
    for unit in 0usize..<2
        if !d.dma_present[unit] then continue
        for stream in 0usize..<8
            for block in 0usize..<2
                if !dma.routed(s.mux,unit * 8 + stream,d.requests[block]) then continue
                // Bounded even for a misconfigured circular PAR which does not
                // service the selected FIFO. No bus callbacks recurse into MMIO.
                for beat in 0..<8
                    if !sai.dma_request(s.blocks[block]) then break
                    if !dma.request(s.units[unit],stream,read_bus,write_bus) then break

private input_slot(s: *AudioLive, block: usize, slot: u32) -> u32
    val b = s.blocks[block]
    val source = if s.debug_input[block] then None else codec_input_word(block,slot,sai.slots(b),sai.sample_bits(b))
    source match
        Some(word) -> word
        None -> if (b.slotr >> 16) & (1u32 << slot) != 0 then input_word(s,block) else 0

private audio_slot(s: *AudioLive, block: usize, slot: u32, word: u32, time: u64) -> u32
    val b = s.blocks[block]
    var input: u32 = 0
    if sai.receiving(b)
        input = input_slot(s,block,slot)
    else output_word(s,block,slot,word)
    val peer = 1 - block
    val other = s.blocks[peer]
    if sai.enabled(other) && (other.cr1 >> 10) & 3 == 1
        other.time = time
        val sample = if sai.receiving(other) then input_slot(s,peer,other.slot) else 0
        val peer_slot = other.slot
        val output = sai.clock_slot(other,sample)
        if !sai.receiving(other) then output_word(s,peer,peer_slot,output)
    // RX data for the autonomous block is committed by sai.advance after this
    // callback. Its DMA is serviced immediately afterwards by bring_audio.
    input

private publish_audio(s: *AudioLive)
    val d = &machine.devices.audio
    val due = if s.blocks[0].due < s.blocks[1].due then s.blocks[0].due else s.blocks[1].due
    atomic_store(&d.next,if d.sai_present then due else NEVER,Release)
    var levels: u32 = if d.sai_present && (sai.irq(s.blocks[0]) || sai.irq(s.blocks[1])) then 1 else 0
    for unit in 0usize..<2
        if !d.dma_present[unit] then continue
        for stream in 0usize..<8
            if dma.irq(s.units[unit],stream) then levels |= 1u32 << u32(1 + unit * 8 + stream)
    val rising = levels & ~atomic_swap(&d.irq_levels,levels,AcqRel)
    for k in 0usize..<17
        if rising & (1u32 << u32(k)) == 0 || d.irq_routes[k] < 0 then continue
        val irq = u32(d.irq_routes[k])
        val own = audio_cpu(s)
        memory.raise(own,irq)
        memory.cut(own)
        if scheduler.launched then memory.poke(if s.core == 0 then core1() else core0(),irq)

private bring_audio(s: *AudioLive, c: *Cpu, time: u64)
    s.core = c.core
    service_audio_dma(s)
    val endpoint_a: sai.Endpoint = (slot,word,at) -> audio_slot(s,0,slot,word,at)
    val endpoint_b: sai.Endpoint = (slot,word,at) -> audio_slot(s,1,slot,word,at)
    loop
        val first = s.blocks[0].due
        val second = s.blocks[1].due
        val due = if first < second then first else second
        if due == NEVER || due > time then break
        // Interleave DMA between slots even when a caller advances a large
        // interval, so batching cannot create artificial FIFO underruns.
        if first <= second then sai.advance(s.blocks[0],due,endpoint_a)
        else sai.advance(s.blocks[1],due,endpoint_b)
        service_audio_dma(s)
    for b in s.blocks
        if time > b.time then b.time = time
    publish_audio(s)

private[virt] sai_dma_due() -> u64 = atomic_load(&machine.devices.audio.next,Acquire)

private audio_raise_levels(c: *Cpu)
    val d = &machine.devices.audio
    val levels = atomic_load(&d.irq_levels,Acquire)
    if levels == 0 then return
    for k in 0usize..<17
        if levels & (1u32 << u32(k)) == 0 || d.irq_routes[k] < 0 then continue
        val irq = u32(d.irq_routes[k])
        if !memory.exception_active(c,memory.IRQ0 + irq) then memory.raise(c,irq)

private[virt] signal_sai_dma(c: *Cpu)
    val due = sai_dma_due()
    val time = board_time(c,c.retired)
    if machine.devices.audio.sai_present && due != NEVER && time >= due
        machine.devices.audio.live.with(s -> bring_audio(s,c,time))
    audio_raise_levels(c)

private[virt] sai_dma_wake(c: *Cpu) -> u64
    val d = &machine.devices.audio
    val levels = atomic_load(&d.irq_levels,Acquire)
    if levels != 0
        for k in 0usize..<17
            if levels & (1u32 << u32(k)) != 0 && d.irq_routes[k] >= 0 && memory.could_wake(c,memory.IRQ0 + u32(d.irq_routes[k])) then return board_time(c,c.retired)
    sai_dma_due()

private valid_audio_access(device: Device, offset: u32, width: u32) -> bool
    if device == Device.Sai && (offset == 0x20 || offset == 0x40) then return width == 1 || width == 2 || width == 4
    width == 4 && offset & 3 == 0

private audio_register_read(s: *AudioLive, device: Device, offset: u32) -> Option[u32] = device match
    Dma1 -> dma.read(s.units[0],offset)
    Dma2 -> dma.read(s.units[1],offset)
    Dmamux -> dma.read_mux(s.mux,offset)
    Sai ->
        if offset == 0 || offset == 0x44 || offset == 0x48 then Some(0)
        elif offset >= 4 && offset <= 0x40 then sai.read(s.blocks[if offset < 0x24 then 0 else 1],(offset - 4) % 32)
        else None
    _ -> None

private audio_register_write(s: *AudioLive, device: Device, offset: u32, value: u32) -> bool = device match
    Dma1 -> dma.write(s.units[0],offset,value)
    Dma2 -> dma.write(s.units[1],offset,value)
    Dmamux -> dma.write_mux(s.mux,offset,value)
    Sai ->
        if offset == 0 || offset == 0x44 || offset == 0x48 then value == 0
        elif offset >= 4 && offset <= 0x40
            val index: usize = if offset < 0x24 then 0 else 1
            val reg = (offset - 4) % 32
            val b = s.blocks[index]
            // Internal synchronous blocks must use the driving block's frame.
            if reg == 0 && value & sai.ENABLE != 0 && (value >> 10) & 3 == 1
                val peer = s.blocks[1 - index]
                if b.frcr != peer.frcr || sai.slots(b) != sai.slots(peer) then return false
            sai.write(b,reg,value)
        else false
    _ -> false

private[virt] sai_dma_read(c: *Cpu, device: Device, address: u32, offset: u32, width: u32, n: u64) -> u32
    if !valid_audio_access(device,offset,width)
        halt(c,Stop.Fault,address)
        return 0
    val result = machine.devices.audio.live.with(s ->
        bring_audio(s,c,board_time(c,n))
        val result = audio_register_read(s,device,offset)
        // Reading RX DR may release space; always publish the resulting request state.
        service_audio_dma(s)
        publish_audio(s)
        result)
    result match
        Some(value) -> if width == 4 then value else value & ((1u32 << (width * 8)) - 1)
        None ->
            halt(c,Stop.Unmapped,address)
            0

private[virt] sai_dma_write(c: *Cpu, device: Device, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if !valid_audio_access(device,offset,width)
        halt(c,Stop.Fault,address)
        return
    machine.devices.audio.live.with(s ->
        bring_audio(s,c,board_time(c,n))
        val word = if width == 4 then value else value & ((1u32 << (width * 8)) - 1)
        if !audio_register_write(s,device,offset,word) then halt(c,Stop.Fault,address)
        service_audio_dma(s)
        publish_audio(s))
    val due = sai_dma_due()
    if due != NEVER then lower_limit(c,retirement_limit(c,due))
