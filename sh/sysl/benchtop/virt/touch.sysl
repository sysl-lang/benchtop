module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, part_model, part_whole}
import sh.sysl.benchtop.parts.gt911 as gt
import sh.sysl.benchtop.parts.ft6x06 as ft
import sh.sysl.benchtop.peripheral.i2c as i2c
import sysl.buf.{Buf, buf}

struct TouchBinding
    name: string
    model: gt.Touch

struct FocalBinding
    name: string
    model: ft.Touch

// The `i`th GT911 and FT6x06 on the bus.
private goodix_at(parts: *I2cParts, i: usize) -> *gt.Touch = &parts.touches[i].model
private focal_at(parts: *I2cParts, i: usize) -> *ft.Touch = &parts.focals[i].model

// The touch controllers `b` puts on the I2C bus `s`, beside the `devices` already there.
private[virt] check_touches(b: Board, s: *I2cState, devices: *Buf[I2cDevice]) -> Result[unit, string]
    for p in b.parts
        if part_model(p) == "ft6x06"
            val address = u8(part_whole(p,"address",0x2a))
            for device in *devices do if device.address == address then return Err("two I2C parts share the same address")
            val i = s.parts.focals.len()
            s.parts.focals.push(FocalBinding(p.name,ft.touch(int(part_whole(p,"width",800)),int(part_whole(p,"height",480)))))
            devices.push(i2c.Device(address,(parts,reading,time) -> ft.start(focal_at(parts,i),reading),
                (parts,byte,time) -> ft.write(focal_at(parts,i),byte),(parts,time) -> ft.read(focal_at(parts,i))))
            continue
        if part_model(p) != "gt911" then continue
        val address = u8(part_whole(p, "address", 93))
        if address != 0x5D && address != 0x14 then return Err("GT911 address must be 0x5d or 0x14")
        for device in *devices do if device.address == address then return Err("two I2C parts share the same address")
        for wire in p.wires
            if wire.port == "int" || wire.port == "reset" then return Err("GT911 currently supports polling with INT and RESET omitted")
        val i = s.parts.touches.len()
        s.parts.touches.push(TouchBinding(p.name, gt.touch(int(part_whole(p, "width", 240)), int(part_whole(p, "height", 240)))))
        devices.push(i2c.Device(address, (parts, reading, time) -> gt.start(goodix_at(parts, i), reading),
            (parts, byte, time) -> gt.write(goodix_at(parts, i), byte), (parts, time) -> gt.read(goodix_at(parts, i))))
    Ok(())

/** Host pointer reports enter the part; firmware must read and acknowledge them over I2C. */
touch_point(m: *Machine, name: string, x: int, y: int, down: bool)
    m.devices.i2c.live.with(s ->
        for i in 0..<s.parts.focals.len()
            if s.parts.focals[i].name == name then ft.point(focal_at(&s.parts,i),x,y,down)
        for i in 0..<s.parts.touches.len()
            if s.parts.touches[i].name == name then gt.point(goodix_at(&s.parts,i), x, y, down))

release_touches(m: *Machine)
    m.devices.i2c.live.with(s ->
        for i in 0..<s.parts.focals.len()
            val t = focal_at(&s.parts,i)
            ft.point(t,t.contacts[0].x,t.contacts[0].y,false)
        for i in 0..<s.parts.touches.len()
            val t = goodix_at(&s.parts,i)
            gt.point(t, t.physical.x, t.physical.y, false))

private[virt] boot_touches(parts: *I2cParts)
    for i in 0..<parts.focals.len()
        val t = focal_at(parts,i)
        t.pointer = 0
        t.addressing = true
        for k in 0..<2 do ft.point(t,0,0,false,k)
    for i in 0..<parts.touches.len() do gt.boot(goodix_at(parts,i))

/** Active GT911 configuration may change resolution through its real register interface. */
touch_dimensions(m: *Machine, name: string) -> Option[(int, int)]
    m.devices.i2c.live.with(s ->
        var found: Option[(int, int)] = None
        for b in s.parts.focals
            if b.name == name then found = Some((b.model.width,b.model.height))
        if found.is_none()
            for b in s.parts.touches
                if b.name == name then found = Some((b.model.width, b.model.height))
        found)
