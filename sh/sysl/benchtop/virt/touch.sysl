module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, part_model, part_whole}
import sh.sysl.benchtop.parts.gt911 as gt
import sh.sysl.benchtop.parts.ft6x06 as ft
import sh.sysl.benchtop.peripheral.i2c as i2c
import sysl.buf.{Buf, buf}

struct TouchBinding
    name: string
    model: &gt.Touch

struct FocalBinding
    name: string
    model: &ft.Touch

// The touch controllers `b` puts on the I2C bus `s`, beside the `devices` already there.
private[virt] check_touches(b: Board, s: *I2cState, devices: *Buf[i2c.Device]) -> Result[unit, string]
    for p in b.parts
        if part_model(p) == "ft6x06"
            val address = u8(part_whole(p,"address",0x2a))
            for device in *devices do if device.address == address then return Err("two I2C parts share the same address")
            val model = ft.touch(int(part_whole(p,"width",800)),int(part_whole(p,"height",480)))
            s.focals.push(FocalBinding(p.name,model))
            devices.push(i2c.Device(address,(reading,time) -> ft.start(model,reading),
                (byte,time) -> ft.write(model,byte),time -> ft.read(model)))
            continue
        if part_model(p) != "gt911" then continue
        val address = u8(part_whole(p, "address", 93))
        if address != 0x5D && address != 0x14 then return Err("GT911 address must be 0x5d or 0x14")
        for device in *devices do if device.address == address then return Err("two I2C parts share the same address")
        for wire in p.wires
            if wire.port == "int" || wire.port == "reset" then return Err("GT911 currently supports polling with INT and RESET omitted")
        val model = gt.touch(int(part_whole(p, "width", 240)), int(part_whole(p, "height", 240)))
        s.touches.push(TouchBinding(p.name, model))
        devices.push(i2c.Device(address, (reading, time) -> gt.start(model, reading),
            (byte, time) -> gt.write(model, byte), time -> gt.read(model)))
    Ok(())

/** Host pointer reports enter the part; firmware must read and acknowledge them over I2C. */
touch_point(name: string, x: int, y: int, down: bool)
    rtc_lock.lock()
    defer rtc_lock.unlock()
    val s = &machine.devices.i2c
    for b in s.focals
        if b.name == name then ft.point(b.model,x,y,down)
    for b in s.touches
        if b.name == name then gt.point(b.model, x, y, down)

release_touches()
    rtc_lock.lock()
    defer rtc_lock.unlock()
    val s = &machine.devices.i2c
    for b in s.focals do ft.point(b.model,b.model.contacts[0].x,b.model.contacts[0].y,false)
    for b in s.touches do gt.point(b.model, b.model.physical.x, b.model.physical.y, false)

private[virt] boot_touches()
    val s = &machine.devices.i2c
    for b in s.focals
        b.model.pointer = 0
        b.model.addressing = true
        for i in 0..<2 do ft.point(b.model,0,0,false,i)
    for b in s.touches
        b.model.pointer = 0
        b.model.address_bytes = 0
        b.model.first = 0
        b.model.count = 0
        b.model.physical = gt.Contact(false, 0, 0)

/** Active GT911 configuration may change resolution through its real register interface. */
touch_dimensions(name: string) -> Option[(int, int)]
    rtc_lock.lock()
    defer rtc_lock.unlock()
    val s = &machine.devices.i2c
    for b in s.focals
        if b.name == name then return Some((b.model.width,b.model.height))
    for b in s.touches
        if b.name == name then return Some((b.model.width, b.model.height))
    None
