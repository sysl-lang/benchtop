module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{Cpu, Kind, Stop}
import sysl.raw.str_cast

// These guests are built for ARMv7-M without DSP, then run on both scheduling modes.
val crunch_m4 = embed("../../../../examples/virt/crunch-m4.elf")
val dual_m4 = embed("../../../../examples/virt/dual-m4.elf")
val exclusive_m4 = embed("../../../../examples/virt/exclusive-m4.elf")

@test("virt4 runs compiled integer firmware on M4 cores in turns and on threads")
m4_guests()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    for parallel in [false, true]
        var stopped = run_on(m,"virt4", crunch_m4, parallel)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, "crunch exits")
        assert(str_cast(output(m).view()) == str_cast(crunch_host), "crunch matches the host")
        assert(cpu.kind == Kind.V7em && core1(m).kind == Kind.V7em, "both M4s")
        stopped = run_on(m,"virt4", dual_m4, parallel)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, "dual-core launch and FIFOs")
        stopped = run_on(m,"virt4", exclusive_m4, parallel)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, "shared exclusives")
