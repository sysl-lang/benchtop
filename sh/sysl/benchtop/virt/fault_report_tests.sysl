module sh.sysl.benchtop.virt
@tests

// The exit report's `fault` object (exit_report.sysl, v6m/explain.sysl), read back as JSON: the count,
// the fault explained with its registers where they are valid, the frame, the symbols, the backtrace,
// the ring and the first fault; an M0+'s without the registers it lacks; none where nothing faulted.

import sh.sysl.benchtop.v6m.{Cause, Cpu, FaultCapture, FaultSummary, ImageSymbol, Kind, Via, fault_of}
import sh.sysl.json as json
import sh.sysl.json.Json
import sh.sysl.parsing.source_of
import sysl.buf.{Buf, buf}

private parsed(text: string) -> Json = json.parse(source_of("report.json", text)) match
    Ok(j) -> j
    Err(_) -> panic(s"not JSON:\n$text")

private text_of(j: Json, key: string) -> string = j.get(key).unwrap().as_str().unwrap()

// A MemManage DACCVIOL a Non-secure task on PSP took at 0x10000234, LR 0x10000101.
private mem_manage(c: *FaultCapture)
    c.taken = true
    c.exception = 4
    c.cause = Cause.Registers
    c.ns = true
    c.cfsr = 0x82
    c.mmfar = 0x20001000
    c.frame = [1, 2, 3, 4, 12, 0x10000101, 0x10000234, 0x01000000]
    c.exc_return = 0xFFFFFFBC
    c.sp = 0x20003FE0
    c.psp = true
    c.stacked = true
    c.cycles = 99
    c.trace[0] = 0x10000234
    c.via[0] = Via.Frame
    c.trace[1] = 0x10000100
    c.via[1] = Via.Lr
    c.trace[2] = 0x10000300
    c.via[2] = Via.Scan
    c.trace_len = 3
    c.ring[0] = 0x10000230
    c.ring[1] = 0x10000234
    c.ring_len = 2

@test("exit report: the fault object reads back — count, ended, the exception and its reasons, the registers that are valid, the frame, PC and LR by symbol, the backtrace with how each entry was found, the ring, and the first")
fault_report_json()
    var cpu: Cpu
    cpu.kind = Kind.V8mMain
    cpu.security = true
    var c: FaultCapture
    mem_manage(&c)
    val last = fault_of(&c, &cpu, 1)
    c.cycles = 10
    c.mmfar = 0x20000000
    c.ring_len = 0
    val first = fault_of(&c, &cpu, 0)
    var r = exit_report(ExitKind.Timeout, 124, "timed out")
    r.fault = FaultSummary(3, Some(last), Some(first), true)
    var syms: Buf[ImageSymbol] = buf()
    syms.push(ImageSymbol(0x10000200, 0x40, "task", 0x10001000))
    syms.push(ImageSymbol(0x10000100, 0x20, "start", 0x10001000))
    val text = exit_report_json(&r, syms.view())
    val f = parsed(text).get("fault").unwrap()
    assert(f.get("count").unwrap().as_int() == Some(3) && f.get("ended").unwrap().as_bool() == Some(true) && f.get("core").unwrap().as_int() == Some(1), text)
    assert(text_of(f, "exception") == "MemManage" && f.get("taken").unwrap().as_bool() == Some(true) && f.get("lockup").unwrap().as_bool() == Some(false), text)
    assert(text_of(f, "state") == "non_secure", text)
    val reasons = f.get("reasons").unwrap()
    assert(reasons.len() == 1 && reasons.at(0).unwrap().as_str() == Some("MemManage: DACCVIOL (data access violation at MMFAR 0x20001000)"), text)
    assert(text_of(f, "cfsr") == "0x00000082" && text_of(f, "hfsr") == "0x00000000" && text_of(f, "mmfar") == "0x20001000", text)
    assert(!f.has("bfar") && !f.has("sfar") && text_of(f, "sfsr") == "0x00000000", "BFAR and SFAR not valid: left out")
    val frame = f.get("frame").unwrap()
    assert(text_of(frame, "r0") == "0x00000001" && text_of(frame, "r12") == "0x0000000c" && text_of(frame, "lr") == "0x10000101", text)
    assert(text_of(frame, "pc") == "0x10000234" && text_of(frame, "xpsr") == "0x01000000" && text_of(frame, "exc_return") == "0xffffffbc", text)
    assert(text_of(frame, "sp") == "0x20003fe0" && text_of(frame, "stack") == "psp" && frame.get("stacked").unwrap().as_bool() == Some(true), text)
    assert(text_of(f, "pc_symbol") == "task+0x34" && text_of(f, "lr_symbol") == "start", text)
    val trace = f.get("backtrace").unwrap()
    assert(trace.len() == 3 && text_of(trace.at(0).unwrap(), "how") == "frame" && text_of(trace.at(1).unwrap(), "how") == "lr", text)
    assert(text_of(trace.at(2).unwrap(), "how") == "scan" && text_of(trace.at(2).unwrap(), "pc") == "0x10000300" && !trace.at(2).unwrap().has("symbol"), text)
    assert(text_of(trace.at(1).unwrap(), "symbol") == "start", text)
    val ring = f.get("ring").unwrap()
    assert(ring.len() == 2 && text_of(ring.at(0).unwrap(), "pc") == "0x10000230" && text_of(ring.at(1).unwrap(), "symbol") == "task+0x34", text)
    assert(f.get("cycles").unwrap().as_int() == Some(99), text)
    val earliest = f.get("first").unwrap()
    assert(earliest.get("core").unwrap().as_int() == Some(0) && text_of(earliest, "mmfar") == "0x20000000" && !earliest.has("ring") && !earliest.has("first"), text)

@test("exit report: an M0+'s fault object has no CFSR, HFSR or security state, a fault benchtop stopped on no EXC_RETURN, and one fault no first")
fault_report_baseline()
    var cpu: Cpu
    cpu.kind = Kind.V6m
    var c: FaultCapture
    c.taken = false
    c.lockup = true
    c.exception = 3
    c.cause = Cause.Svc
    c.frame[6] = 0x100
    c.trace[0] = 0x100
    c.trace_len = 1
    var r = exit_report(ExitKind.FaultLockup, 3, "locked up")
    r.fault = FaultSummary(1, Some(fault_of(&c, &cpu, 0)), Some(fault_of(&c, &cpu, 0)), true)
    val text = exit_report_json(&r, [][..])
    val f = parsed(text).get("fault").unwrap()
    assert(text_of(f, "exception") == "HardFault" && f.get("lockup").unwrap().as_bool() == Some(true) && f.get("taken").unwrap().as_bool() == Some(false), text)
    assert(f.get("reasons").unwrap().at(0).unwrap().as_str() == Some("lockup: SVC where neither SVCall nor HardFault could preempt"), text)
    assert(!f.has("cfsr") && !f.has("hfsr") && !f.has("mmfar") && !f.has("state") && !f.has("sfsr") && !f.has("pc_symbol"), text)
    val frame = f.get("frame").unwrap()
    assert(!frame.has("exc_return") && frame.get("stacked").unwrap().as_bool() == Some(false) && text_of(frame, "stack") == "msp", text)
    assert(!f.has("first") && !f.has("ring"), text)
