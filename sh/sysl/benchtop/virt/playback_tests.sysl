module sh.sysl.benchtop.virt
@tests
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sh.sysl.fat as fat
import sh.sysl.wav as wav
import sysl.raw.str_cast
import sysl.text.replace_all
import sysl.buf.{Buf,buf}

private val PLAY_GUEST = embed("../../../../examples/touch/storage-disco.elf")
private const PLAY_FRAMES: u32 = 240257

private playback_disk(frames: u32, rate: u32 = 48000, encoding: wav.Encoding = wav.Encoding.Pcm16) -> fat.RamDevice
    var disk = fat.ram_device(32768)
    fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
    var cache: [512]u8 = [0;512]
    var volume = fat.mount(&disk,cache[..]).unwrap()
    var file = volume.create("RECORD.WAV").unwrap()
    var header: [80]u8 = [0;80]
    val size = wav.header(wav.format(rate,2,encoding),u64(frames),header[..]).unwrap()
    volume.write(&file,header[..<size]).unwrap()
    var payload: [4096]u8 = [0;4096]
    var at: u32 = 0
    while at < frames
        val count = if frames - at > 1024 then 1024u32 else frames - at
        for i in 0u32..<count
            val positive = (at + i) % 48 < 24
            val left: u16 = if positive then 10000 else 0xd8f0
            val right: u16 = if positive then 0xb1e0 else 20000
            val target = usize(i) * 4
            payload[target] = u8(left)
            payload[target + 1] = u8(left >> 8)
            payload[target + 2] = u8(right)
            payload[target + 3] = u8(right >> 8)
        volume.write(&file,payload[..<usize(count) * 4]).unwrap()
        at += count
    volume.flush().unwrap()
    disk

private playback_boot(disk: fat.RamDevice, slow: bool = false)
    var description = replace_all(str_cast(embed("../../../../boards/stm32h747-sd.hocon")),"target/disco-sd.img","")
    if slow then description = replace_all(description,"kernel-clock-hz = 60000000","kernel-clock-hz = 937500")
    board_from("playback-test.hocon",description.bytes).unwrap()
    sd_seed_image(disk.image())
    boot(core0(),image_of(PLAY_GUEST).unwrap().view())
    start_workers(core0()).unwrap()
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core1()))
    take_sound(observation_time(),2)
private play_symbol(name: string) -> u32 = u32(elf.read(PLAY_GUEST).unwrap().symbol_named(name).unwrap().unwrap().value)
private play_value(name: string) -> u32 = cpu.load32(core0(),play_symbol(name))
private play_chunks(count: int, samples: *Buf[f32])
    for i in 0..<count
        submit_workers(2400000)
        wait_workers()
        for value in take_sound(observation_time(),2) do samples.push(value)
private playback_tap(samples: *Buf[f32], x: int = 474)
    touch_point("touch",x,332,true)
    play_chunks(16,samples)
    touch_point("touch",x,332,false)
    play_chunks(16,samples)

@test("Discovery playback: sustained stereo WAV from SD reaches SAI/codec sample-exactly, ends on the final frame, and supports stop/restart")
playback_firmware()
    val disk = playback_disk(PLAY_FRAMES)
    playback_boot(disk)
    defer stop_workers()
    var output: Buf[f32] = buf()
    playback_tap(&output)
    play_chunks(1100,&output)
    pause_workers()
    assert(workers_observe().running,stop_message(core1()))
    assert(play_value("play_status") == 3,s"play state=${play_value("play_status")}")
    assert(play_value("play_underruns") == 0 && play_value("play_tail") == PLAY_FRAMES)
    assert(play_value("audio_errors") == 0 && play_value("audio_deadline_misses") == 0)
    assert(play_value("audio_control") != 0)
    var first = output.len() / 2
    for i in 0..<(output.len() / 2)
        if output.at(i * 2) != 0.0
            first = i
            break
    assert(first + usize(PLAY_FRAMES) < output.len() / 2,"all declared frames must reach the host codec")
    val level = output.at(first * 2)
    assert(level > 0.001)
    for i in 0u32..<PLAY_FRAMES
        val at = (first + usize(i)) * 2
        val expected = if i % 48 < 24 then level else -level
        val error = output.at(at) - expected
        val stereo = output.at(at + 1) + 2.0 * expected
        assert(error > -0.000001 && error < 0.000001,"left sample order must be preserved")
        assert(stereo > -0.000001 && stereo < 0.000001,"right channel must retain its separate samples")
    for i in (first + usize(PLAY_FRAMES))*2..<output.len() do assert(output.at(i) == 0.0,"EOF must not replay stale ring data")
    // Playback has no write path: preserve the entire SD image.
    for i in 0..<disk.image().len do assert(disk.image()[i] == sd_image()[i])
    output = buf()
    playback_tap(&output)
    pause_workers()
    assert(play_value("play_status") == 1 && play_value("play_tail") < PLAY_FRAMES)
    playback_tap(&output,400) // Recording cannot take the shared ring while playing.
    pause_workers()
    assert(play_value("record_command") == 0 && play_value("play_status") == 1)
    playback_tap(&output)
    play_chunks(30,&output)
    pause_workers()
    assert(play_value("play_status") == 3 && play_value("play_tail") < PLAY_FRAMES)
    // Inject an SD read failure after the next playback has prefilled its ring.
    playback_tap(&output)
    pause_workers()
    storage_card.unwrap().media.read = (sector,out) -> false
    play_chunks(100,&output)
    pause_workers()
    assert(play_value("play_status") == 4)
    assert(play_value("audio_errors") == 0 && play_value("audio_deadline_misses") == 0)

@test("Discovery playback: missing, corrupt, unsupported, empty, short and exact-buffer WAV files are handled without underruns")
playback_validation()
    for kind in 0..<7
        var disk = playback_disk(if kind == 4 then 0 elif kind == 5 then 17 elif kind == 6 then 16384 else 8,
            if kind == 2 then 44100 else 48000,if kind == 3 then wav.Encoding.Float32 else wav.Encoding.Pcm16)
        if kind == 0 then fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
        if kind == 1
            var cache: [512]u8 = [0;512]
            var volume = fat.mount(&disk,cache[..]).unwrap()
            var file = volume.open("RECORD.WAV").unwrap()
            volume.write(&file,"broken".bytes).unwrap()
            volume.flush().unwrap()
        playback_boot(disk)
        var output: Buf[f32] = buf()
        playback_tap(&output)
        play_chunks(120,&output)
        pause_workers()
        val state = play_value("play_status")
        val expected: u32 = if kind == 0 then 6 elif kind < 4 then 7 else 3
        stop_workers()
        assert(state == expected,s"case $kind state=$state")
        assert(play_value("play_underruns") == 0)
        if kind >= 4 then assert(play_value("play_tail") == (if kind == 4 then 0u32 elif kind == 5 then 17 else 16384))

@test("Discovery playback: a slow SPI clock causes a reported underrun while M7 keeps audio deadlines")
playback_underrun()
    playback_boot(playback_disk(PLAY_FRAMES),true)
    defer stop_workers()
    var output: Buf[f32] = buf()
    playback_tap(&output)
    play_chunks(1400,&output)
    pause_workers()
    assert(workers_observe().running,stop_message(core1()))
    assert(play_value("play_underruns") > 0 && play_value("play_status") == 5,s"slow play state=${play_value("play_status")}")
    assert(play_value("audio_errors") == 0 && play_value("audio_deadline_misses") == 0)
