module sh.sysl.benchtop.virt

// The machine benchtop runs: two supported Cortex-M cores and bus parts that benchtop
// emulates, put there by a board description (`assemble`, in machine.sysl). `boards/virt.hocon` is
// the virtual board (and `boards/virt33.hocon` the same with M33s), a machine that exists only in
// benchtop, for running a program and talking to it with nothing between them but the core; the
// addresses and IRQs below are the ones it gives.
//
// Its RAM is the core's, 1 MB from address 0, holding the vector table, the code, the data and the
// stack. The debug console (`debug-console`) answers four registers from its base, 0x4000_0000 on
// the virtual board:
//
//     +0x0  DATA    write: the low byte goes to the host's standard output.
//                   read: the next byte typed, or 0xFFFF_FFFF when none is waiting.
//     +0x4  STATUS  bit 0: a byte is waiting. bit 1: input has ended and nothing is waiting.
//     +0x8  EXIT    write: benchtop ends, with the value as its exit status.
//     +0xC  CTRL    bit 0: the console's interrupt is enabled. Reads back.
//
// The console raises its IRQ (0 on the virtual board; none where the board gives it none) while its
// interrupt is enabled and STATUS is not 0 — a byte is waiting, or the input has ended — so a handler
// that reads until STATUS is 0, or turns CTRL off, ends it. The core's own system control space
// (SysTick, the NVIC, the SCB) is at 0xE000_E000. Every other address off the RAM and outside every
// device's window stops the core with `Stop.Unmapped`.
//
// **The interrupt is raised between runs**, which a million instructions apart is often enough for
// typing; and when the core sleeps in `WFI` with nothing in it to wake it, the board waits for the
// console, if its interrupt would. It is raised in each running core's NVIC; a core that has not
// enabled IRQ 0 is not interrupted by it.
//
// **The board has two cores**, of the kind its description names, sharing the RAM and the decoded
// records. Core 0 boots from the vector table; core 1 sleeps until core 0 launches it. Both run on the one host thread, a quantum at
// a time each, so a run is the same every time. Their shared block (`virt-sio`), a small SIO after the
// RP2040's, answers each core by which one made the access, from its base, 0xD000_0000 on the virtual
// board:
//
//     +0x000  CPUID        read: 0 on core 0, 1 on core 1.
//     +0x050  FIFO_ST      bit 0 VLD: this core's RX FIFO holds a word. bit 1 RDY: its TX FIFO has
//                          room. bit 2 WOF: it wrote to a full TX FIFO. bit 3 ROE: it read an empty
//                          RX FIFO. Writing a 1 to WOF or ROE clears it.
//     +0x054  FIFO_WR      write: push a word to the other core's RX FIFO (8 deep); when full, the
//                          word is lost and WOF is set.
//     +0x058  FIFO_RD      read: pop this core's RX FIFO; when empty, 0, and ROE is set.
//     +0x05C  SPINLOCK_ST  read: bit k set while spinlock k is claimed.
//     +0x100  SPINLOCK0-31 (every 4 bytes) read: claim the lock, answering 1 << k if it was free and
//                          0 if it was already claimed. write: release it.
//
// **The FIFO's interrupt is the SIO's IRQ** (1 on the virtual board), raised in a core's own NVIC while its VLD, WOF or ROE is set, and
// only there; like the console's, it is raised between runs. **Core 1 is launched as on the RP2040**
// (`multicore_launch_core1_raw`): until it runs, the board plays its boot ROM, echoing every word core
// 0 pushes back into core 0's RX FIFO and launching core 1 after the sequence 0, 0, 1, VTOR, SP,
// ENTRY. Zeros at its start keep the last two, and any other word out of place starts it again;
// VTOR, SP and ENTRY may be any word. Core 1 then starts at ENTRY with SP and VTOR as sent; an ENTRY
// without its Thumb bit stops core 1 at `Stop.Fault`, there. Once core 1 runs, the same words are
// only data in its FIFO.
//
// **The cores take turns.** In a round each runs until its clock — instructions retired plus the time
// skipped asleep — reaches the round's end, `quantum` (1000 by default) past the last one's, at its
// first taken branch from there; so the two clocks stay within a quantum and a straight run of code
// of each other, and what one core writes in its turn the other first sees in its next. A core asleep
// in `WFI` skips to the round's end, or wakes before it on its own SysTick or on an interrupt the other
// core raised in an earlier turn. Before core 1 is launched, core 0 runs alone a million instructions
// at a time. The board stops at `Asleep` only when every running core sleeps with nothing that can
// wake it, and it ends when any core stops: `run_board` answers that core.
//
// **The console's input is a channel**, so where it comes from is the caller's: `listen` starts a
// thread that copies the host's standard input into it a byte at a time, and a test sends its bytes
// in itself. **Its output is collected**, and goes to the host when a line ends, when the guest looks
// for input (so a prompt shows before the guest waits), when it exits, and at `flush_console` —
// unless `capture` asked to keep it, which is what a test reads.

import sh.sysl.benchtop.v6m.{configure_instruction_timing, Bus, Cpu, Kind, Stop, IRQ0, NEVER, RAM_BYTES, clear, could_wake, halt, load32, raise, reset, run_single, run_threaded, set_limit}
import sh.sysl.benchtop.v6m as memory
import sh.sysl.elf as elf
import sysl.buf.{Buf, buf, Frozen}
import sysl.math.{min, max}
import sysl.sync.*
import sysl.threads.{Channel, Mutex, channel, spawn}
import sysl.io.stdin

// The console's registers, from its base.
const DATA: u32 = 0x0
const STATUS: u32 = 0x4
const EXIT: u32 = 0x8
const CTRL: u32 = 0xC

// STATUS bits.
const WAITING: u32 = 1
const ENDED: u32 = 2

// CTRL's bit, which enables the console's interrupt.
const RX_INTERRUPT: u32 = 1

// The SIO's registers, from its base.
const CPUID: u32 = 0x00
const FIFO_ST: u32 = 0x50
const FIFO_WR: u32 = 0x54
const FIFO_RD: u32 = 0x58
const SPINLOCK_ST: u32 = 0x5C
const SPINLOCK0: u32 = 0x100
const SPINLOCK31: u32 = 0x17C

// FIFO_ST bits.
const VLD: u32 = 1
const RDY: u32 = 2
const WOF: u32 = 4
const ROE: u32 = 8

const FIFO_DEPTH: u32 = 8

/** A device on the cores' bus: what it is, the addresses it answers, `base` to `last`, and the IRQs
 * it raises, in the order its description gives them, -1 past the last.
 */
struct Mapped
    device: Device
    base: u32
    last: u32
    irqs: [8]int

enum Device
    Console
    Sio
    Resets
    Timer
    Watchdog
    PanelGpio
    Adc
    I2c
    Pwm
    DigitalAudio
    Spi
    H7Rcc
    H7Spi
    Stm32Gpio
    Sdmmc
    Dsi
    Sai
    Dma1
    Dma2
    Dmamux
end Device

val NO_IRQS: [8]int = [-1;8]

/** The cores' bus: the devices on it, at most one of each kind (`attached` of `mapped`), and the
 * IRQs the console and the SIO raise, -1 where the board has no such device or gave it no IRQ.
 * `mapped` is a plain array, which both cores' threads read at once without touching it.
 */
struct BusState
    mapped: [32]Mapped
    attached: usize
    console_irq: int
    fifo_irq: int

/** A bus with no device on it. */
bus_state() -> BusState = BusState([Mapped(Console,0,0,NO_IRQS);32], 0, -1, -1)

// The bus that puts `ds` there, at most one device of each kind.
private[virt] bus_of(ds: []const Mapped) -> BusState
    require ds.len <= 32, "a board has at most one device of each kind"

    var bus = bus_state()

    bus.attached = ds.len
    for i in 0..<ds.len
        val m = ds[i]

        bus.mapped[i] = m
        m.device match
            Console -> bus.console_irq = m.irqs[0]
            Sio -> bus.fifo_irq = m.irqs[0]
            _ -> ()
    bus

// Each CPU owns one cache line. Cache only address decoding, never register
// values or peripheral side effects. The device table is immutable while running.
private struct BusCache
    index: usize
    padding: [56]u8
private var bus_cache: [2]BusCache = [BusCache(0xffffffffffffffff,[0;56]);2]

// Forget each core's last device, for a bus that has changed.
private[virt] forget_bus_cache()
    for k in 0..<2 do bus_cache[k].index = 0xffffffffffffffff

private bus_mapping(c: *Cpu, address: u32) -> *Mapped
    val bus = &machine.devices.bus
    val k = usize(c.core)
    val cached = bus_cache[k].index
    if cached < bus.attached
        val m = &bus.mapped[cached]
        if address >= m.base && address <= m.last then return m
    for i in 0..<bus.attached
        val m = &bus.mapped[i]
        if address >= m.base && address <= m.last
            bus_cache[k].index = i
            return m
    null

/** How many devices the bus has on it. */
attached() -> usize = machine.devices.bus.attached

// The IRQ the console raises, and the one the SIO's FIFOs raise; -1 for none.
private[virt] console_irq() -> int = machine.devices.bus.console_irq
private[virt] fifo_irq() -> int = machine.devices.bus.fifo_irq

/** The debug console (`debug-console`): the guest's input, as a channel the host fills (`typed`, its
 * values held in `slots`, whose lock no thread takes), CTRL, which both cores' threads read without
 * a lock, and under `live` the rest. The input thread `listen` starts holds the channel's address, so
 * a console is reset in place (`open_console`), never replaced.
 */
struct Console
    slots: Mutex[Buf[u8]]
    typed: Channel[u8]
    ctrl: u32
    live: Mutex[ConsoleLive]

/** A byte taken from the input to answer STATUS and not yet read through DATA (-1 for none), what the
 * guest has written and not yet flushed, and whether, and how much of, it is kept for `output` instead.
 */
struct ConsoleLive
    held: int
    out: Buf[u8]
    capturing: bool
    capture_limit: usize

private console_live() -> ConsoleLive = ConsoleLive(-1, buf(), false, 0)

/** A console with no input waiting, its output going to the host, and its interrupt off. */
console() -> Console
    var slots: Buf[u8] = buf()
    for i in 0..<4096 do slots.push(0)
    val typed = channel(slots.view())
    Console(Mutex.new(slots), typed, 0, Mutex.new(console_live()))

// What the two cores are, as the board description says.
var core_instruction_timing: [2]bool = [false,false]
var core_kinds: [2]Kind = [Kind.V6m, Kind.V6m]
var core_priority_bits: [2]u32 = [2, 2]
var core_dsp: [2]bool = [false, false]
// Each core's floating-point unit: none (0), single precision (1) or double (2).
var core_fpu: [2]u32 = [0, 0]
// The boot ROM's place in the launch sequence, 0 to 5, and the VTOR and SP it has taken.
var step = 0
var sent: [2]u32
// Core k's RX FIFO, a ring that core 1 - k pushes to and core k pops from: `pushed[k]` and
// `popped[k]` count the words each side has moved, so it holds `pushed[k] - popped[k]` of them, from
// `fifo[k][popped[k] % 8]`. Each count is written by its own side alone and read by the other with
// acquire, after a release, which is what makes the ring safe with the cores on two threads: a
// single-producer single-consumer queue with no lock. `fifo_errors[k]` is core k's WOF and ROE, which
// only core k sets and clears.
var fifo: [2][8]u32
var pushed: [2]u32
var popped: [2]u32
var fifo_errors: [2]u32
// Bit k set while spinlock k is claimed; claimed and released with atomic operations.
var locks: u32 = 0

// Ready the console with an empty input, its output going to the host, and its interrupt off.
open_console()
    pause_workers()
    val c = &machine.console
    c.typed = c.slots.with(slots -> channel(slots.view()))
    c.live.with(l -> *l = console_live())
    atomic_store(&c.ctrl, 0, Relaxed)

// Keep the guest's output for `output` rather than writing it to the host.
capture()
    machine.console.live.with(l -> l.capturing = true)

/** Console tail for a long-running visual session. */
capture_bounded(limit: usize)
    machine.console.live.with(l ->
        l.capturing = true
        l.capture_limit = if limit < 128 then 128 else limit)

/** A read-only copy of everything the guest has written since `capture`. */
output() -> &sync Frozen[u8] = machine.console.live.with(l ->
    var bytes: Buf[u8] = buf()
    bytes.extend(l.out.view())
    bytes.freeze())

/** Owned copy for a UI reading concurrently with console writes. */
output_snapshot() -> Buf[u8] = machine.console.live.with(l ->
    var bytes: Buf[u8] = buf()
    bytes.extend(l.out.view())
    bytes)

/** The console's input, which `type_in` and the input thread send to. */
input() -> *Channel[u8] = &machine.console.typed

// Give the guest `bytes` to read, and then the end of its input.
type_in(bytes: []const u8)
    for b in bytes do machine.console.typed.send(b)
    machine.console.typed.close()

// The byte that ends benchtop from the keyboard, whatever the guest is doing: Ctrl-], as telnet's.
const QUIT: u8 = 0x1D

// Copy the host's standard input to the guest, from a thread of its own, until it ends. Ctrl-] is not
// passed on: it ends benchtop with status 130, as an interrupt would, the terminal put back by the
// exit hook `sysl.tty.raw` registered.
listen() -> bool = spawn(&pump, &machine.console.typed).is_some()

private pump(ch: *Channel[u8])
    var r = stdin()
    var one: [1]u8 = [0]

    loop
        val got = r.read(one[..])

        if got.len == 0 then break
        if got[0] == QUIT then exit(130)
        if !ch.send(got[0]) then break

    ch.close()

// Write out what the guest has written, unless it is being captured.
flush_console() = machine.console.live.with(l -> flush_out(l))

private flush_out(l: *ConsoleLive)
    if l.capturing || l.out.len() == 0 then return

    putbytes(l.out.view())
    flush()
    l.out.clear()

// The next byte of input if one is waiting, without taking it.
private peek(c: *Console, l: *ConsoleLive) -> int
    if l.held < 0
        c.typed.try_receive() match
            Some(b) -> l.held = int(b)
            None -> ()

    l.held

private status(c: *Console, l: *ConsoleLive) -> u32
    if peek(c, l) >= 0 then return WAITING
    if c.typed.is_closed() then return ENDED

    0

private[virt] console_status() -> u32
    val c = &machine.console
    c.live.with(l -> status(c, l))

// The console's half of an access to address `a`, register `o` from its base.
private console_read(cpu: *Cpu, a: u32, o: u32) -> u32
    val c = &machine.console
    if o == CTRL then return console_ctrl()
    if o != DATA && o != STATUS
        halt(cpu, Stop.Unmapped, a)
        return 0
    c.live.with(l ->
        flush_out(l)
        if o == STATUS then status(c, l) else take(c, l))

// DATA: the byte waiting, taken, or all ones where none is.
private take(c: *Console, l: *ConsoleLive) -> u32
    val b = peek(c, l)
    l.held = -1
    if b < 0 then 0xFFFFFFFF else u32(b)

private console_write(cpu: *Cpu, a: u32, o: u32, x: u32)
    o match
        DATA -> machine.console.live.with(l -> put(l, u8(x & 0xFF)))
        EXIT ->
            cpu.exit_code = x
            halt(cpu, Stop.Exit, a)
        CTRL -> atomic_store(&machine.console.ctrl, x & RX_INTERRUPT, Relaxed)
        _ -> halt(cpu, Stop.Unmapped, a)

// The guest writes `b`: kept, and written out at a newline or when 4 KB have gathered, or, where the
// output is captured with a limit, the oldest half let go once it reaches the limit.
private put(l: *ConsoleLive, b: u8)
    if l.capturing && l.capture_limit != 0 && l.out.len() >= l.capture_limit
        var tail: Buf[u8] = buf()
        tail.extend(l.out.view()[(l.out.len() - l.capture_limit / 2)..])
        l.out = tail
    l.out.push(b)
    if b == 10 || l.out.len() >= 4096 then flush_out(l)

@inline
private[virt] console_ctrl() -> u32 = atomic_load(&machine.console.ctrl, Relaxed)

// Whether the console raises its interrupt now: it is enabled and STATUS is not 0.
private[virt] console_raising() -> bool
    if console_irq() < 0 || console_ctrl() & RX_INTERRUPT == 0 then return false

    console_status() != 0

// The board's RAM as `file` fills it: an ELF file's segments at their load addresses, or, for a file
// that is not ELF, its bytes from address 0.
image_of(file: []const u8) -> Result[Buf[u8], string]
    val map = machine.map
    var image: Buf[u8] = buf()

    for i in 0..<RAM_BYTES do image.push(0)
    for i in 0..<map.flash_size do image.push(255)

    elf.read(file) match
        Ok(e) ->
            var regions: Buf[elf.Region] = buf()
            regions.push(elf.Region(u64(map.ram_at), image.view()[..<usize(map.ram_size)]))
            for bank in map.banks do regions.push(elf.Region(u64(bank.base),image.view()[usize(bank.offset)..<usize(bank.offset + bank.size)]))
            if map.flash_size != 0 then regions.push(elf.Region(u64(map.flash_at), image.view()[usize(RAM_BYTES)..]))

            elf.load(e, regions.view()) match
                Ok(_) -> ()
                Err(why) -> return Err(s"$why")
        Err(elf.ElfError.NotElf) ->
            val capacity = if map.flash_size == 0 then map.ram_size else map.flash_size
            val offset = if map.flash_size == 0 then 0u32 else RAM_BYTES
            if file.len > usize(capacity) then return Err(if map.flash_size == 0 then "larger than the board's 1 MB of RAM" else "larger than the board's flash")
            for i in 0..<file.len do image.set(usize(offset) + i, file[i])
        Err(why) -> return Err(s"$why")

    Ok(image)

// A virtual board with `image` loaded at 0, both cores of the kind the board names, core 0 reset as
// every M-profile core resets — SP from the vector table's first word, PC from its second — and core
// 1 waiting in its boot ROM, with the SIO's FIFOs empty, every spinlock free, and the default
// quantum.
boot(cpu: *Cpu, image: []const u8)
    pause_workers()
    cpu.kind = core_kinds[0]
    memory.reset_mapped(cpu, machine.memory, image, machine.map)
    configure_instruction_timing(cpu,core_instruction_timing[0])
    cpu.priority_bits = core_priority_bits[0]
    cpu.dsp = core_dsp[0]
    cpu.fpu = core_fpu[0]
    cpu.bus = &machine
    cpu.vtor = if machine.map.flash_size == 0 then machine.map.ram_at else machine.map.flash_at
    cpu.r[13] = load32(cpu, cpu.vtor)
    cpu.pc = load32(cpu, cpu.vtor + 4) & ~1

    val second = core1()
    second.kind = core_kinds[1]
    second.core = 1
    memory.attach_memory(second, machine.memory)
    clear(second, 0)
    configure_instruction_timing(second,core_instruction_timing[1])
    second.priority_bits = core_priority_bits[1]
    second.dsp = core_dsp[1]
    second.fpu = core_fpu[1]
    step = 0

    for k in 0..<2
        pushed[k] = 0
        popped[k] = 0
        fifo_errors[k] = 0

    locks = 0
    reset_scheduler()
    boot_sai_dma()
    boot_dsi()
    boot_h7()
    boot_rp()
    boot_spi()
    boot_storage()
    boot_sdmmc()
    boot_panel()
    boot_adc()
    boot_i2c()
    boot_sound()
    boot_digital_audio()
    rebase_workers()

// Start core 1 at `entry` with `sp` and `vtor`, as the boot ROM does at the end of the launch
// sequence. An entry without its Thumb bit stops core 1 at `Stop.Fault`, there.
launch(vtor: u32, sp: u32, entry: u32)
    val second = core1()
    memory.attach_memory(second, machine.memory)
    clear(second, entry & ~1)
    configure_instruction_timing(second,core_instruction_timing[1])
    second.priority_bits = core_priority_bits[1]
    second.dsp = core_dsp[1]
    second.fpu = core_fpu[1]
    second.bus = &machine
    second.vtor = vtor
    second.r[13] = sp
    if cpu_models_differ()
        memory.pair(core0(),second)
        scheduler.paired = true
    scheduler.launched = true
    scheduler.starting = true

    if entry & 1 == 0
        second.pc = entry
        halt(second, Stop.Fault, entry)

private[virt] device_due() -> u64 = min(sdmmc_due(), min(min(min(min(timer_due(), adc_due()), spi_due()),dsi_due()),sai_dma_due()))
private[virt] device_wake(cpu: *Cpu) -> u64 = min(sdmmc_wake(cpu), min(min(min(min(timer_wake(cpu), adc_wake(cpu)), spi_wake(cpu)),dsi_due()),sai_dma_wake(cpu)))

// A byte of input the board waited for, kept to answer STATUS and DATA; nothing where the input ended.
private[virt] hold_input(got: Option[u8])
    got match
        Some(b) -> machine.console.live.with(l -> l.held = int(b))
        None -> ()

// What `benchtop run` says when the board's core has stopped: why, and for a stop the guest did not
// ask for, where the core stopped and after how many instructions.
stop_message(cpu: *Cpu) -> string = cpu.stop match
    Budget -> "the guest is still running"
    Exit -> s"the guest exited with ${cpu.exit_code}"
    Breakpoint -> f"breakpoint at 0x${cpu.stop_at}%08x"
    Reset -> "the guest asked for a system reset"
    Undefined -> stopped(cpu, f"an undefined instruction at 0x${cpu.stop_at}%08x")
    Unmapped -> stopped(cpu, f"an access to 0x${cpu.stop_at}%08x, where nothing is")
    Asleep -> stopped(cpu, f"a WFI nothing can wake, before 0x${cpu.stop_at}%08x")
    Fault -> stopped(cpu, f"a fault it cannot take, at 0x${cpu.stop_at}%08x")
    StackLimit -> stopped(cpu, f"a stack-limit violation (a UsageFault benchtop does not take), at 0x${cpu.stop_at}%08x")

private stopped(cpu: *Cpu, why: string) -> string
    val core = if cpu == core1() then "core 1, " else ""

    f"the guest stopped at $why (${core}pc 0x${cpu.pc}%08x, ${cpu.retired} instructions)"

// Raise a core's interrupts: the console's while it is enabled and STATUS is not 0, the FIFO's while
// the core's VLD, WOF or ROE is set, and the timer's alarms' while they are raised at its clock.
private[virt] signal(cpu: *Cpu)
    if console_raising() then raise(cpu, u32(console_irq()))

    val k = core_of(cpu)

    if fifo_irq() >= 0 && (waiting_in(k) > 0 || fifo_errors[k] != 0) then raise(cpu, u32(fifo_irq()))
    signal_rp(cpu)
    signal_sai_dma(cpu)
    signal_dsi(cpu)
    signal_spi(cpu)
    signal_sdmmc(cpu)
    signal_panel(cpu)
    signal_adc(cpu)
    signal_rtcs(cpu)

// ---------------------------------------------------------------------------------------------------
// The SIO.

// The core that made an access: 1 for core 1, 0 for core 0.
private core_of(cpu: *Cpu) -> int = if cpu == core1() then 1 else 0

// Each core's bus is the machine it is part of.
impl Bus for Machine
    read(*self, cpu: *Cpu, a: u32, width: u32, n: u64) -> u32 = board_read(cpu, a, width, n)
    write(*self, cpu: *Cpu, a: u32, width: u32, x: u32, n: u64) = board_write(cpu, a, width, x, n)

// The board's half of an access off the RAM, which the core makes through its bus: the device
// whose window holds the address answers it, with the register's offset from its base. An address
// in no window stops the core at `Unmapped`. The RAM's own accesses never come here.
board_read(cpu: *Cpu, a: u32, width: u32, n: u64) -> u32
    val m = bus_mapping(cpu,a)
    if m != null
        return m.device match
            Sai | Dma1 | Dma2 | Dmamux -> sai_dma_read(cpu,m.device,a,a - m.base,width,n)
            Dsi -> dsi_read(cpu,a,a - m.base,width,n)
            Sdmmc -> sdmmc_read(cpu,a,a - m.base,width,n)
            H7Spi | Stm32Gpio -> storage_read(cpu,m.device,a,a - m.base,width,n)
            H7Rcc -> h7_rcc_read(cpu,a,a - m.base,width)
            Console -> console_read(cpu, a, a - m.base)
            DigitalAudio -> digital_read(cpu, a, a - m.base, width, n)
            Pwm -> pwm_read(cpu, a, a - m.base, width, n)
            Spi -> spi_read(cpu, a, a - m.base, width, n)
            I2c -> i2c_read(cpu, a, a - m.base, width, n)
            Adc -> adc_read(cpu, a, a - m.base, width, n)
            PanelGpio -> panel_read(cpu, a, a - m.base, width, n)
            Sio -> sio_read(cpu, a, a - m.base)
            d -> rp_read(cpu, d, a, a - m.base, width, n)

    halt(cpu, Stop.Unmapped, a)
    0

board_write(cpu: *Cpu, a: u32, width: u32, x: u32, n: u64)
    val m = bus_mapping(cpu,a)
    if m != null
        m.device match
            Sai | Dma1 | Dma2 | Dmamux -> sai_dma_write(cpu,m.device,a,a - m.base,width,x,n)
            Dsi -> dsi_write(cpu,a,a - m.base,width,x,n)
            Sdmmc -> sdmmc_write(cpu,a,a - m.base,width,x,n)
            H7Spi | Stm32Gpio -> storage_write(cpu,m.device,a,a - m.base,width,x,n)
            H7Rcc -> h7_rcc_write(cpu,a,a - m.base,width,x)
            Console -> console_write(cpu, a, a - m.base, x)
            DigitalAudio -> digital_write(cpu, a, a - m.base, width, x, n)
            Pwm -> pwm_write(cpu, a, a - m.base, width, x, n)
            Spi -> spi_write(cpu, a, a - m.base, width, x, n)
            I2c -> i2c_write(cpu, a, a - m.base, width, x, n)
            Adc -> adc_write(cpu, a, a - m.base, width, x, n)
            PanelGpio -> panel_write(cpu, a, a - m.base, width, x, n)
            Sio -> sio_write(cpu, a, a - m.base, x)
            d -> rp_write(cpu, d, a, a - m.base, width, x, n)
        return

    halt(cpu, Stop.Unmapped, a)

// The first IRQ the bus gives a device of kind `d`, and whether there is one; -1 where it gave none.
private[virt] mapped_irq(ds: []const Mapped, d: Device) -> (bool, int)
    for m in ds do if m.device == d then return (true, m.irqs[0])
    (false, -1)

// Spinlock k's bit, for a register that is one of the spinlocks; 0 for any other.
private lock_bit(o: u32) -> u32
    if o < SPINLOCK0 || o > SPINLOCK31 || o & 3 != 0 then return 0

    1 << ((o - SPINLOCK0) >> 2)

// The SIO's half of an access to address `a`, register `o` from its base.
private sio_read(cpu: *Cpu, a: u32, o: u32) -> u32
    val k = core_of(cpu)
    val bit = lock_bit(o)

    if bit != 0 then return claim(bit)

    o match
        CPUID -> u32(k)
        FIFO_ST -> fifo_status(k)
        FIFO_WR -> 0
        FIFO_RD ->
            if waiting_in(k) == 0
                fifo_errors[k] |= ROE
                return 0

            pop(k)
        SPINLOCK_ST -> atomic_load(&locks, Relaxed)
        _ ->
            halt(cpu, Stop.Unmapped, a)
            0

private sio_write(cpu: *Cpu, a: u32, o: u32, x: u32)
    val k = core_of(cpu)
    val bit = lock_bit(o)

    if bit != 0
        // Release: what the core wrote while it held the lock is seen by the next core to claim it.
        atomic_and(&locks, ~bit, Release)
        return

    o match
        FIFO_ST -> fifo_errors[k] &= ~(x & (WOF | ROE))
        FIFO_WR ->
            if k == 0 && !scheduler.launched
                boot_rom(cpu, x)
            else if push(1 - k, x)
                if scheduler.threaded && fifo_irq() >= 0 then wake_core(1 - k, u32(fifo_irq()))
            else
                fifo_errors[k] |= WOF
        CPUID | FIFO_RD | SPINLOCK_ST -> ()
        _ -> halt(cpu, Stop.Unmapped, a)

// Claim the spinlock whose bit is `bit`: answer the bit, having claimed it, if it was free, and 0 if
// it was already claimed. One atomic test-and-set, so of two cores claiming at once exactly one
// gets it; acquire, so the claimer sees what the last holder wrote. A claimed lock is first read, to
// leave its word alone while it is spun on.
private claim(bit: u32) -> u32
    if atomic_load(&locks, Relaxed) & bit != 0 then return 0
    if atomic_or(&locks, bit, Acquire) & bit != 0 then return 0

    bit

private fifo_status(k: int) -> u32
    var st = fifo_errors[k]

    if waiting_in(k) > 0 then st |= VLD
    if (k == 0 && !scheduler.launched) || room_in(1 - k) then st |= RDY
    st

// The words in core k's RX FIFO, as core k, its consumer, sees them.
private[virt] waiting_in(k: int) -> u32 = atomic_load(&pushed[k], Acquire) - atomic_load(&popped[k], Relaxed)

// Whether core k's RX FIFO has room, as its producer sees it.
private room_in(k: int) -> bool = atomic_load(&pushed[k], Relaxed) - atomic_load(&popped[k], Acquire) < FIFO_DEPTH

// Push `x` to core k's RX FIFO, answering whether it had room. The word is in its slot before the
// release that counts it.
private push(k: int, x: u32) -> bool
    if !room_in(k) then return false

    val p = atomic_load(&pushed[k], Relaxed)

    fifo[k][p % FIFO_DEPTH] = x
    atomic_store(&pushed[k], p + 1, Release)
    true

// Pop core k's RX FIFO, which holds a word. The word is read before the release that frees its slot.
private pop(k: int) -> u32
    val q = atomic_load(&popped[k], Relaxed)
    val x = fifo[k][q % FIFO_DEPTH]

    atomic_store(&popped[k], q + 1, Release)
    x

// Core 1's boot ROM taking word `w` from core 0: it echoes it, and follows the launch sequence 0, 0,
// 1, VTOR, SP, ENTRY. Zeros at its start keep the last two; any other word out of place starts it
// again. VTOR, SP and ENTRY may be any word. The echo of ENTRY is the last, and core 1 starts after it.
private boot_rom(cpu: *Cpu, w: u32)
    push(0, w)

    if step < 2
        step = if w == 0 then step + 1 else 0
        return

    if step == 2
        step = if w == 1 then 3 else if w == 0 then 2 else 0
        return

    if step < 5
        sent[step - 3] = w
        step += 1
        return

    step = 0
    launch(sent[0], sent[1], w)
    set_limit(cpu, 0)

private[virt] cpu_models_differ() -> bool = core_kinds[0] != core_kinds[1] || core_instruction_timing[0] != core_instruction_timing[1]
