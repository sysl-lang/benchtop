module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, ChipForm, Core, Description, Peripheral as DescribedPeripheral, ProductForm, Registry, article_of, built_in_shelf, core_option, library, param_named, part_model, part_whole, load, open_description, unemulated_core_option}
import sh.sysl.benchtop.v6m.{Kind, RAM_BYTES, default_priority_bits, has_fixed_dsp, model_named, model_names}
import sh.sysl.parsing.{Diagnostic, Source, Span, source}
import sh.sysl.benchtop.v6m.{Cpu, Fpu, Memory, MemoryMap, RamBank, memory, ram_only}
import sysl.buf.{Buf, buf}
import sysl.math.min

// A board description made into the machine benchtop runs.
//
// **The description is the machine.** The cores are the chip's, and every device's base and IRQ comes
// from its peripheral's `at` and `irq`, so a chip that moves the console moves it for the guest too.
// What benchtop can run is narrower than what `benchtop check` accepts: a chip of two
// supported Cortex-M cores, their RAM where the cores have it, and the peripherals benchtop emulates,
// on a board with no parts of its own. Anything else is refused by name, so a board described for the
// checker alone (a real chip, an LED) says why it does not run.

/** A board description read, checked and put on the bus; or the diagnostics or the reason it cannot
 * run. `name` is what the diagnostics call the file.
 */
board_from(name: string, text: []const u8) -> Result[Board, string] = board_of(source(name, text))

/** `board_from` for the description `which` names: one built into benchtop, or a file's path. */
board_named(which: string) -> Result[Board, string]
    open_description(built_in_shelf(), which, "", Span(0, 0)) match
        Ok(src) -> board_of(src)
        Err(d) -> Err(described_error(d))

/** A mistake in naming a description on the command line, where there is no file to point into. */
described_error(d: Diagnostic) -> string
    val label = if d.label.is_empty() then "" else s" (${d.label})"

    s"benchtop: ${d.message}$label\n  = note: ${d.note}\n"

private board_of(src: Source) -> Result[Board, string]
    val reg = library()
    val got = load(src, reg)

    if got.report.has_errors() then return Err(got.report.render(src))

    val b = runnable(got.description) match
        Ok(b) -> b
        Err(why) -> return Err(s"${src.name}: $why\n")

    assemble(b, reg) match
        Ok(_) -> Ok(b)
        Err(why) -> Err(s"${src.name}: $why\n")

/** The one board a description runs: the board it is, or a product's one board. A product's own
 * parts are outside every board's bus, and benchtop does not run them; a chip is run on a board.
 */
runnable(d: Description) -> Result[Board, string]
    if d.form == ChipForm then
        return Err(s"this is the mcu `${d.chip.name}`, and benchtop runs a board: name one, or write one around the mcu, as `board { name = mine, mcu = ... }`")

    if d.form != ProductForm then return Ok(d.board)

    val p = d.product

    if p.boards.len() != 1 then
        return Err(s"benchtop runs one board, and this product has ${p.boards.len()}")

    if !p.parts.is_empty() then
        return Err(s"benchtop runs a product's board and nothing outside it, and `${p.parts.at(0).name}` is outside it")

    Ok(p.boards.at(0).board)
end runnable

/** Make the machine a checked board describes — its memory map, the devices on its bus, its cores and
 * its clock — or say why benchtop cannot run it. The whole description is checked before anything is
 * set, so a refused one leaves the machine as the last board made it.
 */
assemble(b: Board, reg: Registry) -> Result[unit, string]
    val p = plan(b, reg)?

    machine.clock_hz = p.clock_hz
    machine.map = p.map
    apply_devices(p.devices)
    machine.configs = p.cores
    Ok(())

/** What a description makes of a machine, decided and checked whole before any of it is set. */
private struct Plan
    map: MemoryMap
    devices: Devices
    clock_hz: u64
    cores: [2]CoreConfig

/** One core as the description makes it: its model and options, and how many ticks of the chip's
 * clock one tick of its own takes (`divisor`; 1 where it runs at the chip's clock). `boot` and
 * `launch` give a core its configuration with `configure`.
 */
struct CoreConfig
    kind: Kind
    timed: bool
    priority_bits: u32
    dsp: bool
    fpu: Fpu
    divisor: u64

/** A core no description has configured: an ARMv6-M with its default options, at the chip's clock. */
private[virt] unconfigured() -> CoreConfig = CoreConfig(Kind.V6m, false, 2, false, Fpu.Absent, 1)

/** The machine `b` describes, or why benchtop cannot run it. It sets nothing. */
private plan(b: Board, reg: Registry) -> Result[Plan, string]
    val chip = b.chip
    val cores = chip.cores

    if !b.parts.is_empty() && !panel_parts(b) then
        val p = b.parts.at(0)

        return Err(s"benchtop does not emulate the parts on a board yet, and `${p.name}` is ${article_of(p.kind)} ${p.kind}")

    for p in chip.peripherals
        reg.peripheral(p.kind) match
            Some(spec) ->
                if !spec.modelled then
                    return Err(s"benchtop does not emulate the ${chip.name}'s `${p.name}` (${p.kind}) yet")
            None -> ()

    if cores.len() != 2 then
        return Err(s"benchtop runs two cores, and the ${chip.name} has ${core_names(chip.cores)}")

    val model = model_named(cores.at(0).name) match
        Some(m) -> m
        None -> return Err(s"benchtop cannot run `${cores.at(0).name}`; supported cores: ${model_names()}")

    for c in cores
        if model_named(c.name).is_none() then return Err(s"benchtop cannot run `${c.name}`; supported cores: ${model_names()}")
        unemulated_core_option(c) match
            Some(why) -> return Err(why)
            None -> ()

    var ds: Buf[Mapped] = buf()
    var ram = false
    var regions: Buf[RamBank] = buf()
    var banks: Buf[RamBank] = buf()
    var ram_used: u32 = 0
    var memory_ram_at: u32 = 0
    var memory_ram_size: u32 = RAM_BYTES
    var memory_flash_at: u32 = 0x10000000
    var memory_flash_size: u32 = 0

    for p in chip.peripherals
        // A checked chip has `at` on every peripheral.
        val at = p.at.unwrap().n
        var irqs = NO_IRQS

        for i in 0..<p.irqs.len()
            val irq = int(p.irqs.at(i).n)

            for c in cores
                val capacity = model_named(c.name).unwrap().irqs
                if irq >= capacity then return Err(s"`${c.name}` implements $capacity external interrupts, and `${p.name}` selects IRQ $irq")
            if i < irqs.len then irqs[i] = irq

        p.kind match
            "ram" ->
                val size: long = p.size.unwrap().n

                if size < 4096 || size > long(RAM_BYTES) || (size & 4095) != 0 then
                    return Err(s"RAM capacity must be a multiple of 4 KB, between 4 KB and ${size_text(RAM_BYTES)}")

                ram = true
                regions.push(RamBank(u32(at),u32(size),0))
            "flash" | "flash-interface" ->
                val size = p.size.unwrap().n
                if memory_flash_size != 0 then return Err("benchtop currently supports one flash region")
                if size < 4096 || size > 4194304 || (size & 4095) != 0 then return Err("flash capacity must be a multiple of 4 KB, between 4 KB and 4 MB")
                if p.kind == "flash-interface"
                    var attached = 0
                    for part in b.parts
                        if part_model(part) != "flash" then continue
                        for wire in part.wires
                            if wire.port != "interface" then continue
                            wire.to match
                                Bus(name) -> if name == p.name
                                    attached += 1
                                    if part_whole(part, "capacity", 0) != size then return Err("external flash capacity must match its mapped interface size")
                                _ -> ()
                    if attached != 1 then return Err("flash-interface needs exactly one external flash part")
                memory_flash_at = u32(at)
                memory_flash_size = u32(size)
            _ -> device_of(p) match
                Some(d) -> ds.push(placed(d, p, at, irqs, reg))
                None -> return Err(s"`${p.name}` is ${article_of(p.kind)} ${p.kind}, which benchtop does not emulate")
    end for

    if !ram then return Err(s"the ${chip.name} has no `ram` region")
    // Adjacent physical banks are contiguous RAM, including unaligned accesses
    // and instructions spanning their boundary. Coalesce before assigning backing.
    var merged = true
    while merged
        merged = false
        for i in 0..<regions.len()
            for j in (i + 1)..<regions.len()
                val a = regions.at(i)
                val b = regions.at(j)
                if u64(a.base) + u64(a.size) != u64(b.base) && u64(b.base) + u64(b.size) != u64(a.base) then continue
                val base = min(a.base, b.base)
                if u64(a.size) + u64(b.size) > u64(RAM_BYTES) then return Err(s"RAM banks must fit within ${size_text(RAM_BYTES)}")
                regions.set(i,RamBank(base,a.size + b.size,0))
                regions.remove(j)
                merged = true
                break
            if merged then break
    if regions.len() > 8 then return Err("benchtop supports at most eight disjoint RAM regions")
    memory_ram_at = regions.at(0).base
    memory_ram_size = regions.at(0).size
    ram_used = memory_ram_size
    for i in 1..<regions.len()
        val region = regions.at(i)
        val offset = ram_used + 4096
        if u64(offset) + u64(region.size) > u64(RAM_BYTES) then return Err(s"RAM banks and backing guards must fit within ${size_text(RAM_BYTES)}")
        banks.push(RamBank(region.base,region.size,offset))
        ram_used = offset + region.size

    for i in 0..<ds.len()
        for j in 0..<i
            if ds.at(i).device == ds.at(j).device && ds.at(i).device != Stm32Gpio then
                return Err(s"benchtop runs one ${device_name(ds.at(i).device)}, and the ${chip.name} has two")

    val clock_hz = chip.clock_hz match
        Some(hz) -> u64(hz.n)
        None -> 0
    for p in chip.peripherals
        if clock_hz == 0 || (p.kind != "virt-i2c" && p.kind != "virt-pwm" && p.kind != "virt-i2s") then continue
        for q in p.params
            if q.name != "clock-hz" then continue
            q.value match
                Whole(hz) -> if u64(hz) != clock_hz
                    return Err(s"`${p.name}.clock-hz` is a guest timebase and must match `mcu.clock-hz`; omit it to inherit the MCU clock")
                _ -> ()
    var divisors: [2]u64 = [1, 1]
    for k in 0..<cores.len()
        core_option(cores.at(k), "clock-hz") match
            Whole(hz) ->
                if clock_hz == 0 || u64(hz) > clock_hz || clock_hz % u64(hz) != 0 then
                    return Err("core `clock-hz` must divide `mcu.clock-hz` exactly; omit it to inherit the MCU timebase")
                divisors[k] = clock_hz / u64(hz)
            _ -> ()

    val map = MemoryMap(memory_ram_at, memory_ram_size, memory_flash_at, memory_flash_size, banks)
    val devices = check_devices(b, ds.view(), clock_hz)?

    Ok(Plan(map, devices, clock_hz, [core_config(cores.at(0), divisors[0]), core_config(cores.at(1), divisors[1])]))
end plan

// A core's kind and options, from a core `plan` has checked, and its clock's divisor.
private core_config(core: Core, divisor: u64) -> CoreConfig
    val kind = model_named(core.name).unwrap().kind
    val timed = core_option(core, "instruction-timing") match
        Text(mode) -> mode == "estimated"
        _ -> false
    val priority_bits = core_option(core, "nvic-priority-bits") match
        Whole(n) -> u32(n)
        _ -> default_priority_bits(kind)
    val dsp = core_option(core, "dsp") match
        Flag(on) -> on
        _ -> has_fixed_dsp(kind)
    val fpu = core_option(core, "fpu") match
        Text(unit) -> if unit == "dp" then Fpu.Double elif unit == "sp" then Fpu.Single else Fpu.Absent
        _ -> Fpu.Absent

    CoreConfig(kind, timed, priority_bits, dsp, fpu, divisor)

// Each peripheral kind benchtop puts on the cores' bus, and the device it is there. Two kinds may be
// one device (an I2C controller is `virt-i2c` or `stm32-i2c`); `stm32-dma` is DMA1 or DMA2, as its
// `controller` says.
private val DEVICE_KINDS = [
    ("debug-console", Console), ("virt-sio", Sio), ("rp-resets", Resets), ("rp-timer", Timer),
    ("rp-watchdog", Watchdog), ("panel-gpio", PanelGpio), ("virt-adc", Adc), ("virt-i2c", I2c),
    ("stm32-i2c", I2c), ("virt-pwm", Pwm), ("virt-i2s", DigitalAudio), ("pl022", Spi),
    ("stm32h7-rcc", H7Rcc), ("stm32-spi", H7Spi), ("stm32-gpio", Stm32Gpio), ("stm32-sdmmc", Sdmmc),
    ("stm32-dsi", Dsi), ("stm32-sai", Sai), ("stm32-dma", Dma1), ("stm32-dmamux", Dmamux)]

// The device on the cores' bus that a peripheral of the description is, or none for a kind benchtop
// does not put there. A checked `controller` is 1 or 2.
private device_of(p: DescribedPeripheral) -> Option[Device]
    for (kind, d) in DEVICE_KINDS
        if kind != p.kind then continue
        if d != Dma1 then return Some(d)
        return param_named(p.params, "controller") match
            Some(q) -> q.value match
                Whole(2) -> Some(Dma2)
                _ -> Some(Dma1)
            None -> Some(Dma1)
    None

// A device's window on the bus: from `at`, the size the chip gives it, or else the size the
// registry's peripheral declares. A checked chip names only peripherals the registry has.
private placed(d: Device, p: DescribedPeripheral, at: long, irqs: [8]int, reg: Registry) -> Mapped
    val size: long = p.size match
        Some(s) -> s.n
        None -> reg.peripheral(p.kind).unwrap().window.size

    Mapped(d, u32(at), u32(at + size - 1), irqs)

// How a refusal names a device: every kind that is it, from `DEVICE_KINDS`.
private device_name(d: Device) -> string
    if d == Dma2 then return "`stm32-dma` controller 2"

    var kinds: Buf[string] = buf()

    for (kind, k) in DEVICE_KINDS do if k == d then kinds.push(s"`$kind`")

    val name = if kinds.len() == 1 then kinds.at(0) else s"${kinds.at(0)} or ${kinds.at(1)}"

    if d == Dma1 then s"$name controller 1" else name

private core_names(cores: Buf[Core]) -> string
    var out = ""

    for i in 0..<cores.len()
        if i > 0 then out = s"$out, "

        out = s"$out${cores.at(i).name}"

    out


/** One board as benchtop runs it. It holds the board's memory: the map `assemble` planned, which
 * `boot` lays out, and the storage both cores run on, which the machine owns and the cores point at.
 * It holds its devices: the bus and each peripheral's state (devices.sysl). It holds its two cores,
 * each of which reaches the machine back through its `bus`, which `boot` and `launch` point here,
 * and what the description makes of each (`configs`), with the chip's clock (`clock_hz`, 0 where it
 * names none). `bus_cache` is each core's last device on the bus. docs/machine.md says what joins it
 * next.
 */
struct Machine
    map: MemoryMap
    memory: &Memory
    devices: Devices
    console: Console
    cores: [2]Cpu
    configs: [2]CoreConfig
    clock_hz: u64
    bus_cache: [2]BusCache

/** The board this process runs, until every entry point is handed its machine. */
var machine = Machine(ram_only(), memory(), no_devices(), console(), unbooted_cores(), [unconfigured(); 2], 0, [no_bus_cache(); 2])

// Two cores before any `boot`, every field zero; `boot` gives them their kind, memory and bus.
private unbooted_cores() -> [2]Cpu
    var cores: [2]Cpu
    cores

/** `n` bytes as a person writes a memory's size: "1 MB", "64 KB", or bytes where neither divides. */
private[virt] size_text(n: u32) -> string =
    if n != 0 && n % 1048576 == 0 then s"${n / 1048576} MB"
    elif n != 0 && n % 1024 == 0 then s"${n / 1024} KB"
    else s"$n bytes"

/** Where the board puts its memory, as the last description assembled said. */
memory_map() -> MemoryMap = machine.map

/** The chip's clock, its `clock-hz`; zero where the description gives none, which a peripheral that
 * needs a timebase refuses and the rest answer with their own default rate. */
clock_hz() -> u64 = machine.clock_hz

/** How many ticks of the chip's clock one tick of each core's takes. */
clock_divisors() -> [2]u64 = [machine.configs[0].divisor, machine.configs[1].divisor]
