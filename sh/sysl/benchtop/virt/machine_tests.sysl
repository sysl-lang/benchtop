module sh.sysl.benchtop.virt
@tests

// The machine a description builds: its devices answer where the description puts them and raise
// the IRQs it gives them, and a board benchtop cannot run is refused with the reason.

import sh.sysl.benchtop.v6m.{Cpu, Fpu, Stop}
import sysl.raw.str_cast
import sysl.fs.{make_temp_dir, remove_dir_all, write_bytes, write_text}

val irq_moved = embed("../../../../examples/virt/irq-moved.elf")
val moved = embed("../../../../examples/virt/moved.hocon")

// The virtual board with its peripherals' places and IRQs as given, for the tests that move them.
private described(console: string, sio: string) -> string = s"""
    board {
      name = "test"
      mcu {
        name = "test", cores = [cortex-m0plus, cortex-m0plus]
        peripherals {
          ram     { peripheral = ram, at = 0x00000000, size = 1M }
          console { peripheral = debug-console, $console }
          sio     { peripheral = virt-sio, $sio }
        }
      }
    }
    """

// A board on a chip `v` of `cores` whose peripherals are `peripherals`.
private board_of(cores: string, peripherals: string) -> string =
    s"board {\n  name = v\n  mcu {\n    name = v, $cores\n    peripherals {\n$peripherals    }\n  }\n}\n"

val TWO = "cores = [cortex-m0plus, cortex-m0plus]"

// What `board_from` says about a description made on `m`, or "" where it runs.
private refusal(m: *Machine, text: string) -> string = board_from(m, "b.hocon", text.bytes) match
    Ok(_) -> ""
    Err(why) -> why

@test("irq.elf built for a console at 0x50000000 and IRQ 7 runs on moved.hocon as irq.elf runs on virt")
machine_moved_console()
    val board = machine()
    val m = &*board
    val cpu = core0(m)

    on_board(m, "moved.hocon", moved)
    booted_on(m, irq_moved, "one\ntwo\n")
    run_board(m)

    assert(output(m).view() == s"${IRQ_GREETING}one\ntwo\n\nbye after 8 bytes\n".bytes, str_cast(output(m).view()))
    assert(cpu.stop == Stop.Exit && cpu.stop_at == 0x50000008 && cpu.exit_code == 0)

@test("a program built for one console base finds nothing at it on a board that puts the console elsewhere")
machine_console_elsewhere()
    val board = machine()
    val m = &*board
    val cpu = core0(m)

    booted(m, irq_moved, "x\n")
    run_board(m)
    assert(cpu.stop == Stop.Unmapped && cpu.stop_at == 0x50000000, f"${cpu.stop} at 0x${cpu.stop_at}%08x")

    on_board(m, "moved.hocon", moved)
    booted_on(m, irq, "x\n")
    run_board(m)
    assert(cpu.stop == Stop.Unmapped && cpu.stop_at == 0x40000000, f"${cpu.stop} at 0x${cpu.stop_at}%08x")

@test("the console raises the IRQ its part gives, and none where it gives none")
machine_console_irq()
    val board = machine()
    val m = &*board
    val cpu = core0(m)

    // irq-moved.elf enables IRQ 7 alone; raised on IRQ 0, its handler never runs and WFI never wakes.
    on_board(m, "t.hocon", described("at = 0x50000000, irq = 0", "at = 0xD0000000, irq = 1").bytes)
    booted_on(m, irq_moved, "one\n")
    run_board(m)
    assert(cpu.stop == Stop.Asleep, s"${cpu.stop}")
    assert(output(m).view() == IRQ_GREETING.bytes, str_cast(output(m).view()))

    on_board(m, "t.hocon", described("at = 0x50000000", "at = 0xD0000000, irq = 1").bytes)
    booted_on(m, irq_moved, "one\n")
    run_board(m)
    assert(cpu.stop == Stop.Asleep, s"${cpu.stop}")

    on_board(m, "t.hocon", described("at = 0x50000000, irq = 7", "at = 0xD0000000, irq = 1").bytes)
    booted_on(m, irq_moved, "one\n")
    run_board(m)
    assert(cpu.stop == Stop.Exit && cpu.exit_code == 0, s"${cpu.stop}")

@test("the SIO answers at the base its part gives, register by register")
machine_sio_moved()
    val board = machine()
    val m = &*board
    val cpu = core0(m)

    on_board(m, "t.hocon", described("at = 0x40000000, irq = 0", "at = 0x60000000").bytes)
    booted_on(m, [], "")

    assert(board_read(m, cpu, 0x60000000, 4, 0) == 0, "CPUID on core 0")
    assert(board_read(m, cpu, 0x60000100, 4, 0) == 1, "spinlock 0 claimed")
    assert(board_read(m, cpu, 0x6000005C, 4, 0) == 1, "SPINLOCK_ST")
    assert(cpu.stop == Stop.Running)

    board_read(m, cpu, 0xD0000000, 4, 0)
    assert(cpu.stop == Stop.Unmapped && cpu.stop_at == 0xD0000000)

@test("run refuses a board benchtop cannot run, saying why")
machine_refusals()
    val board = machine()
    val m = &*board
    val rp = "board {\n  name = v, mcu = rp2040\n  parts { d1 { part = led, wire { anode = GP16 } } }\n}\n"

    assert(refusal(m, rp) == "b.hocon: benchtop does not emulate the parts on a board yet, and `d1` is a led\n", refusal(m, rp))
    assert(refusal(m, "board = pico2w\n") == "b.hocon: benchtop does not emulate the parts on a board yet, and `wifi` is a cyw43439\n", refusal(m, "board = pico2w\n"))
    assert(refusal(m, "board { name = v, mcu = rp2040 }\n") == "b.hocon: benchtop does not emulate the rp2040's `rom` (rom) yet\n", refusal(m, "board { name = v, mcu = rp2040 }\n"))
    assert(refusal(m, "board { name = v, mcu = rp2350 }\n") == "b.hocon: benchtop does not emulate the rp2350's `rom` (rom) yet\n", refusal(m, "board { name = v, mcu = rp2350 }\n"))

    val ram = "      ram { peripheral = ram, at = 0, size = 1M }\n"
    val one = board_of("cores = [cortex-m0plus]", ram)

    assert(refusal(m, one) == "b.hocon: benchtop runs two cores, and the v has cortex-m0plus\n", refusal(m, one))

    val m33 = board_of("cores = [cortex-m0plus, cortex-m33]", ram)

    assert(refusal(m, m33) == "", "different supported Cortex-M cores share a board")

    val big = board_of(TWO, "      ram { peripheral = ram, at = 0, size = 2M }\n")

    assert(refusal(m, big) == "b.hocon: RAM capacity must be a multiple of 4 KB, between 4 KB and 1 MB\n", refusal(m, big))

    val high = board_of(TWO, "      ram { peripheral = ram, at = 0x20000000, size = 1M }\n")

    assert(refusal(m, high) == "", "relocated RAM is supported")

    val none = board_of(TWO, "      console { peripheral = debug-console, at = 0x40000000 }\n")

    assert(refusal(m, none) == "b.hocon: the v has no `ram` region\n", refusal(m, none))

    val consoles = board_of(TWO, s"$ram      a { peripheral = debug-console, at = 0x40000000 }\n      b { peripheral = debug-console, at = 0x40000010 }\n")

    assert(refusal(m, consoles) == "b.hocon: benchtop runs one `debug-console`, and the v has two\n", refusal(m, consoles))

    for kind in ["virt-i2c", "stm32-i2c"]
        val i2cs = board_of(TWO, s"$ram      a { peripheral = $kind, at = 0x40000000 }\n      b { peripheral = $kind, at = 0x40001000 }\n")

        assert(refusal(m, i2cs) == "b.hocon: benchtop runs one `virt-i2c` or `stm32-i2c`, and the v has two\n", refusal(m, i2cs))

    // One of each kind is two I2C controllers too, and is named by both kinds.
    val mixed = board_of(TWO, s"$ram      a { peripheral = virt-i2c, at = 0x40000000 }\n      b { peripheral = stm32-i2c, at = 0x40001000 }\n")

    assert(refusal(m, mixed) == "b.hocon: benchtop runs one `virt-i2c` or `stm32-i2c`, and the v has two\n", refusal(m, mixed))

    // `controller` picks DMA1 or DMA2, read once; two of the same controller are refused by its number,
    // and one of each is two devices.
    for n in [1, 2]
        val dmas = board_of(TWO, s"$ram      a { peripheral = stm32-dma, controller = $n, at = 0x40020000 }\n      b { peripheral = stm32-dma, controller = $n, at = 0x40020400 }\n")

        assert(refusal(m, dmas) == s"b.hocon: benchtop runs one `stm32-dma` controller $n, and the v has two\n", refusal(m, dmas))

    val default_dma = board_of(TWO, s"$ram      a { peripheral = stm32-dma, at = 0x40020000 }\n      b { peripheral = stm32-dma, controller = 1, at = 0x40020400 }\n")

    assert(refusal(m, default_dma) == "b.hocon: benchtop runs one `stm32-dma` controller 1, and the v has two\n", refusal(m, default_dma))

    val both_dmas = board_of(TWO, s"$ram      a { peripheral = stm32-dma, controller = 1, at = 0x40020000 }\n      b { peripheral = stm32-dma, controller = 2, at = 0x40020400 }\n")

    assert(refusal(m, both_dmas) == "", refusal(m, both_dmas))

    val sio = board_of(TWO, s"$ram      s { peripheral = rp-sio, at = 0xD0000000, irq = [15, 16] }\n")

    assert(refusal(m, sio) == "b.hocon: benchtop does not emulate the v's `s` (rp-sio) yet\n", refusal(m, sio))

    // A chip alone is not a board, however runnable its cores and peripherals.
    val alone = refusal(m, "mcu = virt\n")

    assert(alone == "b.hocon: this is the mcu `virt`, and benchtop runs a board: name one, or write one around the mcu, as `board { name = mine, mcu = ... }`\n", alone)

@test("a product runs where it is one runnable board and nothing outside it")
machine_products()
    val board = machine()
    val m = &*board
    assert(refusal(m, "product { name = p, boards { v { board = virt } } }\n") == "")

    val two = "product { name = p, boards { a { board = virt }, b { board = virt } } }\n"

    assert(refusal(m, two) == "b.hocon: benchtop runs one board, and this product has 2\n", refusal(m, two))

    val outside = "product {\n  name = p\n  boards { pico { board = pico } }\n  parts { d1 { part = led, wire { anode = pico.GP15 } } }\n}\n"

    assert(refusal(m, outside) == "b.hocon: benchtop runs a product's board and nothing outside it, and `d1` is outside it\n", refusal(m, outside))
    assert(refusal(m, "product { name = p, boards { p { board = pico } } }\n").contains("benchtop does not emulate the parts on a board yet"))

@test("a board is found by name or by path, as `run --board` finds it")
machine_board_named()
    val board = machine()
    val m = &*board
    assert(board_named(m, "virt").is_ok())

    val virt = board_named(m, "virt").unwrap()

    assert(virt.name == "virt" && virt.parts.is_empty() && virt.chip.peripherals.len() == 3)
    assert(refusal(m, "board = virt\n") == "")

    board_named(m, "pico3") match
        Ok(_) -> assert(false, "pico3")
        Err(why) -> assert(why == "benchtop: unknown board `pico3` (did you mean `pico`?)\n  = note: the descriptions benchtop has built in are `virt`, `virt4`, `virt7`, `virt33`, `virt0`, `virt1`, `virt3`, `virt23`, `virt35p`, `virt52`, `virt55`, `virt85`, `workbench`, `pico`, `pico2`, `pico2w`, `pico-breadboard-kit` and `stm32h747-disco`; one in a file is named by its path, as `boards/mine.hocon`\n", why)

    board_named(m, "no/such/board.hocon") match
        Ok(_) -> assert(false, "a missing file")
        Err(why) -> assert(why.starts_with("benchtop: cannot read `no/such/board.hocon`: "), why)

@test("`--board` with a path reads the file, and a product there finds its board beside it")
machine_board_path()
    val owner = machine()
    val m = &*owner
    val dir = make_temp_dir("benchtop").unwrap()
    val board = s"$dir/moved.hocon"
    val product = s"$dir/kit.hocon"

    assert(write_bytes(board, moved).is_ok())
    assert(write_text(product, "product { name = k, boards { m { board = \"moved.hocon\" } } }\n").is_ok())

    for which in [board, product]
        val cpu = core0(m)

        board_named(m, which) match
            Ok(b) -> assert(b.name == "virt, console moved", b.name)
            Err(why) -> assert(false, why)

        booted_on(m, irq_moved, "one\n")
        run_board(m)
        assert(cpu.stop == Stop.Exit && cpu.stop_at == 0x50000008 && cpu.exit_code == 0, which)

    assert(remove_dir_all(dir).is_ok())

@test("run reports a description's mistakes as check does, before anything runs")
machine_mistakes()
    val board = machine()
    val why = refusal(&*board, board_of(TWO, "      ram { peripheral = ram, size = 1M }\n"))

    assert(why.contains("`ram` has no address"), why)
    assert(why.contains("b.hocon:6:7"), why)

@test("heterogeneous cores preserve their identity and independent FPU configuration across launch and reboot")
machine_heterogeneous()
    val board = machine()
    val m = &*board
    val text = board_of("cores = [{ core = cortex-m7, fpu = dp }, { core = cortex-m4, fpu = sp }]",
        "ram { peripheral = ram, at = 0, size = 1M }\n")
    assert(board_from(m, "h7-test.hocon",text.bytes).is_ok())
    for reboot in 0..<2
        boot(m,[])
        assert(core0(m).kind == sh.sysl.benchtop.v6m.Kind.V7emM7 && core1(m).kind == sh.sysl.benchtop.v6m.Kind.V7em)
        assert(core0(m).fpu == Fpu.Double && core1(m).fpu == Fpu.Single)
        launch(m,0,0x7000,0x201)
        assert(core1(m).kind == sh.sysl.benchtop.v6m.Kind.V7em && core1(m).fpu == Fpu.Single)
        assert(core0(m).dsp && core1(m).dsp)

@test("a description's per-core configuration is one record per core: model, options and clock divisor")
machine_core_configs()
    val board = machine()
    val m = &*board
    val text = board_of("cores = [{ core = cortex-m7, fpu = dp }, { core = cortex-m4, fpu = none }]",
        "ram { peripheral = ram, at = 0, size = 1M }\n")
    assert(board_from(m, "configs.hocon",text.bytes).is_ok())
    val (a, b) = (m.configs[0], m.configs[1])
    assert(a.kind == sh.sysl.benchtop.v6m.Kind.V7emM7 && a.fpu == Fpu.Double && a.divisor == 1)
    assert(b.kind == sh.sysl.benchtop.v6m.Kind.V7em && b.fpu == Fpu.Absent && b.divisor == 1)
    assert(cpu_models_differ(m), "an M7 and an M4 are different models")
    boot(m,[])
    assert(core0(m).fpu == Fpu.Double && core1(m).fpu == Fpu.Absent)
    assert(core0(m).divisor == 1 && core1(m).divisor == 1, "boot gives each core its clock divisor")
    assert(board_named(m, "virt").is_ok())
    assert(!cpu_models_differ(m) && m.configs[0].fpu == Fpu.Absent)

@test("each core's bus cache has a host cache line of its own")
machine_bus_cache_lines()
    val board = machine()
    val m = &*board
    assert(alignof(BusCache) == HOST_CACHE_LINE && sizeof(BusCache) == HOST_CACHE_LINE)
    val a = usize(&m.bus_cache[0])
    val b = usize(&m.bus_cache[1])
    assert(a % HOST_CACHE_LINE == 0 && b - a == HOST_CACHE_LINE)

@test("every window on the bus reaches a device, and the running devices are those the board has, once each")
machine_attached_windows()
    // virt: the console and the SIO; the DISCO (its chip's whole `stm32h747` set): the SAI and DMA,
    // the DSI, the SDMMC, the I2C; touch: the SPI, the panel's GPIO, the I2C.
    val board = machine()
    val m = &*board
    for (name, running) in [("virt", 2usize), ("stm32h747-disco", 4usize), ("boards/touch.hocon", 3usize)]
        assert(board_named(m, name).is_ok(), name)
        val bus = &m.devices.bus
        assert(bus.attached > 0, name)
        for i in 0..<bus.attached
            val id = bus.windows[i]::Id
            val expected = bus.mapped[i].device match
                Console -> Console::Id
                Sio -> SioState::Id
                Dsi -> DsiState::Id
                I2c -> I2c::Id
                H7Rcc -> RccState::Id
                Spi -> SpiState::Id
                Sdmmc -> SdmmcState::Id
                PanelGpio -> PanelState::Id
                Sai | Dma1 | Dma2 | Dmamux -> AudioWindow::Id
                _ -> id
            assert(id == expected, s"$name: window $i answers for its device")
        assert(m.devices.running.count == running, s"$name runs ${m.devices.running.count} devices")
    assert(board_named(m, "virt").is_ok())
    boot(m,[])
    assert(board_read(m, core0(m), 0xD0000000, 4, 0) == 0 && core0(m).stop == Stop.Running, "the virt board's SIO answers through its window")
    board_read(m, core0(m), 0x60000000, 4, 0)
    assert(core0(m).stop == Stop.Unmapped, "an address in no window stops the core")

@test("the SIO is a device of the machine's, and boot gives it back as at power-on")
machine_sio_reset()
    val board = machine()
    val m = &*board
    assert(board_named(m, "virt").is_ok())
    val sio: u32 = 0xD0000000
    for round in 0..<2
        boot(m,[])
        val s = &m.devices.sio
        assert(s.step == 0 && s.locks == 0 && s.pushed == [0u32, 0u32] && s.popped == [0u32, 0u32] && s.errors == [0u32, 0u32], s"round $round starts at power-on")
        assert(board_read(m, core0(m), sio + 0x100, 4, 0) == 1, "spinlock 0 was free")
        board_write(m, core0(m), sio + 0x54, 4, 0, 0)
        board_write(m, core0(m), sio + 0x54, 4, 0, 0)
        assert(s.step == 2 && s.pushed[0] == 2, "the boot ROM took two zeros and echoed both")
        assert(board_read(m, core0(m), sio + 0x5C, 4, 0) == 1, "and the lock is still claimed")
        assert(board_read(m, core0(m), sio + 0x58, 4, 0) == 0 && board_read(m, core0(m), sio + 0x50, 4, 0) & 1 == 1, "one echo still waits")

@test("a device reaches its machine through what it is handed: a refused board leaves another machine's devices alone")
machine_devices_are_each_machines()
    val first = machine()
    val second = machine()
    val a = &*first
    val b = &*second
    assert(board_named(a, "stm32h747-disco").is_ok())
    assert(board_named(b, "virt").is_ok())
    val (on_a, on_b) = (attached(a), attached(b))
    assert(on_a == 19 && on_b < on_a, s"$on_a and $on_b devices")
    assert(refusal(b, "board = pico2w\n") != "")
    assert(attached(a) == on_a && attached(b) == on_b, "a refusal on one machine changes neither")
    boot(a,image_of(a, []).unwrap().view())
    boot(b,[])
    assert(board_read(b, core0(b), 0xD0000000, 4, 0) == 0 && core0(b).stop == Stop.Running, "virt's SIO answers on its own machine")
    board_read(a, core0(a), 0xD0000000, 4, 0)
    assert(core0(a).stop == Stop.Unmapped, "the DISCO has no SIO there")
