module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{Stop, load32, store32, load16}
import sh.sysl.benchtop.parts.mipi_dcs as tft

private val PANEL_GUEST = embed("../../../../bench/guest/panel-ram.elf")

// `m` made the board `which` names and booted with the panel guest, its output captured.
private panel_booted(m: *Machine, which: string)
    assert(board_named(m, which).is_ok())
    open_console(m)
    capture(m)
    boot(m, image_of(m, PANEL_GUEST).unwrap().view())

@test("panel GPIO: mapped output/input/direction, masked edges, W1C and access faults")
panel_registers()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    panel_booted(m, "bench/guest/workbench-ram.hocon")
    assert(load32(cpu, 0x50000004) == 0xFFFFFFFF)
    store32(cpu, 0x50000008, 7)
    store32(cpu, 0x50000000, 5)
    assert(panel_outputs(m) == 5 && (load32(cpu, 0x50000004) & 7) == 5)
    panel_inputs(m, 0xFFFFFEFF)
    assert(load32(cpu, 0x5000000C) == 256 && load32(cpu, 0x50000014) == 0)
    store32(cpu, 0x50000010, 256)
    assert(load32(cpu, 0x50000014) == 256)
    store32(cpu, 0x5000000C, 256)
    assert(load32(cpu, 0x50000014) == 0)
    load16(cpu, 0x50000000)
    assert(cpu.stop == Stop.Fault)
    cpu.stop = Stop.Running
    load32(cpu, 0x50000018)
    assert(cpu.stop == Stop.Unmapped)

@test("visual board pump: an idle interrupt-enabled console never blocks the host event loop")
pump_idle()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    panel_booted(m, "virt")
    // WFI at 0x100 with console IRQ0 enabled and no terminal input thread.
    cpu.pc = 0x100
    store32(cpu, 0x100, 0xE7FEBF30)
    store32(cpu, 0xE000E100, 1)
    store32(cpu, 0x4000000C, 1)
    val before = cpu.retired
    assert(pump_board(m, 1))
    assert(cpu.sleeping && cpu.stop == Stop.Running && cpu.retired == before + 1)
    assert(pump_board(m, 1000) && cpu.sleeping && cpu.retired == before + 1)
    assert(pump_board(m, 0) && cpu.retired == before + 1)

@test("visual board pump: host GPIO input wakes a sleeping core through the real interrupt handler")
pump_gpio_irq()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    panel_booted(m, "bench/guest/workbench-ram.hocon")
    cpu.pc = 0x100
    store32(cpu, 0x100, 0xE7FEBF30)
    store32(cpu, 0x48, 0x201)
    store32(cpu, 0x200, 0xE7FEBE00)
    store32(cpu, 0xE000E100, 4)
    store32(cpu, 0x50000010, 256)
    assert(pump_board(m, 1) && cpu.sleeping)
    panel_inputs(m, 0xFFFFFEFF)
    assert(!pump_board(m, 100))
    assert(cpu.stop == Stop.Breakpoint && cpu.ipsr == 18 && cpu.pc == 0x200)

// Whether the frame `tft_frame` answers for `m`'s panel `name` is, point by point, what its
// controller shows through the panel's window.
private frame_is_glass(m: *Machine, name: string) -> bool
    val frame = tft_frame(m, name).unwrap()
    m.devices.displays.live.with(s -> frame_matches(s, name, frame))

private frame_matches(s: *DisplayState, name: string, frame: TftFrame) -> bool
    for b in s.tfts
        if b.name != name then continue
        if frame.width != b.width || frame.height != b.height then return false
        for y in 0..<b.height
            for x in 0..<b.width
                if frame.pixels.at(usize(y * b.width + x)) != tft.pixel(b.model, x + b.x, y + b.y) then return false
        return true
    false

@test("TFT frames: the copy taken under the display lock is the glass, through an offset window, in BGR and asleep")
tft_frames_are_the_glass()
    val board = machine()
    val m = &*board
    assert(board_named(m, "workbench").is_ok())
    assert(tft_frame(m, "no-such-panel").is_none())
    m.devices.displays.live.with(s ->
        var b = s.tfts.at(0)
        for i in 0..<b.model.ram.len() do b.model.ram.set(i, u32((i * 2654435761) & 0xFFFFFF))
        b.model.state.sleeping = false
        b.model.state.enabled = true
        b.x = 3
        b.y = 90
        s.tfts.set(0, b))
    assert(frame_is_glass(m, "tft"), "an offset window reaching past the controller's last row")
    m.devices.displays.live.with(s ->
        val model = s.tfts.at(0).model
        model.state.madctl = 8
        model.state.inverse = true)
    assert(frame_is_glass(m, "tft"), "BGR and inverted")
    m.devices.displays.live.with(s ->
        val model = s.tfts.at(0).model
        model.state.sleeping = true)
    assert(frame_is_glass(m, "tft") && tft_frame(m, "tft").unwrap().pixels.at(0) == 0, "asleep, the glass is dark")
