module sh.sysl.benchtop.virt

// The STM32's USARTs (`stm32-usart`) on the board, two at most: the register model
// (peripheral/stm32_usart) and the line each drives. A board puts the host's terminal on a line with a
// `terminal` part wired to the USART's bus, as the STM32H747I-DISCO's ST-LINK virtual COM port is on
// USART1: what the guest sends joins the machine's console output, and what is typed into the console
// reaches the receiver of the first USART in the chip's order that a terminal is on. `--serial` sends a
// USART's output to a file instead (`set_serial`).
//
// A character crosses only where the pin carrying it is in the USART's alternate function, as on the
// board. Typed input waits in the console until the receiver is enabled and its line is free, where a
// person typing at a real port while the receiver is off would lose it; once taken, a character
// arrives a frame later at the baud rate the guest set, so a paste reaches the guest at line rate and
// overruns a guest that reads too slowly, as on the wire.

import sh.sysl.benchtop.{Board, Part, part_model}
import sh.sysl.benchtop.peripheral.Model
import sh.sysl.benchtop.peripheral.stm32_usart as uart
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.benchtop.v6m.{Cpu, Stop, IRQ0, could_wake, exception_active, halt, lower_limit, raise, unmodelled_register}
import sh.sysl.stm32h747.usart1 as reg
import sysl.buf.Frozen
import sysl.fs.{append_bytes, write_bytes}
import sysl.raw.str_cast
import sysl.sync.*
import sysl.threads.Mutex

// The alternate function that puts a USART's TX and RX on the pins the chip lists for them, where the
// chip's description gives none (`alternate-function`): USART1's, AF7 (DS12930).
const USART_AF: u32 = 7

// How many characters a redirected USART gathers before it appends them to its file.
private const FILE_CHUNK: usize = 256

/** A pin of the chip's GPIO: its bank, an index among the storage path's banks, and its number there. */
struct UsartPin
    bank: usize
    pin: u32

/** A USART: whether the bus has it, the chip's name for it, the IRQ it raises (-1 for none), the
 * alternate function its pins take, whether the host's terminal is on its line and whether typed input
 * reaches its receiver; the pins its TX and RX are routed to, which the board fixes, where `pins` says
 * the board gives them; the file its output goes to instead of the console (empty for the console);
 * `next` and `level`, its next event's clock and its interrupt line, published for the cores to read
 * without its lock; and under `live` the register model. The name and the file are frozen bytes, read
 * through `name()` and `file()`, since the cores' threads share the state.
 */
struct UsartState
    present: bool
    label: &sync Frozen[u8]
    irq: int
    af: u32
    terminal: bool
    input: bool
    pins: bool
    tx: UsartPin
    rx: UsartPin
    out: &sync Frozen[u8]
    next: u64
    level: u32
    live: Mutex[uart.Usart]
end UsartState

/** No USART on the bus. */
usart_state() -> UsartState =
    UsartState(false, frozen_text(""), -1, USART_AF, false, false, false, UsartPin(0, 0), UsartPin(0, 0), frozen_text(""), NEVER, 0,
        Mutex.new(uart.usart(1, 1)))

impl UsartState
    /** The chip's name for the USART ('' where the bus has none). */
    name(*self) -> string = str_cast(self.label.view())

    /** The file the USART's output goes to ('' for the console). */
    file(*self) -> string = str_cast(self.out.view())

/** Whether part `p` is the host's terminal on `b`'s USART `name`. */
private[virt] usart_terminal(b: Board, p: Part, name: string) -> bool
    if part_model(p) != "terminal" then return false
    for wire in p.wires
        if wire.port != "uart" then continue
        wire.to match
            Bus(to) -> if to == name then for q in b.chip.peripherals do if q.name == name && q.kind == "stm32-usart" then return true
            _ -> ()
    false

/** Whether part `p` is the host's terminal on any of `b`'s USARTs. */
private[virt] any_usart_terminal(b: Board, p: Part) -> bool
    for q in b.chip.peripherals do if q.kind == "stm32-usart" && usart_terminal(b, p, q.name) then return true
    false

// The pin the board routes the USART `name`'s `signal` to, or the only one its chip lists.
private usart_pin_name(b: Board, name: string, signal: string) -> string
    for bus in b.buses
        if bus.name != name then continue
        for route in bus.signals do if route.name == signal then return route.pin
    for p in b.chip.peripherals
        if p.name != name then continue
        for route in p.signals do if route.name == signal && route.pins.len() == 1 then return route.pins[0].name
    ""

// The GPIO pin of the storage path's banks that the USART `name`'s `signal` is on, or None.
private usart_pin(b: Board, storage: *StorageState, name: string, signal: string) -> Option[UsartPin]
    val pin_name = usart_pin_name(b, name, signal)
    for bank in ["PA","PB","PC","PD","PE","PF","PG","PH","PI","PJ","PK"]
        val pin = local_pin(pin_name, bank) match
            Some(n) -> n
            None -> continue
        return storage.live.with(l -> gpio_named(l, bank)).map(i -> UsartPin(i, pin))
    None

/** The `k`th USART (from 0) of `b`'s chip, in its order, on a chip whose clock is `clock_hz`, with its
 * pins among `storage`'s GPIO banks; idle where the chip has fewer; or why benchtop cannot run it.
 */
private[virt] check_usart(b: Board, clock_hz: u64, storage: *StorageState, k: usize) -> Result[UsartState, string]
    var s = usart_state()
    var seen: usize = 0
    for p in b.chip.peripherals
        if p.kind != "stm32-usart" then continue
        seen += 1
        if seen != k + 1 then continue
        s.present = true
        s.label = frozen_text(p.name)
        if !p.irqs.is_empty() then s.irq = int(p.irqs[0].n)
        var kernel: u64 = 0
        for q in p.params
            if q.name == "kernel-clock-hz" then q.value match
                Whole(hz) -> kernel = u64(hz)
                _ -> ()
            if q.name == "alternate-function" then q.value match
                Whole(af) -> s.af = u32(af)
                _ -> ()
        if clock_hz == 0 || kernel == 0 then return Err(s"`${p.name}` needs the chip's `clock-hz` and its own `kernel-clock-hz`")
        for part in b.parts do if usart_terminal(b, part, p.name) then s.terminal = true
        s.input = s.terminal
        (usart_pin(b, storage, p.name, "tx"), usart_pin(b, storage, p.name, "rx")) match
            (Some(tx), Some(rx)) ->
                s.tx = tx
                s.rx = rx
                s.pins = true
            _ -> if s.terminal then return Err(s"the terminal on `${p.name}` needs its tx and rx on pins of the chip's GPIO, under `buses`")
        s.live = Mutex.new(uart.usart(kernel, clock_hz))
    Ok(s)

/** Send the output of `s`, a USART the bus has, to `file` instead of the console, emptying the file
 * now and again at each boot; or why not: the board routes its TX to no pin.
 */
private[virt] usart_to_file(s: *UsartState, file: string) -> Result[unit, string]
    if !s.pins then return Err(s"--serial ${s.name()}: the board routes `${s.name()}`'s tx and rx to no pins, under `buses`")
    write_bytes(file, []).map_err(e -> s"$file: $e")?
    s.out = frozen_text(file)
    Ok(())

private[virt] boot_usart(s: *UsartState)
    if !s.file().is_empty() then _ = write_bytes(s.file(), [])
    s.live.with(u -> u.reset())
    atomic_store(&s.next, NEVER, Release)
    atomic_store(&s.level, 0, Release)

private publish_usart(s: *UsartState, u: *uart.Usart)
    atomic_store(&s.next, u.due(), Release)
    atomic_store(&s.level, if u.irq() then 1 else 0, Release)

// Which way `s`'s line reaches the host's terminal or its file now: each pin in the USART's alternate
// function.
private usart_routes(m: *Machine, s: *UsartState) -> (bool, bool)
    if !s.pins || (!s.terminal && s.file().is_empty()) then return (false, false)
    val storage = &m.devices.storage
    (storage_gpio_alternate(storage, s.tx.bank, s.tx.pin, s.af),
     storage_gpio_alternate(storage, s.rx.bank, s.rx.pin, s.af))

// Bring `s`'s model `u` up to `time`: what it has sent goes to the console or its file, and a character
// typed starts arriving where the receiver would take one. `routes` is `usart_routes`, asked before
// the lock.
private bring_usart(m: *Machine, s: *UsartState, u: *uart.Usart, routes: (bool, bool), time: u64)
    u.advance(time)
    val (tx, rx) = routes
    val file = s.file()
    if file.is_empty()
        loop
            u.sent.pop_front() match
                Some(c) -> if tx then console_put(&m.console, u8.wrap(c))
                None -> break
    else
        var chunk: [256]u8
        var n: usize = 0
        loop
            u.sent.pop_front() match
                Some(c) ->
                    if !tx then continue
                    chunk[n] = u8.wrap(c)
                    n += 1
                    if n == FILE_CHUNK
                        _ = append_bytes(file, chunk[..])
                        n = 0
                None -> break
        if n > 0 then _ = append_bytes(file, chunk[0..<n])
    if rx && s.input && u.receiving()
        console_take(&m.console) match
            Some(b) -> u.receive(u16(b), time)
            None -> ()
    publish_usart(s, u)

private[virt] usart_due(s: *UsartState) -> u64 = atomic_load(&s.next, Acquire)

private[virt] usart_wake(s: *UsartState, cpu: *Cpu) -> u64
    if !s.present || s.irq < 0 || !could_wake(cpu, IRQ0 + u32(s.irq)) then return NEVER
    if atomic_load(&s.level, Acquire) != 0 then board_time(cpu, cpu.retired) else usart_due(s)

/** Whether typed input would wake `cpu` through the USART `s`: typed input reaches its receiver, the
 * guest is waiting on its receiver's interrupt, and the input has not ended.
 */
private[virt] usart_listens(m: *Machine, s: *UsartState, cpu: *Cpu) -> bool
    if !s.present || !s.input || s.irq < 0 || !could_wake(cpu, IRQ0 + u32(s.irq)) then return false
    if console_status(&m.console) == ENDED then return false
    val (_, rx) = usart_routes(m, s)
    val listening = reg.CR1_UE_MASK | reg.CR1_RE_MASK | reg.CR1_RXNEIE_MASK
    rx && s.live.with(u -> u.cr1 & listening == listening)

private[virt] signal_usart(m: *Machine, s: *UsartState, cpu: *Cpu)
    if !s.present then return
    val time = board_time(cpu, cpu.retired)
    // Only the line's events and typed input change the model here: a USART no input reaches, with no
    // event due by `time`, has nothing to bring up, and an idle one is not locked at every slice.
    if s.input || usart_due(s) <= time
        val routes = usart_routes(m, s)
        s.live.with(u -> bring_usart(m, s, u, routes, time))
    if atomic_load(&s.level, Acquire) != 0 && s.irq >= 0 && !exception_active(cpu, IRQ0 + u32(s.irq)) then raise(cpu, u32(s.irq))

// RDR and TDR take a byte, a halfword or a word; every other register only a word, which the model
// checks. Any access off its own alignment faults.
private usart_access(cpu: *Cpu, address: u32, offset: u32, width: u32) -> bool
    if (width == 1 || width == 2 || width == 4) && offset & (width - 1) == 0 then return true
    halt(cpu, Stop.Fault, address)
    false

private[virt] usart_read(m: *Machine, s: *UsartState, cpu: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if !usart_access(cpu, address, offset, width) then return 0
    val time = board_time(cpu, n)
    val routes = usart_routes(m, s)
    s.live.with(u ->
        bring_usart(m, s, u, routes, time)
        val value = u.read(offset, width, time)
        publish_usart(s, u)
        value) match
        Some(value) -> value
        None ->
            unmodelled_register(cpu, address, f"the STM32 USART + 0x$offset%03x")
            0

private[virt] usart_write(m: *Machine, s: *UsartState, cpu: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if !usart_access(cpu, address, offset, width) then return
    val time = board_time(cpu, n)
    val routes = usart_routes(m, s)
    val ok = s.live.with(u ->
        bring_usart(m, s, u, routes, time)
        val ok = u.write(offset, width, value, time)
        publish_usart(s, u)
        ok)
    if !ok then halt(cpu, Stop.Fault, address)
    val next = usart_due(s)
    if next != NEVER then lower_limit(cpu, retirement_limit(cpu, next))
