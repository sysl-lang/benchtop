module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board,param_named,part_model,part_whole}
import sh.sysl.benchtop.peripheral.dsi as dsi
import sh.sysl.benchtop.parts.mipi_dcs as dcs
import sh.sysl.benchtop.v6m.{Cpu,Stop,NEVER,halt,lower_limit}
import sysl.buf.{Buf,buf}
import sysl.sync.*
import sysl.threads.SleepLock

var dsi_host = dsi.host(480000000)
private[virt] var has_dsi = false
private[virt] var dsi_reg_lock = SleepLock.new()
private var dsi_next: u64 = NEVER
private val dsi_sink: dsi.Endpoint = (vc,kind,bytes) -> dsi_endpoint(vc,kind,bytes)

private[virt] configure_dsi(b: Board) -> Result[unit,string]
    has_dsi = false
    var reference: u64 = 25000000
    for p in b.chip.peripherals
        if p.kind != "stm32-dsi" then continue
        has_dsi = true
        param_named(p.params,"reference-clock-hz") match
            Some(q) -> q.value match
                Whole(n) -> reference = u64(n)
                _ -> ()
            None -> ()
    if has_dsi && board_clock_hz == 0 then return Err("stm32-dsi requires mcu.clock-hz for its transfer timebase")
    dsi_host = dsi.host(if has_dsi then board_clock_hz else 480000000,reference)
    atomic_store(&dsi_next,NEVER,Release)
    var channels: u32 = 0
    for p in b.parts
        if part_model(p) != "mipi-dcs-display" then continue
        if !has_dsi then return Err("DSI display requires a stm32-dsi peripheral")
        val vc = u32(part_whole(p,"channel",0))
        if channels & (1u32 << vc) != 0 then return Err("two DSI displays share a virtual channel")
        channels |= 1u32 << vc
    Ok(())

private[virt] boot_dsi()
    dsi_host = dsi.host(dsi_host.hz,dsi_host.reference_hz)
    dsi_host.defer_reads = dsi_async
    atomic_store(&dsi_next,NEVER,Release)

// CPU-side completion enqueues only; display interpretation runs on its worker.
private dsi_endpoint(vc: u32, kind: u32, payload: []const u8) -> Buf[u8]
    if dsi_async
        enqueue_dsi_packet(vc,kind,payload,dsi_host.request_id)
        return buf()
    display_lock.lock()
    defer display_lock.unlock()
    apply_dsi_packet(vc,kind,payload)

// Invoked under display_lock by the device worker (or deterministic fallback).
private[virt] apply_dsi_packet(vc: u32, kind: u32, payload: []const u8) -> Buf[u8]
    var response: Buf[u8] = buf()
    for b in tft_bindings
        if b.dsi_channel != int(vc) then continue
        if kind == 0x05 || kind == 0x15 || kind == 0x39
            if payload.len == 0 then return response
            dcs.write(b.model,false,payload[0])
            for i in 1..<payload.len do dcs.write(b.model,true,payload[i])
        elif kind == 0x06 && payload.len == 1
            payload[0] match
                0x0a -> response.push(0x88 | (if b.model.sleeping then 0 else 16) | (if b.model.enabled then 4 else 0))
                0x0b -> response.push(b.model.madctl)
                0x0c -> response.push((b.model.format << 4) | b.model.format)
                _ -> ()
    response

// Only the CPU owning an actual due event enters the display's critical
// section. An idle peripheral must not couple guest execution to UI painting.
private[virt] signal_dsi(c: *Cpu)
    if !has_dsi then return
    val time = board_time(c,c.retired)
    val due = atomic_load(&dsi_next,Acquire)
    if due == NEVER || time < due then return
    dsi_reg_lock.lock()
    defer dsi_reg_lock.unlock()
    advance_dsi(time)
    publish_dsi_deadline()

private[virt] dsi_due() -> u64
    if !has_dsi then return NEVER
    atomic_load(&dsi_next,Acquire)

// The register lock is held by the caller. Publish after every state change,
// including MMIO-driven completion and reset/cancellation of a queued packet.
private[virt] publish_dsi_deadline()
    val blocked = dsi_async && !dsi_queue_has_room()
    atomic_store(&dsi_next,if dsi_host.busy && !blocked then dsi_host.due else NEVER,Release)

private[virt] advance_dsi(time: u64)
    if dsi_async && dsi_host.busy && !dsi_host.response_pending && !dsi_queue_has_room() then return
    dsi.advance(dsi_host,time,dsi_sink)

private[virt] dsi_read(c: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if width != 4 || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return 0
    dsi_reg_lock.lock()
    defer dsi_reg_lock.unlock()
    advance_dsi(board_time(c,n))
    publish_dsi_deadline()
    dsi.read(dsi_host,offset) match
        Some(v) -> v
        None ->
            halt(c,Stop.Unmapped,address)
            0

private[virt] dsi_write(c: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if width != 4 || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return
    dsi_reg_lock.lock()
    defer dsi_reg_lock.unlock()
    advance_dsi(board_time(c,n))
    if !dsi.write(dsi_host,offset,value) then halt(c,Stop.Fault,address)
    publish_dsi_deadline()
    if dsi_host.busy then lower_limit(c,retirement_limit(c,dsi_host.due))
