module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board,param_named,part_model,part_whole}
import sh.sysl.benchtop.peripheral.Model
import sh.sysl.benchtop.peripheral.dsi as dsi
import sh.sysl.benchtop.parts.mipi_dcs as dcs
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.benchtop.v6m.{Cpu,Stop,halt,lower_limit}
import sysl.buf.{Buf,buf}
import sysl.sync.*
import sysl.threads.Mutex

/** The DSI host (`stm32-dsi`): whether the bus has it, the clock of its next event, published for the
 * cores to read without the lock, the core that brings its events in (`claim_device`), and the packet
 * engine, which both cores and the DSI worker reach, wired to where its packets go (`connect_dsi`):
 * the machine's DSI worker (`worker`) while it runs, the displays otherwise.
 */
struct DsiState
    present: bool
    next: u64
    driver: u32
    host: Mutex[dsi.Host]
    worker: *DsiWorker

/** No DSI host on the bus. */
dsi_state() -> DsiState = DsiState(false, NEVER, 0, Mutex.new(dsi.host(480000000)), null)

/** Send the host's packets to the displays of `ds`, through `worker` while it runs. Called once the
 * devices are in place, since the sink holds their address.
 */
private[virt] connect_dsi(ds: *Devices, worker: *DsiWorker)
    ds.dsi.worker = worker
    ds.dsi.host.with(h -> h.sink = (vc,kind,bytes,request) -> dsi_endpoint(ds,vc,kind,bytes,request))

// The DSI host `b` makes on a chip whose clock is `clock_hz`, and a check of the panels on it.
private[virt] check_dsi(b: Board, clock_hz: u64) -> Result[DsiState,string]
    var present = false
    var reference: u64 = 25000000
    for p in b.chip.peripherals
        if p.kind != "stm32-dsi" then continue
        present = true
        param_named(p.params,"reference-clock-hz") match
            Some(q) -> q.value match
                Whole(n) -> reference = u64(n)
                _ -> ()
            None -> ()
    if present && clock_hz == 0 then return Err("stm32-dsi requires mcu.clock-hz for its transfer timebase")
    var channels: u32 = 0
    for p in b.parts
        if part_model(p) != "mipi-dcs-display" then continue
        if !present then return Err("DSI display requires a stm32-dsi peripheral")
        val vc = u32(part_whole(p,"channel",0))
        if channels & (1u32 << vc) != 0 then return Err("two DSI displays share a virtual channel")
        channels |= 1u32 << vc
    Ok(DsiState(present, NEVER, 0, Mutex.new(dsi.host(if present then clock_hz else 480000000,reference)), null))

private[virt] boot_dsi(s: *DsiState)
    val deferred = dsi_async(s.worker)
    s.host.with(h ->
        h.reset()
        h.defer_reads = deferred)
    atomic_store(&s.next,NEVER,Release)
    atomic_store(&s.driver,0,Release)

// CPU-side completion enqueues only; display interpretation runs on its worker.
private dsi_endpoint(ds: *Devices, vc: u32, kind: u32, payload: []const u8, request: u64) -> Buf[u8]
    if dsi_async(ds.dsi.worker)
        enqueue_dsi_packet(ds.dsi.worker,vc,kind,payload,request)
        return buf()
    var response: Buf[u8] = buf()
    val into = &response
    ds.displays.live.with(s -> apply_dsi_packet(s,vc,kind,payload,into))
    response

// Deliver a packet to the panels on its virtual channel, under the displays' lock, by the device
// worker (or deterministic fallback); a read's answer goes to `response`.
private[virt] apply_dsi_packet(s: *DisplayState, vc: u32, kind: u32, payload: []const u8, response: *Buf[u8])
    for b in s.tfts
        if b.dsi_channel != int(vc) then continue
        if kind == 0x05 || kind == 0x15 || kind == 0x39
            if payload.len == 0 then return
            dcs.write(b.model,false,payload[0])
            for i in 1..<payload.len do dcs.write(b.model,true,payload[i])
        elif kind == 0x06 && payload.len == 1
            payload[0] match
                0x0a -> response.push(0x88 | (if b.model.state.sleeping then 0 else 16) | (if b.model.state.enabled then 4 else 0))
                0x0b -> response.push(b.model.state.madctl)
                0x0c -> response.push((b.model.state.format << 4) | b.model.state.format)
                _ -> ()

// Only the CPU owning an actual due event enters the display's critical
// section. An idle peripheral must not couple guest execution to UI painting.
private[virt] signal_dsi(s: *DsiState, c: *Cpu)
    if !s.present || !drives_device(&s.driver,c) then return
    val time = board_time(c,c.retired)
    val due = atomic_load(&s.next,Acquire)
    if due == NEVER || time < due then return
    s.host.with(h ->
        advance_dsi(s,h,time)
        publish_dsi_deadline(s,h))

private[virt] dsi_due(s: *DsiState) -> u64
    if !s.present then return NEVER
    atomic_load(&s.next,Acquire)

// The next event, for the core that brings the DSI host's events in; NEVER for the other.
private[virt] dsi_due_for(s: *DsiState, c: *Cpu) -> u64 = if drives_device(&s.driver,c) then dsi_due(s) else NEVER

// Under the host's lock. Publish after every state change, including MMIO-driven completion and
// reset/cancellation of a queued packet.
private[virt] publish_dsi_deadline(s: *DsiState, h: *dsi.Host)
    val blocked = dsi_async(s.worker) && !dsi_queue_has_room(s.worker)
    atomic_store(&s.next,if !blocked then h.due() else NEVER,Release)

// Under the host's lock.
private[virt] advance_dsi(s: *DsiState, h: *dsi.Host, time: u64)
    if dsi_async(s.worker) && h.busy && !h.response_pending &&!dsi_queue_has_room(s.worker) then return
    h.advance(time)

private[virt] dsi_read(s: *DsiState, c: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if width != 4 || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return 0
    s.host.with(h ->
        advance_dsi(s,h,board_time(c,n))
        publish_dsi_deadline(s,h)
        h.read(offset,width,h.time)) match
        Some(v) -> v
        None ->
            halt(c,Stop.Unmapped,address)
            0

private[virt] dsi_write(s: *DsiState, c: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if width != 4 || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return
    claim_device(&s.driver,c)
    s.host.with(h ->
        advance_dsi(s,h,board_time(c,n))
        if !h.write(offset,width,value,h.time) then halt(c,Stop.Fault,address)
        publish_dsi_deadline(s,h)
        if h.busy then lower_limit(c,retirement_limit(c,h.arrives)))
