module sh.sysl.benchtop.virt

// The STM32H747's power controller (`stm32h7-pwr`) on the board: the register model
// (peripheral/stm32_pwr), which both cores reach, timed on the board clock. Its `supply` says how the
// board's hardware supplies the core domain, the direct SMPS where the description names none, as on
// the STM32H747I-DISCO.

import sh.sysl.benchtop.{Board, mcu_clock_hz, param_named}
import sh.sysl.benchtop.peripheral.Model
import sh.sysl.benchtop.v6m.{Cpu, Stop, halt}
import sh.sysl.benchtop.peripheral.stm32_pwr as power
import sysl.threads.Mutex

// A regulator change settles in 10 µs of guest time.
private const SETTLE_US: u64 = 10

/** The PWR block: the register model, which either core's access changes. */
struct PwrState
    live: Mutex[power.Pwr]

/** The PWR as a board without one leaves it. */
pwr_state() -> PwrState = PwrState(Mutex.new(power.pwr()))

/** The PWR `b` makes on a chip whose clock is `clock_hz` (0 where it names none). */
private[virt] check_pwr(b: Board, clock_hz: u64) -> PwrState
    for p in b.chip.peripherals
        if p.kind != "stm32h7-pwr" then continue
        var supply = power.Supply.DirectSmps
        param_named(p.params, "supply") match
            Some(q) -> q.value match
                Text(name) -> supply = power.supply_named(name).unwrap_or(supply)
                _ -> ()
            None -> ()
        val hz = if clock_hz != 0 then clock_hz else mcu_clock_hz(b.chip)
        return PwrState(Mutex.new(power.pwr(supply, hz * SETTLE_US / 1000000)))
    pwr_state()

private[virt] boot_pwr(s: *PwrState) = s.live.with(p -> p.reset())

/** The voltage scale the core domain runs at board time `time`, 1 (the fastest) to 3. */
pwr_scale(s: *PwrState, time: u64) -> u32 = s.live.with(p -> power.vos_scale(p, time))

// Every PWR register is a word; another width or alignment faults, and an offset with no register
// is unmapped.
private pwr_access(c: *Cpu, address: u32, offset: u32, width: u32) -> bool
    if width == 4 && offset & 3 == 0 then return true
    halt(c, Stop.Fault, address)
    false

private[virt] pwr_read(s: *PwrState, c: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if !pwr_access(c, address, offset, width) then return 0
    val time = board_time(c, n)
    s.live.with(p -> p.read(offset, width, time)) match
        Some(value) -> value
        None ->
            halt(c, Stop.Unmapped, address)
            0

private[virt] pwr_write(s: *PwrState, c: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if !pwr_access(c, address, offset, width) then return
    val time = board_time(c, n)
    if !s.live.with(p -> p.write(offset, width, value, time)) then halt(c, Stop.Unmapped, address)
