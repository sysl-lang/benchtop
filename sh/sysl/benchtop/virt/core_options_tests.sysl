module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{Cpu, Kind, Stop, NVIC_IPR, load32, store32}
import sysl.raw.str_cast

private configured_board(options0: string, options1: string) -> string =
    s"board { name = options, mcu { name = options, cores = [{ core = cortex-m7, $options0 }, { core = cortex-m7, $options1 }], peripherals { ram { peripheral = ram, at = 0, size = 1M }, console { peripheral = debug-console, at = 0x40000000, irq = 0 }, sio { peripheral = virt-sio, at = 0xD0000000, irq = 1 } } } }"

@test("per-core priority widths survive boot, core 1 launch, both schedulers and a later default board")
core_options_priority_boot()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    for parallel in [false, true]
        on_board(m, "options.hocon", configured_board("nvic-priority-bits = 3", "nvic-priority-bits = 8").bytes)
        open_console(m)
        capture(m)
        type_in(m, [])
        image_of(m, dual_m7) match
            Ok(img) -> boot(m, img.view())
            Err(why) -> assert(false, why)
        assert(cpu.priority_bits == 3 && core1(m).priority_bits == 8, "boot applies each core's settings")
        if parallel then set_threads()
        val stopped = run_board(m)
        assert(stopped.stop == Stop.Exit && stopped.exit_code == 0, str_cast(output(m).view()))
        assert(cpu.priority_bits == 3 && core1(m).priority_bits == 8, "launch preserves core 1's configuration")
        store32(cpu, NVIC_IPR, 0xFFFFFFFF)
        store32(core1(m), NVIC_IPR, 0xFFFFFFFF)
        assert(load32(cpu, NVIC_IPR) == 0xE0E0E0E0 && load32(core1(m), NVIC_IPR) == 0xFFFFFFFF, "different widths affect guest registers")
    end for

    run_on(m, "virt7", crunch_m7, false)
    assert(cpu.priority_bits == 4 && core1(m).priority_bits == 4, "plain board restores defaults")
    run_on(m, "virt", crunch_m0, false)
    assert(cpu.kind == Kind.V6m && cpu.priority_bits == 2 && core1(m).priority_bits == 2, "M0+ defaults unchanged")
end core_options_priority_boot

@test("run refuses every declared feature it cannot emulate before booting a guest")
core_options_unimplemented()
    val board = machine()
    val m = &*board
    for option in ["mpu-regions = 8", "icache = true", "dcache = true"]
        board_from(m, "options.hocon", configured_board(option, "").bytes) match
            Ok(_) -> assert(false, option)
            Err(why) -> assert(why.contains("does not emulate") && why.contains(option), why)
    end for

    val trustzone = "board { name = secure, mcu { name = secure, cores = [{ core = cortex-m33, security = trustzone }, cortex-m33], peripherals { ram { peripheral = ram, at = 0, size = 1M } } } }"
    board_from(m, "secure.hocon", trustzone.bytes) match
        Ok(_) -> assert(false, "TrustZone is not emulated")
        Err(why) -> assert(why.contains("security = trustzone"), why)
end core_options_unimplemented
