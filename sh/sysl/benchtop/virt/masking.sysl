module sh.sysl.benchtop.virt

// The masking report of a virtual board's cores (v6m/masking.sysl): how long each core runs with
// interrupts masked, and how long each interrupt waits to be taken.

import sh.sysl.benchtop.v6m.{masking_text, record_masking}

/** Record the masked intervals and interrupt latencies of both of `m`'s cores from now on, from
 * nothing: after `boot`, whose reset ends whatever was open. Core 1's launch keeps its record. */
record_board_masking(m: *Machine)
    record_masking(&m.cores[0])
    record_masking(&m.cores[1])

/** The masking report of `m`'s cores: core 0's, then core 1's where it was launched. */
board_masking_text(m: *Machine) -> string
    val first = masking_text(&m.cores[0], 0)
    if !running_both(m) then return first
    s"$first${masking_text(&m.cores[1], 1)}"
