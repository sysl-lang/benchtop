module sh.sysl.benchtop.virt

// The masking report of a board's Cortex-M cores (v6m/masking.sysl): how long each core runs with
// interrupts masked, and how long each interrupt waits to be taken. A virtual board's machine, and any
// board a front end drives as a `Guest` (an RP board's Cortex-M33s or Cortex-M0+s), record it on the
// cores themselves.

import sh.sysl.benchtop.v6m.{MaskingOptions, masking_defaults, masking_text, record_masking}

/** Why the masking report is refused on a board of RISC-V harts. */
const MASKING_CORTEX_ONLY = "--report-masking is for a board of Cortex-M cores: the Hazard3 harts mask interrupts through mstatus and mie, which the report does not read"

/** Record the masked intervals and interrupt latencies of both of `m`'s cores from now on, from
 * nothing: after `boot`, whose reset ends whatever was open. Core 1's launch keeps its record. */
record_board_masking(m: *Machine, o: MaskingOptions = masking_defaults())
    record_masking(&m.cores[0], o)
    record_masking(&m.cores[1], o)

/** The masking report of `m`'s cores: core 0's, then core 1's where it was launched. */
board_masking_text(m: *Machine) -> string
    val first = masking_text(&m.cores[0], 0)
    if !running_both(m) then return first
    s"$first${masking_text(&m.cores[1], 1)}"

/** Record the masked intervals and interrupt latencies of every Cortex-M core of `g` from now on, from
 * nothing, after the board has booted; or why it cannot: a board of RISC-V harts has no such core. */
record_guest_masking(g: &Guest, o: MaskingOptions = masking_defaults()) -> Result[unit, string]
    val n = g.cores()
    if n == 0 then return Err(MASKING_CORTEX_ONLY)
    for k in 0..<n do record_masking(g.core(k), o)
    Ok(())

/** The masking report of `g`'s Cortex-M cores, in order, each one that has started. */
guest_masking_text(g: &Guest) -> string
    var text = ""
    for k in 0..<g.cores() do if g.started(k) then text = s"$text${masking_text(g.core(k), k)}"
    text
