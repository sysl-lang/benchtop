module sh.sysl.benchtop.virt
@tests
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sh.sysl.fat as fat
import sh.sysl.wav as wav
import sysl.raw.str_cast
import sysl.text.replace_all
import sysl.buf.{Buf,buf}
import sysl.fs
import sysl.io.bytes_at

private val RECORD_GUEST = embed("../../../../examples/touch/storage-disco.elf")
private record_chunks(m: *Machine, count: int)
    var signal: [240]f32 = [0.0;240]
    for i in 0..<240 do signal[i] = if i % 48 < 24 then 0.25 else -0.25
    for i in 0..<count
        feed_microphone(m, signal[..])
        submit_workers(2400000)
        wait_workers()
private record_tap(m: *Machine)
    touch_point(m, "touch",400,332,true)
    record_chunks(m, 8)
    touch_point(m, "touch",400,332,false)
    record_chunks(m, 8)

private recorded_file(m: *Machine) -> Buf[u8]
    val storage = blank_card()
    var disk = fat.ram_device(storage.view())
    val image = sd_image(m)
    for sector in 0u64..<32768 do disk.write(sector,image.view()[usize(sector)*512..<usize(sector+1)*512]).unwrap()
    var scratch: [512]u8 = [0;512]
    var volume = fat.mount(&disk,scratch[..]).unwrap()
    var file = volume.open("RECORD.WAV").unwrap()
    var bytes: Buf[u8] = buf()
    var payload: [512]u8 = [0;512]
    loop
        val got = volume.read(&file,payload[..]).unwrap()
        if got == 0 then break
        for i in 0..<got do bytes.push(payload[i])
    bytes

@test("Discovery WAV: real microphone DMA records stereo PCM16 through FAT/SD while DSP continues, then finalizes a readable file")
recording_firmware()
    val dir = fs.make_temp_dir("benchtop-recording").unwrap()
    defer fs.remove_dir_all(dir).unwrap()
    val card = s"$dir/recording-regression.img"
    val description = replace_all(str_cast(embed("../../../../boards/stm32h747-sd.hocon")),"target/disco-sd.img",card)
    val storage = blank_card()
    var disk = fat.ram_device(storage.view())
    fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
    fs.write_bytes(card,disk.image()).unwrap()
    val board = machine()
    val m = &*board
    board_from(m, "recording-test.hocon",description.bytes).unwrap()
    boot(m,image_of(m, RECORD_GUEST).unwrap().view())
    val executable = elf.read(RECORD_GUEST).unwrap()
    val state = u32(executable.symbol_named("record_status").unwrap().unwrap().value)
    val overruns = u32(executable.symbol_named("record_overruns").unwrap().unwrap().value)
    val errors = u32(executable.symbol_named("audio_errors").unwrap().unwrap().value)
    val misses = u32(executable.symbol_named("audio_deadline_misses").unwrap().unwrap().value)
    start_workers(m).unwrap()
    defer stop_workers()
    submit_workers(240000000)
    wait_workers()
    record_tap(m)
    record_chunks(m,1000)
    pause_workers()
    assert(workers_observe().running,stop_message(core1(m)))
    assert(cpu.load32(core0(m),state) == 1,s"record state=${cpu.load32(core0(m),state)} overruns=${cpu.load32(core0(m),overruns)}")
    record_tap(m)
    record_chunks(m,150)
    pause_workers()
    assert(workers_observe().running,stop_message(core1(m)))
    assert(cpu.load32(core0(m),state) == 3,s"finish state=${cpu.load32(core0(m),state)} overruns=${cpu.load32(core0(m),overruns)}")
    assert(cpu.load32(core0(m),overruns) == 0)
    val (multi, double, completions, blocks) = m.devices.sdmmc.live.with(l -> (l.host.stats.multi_transfers, l.host.stats.double_transfers, l.host.stats.buffer_completions, l.host.stats.blocks))
    assert(multi > 0 && double > 0 && completions > 0,"the actual FAT/WAV path must exercise multiblock commands and both IDMA buffers")
    fs.make_dir_all("target").unwrap()
    fs.write_text("target/sdmmc-bulk-stats.txt",s"multiblock=$multi double-buffer=$double buffer-completions=$completions blocks=$blocks\n").unwrap()
    assert(cpu.load32(core0(m),errors) == 0 && cpu.load32(core0(m),misses) == 0)
    val persisted = fs.read_bytes(card).unwrap()
    val image = sd_image(m)
    for i in 0..<persisted.len do assert(persisted[i] == image.view()[i],"record finalization must flush every accepted sector to disk")
    val bytes = recorded_file(m)
    var source = bytes_at(bytes.view())
    val info = wav.inspect(&source).unwrap()
    assert(info.format == wav.format(48000,2,wav.Encoding.Pcm16))
    assert(info.frames > 230000 && info.frames < 260000,s"frames=${info.frames}")
    assert(bytes.len() == usize(info.data_offset) + usize(info.data_bytes))
    var nonzero = false
    for i in 0..<usize(info.frames)
        val at = usize(info.data_offset) + i * 4
        assert(bytes.at(at) == bytes.at(at + 2) && bytes.at(at + 1) == bytes.at(at + 3),"mono host input must retain identical stereo slots")
        if bytes.at(at) != 0 || bytes.at(at + 1) != 0 then nonzero = true
    assert(nonzero,"recording must contain captured audio even with MONITOR off")
    fs.write_bytes("target/disco-recording-test.wav",bytes.view()).unwrap()

    // Complete the actual record/save/play cycle through the same card and
    // firmware, then return to recording to exercise buffer ownership reversal.
    touch_point(m, "touch",474,332,true)
    record_chunks(m,16)
    touch_point(m, "touch",474,332,false)
    record_chunks(m,1100)
    pause_workers()
    val play_state = u32(executable.symbol_named("play_status").unwrap().unwrap().value)
    val played = u32(executable.symbol_named("play_tail").unwrap().unwrap().value)
    val underruns = u32(executable.symbol_named("play_underruns").unwrap().unwrap().value)
    assert(cpu.load32(core0(m),play_state) == 3,"a freshly recorded file must play through to EOF")
    assert(u64(cpu.load32(core0(m),played)) == info.frames && cpu.load32(core0(m),underruns) == 0)

    // Losing write permission during recording must report failure and let M7
    // continue. Never present an unfinalized/failed file as REC SAVED.
    record_tap(m)
    pause_workers()
    with_sd_card(m, c -> c.protected = true)
    record_chunks(m,100)
    pause_workers()
    assert(cpu.load32(core0(m),state) == 4,"SD write failure must reach the UI")
    assert(cpu.load32(core0(m),errors) == 0 && cpu.load32(core0(m),misses) == 0)

@test("Discovery WAV: a slow card overruns a bounded buffer without blocking M7 and finalizes the captured prefix")
recording_overrun()
    val description = replace_all(str_cast(embed("../../../../boards/stm32h747-sd.hocon")),"target/disco-sd.img","")
    val board = machine()
    val m = &*board
    board_from(m, "slow-recording-test.hocon",description.bytes).unwrap()
    val storage = blank_card()
    var disk = fat.ram_device(storage.view())
    fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
    sd_seed_image(m, disk.image())
    boot(m,image_of(m, RECORD_GUEST).unwrap().view())
    val executable = elf.read(RECORD_GUEST).unwrap()
    val state = u32(executable.symbol_named("record_status").unwrap().unwrap().value)
    val overruns = u32(executable.symbol_named("record_overruns").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("record_frames").unwrap().unwrap().value)
    val errors = u32(executable.symbol_named("audio_errors").unwrap().unwrap().value)
    val misses = u32(executable.symbol_named("audio_deadline_misses").unwrap().unwrap().value)
    start_workers(m).unwrap()
    defer stop_workers()
    submit_workers(240000000)
    wait_workers()
    record_tap(m)
    pause_workers()
    with_sd_card(m, c -> c.program_ticks = 96000000) // 200ms programming, below SD's 500ms timeout
    record_chunks(m,256)
    pause_workers()
    assert(cpu.load32(core0(m),overruns) > 0,"card latency must exceed the 341ms ring budget")
    with_sd_card(m, c -> c.program_ticks = 0)
    record_chunks(m,300)
    pause_workers()
    assert(workers_observe().running,stop_message(core1(m)))
    assert(cpu.load32(core0(m),state) == 5,s"slow-card state=${cpu.load32(core0(m),state)}")
    assert(cpu.load32(core0(m),errors) == 0 && cpu.load32(core0(m),misses) == 0)
    val bytes = recorded_file(m)
    var source = bytes_at(bytes.view())
    val info = wav.inspect(&source).unwrap()
    assert(info.frames == u64(cpu.load32(core0(m),frames)) && info.frames > 0)
