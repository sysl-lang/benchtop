module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu

@test("RAM banks: board descriptions coalesce adjacent physical banks before ELF and CPU mapping")
board_ram_banks()
    val text = "board { name = banks, mcu { name = mixed, cores = [cortex-m4,cortex-m4], peripherals { second { peripheral = ram, at = 0x24001000, size = 4K }, separate { peripheral = ram, at = 0x30000000, size = 4K }, first { peripheral = ram, at = 0x24000000, size = 4K } } } }"
    board_from("banks.hocon",text.bytes) match
        Ok(_) -> ()
        Err(why) -> assert(false,why)
    boot(core0(),image_of([]).unwrap().view())
    assert(board_ram_at == 0x24000000 && board_ram_size == 8192 && board_extra_ram.len() == 1)
    cpu.store32(core0(),0x24000fff,0x12345678)
    assert(cpu.load32(core0(),0x24000fff) == 0x12345678)
    cpu.store16(core0(),0x24000ffe,0xf240)
    cpu.store16(core0(),0x24001000,0x0007)
    cpu.store16(core0(),0x24001002,0xbe00)
    core0().pc = 0x24000ffe
    cpu.set_limit(core0(),1000)
    cpu.run_threaded(core0())
    assert(core0().stop == cpu.Stop.Breakpoint && core0().r[0] == 7)
    cpu.store32(core0(),0x30000000,42)
    assert(cpu.load32(core0(),0x30000000) == 42)
