module sh.sysl.benchtop.virt

// A front end's session on the board: the run controller (restart, advance, pause, stop-to-status)
// and the board's input model (what each part's control is doing, and the pin levels and voltages
// that follow from it). The desktop, headless runs and tests all drive the board through it, so none
// of them needs to know which core the board has or how its parts are wired.

import sh.sysl.benchtop.{Part, part_flag, part_whole}
import sh.sysl.benchtop.parts.hd44780.Lcd
import sysl.buf.{Buf, buf}
import sysl.sync.*

/** A control's position: hundredths of a percent of its travel. */
const POSITION_MAX: int = 10000
/** Where a sprung control (a joystick axis) rests. */
const POSITION_CENTRE: int = 5000

/** The guest clock a session paces itself against, when the board does not name one. */
const TOUCH_HZ: u64 = 12000000
const FALLBACK_HZ: u64 = 1200000
/** The console a window's session keeps for its terminal pane, in bytes. */
const WINDOW_CAPTURE: usize = 8192
/** The instructions a frame of an unpaced session gives the guest. */
const FALLBACK_BUDGET: u64 = 20000

/** What the session is doing, as the desktop shows it. */
enum RunStatus derives Eq
    Preview
    Running
    Paused
    Waiting
    WaitingForBuild
    Breakpoint
    Exit(code: int)
    ResetRequest
    Fault

impl RunStatus
    label(self) -> string = self match
        Preview -> "LAYOUT PREVIEW"
        Running -> "RUNNING"
        Paused -> "PAUSED"
        Waiting -> "WAITING"
        WaitingForBuild -> "WAITING FOR BUILD"
        Breakpoint -> "BREAKPOINT"
        Exit(code) -> s"EXIT $code"
        ResetRequest -> "RESET REQUEST"
        Fault -> "GUEST FAULT"

/** The state of one part's control. A part with no control is `Inert`. */
enum PartInput derives Eq
    Inert
    Pressed(down: bool)
    Closed(on: bool)
    Position(at: int)
    Axes(x: int, y: int)

/** Which clock paces an interactive session: the board's own, its sound peripheral's, the touch
 * clock for a board with a touch screen, or a fixed slice per frame.
 */
enum PacingSource derives Eq
    BoardClock(hz: u64)
    SoundClock(hz: u64)
    TouchClock
    Fixed

impl PacingSource
    hz(self) -> u64 = self match
        BoardClock(hz) -> hz
        SoundClock(hz) -> hz
        TouchClock -> TOUCH_HZ
        Fixed -> FALLBACK_HZ

/** The pacing source for the board loaded on `m`; `touch` says whether its view binds a touch screen. */
pacing_source(m: *Machine, touch: bool) -> PacingSource =
    if clock_hz(m) != 0 then PacingSource.BoardClock(clock_hz(m))
    elif sound_available(m) then PacingSource.SoundClock(sound_clock_hz(m))
    elif touch then PacingSource.TouchClock
    else PacingSource.Fixed

/** A run of a board's firmware: the board (`guest`) — at first the machine it owns, on which
 * `board_named` assembles a board (`&session.machine`), or an RP board put in its place — its parts'
 * controls and where the run has got to.
 */
struct Session
    machine: &Machine
    guest: &Guest
    parts: Buf[Part]
    chip: string
    inputs: Buf[PartInput]
    live: bool
    paused: bool
    stopped: bool
    status: RunStatus
    message: string
    background: bool
    pc: u32
    instructions: u64

private clamp_position(at: int) -> int = if at < 0 then 0 elif at > POSITION_MAX then POSITION_MAX else at

/** The control of part `p` at rest: a button let go, a switch as described, a knob at its `position`,
 * a joystick centred.
 */
resting(p: Part) -> PartInput = p.kind match
    "button" | "reset-button" -> PartInput.Pressed(false)
    "switch" -> PartInput.Closed(part_flag(p, "closed", false))
    "potentiometer" -> PartInput.Position(clamp_position(int(part_whole(p, "position", 50)) * 100))
    "joystick" -> PartInput.Axes(POSITION_CENTRE, POSITION_CENTRE)
    _ -> PartInput.Inert

/** A session over `parts` on `chip`, with a machine of its own no board has been assembled on yet, its
 * console's last `capture` bytes kept for the front end; a session that is not `live` only previews
 * the layout.
 */
session(parts: Buf[Part], chip: string, live: bool, capture: usize = WINDOW_CAPTURE) -> &Session
    var inputs: Buf[PartInput] = buf()
    for p in parts do inputs.push(resting(p))
    val m = machine()
    Session(machine = m, guest = machine_guest(m, capture), parts = parts, chip = chip, inputs = inputs, live = live, paused = false, stopped = false,
        status = if live then RunStatus.Running else RunStatus.Preview, message = "", background = false, pc = 0, instructions = 0)

impl Session
    /** The session's machine, for the functions that take one. */
    board(&self) -> *Machine = &*self.machine

    private index(&self, name: string) -> Option[usize]
        for i in 0..<self.parts.len() do if self.parts[i].name == name then return Some(i)
        None

    /** What the named part's control is doing; `Inert` for a part with none. */
    part_input(&self, name: string) -> PartInput = self.index(name) match
        Some(i) -> self.inputs[i]
        None -> PartInput.Inert

    /** Set the named part's control. A position is held to the control's travel. */
    set_part_input(&self, name: string, input: PartInput)
        val i = self.index(name) match
            Some(i) -> i
            None -> return
        self.inputs[i] = input match
            Position(at) -> PartInput.Position(clamp_position(at))
            Axes(x, y) -> PartInput.Axes(clamp_position(x), clamp_position(y))
            other -> other

    /** A potentiometer's position. */
    position(&self, name: string) -> int = self.part_input(name) match
        Position(at) -> at
        _ -> 0

    /** A joystick's two axes; centred for any other part. */
    axes(&self, name: string) -> (int, int) = self.part_input(name) match
        Axes(x, y) -> (x, y)
        _ -> (POSITION_CENTRE, POSITION_CENTRE)

    closed(&self, name: string) -> bool = self.part_input(name) match
        Closed(on) -> on
        _ -> false

    pressed(&self, name: string) -> bool = self.part_input(name) match
        Pressed(down) -> down
        _ -> false

    toggle(&self, name: string) = self.set_part_input(name, PartInput.Closed(!self.closed(name)))

    /** Let go of every button; switches and knobs stay where they were put. */
    release_buttons(&self)
        for i in 0..<self.inputs.len()
            if self.inputs[i] == PartInput.Pressed(true) then self.inputs[i] = PartInput.Pressed(false)

    /** Drive the board's input pins and analogue sources from the parts' controls. */
    apply_inputs(&self)
        if self.live then self.guest.apply_inputs(self.parts.view(), self.inputs.view())

    /** Whether an output part (an LED) is lit by the pin it is wired to. */
    lit(&self, p: Part) -> bool = self.live && self.guest.lit(p)

    /** What each digit of the seven-segment display `p`, shown as `name`, shows now. */
    segments(&self, name: string, p: Part) -> [8]u8 = self.guest.segments(name, p)

    /** The HD44780 `p`, shown as `name`, as its controller stands. */
    lcd(&self, name: string, p: Part) -> Option[Lcd] = self.guest.lcd(name, p)

    /** Whether the buzzer `p`, shown as `name`, is sounding. */
    sounding(&self, name: string, p: Part) -> bool = self.guest.sounding(name, p)

    /** Whether the board has anything the host plays. */
    sounds(&self) -> bool = self.guest.sounds()

    /** Whether a reset button is held, which keeps the chip in reset until it is let go. */
    in_reset(&self) -> bool
        for i in 0..<self.parts.len()
            if self.parts[i].kind == "reset-button" && self.inputs[i] ==PartInput.Pressed(true) then return true
        false

    /** Boot `image` on the board and run it from the start. */
    restart(&self, image: []const u8)
        self.release_buttons()
        self.paused = false
        self.stopped = false
        self.status = RunStatus.Running
        self.message = ""
        self.instructions = 0
        self.pc = 0
        self.guest.restart(image) match
            Ok(pc) -> self.pc = pc
            Err(why) ->
                self.stopped = true
                self.paused = true
                self.status = RunStatus.Fault
                self.message = why

    /** A live session with nothing to run until a build delivers an image. */
    await_build(&self)
        self.stopped = true
        self.paused = true
        self.status = RunStatus.WaitingForBuild

    /** Start the board's own threads; from then on `advance` observes them rather than running the
     * cores itself. `parallel` gives each core a thread of its own.
     */
    start(&self, parallel: bool, hz: u64) -> Result[unit, string]
        self.guest.start(parallel, hz)?
        self.background = true
        Ok(())

    stop(&self) = self.guest.stop()

    pause(&self)
        if !self.live || self.stopped then return
        self.paused = !self.paused
        if self.background && self.paused then self.guest.pause()

    /** One frame of the guest: `budget` instructions run here, or, once the board's threads are started,
     * those threads paused, resumed or stepped to match. A paused frame advances nothing; `step` runs one
     * instruction and pauses. Answers the machine's workers' observation when they drive the board.
     */
    advance(&self, step: bool = false, budget: u64 = FALLBACK_BUDGET) -> Option[WorkerObservation]
        self.apply_inputs()
        if !self.live || self.stopped then return None
        val s = self.guest.advance(self.paused, step, budget)
        if step then self.paused = true
        self.pc = s.pc
        self.instructions = s.instructions
        self.status = s.status
        self.message = s.message
        s.status match
            Running | Waiting -> if self.paused then self.status = RunStatus.Paused
            Paused -> ()
            _ ->
                self.stopped = true
                self.paused = true
        s.observation

/** The size of `m`'s backing RAM, in bytes. */
ram_size(m: *Machine) -> usize = m.memory.ram.len

/** A little-endian `width`-byte value at `offset` into `m`'s backing RAM, read without stopping the
 * cores; `None` outside it.
 */
ram_peek(m: *Machine, width: usize, offset: usize) -> Option[u32]
    val mem = m.memory
    if width > 4 || offset + width > mem.ram.len then return None
    var n: u32 = 0
    for byte in 0..<width do n |= u32(atomic_load(&mem.ram[offset + byte], Relaxed)) << u32(byte * 8)
    Some(n)
