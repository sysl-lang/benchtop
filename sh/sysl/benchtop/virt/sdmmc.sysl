module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board,Target,param_named}
import sh.sysl.benchtop.peripheral.sdmmc as sdmmc
import sh.sysl.benchtop.parts.sd_card as card
import sh.sysl.benchtop.v6m as memory
import sysl.sync.*
import sysl.threads.Mutex

/** A pin of an STM32 GPIO bank, named by the bank. */
struct SdRoute
    bank: string
    pin: u32

/** The SDMMC (`stm32-sdmmc`): the IRQ it raises (-1 for none) and the pins its CK, CMD and D0-D3 are
 * routed to, which the board fixes; `next` and `level`, its next event's clock and its interrupt
 * line, published for the cores to read without its lock; and under `live` its host and the card on
 * it. A thread holding `live` may take the storage path's lock (for the GPIO banks), never the other
 * way round.
 */
struct SdmmcState
    present: bool
    irq: int
    next: u64
    level: u32
    routes: [6]SdRoute
    live: Mutex[SdmmcLive]

/** The SDMMC's host and the card on it, if any. */
struct SdmmcLive
    host: &sdmmc.Host
    card: Option[&card.Native]

private val sd_signal_names: [6]string = ["ck","cmd","d0","d1","d2","d3"]

/** No SDMMC on the bus. */
sdmmc_state() -> SdmmcState = SdmmcState(false, -1, memory.NEVER, 0, [SdRoute("",0);6], Mutex.new(SdmmcLive(sdmmc.host(), None)))

// The SDMMC `b` makes on a chip whose clock is `clock_hz`, its pins on the banks of `storage`, and
// `sd`, the card the storage path puts on it, if any.
private[virt] check_sdmmc(b: Board, clock_hz: u64, storage: *StorageState, sd: Option[&card.Card]) -> Result[SdmmcState,string]
    var s = sdmmc_state()
    var kernel: u64 = 60000000
    var name = ""
    for p in b.chip.peripherals
        if p.kind != "stm32-sdmmc" then continue
        s.present = true
        name = p.name
        if !p.irqs.is_empty() then s.irq = int(p.irqs.at(0).n)
        for q in p.params do if q.name == "kernel-clock-hz" then q.value match
            Whole(hz) -> kernel = u64(hz)
            _ -> ()
    if !s.present then return Ok(s)
    if clock_hz == 0 || kernel > clock_hz then return Err("SDMMC requires a valid MCU/kernel clock")
    // A board that does not wire the SDMMC's bus leaves its lines on no pin: the host runs, and no
    // card ever answers it.
    var wired = false
    for bus in b.buses do if bus.name == name then wired = true
    for i in 0usize..<6
        if !wired then break
        var found = false
        for bus in b.buses
            if bus.name != name then continue
            for signal in bus.signals
                if signal.name != sd_signal_names[i] then continue
                for bank in ["PA","PB","PC","PD","PE","PF","PG","PH","PI","PJ","PK"]
                    local_pin(signal.pin,bank) match
                        Some(pin) ->
                            if storage.live.with(l -> gpio_named(l,bank)).is_none() then return Err("SDMMC routed pin needs its STM32 GPIO bank")
                            s.routes[i] = SdRoute(bank,pin)
                            found = true
                        None -> ()
        if !found then return Err("SDMMC requires routed ck/cmd/d0/d1/d2/d3 pins")
    s.live = Mutex.new(SdmmcLive(sdmmc.host(clock_hz,kernel), sd match
        Some(c) -> Some(card.native(c))
        None -> None))
    Ok(s)

private[virt] boot_sdmmc()
    val s = &machine.devices.sdmmc
    s.live.with(l ->
        sdmmc.reset(l.host)
        l.card match
            Some(c) -> card.reset_native(c)
            None -> ())
    atomic_store(&s.next,memory.NEVER,Release)
    atomic_store(&s.level,0,Release)

private sdmmc_routed(s: *SdmmcState, l: *SdmmcLive) -> bool
    if s.routes[0].bank.is_empty() then return false
    val count = if l.host.clock & 0xc000 == 0x4000 then 6usize else 3usize
    for i in 0..<count
        val route = s.routes[i]
        if !storage_gpio_alternate(route.bank,route.pin,12) then return false
    true
private publish_sdmmc(s: *SdmmcState, l: *SdmmcLive)
    atomic_store(&s.next,sdmmc.due(l.host),Release)
    atomic_store(&s.level,if sdmmc.irq(l.host) then 1 else 0,Release)
private bring_sdmmc(s: *SdmmcState, l: *SdmmcLive, cpu: *memory.Cpu, time: u64)
    val read_ram: &Fn(u32,[]u8) -> bool = (address,out) ->
        if address & 3 != 0 || out.len & 3 != 0 || !cpu.mem.ram_range(address, u32(out.len)) then return false
        for i in 0..<(out.len / 4)
            val at = address + u32(i * 4)
            val value = memory.host_read(memory.page_for(cpu,at,4),at,4)
            for j in 0usize..<4 do out[i * 4 + j] = u8(value >> (u32(j) * 8))
        true
    val write_ram: &Fn(u32,[]const u8) -> bool = (address,bytes) ->
        if address & 3 != 0 || bytes.len & 3 != 0 || !cpu.mem.ram_range(address, u32(bytes.len)) then return false
        for i in 0..<(bytes.len / 4)
            var value: u32 = 0
            for j in 0usize..<4 do value |= u32(bytes[i * 4 + j]) << (u32(j) * 8)
            if !memory.device_store(cpu,address + u32(i * 4),4,value) then return false
        true
    sdmmc.advance(l.host,time,l.card,sdmmc_routed(s,l),read_ram,write_ram)
    publish_sdmmc(s,l)
private[virt] sdmmc_due() -> u64 = atomic_load(&machine.devices.sdmmc.next,Acquire)
private[virt] sdmmc_wake(cpu: *memory.Cpu) -> u64
    val s = &machine.devices.sdmmc
    if !s.present || s.irq < 0 || !memory.could_wake(cpu,memory.IRQ0 + u32(s.irq)) then return memory.NEVER
    if atomic_load(&s.level,Acquire) != 0 then board_time(cpu,cpu.retired) else sdmmc_due()
private[virt] signal_sdmmc(cpu: *memory.Cpu)
    val s = &machine.devices.sdmmc
    if !s.present then return
    val time = board_time(cpu,cpu.retired)
    if sdmmc_due() <= time then s.live.with(l -> bring_sdmmc(s,l,cpu,time))
    if atomic_load(&s.level,Acquire) != 0 && s.irq >= 0 && !memory.exception_active(cpu,memory.IRQ0 + u32(s.irq)) then memory.raise(cpu,u32(s.irq))
private[virt] sdmmc_read(cpu: *memory.Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if width != 4 || offset & 3 != 0
        memory.halt(cpu,memory.Stop.Fault,address)
        return 0
    val s = &machine.devices.sdmmc
    val time = board_time(cpu,n)
    s.live.with(l ->
        bring_sdmmc(s,l,cpu,time)
        sdmmc.read(l.host,offset,l.card,time)) match
        Some(value) -> value
        None ->
            memory.halt(cpu,memory.Stop.Unmapped,address)
            0
private[virt] sdmmc_write(cpu: *memory.Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if width != 4 || offset & 3 != 0
        memory.halt(cpu,memory.Stop.Fault,address)
        return
    val s = &machine.devices.sdmmc
    val time = board_time(cpu,n)
    val ok = s.live.with(l ->
        bring_sdmmc(s,l,cpu,time)
        val ok = sdmmc.write(l.host,offset,value,time)
        publish_sdmmc(s,l)
        ok)
    if !ok then memory.halt(cpu,memory.Stop.Fault,address)
    val next = sdmmc_due()
    if next != memory.NEVER then memory.lower_limit(cpu,retirement_limit(cpu,next))
