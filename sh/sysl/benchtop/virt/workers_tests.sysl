module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sysl.threads.current
import sysl.time.{monotonic,millis}
import sysl.raw.str_cast
import sh.sysl.elf as elf

@test("CPU workers: distinct persistent host threads, bounded work, pause, step and reset")
worker_lifecycle()
    val c = core0()
    val program = image([(0x100,SPINNER[..]),(0x200,SPINNER[..])])
    started(c,program.view())
    launch(0,0x7000,0x201)
    start_workers(c).unwrap()
    defer stop_workers()
    val ids = workers_observe().worker_ids
    assert(ids[0] != 0 && ids[1] != 0 && ids[0] != ids[1])
    assert(ids[0] != current().id && ids[1] != current().id,"guest cores must not run on the UI/caller thread")
    for batch in 0..<12
        submit_workers(10000)
        wait_workers()
        val snapshot = workers_observe()
        assert(snapshot.running && snapshot.worker_ids == ids)
        assert(snapshot.cores[0].retired > 0 && snapshot.cores[1].retired > 0)
    pause_workers()
    val before = workers_observe()
    val until = monotonic() + millis(5)
    while monotonic() < until do ()
    assert(workers_observe().cores[0].retired == before.cores[0].retired)
    step_workers()
    val stepped = workers_observe()
    assert(stepped.cores[0].retired == before.cores[0].retired + 1)
    assert(stepped.cores[1].retired == before.cores[1].retired + 1)
    boot(c,program.view())
    assert(workers_observe().worker_ids == ids && workers_observe().cores[0].retired == 0)
    submit_workers(10000)
    wait_workers()
    assert(workers_observe().cores[0].retired > 0 && workers_observe().cores[1].retired == 0)

@test("CPU workers: clock pacing progresses while the UI/caller does unrelated work")
worker_autonomous_clock()
    val c = core0()
    started(c,image([(0x100,SPINNER[..]),(0x200,SPINNER[..])]).view())
    launch(0,0x7000,0x201)
    start_workers(c,true,2000000).unwrap()
    defer stop_workers()
    val beginning = monotonic()
    resume_workers()
    // No UI ticks, submitted budgets, polling, or joins drive execution here.
    val until = beginning + millis(60)
    while monotonic() < until do ()
    pause_workers()
    val snapshot = workers_observe()
    val elapsed = monotonic() - beginning
    assert(snapshot.cores[0].retired > 1000 && snapshot.cores[1].retired > 1000)
    assert(snapshot.cores[0].time <= u64(elapsed.us) * 2 + 10,"pacing must not run ahead of the configured wall clock")
    val paused = snapshot.cores[0].retired
    val again = monotonic() + millis(5)
    while monotonic() < again do ()
    assert(workers_observe().cores[0].retired == paused)

@test("CPU workers: real dual-core firmware keeps FIFO ordering, barriers and spinlock correctness")
worker_dual_firmware()
    for guest in [count_elf,pingpong_elf,order_elf]
        on_virt()
        open_console()
        capture()
        boot(core0(),image_of(guest).unwrap().view())
        start_workers(core0()).unwrap()
        submit_workers(20000000)
        wait_workers()
        pause_workers()
        val snapshot = workers_observe()
        assert(!snapshot.running && snapshot.cores[0].stop == cpu.Stop.Exit,stop_message(core0()))
        val owned = output_snapshot()
        val text = str_cast(owned.view())
        assert(text.contains("total 40000") || text.contains("replies 20000, wrong 0, errors 0") || text.starts_with("stale 0 "),text)
        stop_workers()

@test("CPU workers: live device snapshots and input remain safe during independent SPI firmware execution")
worker_live_display()
    val guest = embed("../../../../examples/touch/demo.elf")
    assert(board_named("boards/touch.hocon").is_ok())
    boot(core0(),image_of(guest).unwrap().view())
    start_workers(core0()).unwrap()
    defer stop_workers()
    submit_workers(40000000)
    for i in 0..<10
        val frame = tft_frame("screen").unwrap()
        assert(frame.width == 240 && frame.height == 240)
        output_snapshot()
        observe_core(0)
        panel_levels()
    wait_workers()
    touch_point("touch",120,60,true)
    submit_workers(8000000)
    wait_workers()
    touch_point("touch",120,60,false)
    submit_workers(8000000)
    wait_workers()
    pause_workers()
    val address = u32(elf.read(guest).unwrap().symbol_named("touch_app").unwrap().unwrap().value)
    assert(cpu.load32(core0(),address) == 1)
    assert(workers_observe().running)

@test("CPU workers: WFI can stay parked across budgets and reboot without replacing threads")
worker_sleeping()
    val c = core0()
    val program = image([(0x100,SLEEPER[..]),(0x200,SLEEPER[..])])
    started(c,program.view())
    launch(0,0x7000,0x201)
    start_workers(c).unwrap()
    defer stop_workers()
    submit_workers(10000)
    wait_workers()
    val first = workers_observe()
    assert(first.running && first.cores[0].sleeping && first.cores[1].sleeping)
    submit_workers(10000)
    wait_workers()
    assert(workers_observe().cores[0].time == 20000)
    assert(workers_observe().worker_ids == first.worker_ids)

@test("CPU workers: Cortex-M7 dual-core firmware runs off the caller in parallel and deterministic modes")
worker_m7_modes()
    for parallel in [false,true]
        assert(board_named("virt7").is_ok())
        open_console()
        capture()
        boot(core0(),image_of(dual_m7).unwrap().view())
        start_workers(core0(),parallel).unwrap()
        submit_workers(20000000)
        wait_workers()
        pause_workers()
        val snapshot = workers_observe()
        assert(!snapshot.running && snapshot.cores[0].stop == cpu.Stop.Exit && core0().exit_code == 0)
        assert(snapshot.worker_ids[0] != current().id)
        val text = output_snapshot()
        assert(str_cast(text.view()).contains("core 0: core 1 finished; total 30"))
        stop_workers()
