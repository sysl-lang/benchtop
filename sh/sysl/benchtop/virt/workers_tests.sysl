module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.benchtop.timing.NEVER
import sysl.threads.{current,Mutex,Condvar}
import sysl.sync.*
import sysl.time.{monotonic,millis,sleep,Duration}
import sysl.raw.str_cast
import sh.sysl.elf as elf

// Whether `done` comes to hold within `limit`, checked every two milliseconds by a test that sleeps
// between checks rather than spinning a core. Real time only bounds how long a test may wait; what it
// asserts is the condition, so a loaded host makes it slower, never red.
private eventually(done: &Fn() -> bool, limit: Duration = millis(20000)) -> bool
    val deadline = monotonic() + limit
    loop
        if (done)() then return true
        if monotonic() >= deadline then return false
        sleep(millis(2))

@test("paced clock: a fake host clock advances the board at its rate, exactly, however long the session")
paced_clock_on_a_fake_clock()
    assert(paced_clock(0, 0, 0, 2000000) == 0)
    assert(paced_clock(0, 0, 1000, 2000000) == 2, "a microsecond is two ticks at 2 MHz")
    assert(paced_clock(500, 7000, 7000 + 1500000000, 2000000) == 500 + 3000000, "from the origin, not from zero")
    // Ten years at 480 MHz: the whole-second split keeps the product inside 64 bits.
    val ten_years: u64 = 10 * 365 * 24 * 3600 * 1000000000
    assert(paced_clock(0, 0, ten_years, 480000000) == ten_years / 1000000000 * 480000000)
    assert(paced_clock(0, 0, 999999999, 3) == 2, "a part of a second rounds down")

@test("paced clock: the lead cap is a twentieth of a second and never zero")
pacing_cap_bounds()
    assert(pacing_cap(2000000) == 100000)
    assert(pacing_cap(19) == 1 && pacing_cap(1) == 1)

@test("paced clock: the leader runs once a whole quantum is due, and otherwise waits exactly until it is")
pacing_wait_on_a_fake_clock()
    // At 2 MHz the quantum is 2000 ticks (a millisecond); a tick is 500 ns.
    assert(pacing_wait_ns(12000, 10000, 2000000) == 0, "a whole quantum is due")
    assert(pacing_wait_ns(13000, 10000, 2000000) == 0)
    assert(pacing_wait_ns(11999, 10000, 2000000) == 500, "one tick short waits one tick")
    assert(pacing_wait_ns(10000, 10000, 2000000) == 1000000, "nothing due waits a whole quantum")
    assert(pacing_wait_ns(5000, 10000, 2000000) == 1000000, "a clock ahead of the host waits a whole quantum")
    // The quantum is at most a batch, at least a tick, and a wait is never zero.
    assert(pacing_wait_ns(10000 + WORKER_BATCH, 10000, 1000000000000) == 0)
    assert(pacing_wait_ns(10000, 10000, 1000000000000) >= 1)
    assert(pacing_wait_ns(0, 0, 999) == 1001002, "a 999 Hz clock's quantum is one tick, rounded up in ns")

@test("CPU workers: distinct persistent host threads, bounded work, pause, step and reset")
worker_lifecycle()
    val c = core0()
    val program = image([(0x100,SPINNER[..]),(0x200,SPINNER[..])])
    started(c,program.view())
    launch(0,0x7000,0x201)
    start_workers(c).unwrap()
    defer stop_workers()
    val ids = workers_observe().worker_ids
    assert(ids[0] != 0 && ids[1] != 0 && ids[0] != ids[1])
    assert(ids[0] != current().id && ids[1] != current().id,"guest cores must not run on the UI/caller thread")
    for batch in 0..<12
        submit_workers(10000)
        wait_workers()
        val snapshot = workers_observe()
        assert(snapshot.running && snapshot.worker_ids == ids)
        assert(snapshot.cores[0].retired > 0 && snapshot.cores[1].retired > 0)
    pause_workers()
    val before = workers_observe()
    sleep(millis(5))
    assert(workers_observe().cores[0].retired == before.cores[0].retired)
    step_workers()
    val stepped = workers_observe()
    assert(stepped.cores[0].retired == before.cores[0].retired + 1)
    assert(stepped.cores[1].retired == before.cores[1].retired + 1)
    boot(c,program.view())
    assert(workers_observe().worker_ids == ids && workers_observe().cores[0].retired == 0)
    submit_workers(10000)
    wait_workers()
    assert(workers_observe().cores[0].retired > 0 && workers_observe().cores[1].retired == 0)

@test("CPU workers: clock pacing progresses while the UI/caller does unrelated work (the real-time smoke test)")
worker_autonomous_clock()
    val c = core0()
    started(c,image([(0x100,SPINNER[..]),(0x200,SPINNER[..])]).view())
    launch(0,0x7000,0x201)
    start_workers(c,true,2000000).unwrap()
    defer stop_workers()
    val beginning = monotonic()
    resume_workers()
    // No UI ticks, submitted budgets, polling, or joins drive execution here: the caller only sleeps.
    val progressed = eventually(() ->
        val s = workers_observe()
        s.cores[0].retired > 1000 && s.cores[1].retired > 1000)
    pause_workers()
    val snapshot = workers_observe()
    val elapsed = monotonic() - beginning
    assert(progressed, "both cores run on their own")
    assert(snapshot.cores[0].time <= u64(elapsed.us) * 2 + 2010,"pacing lead is bounded by one checkpoint plus an instruction boundary")
    val paused = snapshot.cores[0].retired
    sleep(millis(5))
    assert(workers_observe().cores[0].retired == paused)

@test("CPU workers: real dual-core firmware keeps FIFO ordering, barriers and spinlock correctness")
worker_dual_firmware()
    for guest in [count_elf,pingpong_elf,order_elf]
        on_virt()
        open_console()
        capture()
        boot(core0(),image_of(guest).unwrap().view())
        start_workers(core0()).unwrap()
        submit_workers(20000000)
        wait_workers()
        pause_workers()
        val snapshot = workers_observe()
        assert(!snapshot.running && snapshot.cores[0].stop == cpu.Stop.Exit,stop_message(core0()))
        val owned = output_snapshot()
        val text = str_cast(owned.view())
        assert(text.contains("total 40000") || text.contains("replies 20000, wrong 0, errors 0") || text.starts_with("stale 0 "),text)
        stop_workers()

@test("CPU workers: live device snapshots and input remain safe during independent SPI firmware execution")
worker_live_display()
    val guest = embed("../../../../examples/touch/demo.elf")
    assert(board_named("boards/touch.hocon").is_ok())
    boot(core0(),image_of(guest).unwrap().view())
    start_workers(core0()).unwrap()
    defer stop_workers()
    submit_workers(40000000)
    for i in 0..<10
        val frame = tft_frame("screen").unwrap()
        assert(frame.width == 240 && frame.height == 240)
        output_snapshot()
        observe_core(0)
        panel_levels()
    wait_workers()
    touch_point("touch",120,60,true)
    submit_workers(8000000)
    wait_workers()
    touch_point("touch",120,60,false)
    submit_workers(8000000)
    wait_workers()
    pause_workers()
    val address = u32(elf.read(guest).unwrap().symbol_named("touch_count").unwrap().unwrap().value)
    assert(cpu.load32(core0(),address) == 1)
    assert(workers_observe().running)

@test("CPU workers: WFI can stay parked across budgets and reboot without replacing threads")
worker_sleeping()
    val c = core0()
    val program = image([(0x100,SLEEPER[..]),(0x200,SLEEPER[..])])
    started(c,program.view())
    launch(0,0x7000,0x201)
    start_workers(c).unwrap()
    defer stop_workers()
    submit_workers(10000)
    wait_workers()
    val first = workers_observe()
    assert(first.running && first.cores[0].sleeping && first.cores[1].sleeping)
    submit_workers(10000)
    wait_workers()
    assert(workers_observe().cores[0].time == 20000)
    assert(workers_observe().worker_ids == first.worker_ids)

@test("CPU workers: Cortex-M7 dual-core firmware runs off the caller in parallel and deterministic modes")
worker_m7_modes()
    for parallel in [false,true]
        assert(board_named("virt7").is_ok())
        open_console()
        capture()
        boot(core0(),image_of(dual_m7).unwrap().view())
        start_workers(core0(),parallel).unwrap()
        submit_workers(20000000)
        wait_workers()
        pause_workers()
        val snapshot = workers_observe()
        assert(!snapshot.running && snapshot.cores[0].stop == cpu.Stop.Exit && core0().exit_code == 0)
        assert(snapshot.worker_ids[0] != current().id)
        val text = output_snapshot()
        assert(str_cast(text.view()).contains("core 0: core 1 finished; total 30"))
        stop_workers()

@test("CPU workers: M7 and M4 retain a 2:1 instruction rate on a shared clock in both schedulers")
worker_heterogeneous_clocks()
    val description = """
        board {
          name = clock-test
          mcu {
            name = mixed
            clock-hz = 480000000
            cores = [{ core = cortex-m7, fpu = dp, clock-hz = 480000000 },
                     { core = cortex-m4, fpu = sp, clock-hz = 240000000 }]
            peripherals { ram { peripheral = ram, at = 0, size = 1M } }
          }
        }
        """
    for parallel in [false,true]
        assert(board_from("clock-test.hocon",description.bytes).is_ok())
        boot(core0(),image([(0x100,SPINNER[..]),(0x200,SPINNER[..])]).view())
        launch(0,0x7000,0x201)
        start_workers(core0(),parallel).unwrap()
        submit_workers(100000)
        wait_workers()
        pause_workers()
        val snapshot = workers_observe()
        assert(snapshot.running)
        val first = snapshot.cores[0]
        val second = snapshot.cores[1]
        assert(first.time >= 100000 && second.time >= 100000)
        assert(first.retired >= 100000 && first.retired <= 100010)
        assert(second.retired >= 50000 && second.retired <= 50010)
        assert(core0().kind == cpu.Kind.V7emM7 && core1().kind == cpu.Kind.V7em)
        step_workers()
        assert(workers_observe().cores[0].retired == first.retired + 1)
        assert(workers_observe().cores[1].retired == second.retired + 1)
        stop_workers()

@test("clock domains: SysTick stays local while wake deadlines use shared MCU ticks")
clock_domain_systick()
    on_virt()
    boot(core0(),[])
    divide_clocks(1,2)
    val c = core1()
    c.tick_ctrl = 3
    c.tick_reload = 99
    c.tick_zero = 100
    c.sleeping = true
    assert(board_next_wake(c) == 200)
    assert(!board_wake_by(c,100) && c.slept == 50)
    assert(board_time(c,c.retired) == 100)
    assert(board_wake_by(c,200) && c.slept == 100)
    assert(retirement_limit(c,301) == 51)
    assert(board_next_wake(core0()) == NEVER)
    divide_clocks(1,1)

// Run core 0 at the chip's clock over `a` and core 1 over `b`, as a description's `clock-hz` would.
private divide_clocks(a: u64, b: u64)
    machine.configs[0].divisor = a
    machine.configs[1].divisor = b

@test("heterogeneous cores never reuse instructions decoded for another architecture in deterministic mode")
worker_heterogeneous_decode()
    val text = """
        board {
          name = decode-test
          mcu { name = mixed, cores = [cortex-m33,cortex-m0plus]
            peripherals { ram { peripheral = ram, at = 0, size = 1M } }
          }
        }
        """
    assert(board_from("decode-test.hocon",text.bytes).is_ok())
    val code: [3]u16 = [0xf241,0x2034,0xe7fe] // MOVW r0,#0x1234; B .
    boot(core0(),image([(0x100,code[..])]).view())
    turn(core0(),10)
    assert(core0().r[0] == 0x1234 && core0().stop == cpu.Stop.Running)
    launch(0,0x7000,0x101)
    scheduler.starting = false
    turn(core1(),10)
    assert(core1().stop == cpu.Stop.Undefined && core1().r[0] == 0)

@test("CPU workers: independent wall pacing supports matching and mixed core models at unequal rates")
worker_paced_models()
    for models in [("cortex-m0plus","cortex-m0plus"),("cortex-m4","cortex-m7"),
                   ("cortex-m33","cortex-m0plus"),("cortex-m7","cortex-m4")]
        val text = s"""
            board {
              name = clocks
              mcu { name = mixed, clock-hz = 2000000
                cores = [{ core = ${models.0} }, { core = ${models.1}, clock-hz = 1000000 }]
                peripherals { ram { peripheral = ram, at = 0, size = 1M } }
              }
            }
            """
        assert(board_from("paced.hocon",text.bytes).is_ok())
        boot(core0(),image([(0x100,SPINNER[..]),(0x200,SPINNER[..])]).view())
        launch(0,0x7000,0x201)
        start_workers(core0(),true,2000000).unwrap()
        val beginning = monotonic()
        resume_workers()
        val progressed = eventually(() ->
            val s = workers_observe()
            s.cores[0].retired > 1000 && s.cores[1].retired > 500)
        pause_workers()
        val snapshot = workers_observe()
        val elapsed = (monotonic() - beginning).us
        assert(progressed, s"${models.0} and ${models.1} both run")
        assert(snapshot.cores[0].time <= u64(elapsed) * 2 + 2010)
        assert(snapshot.cores[1].time <= u64(elapsed) * 2 + 2010)
        val a = snapshot.cores[0].retired
        val b = snapshot.cores[1].retired
        assert(snapshot.cores[0].late_us == 0 && snapshot.cores[1].late_us == 0,"paused snapshots do not accumulate wall-time lag")
        step_workers()
        assert(workers_observe().cores[0].retired == a + 1 && workers_observe().cores[1].retired == b + 1)
        resume_workers()
        pause_workers()
        assert(workers_observe().running)
        stop_workers()

@test("CPU workers: sleeping cores publish paced clocks and acknowledge pause without simulating future control windows")
worker_paced_sleep()
    for both in [false,true]
        val first_code = if both then SLEEPER[..] else SPINNER[..]
        started(core0(),image([(0x100,first_code),(0x200,SLEEPER[..])]).view())
        launch(0,0x7000,0x201)
        start_workers(core0(),true,2000000).unwrap()
        val beginning = monotonic()
        resume_workers()
        val published = eventually(() ->
            val s = workers_observe()
            s.cores[1].sleeping && s.cores[1].time > 1000)
        pause_workers()
        val snapshot = workers_observe()
        val elapsed = (monotonic() - beginning).us
        assert(published,"a sleeping peer publishes its own clock, not only its retired count")
        assert(snapshot.running && snapshot.cores[1].sleeping)
        for c in snapshot.cores do assert(c.time <= u64(elapsed) * 2 + 2010)
        val paused = snapshot.cores[0].time
        sleep(millis(5))
        assert(workers_observe().cores[0].time == paused)
        val resumed = monotonic()
        resume_workers()
        sleep(millis(10))
        pause_workers()
        assert(workers_observe().cores[0].time <= paused + u64((monotonic() - resumed).us) * 2 + 2010,
            "time spent paused is excluded from the next pacing epoch")
        stop_workers()

@test("CPU workers: a rejected pacing clock cannot affect execution outside a worker session")
worker_rejected_clock()
    started(core0(),image([(0x100,SPINNER[..]),(0x200,SPINNER[..])]).view())
    divide_clocks(1,2)
    assert(start_workers(core0(),true,3).is_err())
    assert(!workers_active())
    assert(worker_clock_limit(core0()) == NEVER && worker_checkpoint(core0()))
    assert(pump_board(core0(),1000) && core0().retired > 0)
    divide_clocks(1,1)

private var stalled_gate = Mutex.new(0)
private var stalled_changed = Condvar.new()
private var stalled_entered: u32 = 0
private var stalled_release: u32 = 0

// The board's bus, but with every read held until the test releases it.
struct StalledBus
end StalledBus

impl cpu.Bus for StalledBus
    read(*self, c: *cpu.Cpu, address: u32, width: u32, retired: u64) -> u32
        stalled_gate.lock_raw()
        atomic_store(&stalled_entered,1,Release)
        while atomic_load(&stalled_release,Acquire) == 0 do stalled_changed.wait(&stalled_gate)
        stalled_gate.unlock_raw()
        0

    write(*self, c: *cpu.Cpu, address: u32, width: u32, x: u32, retired: u64) = board_write(c,address,width,x,retired)

private var stalled_bus = StalledBus()

@test("CPU workers: a delayed device on one core cannot stop another core's independently paced execution")
worker_peer_isolation()
    val reader: [6]u16 = [0x4801,0x6801,0xe7fe,0xbf00,0,0x6000]
    started(core0(),image([(0x100,SPINNER[..]),(0x200,reader[..])]).view())
    launch(0,0x7000,0x201)
    core1().bus = &stalled_bus
    atomic_store(&stalled_entered,0,Release)
    atomic_store(&stalled_release,0,Release)
    start_workers(core0(),true,2000000).unwrap()
    defer stop_workers()
    resume_workers()
    val entered = eventually(() -> atomic_load(&stalled_entered,Acquire) != 0)
    val before = workers_observe().cores[0].retired
    val ran = eventually(() -> workers_observe().cores[0].retired > before + 10000)
    val late = eventually(() -> workers_observe().cores[1].late_us > 5000)
    stalled_gate.lock_raw()
    atomic_store(&stalled_release,1,Release)
    stalled_changed.notify_all()
    stalled_gate.unlock_raw()
    pause_workers()
    assert(entered,"the second guest must have entered the delayed device")
    assert(ran, "the runnable core cannot be held at its peer's clock or a shared job boundary")
    assert(late, "a delayed core reports lateness without holding back its peer")

@test("core registers: r0 to r15 name the observed registers, and nothing else does")
core_register_names()
    for i in 0..<CORE_REGISTERS do assert_eq(core_register_index(s"r$i"), Some(i))
    for bad in ["", "r", "r16", "r-1", "r01", "r1x", "x1", "R1", "pc"] do assert(core_register_index(bad).is_none(), bad)
    assert_eq(CORE_COUNT, 2)
