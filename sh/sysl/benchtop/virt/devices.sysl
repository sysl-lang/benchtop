module sh.sysl.benchtop.virt

// The devices a machine owns: the bus that routes the cores' accesses, and each peripheral's state
// as a struct of its own, in `Machine.devices`. A board description makes them in two steps.
// `check_devices` reads the description and answers every device as the board makes it, or why
// benchtop cannot run it; it sets nothing. `apply_devices` puts a checked set in place and cannot
// fail. So a refused description leaves every device as the last board left it.
//
// A device that more than one thread reaches keeps what the board fixes (whether the bus has it, its
// IRQs, its clock) beside a `Mutex` that owns everything the threads change, so no access to the
// changing part can skip the lock.

import sh.sysl.benchtop.Board

/** Every device of one machine. A field holds one kind of device, idle where the board has none. */
struct Devices
    bus: BusState
    rp: RpState
    rcc: RccState
    spi: SpiState
    storage: StorageState
    sdmmc: SdmmcState
    adc: AdcState
    panel: PanelState
    i2c: I2c
    codec: CodecState
    pwm: PwmState
    i2s: I2sState
    displays: Displays
    dsi: DsiState
    audio: AudioState
    sio: SioState
    // The windows of the devices that answer several (peripheral.sysl), and the devices the board
    // has that run between the cores' accesses, which `attach` sets.
    windows: Windows
    running: Running
end Devices

/** The devices of a machine no board has been assembled on: an empty bus, and every device idle. */
no_devices() -> Devices =
    Devices(bus_state(), rp_state(), rcc_state(), spi_state(), storage_state(), sdmmc_state(), adc_state(), panel_state(),
        i2c_state(), codec_state(), pwm_state(), i2s_state(), display_state(), dsi_state(), audio_state(), sio_state(),
        windows(), no_running())

/** The devices `b` makes, with `mapped` on the bus and `clock_hz` the chip's clock (0 where it names
 * none), or why benchtop cannot run them. It sets nothing. The checks run in the order a refusal is
 * reported in, and a later device's check may read an earlier one's answer.
 */
private[virt] check_devices(b: Board, mapped: []const Mapped, clock_hz: u64) -> Result[Devices, string]
    val rcc = check_rcc(b)?
    val spi = check_spi(b)?
    var (storage, card) = check_storage(b, clock_hz)?
    val sdmmc = check_sdmmc(b, clock_hz, &storage, card)?
    val adc = check_adc(b, mapped)
    var (i2c, codec) = check_i2c(b)?
    var pwm = check_pwm(b, mapped)?
    val i2s = check_i2s(b, &pwm, &codec)?
    val displays = check_displays(b)
    val dsi = check_dsi(b, clock_hz)?
    val audio = check_audio(b, mapped, clock_hz)?

    Ok(Devices(bus_of(mapped), rp_of(mapped), rcc, spi, storage, sdmmc, adc, panel_of(mapped), i2c, codec, pwm, i2s, displays, dsi, audio, sio_state(),
        windows(), no_running()))

/** Put a checked set of devices in place of the machine's, each as at power-on.
 *
 * Every thread that reaches a device is parked or ended first: the CPU workers pause (and with them
 * the DSI worker drains), and the SD image writer finishes its queued sectors before its image is let
 * go. The whole set is then replaced at once, each device's lock with it, so no lock is held here: a
 * lock cannot guard its own replacement, and the parking is what excludes every other thread.
 */
private[virt] apply_devices(m: *Machine, d: Devices)
    pause_workers()
    stop_disk(&m.devices.storage)
    // The boot count carries over, so the host's audio sees the new board as a change.
    val epoch = m.devices.pwm.epoch
    m.devices = d
    m.devices.pwm.epoch = epoch
    attach(m)
    forget_bus_cache(m)
    start_disk(&m.devices.storage)
    boot_spi(&m.devices.spi)
    boot_sdmmc(&m.devices.sdmmc)
    boot_codecs(&m.devices.codec)
    boot_sai_dma(&m.devices.audio)
