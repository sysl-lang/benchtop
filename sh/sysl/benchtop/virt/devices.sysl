module sh.sysl.benchtop.virt

// The devices a machine owns: the bus that routes the cores' accesses, and each peripheral's state
// as a struct of its own, in `Machine.devices`. A board description makes them in two steps.
// `check_devices` reads the description and answers every device as the board makes it, or why
// benchtop cannot run it; it sets nothing. `apply_devices` puts a checked set in place and cannot
// fail. So a refused description leaves every device as the last board left it.
//
// The locks the devices are read under, and the queues and worker threads that carry their data to
// the host, stay beside them as module-level values: they belong to the scheduler, not to a board.

import sh.sysl.benchtop.Board

/** Every device of one machine. A field holds one kind of device, idle where the board has none. */
struct Devices
    bus: BusState
    rp: RpState
    rcc: RccState
    spi: SpiState
    storage: StorageState
    sdmmc: SdmmcState
    adc: AdcState
    panel: PanelState
    i2c: I2cState
    codec: CodecState
    pwm: PwmState
    i2s: I2sState
    displays: DisplayState
    dsi: DsiState
    audio: AudioState
end Devices

/** The devices of a machine no board has been assembled on: an empty bus, and every device idle. */
no_devices() -> Devices =
    Devices(bus_state(), rp_state(), rcc_state(), spi_state(), storage_state(), sdmmc_state(), adc_state(), panel_state(),
        i2c_state(), codec_state(), pwm_state(), i2s_state(), display_state(), dsi_state(), audio_state())

/** The devices `b` makes, with `mapped` on the bus and `clock_hz` the chip's clock (0 where it names
 * none), or why benchtop cannot run them. It sets nothing. The checks run in the order a refusal is
 * reported in, and a later device's check may read an earlier one's answer.
 */
private[virt] check_devices(b: Board, mapped: []const Mapped, clock_hz: u64) -> Result[Devices, string]
    val rcc = check_rcc(b)?
    val spi = check_spi(b)?
    var storage = check_storage(b, clock_hz)?
    val sdmmc = check_sdmmc(b, clock_hz, &storage)?
    val adc = check_adc(b, mapped)
    var (i2c, codec) = check_i2c(b)?
    var pwm = check_pwm(b, mapped)?
    val i2s = check_i2s(b, &pwm, &codec)?
    val displays = check_displays(b)
    val dsi = check_dsi(b, clock_hz)?
    val audio = check_audio(b, clock_hz)?

    Ok(Devices(bus_of(mapped), rp_of(mapped), rcc, spi, storage, sdmmc, adc, panel_of(mapped), i2c, codec, pwm, i2s, displays, dsi, audio))

/** Put a checked set of devices in place of the machine's, each as at power-on. */
private[virt] apply_devices(d: Devices)
    // The last board's SD image writer finishes its queued sectors before its image is let go.
    stop_disk()
    adc_lock.lock()
    machine.devices = d
    adc_lock.unlock()
    forget_bus_cache()
    start_disk()
    boot_spi()
    boot_sdmmc()
    boot_codecs()
    boot_sai_dma()
