module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sysl.time.{monotonic,millis}

private val DISCO_GUEST = embed("../../../../examples/touch/disco.elf")

@test("Discovery DSI: M4 renders imui through DSI packets and handles FT6206 input over real I2C4 registers")
disco_dsi_firmware()
    board_named("stm32h747-disco") match
        Ok(_) -> ()
        Err(why) -> assert(false,why)
    open_console()
    capture()
    boot(core0(),image_of(DISCO_GUEST).unwrap().view())
    start_workers(core0()).unwrap()
    defer stop_workers()
    submit_workers(150000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(if core0().stop != cpu.Stop.Budget then core0() else core1()))
    assert(running_both() && core1().kind == cpu.Kind.V7em)
    val executable = elf.read(DISCO_GUEST).unwrap()
    val state = u32(executable.symbol_named("touch_app").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    assert(cpu.load32(core0(),frames) > 0,"M4 must have rendered through DSI")
    assert(cpu.load32(core0(),state) == 0)
    val before = tft_frame("screen").unwrap()
    assert(before.width == 800 && before.height == 480)
    assert(before.pixels.at(0) == 0 && before.pixels.at(120 * 800 + 280) != 0)
    touch_point("touch",400,180,true)
    submit_workers(20000000)
    wait_workers()
    touch_point("touch",400,180,false)
    submit_workers(20000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running)
    assert(cpu.load32(core0(),state) == 1,"M4 processes FT6206 button release")
    val after = tft_frame("screen").unwrap()
    var changed = false
    for i in 0..<after.pixels.len() do if before.pixels.at(i) != after.pixels.at(i) then changed = true
    assert(changed,"all changed pixels must reach the display through the DSI endpoint")
    assert(!serial_present,"Discovery must not use the PL022 SPI test harness")

@test("DSI peripheral: pending packets complete while guest cores are asleep")
dsi_sleeping_transfer()
    assert(board_named("stm32h747-disco").is_ok())
    boot(core0(),image_of(DISCO_GUEST).unwrap().view())
    val c = core0()
    for pair in [(0x430u32,0x01000001u32 | (100 << 2) | (5 << 11)),(0xa0,3),(0xa4,1),(0x404,8),(4,1)]
        board_write(c,0x50000000 + pair.0,4,pair.1,0)
    board_write(c,0x5000006c,4,(0x29 << 8) | 5,0)
    cpu.store16(c,0x24000100,0xbf30)
    c.pc = 0x24000100
    run_board(c)
    assert(c.stop == cpu.Stop.Asleep)
    assert(!dsi_host.busy && tft_bindings.at(0).model.enabled,"link completion must not depend on an awake CPU or UI painting")

@test("DSI scheduling: idle peripheral never parks CPU workers behind a UI display snapshot")
dsi_idle_display_lock()
    assert(board_named("stm32h747-disco").is_ok())
    boot(core0(),image_of(DISCO_GUEST).unwrap().view())
    cpu.store16(core0(),0x24000100,0xe7fe)
    cpu.store16(core0(),0x24000200,0xe7fe)
    core0().pc = 0x24000100
    launch(0x08100000,0x24070000,0x24000201)
    start_workers(core0()).unwrap()
    defer stop_workers()
    // Model a UI reader holding a consistent display snapshot. The idle DSI
    // deadline and signal checks need neither that reader nor its lock.
    display_lock.lock()
    submit_workers(150000)
    val until = monotonic() + millis(100)
    while monotonic() < until && workers_observe().cores[0].retired == 0 do ()
    val progress = workers_observe()
    display_lock.unlock()
    wait_workers()
    assert(progress.cores[0].retired >= 150000 && progress.cores[1].retired >= 70000,
        "both guest CPUs must execute while an unrelated UI reader owns the display lock")
