module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sysl.time.{monotonic,millis,sleep}
import sysl.threads.current

private val DISCO_GUEST = embed("../../../../examples/touch/disco.elf")

@test("Discovery DSI: M4 renders imui through DSI packets and handles FT6206 input over real I2C4 registers")
disco_dsi_firmware()
    val board = machine()
    val m = &*board
    board_named(m, "stm32h747-disco") match
        Ok(_) -> ()
        Err(why) -> assert(false,why)
    open_console(m)
    capture(m)
    boot(m,image_of(m, DISCO_GUEST).unwrap().view())
    start_workers(m).unwrap()
    defer stop_workers()
    submit_workers(150000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(if core0(m).stop != cpu.Stop.Running then core0(m) else core1(m)))
    assert(running_both() && core1(m).kind == cpu.Kind.V7em)
    val executable = elf.read(DISCO_GUEST).unwrap()
    val state = u32(executable.symbol_named("touch_count").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    assert(cpu.load32(core0(m),frames) > 0,"M4 must have rendered through DSI")
    assert(cpu.load32(core0(m),state) == 0)
    val before = tft_frame(m, "screen").unwrap()
    assert(before.width == 800 && before.height == 480)
    assert(before.pixels.at(0) == 0 && before.pixels.at(120 * 800 + 280) != 0)
    touch_point(m, "touch",400,180,true)
    submit_workers(20000000)
    wait_workers()
    touch_point(m, "touch",400,180,false)
    submit_workers(20000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running)
    assert(cpu.load32(core0(m),state) == 1,"M4 processes FT6206 button release")
    val after = tft_frame(m, "screen").unwrap()
    var changed = false
    for i in 0..<after.pixels.len() do if before.pixels.at(i) != after.pixels.at(i) then changed = true
    assert(changed,"all changed pixels must reach the display through the DSI endpoint")
    assert(!m.devices.spi.present,"Discovery must not use the PL022 SPI test harness")

@test("DSI peripheral: pending packets complete while guest cores are asleep")
dsi_sleeping_transfer()
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m,image_of(m, DISCO_GUEST).unwrap().view())
    val c = core0(m)
    for pair in [(0x430u32,0x01000001u32 | (100 << 2) | (5 << 11)),(0xa0,6),(0xa4,1),(0x404,8),(4,1)]
        board_write(m,c,0x50000000 + pair.0,4,pair.1,0)
    board_write(m,c,0x5000006c,4,(0x29 << 8) | 5,0)
    cpu.store16(c,0x24000100,0xbf30)
    c.pc = 0x24000100
    run_board(m)
    assert(c.stop == cpu.Stop.Asleep)
    assert(!m.devices.dsi.host.with(h -> (*h).busy) && m.devices.displays.live.with(s -> s.tfts.at(0).model.enabled),"link completion must not depend on an awake CPU or UI painting")

@test("DSI scheduling: idle peripheral never parks CPU workers behind a UI display snapshot")
dsi_idle_display_lock()
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m,image_of(m, DISCO_GUEST).unwrap().view())
    cpu.store16(core0(m),0x24000100,0xe7fe)
    cpu.store16(core0(m),0x24000200,0xe7fe)
    core0(m).pc = 0x24000100
    launch(m,0x08100000,0x24070000,0x24000201)
    start_workers(m).unwrap()
    defer stop_workers()
    // Model a UI reader holding a consistent display snapshot. The idle DSI
    // deadline and signal checks need neither that reader nor its lock.
    m.devices.displays.live.lock_raw()
    submit_workers(150000)
    val until = monotonic() + millis(20000)
    while monotonic() < until && (workers_observe().cores[0].time < 150000 || workers_observe().cores[1].time < 140000) do sleep(millis(1))
    val progress = workers_observe()
    m.devices.displays.live.unlock_raw()
    wait_workers()
    assert(progress.cores[0].time >= 150000 && progress.cores[1].time >= 140000,
        "both guest CPUs must execute while an unrelated UI reader owns the display lock")

@test("Discovery DSI: independently paced workers boot real firmware, publish progress and reset safely")
disco_independent_pacing()
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m,image_of(m, DISCO_GUEST).unwrap().view())
    val frames = u32(elf.read(DISCO_GUEST).unwrap().symbol_named("touch_frames").unwrap().unwrap().value)
    start_workers(m,true,480000000).unwrap()
    defer stop_workers()
    val ids = workers_observe().worker_ids
    val device_id = dsi_worker_status().worker_id
    resume_workers()
    val until = monotonic() + millis(10000)
    // Atomic RAM observation avoids inspecting or changing a running Cpu's
    // registers. The backing/page mapping is immutable until the paused reset.
    val page = cpu.page_for(core0(m),frames,4)
    assert(page != 0)
    while monotonic() < until && cpu.host_read(page,frames,4) == 0 && workers_observe().running do sleep(millis(1))
    pause_workers()
    assert(workers_observe().running,stop_message(if core0(m).stop != cpu.Stop.Running then core0(m) else core1(m)))
    assert(cpu.load32(core0(m),frames) > 0)
    assert(workers_observe().launched && workers_observe().cores[1].retired > 0)
    boot(m,image_of(m, DISCO_GUEST).unwrap().view())
    assert(workers_observe().worker_ids == ids && !workers_observe().launched)
    assert(workers_observe().cores[0].retired == 0 && workers_observe().cores[1].retired == 0)
    assert(device_id != 0 && dsi_worker_status().worker_id == device_id && dsi_worker_status().outstanding == 0)

private enable_dsi_for_test(m: *Machine)
    val c = core0(m)
    for pair in [(0x430u32,0x01000001u32 | (100 << 2) | (5 << 11)),(0xa0,6),(0xa4,1),(0x404,8),(4,1)]
        board_write(m,c,0x50000000 + pair.0,4,pair.1,0)

@test("DSI worker: active display processing cannot block CPU workers behind a UI snapshot")
dsi_worker_display_isolation()
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m,image_of(m, DISCO_GUEST).unwrap().view())
    cpu.store16(core0(m),0x24000100,0xe7fe)
    cpu.store16(core0(m),0x24000200,0xe7fe)
    core0(m).pc = 0x24000100
    launch(m,0x08100000,0x24070000,0x24000201)
    enable_dsi_for_test(m)
    board_write(m,core0(m),0x5000006c,4,(0x29 << 8) | 5,0)
    start_workers(m,true,2000000).unwrap()
    defer stop_workers()
    val ids = workers_observe().worker_ids
    val device = dsi_worker_status().worker_id
    assert(device != 0 && device != ids[0] && device != ids[1] && device != current().id)
    val held = m.devices.displays.live.lock_raw()
    resume_workers()
    val until = monotonic() + millis(20000)
    while monotonic() < until && (workers_observe().cores[0].retired < 20000 || workers_observe().cores[1].retired < 1000) do sleep(millis(1))
    val progress = workers_observe()
    val pending = dsi_worker_status().outstanding
    val enabled = held.tfts.at(0).model.enabled
    m.devices.displays.live.unlock_raw()
    pause_workers()
    assert(progress.cores[0].retired >= 20000 && progress.cores[1].retired > 1000)
    assert(pending > 0 && !enabled,"the device worker is delayed by the UI reader while CPUs keep executing")
    assert(m.devices.displays.live.with(s -> s.tfts.at(0).model.enabled) && dsi_worker_status().outstanding == 0)

@test("DSI worker: bounded FIFO applies backpressure without losing packets and readback follows writes")
dsi_worker_fifo_readback()
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m,image_of(m, DISCO_GUEST).unwrap().view())
    enable_dsi_for_test(m)
    start_workers(m).unwrap()
    defer stop_workers()
    val c = core0(m)
    var time: u64 = 1000
    var sent: u64 = 0
    m.devices.displays.live.lock_raw()
    for i in 0..<80
        if board_read(m,c,0x50000074,4,time) & 1 == 0 then break
        board_write(m,c,0x5000006c,4,(0x29 << 8) | 5,time)
        sent += 1
        time += 1000
    val blocked = board_read(m,c,0x50000074,4,time)
    val queue = dsi_worker_status()
    m.devices.displays.live.unlock_raw()
    assert(c.stop == cpu.Stop.Running && blocked & 3 == 2)
    assert(queue.queued <= 64 && queue.outstanding <= 65)
    flush_dsi_worker()
    board_read(m,c,0x50000074,4,time + 1000)
    flush_dsi_worker()
    assert(dsi_worker_status().completed == sent,"every accepted packet must be consumed once")
    board_write(m,c,0x5000006c,4,(0x3a << 8) | (0x55 << 16) | 0x15,time + 2000)
    board_read(m,c,0x50000074,4,time + 3000)
    flush_dsi_worker()
    board_write(m,c,0x5000006c,4,(0x0c << 8) | 6,time + 4000)
    board_read(m,c,0x50000074,4,time + 5000)
    flush_dsi_worker()
    assert(board_read(m,c,0x50000070,4,time + 6000) == 0x55)
    assert(c.stop == cpu.Stop.Running)
