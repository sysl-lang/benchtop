module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sysl.threads.spawn
import sysl.time.{millis,sleep}
import sysl.math.pi
import sysl.raw.str_cast
import sysl.text.replace_all
private magnitude(x: f32) -> f32 = if x < 0.0 then -x else x

private boot_codecs_of(m: *Machine) = boot_codecs(&m.devices)

@test("WM8994: a codec reset waits for the I2C bus's lock, which every guest transfer to the codec holds")
codec_reset_under_bus_lock()
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    m.devices.i2c.live.with(s -> s.parts.codec.regs[1] = 0x3003)
    // Hold the bus as a guest's transfer does, and reset from another thread meanwhile.
    val held = m.devices.i2c.live.lock_raw()
    val other = spawn(&boot_codecs_of, m, 1 << 20).unwrap()
    sleep(millis(100))
    val during = held.parts.codec.regs[1]
    m.devices.i2c.live.unlock_raw()
    other.join()
    assert(during == 0x3003, "the reset must not reach the codec while a transfer holds the bus")
    assert(m.devices.i2c.live.with(s -> s.parts.codec.regs[1]) == 0, "the reset reaches the codec the bus's devices program")

private val CODEC_GUEST = embed("../../../../examples/touch/audio-disco.elf")

@test("Discovery audio: M7 DMA IRQ firmware generates a 440Hz sine while M4 renders and handles touch")
codec_guest_audio()
    val board = machine()
    val m = &*board
    assert(ideal_disco(m))
    boot(m,image_of(m, CODEC_GUEST).unwrap().view())
    val executable = elf.read(CODEC_GUEST).unwrap()
    val errors = u32(executable.symbol_named("audio_errors").unwrap().unwrap().value)
    val misses = u32(executable.symbol_named("audio_deadline_misses").unwrap().unwrap().value)
    val ready = u32(executable.symbol_named("audio_ready").unwrap().unwrap().value)
    val irqs = u32(executable.symbol_named("audio_irqs").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    start_workers(m).unwrap()
    defer stop_workers(m)
    submit_workers(m,150000000)
    wait_workers(m)
    pause_workers(m)
    assert(workers_observe(m).running,stop_message(core0(m)))
    assert(cpu.load32(core0(m),ready) == 1 && cpu.load32(core0(m),errors) == 0)
    assert(cpu.load32(core0(m),irqs) > 10 && cpu.load32(core0(m),frames) > 0)
    for sample in take_codec_sound(&m.devices) do assert(sample == 0.0,"startup must be silent")
    val before = cpu.load32(core0(m),frames)
    touch_point(m, "touch",400,246,true)
    submit_workers(m,20000000)
    wait_workers(m)
    touch_point(m, "touch",400,246,false)
    submit_workers(m,100000000)
    wait_workers(m)
    pause_workers(m)
    assert(workers_observe(m).running,stop_message(core0(m)))
    assert(cpu.load32(core0(m),errors) == 0 && cpu.load32(core0(m),frames) > before)
    val samples = take_codec_sound(&m.devices)
    assert(samples.len() > 2000)
    var peak: f32 = 0.0
    var crossings = 0
    var first: usize = 0
    var last: usize = 0
    for i in 1..<samples.len()
        val sample = samples.at(i)
        if magnitude(sample) > peak then peak = magnitude(sample)
        if samples.at(i - 1) <= 0.0 && sample > 0.0
            if crossings == 0 then first = i
            last = i
            crossings += 1
    assert(peak > 0.015 && peak < 0.025,"codec must output the firmware sine at the configured gain")
    assert(crossings > 10)
    var residual: real = 0.0
    for i in 2..<samples.len()
        val error = real(samples.at(i)) - 1.9966836332 * real(samples.at(i - 1)) + real(samples.at(i - 2))
        residual += error * error
    assert(residual / real(samples.len() - 2) < 0.0000000001,"PCM must follow a sine recurrence without discontinuities")
    assert(cpu.load32(core0(m),misses) == 0,"M7 must refill both DMA halves before they are consumed")
    val frequency = real(crossings - 1) * 48000.0 / real(last - first)
    assert(frequency > 438.0 && frequency < 442.0,"SAI clock and guest oscillator must produce 440Hz")
    touch_point(m, "touch",400,246,true)
    submit_workers(m,20000000)
    wait_workers(m)
    touch_point(m, "touch",400,246,false)
    submit_workers(m,150000000)
    wait_workers(m)
    pause_workers(m)
    for sample in take_codec_sound(&m.devices) do assert(magnitude(sample) < 0.00001,"release envelope must settle to silence")

/** The Discovery with an ideal speaker in place of its catalogued one, for a test of what the codec
 * sends rather than what a cone makes of it.
 */
private[virt] ideal_disco(m: *Machine) -> bool
    val board = str_cast(embed("../../../../boards/stm32h747-disco.hocon"))
    board_from(m, "stm32h747-disco.hocon", replace_all(board, "part = CMS-151103-088SP", "part = speaker").bytes).is_ok()

// The steady-state peak of `f` driven by a unit sine at `hz`, sampled at 48 kHz, after a second.
private cone_peak(f: Biquad, hz: real) -> real
    var g = f
    var peak = 0.0
    for n in 0..<96000
        val y = step(&g, (2.0 * pi * hz * real(n) / 48000.0).sin())
        if n >= 48000 && y.abs() > peak then peak = y.abs()
    peak

@test("speaker cone: no resonance passes everything; a resonance rolls off 12 dB an octave below it")
speaker_cone()
    for hz in [50.0, 850.0, 5000.0] do assert((cone_peak(cone(0, 48000), hz) - 1.0).abs() < 1.0e-9, s"$hz")
    val micro = cone(850, 48000)
    // A Butterworth high-pass is 3 dB down at its corner, and its gain falls as (f / fc)² below it.
    assert((cone_peak(micro, 850.0) - 0.7071).abs() < 0.01)
    assert((cone_peak(micro, 5000.0) - 1.0).abs() < 0.01)
    val low = cone_peak(micro, 100.0)
    assert(low > 0.0125 && low < 0.0150, s"$low")
    assert((cone_peak(micro, 212.5) / cone_peak(micro, 106.25) - 4.0).abs() < 0.1, "an octave is 12 dB")

@test("speaker cone: the board's catalogued speaker takes its datasheet resonance, and a bare speaker is ideal")
speaker_cone_board()
    val owner = machine()
    val m = &*owner
    assert(board_named(m, "stm32h747-disco").is_ok())
    m.devices.codec.mix.with(c ->
        assert(c.cone[0].b[0] < 1.0 && c.cone[0].b[0] > 0.9 && c.cone[1].b[0] == c.cone[0].b[0], "CMS-151103-088SP resonates at 850 Hz"))
    val board = str_cast(embed("../../../../boards/stm32h747-disco.hocon"))
    assert(board_from(m, "ideal.hocon", replace_all(board, "part = CMS-151103-088SP", "part = speaker").bytes).is_ok())
    m.devices.codec.mix.with(c -> assert(c.cone[0].b == [1.0, 0.0, 0.0], "a bare speaker is ideal"))
