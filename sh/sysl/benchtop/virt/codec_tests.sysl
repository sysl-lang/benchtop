module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
private magnitude(x: f32) -> f32 = if x < 0.0 then -x else x

private val CODEC_GUEST = embed("../../../../examples/touch/audio-disco.elf")

@test("Discovery audio: M7 DMA IRQ firmware generates a 440Hz sine while M4 renders and handles touch")
codec_guest_audio()
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m,image_of(m, CODEC_GUEST).unwrap().view())
    val executable = elf.read(CODEC_GUEST).unwrap()
    val errors = u32(executable.symbol_named("audio_errors").unwrap().unwrap().value)
    val misses = u32(executable.symbol_named("audio_deadline_misses").unwrap().unwrap().value)
    val ready = u32(executable.symbol_named("audio_ready").unwrap().unwrap().value)
    val irqs = u32(executable.symbol_named("audio_irqs").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    start_workers(m).unwrap()
    defer stop_workers(m)
    submit_workers(m,150000000)
    wait_workers(m)
    pause_workers(m)
    assert(workers_observe(m).running,stop_message(core0(m)))
    assert(cpu.load32(core0(m),ready) == 1 && cpu.load32(core0(m),errors) == 0)
    assert(cpu.load32(core0(m),irqs) > 10 && cpu.load32(core0(m),frames) > 0)
    for sample in take_codec_sound(&m.devices) do assert(sample == 0.0,"startup must be silent")
    val before = cpu.load32(core0(m),frames)
    touch_point(m, "touch",400,246,true)
    submit_workers(m,20000000)
    wait_workers(m)
    touch_point(m, "touch",400,246,false)
    submit_workers(m,100000000)
    wait_workers(m)
    pause_workers(m)
    assert(workers_observe(m).running,stop_message(core0(m)))
    assert(cpu.load32(core0(m),errors) == 0 && cpu.load32(core0(m),frames) > before)
    val samples = take_codec_sound(&m.devices)
    assert(samples.len() > 2000)
    var peak: f32 = 0.0
    var crossings = 0
    var first: usize = 0
    var last: usize = 0
    for i in 1..<samples.len()
        val sample = samples.at(i)
        if magnitude(sample) > peak then peak = magnitude(sample)
        if samples.at(i - 1) <= 0.0 && sample > 0.0
            if crossings == 0 then first = i
            last = i
            crossings += 1
    assert(peak > 0.015 && peak < 0.025,"codec must output the firmware sine at the configured gain")
    assert(crossings > 10)
    var residual: real = 0.0
    for i in 2..<samples.len()
        val error = real(samples.at(i)) - 1.9966836332 * real(samples.at(i - 1)) + real(samples.at(i - 2))
        residual += error * error
    assert(residual / real(samples.len() - 2) < 0.0000000001,"PCM must follow a sine recurrence without discontinuities")
    assert(cpu.load32(core0(m),misses) == 0,"M7 must refill both DMA halves before they are consumed")
    val frequency = real(crossings - 1) * 48000.0 / real(last - first)
    assert(frequency > 438.0 && frequency < 442.0,"SAI clock and guest oscillator must produce 440Hz")
    touch_point(m, "touch",400,246,true)
    submit_workers(m,20000000)
    wait_workers(m)
    touch_point(m, "touch",400,246,false)
    submit_workers(m,150000000)
    wait_workers(m)
    pause_workers(m)
    for sample in take_codec_sound(&m.devices) do assert(magnitude(sample) < 0.00001,"release envelope must settle to silence")
