module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu

@test("STM32 I2C v2: repeated START, byte data access, reload, NACK, STOP clear and PE state")
i2c_v2_protocol()
    assert(board_named("stm32h747-disco").is_ok())
    boot(core0(),image_of(embed("../../../../examples/touch/disco.elf")).unwrap().view())
    val c = core0()
    board_write(c,0x58001c10,4,0x12345678,0)
    board_write(c,0x58001c00,4,1,0)
    board_write(c,0x58001c04,4,0x54 | (1 << 16) | (1 << 13),0)
    assert(board_read(c,0x58001c18,4,0) & 2 != 0)
    board_write(c,0x58001c28,1,0xa8,0)
    assert(board_read(c,0x58001c18,4,0) & (1 << 6) != 0)
    board_write(c,0x58001c04,4,0x54 | (1 << 16) | (1 << 13) | (1 << 10) | (1 << 25),0)
    assert(board_read(c,0x58001c24,1,0) == 0x11)
    assert(board_read(c,0x58001c18,4,0) & ((1 << 15) | (1 << 5)) == 1 << 5)
    board_write(c,0x58001c1c,4,1 << 5,0)
    assert(board_read(c,0x58001c18,4,0) == 1)
    board_write(c,0x58001c04,4,0x54 | (1 << 16) | (1 << 13) | (1 << 24),0)
    board_write(c,0x58001c28,4,0x80,0)
    assert(board_read(c,0x58001c18,4,0) & (1 << 7) != 0)
    board_write(c,0x58001c04,4,0x54 | (1 << 16) | (1 << 25),0)
    board_write(c,0x58001c28,4,0x22,0)
    assert(machine.devices.i2c.live.with(s -> s.focals.at(0).model.registers[0x80]) == 0x22)
    board_write(c,0x58001c04,4,0x56 | (1 << 16) | (1 << 13) | (1 << 25),0)
    assert(board_read(c,0x58001c18,4,0) & 0x8030 == 0x30)
    board_write(c,0x58001c00,4,0,0)
    assert(board_read(c,0x58001c18,4,0) == 1)
    assert(board_read(c,0x58001c10,4,0) == 0x12345678)
    assert(c.stop == cpu.Stop.Budget)
    board_write(c,0x58001c00,4,1 << 14,0)
    assert(c.stop == cpu.Stop.Fault,"unsupported DMA/interrupt configuration must be explicit")
