module sh.sysl.benchtop.virt

// The CPU workers: a persistent host thread for each core, which the desktop drives with pause,
// resume, step and reset, and tests with bounded budgets. They run the board through the scheduler's
// turns and lockstep (`scheduler.sysl`), paced against the host's clock where the session has one.

import sh.sysl.benchtop.timing.NEVER
import sh.sysl.benchtop.v6m.{Cpu, Stop, refresh, take_incoming, set_limit, run_single, clock as core_ticks}
import sysl.threads.{Thread, Mutex, Condvar, spawn, current}
import sysl.time.monotonic
import sysl.text.parse_long
import sh.sysl.benchtop.timing as timing
import sysl.sync.*
import sysl.math.{min,max}

/** How many cores a board has, and how many general registers each core's observation publishes
 * (the Arm r0 to r15). */
const CORE_COUNT: int = 2
const CORE_REGISTERS: int = 16

/** The index of the observed register that `name` (`r0` to `r15`) spells, or `None`. */
core_register_index(name: string) -> Option[int]
    if !name.starts_with("r") then return None
    val n = parse_long(name[1..]) match
        Ok(n) -> n
        Err(_) -> return None
    if n < 0 || n >= CORE_REGISTERS || name != s"r$n" then None else Some(int(n))

/** Each running core publishes only its own state. Pause/reset snapshots are
 * captured coherently after both workers reach a safe boundary. */
struct CoreObservation
    pc: u32
    retired: u64
    time: u64
    registers: [CORE_REGISTERS]u32
    sleeping: bool
    stop: Stop
    late_us: u64

struct WorkerObservation
    cores: [CORE_COUNT]CoreObservation
    launched: bool
    running: bool
    worker_ids: [2]u64

/** What the threads that drive the workers and the workers themselves share, under `Workers.control`.
 * `requested` is the board clock a manual budget runs to; `generation` counts the lockstep batches
 * core 0's worker has handed core 1's, and `finished` the last one core 1's worker has run. A paced
 * session's origin and each core's pacer are set while the workers are parked. `waited_us` is the host
 * time each core's worker has spent waiting for the host's clock to catch its guest up, since the
 * session was started.
 */
struct WorkerControl
    snap: WorkerObservation
    ids: [2]u64
    closing: bool
    paused: bool
    busy: bool
    step_pending: bool
    requested: u64
    generation: u64
    finished: u64
    origin_ns: u64
    origin_clock: u64
    epoch_ready: bool
    pacers: [2]timing.CorePacer
    waited_us: [2]u64

/** The CPU workers' session, which the scheduler of the machine whose cores they run owns: `active`,
 * `parallel`, `hz` and `paced`, set while no worker runs and read freely; `interrupt` is atomic;
 * `next_check` is each core's next pacing checkpoint, written and read only by that core's worker, or
 * while both are parked.
 */
struct Workers
    active: bool
    parallel: bool
    hz: u64
    // Each core paced against the host's clock on its own, for an interactive parallel session.
    paced: bool
    interrupt: u32
    next_check: [2]u64
    handles: [2]Option[Thread]
    control: Mutex[WorkerControl]
    changed: Condvar
    core1_changed: Condvar

private[virt] const WORKER_BATCH: u64 = 250000

private no_core() -> CoreObservation = CoreObservation(0, 0, 0, [0;16], false, Stop.Running, 0)

private[virt] no_workers() -> Workers = Workers(false, true, 0, false, 0, [0, 0], [None, None],
    Mutex.new(WorkerControl(WorkerObservation([no_core(), no_core()], false, false, [0, 0]), [0, 0],
        false, true, false, false, 0, 0, 0, 0, 0, false, [timing.CorePacer(0, 0, 0, 0, 0);2], [0, 0])),
    Condvar.new(), Condvar.new())

private capture_core(c: *Cpu) -> CoreObservation = CoreObservation(c.pc,c.retired,board_time(c,c.retired),c.r,c.sleeping,c.stop,0)

private capture_workers(m: *Machine, ids: [2]u64) -> WorkerObservation = WorkerObservation(
    [capture_core(&m.cores[0]),capture_core(&m.cores[1])],m.scheduler.launched,
    m.cores[0].stop == Stop.Running && m.cores[1].stop == Stop.Running,ids)

/** Whether `m`'s CPU workers are started. */
workers_active(m: *Machine) -> bool = m.scheduler.workers.active

/** `m`'s core `k` as last observed. Safe for UI, instruments and host audio without touching a
 * running Cpu.
 */
observe_core(m: *Machine, k: int) -> CoreObservation
    require k == 0 || k == 1, "core is 0 or 1"
    val w = &m.scheduler.workers
    if !w.active then return capture_core(&m.cores[k])
    w.control.with(c -> observed_workers(m, c).cores[k])

/** The later of `m`'s cores' clocks as last observed. */
observation_time(m: *Machine) -> u64
    val w = &m.scheduler.workers
    if !w.active then return max(board_time(&m.cores[0],m.cores[0].retired),board_time(&m.cores[1],m.cores[1].retired))
    w.control.with(c -> max(c.snap.cores[0].time,c.snap.cores[1].time))

/** `m`'s cores as its workers last observed them. */
workers_observe(m: *Machine) -> WorkerObservation
    require m.scheduler.workers.active, "CPU workers are started"
    m.scheduler.workers.control.with(c -> observed_workers(m, c))

/** The host time each of `m`'s cores' workers has spent waiting for the host's clock since the
 * workers were started: the part of a paced session's wall time a core did not need to keep up.
 */
workers_waited_us(m: *Machine) -> [2]u64
    require m.scheduler.workers.active, "CPU workers are started"
    m.scheduler.workers.control.with(c -> c.waited_us)

/** hz=0 supplies deterministic manual budgets for tests. Interactive sessions
 * use their own wall clock; the UI never supplies their instruction budget.
 */
start_workers(m: *Machine, parallel: bool = true, hz: u64 = 0) -> Result[unit,string]
    require hz <= 1000000000, "worker clock is at most 1 GHz"
    require !m.scheduler.workers.active && !m.scheduler.threaded, "one board owns the CPU workers"
    val s = &m.scheduler
    val w = &s.workers
    for k in 0..<2
        val divisor = m.configs[k].divisor
        if hz != 0 && (hz < divisor || hz % divisor != 0) then
            return Err("worker clock must divide into each configured core clock domain")
    w.parallel = parallel
    w.hz = hz
    w.paced = hz != 0 && parallel
    atomic_store(&w.interrupt,0,Release)
    w.control.with(c ->
        c.closing = false
        c.paused = true
        c.busy = false
        c.step_pending = false
        c.epoch_ready = false
        c.requested = s.now
        c.ids = [0,0]
        c.generation = 0
        c.finished = 0
        c.waited_us = [0, 0]
        c.snap = capture_workers(m, c.ids))
    w.active = true
    w.handles[0] = spawn(&leading_worker,m,1 << 20)
    if w.handles[0].is_none()
        w.active = false
        return Err("cannot create the host worker for guest core 0")
    w.handles[1] = spawn(&following_worker,m,1 << 20)
    if w.handles[1].is_none()
        w.control.with(c ->
            c.closing = true
            w.changed.notify_all())
        w.handles[0].unwrap().join()
        w.handles[0] = None
        w.active = false
        return Err("cannot create the host worker for guest core 1")
    val c = w.control.lock_raw()
    while c.ids[0] == 0 || c.ids[1] == 0 do w.changed.wait(&w.control)
    c.snap.worker_ids = c.ids
    w.control.unlock_raw()
    if parallel
        start_dsi_worker(m) match
            Ok(_) -> ()
            Err(why) ->
                stop_workers(m)
                return Err(why)
    Ok(())

/** Set `m`'s parked workers running. */
resume_workers(m: *Machine)
    val s = &m.scheduler
    val w = &s.workers
    if !w.active then return
    w.control.with(c ->
        if c.paused && c.snap.running
            c.origin_clock = s.now
            c.origin_ns = host_now_ns()
            if w.paced
                val at = c.origin_ns / 1000
                for k in 0..<2
                    val core = &m.cores[k]
                    val origin = if k == 1 && !s.launched then local_time(core,s.now) else core_ticks(core,core.retired)
                    c.pacers[k] = timing.pacer(w.hz / divisor_of(core),at,origin)
                    w.next_check[k] = c.pacers[k].next_check
                c.epoch_ready = true
            atomic_store(&w.interrupt,0,Release)
            c.paused = false
            w.changed.notify_all())

/** Park `m`'s workers. Pause acknowledges a short boundary; no worker runs during reset or step. */
pause_workers(m: *Machine)
    val s = &m.scheduler
    val w = &s.workers
    if !w.active then return
    w.control.with(c ->
        c.paused = true
        atomic_store(&w.interrupt,1,Release)
        w.changed.notify_all())
    // Wake a peer parked on guest-time ordering. Never take the board's lock while holding the
    // control lock: checkpoint publication takes the control lock.
    if w.paced then nudge(s)
    val c = w.control.lock_raw()
    while c.busy do w.changed.wait(&w.control)
    c.requested = s.now
    w.control.unlock_raw()
    flush_dsi_worker(m)

/** Call after `m`'s boot/reset while paused; thread identities and handles survive. */
rebase_workers(m: *Machine)
    val w = &m.scheduler.workers
    if !w.active then return
    w.control.with(c ->
        assert(c.paused && !c.busy,"reset requires parked CPU workers")
        c.requested = m.scheduler.now
        c.snap = capture_workers(m, c.ids))

/** Park `m`'s workers, run one instruction on each running core, and park them again. */
step_workers(m: *Machine)
    pause_workers(m)
    val w = &m.scheduler.workers
    val c = w.control.lock_raw()
    if c.snap.running
        c.step_pending = true
        c.paused = false
        w.changed.notify_all()
        while c.step_pending || c.busy do w.changed.wait(&w.control)
    w.control.unlock_raw()
    flush_dsi_worker(m)

/** Run `m` for `ticks` more board ticks. Manual budgets are useful for regression tests and
 * throughput measurements. */
submit_workers(m: *Machine, ticks: u64)
    require m.scheduler.workers.active && m.scheduler.workers.hz == 0, "manual budgets need an unpaced worker session"
    val w = &m.scheduler.workers
    w.control.with(c ->
        c.requested += ticks
        c.paused = false
        w.changed.notify_all())

/** Wait until `m`'s workers have run every budget submitted, or park. */
wait_workers(m: *Machine)
    val s = &m.scheduler
    val w = &s.workers
    val c = w.control.lock_raw()
    while (c.busy || (!c.paused && c.snap.running && s.now < c.requested)) && !c.closing
        w.changed.wait(&w.control)
    w.control.unlock_raw()
    flush_dsi_worker(m)

/** Stop `m`'s workers and join their threads. */
stop_workers(m: *Machine)
    val s = &m.scheduler
    val w = &s.workers
    if !w.active then return
    pause_workers(m)
    w.control.with(c ->
        c.closing = true
        w.changed.notify_all()
        w.core1_changed.notify_all())
    for k in 0..<2
        w.handles[k] match
            Some(t) -> t.join()
            None -> ()
        w.handles[k] = None
    stop_dsi_worker(m)
    s.threaded = false
    s.horizon = NEVER
    w.active = false
    w.paced = false

/** The board clock a session paced at `hz` has reached at host time `now_ns`, when it was at
 * `origin_clock` at host time `origin_ns`. Whole seconds and the remainder are scaled apart, so the
 * product cannot overflow however long the session runs. The host clock is a parameter, so the
 * pacing is tested on a fake one.
 */
private[virt] paced_clock(origin_clock: u64, origin_ns: u64, now_ns: u64, hz: u64) -> u64
    val elapsed = now_ns - origin_ns
    origin_clock + elapsed / 1000000000 * hz + elapsed % 1000000000 * hz / 1000000000

/** The furthest a paced board's clock may run ahead of where it is: a twentieth of a second, and at
 * least one tick. Beyond it (the host stalled, or the machine slept) the session re-bases instead
 * of racing to catch up.
 */
private[virt] pacing_cap(hz: u64) -> u64 = max(1, hz / 20)

/** How long the leading worker waits, in host nanoseconds, before a paced board at `now` with the
 * host's clock at `target` has a whole quantum (a millisecond of board time, at most a batch) to run;
 * zero when it has one already.
 */
private[virt] pacing_wait_ns(target: u64, now: u64, hz: u64) -> u64
    val quantum = min(WORKER_BATCH, max(1, hz / 1000))
    if target > now && target - now >= quantum then return 0
    val missing = if target > now then quantum - (target - now) else quantum
    max(1, (missing * 1000000000 + hz - 1) / hz)

// The board clock a paced session has reached by the host's clock, under the control lock.
private wall_target(s: *Scheduler, c: *WorkerControl) -> u64
    val hz = s.workers.hz
    val now = s.now
    val due = paced_clock(c.origin_clock, c.origin_ns, host_now_ns(), hz)
    val cap = pacing_cap(hz)
    if due > now && due - now > cap
        c.origin_ns = host_now_ns()
        c.origin_clock = now + cap
        return now + cap
    due

// The leading worker, which runs `m`'s core 0: it takes the control requests, runs batches up to
// their horizon, and hands each paired run to the following worker by bumping `generation`.
private leading_worker(m: *Machine)
    val s = &m.scheduler
    val w = &s.workers
    val c = w.control.lock_raw()
    c.ids[0] = current().id
    w.changed.notify_all()
    loop
        if c.closing then break
        if c.paused || !c.snap.running
            w.changed.wait(&w.control)
            continue
        val stepping = c.step_pending
        var target = c.requested
        val now = s.now
        if w.hz != 0 && !w.paced && !stepping
            target = wall_target(s, c)
            val delay = pacing_wait_ns(target, now, w.hz)
            if delay != 0
                w.changed.wait_for(&w.control,i64(delay))
                continue
        if !stepping && !w.paced && target <= now
            w.changed.wait(&w.control)
            continue
        // Each normal worker runs until an explicit control request or stop.
        // No periodic job barrier lets a slow peer stall a faster CPU.
        val horizon = if w.paced && !stepping then NEVER else now + min(WORKER_BATCH,if stepping then 1 else target - now)
        c.busy = true
        w.control.unlock_raw()
        execute_worker_batch(m,horizon,stepping)
        w.control.lock_raw()
        c.snap = capture_workers(m, c.ids)
        c.busy = false
        if stepping
            c.step_pending = false
            c.paused = true
        w.changed.notify_all()
    w.control.unlock_raw()

// The following worker, which runs `m`'s core 1: one run of it for each generation the leading
// worker starts, reported back through `finished`.
private following_worker(m: *Machine)
    val w = &m.scheduler.workers
    val c = w.control.lock_raw()
    c.ids[1] = current().id
    w.changed.notify_all()
    var seen: u64 = 0
    loop
        while !c.closing && c.generation == seen do w.core1_changed.wait(&w.control)
        if c.closing then break
        seen = c.generation
        w.control.unlock_raw()
        run_core(m,1)
        w.control.lock_raw()
        c.finished = seen
        w.changed.notify_all()
    w.control.unlock_raw()

private execute_worker_batch(m: *Machine, horizon: u64, stepping: bool)
    val s = &m.scheduler
    val w = &s.workers
    val cpu = &m.cores[0]
    val second = &m.cores[1]
    if stepping
        s.threaded = false
        val count = if s.launched then 2 else 1
        for k in 0..<count
            val c = &m.cores[k]
            take_incoming(c)
            refresh(c)
            signal(m,c)
            if c.stop == Stop.Running && board_wake_by(c,board_time(c,c.retired))
                set_limit(c,c.retired + 1)
                run_single(c)
        if s.starting
            s.starting = false
            second.slept = local_time(second,board_time(cpu,cpu.retired))
        s.now = board_clock(m)
        flush_console(m)
        return
    if !w.parallel
        s.threaded = false
        take_incoming(cpu)
        take_incoming(second)
        refresh(cpu)
        refresh(second)
        pump_board(m,horizon - s.now)
        return
    if !s.launched
        turn(m,cpu,horizon)
        if s.starting
            s.starting = false
            s.now = board_time(cpu,cpu.retired)
            second.slept = local_time(second,s.now)
    if s.launched && cpu.stop == Stop.Running && second.stop == Stop.Running
        pair_cores(m,horizon)
        val job = w.control.with(c ->
            c.snap.launched = s.launched
            c.generation += 1
            w.core1_changed.notify_all()
            c.generation)
        run_core(m,0)
        val c = w.control.lock_raw()
        while c.finished != job do w.changed.wait(&w.control)
        w.control.unlock_raw()
    s.horizon = NEVER
    take_incoming(cpu)
    take_incoming(second)
    s.now = board_clock(m)
    flush_console(m)

// `m`'s clock once a batch has run: the later of the running cores' clocks.
private board_clock(m: *Machine) -> u64
    val (cpu, second) = (&m.cores[0], &m.cores[1])
    max(board_time(cpu,cpu.retired),if m.scheduler.launched then board_time(second,second.retired) else 0)

private host_now_ns() -> u64 = u64(monotonic().us) * 1000

/** Cheap control poll shared by the serial startup and parallel executors. */
private[virt] worker_run_interrupted(s: *Scheduler) -> bool
    val w = &s.workers
    w.active && w.paced && atomic_load(&w.interrupt,Acquire) != 0

/** A sleeping CPU must also stop at its next pacing checkpoint, rather than
 * skipping an entire control window into the future before consulting time.
 */
private[virt] worker_clock_limit(s: *Scheduler, c: *Cpu) -> u64
    val w = &s.workers
    if !w.active || !w.paced then return NEVER
    w.next_check[c.core] * divisor_of(c)

private[virt] worker_checkpoint(s: *Scheduler, cpu: *Cpu) -> bool
    val w = &s.workers
    if !w.active || !w.paced then return true
    if worker_run_interrupted(s) then return false
    val ticks = core_ticks(cpu,cpu.retired)
    val k = cpu.core
    if ticks < w.next_check[k] then return true
    val c = w.control.lock_raw()
    c.snap.cores[k] = capture_core(cpu)
    w.changed.notify_all()
    loop
        if c.paused || c.closing || lockstep_ended(s)
            w.control.unlock_raw()
            return false
        val wait = timing.wait_us(c.pacers[k],ticks,host_now_ns() / 1000)
        if wait == 0 then break
        val before = host_now_ns()
        w.changed.wait_for(&w.control,i64(wait * 1000))
        c.waited_us[k] += (host_now_ns() - before) / 1000
    timing.checkpoint(&c.pacers[k],ticks)
    w.next_check[k] = c.pacers[k].next_check
    w.control.unlock_raw()
    true

// A guest stop also interrupts a peer sleeping on its host-time deadline.
private[virt] wake_worker_checkpoints(s: *Scheduler)
    val w = &s.workers
    if !w.active || !w.paced then return
    w.control.with(c -> w.changed.notify_all())

/** True for the normal real-time worker session, independent of CPU models. */
private[virt] worker_independent(s: *Scheduler) -> bool = s.workers.active && s.workers.paced

// Under `m`'s workers' control lock. Compute lateness from the last published clock and the common
// host timestamp, even if a worker is currently stuck in a device.
private observed_workers(m: *Machine, c: *WorkerControl) -> WorkerObservation
    var snapshot = c.snap
    if !m.scheduler.workers.paced || !c.epoch_ready || c.paused || c.step_pending then return snapshot
    val at = host_now_ns() / 1000
    for k in 0..<(if snapshot.launched then 2 else 1)
        snapshot.cores[k].late_us = timing.late_us(c.pacers[k],snapshot.cores[k].time / m.configs[k].divisor,at)
    snapshot
