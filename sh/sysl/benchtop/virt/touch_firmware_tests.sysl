module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.benchtop.{load, library}
import sh.sysl.parsing.source_of
import sh.sysl.elf as elf
import sysl.raw.str_cast
import sysl.text.replace_all

private val TOUCH_GUEST = embed("../../../../examples/touch/demo.elf")

// The colour of a toggle's knob.
private const KNOB_COLOR: u32 = 0xE7EBEF

// The address of one of the touch firmware's exported state symbols (`touch_count`,
// `touch_enabled`, `touch_level`, `touch_heap_used`).
private touch_symbol(name: string) -> u32 = u32(elf.read(TOUCH_GUEST).unwrap().symbol_named(name).unwrap().unwrap().value)

private boot_touch()
    assert(board_named("boards/touch.hocon").is_ok())
    open_console()
    capture_bounded(256)
    boot(core0(), image_of(TOUCH_GUEST).unwrap().view())

private run_touch(cycles: u64 = 10000000)
    assert(pump_board(core0(), cycles), stop_message(core0()))

@test("touch imui firmware: GT911 click changes a guest counter and pixels, toggle drives GPIO, slider reaches both endpoints")
firmware_ui()
    boot_touch()
    val count = touch_symbol("touch_count")
    val enabled = touch_symbol("touch_enabled")
    val level = touch_symbol("touch_level")
    run_touch(30000000)
    assert(cpu.load32(core0(), count) == 0)
    assert(cpu.load8(core0(), enabled) == 1 && (panel_output_latch() & 32) != 0)
    val before = tft_frame("screen").unwrap()
    touch_point("touch", 120, 60, true)
    run_touch()
    assert(cpu.load32(core0(), count) == 0, "button activates on release")
    touch_point("touch", 120, 60, false)
    run_touch()
    assert(cpu.load32(core0(), count) == 1)
    val after = tft_frame("screen").unwrap()
    var changed = false
    for i in 0..<after.pixels.len() do if before.pixels.at(i) != after.pixels.at(i) then changed = true
    assert(changed, "imui count redraw traveled through actual GPIO SPI")
    touch_point("touch", 200, 125, true)
    run_touch()
    touch_point("touch", 200, 125, false)
    run_touch()
    assert(cpu.load8(core0(), enabled) == 0 && (panel_output_latch() & 32) == 0)
    val toggled = tft_frame("screen").unwrap()
    var knob_pixels = 0
    for x in 150..<230 do if toggled.pixels.at(usize(125 * 240 + x)) == KNOB_COLOR then knob_pixels += 1
    assert(knob_pixels > 0, "imui paints the new knob position in the same release frame")
    touch_point("touch", 120, 180, true)
    run_touch()
    touch_point("touch", 239, 180, true)
    run_touch()
    assert(cpu.load32(core0(), level) == 100)
    touch_point("touch", 0, 180, true)
    run_touch()
    assert(cpu.load32(core0(), level) == 0)
    release_touches()
    run_touch()

@test("touch imui firmware: a queued quick click survives the initial full-screen SPI redraw")
quick_click()
    boot_touch()
    touch_point("touch", 120, 60, true)
    touch_point("touch", 120, 60, false)
    run_touch(40000000)
    assert(cpu.load32(core0(), touch_symbol("touch_count")) == 1)

@test("touch I2C: GT911 address selection and an RTC share one controller without bypassing device protocols")
shared_i2c()
    val text = str_cast(embed("../../../../boards/touch.hocon"))
    val shared = replace_all(text, "parts {", "parts { rtc { part = DS3231SN, ref = U2, initial-time = fixed, wire { i2c = i2c0 } }")
    assert(board_from("shared.hocon", shared.bytes).is_ok())
    boot(core0(), image_of(TOUCH_GUEST).unwrap().view())
    val c = core0()
    cpu.store32(c, 0x50000300, 0x68)
    cpu.store32(c, 0x50000308, 1)
    cpu.store32(c, 0x50000304, 0)
    cpu.store32(c, 0x50000308, 4)
    cpu.store32(c, 0x50000308, 3)
    cpu.store32(c, 0x50000308, 2)
    assert(cpu.load32(c, 0x50000304) == 0 && (cpu.load32(c, 0x5000030C) & 2) == 0)
    cpu.store32(c, 0x50000308, 8)
    touch_point("touch", 12, 34, true)
    run_touch(40000000)
    assert(c.stop == cpu.Stop.Budget)
    val alternate = replace_all(text, "part = GT911", "part = GT911, address = 20")
    assert(board_from("alternate.hocon", alternate.bytes).is_ok(), "the real part supports either strap-selected address")
    val invalid = replace_all(text, "part = GT911", "part = GT911, address = 21")
    assert(load(source_of("invalid.hocon", invalid), library()).report.has_errors())

@test("touch PlutoVG: embedded TrueType text is antialiased and redraws reuse the bounded firmware heap")
vector_graphics()
    boot_touch()
    run_touch(40000000)
    assert(core0().kind == cpu.Kind.V8mMain && core0().fpu != cpu.Fpu.Absent)
    val frame = tft_frame("screen").unwrap()
    var colors: [64]u32 = [0;64]
    var count = 0
    for y in 4..<32
        for x in 12..<228
            val color = frame.pixels.at(usize(y * 240 + x))
            var found = false
            for i in 0..<count do if colors[i] == color then found = true
            if !found && count < 64
                colors[count] = color
                count += 1
    assert(count > 16, "TrueType glyph edges contain coverage shades, not just bitmap ink/background")
    val heap = touch_symbol("touch_heap_used")
    for i in 0..<10
        touch_point("touch", 200, 125, true)
        run_touch()
        touch_point("touch", 200, 125, false)
        run_touch()
    val warm = cpu.load32(core0(), heap)
    for i in 0..<10
        touch_point("touch", 200, 125, true)
        run_touch()
        touch_point("touch", 200, 125, false)
        run_touch()
    val used = cpu.load32(core0(), heap)
    assert(warm > 0 && used <= warm + 8192 && used <= 131072, s"heap warm=$warm final=$used")
