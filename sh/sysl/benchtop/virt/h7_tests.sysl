module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf

private val H7_GUEST = embed("../../../../examples/touch/h7.elf")

@test("H747 boot: flash-linked M7 releases M4 through RCC and M4 runs the touch UI on its own worker")
h747_touch_on_m4()
    val board = machine()
    val m = &*board
    assert(board_named(m, "boards/h747-cores.hocon").is_ok())
    open_console(m)
    capture(m)
    boot(m,image_of(m, H7_GUEST).unwrap().view())
    assert(!running_both(m) && core0(m).pc >= 0x08000000)
    assert(board_read(m,core0(m),0x580244a0,4,0) == 4)
    start_workers(m).unwrap()
    defer stop_workers(m)
    submit_workers(m,100000000)
    wait_workers(m)
    pause_workers(m)
    val snap = workers_observe(m)
    assert(snap.launched && snap.running,stop_message(if core0(m).stop != cpu.Stop.Running then core0(m) else core1(m)))
    assert(core0(m).kind == cpu.Kind.V7emM7 && core1(m).kind == cpu.Kind.V7em)
    assert(core0(m).fpu == cpu.Fpu.Double && core1(m).fpu == cpu.Fpu.Single)
    assert(core1(m).vtor == 0x08100000)
    assert(board_read(m,core0(m),0x580244a0,4,core0(m).retired) == 12)
    val executable = elf.read(H7_GUEST).unwrap()
    val state = u32(executable.symbol_named("touch_count").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    assert(cpu.load32(core0(m),frames) > 0,"M4 must have finished rendering a frame")
    assert(cpu.load32(core0(m),state) == 0)
    assert(snap.cores[0].retired > snap.cores[1].retired)
    val before = tft_frame(m, "screen").unwrap()
    touch_point(m, "touch",120,60,true)
    submit_workers(m,20000000)
    wait_workers(m)
    touch_point(m, "touch",120,60,false)
    submit_workers(m,20000000)
    wait_workers(m)
    pause_workers(m)
    assert(workers_observe(m).running)
    assert(cpu.load32(core0(m),state) == 1,"M4 handles the button release")
    val after = tft_frame(m, "screen").unwrap()
    var changed = false
    for i in 0..<after.pixels.len() do if before.pixels.at(i) != after.pixels.at(i) then changed = true
    assert(changed,"UI pixels must travel through guest SPI to the panel")

@test("H747 RCC boot control: reset state, reserved bits, access width, unknown registers and malformed vectors")
h747_rcc_boundaries()
    val board = machine()
    val m = &*board
    assert(board_named(m, "boards/h747-cores.hocon").is_ok())
    boot(m,image_of(m, H7_GUEST).unwrap().view())
    board_write(m,core0(m),0x580244a0,4,0xfffffff7,0)
    assert(!running_both(m) && board_read(m,core0(m),0x580244a0,4,0) == 4)
    board_read(m,core0(m),0x580244a0,2,0)
    assert(core0(m).stop == cpu.Stop.Fault)
    boot(m,image_of(m, H7_GUEST).unwrap().view())
    board_read(m,core0(m),0x58024400,4,0)
    assert(core0(m).stop == cpu.Stop.Unmapped,"unimplemented RCC registers must not silently acknowledge setup")
    boot(m,image_of(m, H7_GUEST).unwrap().view())
    m.devices.rcc.cm4_boot = 0x081f0000 // Erased flash: invalid stack/vector pair.
    board_write(m,core0(m),0x580244a0,4,12,0)
    assert(running_both(m))
    assert(core1(m).vtor == 0x081f0000)

// RCC base plus offset.
private rcc(offset: u32) -> u32 = 0x58024400 + offset

// The enable registers' offsets in RM0399's order, relative to a view's first (AHB3ENR).
private val ENR_NAMES: [9]string = ["AHB3ENR", "AHB1ENR", "AHB2ENR", "AHB4ENR", "APB3ENR", "APB1LENR", "APB1HENR", "APB2ENR", "APB4ENR"]
// One documented bit of each register (CMSIS stm32h747xx.h), and every bit it has.
private val ENR_SAMPLE: [9]u32 = [0x00010000, 0x00000001, 0x00000200, 0x00000100, 0x00000010, 0x00020000, 0x00000100, 0x00000010, 0x00000080]
private val ENR_ALL: [9]u32 = [0xf0015131, 0x1e03c023, 0xe0000241, 0x132807ff, 0x00000058, 0xe8ffcbff, 0x00000136, 0x31d73033, 0x0021deaa]

// The plain view, CPU1's copies and CPU2's copies of AHB3ENR.
private val VIEWS: [3]u32 = [0xd4, 0x134, 0x194]
// Registers around the enables that stay refused: the reset registers (AHB4RSTR, AHB3RSTR,
// APB4RSTR), RSR, the gap after APB4ENR, AHB4LPENR, C1_RSR, the gap after C1_APB4ENR,
// C1_AHB4LPENR, C2_RSR, the gap after C2_APB4ENR and C2_AHB4LPENR.
private val REFUSED: [12]u32 = [0x88, 0x7c, 0x9c, 0xd0, 0xf8, 0x108, 0x130, 0x158, 0x168, 0x190, 0x1b8, 0x1c8]

private h7_board() -> &Machine
    val board = machine()
    assert(board_named(&*board, "boards/h747-cores.hocon").is_ok())
    boot(&*board,image_of(&*board, H7_GUEST).unwrap().view())
    board

@test("H747 RCC enables: reset values and read-back of every register in all three views")
h747_rcc_enables_reset_and_readback()
    val board = h7_board()
    val m = &*board
    for i in 0..<9
        for at in VIEWS
            assert(board_read(m,core0(m),rcc(at + i * 4),4,0) == (if i == 8 then 0x00010000 else 0), ENR_NAMES[i])
        board_write(m,core0(m),rcc(0x134 + i * 4),4,ENR_ALL[i],0)
        assert(core0(m).stop == cpu.Stop.Running, ENR_NAMES[i])
        assert(board_read(m,core0(m),rcc(0x134 + i * 4),4,0) == ENR_ALL[i], ENR_NAMES[i])
        board_write(m,core0(m),rcc(0x194 + i * 4),4,ENR_SAMPLE[i],0)
        assert(board_read(m,core0(m),rcc(0x194 + i * 4),4,0) == ENR_SAMPLE[i], ENR_NAMES[i])
        board_write(m,core0(m),rcc(0xd4 + i * 4),4,0,0)
        assert(board_read(m,core0(m),rcc(0x134 + i * 4),4,0) == 0, "the plain register is CPU1's copy for the CM7")
        assert(board_read(m,core0(m),rcc(0x194 + i * 4),4,0) == ENR_SAMPLE[i], "CPU2's copy is untouched")
    board_write(m,core0(m),rcc(0xe0),4,0x7ff,0)
    boot(m,image_of(m, H7_GUEST).unwrap().view())
    assert(board_read(m,core0(m),rcc(0xe0),4,0) == 0 && board_read(m,core0(m),rcc(0x194),4,0) == 0, "a reset restores the enables")
    assert(board_read(m,core0(m),rcc(0xf4),4,0) == 0x00010000)

@test("H747 RCC enables: each core's plain registers are its own copy")
h747_rcc_enables_per_core()
    val board = h7_board()
    val m = &*board
    board_write(m,core0(m),rcc(0xe0),4,0x00000101,0)
    board_write(m,core1(m),rcc(0xe0),4,0x00000002,0)
    assert(board_read(m,core0(m),rcc(0xe0),4,0) == 0x101 && board_read(m,core1(m),rcc(0xe0),4,0) == 2)
    assert(board_read(m,core1(m),rcc(0x140),4,0) == 0x101, "CPU2 reads CPU1's copy at C1_AHB4ENR")
    assert(board_read(m,core0(m),rcc(0x1a0),4,0) == 2, "CPU1 reads CPU2's copy at C2_AHB4ENR")
    board_write(m,core1(m),rcc(0x140),4,0x10000000,0)
    assert(board_read(m,core0(m),rcc(0xe0),4,0) == 0x10000000, "either core may write the other's copy")

@test("H747 RCC enables: reserved bits, access width, reset registers and gaps still fault")
h747_rcc_enables_refusals()
    val board = h7_board()
    val m = &*board
    for i in 0..<9
        board_write(m,core0(m),rcc(0x134 + i * 4),4,ENR_SAMPLE[i],0)
        board_write(m,core0(m),rcc(0x134 + i * 4),4,ENR_SAMPLE[i] | ~ENR_ALL[i],0)
        assert(core0(m).stop == cpu.Stop.Fault, ENR_NAMES[i])
        assert(board_read(m,core0(m),rcc(0x134 + i * 4),4,0) == ENR_SAMPLE[i], "a refused write leaves the register as it was")
        boot(m,image_of(m, H7_GUEST).unwrap().view())
    board_write(m,core0(m),rcc(0xe0),2,1,0)
    assert(core0(m).stop == cpu.Stop.Fault, "a halfword store to an enable register")
    boot(m,image_of(m, H7_GUEST).unwrap().view())
    board_read(m,core0(m),rcc(0xe2),4,0)
    assert(core0(m).stop == cpu.Stop.Fault, "a misaligned word")
    for at in REFUSED
        boot(m,image_of(m, H7_GUEST).unwrap().view())
        board_write(m,core0(m),rcc(at),4,1,0)
        assert(core0(m).stop == cpu.Stop.Unmapped, "a write outside the enables stays refused")
        boot(m,image_of(m, H7_GUEST).unwrap().view())
        board_read(m,core0(m),rcc(at),4,0)
        assert(core0(m).stop == cpu.Stop.Unmapped, "a read outside the enables stays refused")
