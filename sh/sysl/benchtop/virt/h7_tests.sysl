module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf

private val H7_GUEST = embed("../../../../examples/touch/h7.elf")

@test("H747 boot: flash-linked M7 releases M4 through RCC and M4 runs the touch UI on its own worker")
h747_touch_on_m4()
    assert(board_named("boards/h747-cores.hocon").is_ok())
    open_console()
    capture()
    boot(core0(),image_of(H7_GUEST).unwrap().view())
    assert(!running_both() && core0().pc >= 0x08000000)
    assert(board_read(core0(),0x580244a0,4,0) == 4)
    start_workers(core0()).unwrap()
    defer stop_workers()
    submit_workers(100000000)
    wait_workers()
    pause_workers()
    val snap = workers_observe()
    assert(snap.launched && snap.running,stop_message(if core0().stop != cpu.Stop.Budget then core0() else core1()))
    assert(core0().kind == cpu.Kind.V7emM7 && core1().kind == cpu.Kind.V7em)
    assert(core0().fpu == 2 && core1().fpu == 1)
    assert(core1().vtor == 0x08100000)
    assert(board_read(core0(),0x580244a0,4,core0().retired) == 12)
    val executable = elf.read(H7_GUEST).unwrap()
    val state = u32(executable.symbol_named("touch_app").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    assert(cpu.load32(core0(),frames) > 0,"M4 must have finished rendering a frame")
    assert(cpu.load32(core0(),state) == 0)
    assert(snap.cores[0].retired > snap.cores[1].retired)
    val before = tft_frame("screen").unwrap()
    touch_point("touch",120,60,true)
    submit_workers(20000000)
    wait_workers()
    touch_point("touch",120,60,false)
    submit_workers(20000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running)
    assert(cpu.load32(core0(),state) == 1,"M4 handles the button release")
    val after = tft_frame("screen").unwrap()
    var changed = false
    for i in 0..<after.pixels.len() do if before.pixels.at(i) != after.pixels.at(i) then changed = true
    assert(changed,"UI pixels must travel through guest SPI to the panel")

@test("H747 RCC boot control: reset state, reserved bits, access width, unknown registers and malformed vectors")
h747_rcc_boundaries()
    assert(board_named("boards/h747-cores.hocon").is_ok())
    boot(core0(),image_of(H7_GUEST).unwrap().view())
    board_write(core0(),0x580244a0,4,0xfffffff7,0)
    assert(!running_both() && board_read(core0(),0x580244a0,4,0) == 4)
    board_read(core0(),0x580244a0,2,0)
    assert(core0().stop == cpu.Stop.Fault)
    boot(core0(),image_of(H7_GUEST).unwrap().view())
    board_read(core0(),0x58024400,4,0)
    assert(core0().stop == cpu.Stop.Unmapped,"unimplemented RCC registers must not silently acknowledge setup")
    boot(core0(),image_of(H7_GUEST).unwrap().view())
    machine.devices.rcc.cm4_boot = 0x081f0000 // Erased flash: invalid stack/vector pair.
    board_write(core0(),0x580244a0,4,12,0)
    assert(running_both())
    assert(core1().vtor == 0x081f0000)
