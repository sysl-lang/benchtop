module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board,Part,part_model,part_whole}
import sh.sysl.benchtop.parts.wm8994 as wm
import sh.sysl.benchtop.peripheral.i2c as i2c
import sysl.buf.{Buf,buf}
import sysl.sync.*
import sysl.threads.Mutex
import sysl.math.{min,max}

/** The WM8994 codec (`wm8994`) on the I2C bus and the SAI: its model, its name on the board, the SAI
 * block it plays from (the other one records), what it drives (`present` once it drives a speaker or
 * headphones) and whether a microphone feeds it, and the host's gain on each output. `gains`,
 * `hp_gains`, `capture_gains` and `bits` are the model's settings, published for the SAI to read
 * without the I2C lock.
 */
struct CodecState
    model: &wm.Codec
    name: string
    block: usize
    present: bool
    headphones: bool
    speaker_present: bool
    mic: bool
    host_gain: [2]u32
    capture_gains: [2]u32
    hp_gains: [2]u32
    gains: [2]u32
    bits: u32
    // The microphone frame the SAI is recording, published for its slots to read without a lock.
    input_frame: int
    input: Mutex[CodecInput]
    mix: Mutex[CodecMix]

/** What the host has given the microphone and not yet sent: a ring of `count` words from `head`,
 * and whether enough has arrived to start sending.
 */
struct CodecInput
    words: [4096]int
    head: usize
    count: usize
    primed: bool

/** The frame the host is taking from what the codec played: each output's sum so far, the frame's
 * number, and whether its first slot has been seen.
 */
struct CodecMix
    sums: [2]real
    frame: u64
    started: bool

/** No codec on the board. */
codec_state() -> CodecState = CodecState(wm.codec(), "", 0, false, false, false, false, [12,12], [0,0], [0,0], [0,0], 16,
    0, Mutex.new(CodecInput([0;4096], 0, 0, false)), Mutex.new(CodecMix([0.0,0.0], 0, false)))

// Whether `p` is a speaker the codec `c` drives.
codec_speaker(c: *CodecState, p: Part) -> bool
    if c.name.is_empty() then return false
    for wire in p.wires do wire.to match
        Port(owner,terminal) -> if owner == c.name && terminal == "out" then return true
        _ -> ()
    false

// The codec `b` puts on the I2C bus, beside the `devices` already there.
private[virt] check_codec(b: Board, devices: *Buf[i2c.Device]) -> Result[CodecState,string]
    var s = codec_state()
    for p in b.parts
        if part_model(p) != "wm8994" then continue
        if !s.name.is_empty() then return Err("one WM8994 codec is currently supported")
        s.name = p.name
        s.block = usize(part_whole(p,"block",0))
        var attached = false
        for wire in p.wires
            if wire.port != "sai" then continue
            wire.to match
                Bus(name) -> for peripheral in b.chip.peripherals
                    if peripheral.name == name && peripheral.kind == "stm32-sai" then attached = true
                _ -> ()
        for wire in p.wires
            if wire.port != "dmic1" then continue
            var found = false
            wire.to match
                Port(owner,terminal) -> for source in b.parts
                    if source.name == owner && terminal == "out" && part_model(source) == "pdm-microphone" then found = true
                _ -> ()
            if !found then return Err("WM8994 dmic1 requires a pdm-microphone out terminal")
            s.mic = true
        if !attached then return Err("WM8994 requires a stm32-sai controller")
        val address = u8(part_whole(p,"address",0x1a))
        for device in *devices do if device.address == address then return Err("two I2C parts share the same address")
        val model = s.model
        devices.push(i2c.Device(address,(reading,time) -> wm.start(model,reading),
            (byte,time) ->
                val ok = wm.write(model,byte)
                publish_codec()
                ok,
            time -> wm.read(model)))
    for p in b.parts
        val headphone = part_model(p) == "headphones"
        if part_model(p) != "speaker" && !headphone then continue
        if !headphone && !codec_speaker(&s, p) then continue
        if headphone
            var attached = false
            for wire in p.wires do wire.to match
                Port(owner,terminal) -> if wire.port == "input" && owner == s.name && terminal == "headphones" then attached = true
                _ -> ()
            if !attached then return Err("headphones input must connect to the WM8994 headphones terminal")
            if s.headphones then return Err("one headphones output is supported per codec")
            s.headphones = true
        else
            if s.speaker_present then return Err("one speaker output is supported per codec")
            s.speaker_present = true
        s.present = true
        s.host_gain[if headphone then 1 else 0] = u32(part_whole(p,"gain",12))
    for source in b.parts
        if part_model(source) != "pdm-microphone" then continue
        var used = false
        for part in b.parts
            if part.name != s.name then continue
            for wire in part.wires do wire.to match
                Port(owner,terminal) -> if wire.port == "dmic1" && owner == source.name && terminal == "out" then used = true
                _ -> ()
        if !used then return Err("pdm-microphone must connect to the WM8994 dmic1 terminal")
    Ok(s)

private publish_codec()
    val s = &machine.devices.codec
    val gains = wm.speaker_gains(s.model)
    for i in 0..<2 do atomic_store(&s.gains[i],gains[i],Release)
    val hp = wm.headphone_gains(s.model)
    for i in 0..<2 do atomic_store(&s.hp_gains[i],hp[i],Release)
    val capture = wm.capture_gains(s.model)
    for i in 0..<2 do atomic_store(&s.capture_gains[i],capture[i],Release)
    atomic_store(&s.bits,wm.word_bits(s.model),Release)

private[virt] boot_codecs()
    wm.reset(machine.devices.codec.model)
    publish_codec()
    machine.devices.codec.mix.with(m ->
        m.sums = [0.0,0.0]
        m.started = false)
    clear_codec_input()

// Called under the SAI queue lock: integer snapshots only, no codec/I2C lock.
private[virt] codec_slot_gain(block: usize, slot: u32, slots: u32, bits: u32) -> u32
    val s = &machine.devices.codec
    if !s.present || block != s.block || slots != 4 || bits != atomic_load(&s.bits,Acquire) then return 0
    val channel = usize(slot / 2)
    if channel >= 2 then return 0
    if slot & 1 == 0
        if s.headphones then u32(u64(atomic_load(&s.hp_gains[channel],Acquire)) * u64(s.host_gain[1]) / 100) else 0
    else
        if s.speaker_present then u32(u64(atomic_load(&s.gains[channel],Acquire)) * u64(s.host_gain[0]) / 100) else 0

private[virt] take_codec_sound(channels: u32 = 1) -> Buf[f32]
    require channels == 1 || channels == 2, "mono or stereo output"
    var result: Buf[f32] = buf()
    val into = &result
    val s = &machine.devices.codec
    val block = s.block
    s.mix.with(m ->
        val packets = sai_take_packets(block)
        for p in packets
            if p.slot == 0
                m.sums = [0.0,0.0]
                m.frame = p.frame
                m.started = true
            if !m.started || p.frame != m.frame then continue
            if p.bits > 0 && p.bits <= 32 && p.slot < 4
                val signed = long(int(p.word << (32 - p.bits))) >> (32 - p.bits)
                m.sums[usize(p.slot / 2)] += real(signed) / real(1u64 << (p.bits - 1)) * real(p.gain) / 65536.0
            if p.slot + 1 == p.slots
                m.started = false
                if channels == 1
                    into.push(f32(max(-1.0,min(1.0,(m.sums[0] + m.sums[1]) * 0.5))))
                else
                    for value in m.sums do into.push(f32(max(-1.0,min(1.0,value)))))
    result

// Host conversion never runs on a guest CPU worker. The bounded queue holds
// mono PCM frames; the codec consumes one frame at slot0 and reuses it at slot2.
private[virt] feed_codec_microphone(samples: []const f32)
    if !machine.devices.codec.mic then return
    var words: Buf[int] = buf()
    for sample in samples
        val clipped = if sample != sample then 0.0f32 else max(-1.0f32,min(1.0f32,sample))
        words.push(int(min(2147483647.0,real(clipped) * 2147483648.0)))
    machine.devices.codec.input.with(q ->
        for word in words
            if q.count == 4096
                q.head = (q.head + 1) % 4096
                q.count -= 1
            q.words[(q.head + q.count) % 4096] = word
            q.count += 1)

private[virt] clear_codec_input()
    val s = &machine.devices.codec
    s.input.with(q ->
        q.head = 0
        q.count = 0
        q.primed = false
        atomic_store(&machine.devices.codec.input_frame,0,Release))

private[virt] codec_input_word(block: usize, slot: u32, slots: u32, bits: u32) -> Option[u32]
    val s = &machine.devices.codec
    if !s.mic || block != 1 - s.block then return None
    if slots != 4 || bits != atomic_load(&s.bits,Acquire) then return Some(0)
    if slot == 0
        s.input.with(q ->
            // A short host prebuffer absorbs capture/UI scheduling jitter.
            if !q.primed && q.count >= 1024 then q.primed = true
            atomic_store(&machine.devices.codec.input_frame,0,Release)
            if q.primed && q.count > 0
                atomic_store(&machine.devices.codec.input_frame,q.words[q.head],Release)
                q.head = (q.head + 1) % 4096
                q.count -= 1
            else q.primed = false)
    if slot != 0 && slot != 2 then return Some(0)
    val gain = atomic_load(&s.capture_gains[usize(slot / 2)],Acquire)
    val sample = ((long(atomic_load(&s.input_frame,Acquire)) * long(gain)) >> 16) >> (32 - bits)
    val limit = 1i64 << (bits - 1)
    Some(u32(max(-limit,min(limit - 1,sample))))
