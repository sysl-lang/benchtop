module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board,Part,part_model,part_whole}
import sh.sysl.benchtop.parts.wm8994 as wm
import sh.sysl.benchtop.peripheral.i2c as i2c
import sysl.buf.{Buf,buf}
import sysl.sync.*
import sysl.threads.SleepLock
import sysl.math.{min,max}

var codec_present = false
var codec_headphones = false
private var codec_speaker_present = false
var codec_mic = false
private var codec_capture_gains: [2]u32 = [0,0]
private var codec_input_lock = SleepLock.new()
private var codec_input: [4096]int
private var codec_input_head: usize = 0
private var codec_input_count: usize = 0
private var codec_input_primed = false
private var codec_input_frame: int = 0
private var codec_name = ""
private var codec_model = wm.codec()
private var codec_block: usize = 0
private var codec_host_gain: [2]u32 = [12,12]
private var codec_hp_gains: [2]u32 = [0,0]
private var codec_gains: [2]u32 = [0,0]
private var codec_bits: u32 = 16
private var codec_mix: [2]real = [0.0,0.0]
private var codec_mix_lock = SleepLock.new()
private var codec_frame: u64 = 0
private var codec_frame_started = false

codec_speaker(p: Part) -> bool
    if codec_name.is_empty() then return false
    for wire in p.wires do wire.to match
        Port(owner,terminal) -> if owner == codec_name && terminal == "out" then return true
        _ -> ()
    false

private[virt] configure_codecs(b: Board, devices: *Buf[i2c.Device]) -> Result[unit,string]
    codec_present = false
    codec_headphones = false
    codec_speaker_present = false
    codec_mic = false
    codec_name = ""
    for p in b.parts
        if part_model(p) != "wm8994" then continue
        if !codec_name.is_empty() then return Err("one WM8994 codec is currently supported")
        codec_name = p.name
        codec_block = usize(part_whole(p,"block",0))
        var attached = false
        for wire in p.wires
            if wire.port != "sai" then continue
            wire.to match
                Bus(name) -> for peripheral in b.chip.peripherals
                    if peripheral.name == name && peripheral.kind == "stm32-sai" then attached = true
                _ -> ()
        for wire in p.wires
            if wire.port != "dmic1" then continue
            var found = false
            wire.to match
                Port(owner,terminal) -> for source in b.parts
                    if source.name == owner && terminal == "out" && part_model(source) == "pdm-microphone" then found = true
                _ -> ()
            if !found then return Err("WM8994 dmic1 requires a pdm-microphone out terminal")
            codec_mic = true
        if !attached then return Err("WM8994 requires a stm32-sai controller")
        val address = u8(part_whole(p,"address",0x1a))
        for device in *devices do if device.address == address then return Err("two I2C parts share the same address")
        codec_model = wm.codec()
        devices.push(i2c.Device(address,(reading,time) -> wm.start(codec_model,reading),
            (byte,time) ->
                val ok = wm.write(codec_model,byte)
                publish_codec()
                ok,
            time -> wm.read(codec_model)))
    for p in b.parts
        val headphone = part_model(p) == "headphones"
        if part_model(p) != "speaker" && !headphone then continue
        if !headphone && !codec_speaker(p) then continue
        if headphone
            var attached = false
            for wire in p.wires do wire.to match
                Port(owner,terminal) -> if wire.port == "input" && owner == codec_name && terminal == "headphones" then attached = true
                _ -> ()
            if !attached then return Err("headphones input must connect to the WM8994 headphones terminal")
            if codec_headphones then return Err("one headphones output is supported per codec")
            codec_headphones = true
        else
            if codec_speaker_present then return Err("one speaker output is supported per codec")
            codec_speaker_present = true
        codec_present = true
        codec_host_gain[if headphone then 1 else 0] = u32(part_whole(p,"gain",12))
    for source in b.parts
        if part_model(source) != "pdm-microphone" then continue
        var used = false
        for part in b.parts
            if part.name != codec_name then continue
            for wire in part.wires do wire.to match
                Port(owner,terminal) -> if wire.port == "dmic1" && owner == source.name && terminal == "out" then used = true
                _ -> ()
        if !used then return Err("pdm-microphone must connect to the WM8994 dmic1 terminal")
    boot_codecs()
    Ok(())

private publish_codec()
    val gains = wm.speaker_gains(codec_model)
    for i in 0..<2 do atomic_store(&codec_gains[i],gains[i],Release)
    val hp = wm.headphone_gains(codec_model)
    for i in 0..<2 do atomic_store(&codec_hp_gains[i],hp[i],Release)
    val capture = wm.capture_gains(codec_model)
    for i in 0..<2 do atomic_store(&codec_capture_gains[i],capture[i],Release)
    atomic_store(&codec_bits,wm.word_bits(codec_model),Release)

private[virt] boot_codecs()
    wm.reset(codec_model)
    publish_codec()
    codec_mix_lock.lock()
    codec_mix = [0.0,0.0]
    codec_frame_started = false
    codec_mix_lock.unlock()
    clear_codec_input()

// Called under the SAI queue lock: integer snapshots only, no codec/I2C lock.
private[virt] codec_slot_gain(block: usize, slot: u32, slots: u32, bits: u32) -> u32
    if !codec_present || block != codec_block || slots != 4 || bits != atomic_load(&codec_bits,Acquire) then return 0
    val channel = usize(slot / 2)
    if channel >= 2 then return 0
    if slot & 1 == 0
        if codec_headphones then u32(u64(atomic_load(&codec_hp_gains[channel],Acquire)) * u64(codec_host_gain[1]) / 100) else 0
    else
        if codec_speaker_present then u32(u64(atomic_load(&codec_gains[channel],Acquire)) * u64(codec_host_gain[0]) / 100) else 0

private[virt] take_codec_sound(channels: u32 = 1) -> Buf[f32]
    require channels == 1 || channels == 2, "mono or stereo output"
    codec_mix_lock.lock()
    defer codec_mix_lock.unlock()
    var result: Buf[f32] = buf()
    val packets = sai_take_packets(codec_block)
    for p in packets
        if p.slot == 0
            codec_mix = [0.0,0.0]
            codec_frame = p.frame
            codec_frame_started = true
        if !codec_frame_started || p.frame != codec_frame then continue
        if p.bits > 0 && p.bits <= 32 && p.slot < 4
            val signed = long(int(p.word << (32 - p.bits))) >> (32 - p.bits)
            codec_mix[usize(p.slot / 2)] += real(signed) / real(1u64 << (p.bits - 1)) * real(p.gain) / 65536.0
        if p.slot + 1 == p.slots
            codec_frame_started = false
            if channels == 1
                result.push(f32(max(-1.0,min(1.0,(codec_mix[0] + codec_mix[1]) * 0.5))))
            else
                for value in codec_mix do result.push(f32(max(-1.0,min(1.0,value))))
    result

// Host conversion never runs on a guest CPU worker. The bounded queue holds
// mono PCM frames; the codec consumes one frame at slot0 and reuses it at slot2.
private[virt] feed_codec_microphone(samples: []const f32)
    if !codec_mic then return
    var words: Buf[int] = buf()
    for sample in samples
        val clipped = if sample != sample then 0.0f32 else max(-1.0f32,min(1.0f32,sample))
        words.push(int(min(2147483647.0,real(clipped) * 2147483648.0)))
    codec_input_lock.lock()
    defer codec_input_lock.unlock()
    for word in words
        if codec_input_count == 4096
            codec_input_head = (codec_input_head + 1) % 4096
            codec_input_count -= 1
        codec_input[(codec_input_head + codec_input_count) % 4096] = word
        codec_input_count += 1

private[virt] clear_codec_input()
    codec_input_lock.lock()
    defer codec_input_lock.unlock()
    codec_input_head = 0
    codec_input_count = 0
    codec_input_primed = false
    atomic_store(&codec_input_frame,0,Release)

private[virt] codec_input_word(block: usize, slot: u32, slots: u32, bits: u32) -> Option[u32]
    if !codec_mic || block != 1 - codec_block then return None
    if slots != 4 || bits != atomic_load(&codec_bits,Acquire) then return Some(0)
    if slot == 0
        codec_input_lock.lock()
        // A short host prebuffer absorbs capture/UI scheduling jitter.
        if !codec_input_primed && codec_input_count >= 1024 then codec_input_primed = true
        atomic_store(&codec_input_frame,0,Release)
        if codec_input_primed && codec_input_count > 0
            atomic_store(&codec_input_frame,codec_input[codec_input_head],Release)
            codec_input_head = (codec_input_head + 1) % 4096
            codec_input_count -= 1
        else codec_input_primed = false
        codec_input_lock.unlock()
    if slot != 0 && slot != 2 then return Some(0)
    val gain = atomic_load(&codec_capture_gains[usize(slot / 2)],Acquire)
    val sample = ((long(atomic_load(&codec_input_frame,Acquire)) * long(gain)) >> 16) >> (32 - bits)
    val limit = 1i64 << (bits - 1)
    Some(u32(max(-limit,min(limit - 1,sample))))
