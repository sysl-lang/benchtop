module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{Board, param_named}
import sh.sysl.benchtop.v6m.{Cpu,Kind,Stop,halt,load32}

// Initial boot-control subset of RCC. Unknown registers fault explicitly; this
// does not substitute ready bits for unimplemented oscillator/PLL behavior.
// ST CMSIS stm32h747xx.h: GCR offset 0xa0, BOOT_C1 bit 2, BOOT_C2 bit 3.
// CM4's reset address is a board option-byte setting, not a fictitious MMIO.
var h7_cm4_boot: u32 = 0x08100000
private var h7_gcr: u32 = 4

private[virt] configure_h7(b: Board) -> Result[unit,string]
    h7_cm4_boot = 0x08100000
    for p in b.chip.peripherals
        if p.kind != "stm32h7-rcc" then continue
        if core_kinds[0] != Kind.V7emM7 || core_kinds[1] != Kind.V7em then
            return Err("stm32h7-rcc requires core 0 Cortex-M7 and core 1 Cortex-M4")
        param_named(p.params,"cm4-boot-address") match
            Some(q) -> q.value match
                Whole(at) -> h7_cm4_boot = u32(at)
                _ -> ()
            None -> ()
        if h7_cm4_boot & 0xffff != 0 then return Err("CM4 boot address must align to the option bytes' 64 KB granularity")
    Ok(())

private[virt] boot_h7() = h7_gcr = 4

private[virt] h7_rcc_read(c: *Cpu, address: u32, offset: u32, width: u32) -> u32
    if width != 4 || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return 0
    if offset == 0xa0 then return h7_gcr
    halt(c,Stop.Unmapped,address)
    0

private[virt] h7_rcc_write(c: *Cpu, address: u32, offset: u32, width: u32, value: u32)
    if width != 4 || offset & 3 != 0
        halt(c,Stop.Fault,address)
        return
    if offset != 0xa0
        halt(c,Stop.Unmapped,address)
        return
    // Boot control is handled before both workers start; no second thread may
    // alter reset/launch state or clear a running CPU's boot request.
    if c.core != 0 || (launched && (value & 12) != h7_gcr)
        halt(c,Stop.Fault,address)
        return
    h7_gcr = 4 | (value & 8)
    if !launched && h7_gcr & 8 != 0
        val sp = load32(c,h7_cm4_boot)
        val entry = load32(c,h7_cm4_boot + 4)
        if c.stop == Stop.Budget then launch(h7_cm4_boot,sp,entry)
