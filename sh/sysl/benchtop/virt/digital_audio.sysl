module sh.sysl.benchtop.virt

import sh.sysl.benchtop.{mcu_clock_hz, Board, part_model, part_whole, param_named}
import sh.sysl.benchtop.peripheral.i2s as i2s
import sh.sysl.benchtop.v6m.{Cpu, Stop, halt}
import sysl.buf.{Buf, buf}
import sysl.threads.Mutex

/** The I2S controller (`virt-i2s`) and the amplifier, speaker and microphone on it: whether the bus
 * has it, its clock, whether a speaker plays what it sends and at what gain, and whether a microphone
 * feeds it, which the board fixes; and the controller, which the cores and the host's audio share.
 */
struct I2sState
    present: bool
    hz: u64
    speaker: bool
    mic: bool
    gain: f32
    controller: Mutex[i2s.Controller]

/** No I2S controller on the bus. */
i2s_state() -> I2sState = I2sState(false, 0, false, false, 0.12, Mutex.new(i2s.controller()))

// The I2S path `b` makes, beside the buzzers `pwm` drives and the codec `codec` makes.
private[virt] check_i2s(b: Board, pwm: *PwmState, codec: *CodecState) -> Result[I2sState, string]
    var s = i2s_state()
    var hz: u64 = mcu_clock_hz(b.chip)
    var bus = ""
    for p in b.chip.peripherals
        if p.kind != "virt-i2s" then continue
        s.present = true
        bus = p.name
        param_named(p.params, "clock-hz") match
            Some(q) -> q.value match
                Whole(n) -> hz = u64(n)
                _ -> ()
            None -> ()
    if s.present && pwm.buzzer_count != 0 && hz != pwm.hz then return Err("PWM and I2S audio must share the same guest clock")
    val controller = i2s.controller(hz)
    s.hz = controller.hz
    s.controller = Mutex.new(controller)
    var amplifier = ""
    for p in b.parts
        if part_model(p) != "i2s-amplifier" && part_model(p) != "i2s-microphone" then continue
        if !s.present then return Err("digital audio parts require a virt-i2s peripheral")
        for wire in p.wires
            if wire.port != "i2s" then continue
            wire.to match
                Bus(name) -> if name != bus then return Err("digital audio part uses an unsupported controller")
                _ -> ()
        if part_model(p) == "i2s-amplifier"
            if !amplifier.is_empty() then return Err("one I2S amplifier is supported per controller")
            amplifier = p.name
        else
            if s.mic then return Err("one left-channel I2S microphone is supported per controller")
            s.mic = true
    for p in b.parts
        if part_model(p) != "speaker" || codec_speaker(codec, p) then continue
        if s.speaker then return Err("one speaker is supported per amplifier")
        for wire in p.wires
            wire.to match
                Port(owner, terminal) -> if owner == amplifier && terminal == "out"
                    if s.speaker then return Err("one speaker is supported per amplifier")
                    s.speaker = true
                    s.gain = f32(real(part_whole(p, "gain", 12)) / 100.0)
                _ -> ()
        if !s.speaker then return Err("speaker input must connect to the I2S amplifier's out terminal")
    Ok(s)

private[virt] boot_digital_audio() = machine.devices.i2s.controller.with(c -> i2s.reset(c))

private[virt] digital_read(cpu: *Cpu, address: u32, offset: u32, width: u32, n: u64) -> u32
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return 0
    machine.devices.i2s.controller.with(c ->
        i2s.advance(c, board_time(cpu, n))
        i2s.read(c, offset)) match
        Some(value) -> value
        None ->
            halt(cpu, Stop.Unmapped, address)
            0

private[virt] digital_write(cpu: *Cpu, address: u32, offset: u32, width: u32, value: u32, n: u64)
    if width != 4 || (offset & 3) != 0
        halt(cpu, Stop.Fault, address)
        return
    machine.devices.i2s.controller.with(c ->
        i2s.advance(c, board_time(cpu, n))
        if !i2s.write(c, offset, value) then halt(cpu, Stop.Unmapped, address))

microphone_available() -> bool = machine.devices.i2s.mic || machine.devices.codec.mic

feed_microphone(samples: []const f32)
    feed_codec_microphone(samples)
    if !machine.devices.i2s.mic then return
    machine.devices.i2s.controller.with(c -> i2s.feed(c, samples))

clear_audio_host()
    clear_codec_input()
    machine.devices.i2s.controller.with(c -> i2s.clear_host(c))

private[virt] take_digital_sound(time: u64) -> Buf[f32]
    val d = &machine.devices.i2s
    val samples = d.controller.with(c ->
        i2s.advance(c, time)
        i2s.take(c))
    if !d.speaker then return buf()
    var out: Buf[f32] = buf()
    for sample in samples do out.push(sample * d.gain)
    out
