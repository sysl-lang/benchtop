module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{Cpu, Model, Stop, MODELS, has_fixed_dsp, model_named, run_match, run_threaded}

val dsp_guest = embed("../../../../examples/virt/dsp.elf")
val dsp_qemu = embed("../../../../examples/virt/dsp.qemu")

// Core 1 says `dsp = false` where the model lets it, and leaves the option out where the model
// always has the extension.
private dsp_board(model: Model, second: bool) -> string
    val other = if has_fixed_dsp(model.kind) then "" else s", dsp = $second"
    s"board { name = dsp, mcu { name = dsp, cores = [{ core = ${model.name}, dsp = true }, { core = ${model.name}$other }], peripherals { ram { peripheral = ram, at = 0, size = 1M }, console { peripheral = debug-console, at = 0x40000000, irq = 0 }, sio { peripheral = virt-sio, at = 0xD0000000, irq = 1 } } } }"

@test("all DSP models match QEMU for 152 instruction variants over integer edges, accumulators, NZCVQ and every GE value")
dsp_differential()
    val owner = machine()
    val m = &*owner
    val cpu = core0(m)
    for model in MODELS
        if !model.dsp then continue
        for exec in [&run_match, &run_threaded]
            on_board(m, "dsp.hocon", dsp_board(model, false).bytes)
            booted_on(m,dsp_guest, "")
            assert(cpu.dsp && core1(m).dsp == has_fixed_dsp(model.kind), "each core's board option applied independently")
            while cpu.stop == Stop.Running && cpu.retired < 200000000
                cpu.limit = cpu.retired + 1000000
                exec(cpu)
            assert(cpu.stop == Stop.Exit && cpu.exit_code == 0, s"${model.name}: ${cpu.stop} at ${cpu.stop_at}")
            val want = lines(dsp_qemu)
            val got = lines(output(m).view())
            assert(want.len() == 152 && got.len() == want.len(), "complete DSP oracle")
            for i in 0..<want.len() do assert(got.at(i) == want.at(i), s"${model.name}: ${got.at(i)}, QEMU: ${want.at(i)}")
    end for
end dsp_differential

@test("DSP settings survive core 1 launch on both schedulers; a plain board gives each model its own default")
dsp_board_lifecycle()
    val owner = machine()
    val m = &*owner
    val cpu = core0(m)
    for parallel in [false, true]
        val both = dsp_board(model_named("cortex-m33").unwrap(), true)
        on_board(m, "dsp.hocon", both.bytes)
        booted_on(m,dual_m33, "")
        if parallel then set_threads(m)
        val stopped = run_board(m)
        assert(stopped.stop == Stop.Exit && cpu.dsp && core1(m).dsp, "launch reapplies each setting")
    end for
    run_on(m,"virt33", crunch_m33, false)
    assert(!cpu.dsp && !core1(m).dsp && cpu.ge == 0 && core1(m).ge == 0, "a plain M33 board leaves the optional DSP off")
    for board in ["virt4", "virt7"]
        run_on(m,board, if board == "virt4" then crunch_m4 else crunch_m7, false)
        assert(cpu.dsp && core1(m).dsp, s"$board: the M4 and M7 always have the DSP extension")
end dsp_board_lifecycle
