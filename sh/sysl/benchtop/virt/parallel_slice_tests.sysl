module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{Stop, clock, store32, SYST_CSR, SYST_RVR}
import sysl.raw.str_cast

// One bounded batch of the CPU workers: `budget` board clocks, answering whether every core runs on.
private batch(budget: u64) -> bool
    submit_workers(budget)
    wait_workers()
    workers_observe().running

@test("CPU worker batches: both cores progress to bounded horizons, records stay paired and reset unpairs them")
bounded_parallel_progress()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    started(m,image([(0x100,SPINNER[..]),(0x200,SPINNER[..])]).view())
    launch(m,0,0x7000,0x201)
    start_workers(m).unwrap()
    defer stop_workers()
    assert(!scheduler.paired)
    for frame in 0..<12
        val before = scheduler.now
        assert(batch(10000))
        assert(clock(cpu,cpu.retired) >= before + 10000)
        assert(clock(core1(m),core1(m).retired) >= before + 10000)
        assert(scheduler.now <= before + 10004)
        assert(scheduler.paired && cpu.peer == core1(m))
    started(m,image([(0x100,SPINNER[..])]).view())
    assert(!scheduler.paired && !scheduler.threaded)
    assert(batch(1) && cpu.retired <= 2)

@test("CPU worker batches: WFI stays resumable across batches and a later SysTick wakes its core")
bounded_parallel_sleep()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    val second = core1(m)
    started(m,image([(0x100,SLEEPER[..]),(0x200,SLEEPER[..])]).view())
    launch(m,0,0x7000,0x201)
    start_workers(m).unwrap()
    defer stop_workers()
    assert(batch(10000))
    assert(cpu.sleeping && second.sleeping)
    assert(cpu.stop == Stop.Running && second.stop == Stop.Running)
    assert(clock(cpu,cpu.retired) == 10000 && clock(second,second.retired) == 10000)
    store32(second,SYST_RVR,49999)
    store32(second,SYST_CSR,7)
    for frame in 0..<4 do assert(batch(10000))
    assert(batch(10000))
    assert(!batch(1))
    assert(second.stop == Stop.Fault && second.stop_at == 0x3C,stop_message(second))
    assert(clock(second,second.retired) == 60000,s"clock ${clock(second,second.retired)}")

@test("CPU worker batches: an awake core continues while its peer sleeps and either core can stop the batch")
bounded_parallel_one_sleeping()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    started(m,image([(0x100,SETS_AND_SLEEPS[..]),(0x200,WAITS_AND_COUNTS[..])]).view())
    launch(m,0,0x7000,0x201)
    start_workers(m).unwrap()
    var running = true
    var batches = 0
    while running && batches < 1000
        running = batch(10000)
        batches += 1
    stop_workers()
    assert(!running && core1(m).stop == Stop.Exit && core1(m).exit_code == 200)
    assert(cpu.sleeping && cpu.stop == Stop.Running)
    assert(!scheduler.threaded)

@test("CPU worker batches: real guest launch, FIFO ordering and shared spinlocks survive repeated batch boundaries")
bounded_parallel_guests()
    val board = machine()
    val m = &*board
    val cpu = core0(m)
    for guest in [count_elf,pingpong_elf,order_elf]
        on_virt(m)
        open_console(m)
        capture(m)
        type_in(m, [])
        boot(m,image_of(m, guest).unwrap().view())
        start_workers(m).unwrap()
        var running = true
        var batches = 0
        while running && batches < 1000
            running = batch(10000)
            batches += 1
        stop_workers()
        assert(!running && cpu.stop == Stop.Exit && cpu.exit_code == 0,stop_message(cpu))
        val text = str_cast(output(m).view())
        assert(text.contains("total 40000") || text.contains("replies 20000, wrong 0, errors 0") || text.starts_with("stale 0 "),text)
