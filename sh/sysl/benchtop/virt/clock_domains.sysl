module sh.sysl.benchtop.virt

import sh.sysl.benchtop.v6m as cpu

// Shared devices and schedulers use MCU ticks. SysTick, exception state and the
// instruction executor keep local core cycles; no conversion in the hot loop.
var core_clock_divisors: [2]u64 = [1,1]

@inline
private[virt] board_time(c: *cpu.Cpu, retired: u64) -> u64 = cpu.clock(c,retired) * core_clock_divisors[c.core]

// Round toward the next core edge. A peripheral deadline between two core
// edges becomes observable on the first edge at or after that deadline.
private[virt] local_time(c: *cpu.Cpu, time: u64) -> u64
    if time == cpu.NEVER then return cpu.NEVER
    val divisor = core_clock_divisors[c.core]
    time / divisor + (if time % divisor != 0 then 1u64 else 0u64)

private[virt] retirement_limit(c: *cpu.Cpu, time: u64) -> u64
    val local = local_time(c,time)
    if local <= c.slept then 0 else local - c.slept

private[virt] board_wake_by(c: *cpu.Cpu, time: u64) -> bool = cpu.wake_by(c,local_time(c,time))

private[virt] board_next_wake(c: *cpu.Cpu) -> u64
    val local = cpu.next_wake(c)
    if local == cpu.NEVER then cpu.NEVER else local * core_clock_divisors[c.core]
