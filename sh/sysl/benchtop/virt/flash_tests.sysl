module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sysl.buf.{Buf, buf}

private val FLASH_GUEST = embed("../../../../examples/matrix/demo.elf")

@test("flash: ELF keeps data in flash and real sysl startup initializes poisoned RAM")
flash_startup()
    assert(board_named("boards/matrix.hocon").is_ok())
    val image = image_of(FLASH_GUEST).unwrap()
    val executable = elf.read(FLASH_GUEST).unwrap()
    val data = u32(executable.symbol_named("matrix_heart").unwrap().unwrap().value)
    val zero = u32(executable.symbol_named("matrix_boot_count").unwrap().unwrap().value)
    assert(data >= 0x20000000 && zero >= 0x20000000)
    boot(core0(), image.view())
    val c = core0()
    assert(c.pc >= 0x10000000 && c.pc < 0x10400000 && c.vtor == 0x10000000)
    assert(c.r[13] == 0x20100000)
    assert(cpu.load32(c, data) == 0, "loader leaves initialized data for startup to copy")
    cpu.store32(c, data, 0xDEADBEEF)
    cpu.store32(c, zero, 0xDEADBEEF)
    pump_board(c, 100000)
    assert(c.stop == cpu.Stop.Budget)
    assert(cpu.load32(c, data) == 10 && cpu.load32(c, data + 16) == 4)
    assert(cpu.load32(c, zero) == 1, "startup cleared bss before incrementing the boot counter")
    boot(c, image.view())
    assert(cpu.load32(c, data) == 0 && cpu.load32(c, zero) == 0)

@test("flash: ordinary stores fault without changing flash, RAM stays writable, erased bytes read ff")
flash_permissions()
    assert(board_named("workbench").is_ok())
    val image = image_of(embed("../../../../examples/visual/demo.elf")).unwrap()
    for width in [1u32, 2u32, 4u32]
        boot(core0(), image.view())
        val c = core0()
        cpu.write(c, 0x20000100, width, 0x12345678, 0)
        assert(cpu.host_read(cpu.page_for(c, 0x20000100, width), 0x20000100, width) == cpu.low_bytes(0x12345678, width))
        assert(cpu.load32(c, 0x103FFFFC) == 0xFFFFFFFF)
        val before = cpu.load32(c, 0x10000000)
        cpu.write(c, 0x10000000, width, 0, 0)
        assert(c.stop == cpu.Stop.Fault && c.stop_at == 0x10000000)
        assert(cpu.load32(c, 0x10000000) == before)
    boot(core0(), image.view())
    cpu.load16(core0(), 0x103FFFFF)
    assert(core0().stop == cpu.Stop.Unmapped, "cross-region reads cannot reach host memory")
    boot(core0(), image.view())
    cpu.load8(core0(), 0x20100000)
    assert(core0().stop == cpu.Stop.Unmapped)

@test("flash: raw binaries load into flash and legacy RAM-only boards still load at zero")
flash_raw()
    assert(board_named("workbench").is_ok())
    val image = image_of([1u8,2,3,4]).unwrap()
    assert(image.len() == 5242880 && image.at(1048576) == 1 && image.at(1048580) == 255)
    assert(board_named("virt").is_ok())
    val legacy = image_of([1u8,2,3,4]).unwrap()
    assert(legacy.len() == 1048576 && legacy.at(0) == 1 && legacy.at(4) == 0)

@test("reset_vector reads the SP and PC boot starts from, in flash and in RAM")
reset_vector_where_boot_reads()
    assert(board_named("boards/matrix.hocon").is_ok())
    val image = image_of(FLASH_GUEST).unwrap()
    assert(image_code_offset() == usize(cpu.RAM_BYTES))
    val (sp, pc) = reset_vector(image.view()).unwrap()
    boot(core0(), image.view())
    assert(sp == core0().r[13], f"0x$sp%08x")
    assert(pc == core0().pc | 1, f"0x$pc%08x")

    assert(board_named("virt").is_ok())
    assert(image_code_offset() == 0)
    val (low_sp, low_pc) = reset_vector(raw_vectors(0x00100000, 0x41).view()).unwrap()
    assert(low_sp == 0x00100000 && low_pc == 0x41)

@test("reset_vector refuses an SP or PC the board could not start from")
reset_vector_refusals()
    assert(board_named("virt").is_ok())
    val refused = "firmware has invalid virtual-board reset vectors"
    // An SP past the RAM, unaligned, or too low to have pushed below the vectors.
    for sp in [0x00100004u32, 0x00010002, 4]
        assert(vector_refusal(sp, 0x41) == refused, f"SP 0x$sp%x")
    // A PC that is not Thumb, that points into the vectors, or that is past the code.
    for pc in [0x40u32, 0x7, 0x00100001]
        assert(vector_refusal(0x00100000, pc) == refused, f"PC 0x$pc%x")
    // The bounds themselves: the lowest SP and PC, and the last halfword of RAM.
    assert(vector_refusal(8, 0x9) == "")
    assert(vector_refusal(0x00100000, 0x000FFFFF) == "")
    reset_vector([0u8; 4]) match
        Ok(_) -> assert(false, "four bytes have no vector table")
        Err(why) -> assert(why == "firmware has no reset vectors", why)

@test("a raw image too big for a small board's RAM is refused with that RAM's size")
raw_image_on_small_ram()
    val small = "board {\n  name = s\n  mcu {\n    name = s, cores = [cortex-m0plus, cortex-m0plus]\n    peripherals {\n      ram { peripheral = ram, at = 0, size = 64K }\n    }\n  }\n}\n"
    assert(board_from("s.hocon", small.bytes).is_ok())
    var file: Buf[u8] = buf()
    for i in 0..<65537 do file.push(0)
    image_of(file.view()) match
        Ok(_) -> assert(false, "loaded")
        Err(why) -> assert(why == "larger than the board's 64 KB of RAM", why)

// The image of a raw file whose vector table is `sp` and `pc`.
private raw_vectors(sp: u32, pc: u32) -> Buf[u8]
    var b: Buf[u8] = buf()
    for w in [sp, pc]
        for k in 0..<4 do b.push(u8((w >> u32(k * 8)) & 0xff))
    image_of(b.view()).unwrap()

// Why reset_vector refuses `sp` and `pc`, or "" where it takes them.
private vector_refusal(sp: u32, pc: u32) -> string = reset_vector(raw_vectors(sp, pc).view()) match
    Ok(_) -> ""
    Err(why) -> why
