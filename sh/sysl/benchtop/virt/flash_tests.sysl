module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf

private val FLASH_GUEST = embed("../../../../examples/matrix/demo.elf")

@test("flash: ELF keeps data in flash and real sysl startup initializes poisoned RAM")
flash_startup()
    assert(board_named("boards/matrix.hocon").is_ok())
    val image = image_of(FLASH_GUEST).unwrap()
    val executable = elf.read(FLASH_GUEST).unwrap()
    val data = u32(executable.symbol_named("matrix_heart").unwrap().unwrap().value)
    val zero = u32(executable.symbol_named("matrix_boot_count").unwrap().unwrap().value)
    assert(data >= 0x20000000 && zero >= 0x20000000)
    boot(core0(), image.view())
    val c = core0()
    assert(c.pc >= 0x10000000 && c.pc < 0x10400000 && c.vtor == 0x10000000)
    assert(c.r[13] == 0x20100000)
    assert(cpu.load32(c, data) == 0, "loader leaves initialized data for startup to copy")
    cpu.store32(c, data, 0xDEADBEEF)
    cpu.store32(c, zero, 0xDEADBEEF)
    pump_board(c, 100000)
    assert(c.stop == cpu.Stop.Running)
    assert(cpu.load32(c, data) == 10 && cpu.load32(c, data + 16) == 4)
    assert(cpu.load32(c, zero) == 1, "startup cleared bss before incrementing the boot counter")
    boot(c, image.view())
    assert(cpu.load32(c, data) == 0 && cpu.load32(c, zero) == 0)

@test("flash: ordinary stores fault without changing flash, RAM stays writable, erased bytes read ff")
flash_permissions()
    assert(board_named("workbench").is_ok())
    val image = image_of(embed("../../../../examples/visual/demo.elf")).unwrap()
    for width in [1u32, 2u32, 4u32]
        boot(core0(), image.view())
        val c = core0()
        cpu.write(c, 0x20000100, width, 0x12345678, 0)
        assert(cpu.host_read(cpu.page_for(c, 0x20000100, width), 0x20000100, width) == cpu.low_bytes(0x12345678, width))
        assert(cpu.load32(c, 0x103FFFFC) == 0xFFFFFFFF)
        val before = cpu.load32(c, 0x10000000)
        cpu.write(c, 0x10000000, width, 0, 0)
        assert(c.stop == cpu.Stop.Fault && c.stop_at == 0x10000000)
        assert(cpu.load32(c, 0x10000000) == before)
    boot(core0(), image.view())
    cpu.load16(core0(), 0x103FFFFF)
    assert(core0().stop == cpu.Stop.Unmapped, "cross-region reads cannot reach host memory")
    boot(core0(), image.view())
    cpu.load8(core0(), 0x20100000)
    assert(core0().stop == cpu.Stop.Unmapped)

@test("flash: raw binaries load into flash and legacy RAM-only boards still load at zero")
flash_raw()
    assert(board_named("workbench").is_ok())
    val image = image_of([1u8,2,3,4]).unwrap()
    assert(image.len() == 5242880 && image.at(1048576) == 1 && image.at(1048580) == 255)
    assert(board_named("virt").is_ok())
    val legacy = image_of([1u8,2,3,4]).unwrap()
    assert(legacy.len() == 1048576 && legacy.at(0) == 1 && legacy.at(4) == 0)
