module sh.sysl.benchtop.virt
@tests
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.fat as fat
import sh.sysl.elf as elf
import sysl.raw.str_cast
import sysl.text.replace_all

private val NATIVE_GUEST = embed("../../../../examples/touch/storage-disco.elf")
private val SPI_GUEST = embed("../../../../examples/touch/storage-spi-disco.elf")
private sdmmc_step(m: *Machine, c: *cpu.Cpu)
    val next = sdmmc_due(&m.devices.sdmmc)
    assert(next != NEVER)
    val now = board_time(c,c.retired)
    val divisor = divisor_of(c)
    if next > now then c.slept += (next - now + divisor - 1) / divisor
    signal_sdmmc(&m.devices,c)
private sreg(m: *Machine, c: *cpu.Cpu, offset: u32, value: u32) = board_write(m,c,0x52007000 + offset,4,value,c.retired)
private sread(m: *Machine, c: *cpu.Cpu, offset: u32) -> u32 = board_read(m,c,0x52007000 + offset,4,c.retired)
// Reads sector 0 into `base` through the IDMA: `c` programs the host, and `runner` is the core whose
// signals bring the transfer in.
private request_block(m: *Machine, c: *cpu.Cpu, base: u32, runner: *cpu.Cpu)
    sreg(m,c,0x38,0x1fe00fff)
    sreg(m,c,0x24,1000000)
    sreg(m,c,0x28,512)
    sreg(m,c,0x2c,0x92)
    sreg(m,c,0x58,base)
    sreg(m,c,0x50,1)
    sreg(m,c,8,0)
    sreg(m,c,12,17 | 64 | 256 | 4096)
    sdmmc_step(m,runner)
    while m.devices.sdmmc.live.with(l -> l.host.data_due) != NEVER do sdmmc_step(m,runner)
// A machine on the SD board that has run the native storage firmware, its card on a four-bit bus.
private sd_machine() -> &Machine
    val description = replace_all(str_cast(embed("../../../../boards/stm32h747-sd.hocon")),"target/disco-sd.img","")
    val board = machine()
    val m = &*board
    board_from(m, "sdmmc-bus.hocon",description.bytes).unwrap()
    boot(m,image_of(m, NATIVE_GUEST).unwrap().view())
    start_workers(m).unwrap()
    submit_workers(m,240000000)
    wait_workers(m)
    pause_workers(m)
    stop_workers(m)
    assert(m.devices.sdmmc.live.with(l -> l.host.wiring.card.is_some() && l.host.wiring.card.unwrap().width == 4))
    board

@test("SDMMC bus: the IDMA moves RAM through the core each signal hands it, not the one that programmed it")
sdmmc_runs_on_the_core_handed()
    val board = sd_machine()
    val m = &*board
    val issuer = core1(m)
    val runner = core0(m)
    for i in 0u32..<128 do cpu.store32(runner,0x24002000 + i * 4,0xdeadbeef)
    request_block(m,issuer,0x24002000,runner)
    assert(issuer.stop == cpu.Stop.Running && runner.stop == cpu.Stop.Running)
    assert(sread(m,issuer,0x34) & 256 != 0, "the transfer the runner brought in ended")
    for i in 0u32..<128 do assert(cpu.load32(runner,0x24002000 + i * 4) != 0xdeadbeef, "every word of the sector reached RAM")

@test("SDMMC bus: real GPIO routes, IDMA RAM boundaries, IRQ49 NVIC delivery and interrupt acknowledgment")
sdmmc_bus()
    val board = sd_machine()
    val m = &*board
    val c = core1(m)
    cpu.set_pending(c,cpu.IRQ0 + 49,false)
    cpu.store32(c,0xe000e104,1 << 17)
    sreg(m,c,0x3c,256)
    request_block(m,c,0x24002000,c)
    assert(c.stop == cpu.Stop.Running && sread(m,c,0x34) & 256 != 0)
    assert(cpu.exception_pending(c,cpu.IRQ0 + 49),"SDMMC1 completion must reach the M4 NVIC")
    sreg(m,c,0x38,256)
    cpu.set_pending(c,cpu.IRQ0 + 49,false)
    signal_sdmmc(&m.devices,c)
    assert(!cpu.exception_pending(c,cpu.IRQ0 + 49))
    // Buffer-complete interrupts share IRQ49 and are observable before DATAEND.
    sreg(m,c,0x38,0x1fe00fff)
    sreg(m,c,0x3c,1 << 28)
    sreg(m,c,0x28,1024)
    sreg(m,c,0x2c,0x92)
    sreg(m,c,0x54,512)
    sreg(m,c,0x58,0x24002000)
    sreg(m,c,0x5c,0x24003000)
    sreg(m,c,0x50,3)
    sreg(m,c,8,0)
    sreg(m,c,12,18 | 64 | 256 | 4096)
    sdmmc_step(m,c)
    while m.devices.sdmmc.live.with(l -> l.host.remaining) > 512 do sdmmc_step(m,c)
    assert(cpu.exception_pending(c,cpu.IRQ0 + 49) && sread(m,c,0x34) & (1 << 28) != 0 && sread(m,c,0x34) & 256 == 0)
    assert(sread(m,c,0x50) & 4 != 0)
    sreg(m,c,0x58,0x24004000) // inactive buffer 0 may be replaced
    sreg(m,c,0x38,1 << 28)
    cpu.set_pending(c,cpu.IRQ0 + 49,false)
    while m.devices.sdmmc.live.with(l -> l.host.data_due) != NEVER do sdmmc_step(m,c)
    assert(cpu.exception_pending(c,cpu.IRQ0 + 49) && sread(m,c,0x34) & 256 != 0)
    sreg(m,c,8,0)
    sreg(m,c,12,12 | 128 | 256 | 4096)
    sdmmc_step(m,c)
    sreg(m,c,0x3c,0)
    cpu.set_pending(c,cpu.IRQ0 + 49,false)
    request_block(m,c,0x40000000,c)
    assert(c.stop == cpu.Stop.Running && sread(m,c,0x34) & (1 << 27) != 0,"IDMA must not enter MMIO or fault the guest CPU")
    sreg(m,c,0x38,0x1fe00fff)
    sreg(m,c,0x3c,4)
    val mode = board_read(m,c,0x58020800,4,c.retired)
    board_write(m,c,0x58020800,4,mode & ~(3u32 << 24),c.retired) // disconnect PC12 CK
    sreg(m,c,8,0x12340000)
    sreg(m,c,12,13 | 256 | 4096)
    sdmmc_step(m,c)
    assert(sread(m,c,0x34) & 4 != 0 && cpu.exception_pending(c,cpu.IRQ0 + 49))

@test("retained SPI storage firmware still initializes, routes GPIO and reads its SD card")
spi_storage_retained()
    val description = replace_all(str_cast(embed("../../../../boards/stm32h747-spi-sd.hocon")),"target/disco-sd.img","")
    val board = machine()
    val m = &*board
    board_from(m, "spi-storage.hocon",description.bytes).unwrap()
    val storage = blank_card()
    var disk = fat.ram_device(storage.view())
    fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
    sd_seed_image(m, disk.image())
    boot(m,image_of(m, SPI_GUEST).unwrap().view())
    start_workers(m).unwrap()
    defer stop_workers(m)
    submit_workers(m,240000000)
    wait_workers(m)
    pause_workers(m)
    assert(workers_observe(m).running,stop_message(core1(m)))
    val status = u32(elf.read(SPI_GUEST).unwrap().symbol_named("storage_status").unwrap().unwrap().value)
    assert(cpu.load32(core0(m),status) == 1,"retained SPI firmware must mount its FAT card")
    assert(!m.devices.storage.is_native && with_sd_card(m, c -> c.stats.reads) > 0,"the retained firmware must read sectors through SPI")
