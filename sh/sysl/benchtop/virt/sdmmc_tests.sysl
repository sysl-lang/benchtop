module sh.sysl.benchtop.virt
@tests
import sh.sysl.benchtop.v6m as cpu
import sh.sysl.fat as fat
import sh.sysl.elf as elf
import sysl.raw.str_cast
import sysl.text.replace_all

private val NATIVE_GUEST = embed("../../../../examples/touch/storage-disco.elf")
private val SPI_GUEST = embed("../../../../examples/touch/storage-spi-disco.elf")
private sdmmc_step(c: *cpu.Cpu)
    val next = sdmmc_due()
    assert(next != cpu.NEVER)
    val now = board_time(c,c.retired)
    val divisor = divisor_of(c)
    if next > now then c.slept += (next - now + divisor - 1) / divisor
    signal_sdmmc(c)
private sreg(c: *cpu.Cpu, offset: u32, value: u32) = board_write(c,0x52007000 + offset,4,value,c.retired)
private sread(c: *cpu.Cpu, offset: u32) -> u32 = board_read(c,0x52007000 + offset,4,c.retired)
private request_block(c: *cpu.Cpu, base: u32)
    sreg(c,0x38,0x1fe00fff)
    sreg(c,0x24,1000000)
    sreg(c,0x28,512)
    sreg(c,0x2c,0x92)
    sreg(c,0x58,base)
    sreg(c,0x50,1)
    sreg(c,8,0)
    sreg(c,12,17 | 64 | 256 | 4096)
    sdmmc_step(c)
    while machine.devices.sdmmc.live.with(l -> l.host.data_due) != cpu.NEVER do sdmmc_step(c)

@test("SDMMC bus: real GPIO routes, IDMA RAM boundaries, IRQ49 NVIC delivery and interrupt acknowledgment")
sdmmc_bus()
    val description = replace_all(str_cast(embed("../../../../boards/stm32h747-sd.hocon")),"target/disco-sd.img","")
    board_from("sdmmc-bus.hocon",description.bytes).unwrap()
    boot(core0(),image_of(NATIVE_GUEST).unwrap().view())
    start_workers(core0()).unwrap()
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    stop_workers()
    assert(machine.devices.sdmmc.live.with(l -> l.card.is_some() && l.card.unwrap().width == 4))
    val c = core1()
    cpu.set_pending(c,cpu.IRQ0 + 49,false)
    cpu.store32(c,0xe000e104,1 << 17)
    sreg(c,0x3c,256)
    request_block(c,0x24002000)
    assert(c.stop == cpu.Stop.Budget && sread(c,0x34) & 256 != 0)
    assert(cpu.exception_pending(c,cpu.IRQ0 + 49),"SDMMC1 completion must reach the M4 NVIC")
    sreg(c,0x38,256)
    cpu.set_pending(c,cpu.IRQ0 + 49,false)
    signal_sdmmc(c)
    assert(!cpu.exception_pending(c,cpu.IRQ0 + 49))
    // Buffer-complete interrupts share IRQ49 and are observable before DATAEND.
    sreg(c,0x38,0x1fe00fff)
    sreg(c,0x3c,1 << 28)
    sreg(c,0x28,1024)
    sreg(c,0x2c,0x92)
    sreg(c,0x54,512)
    sreg(c,0x58,0x24002000)
    sreg(c,0x5c,0x24003000)
    sreg(c,0x50,3)
    sreg(c,8,0)
    sreg(c,12,18 | 64 | 256 | 4096)
    sdmmc_step(c)
    while machine.devices.sdmmc.live.with(l -> l.host.remaining) > 512 do sdmmc_step(c)
    assert(cpu.exception_pending(c,cpu.IRQ0 + 49) && sread(c,0x34) & (1 << 28) != 0 && sread(c,0x34) & 256 == 0)
    assert(sread(c,0x50) & 4 != 0)
    sreg(c,0x58,0x24004000) // inactive buffer 0 may be replaced
    sreg(c,0x38,1 << 28)
    cpu.set_pending(c,cpu.IRQ0 + 49,false)
    while machine.devices.sdmmc.live.with(l -> l.host.data_due) != cpu.NEVER do sdmmc_step(c)
    assert(cpu.exception_pending(c,cpu.IRQ0 + 49) && sread(c,0x34) & 256 != 0)
    sreg(c,8,0)
    sreg(c,12,12 | 128 | 256 | 4096)
    sdmmc_step(c)
    sreg(c,0x3c,0)
    cpu.set_pending(c,cpu.IRQ0 + 49,false)
    request_block(c,0x40000000)
    assert(c.stop == cpu.Stop.Budget && sread(c,0x34) & (1 << 27) != 0,"IDMA must not enter MMIO or fault the guest CPU")
    sreg(c,0x38,0x1fe00fff)
    sreg(c,0x3c,4)
    val mode = board_read(c,0x58020800,4,c.retired)
    board_write(c,0x58020800,4,mode & ~(3u32 << 24),c.retired) // disconnect PC12 CK
    sreg(c,8,0x12340000)
    sreg(c,12,13 | 256 | 4096)
    sdmmc_step(c)
    assert(sread(c,0x34) & 4 != 0 && cpu.exception_pending(c,cpu.IRQ0 + 49))

@test("retained SPI storage firmware still initializes, routes GPIO and reads its SD card")
spi_storage_retained()
    val description = replace_all(str_cast(embed("../../../../boards/stm32h747-spi-sd.hocon")),"target/disco-sd.img","")
    board_from("spi-storage.hocon",description.bytes).unwrap()
    val storage = blank_card()
    var disk = fat.ram_device(storage.view())
    fat.format(&disk,Some(fat.FatType.Fat16)).unwrap()
    sd_seed_image(disk.image())
    boot(core0(),image_of(SPI_GUEST).unwrap().view())
    start_workers(core0()).unwrap()
    defer stop_workers()
    submit_workers(240000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core1()))
    val status = u32(elf.read(SPI_GUEST).unwrap().symbol_named("storage_status").unwrap().unwrap().value)
    assert(cpu.load32(core0(),status) == 1,"retained SPI firmware must mount its FAT card")
    assert(!machine.devices.storage.is_native && with_sd_card(c -> c.reads) > 0,"the retained firmware must read sectors through SPI")
