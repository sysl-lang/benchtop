module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.{load32, store32, store8, Stop}

private val AUDIO_RTC_GUEST = embed("../../../../examples/visual/demo.elf")

private audio_rtc_ready(m: *Machine)
    assert(board_named(m, "workbench").is_ok())
    boot(m, image_of(m, AUDIO_RTC_GUEST).unwrap().view())

@test("RTC MCU bus: ordinary I2C MMIO transactions address real DS3231 registers and preserve them over MCU reset")
rtc_mmio()
    val board = machine()
    val m = &*board
    audio_rtc_ready(m)
    val c = core0(m)
    val base: u32 = 0x50000300
    store32(c,base,0x68)
    store32(c,base + 8,1)
    assert(load32(c,base + 12) == 5)
    store32(c,base + 4,0)
    store32(c,base + 8,4)
    val bytes: [7]u32 = [0x56,0x34,0x12,4,0x29,0x02,0x24]
    for byte in bytes
        store32(c,base + 4,byte)
        store32(c,base + 8,4)
    store32(c,base + 8,1)
    store32(c,base + 4,0)
    store32(c,base + 8,4)
    store32(c,base + 8,3)
    for expected in bytes
        store32(c,base + 8,2)
        assert(load32(c,base + 4) == expected)
    store32(c,base + 8,8)
    assert(load32(c,base + 12) == 1 && c.stop == Stop.Running)
    boot(m,image_of(m, AUDIO_RTC_GUEST).unwrap().view())
    assert(rtc_snapshot(m, "rtc").unwrap()[0] == 0x56)
    store32(c,base,0x69)
    store32(c,base + 8,1)
    assert(load32(c,base + 12) == 2)
    store8(c,base,0)
    assert(c.stop == Stop.Fault)

@test("PWM MCU bus: a routed PWM pad overrides GPIO latch/OE, counter tracks cycles and bad accesses fault")
pwm_mmio()
    val board = machine()
    val m = &*board
    audio_rtc_ready(m)
    val c = core0(m)
    val base: u32 = 0x50000200
    store32(c,base + 4,10)
    store32(c,base + 8,5)
    store32(c,base,1)
    assert((load32(c,0x50000004) & 32) != 0)
    assert(panel_output_latch(m) == 0 && (panel_drive_mask(m) & 32) != 0)
    c.slept = 6
    assert(load32(c,base + 12) == 6 && (load32(c,0x50000004) & 32) == 0)
    store32(c,base,0)
    assert((panel_drive_mask(m) & 32) == 0)
    store8(c,base,0)
    assert(c.stop == Stop.Fault)
