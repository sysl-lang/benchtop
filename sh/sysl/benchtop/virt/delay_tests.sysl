module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sysl.buf.{Buf,buf}
import sysl.math.Float
import sysl.fs.{write_text, make_dir_all}

private val DELAY_GUEST = embed("../../../../examples/touch/delay-disco.elf")

private delay_chunks(count: int)
    val quiet: [240]f32 = [0.0;240]
    for i in 0..<count
        feed_microphone(quiet[..])
        submit_workers(2400000)
        wait_workers()

@test("Discovery stereo delay: actual SRAM, RX DMA, headphone stereo echoes, feedback, touch controls and DSP deadlines")
stereo_delay_firmware()
    board_named("stm32h747-disco") match
        Ok(_) -> ()
        Err(why) -> assert(false,why)
    boot(core0(),image_of(DELAY_GUEST).unwrap().view())
    val executable = elf.read(DELAY_GUEST).unwrap()
    val errors = u32(executable.symbol_named("audio_errors").unwrap().unwrap().value)
    val misses = u32(executable.symbol_named("audio_deadline_misses").unwrap().unwrap().value)
    val peak = u32(executable.symbol_named("audio_dsp_peak_cycles").unwrap().unwrap().value)
    val control = u32(executable.symbol_named("audio_control").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    start_workers(core0()).unwrap()
    defer stop_workers()
    submit_workers(150000000)
    wait_workers()
    pause_workers()
    assert(workers_observe().running,stop_message(core0()))
    assert(codec_headphones && sound_channels() == 2)
    assert(cpu.load32(core0(),errors) == 0)
    val before = cpu.load32(core0(),frames)
    val prefill: [4096]f32 = [0.0;4096]
    feed_microphone(prefill[..])
    delay_chunks(8)
    for value in take_sound(observation_time(),2) do assert(value == 0.0)
    touch_point("touch",400,162,true)
    delay_chunks(8)
    touch_point("touch",400,162,false)
    delay_chunks(40)
    take_sound(observation_time(),2)
    var impulse: [240]f32 = [0.0;240]
    impulse[0] = 0.5
    feed_microphone(impulse[..])
    submit_workers(2400000)
    wait_workers()
    var recording: Buf[f32] = buf()
    for value in take_sound(observation_time(),2) do recording.push(value)
    for chunk in 0..<100
        delay_chunks(1)
        for value in take_sound(observation_time(),2) do recording.push(value)
    pause_workers()
    assert(recording.len() > 40000 && recording.len() % 2 == 0)
    var dry: usize = recording.len()
    for i in 0..<(recording.len() / 2)
        if recording.at(i * 2) > 0.03
            dry = i
            break
    assert(dry + 14400 < recording.len() / 2,"guest must pass the captured impulse into the headphone DMA stream")
    assert((recording.at(dry * 2) - recording.at(dry * 2 + 1)).abs() < 0.00001)
    val left = recording.at((dry + 4800) * 2)
    val right = recording.at((dry + 7200) * 2 + 1)
    assert(left > 0.020 && left < 0.022 && right > 0.020 && right < 0.022,"100/150ms echoes must preserve stereo at 48kHz")
    assert(recording.at((dry + 4800) * 2 + 1).abs() < 0.00001)
    assert(recording.at((dry + 7200) * 2).abs() < 0.00001)
    assert((recording.at((dry + 9600) * 2) - left * 0.35).abs() < 0.00001,"feedback must decay by its guest-controlled gain")
    assert((recording.at((dry + 14400) * 2 + 1) - right * 0.35).abs() < 0.00001)
    assert(cpu.load32(core0(),errors) == 0 && cpu.load32(core0(),misses) == 0)
    val used = cpu.load32(core0(),peak)
    assert(used > 1000 && used < 1280000,"refill work must fit the 128-frame deadline")
    make_dir_all("target").unwrap()
    write_text("target/disco-delay-dsp.txt",s"estimated peak refill cycles=$used deadline=1280000 load-percent=${real(used) / 12800.0}\n").unwrap()
    touch_point("touch",500,208,true)
    delay_chunks(8)
    touch_point("touch",500,208,false)
    delay_chunks(8)
    touch_point("touch",500,252,true)
    delay_chunks(8)
    touch_point("touch",500,252,false)
    delay_chunks(8)
    pause_workers()
    assert(cpu.load32(core0(),control + 16) >= 75 && cpu.load32(core0(),control + 16) <= 85)
    assert(cpu.load32(core0(),control + 20) >= 90 && cpu.load32(core0(),control + 20) <= 100)
    assert(cpu.load32(core0(),frames) > before)
    touch_point("touch",400,162,true)
    delay_chunks(8)
    touch_point("touch",400,162,false)
    delay_chunks(40)
    pause_workers()
    for value in take_sound(observation_time(),2) do assert(value.abs() < 0.00001)
    assert(cpu.load32(core0(),misses) == 0 && workers_observe().running)
