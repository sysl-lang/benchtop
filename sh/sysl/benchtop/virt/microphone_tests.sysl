module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m as cpu
import sh.sysl.elf as elf
import sysl.math.{min,max}
import sysl.math.Float
import sysl.text.replace_all
import sysl.raw.str_cast

private val MIC_GUEST = embed("../../../../examples/touch/mic-disco.elf")
private val MIC_WAVE: [16]f32 = [0.0,0.191341716,0.353553391,0.461939766,0.5,0.461939766,0.353553391,0.191341716,0.0,-0.191341716,-0.353553391,-0.461939766,-0.5,-0.461939766,-0.353553391,-0.191341716]

private microphone_chunks(m: *Machine, n: int)
    var samples: [240]f32
    for i in 0..<240 do samples[i] = MIC_WAVE[i % 16]
    for chunk in 0..<n
        feed_microphone(m, samples[..])
        submit_workers(m,2400000)
        wait_workers(m)

private microphone_energy(m: *Machine) -> real
    val samples = take_codec_sound(&m.devices)
    assert(samples.len() >= 1024)
    var energy: real = 0.0
    var low: f32 = 1.0
    var high: f32 = -1.0
    for i in (samples.len() - 1024)..<samples.len()
        val sample = samples.at(i)
        energy += real(sample) * real(sample)
        low = min(low,sample)
        high = max(high,sample)
    assert(low < -0.005 && high > 0.005,"signed microphone samples must survive RX DMA, M7 DSP and TX DMA")
    energy / 1024.0

@test("Discovery microphone: RX IRQ60 drives M7 effects, M4 meter and touch controls while TX plays processed PCM")
codec_microphone_firmware()
    val board = machine()
    val m = &*board
    assert(ideal_disco(m))
    boot(m,image_of(m,MIC_GUEST).unwrap().view())
    assert(microphone_available(m))
    val executable = elf.read(MIC_GUEST).unwrap()
    val errors = u32(executable.symbol_named("audio_errors").unwrap().unwrap().value)
    val misses = u32(executable.symbol_named("audio_deadline_misses").unwrap().unwrap().value)
    val irqs = u32(executable.symbol_named("audio_capture_irqs").unwrap().unwrap().value)
    val level = u32(executable.symbol_named("audio_input_level").unwrap().unwrap().value)
    val frames = u32(executable.symbol_named("touch_frames").unwrap().unwrap().value)
    start_workers(m).unwrap()
    defer stop_workers(m)
    submit_workers(m,150000000)
    wait_workers(m)
    pause_workers(m)
    assert(workers_observe(m).running,stop_message(core0(m)))
    assert(cpu.load32(core0(m),errors) == 0 && cpu.load32(core0(m),irqs) > 10)
    val before = cpu.load32(core0(m),frames)
    val quiet = tft_frame(m, "screen").unwrap()
    var prefill: [4096]f32
    for i in 0..<4096 do prefill[i] = MIC_WAVE[i % 16]
    feed_microphone(m,prefill[..])
    microphone_chunks(m,8)
    pause_workers(m)
    assert(cpu.load32(core0(m),level) >= 49 && cpu.load32(core0(m),level) <= 51)
    for sample in take_codec_sound(&m.devices) do assert(sample == 0.0,"monitor is off while capture and the meter remain active")
    val meter = tft_frame(m, "screen").unwrap()
    var changed = false
    for y in 328usize..<344
        for x in 292usize..<508
            if quiet.pixels.at(y * 800 + x) != meter.pixels.at(y * 800 + x) then changed = true
    assert(changed,"M4 must draw the input level measured by M7")
    touch_point(m, "touch",400,246,true)
    microphone_chunks(m,8)
    touch_point(m, "touch",400,246,false)
    microphone_chunks(m,40)
    pause_workers(m)
    val dry = microphone_energy(m)
    assert(dry > 0.0016 && dry < 0.0020,"unity guest gain with 0.12 host gain gives the expected dry signal energy")
    touch_point(m, "touch",400,180,true)
    microphone_chunks(m,8)
    touch_point(m, "touch",400,180,false)
    microphone_chunks(m,32)
    pause_workers(m)
    val filtered = microphone_energy(m)
    assert(filtered > dry * 0.05 && filtered < dry * 0.16,"one-pole low-pass must attenuate the 3kHz input")
    touch_point(m, "touch",400,180,true)
    microphone_chunks(m,8)
    touch_point(m, "touch",400,180,false)
    microphone_chunks(m,32)
    pause_workers(m)
    val high_pass = microphone_energy(m)
    assert(high_pass > filtered * 5.0 && high_pass < dry)
    touch_point(m, "touch",400,246,true)
    microphone_chunks(m,8)
    touch_point(m, "touch",400,246,false)
    microphone_chunks(m,40)
    pause_workers(m)
    for sample in take_codec_sound(&m.devices) do assert(sample > -0.00001 && sample < 0.00001)
    assert(cpu.load32(core0(m),level) >= 49 && cpu.load32(core0(m),frames) > before)
    assert(cpu.load32(core0(m),errors) == 0 && cpu.load32(core0(m),misses) == 0,"continuous duplex DSP must meet DMA deadlines")
    assert(workers_observe(m).running)

private capture_register(m: *Machine, reg: u32, value: u32)
    val c = core0(m)
    board_write(m,c,0x58001c00,4,1,0)
    board_write(m,c,0x58001c04,4,(0x1a << 1) | (4 << 16) | (1 << 13) | (1 << 25),0)
    for byte in [reg >> 8,reg & 255,value >> 8,value & 255] do board_write(m,c,0x58001c28,1,byte,0)
    assert(board_read(m,c,0x58001c18,4,0) & 48 == 32,"codec write must finish without NACK")
    board_write(m,c,0x58001c1c,4,32,0)

@test("WM8994 host capture microphone: prebuffer, stereo slots, all widths, saturation, NaN, bounded queue and reset")
codec_host_capture()
    val board = machine()
    val m = &*board
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m,image_of(m,[]).unwrap().view())
    for pair in [(1u16,3u16),(4,0x30c),(0x200,1),(0x208,10),(0x606,2),(0x607,2)] do capture_register(m,u32(pair.0),u32(pair.1))
    var samples: [1024]f32 = [0.5;1024]
    samples[0] = -2.0
    samples[1] = 2.0
    samples[2] = f32.nan()
    for width in 0u32..<4
        clear_audio_host(m)
        capture_register(m,0x300,0x10 | (width << 5))
        val bits = [16u32,20,24,32][usize(width)]
        feed_microphone(m,samples[..<1023])
        assert(codec_input_word(&m.devices.codec,1,0,4,bits).unwrap() == 0,"wait for the capture prebuffer")
        feed_microphone(m,samples[1023..])
        val negative = u32.wrap(-(1i64 << (bits - 1)))
        val positive = u32((1i64 << (bits - 1)) - 1)
        assert(codec_input_word(&m.devices.codec,1,0,4,bits).unwrap() == negative)
        assert(codec_input_word(&m.devices.codec,1,2,4,bits).unwrap() == negative,"both channels use the same frame")
        assert(codec_input_word(&m.devices.codec,1,0,4,bits).unwrap() == positive)
        assert(codec_input_word(&m.devices.codec,1,0,4,bits).unwrap() == 0,"NaN becomes silence")
        assert(codec_input_word(&m.devices.codec,1,1,4,bits).unwrap() == 0 && codec_input_word(&m.devices.codec,0,0,4,bits).is_none())
    clear_audio_host(m)
    capture_register(m,0x300,0x10)
    capture_register(m,0x400,0x1d0)
    capture_register(m,0x401,0x100)
    val loud: [1024]f32 = [0.75;1024]
    feed_microphone(m,loud[..])
    assert(codec_input_word(&m.devices.codec,1,0,4,16).unwrap() == 32767,"positive codec gain saturates")
    assert(codec_input_word(&m.devices.codec,1,2,4,16).unwrap() == 0,"ADC volume zero mutes only its channel")
    clear_audio_host(m)
    val negative_loud: [1024]f32 = [-0.75;1024]
    feed_microphone(m,negative_loud[..])
    assert(codec_input_word(&m.devices.codec,1,0,4,16).unwrap() == 0xffff8000,"negative codec gain saturates")
    capture_register(m,0x300,0x70)
    capture_register(m,0x400,0x1c0)
    capture_register(m,0x401,0x1c0)
    clear_audio_host(m)
    for i in 0..<6 do feed_microphone(m,samples[..])
    assert(codec_input_word(&m.devices.codec,1,0,4,32).unwrap() == 0x80000000)
    for i in 1..<4096 do codec_input_word(&m.devices.codec,1,0,4,32)
    assert(codec_input_word(&m.devices.codec,1,0,4,32).unwrap() == 0,"bounded queue contains only the latest 4096 frames")
    feed_microphone(m,samples[..])
    boot(m,image_of(m,[]).unwrap().view())
    assert(codec_input_word(&m.devices.codec,1,0,4,16).unwrap() == 0,"reset discards host capture and prebuffer state")
    assert(board_named(m, "virt").is_ok() && !microphone_available(m))

@test("WM8994 host capture: microphone connections are validated against the catalog")
codec_microphone_wiring()
    val board = machine()
    val m = &*board
    val original = str_cast(embed("../../../../boards/stm32h747-disco.hocon"))
    assert(board_from(m, "bad-mic.hocon",replace_all(original,"dmic1 = microphone.out","dmic1 = speaker.input").bytes).is_err())
    assert(board_from(m, "unused-mic.hocon",replace_all(original,", dmic1 = microphone.out","").bytes).is_err())
