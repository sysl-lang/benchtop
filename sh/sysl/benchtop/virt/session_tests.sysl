module sh.sysl.benchtop.virt
@tests

import sh.sysl.benchtop.v6m.Stop
import sysl.sync.*

private val WORKBENCH_GUEST = embed("../../../../examples/visual/demo.elf")

// A session over the workbench's parts, its own machine made the workbench board.
private workbench_session(live: bool = true) -> &Session
    val described = machine()
    val b = board_named(&*described, "workbench").unwrap()
    val s = session(b.parts, b.chip.name, live)
    assert(board_named(s.board(), "workbench").is_ok())
    s

@test("session: every run status has its desktop label, and an exit code is part of the status")
ses_labels()
    for (status, label) in [(RunStatus.Preview, "LAYOUT PREVIEW"), (RunStatus.Running, "RUNNING"), (RunStatus.Paused, "PAUSED"),
        (RunStatus.Waiting, "WAITING"), (RunStatus.WaitingForBuild, "WAITING FOR BUILD"), (RunStatus.Breakpoint, "BREAKPOINT"),
        (RunStatus.Exit(3), "EXIT 3"), (RunStatus.ResetRequest, "RESET REQUEST"), (RunStatus.Fault, "GUEST FAULT")]
        assert(status.label() == label, label)
    assert(RunStatus.Exit(3) == RunStatus.Exit(3) && RunStatus.Exit(3) != RunStatus.Exit(4) && RunStatus.Exit(0) != RunStatus.Fault)

@test("session: controls start at rest, positions are held to their travel, and unknown parts are ignored")
ses_inputs()
    val s = workbench_session()
    assert(s.part_input("button1") == PartInput.Pressed(false) && s.position("volume") == 5000)
    assert(s.part_input("heartbeat") == PartInput.Inert && s.part_input("nothing") == PartInput.Inert)
    assert(s.axes("volume") == (POSITION_CENTRE, POSITION_CENTRE) && !s.closed("button1") && !s.pressed("volume"))
    s.set_part_input("volume", PartInput.Position(12000))
    assert(s.position("volume") == POSITION_MAX)
    s.set_part_input("volume", PartInput.Position(-5))
    assert(s.position("volume") == 0)
    s.set_part_input("volume", PartInput.Axes(-1, 20000))
    assert(s.axes("volume") == (0, POSITION_MAX))
    s.set_part_input("nothing", PartInput.Pressed(true))
    assert(s.part_input("nothing") == PartInput.Inert)
    s.set_part_input("button1", PartInput.Pressed(true))
    s.set_part_input("button2", PartInput.Pressed(true))
    s.release_buttons()
    assert(!s.pressed("button1") && !s.pressed("button2"))

@test("session: a button's active level and a knob's voltage reach the board only while live")
ses_apply()
    val s = workbench_session()
    val m = s.board()
    open_console(m)
    capture(m)
    boot(m, image_of(m, WORKBENCH_GUEST).unwrap().view())
    s.apply_inputs()
    assert((panel_levels(m) & (3 << 8)) == (3 << 8) && analog_level(m, 26) == 1650000)
    s.set_part_input("button1", PartInput.Pressed(true))
    s.set_part_input("volume", PartInput.Position(POSITION_MAX))
    s.apply_inputs()
    assert((panel_levels(m) & (3 << 8)) == (2 << 8) && analog_level(m, 26) == 3300000)
    val preview = session(s.parts, s.chip, false)
    assert(board_named(preview.board(), "workbench").is_ok())
    preview.set_part_input("volume", PartInput.Position(0))
    preview.apply_inputs()
    assert(analog_level(preview.board(), 26) == 1650000 && preview.status == RunStatus.Preview)
    assert(analog_level(m, 26) == 3300000, "a preview session drives nothing, and another session's board least of all")

@test("session: a stopped core becomes the session's status and message, and a stopped session stays put")
ses_stops()
    for (stop, code, status) in [(Stop.Exit, 3u32, RunStatus.Exit(3)), (Stop.Breakpoint, 0u32, RunStatus.Breakpoint),
        (Stop.Reset, 0u32, RunStatus.ResetRequest), (Stop.Unmapped, 0u32, RunStatus.Fault), (Stop.Fault, 0u32, RunStatus.Fault)]
        val s = workbench_session()
        val m = s.board()
        s.restart(image_of(m, WORKBENCH_GUEST).unwrap().view())
        assert(s.status == RunStatus.Running && !s.stopped && s.message.is_empty())
        core0(m).stop = stop
        core0(m).exit_code = code
        s.advance(budget = 0)
        assert(s.stopped && s.paused && s.status == status && s.message == stop_message(core0(m)), status.label())
        val retired = core0(m).retired
        s.advance()
        assert(core0(m).retired == retired && s.status == status)
        s.pause()
        assert(s.paused)
    val s = workbench_session()
    s.await_build()
    assert(s.stopped && s.status == RunStatus.WaitingForBuild)

@test("session: pause holds the cores, step runs one instruction, and a preview never runs")
ses_run()
    val s = workbench_session()
    val m = s.board()
    s.restart(image_of(m, WORKBENCH_GUEST).unwrap().view())
    assert(s.advance().is_none() && s.instructions > 0 && s.status != RunStatus.Paused)
    s.pause()
    val retired = core0(m).retired
    s.advance()
    assert(core0(m).retired == retired && s.status == RunStatus.Paused)
    s.advance(true)
    assert(core0(m).retired == retired + 1 && s.paused && s.pc == core0(m).pc)
    s.pause()
    assert(!s.paused)
    val preview = workbench_session(false)
    val before = core0(preview.board()).retired
    preview.pause()
    assert(preview.advance().is_none() && core0(preview.board()).retired == before && !preview.paused)

@test("session: the pacing source follows the board's clock, then its sound, then a touch screen")
ses_pacing()
    val board = machine()
    val m = &*board
    assert(board_named(m, "workbench").is_ok())
    assert(pacing_source(m, false) == PacingSource.SoundClock(12000000) && pacing_source(m, true) == PacingSource.SoundClock(12000000))
    assert(board_named(m, "virt").is_ok())
    assert(pacing_source(m, true) == PacingSource.TouchClock && pacing_source(m, false) == PacingSource.Fixed)
    assert(PacingSource.TouchClock.hz() == TOUCH_HZ && PacingSource.Fixed.hz() == FALLBACK_HZ && PacingSource.BoardClock(7).hz() == 7)
    assert(board_named(m, "stm32h747-disco").is_ok())
    assert(pacing_source(m, false) == PacingSource.BoardClock(clock_hz(m)) && clock_hz(m) != 0)

@test("session: RAM observations read little-endian values inside backing RAM and nothing outside it")
ses_ram_peek()
    val board = machine()
    val m = &*board
    assert(board_named(m, "workbench").is_ok())
    val mem = m.memory
    for (i, b) in [(0usize, 0x78u8), (1, 0x56), (2, 0x34), (3, 0x12)] do atomic_store(&mem.ram[200 + i], b, Relaxed)
    assert(ram_peek(m, 1, 200) == Some(0x78) && ram_peek(m, 2, 200) == Some(0x5678) && ram_peek(m, 4, 200) == Some(0x12345678))
    assert(ram_peek(m, 4, ram_size(m) - 4).is_some() && ram_peek(m, 4, ram_size(m) - 3) == None && ram_peek(m, 1, ram_size(m)) == None)
    assert(ram_peek(m, 5, 0) == None && ram_size(m) == 1048576)

@test("session: the Discovery's user LEDs light while PI12 to PI15 drive low, and only as outputs")
ses_disco_leds()
    val described = machine()
    val b = board_named(&*described, "stm32h747-disco").unwrap()
    val s = session(b.parts, b.chip.name, true)
    val m = s.board()
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m, image_of(m, []).unwrap().view())
    val leds = s.parts.view().filter(p -> p.kind == "led")
    assert(leds.len == 4 && leds[0].name == "led1" && leds[3].name == "led4")
    val lit = () -> [s.lit(leds[0]), s.lit(leds[1]), s.lit(leds[2]), s.lit(leds[3])]
    // Out of reset every pin of GPIOI is analogue, so no LED is driven, whatever the output latch says.
    assert(lit() == [false, false, false, false])
    val gpioi = 0x58022000u32
    board_write(m, core0(m), gpioi, 4, 0x55ffffff, 0)
    assert(lit() == [true, true, true, true], "an output latched low lights its LED")
    board_write(m, core0(m), gpioi + 24, 4, (1u32 << 13) | (1u32 << 15), 0)
    assert(lit() == [true, false, true, false])
    board_write(m, core0(m), gpioi + 24, 4, (1u32 << 29) | (1u32 << 12), 0)
    assert(lit() == [false, true, true, false], "BSRR's reset half clears PI13 and its set half raises PI12")
    board_write(m, core0(m), gpioi + 24, 4, (1u32 << 30) | (1u32 << 14), 0)
    assert(lit() == [false, true, false, false], "a pin both set and reset in one BSRR write is set")
    // PI13 back to an input: still latched low, but nothing drives the LED.
    board_write(m, core0(m), gpioi, 4, 0x51ffffff, 0)
    assert(lit() == [false, false, false, false])
    assert(!session(s.parts, s.chip, false).lit(leds[1]), "a preview lights nothing")

@test("session: the Discovery's wake-up button holds PC13 high while pressed, and leaves other held pins alone")
ses_disco_wakeup()
    val described = machine()
    val b = board_named(&*described, "stm32h747-disco").unwrap()
    val s = session(b.parts, b.chip.name, true)
    val m = s.board()
    assert(board_named(m, "stm32h747-disco").is_ok())
    boot(m, image_of(m, []).unwrap().view())
    val idr = () -> board_read(m, core0(m), 0x58020800 + 16, 4, 0)
    s.apply_inputs()
    assert(idr() & (1u32 << 13) == 0)
    s.set_part_input("wakeup", PartInput.Pressed(true))
    s.apply_inputs()
    assert(idr() & (1u32 << 13) != 0, "pressed onto 3V3")
    // Something else holds PC1 low: the button's release must not let it go.
    assert(stm32_hold(&m.devices.storage, "PC1", Some(false)))
    board_write(m, core0(m), 0x58020800 + 20, 4, 2, 0)
    assert(idr() & 2 == 0)
    s.set_part_input("wakeup", PartInput.Pressed(false))
    s.apply_inputs()
    assert(idr() & ((1u32 << 13) | 2) == 0)
    assert(!stm32_hold(&m.devices.storage, "PZ3", Some(true)) && !stm32_hold(&m.devices.storage, "PC16", None))
    // A reset button is held in reset only while pressed; a preview never is.
    assert(!s.in_reset())
    s.set_part_input("reset", PartInput.Pressed(true))
    assert(s.in_reset())
    s.release_buttons()
    assert(!s.in_reset())
