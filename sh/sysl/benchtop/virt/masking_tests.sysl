module sh.sysl.benchtop.virt
@tests

// The masking report of a virtual board's two cores: each core's intervals are its own, whether the
// cores take turns on one thread or run on a thread each.

import sh.sysl.benchtop.v6m.{Stop, masking_longest, stop_masking}
import sysl.buf.{Buf, buf}

// cpsid i; nop x `k`; cpsie i; then asleep for good (wfi; b wfi).
masker(k: int) -> Buf[u16]
    var b: Buf[u16] = buf()
    b.push(0xB672)
    for i in 0..<k do b.push(0xBF00)
    b.push(0xB662)
    b.push(0xBF30)
    b.push(0xE7FD)
    b

// A board named `which`, core 0 masking for 3 nops at 0x100 and core 1 for 7 at 0x200, both recording,
// run until both sleep, the cores on threads of their own where `threads` says so.
masked_pair(m: *Machine, which: string, threads: bool)
    board_named(m, which) match
        Ok(_) -> ()
        Err(why) -> assert(false, why)
    open_console(m)
    capture(m)
    type_in(m, [])
    boot(m, image([(0x100, masker(3).view()), (0x200, masker(7).view())]).view())
    record_board_masking(m)
    launch(m, 0, 0x7000, 0x201)
    if threads then set_threads(m)

    val stopped = run_board(m)
    assert(stopped.stop == Stop.Asleep, s"${stopped.stop}")

@test("each core of a dual-core board reports its own intervals, taking turns or on threads, M0+ and M33")
masking_per_core()
    for which in ["virt", "virt33"]
        for threads in [false, true]
            val board = machine()
            val m = &*board

            masked_pair(m, which, threads)

            val text = board_masking_text(m)
            val where = s"$which, threads $threads:\n$text"
            assert(text.contains(" intervals=1 masked=4 longest=4 from=0x00000100 to=0x00000108\n"), where)
            assert(text.contains(" intervals=1 masked=8 longest=8 from=0x00000200 to=0x00000210\n"), where)
            assert(text.starts_with("masking core=0 ") && text.contains("\nmasking core=1 "), where)
            assert(masking_longest(core0(m)).unwrap().cycles == 4 && masking_longest(core1(m)).unwrap().cycles == 8, where)
            stop_masking(core0(m))
            stop_masking(core1(m))

@test("a board that records nothing reports nothing, and core 1 is left out until it is launched")
masking_board_off()
    val board = machine()
    val m = &*board

    on_virt(m)
    boot(m, image([(0x100, masker(3).view())]).view())
    assert(board_masking_text(m) == "")

    record_board_masking(m)
    assert(board_masking_text(m).starts_with("masking core=0 ") && !board_masking_text(m).contains("core=1"))
    stop_masking(core0(m))
    stop_masking(core1(m))
