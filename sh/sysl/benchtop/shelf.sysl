module sh.sysl.benchtop

import sh.sysl.parsing.{Diagnostic, Report, Source, Span, error, nearest_name, source_of}
import sysl.buf.{Buf, buf}
import sysl.raw.str_cast
import sysl.fs.read_bytes

// Where a description finds the chips and boards it names.
//
// **A chip or a board is named one of two ways, and the text says which.** A name with a `/` in it, or
// ending in `.hocon`, is a file's path, read relative to the directory of the description that names
// it; any other name is a description built into benchtop (the boards `virt`, `pico`, `pico2w`,
// `pico-breadboard-kit`, the chips `virt`, `rp2040`, `rp2350`, ...). The same rule answers `board =
// pico2w` at the top of a file, a board's `chip = rp2040`, a product's `boards { pico { board = pico }
// }`, and the command line's `--board` and `check`, so `--board virt` is always the built-in board even
// where a file called `virt` sits in the current directory: that one is `./virt`. Chips and boards are
// named apart, so the chip `virt` and the board `virt` are two descriptions.

/** The boards and chips built into benchtop, by name, and how a file is read. */
struct Shelf
    bundled: Buf[(string, string)]
    chips: Buf[(string, string)]
    read: &Fn(string) -> Result[string, string]

private val VIRT_CHIP = embed("../../../chips/virt.hocon")
private val VIRT4_CHIP = embed("../../../chips/virt4.hocon")
private val VIRT7_CHIP = embed("../../../chips/virt7.hocon")
private val VIRT33_CHIP = embed("../../../chips/virt33.hocon")
private val VIRT0_CHIP = embed("../../../chips/virt0.hocon")
private val VIRT1_CHIP = embed("../../../chips/virt1.hocon")
private val VIRT3_CHIP = embed("../../../chips/virt3.hocon")
private val VIRT23_CHIP = embed("../../../chips/virt23.hocon")
private val VIRT35P_CHIP = embed("../../../chips/virt35p.hocon")
private val VIRT52_CHIP = embed("../../../chips/virt52.hocon")
private val VIRT55_CHIP = embed("../../../chips/virt55.hocon")
private val VIRT85_CHIP = embed("../../../chips/virt85.hocon")
private val RP2040_CHIP = embed("../../../chips/rp2040.hocon")
private val RP2350_CHIP = embed("../../../chips/rp2350.hocon")

private val VIRT_FILE = embed("../../../boards/virt.hocon")
private val VIRT4_FILE = embed("../../../boards/virt4.hocon")
private val VIRT7_FILE = embed("../../../boards/virt7.hocon")
private val VIRT33_FILE = embed("../../../boards/virt33.hocon")
private val VIRT0_FILE = embed("../../../boards/virt0.hocon")
private val VIRT1_FILE = embed("../../../boards/virt1.hocon")
private val VIRT3_FILE = embed("../../../boards/virt3.hocon")
private val VIRT23_FILE = embed("../../../boards/virt23.hocon")
private val VIRT35P_FILE = embed("../../../boards/virt35p.hocon")
private val VIRT52_FILE = embed("../../../boards/virt52.hocon")
private val VIRT55_FILE = embed("../../../boards/virt55.hocon")
private val VIRT85_FILE = embed("../../../boards/virt85.hocon")
private val PICO_FILE = embed("../../../boards/pico.hocon")
private val PICO2_FILE = embed("../../../boards/pico2.hocon")
private val PICO2W_FILE = embed("../../../boards/pico2w.hocon")
private val KIT_FILE = embed("../../../boards/pico-breadboard-kit.hocon")

/** The descriptions built into benchtop, and files read from the file system. */
built_in_shelf() -> Shelf = Shelf(bundled_descriptions(), bundled_chips(), read_file)

/** Each chip built into benchtop, as its name and its text. */
bundled_chips() -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    out.push(("virt", str_cast(VIRT_CHIP)))
    out.push(("virt4", str_cast(VIRT4_CHIP)))
    out.push(("virt7", str_cast(VIRT7_CHIP)))
    out.push(("virt33", str_cast(VIRT33_CHIP)))
    out.push(("virt0", str_cast(VIRT0_CHIP)))
    out.push(("virt1", str_cast(VIRT1_CHIP)))
    out.push(("virt3", str_cast(VIRT3_CHIP)))
    out.push(("virt23", str_cast(VIRT23_CHIP)))
    out.push(("virt35p", str_cast(VIRT35P_CHIP)))
    out.push(("virt52", str_cast(VIRT52_CHIP)))
    out.push(("virt55", str_cast(VIRT55_CHIP)))
    out.push(("virt85", str_cast(VIRT85_CHIP)))
    out.push(("rp2040", str_cast(RP2040_CHIP)))
    out.push(("rp2350", str_cast(RP2350_CHIP)))
    out
end bundled_chips

/** Each description built into benchtop, as its name and its text. */
bundled_descriptions() -> Buf[(string, string)]
    var out: Buf[(string, string)] = buf()

    out.push(("virt", str_cast(VIRT_FILE)))
    out.push(("virt4", str_cast(VIRT4_FILE)))
    out.push(("virt7", str_cast(VIRT7_FILE)))
    out.push(("virt33", str_cast(VIRT33_FILE)))
    out.push(("virt0", str_cast(VIRT0_FILE)))
    out.push(("virt1", str_cast(VIRT1_FILE)))
    out.push(("virt3", str_cast(VIRT3_FILE)))
    out.push(("virt23", str_cast(VIRT23_FILE)))
    out.push(("virt35p", str_cast(VIRT35P_FILE)))
    out.push(("virt52", str_cast(VIRT52_FILE)))
    out.push(("virt55", str_cast(VIRT55_FILE)))
    out.push(("virt85", str_cast(VIRT85_FILE)))
    out.push(("pico", str_cast(PICO_FILE)))
    out.push(("pico2", str_cast(PICO2_FILE)))
    out.push(("pico2w", str_cast(PICO2W_FILE)))
    out.push(("pico-breadboard-kit", str_cast(KIT_FILE)))
    out
end bundled_descriptions

private read_file(file: string) -> Result[string, string] = read_bytes(file) match
    Ok(b) -> Ok(str_cast(b))
    Err(e) -> Err(s"$e")

/** Whether a reference to a board names a file rather than a description built into benchtop. */
is_path(which: string) -> bool = which.contains("/") || which.ends_with(".hocon")

/** The description `which` names, as a source named for it; or what is wrong, pointing at `span`. A
 * path is read from the directory of `from`, the description that names it.
 */
open_description(shelf: Shelf, which: string, from: string, span: Span) -> Result[Source, Diagnostic] =
    open_named(shelf, which, from, span, false)

/** `open_description` for a chip: one built into benchtop, or a file's path. */
open_chip(shelf: Shelf, which: string, from: string, span: Span) -> Result[Source, Diagnostic] =
    open_named(shelf, which, from, span, true)

private open_named(shelf: Shelf, which: string, from: string, span: Span, chip: bool) -> Result[Source, Diagnostic]
    if is_path(which) then
        val here = if which.starts_with("./") then which[2..] else which
        val file = if which.starts_with("/") then which else s"${directory_of(from)}$here"

        return (shelf.read)(file) match
            Ok(text) -> Ok(source_of(file, text))
            Err(why) -> Err(error(span, s"cannot read `$file`: $why"))

    val among = if chip then shelf.chips else shelf.bundled

    for (name, text) in among
        if name == which then return Ok(source_of(name, text))

    var names: Buf[string] = buf()

    for (name, _) in among do names.push(name)

    val what = if chip then "chip" else "board"
    var d = error(span, s"unknown $what `$which`")

    nearest_name(which, names) match
        Some(n) -> d = d.with_label(s"did you mean `$n`?")
        None -> ()

    val dir = if chip then "chips" else "boards"
    val kind = if chip then "chips" else "descriptions"

    Err(d.with_note(s"the $kind benchtop has built in are ${listing(names)}; one in a file is named by its path, as `$dir/mine.hocon`"))
end open_named

// `dir/` for `dir/file.hocon`, and nothing for a name with no directory.
private directory_of(file: string) -> string
    var cut: usize = 0

    for i in 0..<file.bytes.len
        if file.bytes[i] == u8('/') then cut = i + 1

    file[0..<cut]
end directory_of

// Chains of boards naming boards are cut off here, which is how a circle is found.
const DEEPEST = 8

/** Find each board a description names, put each product's overrides on its board, and say what is
 * wrong with any of it.
 */
find_boards(d: *Description, src: Source, reg: Registry, shelf: Shelf, depth: int, r: *Report)
    if d.form == ChipForm && !d.named.is_empty() then
        named_chip(shelf, d.named, src, reg, depth, d.named_span, r) match
            Some(c) -> d.chip = c
            None -> ()
    elif d.form == BoardForm && !d.named.is_empty() then
        named_board(shelf, d.named, src, reg, depth, d.named_span, r) match
            Some(b) -> d.board = b
            None -> ()
    elif d.form == BoardForm then
        if !d.board.chip_named.is_empty() then
            named_chip(shelf, d.board.chip_named, src, reg, depth, d.board.chip_span, r) match
                Some(c) ->
                    d.board.chip = c
                    d.board.chip_found = true
                None -> ()
    elif d.form == ProductForm then
        for i in 0..<d.product.boards.len()
            var inst = d.product.boards.at(i)

            if inst.of.is_empty() then continue

            named_board(shelf, inst.of, src, reg, depth, inst.of_span, r) match
                Some(b) ->
                    inst.board = b
                    inst.found = true
                    apply_overrides(&inst, reg, r)
                None -> ()

            d.product.boards.set(i, inst)
        end for
    end if
end find_boards

// The board `which` names, read and checked; or `None`, with what is wrong added to `r`.
private named_board(shelf: Shelf, which: string, src: Source, reg: Registry, depth: int, span: Span, r: *Report) -> Option[Board]
    if depth >= DEEPEST then
        r.add(error(span, s"`$which` is not a board: the boards name each other in a circle"))
        return None

    val found = open_description(shelf, which, src.name, span) match
        Ok(s) -> s
        Err(d) ->
            r.add(d)
            return None

    val got = load_at(found, reg, shelf, depth + 1)

    if got.report.has_errors() then
        r.add(error(span, s"the board `$which` has mistakes").with_note(got.report.render(found)))
        return None

    if got.description.form == ProductForm then
        r.add(error(span, s"`$which` is a product, and only a board is named here")
            .with_note("a product holds boards; it is not one"))
        return None

    if got.description.form == ChipForm then
        r.add(error(span, s"`$which` is a chip, and only a board is named here")
            .with_note("a board is built around a chip; name the chip in a board's `chip`"))
        return None

    Some(got.description.board)
end named_board

// The chip `which` names, read and checked; or `None`, with what is wrong added to `r`.
private named_chip(shelf: Shelf, which: string, src: Source, reg: Registry, depth: int, span: Span, r: *Report) -> Option[Chip]
    if depth >= DEEPEST then
        r.add(error(span, s"`$which` is not a chip: the chips name each other in a circle"))
        return None

    val found = open_chip(shelf, which, src.name, span) match
        Ok(s) -> s
        Err(d) ->
            r.add(d)
            return None

    val got = load_at(found, reg, shelf, depth + 1)

    if got.report.has_errors() then
        r.add(error(span, s"the chip `$which` has mistakes").with_note(got.report.render(found)))
        return None

    if got.description.form != ChipForm then
        r.add(error(span, s"`$which` is ${article_of(form_word(got.description.form))} ${form_word(got.description.form)}, and only a chip is named here"))
        return None

    Some(got.description.chip)
end named_chip

private form_word(f: Form) -> string = f match
    ChipForm -> "chip"
    BoardForm -> "board"
    ProductForm -> "product"
    NoForm -> "description"

// Each of an instance's overrides held to its board's part and that part's parameters, and set.
private apply_overrides(inst: *Instance, reg: Registry, r: *Report)
    for o in inst.overrides
        var index = -1

        for i in 0..<inst.board.parts.len()
            if inst.board.parts.at(i).name == o.part then index = int(i)

        if index < 0 then
            var names: Buf[string] = buf()

            for p in inst.board.parts do names.push(p.name)

            var d = error(o.part_span, s"`${inst.name}` (${inst.of}) has no part `${o.part}`")

            nearest_name(o.part, names) match
                Some(n) -> d = d.with_label(s"did you mean `$n`?")
                None -> ()

            r.add(d.with_note(if names.is_empty() then "it has no parts" else s"its parts are ${listing(names)}"))
            continue
        end if

        var p = inst.board.parts.at(usize(index))

        val spec = reg.part(p.kind) match
            Some(s) -> s
            None -> continue

        val ps = spec.param(o.param.name) match
            Some(x) -> x
            None ->
                r.add(unknown_param(s"${inst.name}.parts.${p.name}", o.param, spec))
                continue

        check_param(s"`${inst.name}.parts.${p.name}.${o.param.name}`", o.param, ps, r)

        var set = false

        for i in 0..<p.params.len()
            if p.params.at(i).name == o.param.name then
                p.params.set(i, o.param)
                set = true

        if !set then p.params.push(o.param)

        inst.board.parts.set(usize(index), p)
    end for
end apply_overrides
