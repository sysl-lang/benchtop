module sh.sysl.benchtop
@tests

// The Pico boards' printed circuit drawings (`pcb_art`): each board's size at 5 px/mm, its 40 header
// pads and 3 debug pads where the mechanical drawing puts them and named as Raspberry Pi's pinout
// names them, the names readable beside them, and the bundled boards' views sized to the drawing with
// the LED part on the LED's footprint.

import sh.sysl.parsing.{Span, source_of}
import sysl.buf.{Buf, buf}
import sysl.text.str_builder

// The drawing `name` names, which must exist.
private art(name: string) -> PcbArt = pcb_art(name).unwrap()

// The header pads by pin number, `number name` from pin 1 to pin 40.
private header_names(a: PcbArt) -> string
    var out = str_builder()

    for n in 1..40
        var found = 0

        for p in a.pins
            if p.number == n
                if found == 0 then out.push(s"${if n > 1 then " " else ""}$n ${p.name}")
                found += 1

        assert(found == 1, s"${a.name}: pin $n is drawn $found times")
    end for

    out.finish()

// The debug pads' names, left to right.
private debug_names(a: PcbArt) -> string
    var out = ""

    for p in a.pins do if p.number == 0 then out += if out.is_empty() then p.name else s" ${p.name}"
    out

// The pin `number` (0 for the `i`th debug pad), as its centre.
private pin_at(a: PcbArt, number: int, i: int = 0) -> (int, int)
    var seen = 0

    for p in a.pins
        if p.number == number
            if seen == i then return (p.x, p.y)
            seen += 1

    assert(false, s"${a.name} has no pin $number")
    (0, 0)

// The pinout of every Pico, read off Raspberry Pi's pinout figure (Figure 2 of each datasheet).
private val PINOUT = "1 GP0 2 GP1 3 GND 4 GP2 5 GP3 6 GP4 7 GP5 8 GND 9 GP6 10 GP7 11 GP8 12 GP9 13 GND 14 GP10 15 GP11 16 GP12 17 GP13 18 GND 19 GP14 20 GP15 21 GP16 22 GP17 23 GND 24 GP18 25 GP19 26 GP20 27 GP21 28 GND 29 GP22 30 RUN 31 GP26 32 GP27 33 AGND 34 GP28 35 ADC_VREF 36 3V3 37 3V3_EN 38 GND 39 VSYS 40 VBUS"

@test("pcb: every Pico is its 21 x 51 mm board at 5 px/mm, with the pads' gutters either side and the USB connector's overhang above")
pcb_board_size()
    for (name, below) in [("pico", 22), ("pico2", 22), ("pico2w", 0)]
        val a = art(name)

        assert(a.name == name && a.board_w == 105 && a.board_h == 255, s"$name: ${a.board_w} x ${a.board_h}")
        assert(a.board_x == PCB_GUTTER && a.board_y == PCB_OVERHANG && PCB_OVERHANG == 7)
        assert(a.width == 40 + 105 + 40 && a.height == 7 + 255 + below, s"$name: ${a.width} x ${a.height}")

        // The board is the first thing drawn, and nothing is drawn outside the view: the USB
        // connector's 1.3 mm overhang reaches up into the 7 px above the board, and no further.
        assert(a.items[0].shape == SolderMask && a.items[0].x == 40 && a.items[0].y == 7 && a.items[0].w == 105 && a.items[0].h == 255)

        var top = a.height

        for item in a.items
            assert(item.x >= 0 && item.y >= 0 && item.x + item.w <= a.width && item.y + item.h <= a.height, s"$name: an item at ${item.x}, ${item.y}")
            if item.y < top then top = item.y

        assert(top == 7 - 6, s"$name: the overhang reaches $top")

    assert(pcb_art("pico3").is_none() && pcb_art("").is_none())
    assert(pcb_names() == "pico, pico2, pico2w")

@test("pcb: 40 castellated header pads and 3 debug pads on every Pico, numbered and named as the pinout figure names them")
pcb_pads()
    for name in ["pico", "pico2", "pico2w"]
        val a = art(name)

        assert(a.pins.len() == 43, s"$name: ${a.pins.len()} pads")
        assert(header_names(a) == PINOUT, s"$name: ${header_names(a)}")
        assert(debug_names(a) == "SWCLK GND SWDIO", s"$name: ${debug_names(a)}")

        // The header's corners: holes 1.61 mm in from the long edges, 2.54 mm apart, the first 1.37 mm
        // from the USB end, so 17.78 mm across and 48.26 mm down.
        assert(pin_at(a, 1) == (40 + 8, 7 + 7) && pin_at(a, 40) == (40 + 97, 7 + 7), s"$name: ${pin_at(a, 1)} ${pin_at(a, 40)}")
        assert(pin_at(a, 20) == (40 + 8, 7 + 248) && pin_at(a, 21) == (40 + 97, 7 + 248), s"$name: ${pin_at(a, 20)} ${pin_at(a, 21)}")
        assert(pin_at(a, 2).1 - pin_at(a, 1).1 == 13 && pin_at(a, 3).1 - pin_at(a, 2).1 == 12)

    // The Pico's and the Pico 2's debug pads are on the bottom edge, 1.6 mm up; the Pico 2 W's in
    // the middle of the board, between the chip and the radio's can.
    for name in ["pico", "pico2"]
        val a = art(name)

        assert(pin_at(a, 0, 0) == (80, 254) && pin_at(a, 0, 1) == (93, 254) && pin_at(a, 0, 2) == (105, 254), s"$name: ${pin_at(a, 0, 0)}")

    val w = art("pico2w")

    assert(pin_at(w, 0, 0) == (96, 163) && pin_at(w, 0, 1) == (108, 163) && pin_at(w, 0, 2) == (121, 163), s"${pin_at(w, 0, 0)}")

@test("pcb: each pad's name is printed once, beside the board in the gutter of its own edge, and no two names overlap")
pcb_labels()
    for name in ["pico", "pico2", "pico2w"]
        val a = art(name)
        val debug_labels = name != "pico2w"

        assert(a.labels.len() == (if debug_labels then 43 else 40), s"$name: ${a.labels.len()} names")

        for i in 0..<a.labels.len()
            val l = a.labels[i]
            val p = a.pins[i]

            assert(l.text == p.name, s"$name: label ${l.text} for ${p.name}")
            assert(l.x >= 0 && l.y >= 0 && l.x + l.w <= a.width && l.y + l.h <= a.height, s"$name: ${l.text} lies outside the view")
            // A header pad's name is in the gutter of its own edge, level with the pad.
            if p.number > 0
                val left = p.number <= 20

                assert(if left then l.x + l.w < a.board_x && l.align == AlignEnd else l.x > a.board_x + a.board_w && l.align == AlignStart, s"$name: ${l.text}")
                assert(l.y + l.h / 2 == p.y, s"$name: ${l.text} at ${l.y}, its pad at ${p.y}")
            else
                assert(l.y >= a.board_y + a.board_h, s"$name: ${l.text} is under the board")

            for j in i + 1..<a.labels.len()
                val m = a.labels[j]
                assert(!(l.x < m.x + m.w && m.x < l.x + l.w && l.y < m.y + m.h && m.y < l.y + l.h), s"$name: ${l.text} and ${m.text} overlap")
        end for
    end for

    // The Pico 2 W's debug pads have no room for their names; its silkscreen says DEBUG over them.
    var debug = 0

    for item in art("pico2w").items do if item.shape == SilkText && item.text == "DEBUG" then debug += 1
    assert(debug == 1)

@test("pcb: the packages each Pico carries — the RP2040 or RP2350 with its marking, flash, crystal, BOOTSEL — and the Pico 2 W's can and antenna")
pcb_packages()
    for (name, chip, can) in [("pico", "RP2040", 0), ("pico2", "RP2350", 0), ("pico2w", "RP2350", 1)]
        val a = art(name)
        var marked = 0
        var cans = 0
        var keepouts = 0
        var caps = 0
        var crystals = 0
        var drills = 0

        for item in a.items
            item.shape match
                IcPackage -> if !item.text.is_empty()
                    assert(item.text == chip && item.w == 35 && item.h == 35, s"$name: ${item.text} ${item.w} x ${item.h}")
                    marked += 1
                ShieldCan -> cans += 1
                AntennaKeepout ->
                    keepouts += 1
                    // The keep-out runs to the far edge, away from the USB connector.
                    assert(item.y + item.h == a.board_y + a.board_h)
                ButtonCap -> caps += 1
                CrystalBase -> crystals += 1
                DrillHole -> drills += 1
                _ -> ()
        end for

        assert(marked == 1 && cans == can && keepouts == can && caps == 1 && crystals == 1, s"$name: $marked $cans $keepouts $caps $crystals")
        // A hole in each of the 43 pads, and the four mounting holes.
        assert(drills == 43 + 4, s"$name: $drills holes")
    end for

// The bundled board `name`'s view, which must check clean.
private bundled_view(name: string) -> View
    for (n, text) in bundled_descriptions()
        if n == name
            val got = load(source_of(s"$name.hocon", text), library())

            assert(!got.report.has_errors(), got.report.render(source_of(s"$name.hocon", text)))
            return got.description.board.view

    assert(false, s"no bundled `$name`")
    View(0, 0, "", buf(), Span(0, 0), "")

@test("pcb: each bundled Pico's view is its drawing's size, and its LED part sits on the LED's footprint left of the USB connector")
pcb_bundled_views()
    for (name, pcb) in [("pico", "pico"), ("pico2", "pico2"), ("pico2-riscv", "pico2"), ("pico2w", "pico2w")]
        val v = bundled_view(name)
        val a = art(pcb)

        assert(v.pcb == pcb && v.width == a.width && v.height == a.height, s"$name: ${v.pcb} ${v.width} x ${v.height}")

        var leds = 0

        for e in v.elements
            if e.name == "led"
                assert(e.x + e.w / 2 == a.led_x && e.y + e.h / 2 == a.led_y, s"$name: the LED's middle at ${e.x + e.w / 2}, ${e.y + e.h / 2}, its footprint at ${a.led_x}, ${a.led_y}")
                leds += 1

        assert(leds == 1)
        // The footprint: 4.75 mm in from the left edge and 4.7 or 4.8 mm down, by the drawing.
        assert(a.led_x == 40 + 24 && a.led_y == 7 + 24)
    end for

// The diagnostics a board whose view is `view` reads to, one per line.
private view_diags(view: string) -> string
    val text = s"board {\n  name = t, mcu = rp2040\n  view {\n$view  }\n}\n"
    val src = source_of("t.hocon", text)
    val got = load(src, library())
    var out = str_builder()

    for i in 0..<got.report.len() do out.push(s"${got.report.at(i).message}\n")
    out.finish()

@test("pcb: a view names a drawing there is, and is exactly its size; either refusal says what would do")
pcb_view_refusals()
    assert(view_diags("    size = [185, 284]\n    pcb = pico\n") == "")
    assert(view_diags("    pcb = pico2w\n    size = [185, 262]\n") == "")
    assert(view_diags("    size = [185, 284]\n    pcb = pico3\n") == "there is no printed circuit drawing named `pico3`\n")
    assert(view_diags("    size = [168, 408]\n    pcb = pico2\n") == "the drawing `pico2` is 185 × 284, so the view is too, not 168 × 408\n")

    val src = source_of("t.hocon", "board {\n  name = t, mcu = rp2040\n  view {\n    size = [10, 10]\n    pcb = nope\n  }\n}\n")
    val shown = load(src, library()).report.render(src)

    assert(shown.contains("pico, pico2, pico2w"), shown)
