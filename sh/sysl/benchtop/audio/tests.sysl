module sh.sysl.benchtop.audio
@tests

import sysl.math.Float

@test("audio PCM: exact PWM integration preserves frequency and is invariant to UI chunk sizes")
frequency_and_chunks()
    val a = synth(12000000, 48000, 0.12)
    val b = synth(12000000, 48000, 0.12)
    val wave = Wave(true, 12000, 6000, 0, false)
    for t in 1u64..100 do advance(a, t * 12000, wave)
    for t in 1u64..1000 do advance(b, t * 1200, wave)
    val one = take(a)
    val two = take(b)
    assert(one.len() == 4096 && two.len() == one.len())
    for i in 0..<one.len() do assert(one.at(i) == two.at(i))
    var crossings = 0
    for i in 1..<one.len() do if one.at(i - 1) <= 0 && one.at(i) > 0 then crossings += 1
    assert(crossings >= 84 && crossings <= 86, s"$crossings cycles in 4096 samples at 48kHz")

@test("audio PCM: sub-sample changes integrate both halves, DC decays and a disabled source is silent")
segments_and_dc()
    val s = synth(48000, 48000, 0.1)
    advance(s, 1, silence())
    assert(take(s).at(0) == 0.0)
    val t = synth(96000, 48000, 1.0)
    advance(t, 1, Wave(true,0,0,0,true))
    advance(t, 2, Wave(true,0,0,0,false))
    assert(take(t).at(0) == 0.0)
    for i in 1u64..10 do advance(s, i * 480, Wave(true,0,0,0,true))
    val dc = take(s)
    assert(dc.at(dc.len() - 1).abs() < 0.0001)
    clear(s)
    advance(s, 480, silence())
    for value in take(s) do assert(value == 0.0)

@test("audio PCM: noninteger clock ratios are drift-free, long stalls are bounded and rewind clears stale samples")
bounds_and_clock()
    val s = synth(1000003,48000)
    for t in 1u64..100 do advance(s, t * 10000, silence())
    assert(s.index == 47999)
    assert(s.samples.len() == 4096 && s.dropped > 0)
    advance(s, 100000300, Wave(true,1000,500,0,false))
    assert(s.samples.len() <= 4096 && s.time == 100000300)
    advance(s, 0, silence())
    assert(s.samples.len() == 0 && s.time == 0)
