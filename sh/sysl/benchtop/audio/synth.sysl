module sh.sysl.benchtop.audio

import sysl.buf.{Buf, buf}
import sysl.math.{min, max}

/** Signal segment, not a pitch command: PWM phase and duty determine the waveform. */
struct Wave
    enabled: bool
    period: u64 // Zero means a constant GPIO level.
    high: u64
    origin: u64
    level: bool

silence() -> Wave = Wave(false, 0, 0, 0, false)

private high_before(w: Wave, time: u64) -> u64
    if time <= w.origin then return 0
    val span = time - w.origin
    (span / w.period) * w.high + min(span % w.period, w.high)

integral(w: Wave, start: u64, end: u64) -> real
    if !w.enabled then return 0.0
    val span = real(end - start)
    if w.period == 0 then return if w.level then span else -span
    2.0 * real(high_before(w, end) - high_before(w, start)) - span

/** Rational cycle-to-sample integration, DC rejection and a bounded chronological sample ring. */
struct Synth
    hz: u64
    rate: u64
    gain: real
    time: u64
    index: u64
    area: real
    previous: real
    filtered: real
    samples: Buf[f32]
    oldest: usize
    dropped: u64

synth(hz: u64 = 12000000, rate: u64 = 48000, gain: real = 0.12) -> &Synth
    require hz >= rate && rate > 0 && gain >= 0.0 && gain <= 1.0, "valid audio clock, sample rate and gain"
    Synth(hz, rate, gain, 0, 0, 0.0, 0.0, 0.0, buf(), 0, 0)

clear(s: &Synth, time: u64 = 0)
    s.time = time
    s.index = time * s.rate / s.hz
    s.area = 0.0
    s.previous = 0.0
    s.filtered = 0.0
    s.samples = buf()
    s.oldest = 0

advance(s: &Synth, time: u64, wave: Wave)
    if time < s.time then clear(s, time)
    if time - s.time > s.hz / 10
        val from = time - s.hz / 10
        s.dropped += (from - s.time) * s.rate / s.hz
        clear(s, from)
    while s.time < time
        val boundary = (s.index + 1) * s.hz / s.rate
        val end = min(boundary, time)
        s.area += integral(wave, s.time, end)
        s.time = end
        if end == boundary
            val start = s.index * s.hz / s.rate
            val input = s.area / real(boundary - start)
            s.filtered = input - s.previous + 0.995 * s.filtered
            s.previous = input
            append(s, f32(max(-1.0, min(1.0, s.filtered * s.gain))))
            s.area = 0.0
            s.index += 1

private append(s: &Synth, value: f32)
    if s.samples.len() < 4096 then s.samples.push(value)
    else
        s.samples.set(s.oldest, value)
        s.oldest = (s.oldest + 1) % 4096
        s.dropped += 1

take(s: &Synth) -> Buf[f32]
    var out: Buf[f32] = buf()
    for i in 0..<s.samples.len() do out.push(s.samples.at((s.oldest + i) % s.samples.len()))
    s.samples = buf()
    s.oldest = 0
    out
