module sh.sysl.benchtop.realtime

// `benchtop realtime`: run a firmware on the board's CPU workers exactly as the desktop runs it --
// each core on its own host thread, paced against the host's clock, DSI packets applied by the DSI
// worker -- with no window, while this thread plays the desktop's part: it takes the board's audio
// as a sound card would, feeds the microphone a tone, drags a finger across the touch panel, and
// copies the display out as often as the window would paint it. Inputs follow the guest's clock, not
// the host's, so a paced run and an unpaced one give the firmware the same inputs.
//
// It answers, per core, how much guest time passed against how much host time (1.0 is real time),
// and how much of that host time each core's worker spent waiting for the host's clock: the headroom
// a paced core had left.

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m.Stop
import sysl.math.{min,max,tau,Float}
import sysl.time.{monotonic,sleep,millis}
import sysl.posix.time.cpu_time

/** How to run: the measured guest seconds after `warmup` guest seconds of boot, paced against the
 * host's clock as the desktop runs (or as fast as the host can), and the parts the desktop drives.
 */
struct Options
    seconds: u64
    warmup: u64
    paced: bool
    display: string
    touch: string

options() -> Options = Options(10, 1, true, "screen", "touch")

/** One core over the measured window: guest time (in board ticks), instructions, the host time its
 * worker waited for the host's clock, and how far it trailed real time when the window closed.
 */
struct CoreRun
    ticks: u64
    retired: u64
    waited_us: u64
    late_us: u64

/** What a run measured over its window. `hz` is the board's clock, which `ticks` count. */
struct Run
    hz: u64
    divisors: [2]u64
    launched: bool
    paced: bool
    wall_us: u64
    cores: [2]CoreRun
    dsi_packets: u64
    dsi_busy_us: u64
    sound_frames: u64
    channels: u64
    mic_frames: u64
    display_reads: u64
    display_read_us: u64
    process_cpu_us: u64

    /** Guest seconds core `k` ran per host second: 1.0 is real time. */
    speed(self, k: int) -> real = real(self.cores[k].ticks) / real(self.hz) / (real(self.wall_us) / 1000000.0)

    /** The share of the window core `k`'s worker spent running rather than waiting for the clock. */
    busy(self, k: int) -> real = 1.0 - real(min(self.cores[k].waited_us, self.wall_us)) / real(self.wall_us)

// Where the window starts or ends: the workers' published state and the host's counters.
private struct Mark
    wall_us: long
    time: [2]u64
    late_us: [2]u64
    retired: [2]u64
    waited_us: [2]u64
    dsi: virt.DsiWorkerStatus
    sound_frames: u64
    mic_frames: u64
    display_reads: u64
    display_read_us: u64
    cpu_us: long

// What this thread has done for the desktop so far.
private struct Host
    sound_frames: u64
    mic_frames: u64
    display_reads: u64
    display_read_us: u64
    next_paint_us: long

private const MIC_HZ: u64 = 48000
private const PAINT_US: long = 16667

/** Boot `file` (an ELF or raw image) on the board `which` names and run it as `o` says. */
run(which: string, file: []const u8, o: Options) -> Result[Run,string]
    if o.seconds == 0 then return Err("--seconds must be at least 1")
    virt.board_named(which)?
    val image = virt.image_of(file)?
    val hz = virt.clock_hz()
    if hz == 0 then return Err(s"$which has no mcu.clock-hz to pace against")
    val cpu = virt.core0()
    virt.open_console()
    virt.capture_bounded(8192)
    virt.boot(cpu, image.view())
    virt.start_workers(cpu, true, if o.paced then hz else 0)?
    val start = o.warmup * hz
    val end = (o.warmup + o.seconds) * hz
    if o.paced then virt.resume_workers() else virt.submit_workers(end)
    var host = Host(0, 0, 0, 0, 0)
    var first: Option[Mark] = None
    var failed = ""
    loop
        serve(&host, o)
        val snapshot = virt.workers_observe()
        if !snapshot.running
            failed = virt.stop_message(if snapshot.cores[0].stop != Stop.Budget then cpu else virt.core1())
            break
        val now = max(snapshot.cores[0].time, snapshot.cores[1].time)
        if first.is_none() && now >= start then first = Some(mark(snapshot, host))
        if now >= end then break
        sleep(millis(2))
    val last = mark(virt.workers_observe(), host)
    val launched = virt.workers_observe().launched
    virt.stop_workers()
    if !failed.is_empty() then return Err(s"the guest stopped: $failed")
    val from = first.unwrap()
    Ok(Run(hz, virt.core_clock_divisors, launched, o.paced, u64(last.wall_us - from.wall_us),
        [core_run(from, last, 0), core_run(from, last, 1)],
        last.dsi.completed - from.dsi.completed, last.dsi.busy_us - from.dsi.busy_us,
        last.sound_frames - from.sound_frames, u64(virt.sound_channels()), last.mic_frames - from.mic_frames,
        last.display_reads - from.display_reads, last.display_read_us - from.display_read_us,
        u64(last.cpu_us - from.cpu_us)))

private core_run(from: Mark, to: Mark, k: int) -> CoreRun =
    CoreRun(to.time[k] - from.time[k], to.retired[k] - from.retired[k], to.waited_us[k] - from.waited_us[k], to.late_us[k])

private mark(snapshot: virt.WorkerObservation, host: Host) -> Mark =
    Mark(monotonic().us, [snapshot.cores[0].time, snapshot.cores[1].time], [snapshot.cores[0].late_us, snapshot.cores[1].late_us],
        [snapshot.cores[0].retired, snapshot.cores[1].retired], virt.workers_waited_us(), virt.dsi_worker_status(),
        host.sound_frames, host.mic_frames, host.display_reads, host.display_read_us, cpu_time().us)

// The desktop's share of a frame: take the sound played so far, give the microphone the tone owed up
// to the guest's clock, move the finger, and copy the display out where a window would paint it.
private serve(host: *Host, o: Options)
    val time = virt.observation_time()
    val channels = u64(virt.sound_channels())
    host.sound_frames += u64(virt.take_sound(time, u32(channels)).len()) / channels
    val seconds = real(time) / real(virt.clock_hz())
    if virt.microphone_available()
        val owed = u64(seconds * real(MIC_HZ))
        if owed > host.mic_frames
            var tone: [4800]f32 = [0.0; 4800]
            val count = min(owed - host.mic_frames, 4800)
            for i in 0..<count
                val t = real(host.mic_frames + i) / real(MIC_HZ)
                // A 440 Hz tone whose loudness swells and fades once a second, so the meter moves.
                val level = 0.5 + 0.4 * (tau * t).sin()
                tone[i] = f32(level * (tau * 440.0 * t).sin())
            virt.feed_microphone(tone[..<count])
            host.mic_frames += count
    if virt.touch_dimensions(o.touch).is_some()
        // Drag along the slider's row and back once every two guest seconds, lifting at each end.
        val phase = seconds.fmod(2.0)
        val x = 300 + int(200.0 * (if phase < 1.0 then phase else 2.0 - phase))
        virt.touch_point(o.touch, x, 302, phase > 0.05 && phase < 0.95 || phase > 1.05 && phase < 1.95)
    val now = monotonic().us
    if now >= host.next_paint_us
        host.next_paint_us = now + PAINT_US
        if virt.tft_frame(o.display).is_some()
            host.display_reads += 1
            host.display_read_us += u64(monotonic().us - now)
