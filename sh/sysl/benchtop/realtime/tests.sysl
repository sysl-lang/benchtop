module sh.sysl.benchtop.realtime
@tests

import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.v6m as v6m
import sh.sysl.elf as elf
import sysl.time.{sleep,millis}

private val MIC_GUEST = embed("../../../../examples/touch/mic-disco.elf")

private unpaced(seconds: u64, warmup: u64) -> Options
    var o = options()
    o.seconds = seconds
    o.warmup = warmup
    o.paced = false
    o

@test("realtime: an unpaced DISCO run measures both cores, the DSI worker, the audio both ways and the display")
unpaced_disco()
    val board = virt.machine()
    val r = run(&*board, "stm32h747-disco", MIC_GUEST, unpaced(1, 0)).unwrap()
    assert(r.launched && !r.paced && r.hz == 480000000 && r.divisors[0] == 1 && r.divisors[1] == 2)
    for k in 0..<2
        assert(r.cores[k].ticks >= r.hz * 9 / 10 && r.cores[k].ticks <= r.hz * 11 / 10, s"core $k ran about one guest second")
        assert(r.cores[k].retired > 0 && r.cores[k].waited_us == 0, s"core $k ran and, unpaced, never waited for the clock")
        assert(r.busy(k) == 1.0 && r.speed(k) > 0.0)
    assert(r.cores[1].retired > r.cores[0].retired, "the M4 draws while the M7 sleeps between audio interrupts")
    assert(r.dsi_packets > 0 && r.display_reads > 0, "the M4's drawing crossed the DSI and was copied out")
    assert(r.channels == 2 && r.sound_frames >= 40000 && r.sound_frames <= 56000, s"one guest second of 48 kHz audio out, not ${r.sound_frames}")
    assert(r.mic_frames >= 43000 && r.mic_frames <= 53000, s"one guest second of 48 kHz tone in, not ${r.mic_frames}")
    assert(r.wall_us > 0 && r.process_cpu_us > 0)

private val BUSY_GUEST = embed("../../../../examples/touch/busy-disco.elf")

// A word of the busy guest's memory on `m`, read at its symbol once a run has stopped.
private guest_word(m: *virt.Machine, name: string, offset: u32 = 0) -> u32 =
    v6m.load32(virt.core0(m), u32(elf.read(BUSY_GUEST).unwrap().symbol_named(name).unwrap().unwrap().value) + offset)

@test("realtime: the busy firmware keeps the M7 running every kernel between its audio interrupts, which meet their deadlines")
busy_disco()
    val board = virt.machine()
    val m = &*board
    val r = run(m, "stm32h747-disco", BUSY_GUEST, unpaced(1, 0)).unwrap()
    assert(r.launched && r.cores[0].ticks >= r.hz * 9 / 10)
    assert(r.cores[0].retired > r.cores[1].retired, "the M7 never sleeps, so it retires more than the M4 that draws")
    assert(r.dsi_packets > 0 && r.sound_frames >= 40000 && r.mic_frames >= 43000, "the M4 still draws and the audio still flows")
    for k in 0..<4
        assert(guest_word(m, "busy_rounds", u32(k) * 4) > 0, s"kernel ${k + 1} ran in the mix")
    assert(guest_word(m, "busy_rounds", 16) == 0, "the mix never sleeps")
    assert(guest_word(m, "audio_errors") == 0 && guest_word(m, "audio_deadline_misses") == 0)
    val used = guest_word(m, "audio_dsp_peak_cycles")
    assert(used > 128 * 255 && used < 1280000, s"the FIR's refill fits the 128-frame deadline, not $used cycles")

@test("realtime: --set writes a word at a symbol before the cores start, so the busy firmware runs the kernel named")
busy_kernel_alone()
    val board = virt.machine()
    val m = &*board
    for kernel in 1..5
        var o = unpaced(1, 0)
        o.poke = Some(Poke("busy_kernel", u32(kernel)))
        run(m, "stm32h747-disco", BUSY_GUEST, o).unwrap()
        for k in 0..<5
            val rounds = guest_word(m, "busy_rounds", u32(k) * 4)
            assert(if k + 1 == kernel then rounds > 0 else rounds == 0, s"kernel $kernel alone, but kernel ${k + 1} ran $rounds rounds")
        assert(guest_word(m, "audio_deadline_misses") == 0)
    var o = unpaced(1, 0)
    o.poke = Some(Poke("no_such_symbol", 1))
    val refused = run(m, "stm32h747-disco", BUSY_GUEST, o) match
        Err(why) -> why
        Ok(_) -> ""
    assert(refused == "the image has no symbol no_such_symbol")

@test("realtime: a run refuses no measured seconds, an unknown board and an image that does not fit")
refusals()
    val board = virt.machine()
    val m = &*board
    val refused = run(m, "stm32h747-disco", MIC_GUEST, unpaced(0, 0)) match
        Err(why) -> why
        Ok(_) -> ""
    assert(refused == "--seconds must be at least 1")
    assert(run(m, "no-such-board", MIC_GUEST, unpaced(1, 0)).is_err())
    assert(run(m, "virt", MIC_GUEST, unpaced(1, 0)).is_err(), "a flash-linked H747 image does not fit the virt board")

// The Run a window of `seconds` guest seconds measures on the DISCO board, its workers unpaced so the test is quick.
private metered(seconds: u64, warmup: u64, gave: u64) -> Option[Run]
    var o = options()
    o.seconds = seconds
    o.warmup = warmup
    val meter = meter(o)
    val board = virt.machine()
    val m = &*board
    virt.board_named(m, "stm32h747-disco").unwrap()
    meter.attach(m).unwrap()
    val image = virt.image_of(m, MIC_GUEST).unwrap()
    virt.open_console(m)
    virt.boot(m, image.view())
    virt.start_workers(m, true, 0).unwrap()
    virt.submit_workers(m, (warmup + seconds) * virt.clock_hz(m))
    var closed = false
    while !closed
        meter.sound(gave)
        meter.mic(gave)
        meter.paint(7)
        closed = meter.observe(m)
        sleep(millis(2))
    virt.stop_workers(m)
    meter.result

@test("realtime: a window's meter marks the guest seconds asked for and counts what the window played, heard and painted")
meter_window()
    val r = metered(1, 0, 3).unwrap()
    assert(r.launched && r.paced && r.hz == 480000000)
    for k in 0..<2
        assert(r.cores[k].ticks >= r.hz * 9 / 10 && r.cores[k].ticks <= r.hz * 11 / 10, s"core $k measured about one guest second")
        assert(r.cores[k].retired > 0)
    assert(r.sound_frames > 0 && r.sound_frames % 3 == 0 && r.mic_frames == r.sound_frames, "the window's own counts, from the mark on")
    assert(r.display_reads > 0 && r.display_read_us == r.display_reads * 7)
    assert(r.wall_us > 0 && r.process_cpu_us > 0)

@test("realtime: a meter started after a warmup measures less than the whole run, and refuses no seconds")
meter_warmup_and_refusal()
    val later = metered(1, 1, 1).unwrap()
    assert(later.cores[0].ticks >= later.hz * 9 / 10 && later.cores[0].ticks <= later.hz * 11 / 10, "a second after one second of warmup, not two")
    var o = options()
    o.seconds = 0
    val board = virt.machine()
    val m = &*board
    virt.board_named(m, "stm32h747-disco").unwrap()
    val refused = meter(o).attach(m) match
        Err(why) -> why
        Ok(_) -> ""
    assert(refused == "--seconds must be at least 1")

private fixed_run(core1: bool, slow: bool) -> Run
    val hz: u64 = 480000000
    val ticks = if slow then hz / 2 else hz
    Run(hz, [1, 2], core1, true, 1000000, [CoreRun(ticks, 100000000, 250000, 12), CoreRun(ticks, 50000000, 500000, 3)],
        20, 100000, 48000, 2, 47000, 60, 5000, 1500000)

@test("realtime: the report names each line, the display's unit by where it ran, and whether both cores kept real time")
report_text()
    val headless = report(fixed_run(true, false), "stm32h747-disco", "a.elf")
    assert(headless.real_time)
    assert(headless.text.contains("realtime: stm32h747-disco a.elf, paced, 1.000 s of host time"))
    assert(headless.text.contains("core 0: 1.000 x real time") && headless.text.contains("late 12 us"))
    assert(headless.text.contains("dsi worker: 20 packets") && headless.text.contains("48000 frames/s out over 2 channel(s), 47000 frames/s into the microphone"))
    assert(headless.text.contains("display: 60 copies out") && headless.text.contains("process: 1.50 host cores busy") && headless.text.ends_with("REAL TIME"))
    val windowed = report(fixed_run(true, false), "stm32h747-disco", "a.elf", "in a window")
    assert(windowed.text.contains("paced, in a window, 1.000 s") && windowed.text.contains("display: 60 paints"))
    val slow = report(fixed_run(false, true), "stm32h747-disco", "a.elf")
    assert(!slow.real_time && slow.text.contains("core 1: not launched") && slow.text.ends_with("BELOW REAL TIME"))
