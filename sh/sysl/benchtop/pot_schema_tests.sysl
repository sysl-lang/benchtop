module sh.sysl.benchtop
@tests

import sh.sysl.parsing.source_of
import sysl.raw.str_cast
import sysl.text.{Search, replace_all}

private val POT_BOARD = str_cast(embed("../../../boards/workbench.hocon"))

@test("pot description: catalog terminals, ref and bare mcu pins parse and round trip")
pot_description()
    val src = source_of("pot.hocon", POT_BOARD)
    val got = load(src, library())
    assert(!got.report.has_errors(), got.report.render(src))
    val p = got.description.board.parts[5]
    assert(p.kind == "potentiometer" && p.reference == "RV1" && p.name == "volume")
    assert(p.wires.len() == 1 && p.params.len() == 4)
    p.wires[0].to match
        Pin(pin) -> assert(pin == "GP26")
        _ -> assert(false)
    val written = description_text(got.description)
    assert(written.contains("ref = RV1"))
    val again = load(source_of("again.hocon", written), library())
    assert(!again.report.has_errors() && description_text(again.description) == written)
    // Type selection may appear after the wiring.
    val reordered = replace_all(POT_BOARD, "part = potentiometer, ref = RV1", "ref = RV1, wire { wiper = GP26 }, part = potentiometer")
    val once = replace_all(reordered, "taper = linear, wire { wiper = GP26 }", "taper = linear")
    assert(!load(source_of("reordered.hocon", once), library()).report.has_errors())

@test("pot description: invalid reference, endpoint, voltage range and terminal values are rejected")
pot_invalid()
    for pair in [
        ("ref = RV1", "ref = D1"),
        ("wiper = GP26", "wiper = missing.GP26"),
        ("wiper = GP26", "wiper = GP33"),
        ("wiper = GP26", "wiper = GP25"),
        ("wiper = GP26", "wiper = 42"),
        ("low-uv = 0", "low-uv = 4000000"),
        ("position = 50", "position = 101"),
        ("taper = linear", "taper = unknown"),
        ("wire { wiper = GP26 }", "wiper = GP26, wire { wiper = GP26 }")
    ]
        val text = replace_all(POT_BOARD, pair.0, pair.1)
        val got = load(source_of("bad.hocon", text), library())
        assert(got.report.has_errors(), s"accepted invalid setting: ${pair.1}")

@test("a port written as a parameter, or a board's own pin qualified by its mcu's name, is refused with the one form")
one_wiring_form()
    for (from, to, want) in [
        ("wire { wiper = GP26 }", "wiper = GP26", "`volume.wiper` is a port, and a port is wired under `wire`"),
        ("wire { wiper = GP26 }", "wiper = controller.GP26", "`volume.wiper` is a port, and a port is wired under `wire`"),
        ("wire { wiper = GP26 }", "wire { wiper = controller.GP26 }", "`controller.GP26` names the board's own mcu, whose pins are written bare")]
        val text = replace_all(POT_BOARD, from, to)
        val src = source_of("form.hocon", text)
        val shown = load(src, library()).report.render(src)
        assert(shown.contains(want), shown)

// The size the `readout` element of the board `text` gets, or the report.
private readout_size(text: string) -> Result[(int, int), string]
    val src = source_of("readout.hocon", text)
    val got = load(src, library())
    if got.report.has_errors() then return Err(got.report.render(src))
    for e in got.description.board.view.elements do if e.name == "readout" then return Ok((e.w, e.h))
    Err("no readout element")

// The workbench with its readout's `color = red,` preceded by `more`.
private readout_with(more: string) -> string = replace_all(POT_BOARD, "color = red,", s"$more color = red,")

private val READOUT_AT = "readout { show = readout, at = [440, 352] }"

@test("seven-segment size: the part's own, from its digits and digit height, the same on every board; a view may repeat it but not change it")
seven_size()
    // 0.56" by default: a 12.6 × 19.0 mm body per digit at 5 px/mm, four of them side by side.
    assert(readout_size(POT_BOARD).unwrap() == (252, 95))
    val two = replace_all(replace_all(POT_BOARD, "digits = 4", "digits = 2"), ", digit2 = GP20, digit3 = GP21", "")
    assert(readout_size(two).unwrap() == (126, 95), "two digits are two cells")
    assert(readout_size(readout_with("digit-height = 0.36,")).unwrap() == (164, 61))
    val big = replace_all(readout_with("digit-height = 0.8,"), READOUT_AT, "readout { show = readout, at = [40, 352] }")
    assert(readout_size(big).unwrap() == (360, 136))
    val over = readout_size(readout_with("digit-height = 0.8,")).unwrap_err()
    assert(over.contains("the element `readout` lies outside the view") && over.contains("x 440 to 800"), over)
    assert(readout_size(readout_with("digit-height = 0.56,")).unwrap() == (252, 95))
    val odd = readout_size(readout_with("digit-height = 0.5,")).unwrap_err()
    assert(odd.contains("`readout.digit-height` is the digit's height in inches, one of 0.36, 0.56 and 0.8, not 0.5"), odd)
    // A view that repeats the part's size is accepted; one that changes it is refused, by name.
    assert(readout_size(replace_all(POT_BOARD, READOUT_AT, "readout { show = readout, at = [440, 352], size = [252, 95] }")).unwrap() == (252, 95))
    val wrong = readout_size(replace_all(POT_BOARD, READOUT_AT, "readout { show = readout, at = [440, 352], size = [220, 52] }")).unwrap_err()
    assert(wrong.contains("the element `readout` shows the part `readout`, so its size is the part's own, 252 × 95, not 220 × 52"), wrong)
    assert(wrong.contains("leave out `size`: a seven-segment display's size comes from its `digits` and `digit-height`"), wrong)

// The size the workbench's view gives the element `name`, or the report.
private element_size(text: string, name: string) -> Result[(int, int), string]
    val src = source_of("parts.hocon", text)
    val got = load(src, library())
    if got.report.has_errors() then return Err(got.report.render(src))
    for e in got.description.board.view.elements do if e.name == name then return Ok((e.w, e.h))
    Err(s"no element $name")

@test("part size: every part on a view is its own size; a size variant is a parameter, and a view's other size is refused")
part_sizes_in_views()
    val led1 = "led1 { part = led, color = blue,"
    val led1_at = "led1 { show = led1, at = [84, 215] }"
    assert(element_size(POT_BOARD, "led1").unwrap() == (25, 25), "a 5 mm LED")
    assert(element_size(replace_all(POT_BOARD, led1, s"$led1 package = 3mm,"), "led1").unwrap() == (15, 15))
    assert(element_size(replace_all(POT_BOARD, led1, s"$led1 package = \"0603\","), "led1").unwrap() == (8, 4))
    assert(element_size(replace_all(POT_BOARD, led1, s"$led1 package = 0603,"), "led1").unwrap() == (8, 4), "0603 needs no quotes")
    val turned = replace_all(replace_all(POT_BOARD, led1, s"$led1 package = \"0805\","), led1_at, "led1 { show = led1, at = [84, 215], look { rotate = 90 } }")
    assert(element_size(turned, "led1").unwrap() == (6, 10), "a turned part swaps its sides")
    val odd = element_size(replace_all(POT_BOARD, led1, s"$led1 package = 7mm,"), "led1").unwrap_err()
    assert(odd.contains("package"), odd)
    // A size the view repeats is accepted, any other refused with what sets the part's size.
    assert(element_size(replace_all(POT_BOARD, led1_at, "led1 { show = led1, at = [84, 215], size = [25, 25] }"), "led1").unwrap() == (25, 25))
    val wrong = element_size(replace_all(POT_BOARD, led1_at, "led1 { show = led1, at = [84, 215], size = [24, 24] }"), "led1").unwrap_err()
    assert(wrong.contains("the element `led1` shows the part `led1`, so its size is the part's own, 25 × 25, not 24 × 24"), wrong)
    assert(wrong.contains("leave out `size`: an LED's size comes from its `package`"), wrong)
    val lcd = element_size(replace_all(POT_BOARD, "lcd { show = lcd, at = [296, 20] }", "lcd { show = lcd, at = [296, 20], size = [255, 78] }"), "lcd").unwrap_err()
    assert(lcd.contains("so its size is the part's own, 414 × 104, not 255 × 78") && lcd.contains("`columns` and `rows`"), lcd)
    val tft = element_size(replace_all(POT_BOARD, "tft { show = tft, at = [358, 476] }", "tft { show = tft, at = [358, 476], size = [250, 250] }"), "tft").unwrap_err()
    assert(tft.contains("252 × 266, not 250 × 250") && tft.contains("`width` and `height`"), tft)
    // The buttons are 12 mm bodies; a 6 mm one is smaller.
    assert(element_size(POT_BOARD, "button1").unwrap() == (60, 60))
    assert(element_size(replace_all(POT_BOARD, "button1 { part = button, active = low, body = 12mm,", "button1 { part = button, active = low,"), "button1").unwrap() == (30, 30))
    // A 1.3" OLED is larger than the 0.96" one, and a diagonal there is no part for is refused.
    val oled = "oled { part = ssd1306, ref = DS3,"
    assert(element_size(POT_BOARD, "oled").unwrap() == (272, 144))
    assert(element_size(replace_all(POT_BOARD, oled, s"$oled diagonal = 1.3,"), "oled").unwrap() == (363, 189))
    val glass = element_size(replace_all(POT_BOARD, oled, s"$oled diagonal = 1.1,"), "oled").unwrap_err()
    assert(glass.contains("`oled.diagonal` is the glass's diagonal in inches, 0.96 or 1.3, not 1.1"), glass)
    val pot = "volume { part = potentiometer, ref = RV1, position = 50,"
    assert(element_size(POT_BOARD, "volume").unwrap() == (80, 80))
    assert(element_size(replace_all(POT_BOARD, pot, s"$pot body = 9mm,"), "volume").unwrap() == (45, 45))

@test("seven-segment description: terminals, references, polarity and multiplex counts are checked")
seven_schema()
    val good = load(source_of("display.hocon", POT_BOARD), library())
    assert(!good.report.has_errors())
    assert(good.description.board.parts[6].reference == "DS1")
    for pair in [
        ("digits = 4", "digits = 9"),
        ("digits = 4", "digits = 3"),
        ("common = cathode", "common = invalid"),
        ("digit3 = GP21", "digit4 = GP21"),
        ("a = GP10", "a = GP99"),
        ("a = GP10", "a = GP8"),
        ("persistence-cycles = 50000", "persistence-cycles = 0")
    ]
        val text = replace_all(POT_BOARD, pair.0, pair.1)
        assert(load(source_of("invalid-display.hocon", text), library()).report.has_errors(), pair.1)
