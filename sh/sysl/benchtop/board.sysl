module sh.sysl.benchtop

import sh.sysl.hocon.*
import sh.sysl.parsing.{Diagnostic, Report, Source, Span, error, full_report, nearest_name}
import sysl.buf.{Buf, buf}
import sysl.text.{parse_long_base, str_builder}

// A description file read into the model: the HOCON tree, held to the format's shape.
//
// **This half knows the format and nothing about the library.** It says a section is unknown, a size
// is not two numbers, an element says both what part it shows and what text it is; whether `st7796`
// is a part, GP30 a pin, or `pico` a board benchtop has, is asked of the registry and the shelf
// later. Every mistake is recorded and reading goes on, so a person editing a file sees all of its
// mistakes at once rather than one per save.

/** A description read: the model as far as it could be built, and everything wrong with it. */
struct Loaded
    description: Description
    report: Report

/** Read, build, find the boards of and check a description. `shelf` is where a board named by
 * another (`board = pico2w`, a product's `board = pico`) is found.
 */
load(src: Source, reg: Registry, shelf: Shelf = built_in_shelf()) -> Loaded = load_at(src, reg, shelf, 0)

/** `load`, `depth` boards deep in a chain of boards naming boards. */
load_at(src: Source, reg: Registry, shelf: Shelf, depth: int) -> Loaded
    var r = full_report()

    val doc = parse(src) match
        Ok(d) -> d
        Err(d) ->
            r.add(d)
            return Loaded(empty_description(), r)

    var d = build(src, doc, &r)

    find_boards(&d, src, reg, shelf, depth, &r)
    check_description(&d, reg, src, &r)
    Loaded(d, r)
end load_at

/** The model a document describes, with every shape mistake added to `r`. */
build(src: Source, doc: Document, r: *Report) -> Description
    var d = empty_description()
    val root = doc.root

    if !root.is_obj() then
        r.add(error(root.span, s"a description is `chip { ... }`, `board { ... }` or `product { ... }`, not ${root.kind_name()}"))
        return d

    var first_form = ""

    for f in root.fields()
        if f.key == "chip" || f.key == "board" || f.key == "product" then
            if first_form.is_empty() then
                first_form = f.key
            elif first_form != f.key then
                r.add(error(f.key_span, s"the description is both a $first_form and a ${f.key}")
                    .with_note("a file describes one chip, one board or one product; a board's chip goes in its `chip`, and a product's boards in its `boards`"))
                continue
        end if

        if f.key == "chip" then
            d.form = ChipForm

            if f.value.is_obj() then
                read_chip(&d.chip, f, r)
            else
                named_here(&d, f, "chip", "`chip = rp2040` or `chip = \"chips/mine.hocon\"`", r)
        elif f.key == "board" then
            d.form = BoardForm

            if f.value.is_obj() then
                read_board(&d.board, f, r)
            else
                named_here(&d, f, "board", "`board = pico2w` or `board = \"boards/mine.hocon\"`", r)
        elif f.key == "product" then
            d.form = ProductForm
            read_product(&d.product, f, r)
        elif chip_section(f.key) then
            r.add(error(f.key_span, s"`${f.key}` belongs inside `chip { ... }`"))
        elif in_section(f.key) then
            r.add(error(f.key_span, s"`${f.key}` belongs inside `board { ... }` or `product { ... }`"))
        else
            unknown(r, f, "section", "", ["chip", "board", "product"])
    end for

    if d.form == NoForm && first_form.is_empty() then
        r.add(error(Span(0, 0), "the description is neither a chip, a board nor a product")
            .with_note("a description is `chip { ... }`, `board { ... }`, `product { ... }`, or a board benchtop has built in, as `board = pico2w`"))

    repeats(src, doc, r, if d.form == ChipForm then d.chip.cores else d.board.chip.cores)
    d
end build

// A chip or a board named at the top of a file, `board = pico2w`.
private named_here(d: *Description, f: Field, what: string, example: string, r: *Report)
    f.value.as_text() match
        Some(t) ->
            d.named = t
            d.named_span = f.value.span
        None ->
            r.add(error(f.value.span, s"`$what` must be a block, or the name of ${article_of(what)} $what, not ${f.value.kind_name()}")
                .with_note(s"write ${article_of(what)} $what out as `$what { ... }`, or name one, as $example"))
end named_here

// The names a board or a product holds, written at the top of a file instead.
private in_section(key: string) -> bool =
    key == "name" || key == "parts" || key == "buses" || key == "exposes" || key == "view" || key == "input" ||
    key == "boards"

// The names only a chip holds.
private chip_section(key: string) -> bool = key == "cores" || key == "pins" || key == "peripherals" || key == "summary"

// An explicit core configuration; a plain name is the same core with all its defaults.
private read_core(v: Value, r: *Report) -> Core
    var c = Core("", v.span, buf(), true, v.span)

    for f in v.fields()
        if f.key == "core"
            c.name = text(f, "`core`", r)
            c.span = f.value.span
        else
            setting(f, s"core option `${f.key}`", r) match
                Some(s) -> c.options.push(Param(f.key, f.key_span, s, f.value.span))
                None -> ()

    if !has_field(v, "core") then r.add(error(v.span, "a core configuration names no core").with_note("say `core = cortex-m7`, followed by its options"))

    c
end read_core

// -- a chip ----------------------------------------------------------------------------------------

private read_chip(c: *Chip, f: Field, r: *Report)
    c.span = f.key_span

    for g in f.value.fields()
        if g.key == "name" then
            c.name = text(g, "`chip.name`", r)
        elif g.key == "summary" then
            c.summary = text(g, "`chip.summary`", r)
        elif g.key == "cores" then
            c.cores_span = g.value.span

            if !g.value.is_arr() then
                r.add(error(g.value.span, s"`chip.cores` must be a list of cores, not ${g.value.kind_name()}")
                    .with_note("name each core, as `cores = [cortex-m0plus, cortex-m0plus]`"))
            elif g.value.items().is_empty() then
                r.add(error(g.value.span, "`chip.cores` names no core")
                    .with_note("name each core, as `cores = [cortex-m0plus, cortex-m0plus]`"))
            else
                for v in g.value.items()
                    if v.is_obj()
                        c.cores.push(read_core(v, r))
                    else
                        v.as_text() match
                            Some(t) -> c.cores.push(Core(t, v.span, buf(), false, v.span))
                            None -> r.add(error(v.span, s"a core is named by a word or a block, not ${v.kind_name()}"))
        elif g.key == "pins" then
            read_banks(c, g, r)
        elif g.key == "peripherals" then
            read_peripherals(&c.peripherals, g, r)
        elif g.key == "parts" then
            r.add(error(g.key_span, "a chip has `peripherals`, not `parts`")
                .with_note("what is on the cores' bus is a peripheral of the chip; a part is soldered beside it, on a board"))
        else
            unknown(r, g, "setting", " in `chip`", ["name", "summary", "cores", "pins", "peripherals"])
    end for

    if !has_field(f.value, "name") then
        r.add(error(f.key_span, "the chip has no name").with_note("give it one, as `name = rp2040`"))

    if !has_field(f.value, "cores") then
        r.add(error(f.key_span, "the chip has no cores").with_note("name each, as `cores = [cortex-m0plus, cortex-m0plus]`"))
end read_chip

// `pins { GP = 30 }`: each bank's capital-letter prefix and how many pins it has.
private read_banks(c: *Chip, f: Field, r: *Report)
    if !is_block(f, "`pins`", r) then return

    for g in f.value.fields()
        if pin_parts(s"${g.key}0").is_none() then
            r.add(error(g.key_span, s"`${g.key}` is not a bank of pins")
                .with_note("a bank is named in capital letters, as `GP` for GP0, GP1, ..., or `PA` for PA0, PA1, ..."))
            continue

        val n = g.value.as_long() match
            Some(n) -> n
            None -> 0

        if n < 1 || n > 100000 then
            r.add(error(g.value.span, s"`pins.${g.key}` must be a whole number from 1, the bank's count of pins"))
            continue

        c.banks.push(Bank(g.key, int(n), g.key_span))
    end for
end read_banks

private read_peripherals(ps: *Buf[Peripheral], f: Field, r: *Report)
    if !is_block(f, "`peripherals`", r) then return

    for g in f.value.fields()
        if !is_block(g, s"the peripheral `${g.key}`", r) then continue

        var p = Peripheral(g.key, g.key_span, "", g.key_span, buf(), None, None, buf(), g.key_span, buf(), buf())

        for h in g.value.fields()
            val what = s"`${g.key}.${h.key}`"

            if h.key == "peripheral" then
                p.kind = text(h, what, r)
                p.kind_span = h.value.span
            elif h.key == "part" then
                r.add(error(h.key_span, s"$what: a peripheral says which library peripheral it is with `peripheral`")
                    .with_note("write it as `peripheral = pl011`"))
            elif h.key == "at" then
                p.at = amount(h, what, false, r)
            elif h.key == "size" then
                p.size = amount(h, what, true, r)
            elif h.key == "irq" then
                p.irq_span = h.key_span

                if h.value.is_arr() then
                    for v in h.value.items() do p.irqs.push(amount_value(v, h.key_span, what, false, r))
                else
                    amount(h, what, false, r) match
                        Some(a) -> p.irqs.push(a)
                        None -> ()
            elif h.key == "signals" then
                if is_block(h, what, r) then
                    for k in h.value.fields()
                        var route = Route(k.key, k.key_span, buf())

                        pins_of(k.value, s"`${g.key}.signals.${k.key}`", &route.pins, r)
                        p.signals.push(route)
            elif h.key == "channels" then
                pins_of(h.value, what, &p.channels, r)
            else
                setting(h, what, r) match
                    Some(s) -> p.params.push(Param(h.key, h.key_span, s, h.value.span))
                    None -> ()
        end for

        if p.kind.is_empty() && !has_field(g.value, "peripheral") then
            r.add(error(g.key_span, s"`${g.key}` names no peripheral")
                .with_note("every peripheral says which library peripheral it is, as `peripheral = pl011`"))

        ps.push(p)
    end for
end read_peripherals

// A list of pins, `[GP0, GP12]`, or a single pin.
private pins_of(v: Value, what: string, out: *Buf[PinRef], r: *Report)
    var items: Buf[Value] = buf()

    if v.is_arr() then items.extend(v.items().view()) else items.push(v)

    for x in items
        x.as_text() match
            Some(t) ->
                if is_pin_name(t) then
                    out.push(PinRef(t, x.span))
                else
                    r.add(error(x.span, s"$what lists pins such as `GP2`, and `$t` is not one"))
            None -> r.add(error(x.span, s"$what lists pins such as `GP2`, not ${x.kind_name()}"))
end pins_of

// -- a board ---------------------------------------------------------------------------------------

private read_board(b: *Board, f: Field, r: *Report)
    for g in f.value.fields()
        if g.key == "name" then
            b.name = text(g, "`board.name`", r)
        elif g.key == "chip" then
            b.has_chip = true
            b.chip_span = g.value.span

            if g.value.is_obj() then
                read_chip(&b.chip, g, r)
                b.chip_found = true
            else
                b.chip_named = text(g, "`board.chip`", r)
        elif g.key == "cores" || g.key == "peripherals" || g.key == "pins" then
            r.add(error(g.key_span, s"`${g.key}` belongs to the chip")
                .with_note("a board names its chip, as `chip = rp2040`, or writes it out, as `chip { name = mine, cores = [...], peripherals { ... } }`"))
        elif g.key == "parts" then
            read_parts(&b.parts, g, r)
        elif g.key == "buses" then
            if is_block(g, "`buses`", r) then
                for h in g.value.fields() do read_bus(&b.buses, "", h.key_span, h, r)
        elif g.key == "exposes" then
            read_exposes(b, g, r)
        elif g.key == "view" then
            read_view(&b.view, g, r)
        elif g.key == "input" then
            read_input(&b.keys, &b.pointers, g, r)
        else
            unknown(r, g, "setting", " in `board`", ["name", "chip", "parts", "buses", "exposes", "view", "input"])
    end for

    val v = f.value

    if !has_field(v, "name") then
        r.add(error(f.key_span, "the board has no name")
            .with_note("give it one, as `name = \"Raspberry Pi Pico\"`"))

    if !has_field(v, "chip") then
        r.add(error(f.key_span, "the board names no chip")
            .with_note("say which chip its parts are wired to, as `chip = rp2040`, or write the chip out, as `chip { name = mine, cores = [cortex-m0plus] }`"))
end read_board

private read_exposes(b: *Board, f: Field, r: *Report)
    if !is_block(f, "`exposes`", r) then return

    b.exposes_span = f.key_span

    for g in f.value.fields()
        val pins = g.key == "pins"

        if !pins && g.key != "buses" then
            unknown(r, g, "setting", " in `exposes`", ["pins", "buses"])
            continue

        if !g.value.is_arr() then
            r.add(error(g.value.span, s"`exposes.${g.key}` must be a list, not ${g.value.kind_name()}")
                .with_note(if pins then "list the pins, as `pins = [GP0, GP1]`" else "list the buses, as `buses = [spi0, i2c0]`"))
            continue

        for v in g.value.items()
            val t = v.as_text() match
                Some(t) -> t
                None -> ""

            if !pins then
                if t.is_empty() then
                    r.add(error(v.span, s"`exposes.buses` lists buses such as `spi0`, not ${v.kind_name()}"))
                else
                    b.exposed_buses.push(Exposed(t, v.span))
            elif is_pin_name(t) then
                b.exposed_pins.push(Exposed(t, v.span))
            else
                r.add(error(v.span, s"`exposes.pins` lists pins such as `GP15`, and `${if t.is_empty() then v.kind_name() else t}` is not one"))
        end for
    end for
end read_exposes

// -- a product -------------------------------------------------------------------------------------

private read_product(p: *Product, f: Field, r: *Report)
    if !is_block(f, "the `product` section", r) then return

    for g in f.value.fields()
        if g.key == "name" then
            p.name = text(g, "`product.name`", r)
        elif g.key == "boards" then
            read_instances(p, g, r)
        elif g.key == "parts" then
            read_parts(&p.parts, g, r)
        elif g.key == "buses" then
            // A product's buses are its boards': `pico.spi0 { sck = GP2 }`, the board first.
            if is_block(g, "`buses`", r) then
                for h in g.value.fields()
                    if is_block(h, s"the buses of `${h.key}`", r) then
                        for k in h.value.fields() do read_bus(&p.buses, h.key, h.key_span, k, r)
        elif g.key == "view" then
            read_view(&p.view, g, r)
        elif g.key == "input" then
            read_input(&p.keys, &p.pointers, g, r)
        elif g.key == "peripherals" || g.key == "cores" || g.key == "chip" then
            r.add(error(g.key_span, s"`${g.key}` belongs to a chip")
                .with_note("a product holds boards, and each board its chip"))
        else
            unknown(r, g, "setting", " in `product`", ["name", "boards", "parts", "buses", "view", "input"])
    end for

    if !has_field(f.value, "name") then
        r.add(error(f.key_span, "the product has no name")
            .with_note("give it one, as `name = \"Pico Breadboard Kit\"`"))

    if p.boards.is_empty() && !has_field(f.value, "boards") then
        r.add(error(f.key_span, "the product has no boards")
            .with_note("name each, as `boards { pico { board = pico } }`"))
end read_product

private read_instances(p: *Product, f: Field, r: *Report)
    if !is_block(f, "`boards`", r) then return

    p.boards_span = f.key_span

    if f.value.fields().is_empty() then
        r.add(error(f.key_span, "the product has no boards")
            .with_note("name each, as `boards { pico { board = pico } }`"))

    for g in f.value.fields()
        if !is_block(g, s"the board `${g.key}`", r) then continue

        var inst = Instance(g.key, g.key_span, "", g.key_span, buf(), empty_board(), false)

        for h in g.value.fields()
            if h.key == "board" then
                inst.of = text(h, s"`${g.key}.board`", r)
                inst.of_span = h.value.span
            elif h.key == "parts" then
                read_overrides(&inst, h, r)
            else
                unknown(r, h, "setting", s" in the board `${g.key}`", ["board", "parts"])
        end for

        if !has_field(g.value, "board") then
            r.add(error(g.key_span, s"`${g.key}` names no board")
                .with_note("say which board it is, as `board = pico`, or a file's path, as `board = \"boards/mine.hocon\"`"))

        p.boards.push(inst)
    end for
end read_instances

// An instance's overrides: `parts { led { color = red } }`, or `parts.led.color = red`.
private read_overrides(inst: *Instance, f: Field, r: *Report)
    if !is_block(f, s"`${inst.name}.parts`", r) then return

    for g in f.value.fields()
        if !is_block(g, s"`${inst.name}.parts.${g.key}`", r) then continue

        for h in g.value.fields()
            val what = s"`${inst.name}.parts.${g.key}.${h.key}`"

            if h.key == "part" || h.key == "wire" || h.key == "at" || h.key == "size" || h.key == "irq" then
                r.add(error(h.key_span, s"$what cannot be overridden")
                    .with_note("an override sets a part's parameters; which part it is, its wiring and its place on the bus stay as the board has them"))
                continue

            setting(h, what, r) match
                Some(s) -> inst.overrides.push(Override(g.key, g.key_span, Param(h.key, h.key_span, s, h.value.span)))
                None -> ()
        end for
    end for
end read_overrides

// -- parts -----------------------------------------------------------------------------------------

private read_parts(parts: *Buf[Part], f: Field, r: *Report)
    if !is_block(f, "`parts`", r) then return

    for g in f.value.fields()
        if !is_block(g, s"the part `${g.key}`", r) then continue

        var p = Part("", g.key_span, g.key, g.key_span, "", g.key_span, buf(), buf(), None, None, None)

        for h in g.value.fields()
            val what = s"`${g.key}.${h.key}`"

            if h.key == "part" then
                p.kind = text(h, what, r)
                p.kind_span = h.value.span
            elif h.key == "ref" then
                p.reference = text(h, what, r)
                p.reference_span = h.value.span
            elif h.key == "wire" then
                read_wires(&p, h, r)
            elif h.key == "at" then
                p.at = amount(h, what, false, r)
            elif h.key == "size" then
                p.size = amount(h, what, true, r)
            elif h.key == "irq" then
                p.irq = amount(h, what, false, r)
            else
                setting(h, what, r) match
                    Some(s) -> p.params.push(Param(h.key, h.key_span, s, h.value.span))
                    None -> ()
        end for

        if p.kind.is_empty() && !has_field(g.value, "part") then
            r.add(error(g.key_span, s"`${g.key}` names no part")
                .with_note("every part says which library part it is, as `part = led`"))

        parts.push(p)
    end for
end read_parts

private read_wires(p: *Part, f: Field, r: *Report)
    if !is_block(f, s"`${p.name}.wire`", r) then return

    for g in f.value.fields()
        val what = s"`${p.name}.wire.${g.key}`"

        g.value.as_text() match
            Some(t) -> p.wires.push(Wire(g.key, g.key_span, target_of(t), g.value.span))
            None -> r.add(error(g.value.span, s"$what must be a pin, a bus or a part's port, not ${g.value.kind_name()}")
                .with_note("a wire names a pin as `GP16`, a bus as `spi0`, or another part's port as `wifi.gpio0`"))
end read_wires

/** What a wire's text names. Capital letters and digits is a pin; a dotted name is a part's port, or
 * in a product a board's pin or bus; anything else is a bus, which the checker looks for among the
 * chip's.
 */
target_of(t: string) -> Target
    if is_pin_name(t) then return Pin(t)

    t.index_of(".") match
        Some(dot) -> Port(t[0..<dot], t[(dot + 1)..])
        None -> Bus(t)
end target_of

// -- buses -----------------------------------------------------------------------------------------

// One bus, `spi0 { sck = GP2, tx = GP3 }`, of the chip of `board` (empty on a board's own).
private read_bus(buses: *Buf[Bus], board: string, board_span: Span, g: Field, r: *Report)
    val qualified = if board.is_empty() then g.key else s"$board.${g.key}"

    if !is_block(g, s"the bus `$qualified`", r) then return

    var bus = Bus(board, board_span, g.key, g.key_span, buf())

    for h in g.value.fields()
        val pin = h.value.as_text() match
            Some(t) -> t
            None -> ""

        if is_pin_name(pin) then
            bus.signals.push(Signal(h.key, h.key_span, pin, h.value.span))
        else
            r.add(error(h.value.span, s"`$qualified.${h.key}` must be a pin such as `GP2`"))
    end for

    buses.push(bus)
end read_bus

// -- the view --------------------------------------------------------------------------------------

private read_view(view: *View, f: Field, r: *Report)
    if !is_block(f, "`view`", r) then return

    view.span = f.key_span

    var sized = false

    for g in f.value.fields()
        if g.key == "size" then
            pair(g.value, "`view.size`", "[width, height]", r) match
                Some((w, h)) ->
                    view.width = w
                    view.height = h
                    sized = true
                None -> ()
        elif g.key == "background" then
            view.background = text(g, "`view.background`", r)
        elif g.key == "elements" then
            read_elements(view, g, r)
        else
            unknown(r, g, "setting", " in `view`", ["size", "background", "elements"])
    end for

    if !sized && !has_field(f.value, "size") then
        r.add(error(f.key_span, "the view has no size").with_note("give it one, as `size = [922, 499]`"))
end read_view

private read_elements(view: *View, f: Field, r: *Report)
    if !is_block(f, "`view.elements`", r) then return

    for g in f.value.fields()
        if !is_block(g, s"the element `${g.key}`", r) then continue

        var e = Element(g.key, g.key_span, Caption(""), g.key_span, 0, 0, 0, 0, false, false, "", buf(), g.key_span)
        var says: Buf[string] = buf()
        var placed = false

        for h in g.value.fields()
            val what = s"`${g.key}.${h.key}`"

            if h.key == "show" || h.key == "text" || h.key == "box" then
                val t = text(h, what, r)

                says.push(h.key)
                e.shows_span = h.key_span
                e.shows = if h.key == "show" then ShowPart(t) elif h.key == "text" then Caption(t) else Fill(t)
            elif h.key == "at" then
                pair(h.value, what, "[x, y]", r) match
                    Some((x, y)) ->
                        e.x = x
                        e.y = y
                        placed = true
                    None -> placed = true
            elif h.key == "size" then
                pair(h.value, what, "[width, height]", r) match
                    Some((w, hh)) ->
                        e.w = w
                        e.h = hh
                        e.has_size = true
                    None -> ()
            elif h.key == "label" then
                e.label = text(h, what, r)
            elif h.key == "look" then
                if is_block(h, what, r) then
                    for k in h.value.fields()
                        setting(k, s"`${g.key}.look.${k.key}`", r) match
                            Some(s) -> e.look.push(Param(k.key, k.key_span, s, k.value.span))
                            None -> ()
            else
                unknown(r, h, "setting", s" in the element `${g.key}`", ["show", "text", "box", "at", "size", "label", "look"])
        end for

        if says.is_empty() then
            r.add(error(g.key_span, s"the element `${g.key}` does not say what it draws")
                .with_note("an element is a part (`show = d1`), a caption (`text = \"BTN1\"`) or a filled box (`box = \"#202020\"`)"))
        elif says.len() > 1 then
            r.add(error(g.key_span, s"the element `${g.key}` says both `${says.at(0)}` and `${says.at(1)}`")
                .with_note("an element draws one thing: a part, a caption or a box"))

        if !placed then
            r.add(error(g.key_span, s"the element `${g.key}` has no place in the view")
                .with_note("give it one, as `at = [20, 40]`: its top-left corner, in pixels"))

        view.elements.push(e)
    end for
end read_elements

// -- input -----------------------------------------------------------------------------------------

private read_input(keys: *Buf[KeyBinding], pointers: *Buf[PointerBinding], f: Field, r: *Report)
    if !is_block(f, "`input`", r) then return

    for g in f.value.fields()
        if g.key == "keys" then
            if !is_block(g, "`input.keys`", r) then continue

            for h in g.value.fields()
                val t = text(h, s"`input.keys.${h.key}`", r)
                val (part, control) = t.index_of(".") match
                    Some(dot) -> (t[0..<dot], t[(dot + 1)..])
                    None -> (t, "")

                keys.push(KeyBinding(h.key, h.key_span, part, control, h.value.span))
            end for
        elif g.key == "pointer" then
            if !is_block(g, "`input.pointer`", r) then continue

            for h in g.value.fields()
                pointers.push(PointerBinding(h.key, h.key_span, text(h, s"`input.pointer.${h.key}`", r), h.value.span))
        else
            unknown(r, g, "setting", " in `input`", ["keys", "pointer"])
    end for
end read_input

// -- names written twice ---------------------------------------------------------------------------

// HOCON merges a name written twice; in a description it is a mistake, so every repeat the reader
// recorded at a place where names are identities is reported, pointing at the second and naming the
// first. A whole block written twice is one mistake: what the two copies share beneath it is not
// reported again.
private repeats(src: Source, doc: Document, r: *Report, cores: Buf[Core])
    var whole: Buf[string] = buf()

    for rep in doc.repeats
        val (_, is_whole) = repeat_message(split_path(rep.path))

        if is_whole then whole.push(rep.path)

    for rep in doc.repeats
        // HOCON objects inside arrays carry local repeat paths; their spans identify the core.
        for c in cores
            if c.configured && rep.again.start >= c.extent.start && rep.again.start < c.extent.end then
                r.add(error(rep.again, s"core setting `${rep.path}` is set twice")
                    .with_note(s"it was first written at ${src.locate(rep.first.start)}"))

        if beneath(rep.path, whole) then continue

        val (message, _) = repeat_message(split_path(rep.path))

        if !message.is_empty() then
            r.add(error(rep.again, message).with_note(s"it was first written at ${src.locate(rep.first.start)}"))
    end for
end repeats

// Whether `path` is inside one of the blocks `whole` names.
private beneath(path: string, whole: Buf[string]) -> bool
    for w in whole
        if path.starts_with(s"$w.") then return true

    false

// What a repeat at the path `segs` is, and whether it is a whole named block written twice. An empty
// message is a merge the format allows.
private repeat_message(segs: Buf[string]) -> (string, bool)
    val top = segs.at(0)

    if top == "chip" then return chip_repeat(segs, 1, "chip")
    if top == "board" && segs.len() >= 3 && segs.at(1) == "chip" then return chip_repeat(segs, 2, "board.chip")
    if top != "board" && top != "product" then return ("", false)

    val n = segs.len() - 1

    if n == 0 then return (s"`$top` is written twice", true)

    val s1 = segs.at(1)
    val s2 = if n >= 2 then segs.at(2) else ""
    val s3 = if n >= 3 then segs.at(3) else ""

    if n == 1 then
        return if s1 == "name" || s1 == "chip" then (s"`$top.$s1` is set twice", false) else ("", false)

    if n == 2 && (s1 == "parts" || s1 == "boards" || (s1 == "buses" && top == "board")) then
        return (s"duplicate name `$s2`", true)

    if n == 3 && s1 == "buses" && top == "product" then return (s"duplicate name `$s2.$s3`", true)
    if n == 3 && s1 == "view" && s2 == "elements" then return (s"duplicate name `$s3`", true)
    if n == 3 && s1 == "input" && s2 == "keys" then return (s"the key `$s3` is bound twice", false)
    if n == 3 && s1 == "input" && s2 == "pointer" then return (s"the element `$s3` is bound twice", false)
    if n == 3 && s1 == "parts" then return (s"`$s2.$s3` is set twice", false)
    if n == 3 && s1 == "boards" then return (s"`$s2.$s3` is set twice", false)
    if n == 4 && s1 == "parts" && s3 == "wire" then return (s"`$s2.${segs.at(4)}` is wired twice", false)
    if n == 5 && s1 == "boards" && s3 == "parts" then return (s"`$s2.parts.${segs.at(4)}.${segs.at(5)}` is set twice", false)

    ("", false)
end repeat_message

// A repeat inside a chip, whose own settings start at `segs[from]`; `top` is how a message names the
// chip.
private chip_repeat(segs: Buf[string], from: usize, top: string) -> (string, bool)
    if segs.len() == from then return (s"`$top` is written twice", true)

    val n = segs.len() - from
    val s1 = segs.at(from)

    if n == 1 then
        return if s1 == "name" || s1 == "summary" || s1 == "cores" then (s"`$top.$s1` is set twice", false) else ("", false)

    if n == 2 && s1 == "pins" then return (s"`pins.${segs.at(from + 1)}` is set twice", false)
    if n == 2 && s1 == "peripherals" then return (s"duplicate name `${segs.at(from + 1)}`", true)
    if n == 3 && s1 == "peripherals" then return (s"`${segs.at(from + 1)}.${segs.at(from + 2)}` is set twice", false)
    if n == 4 && s1 == "peripherals" && segs.at(from + 2) == "signals" then
        return (s"`${segs.at(from + 1)}.signals.${segs.at(from + 3)}` is set twice", false)

    ("", false)
end chip_repeat

// A repeat's path, `parts.d1` or `parts."a.b"`, split into its names.
private split_path(p: string) -> Buf[string]
    var out: Buf[string] = buf()
    var from: usize = 0
    var quoted = false

    for i in 0..(p.bytes.len)
        if i < p.bytes.len && p.bytes[i] == u8('"') then
            quoted = !quoted
        elif i == p.bytes.len || (p.bytes[i] == u8('.') && !quoted) then
            var seg = p[from..<i]

            if seg.bytes.len >= 2 && seg.starts_with("\"") then seg = seg[1..<(seg.bytes.len - 1)]

            out.push(seg)
            from = i + 1
        end if
    end for

    out
end split_path

// -- the shapes every section shares ---------------------------------------------------------------

private is_block(f: Field, what: string, r: *Report) -> bool
    if f.value.is_obj() then return true

    r.add(error(f.value.span, s"$what must be a block, not ${f.value.kind_name()}")
        .with_note(s"write it as `${f.key} { ... }`"))
    false
end is_block

private has_field(v: Value, key: string) -> bool = v.field(key).is_some()

// A setting whose value must be text: a word or a quoted string. Anything else is reported and read
// as empty.
private text(f: Field, what: string, r: *Report) -> string
    f.value.as_text() match
        Some(t) -> t
        None ->
            r.add(error(f.value.span, s"$what must be a word or a quoted string, not ${f.value.kind_name()}"))
            ""
end text

// A pair of whole numbers, `[x, y]`.
private pair(v: Value, what: string, shape: string, r: *Report) -> Option[(int, int)]
    val items = v.items()

    if v.is_arr() && items.len() == 2 then
        val a = items.at(0).as_long()
        val b = items.at(1).as_long()

        if a.is_some() && b.is_some() then return Some((int(a.unwrap()), int(b.unwrap())))
    end if

    r.add(error(v.span, s"$what must be $shape, two whole numbers"))
    None
end pair

// A parameter's value as it was written. A word that is a hexadecimal number, `0x5d`, is a whole
// number, which is how an address is written on a datasheet.
private setting(f: Field, what: string, r: *Report) -> Option[Setting]
    f.value.kind match
        Int(n, _) -> Some(Whole(n))
        Real(x, _) -> Some(Number(x))
        Bool(on) -> Some(Flag(on))
        Str(s) -> Some(Text(s))
        Word(w) ->
            if w.starts_with("0x") && w.bytes.len > 2 then
                parse_long_base(w[2..], 16) match
                    Ok(n) -> return Some(Whole(n))
                    Err(_) -> ()

            Some(Text(w))
        _ ->
            r.add(error(f.value.span, s"$what must be a single value, not ${f.value.kind_name()}"))
            None
end setting

// A part's address, IRQ or size: a whole number, written in decimal (`7`) or hexadecimal
// (`0x40000000`); a size may also be written in kibibytes or mebibytes (`64K`, `1M`).
private amount(f: Field, what: string, sized: bool, r: *Report) -> Option[Amount] = Some(amount_value(f.value, f.key_span, what, sized, r))

// One amount's value, of the setting whose name is at `key_span`.
private amount_value(v: Value, key_span: Span, what: string, sized: bool, r: *Report) -> Amount
    val n: Option[long] = v.kind match
        Int(n, _) -> if n >= 0 then Some(n) else None
        Word(w) -> amount_of(w, sized)
        _ -> None

    n match
        Some(x) -> Amount(x, written_text(v), key_span, v.span)
        None ->
            val forms = if sized then "a whole number such as `4096`, `0x1000`, `64K` or `1M`" else "a whole number such as `7` or `0x40000000`"

            r.add(error(v.span, s"$what must be $forms"))
            // Written, though not readably: -1 keeps the checker from also saying it is missing.
            Amount(-1, "", key_span, v.span)
end amount_value

// The value a word spells as an amount, or `None`.
private amount_of(w: string, sized: bool) -> Option[long]
    if w.starts_with("0x") && w.bytes.len > 2 then
        return parse_long_base(w[2..], 16) match
            Ok(n) -> if n >= 0 then Some(n) else None
            Err(_) -> None

    val k = w.bytes.len

    if !sized || k < 2 then return None

    val unit: long = w.bytes[k - 1] match
        'K' -> 1024
        'M' -> 1048576
        _ -> return None

    parse_long_base(w[0..<(k - 1)], 10) match
        Ok(n) -> if n >= 0 && n <= 4096 * 1024 then Some(n * unit) else None
        Err(_) -> None
end amount_of

// A value's text as it was written: a number's own, a word as it stands.
private written_text(v: Value) -> string
    v.kind match
        Int(_, w) -> w
        Word(w) -> w
        _ -> ""

// A name that is not one the format knows, with a guess at the one that was meant.
private unknown(r: *Report, f: Field, what: string, where: string, known: []const string)
    var names: Buf[string] = buf()

    names.extend(known)

    var d = error(f.key_span, s"unknown $what `${f.key}`$where")

    nearest_name(f.key, names) match
        Some(n) -> d = d.with_label(s"did you mean `$n`?")
        None -> ()

    r.add(d.with_note(s"the ${what}s here are ${listing(names)}"))
end unknown

/** Names as a message lists them: `a`, `b` and `c`. */
listing(names: Buf[string]) -> string
    var b = str_builder()

    for i in 0..<names.len()
        if i > 0 then b.push(if i + 1 == names.len() then " and " else ", ")

        b.push(s"`${names.at(i)}`")

    b.finish()
end listing
