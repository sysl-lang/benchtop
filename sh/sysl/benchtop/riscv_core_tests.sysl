module sh.sysl.benchtop
@tests

import sh.sysl.benchtop.riscv.{MODELS as RISCV_MODELS, implemented}
import sh.sysl.parsing.source_of

@test("RISC-V ISA profiles are named cores in mcu configurations and round-trip through the shared checker")
riscv_core_descriptions()
    for model in RISCV_MODELS
        val src = source_of("riscv.hocon", s"mcu { name = test, cores = [${model.name}, { core = ${model.name} }] }")
        val got = load(src, library())
        assert(!got.report.has_errors(), got.report.render(src))
        assert(library().core(model.name).unwrap().summary.contains(model.isa))
        val text = description_text(got.description)
        val again = load(source_of("again.hocon", text), library())
        assert(!again.report.has_errors() && description_text(again.description) == text)
        for core in got.description.chip.cores
            assert(unemulated_core_option(core).is_none() == implemented(model))

@test("RISC-V core configurations reject Arm-only options without panicking")
riscv_arm_options()
    for option in ["fpu = sp", "nvic-priority-bits = 4", "dsp = true", "security = trustzone"]
        val src = source_of("riscv.hocon", s"mcu { name = test, cores = [{ core = rv32imc, $option }] }")
        val got = load(src, library())
        assert(got.report.has_errors())
        assert(got.report.render(src).contains("has no option"))

@test("RISC-V chips do not reserve the Cortex-M private peripheral bus; mixed chips still do")
riscv_bus_space()
    for cores in ["rv32i", "rv32imc", "hazard3", "cortex-m33", "rv32i, cortex-m33"]
        val src = source_of("memory.hocon", s"mcu { name = t, cores = [$cores], peripherals { ram { peripheral = ram, at = 0xE0000000, size = 4K } } }")
        val got = load(src, library())
        assert(got.report.has_errors() == cores.contains("cortex"), cores)

@test("Hazard3 descriptions accept RP2350 interrupt numbers while bare ISA profiles declare no controller")
riscv_irq_limits()
    for irq in [0, 51, 52]
        val src = source_of("irq.hocon", s"mcu { name = t, cores = [hazard3, hazard3], peripherals { c { peripheral = debug-console, at = 0x40000000, irq = $irq } } }")
        val got = load(src, library())
        assert(got.report.has_errors() == (irq == 52))
    val src = source_of("no-irq.hocon", "mcu { name = t, cores = [rv32i], peripherals { c { peripheral = debug-console, at = 0x40000000, irq = 0 } } }")
    assert(load(src, library()).report.has_errors())
