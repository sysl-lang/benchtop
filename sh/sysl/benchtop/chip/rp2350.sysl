// The RP2350 as its cores see it, whichever cores they are (DESIGN.md §9): the devices on the bus at
// the addresses `sh.sysl.rp2350` generates from the SVD, one clock tree, and the interrupt lines each
// raises in a core. It knows a core only as a `Processor`: which core made an access (the SIO's view
// and CPUID), and the interrupt inputs `signal` drives. A board puts the chip's memory and cores
// around it (`RiscvBoard`).
//
// **Time is clk_sys cycles** (`now`). `advance` turns them into clk_ref cycles, which TICKS divides
// into the 1 µs ticks TIMER0, TIMER1 and MTIME count, and into the crystal's own cycles while XOSC
// starts. Each frequency is the clock tree's: clk_ref and clk_sys follow CLOCKS, XOSC and the PLLs.
//
// **The boot ROM is the boards'** (bootrom.sysl): each maps Raspberry Pi's ROM image at address 0 and
// runs its cores in it, so core 1's wait for a launch is the ROM's own code on the SIO FIFOs. The chip
// tells the board when PSM holds core 1 in reset and when it lets it go (`take_core1_reset`,
// `take_core1_release`); an access that reaches the chip at the ROM's addresses is refused by name.
//
// **POWMAN powers the switched core down and up** (`power_down`, `take_power_up`): down, every block
// but POWMAN is at power-on and only POWMAN advances, its power-up requests seeing the pads through their
// isolation latches; a request powers it up again, for the board to boot.

/** The Pico 2's crystal. */
const XOSC_HZ: u64 = 12000000
/** The ring oscillator's nominal frequency, which clk_ref runs from at power-on. */
const ROSC_HZ: u64 = 11000000
/** The low-power oscillator. */
const LPOSC_HZ: u64 = 32768

// Interrupt numbers (datasheet, "Interrupts"; the SDK's `intctrl.h`).
const TIMER0_IRQ_0: u32 = 0
const TIMER1_IRQ_0: u32 = 4
const SIO_IRQ_FIFO: u32 = 25
const SIO_IRQ_BELL: u32 = 26
const POWMAN_IRQ_POW: u32 = 44
const POWMAN_IRQ_TIMER: u32 = 45
const SPI0_IRQ: u32 = 31
const SPI1_IRQ: u32 = 32
const UART0_IRQ: u32 = 33
const UART1_IRQ: u32 = 34
const USBCTRL_IRQ: u32 = 14
const DMA_IRQ_0: u32 = 10
// PIO0's IRQ_0 and IRQ_1, then PIO1's and PIO2's.
const PIO0_IRQ_0: u32 = 15
// FUNCSEL for PIO0; PIO1 and PIO2 follow.
private const PIO_FUNCSEL: u32 = 6

/** A level a PIO block gave a GPIO: the clk_sys cycle at whose end it took effect. */
struct PinEdge
    cycle: u64
    gpio: u32
    level: bool

// The clk_sys cycle, from `start`, on which `units` quarter clk_peri cycles have passed, `rest` being the
// remainder carried into the first (`advance_lines`).
private line_time(start: u64, units: u64, rest: u64, peri: u64, sys: u64) -> u64
    val need = u128(units) * u128(sys) / u128(UART_UNITS_PER_CYCLE)
    if need <= u128(rest) then return start
    start + u64((need - u128(rest) + u128(peri) - 1) / u128(peri))

const ADC_IRQ_FIFO: u32 = 35
const I2C0_IRQ: u32 = 36
const TRNG_IRQ: u32 = 39
/** The SHA-256 core's DMA request (`DREQ_SHA256`). */
const DREQ_SHA256: u32 = 54
// Every line a device here drives: `signal` drives each one, high or low, into a hart's level inputs.
private const WIRED_LINES: u64 = 0xFFu64 << TIMER0_IRQ_0 | 0xFu64 << DMA_IRQ_0 | 1u64 << USBCTRL_IRQ | 1u64 << rp.IO_IRQ_BANK0 |
    1u64 << SIO_IRQ_FIFO | 1u64 << SIO_IRQ_BELL | 1u64 << UART0_IRQ | 1u64 << UART1_IRQ | 1u64 << POWMAN_IRQ_POW | 1u64 << POWMAN_IRQ_TIMER |
    1u64 << SPI0_IRQ | 1u64 << SPI1_IRQ | 1u64 << TRNG_IRQ | 3u64 << PWM_IRQ_WRAP_0 | 1u64 << ADC_IRQ_FIFO | 3u64 << I2C0_IRQ |
    0x3Fu64 << PIO0_IRQ_0

/** A GPIO with no wire (`Rp2350.wire`). */
const NO_WIRE: u8 = 0xFF

// Each APB device's window: its registers and their XOR, SET and CLR aliases.
private const WINDOW: u32 = 0x4000

/** The devices on the chip's bus. */
enum Block
    Resets = 0
    Clocks
    Xosc
    PllSys
    PllUsb
    Ticks
    Timer0
    Timer1
    Watchdog
    IoBank0
    PadsBank0
    Uart0
    Uart1
    I2c0
    I2c1
    Pio0
    Pio1
    Pio2
    HstxCtrl
    HstxFifo
    Sio
    BootRam
    UsbCtrl
    UsbDpram
    Psm
    Rosc
    SysInfo
    SysCfg
    BusCtrlBlock
    TbMan
    GlitchBlock
    Powman
    AccessCtrl
    XipCtrl
    QmiBlock
    XipAux
    IoQspiBlock
    PadsQspi
    OtpData
    OtpDataRaw
    OtpDataGuarded
    OtpDataRawGuarded
    OtpBlock
    DmaBlock
    TrngBlock
    ShaBlock
    PwmBlock
    Spi0
    Spi1
    AdcBlock

/** A block, its base address, its name in a refusal, and the RESETS bit holding it (0 for none). */
struct Placed
    block: Block
    base: u32
    name: string
    reset: u32

/** Every block the chip runs, with the SVD's base addresses. */
val BLOCKS: [50]Placed = [
    Placed(Block.Resets, resets_reg.BASE, "RESETS", 0),
    Placed(Block.Clocks, clocks_reg.BASE, "CLOCKS", 0),
    Placed(Block.Xosc, xosc_reg.BASE, "XOSC", 0),
    Placed(Block.PllSys, pll_sys_reg.BASE, "PLL_SYS", resets_reg.RESET_PLL_SYS_MASK),
    Placed(Block.PllUsb, pll_usb_reg.BASE, "PLL_USB", resets_reg.RESET_PLL_USB_MASK),
    Placed(Block.Ticks, ticks_reg.BASE, "TICKS", 0),
    Placed(Block.Timer0, timer0_reg.BASE, "TIMER0", resets_reg.RESET_TIMER0_MASK),
    Placed(Block.Timer1, timer1_reg.BASE, "TIMER1", resets_reg.RESET_TIMER1_MASK),
    Placed(Block.Watchdog, watchdog_reg.BASE, "WATCHDOG", 0),
    Placed(Block.IoBank0, io_reg.BASE, "IO_BANK0", resets_reg.RESET_IO_BANK0_MASK),
    Placed(Block.PadsBank0, pads_reg.BASE, "PADS_BANK0", resets_reg.RESET_PADS_BANK0_MASK),
    Placed(Block.Uart0, uart0_reg.BASE, "UART0", resets_reg.RESET_UART0_MASK),
    Placed(Block.Uart1, uart1_reg.BASE, "UART1", resets_reg.RESET_UART1_MASK),
    Placed(Block.Spi0, spi0_reg.BASE, "SPI0", resets_reg.RESET_SPI0_MASK),
    Placed(Block.Spi1, spi1_reg.BASE, "SPI1", resets_reg.RESET_SPI1_MASK),
    Placed(Block.Sio, sio_reg.BASE, "SIO", 0),
    Placed(Block.BootRam, bootram_reg.BASE, "BOOTRAM", 0),
    // Not gated by RESETS: the SDK reads SIE_CTRL before it releases USBCTRL
    // (`runtime_init_usb_power_down`), and benchtop answers it as the block's power-on state. RESETS
    // asserting USBCTRL's bit resets the controller (`reset_blocks`). Its DPRAM is on the AHB, with no
    // atomic aliases.
    Placed(Block.UsbCtrl, usb_reg.BASE, "USBCTRL", 0),
    Placed(Block.UsbDpram, usb_dpram_reg.BASE, "USBCTRL_DPRAM", 0),
    Placed(Block.Psm, psm_reg.BASE, "PSM", 0),
    Placed(Block.Rosc, rosc_reg.BASE, "ROSC", 0),
    Placed(Block.SysInfo, sysinfo_reg.BASE, "SYSINFO", 0),
    Placed(Block.SysCfg, syscfg_reg.BASE, "SYSCFG", 0),
    Placed(Block.BusCtrlBlock, busctrl_reg.BASE, "BUSCTRL", 0),
    Placed(Block.TbMan, tbman_reg.BASE, "TBMAN", 0),
    Placed(Block.GlitchBlock, glitch_reg.BASE, "GLITCH_DETECTOR", 0),
    Placed(Block.Powman, powman_reg.BASE, "POWMAN", 0),
    Placed(Block.AccessCtrl, accessctrl_reg.BASE, "ACCESSCTRL", 0),
    // XIP_CTRL and the QMI have no RESETS bit; XIP_AUX is on the AHB, with no atomic aliases.
    Placed(Block.XipCtrl, xip_ctrl_reg.BASE, "XIP_CTRL", 0),
    Placed(Block.QmiBlock, qmi_reg.BASE, "QMI", 0),
    Placed(Block.XipAux, xip_aux_reg.BASE, "XIP_AUX", 0),
    Placed(Block.IoQspiBlock, io_qspi_reg.BASE, "IO_QSPI", resets_reg.RESET_IO_QSPI_MASK),
    Placed(Block.PadsQspi, pads_qspi_reg.BASE, "PADS_QSPI", resets_reg.RESET_PADS_QSPI_MASK),
    // The OTP's read windows, on no RESETS bit; no atomic aliases.
    Placed(Block.OtpData, OTP_DATA_BASE, "OTP_DATA", 0),
    Placed(Block.OtpDataRaw, OTP_DATA_BASE + 0x4000, "OTP_DATA_RAW", 0),
    Placed(Block.OtpDataGuarded, OTP_DATA_BASE + 0x8000, "OTP_DATA_GUARDED", 0),
    Placed(Block.OtpDataRawGuarded, OTP_DATA_BASE + 0xC000, "OTP_DATA_RAW_GUARDED", 0),
    // The OTP block's registers, with their atomic aliases; on no RESETS bit.
    Placed(Block.OtpBlock, otp_reg.BASE, "OTP", 0),
    Placed(Block.I2c0, i2c0_reg.BASE, "I2C0", resets_reg.RESET_I2C0_MASK),
    Placed(Block.I2c1, i2c1_reg.BASE, "I2C1", resets_reg.RESET_I2C1_MASK),
    // On the AHB, with its atomic aliases (the SDK sets INTE bits with `hw_set_bits`).
    Placed(Block.DmaBlock, dma_reg.BASE, "DMA", resets_reg.RESET_DMA_MASK),
    // The TRNG and the SHA-256 core, on the APB with the atomic aliases.
    Placed(Block.TrngBlock, trng_reg.BASE, "TRNG", resets_reg.RESET_TRNG_MASK),
    Placed(Block.ShaBlock, sha256_reg.BASE, "SHA256", resets_reg.RESET_SHA256_MASK),
    Placed(Block.PwmBlock, pwm_reg.BASE, "PWM", resets_reg.RESET_PWM_MASK),
    Placed(Block.AdcBlock, adc_reg.BASE, "ADC", resets_reg.RESET_ADC_MASK),
    Placed(Block.HstxCtrl, hstx_ctrl_reg.BASE, "HSTX_CTRL", resets_reg.RESET_HSTX_MASK),
    Placed(Block.HstxFifo, hstx_fifo_reg.BASE, "HSTX_FIFO", resets_reg.RESET_HSTX_MASK),
    // The PIO blocks, on the AHB with the atomic aliases. Last, so the blocks a running program polls
    // are found without passing them (`block_at` walks the table).
    Placed(Block.Pio0, pio0_reg.BASE, "PIO0", resets_reg.RESET_PIO0_MASK),
    Placed(Block.Pio1, pio1_reg.BASE, "PIO1", resets_reg.RESET_PIO1_MASK),
    Placed(Block.Pio2, pio2_reg.BASE, "PIO2", resets_reg.RESET_PIO2_MASK),
]

/** OTP_DATA_BASE (`hardware/regs/addressmap.h`); the raw, guarded and raw guarded windows follow it
 * 16 KB apart.
 */
const OTP_DATA_BASE: u32 = 0x40130000

/** The block whose window holds `a`, with the offset into it. */
block_at(a: u32) -> Option[(Placed, u32)]
    for p in BLOCKS do if a >= p.base && a - p.base < WINDOW then return Some((p, a - p.base))
    None

struct Rp2350
    resets: Resets
    clocks: Clocks
    xosc: Xosc
    pll_sys: Pll
    pll_usb: Pll
    ticks: Ticks
    timers: [2]Timer
    watchdog: Watchdog
    sio: Sio
    io: IoBank0
    pads: Pads
    uarts: [2]Uart
    pio: Pio
    bootram: BootRam
    usb: UsbCtrl
    psm: Psm
    rosc: Rosc
    sysinfo: SysInfo
    syscfg: SysCfg
    busctrl: BusCtrl
    glitch: GlitchDetector
    powman: Powman
    accessctrl: AccessCtrl
    io_qspi: IoQspi
    pads_qspi: QspiPads
    xip: Xip
    qmi: Qmi
    // The flash on QSPI chip select 0, the board's part, whose array the board connects.
    flash: QspiFlash
    // The OTP: the board's array, as the part's flash is, and the OTP block's registers.
    otp: Otp
    // The TRNG and the SHA-256 core, and the clk_sys cycles into the DMA's present run that the transfer
    // being made falls at (`dma_run`), which a device with its own busy time stamps its writes with.
    trng: Trng
    sha: Sha256
    dma_t: u64
    // Something a board mirrors in its memory map has changed: the flash's contents, direct mode, or
    // which XIP_SRAM lines are pinned (`take_xip_changed`).
    xip_changed: bool
    rcp: Rcp
    dcp: Dcp
    // Core 1 has been put in reset by PSM since the board last asked (`take_core1_reset`), or taken
    // out of it (`take_core1_release`).
    core1_reset: bool
    core1_release: bool
    // The PSM stages the watchdog's resets have taken down since the board last asked (`take_restart`).
    restart: Option[u32]
    // clk_sys cycles since power-on, and the remainders carried into the next clk_ref, crystal and
    // ring-oscillator cycle.
    now: u64
    ref_rest: u64
    xosc_rest: u64
    rosc_rest: u64
    // Whether POWMAN has powered the switched core down (`power_down`), and the state it has powered it
    // up to since the board last asked (`take_power_up`).
    swcore_off: bool
    woke: Option[u32]
    // What drives each GPIO from off the chip, bit n for GPIO n: whether something does, and the level
    // (`drive_from_outside`).
    outside_driven: u64
    outside_level: u64
    // What the pads' isolation latches hold while the switched core is down, as each pad was at the
    // power-down: whether it drove, its level, and whether its input was enabled.
    held_driven: u64
    held_level: u64
    held_ie: u64
    // The clk_sys cycles' remainder carried into the next clk_peri cycle, counted while a UART's line is
    // busy (`advance_lines`).
    peri_rest: u64
    // The wires between GPIOs on the workbench (`wire`): the GPIO each is wired to, NO_WIRE for none.
    wires: [GPIO_COUNT]u8
    // Why the UARTs' lines did something benchtop does not model while time passed, for the board to
    // stop on (`take_line_fault`); empty for nothing.
    line_fault: string
    // The DMA's registers and channels (dma.sysl moves their data), and the board's memory as the DMA
    // reaches it (`connect_memory`).
    dma: Dma
    memory: Option[*DmaMemory]
    // The PWM block (pwm.sysl runs it): a GPIO interrupt watches a pin it drives, and whether that or a
    // slice counting from its B pin makes the chip walk its edges.
    pwm: Pwm
    pwm_watched: bool
    pwm_stepping: bool
    // The two SPIs, and the clock they share while one is busy (`advance_spi`).
    spi: Spis
    // The ADC (adc.sysl gives it time), the clk_sys remainder it carries, and what the board puts on its
    // inputs.
    adc: Adc
    adc_rest: u64
    analog: AnalogIn
    // I2C0 and I2C1, with the I2C parts on the workbench (chip/i2c.sysl).
    i2c: I2cBus
    // HSTX, the part of a clk_hstx cycle still owed it, and what watches its outputs (`connect_hstx`).
    hstx: Hstx
    hstx_rest: u64
    hstx_sink: Option[*HstxSink]
    // What has happened on the GPIOs `capture_edges` asks after: which those are, the level
    // each last had, and each change.
    edge_mask: u64
    edge_levels: u64
    pin_edges: Buf[PinEdge]

    /** Power-on, with core 1 in the boot ROM; the flash keeps its array, as the board's part, the
     * board's memory stays connected, and the wires and I2C parts stay on the workbench.
     */
    reset(*self)
        val bytes = self.flash.bytes
        val size = self.flash.size
        val wires = self.wires
        val array = self.otp
        val memory = self.memory
        val analog = self.analog
        val parts = self.i2c.parts
        val sink = self.hstx_sink
        // The logic analyser on the pins, like the wires, is the board's: it goes on recording.
        val mask = self.edge_mask
        val edges = self.pin_edges
        val fresh = rp2350()
        *self = fresh
        if size != 0 then self.flash.connect(bytes, size)
        self.otp.power_on(array)
        self.wires = wires
        self.memory = memory
        self.analog = analog
        self.i2c.parts = parts
        self.hstx_sink = sink
        self.pin_edges = edges
        self.capture_edges(mask)

    /** What is wired to the HSTX outputs: told of each clk_hstx cycle they shift. */
    connect_hstx(*self, s: *HstxSink) = self.hstx_sink = Some(s)

    /** Whether the flash's contents, direct mode or the pinned XIP_SRAM lines have changed since the last
     * call, for a board that mirrors them.
     */
    take_xip_changed(*self) -> bool
        val was = self.xip_changed
        self.xip_changed = false
        was

    /** What each clock source runs at now; the PLLs take the crystal as their reference. */
    sources(*self) -> Sources
        val xosc = if self.xosc.stable() then XOSC_HZ else 0
        Sources(self.rosc.hz(ROSC_HZ), xosc, LPOSC_HZ, self.pll_sys.hz(xosc), self.pll_usb.hz(xosc))

    sys_hz(*self) -> u64 = self.clocks.sys_hz(self.sources())
    ref_hz(*self) -> u64 = self.clocks.ref_hz(self.sources())

    /** `cycles` of clk_sys pass: every clock the devices count advances with them, and a busy DMA makes
     * its transfers (`advance_with_dma`).
     */
    advance(*self, cycles: u64)
        if self.dma.busy != 0 && !self.swcore_off && cycles != 0 && self.sys_hz() != 0 then self.advance_with_dma(cycles) else self.advance_devices(cycles)

    // `cycles` of clk_sys pass on every device but the DMA.
    private[chip] advance_devices(*self, cycles: u64)
        if cycles == 0 then return
        val sys = self.sys_hz()
        self.now += cycles
        if sys == 0 then return
        if self.swcore_off
            // Only the always-on domain runs: POWMAN's timer from the LPOSC, and its power-up requests.
            self.powman.advance(cycles, sys, LPOSC_HZ, 0, false)
            self.powman.sample(self.pwrup_levels())
            if self.powman.wake_due() then self.power_up()
            return
        self.ref_rest += cycles * self.ref_hz()
        val ref_cycles = self.ref_rest / sys
        self.ref_rest %= sys
        if self.xosc.on
            self.xosc_rest += cycles * XOSC_HZ
            self.xosc.advance(self.xosc_rest / sys)
            self.xosc_rest %= sys
        if self.rosc.running()
            self.rosc_rest += cycles * ROSC_HZ
            self.rosc.advance(self.rosc_rest / sys)
            self.rosc_rest %= sys
        val made = self.ticks.advance(ref_cycles)
        for i in 0..<2
            val t = &self.timers[i]
            t.advance(if t.clk_sys then cycles else made[usize(Tick.Timer0) + i])
        self.sio.advance_mtime(if self.sio.mtime_full_speed() then cycles else made[usize(Tick.Riscv)])
        if self.powman.counting()
            val level = self.powman.reference_gpio() match
                Some(n) -> self.pin(n).input
                None -> false
            self.powman.advance(cycles, sys, LPOSC_HZ, self.crystal_hz(), level)
        if self.powman.watching() then self.powman.sample(self.pwrup_levels())
        // No debugger halts a core or drives JTAG, so no PAUSE applies.
        self.watchdog.advance(made[usize(Tick.Watchdog)], 0)
        self.watchdog_reset()
        // The UARTs count only while their lines are busy, so an idle UART costs nothing here.
        if self.uarts[0].active() || self.uarts[1].active() then self.advance_lines(cycles, sys)
        if self.pwm.enabled != 0 then self.advance_pwm(cycles)
        // Likewise the SPIs, whose clock counts only while a transfer or a receive timeout is pending.
        if self.spi.live() then self.spi.pass(self, cycles, sys, self.clocks.peri_hz(self.sources()))
        if self.adc.active() then self.advance_adc(cycles, sys)
        // The I2C buses only where a step ends: a master's bus otherwise costs a comparison.
        if self.i2c.next_due() <= self.now then self.i2c_steps()
        if self.hstx.enabled() then self.hstx_pass(cycles, sys)
    end advance_devices

    // `cycles` of clk_sys at `sys` Hz pass on HSTX, as clk_hstx's cycles. A GPIO interrupt on a pin HSTX
    // drives would have to sample at HSTX's own rate, which is refused by name.
    private hstx_pass(*self, cycles: u64, sys: u64)
        val hz = self.clocks.hstx_hz(self.sources())
        if hz == 0 then return
        val total = u128(self.hstx_rest) + u128(cycles) * u128(hz)
        self.hstx_rest = u64(total % u128(sys))
        self.hstx.pass(u64(total / u128(sys)), self.hstx_sink)
        if !self.line_fault.is_empty() then return
        if !self.hstx.fault.is_empty()
            self.line_fault = self.hstx.fault
            self.hstx.fault = ""
            return
        for n in 12u32..<20
            if self.io.irq.watched(n) && rp.route(n, self.io.function(n)) == rp.Route.Hstx
                self.line_fault = s"a GPIO interrupt on GPIO $n, which HSTX drives, is not modelled"
                return

    // `cycles` of clk_sys at `sys` Hz pass on the UARTs' lines, as clk_peri's cycles, event by event: each
    // frame that ends is carried over the wires from the GPIOs its TX drives (`deliver`), and a frame
    // that starts is checked against what watches its pins (`check_frame`).
    private advance_lines(*self, cycles: u64, sys: u64)
        val peri = self.clocks.peri_hz(self.sources())
        if peri == 0 then return
        val rest = self.peri_rest
        // A device access every few cycles (a core polling UARTFR) comes here each time: 64-bit
        // arithmetic wherever the product fits, which is all but a sleep of hours.
        var left: u64 = 0
        if cycles <= 0xFFFFFFFF && peri <= 0xFFFFFFFF
            val total = self.peri_rest + cycles * peri
            left = total / sys * UART_UNITS_PER_CYCLE
            self.peri_rest = total % sys
        else
            val total = u128(self.peri_rest) + u128(cycles) * u128(peri)
            left = u64(total / u128(sys)) * UART_UNITS_PER_CYCLE
            self.peri_rest = u64(total % u128(sys))
        // Most steps end before any event: the counts go down and nothing else happens. A PIO block
        // reads the lines' levels, so while one listens each bit is an event too.
        val listening = self.pio.listening
        if !listening && left < self.uarts[0].until_event() && left < self.uarts[1].until_event()
            self.uarts[0].pass(left)
            self.uarts[1].pass(left)
            return
        val start = self.now - cycles
        var used: u64 = 0
        while left > 0
            var step = min(left, min(self.uarts[0].until_event(), self.uarts[1].until_event()))
            var edge = start
            if listening
                step = min(step, min(self.uarts[0].until_bit(), self.uarts[1].until_bit()))
                edge = line_time(start, used + step, rest, peri, sys)
                // The blocks run with the old level up to the cycle before the new one.
                if edge > start && self.pio.running then self.pio_run_to(edge - 1)
            used += step
            // Both lines move through the step before either frame is delivered: a character arriving at
            // its end starts the receiver's timeout there, not a step earlier.
            val sent = [self.uarts[0].pass(step), self.uarts[1].pass(step)]
            if listening then self.pio.drive(if edge > start then edge - 1 else start, self.inputs_now())
            for k in 0..<2
                sent[k] match
                    Some(s) -> self.deliver(k, s)
                    None -> ()
                if self.uarts[k].take_started()
                    self.check_frame(k) match
                        Some(why) -> if self.line_fault.is_empty() then self.line_fault = why
                        None -> ()
            left -= step
            if !self.uarts[0].active() && !self.uarts[1].active() then break
    end advance_lines

    // The clk_sys cycles until a UART's line next does something (`Uart.until_event`); None while both
    // are idle or clk_peri is stopped.
    private[chip] line_due(*self) -> Option[u64]
        earliest(self.uart_due(), self.spi.due(self.sys_hz(), self.clocks.peri_hz(self.sources())))

    // The clk_sys cycles until a UART's line next does something.
    private uart_due(*self) -> Option[u64]
        if !self.uarts[0].active() && !self.uarts[1].active() then return None
        val peri = self.clocks.peri_hz(self.sources())
        val sys = self.sys_hz()
        if peri == 0 || sys == 0 then return None
        val units = min(self.uarts[0].until_event(), self.uarts[1].until_event())
        val peri_cycles = (units + UART_UNITS_PER_CYCLE - 1) / UART_UNITS_PER_CYCLE
        // The first c with (peri_rest + c × peri) / sys reaching peri_cycles.
        val need = u128(peri_cycles) * u128(sys) - u128(self.peri_rest)
        Some(u64((need + u128(peri) - 1) / u128(peri)))

    /** The clk_sys cycles until UART `k`'s transmitter has sent everything it will send, or until the DMA
     * gives it more (a busy channel paced by its TX request); None where it sends nothing more, or cannot
     * (clk_peri stopped).
     */
    sending_due(*self, k: usize) -> Option[u64]
        if self.uarts[k].sending() then return self.uart_due()
        if self.dma.busy != 0 && self.dma_feeds(k) && self.uarts[k].dreq_tx() then return Some(1)
        None

    // UART `k` has finished sending `s`: from each GPIO its TX drives, over that GPIO's wire, to the UART
    // whose RX is at the other end.
    private deliver(*self, k: usize, s: Sent)
        for g in 0u32..<GPIO_COUNT
            val h = self.wires[g]
            if h == NO_WIRE || rp.route(g, self.io.function(g)) != rp.Route.UartTx || uart_of(g) != k then continue
            if !self.pads.pin(g, self.drive(g), None).drives then continue
            val why = self.hear(u32(h), s)
            if !why.is_empty() && self.line_fault.is_empty() then self.line_fault = s"UART$k's TX on GPIO $g, wired to GPIO $h: $why"

    // A frame `s` arrives over a wire at GPIO `n`: the UART whose RX is there receives it; empty, or why
    // benchtop does not model what happens.
    private hear(*self, n: u32, s: Sent) -> string
        if rp.route(n, self.io.function(n)) != rp.Route.UartRx then return ""
        val j = uart_of(n)
        val why = self.rx_refusal(n)
        if !why.is_empty() then return why
        if !self.uarts[j].hears(s) then return s"UART$j's RX there reads at divisor ${self.uarts[j].latched_divisor()} and LCR_H 0x${hex(self.uarts[j].lcr_h)}, the frame was sent at divisor ${s.divisor} and LCR_H 0x${hex(s.format)}: a frame read at another rate or in another shape is not modelled"
        self.uarts[j].receive(s.frame)
        ""

    // Why a UART RX on GPIO `n` cannot take a frame as benchtop models it: an input override, or a pad
    // that does not read its input (the RX would see a low line, a break).
    private rx_refusal(*self, n: u32) -> string
        if self.io.ctrl[n] & io_reg.GPIO0_CTRL_INOVER_MASK != 0 then return s"GPIO $n's INOVER changes what its UART RX reads, which is not modelled for frames"
        if !self.pads.pin(n, self.drive(n), Some(true)).input then return s"GPIO $n's pad does not read its input (IE clear or isolated), so its UART RX would see a break, which is not modelled"
        ""

    // Why the frame UART `k` has just started cannot be shown as benchtop models it: its TX's pins change
    // level bit by bit, which the GPIO interrupts do not sample, so one watching a pin the frame reaches
    // is refused; an output override on a pin the frame goes over a wire from would change it.
    private check_frame(*self, k: usize) -> Option[string]
        for g in 0u32..<GPIO_COUNT
            if rp.route(g, self.io.function(g)) != rp.Route.UartTx || uart_of(g) != k then continue
            if self.io.irq.watched(g) then return Some(s"UART$k sends a frame on GPIO $g, whose interrupts are enabled: the GPIO interrupts do not sample a frame's bits")
            self.pwm_frame_refusal(k, g) match
                Some(why) -> return Some(why)
                None -> ()
            val h = self.wires[g]
            if h == NO_WIRE then continue
            if self.io.irq.watched(u32(h)) then return Some(s"UART$k sends a frame on GPIO $g to GPIO $h over a wire, and GPIO $h's interrupts are enabled: the GPIO interrupts do not sample a frame's bits")
            if self.io.ctrl[g] & (io_reg.GPIO0_CTRL_OUTOVER_MASK | io_reg.GPIO0_CTRL_OEOVER_MASK) != 0 then return Some(s"UART$k sends a frame over a wire from GPIO $g, whose OUTOVER or OEOVER changes it, which is not modelled for frames")
        None

    /** A frame sent into GPIO `n` from off the chip, for the UART whose RX is there: true once it is on
     * the line, to arrive a frame later at that UART's rate; false while the line still carries the last
     * one. Refused where no UART receives on GPIO `n`, or not as benchtop models it.
     */
    line_in(*self, n: u32, f: Frame) -> Result[bool, string]
        if n >= GPIO_COUNT then return Err(s"there is no GPIO $n")
        if rp.route(n, self.io.function(n)) != rp.Route.UartRx then return Err(s"GPIO $n is not a UART's RX (FUNCSEL ${self.io.function(n)})")
        val j = uart_of(n)
        val why = self.rx_refusal(n)
        if !why.is_empty() then return Err(why)
        val h = self.wires[n]
        if h != NO_WIRE && self.pads.pin(u32(h), self.drive(u32(h)), None).drives then return Err(s"GPIO $n is wired to GPIO $h, which drives it")
        if self.uarts[j].latched_divisor() < 64 then return Err(s"UART$j's latched baud divisor has IBRD 0, which times no frame")
        Ok(self.uarts[j].arrive(f))

    /** A wire between GPIOs `a` and `b` on the workbench, or none from `a` where `b` is None: each pin sees
     * the other's level where the other drives, and a UART frame sent from one reaches a UART RX at the
     * other. A GPIO has one wire.
     */
    wire(*self, a: u32, b: Option[u32])
        if self.pio.running then self.pio_catch_up()
        val was = self.wires[a]
        if was != NO_WIRE then self.wires[usize(was)] = NO_WIRE
        self.wires[a] = NO_WIRE
        b match
            Some(other) ->
                val prior = self.wires[other]
                if prior != NO_WIRE then self.wires[usize(prior)] = NO_WIRE
                self.wires[a] = u8(other)
                self.wires[other] = u8(a)
            None -> ()
        if !self.swcore_off then self.gpio_changed()

    /** Why the UARTs' lines, the I2C buses, a PIO state machine, or the DMA's transfers stopped being
     * modelled since the last call, if they did.
     */
    take_line_fault(*self) -> Option[string]
        if !self.dma.fault.is_empty()
            val why = self.dma.fault
            self.dma.fault = ""
            return Some(why)
        if !self.i2c.fault.is_empty()
            val why = self.i2c.fault
            self.i2c.fault = ""
            return Some(why)
        if self.pio.running then self.pio_catch_up()
        if self.line_fault.is_empty() then return None
        Some(self.next_line_fault())

    // The fault waiting, taken; a PIO fault that came while it waited is the next one. Out of line, so
    // the board's check each quantum stays two tests.
    private next_line_fault(*self) -> string
        val why = self.line_fault
        self.line_fault = ""
        self.pio.take_fault() match
            Some(w) -> self.line_fault = w
            None -> ()
        why

    // The PIO blocks ACCESSCTRL lets Non-secure code reach (NSP or NSU), bit k for PIO k: two that
    // differ are disconnected from each other's PREV and NEXT.
    private pio_ns(*self) -> u32
        var bits: u32 = 0
        for k in 0u32..<3
            val i = (accessctrl_reg.PIO0_OFFSET - accessctrl_reg.ROM_OFFSET) / 4 + k
            if self.accessctrl.devices[i] & 3 != 0 then bits |= 1 << k
        bits

    /** The levels on GPIO 0–47 as the PIO blocks read them, from the end of this cycle, whatever the pads
     * say, until a GPIO next changes: a test's way to exercise the state machines by themselves.
     */
    pio_drive(*self, levels: u64)
        self.pio_catch_up()
        self.pio.listening = true
        self.pio.drive(self.now, levels)

    /** PIO block `k`'s pins in its own numbering (GPIOBASE moves them): levels, and output enables. */
    pio_pins(*self, k: u32) -> (u32, u32)
        self.pio_catch_up()
        self.pio.pins(k)

    // The PIO blocks run to `now`. Nothing outside them sees their state but through the bus, these
    // hooks, the interrupt lines (`signal`) and the faults the board collects each quantum, so they run
    // only then, and `advance` pays nothing for them; `pio_due` wakes a sleeping board where something
    // could see them. A state machine stopped on something benchtop does not model joins the lines'
    // faults at once.
    private[chip] pio_catch_up(*self)
        if !self.pio.running || self.swcore_off then return
        self.pio_run_to(self.now)
        if self.line_fault.is_empty()
            self.pio.take_fault() match
                Some(why) -> self.line_fault = why
                None -> ()

    // The blocks run to cycle `t`, each pin they move carried to what reads it on the cycle it moved. Out
    // of line, so that `take_line_fault`, which the board calls each quantum, stays small enough to inline.
    @noinline
    private pio_run_to(*self, t: u64)
        loop
            self.pio.advance_to(t)
            if !self.pio.pins_moved then break
            self.pio.pins_moved = false
            self.pio_pins_moved()

    // A block has moved pins at the end of cycle `moved_at`. One the mux gives to it changes what the
    // GPIO interrupts see and what the blocks themselves read; the rest reach nothing.
    private pio_pins_moved(*self)
        var reaches = false
        for b in 0u32..<3
            var bits = self.pio.moved[b]
            self.pio.moved[b] = 0
            while bits != 0
                val g = bits.trailing_zeros() + self.pio.blocks[b].gpiobase
                bits &= bits - 1
                if g >= GPIO_COUNT || self.io.function(g) != PIO_FUNCSEL + b then continue
                reaches = true
                if self.powman_reads(g) && self.line_fault.is_empty() then self.line_fault = s"PIO$b drives GPIO $g, which POWMAN watches: POWMAN samples its GPIOs as time passes, and a level from a PIO block between catch-ups is not modelled"
                val h = self.wires[g]
                if h == NO_WIRE || rp.route(u32(h), self.io.function(u32(h))) != rp.Route.UartRx || !self.pads.pin(g, self.drive(g), None).drives then continue
                if self.line_fault.is_empty() then self.line_fault = s"PIO$b drives GPIO $g, wired to GPIO $h, a UART's RX: a UART receives whole frames from another UART, and a level from a PIO block is not modelled"
        if !reaches then return
        self.record_edges(self.pio.moved_at)
        self.gpio_sample()
        self.pio.drive(self.pio.moved_at, self.inputs_now())

    // Whether POWMAN reads GPIO `g`: its timer's reference, or a power-up request.
    private powman_reads(*self, g: u32) -> bool
        if self.powman.counting() && self.powman.reference_gpio() == Some(g) then return true
        if !self.powman.watching() then return false
        for k in 0..<4 do if self.powman.pwrup_gpio(k) == Some(g) then return true
        false

    // PIO block `k`'s drive on GPIO `n`, which GPIOBASE may leave outside its 32 pins.
    private pio_output(*self, k: u32, n: u32) -> Drive
        val b = &self.pio.blocks[k]
        if n < b.gpiobase || n - b.gpiobase >= 32 then return Drive(false, false)
        val bit = 1u32 << (n - b.gpiobase)
        Drive(b.pad_out & bit != 0, b.pad_oe & bit != 0)

    /** Record each level the GPIOs of `mask` (bit n for GPIO n) take from now on, with the cycle at whose
     * end it changed: a logic analyser on the pins (`pin_edges`). It sees what a PIO block gives a pin and
     * what changes it through the mux, the pads, the SIO or from outside; a UART's frames between those
     * are not recorded. The record is current to
     * the blocks' last catch-up, which any look at the chip makes (`take_line_fault`, each board quantum).
     */
    capture_edges(*self, mask: u64)
        self.pio_catch_up()
        self.edge_mask = mask
        self.edge_levels = 0
        for n in 0..<GPIO_COUNT do if self.pin(n).level then self.edge_levels |= 1u64 << n

    private record_edges(*self, w: u64)
        var bits = self.edge_mask
        while bits != 0
            val n = u32(bits.trailing_zeros())
            bits &= bits - 1
            val bit = 1u64 << n
            val level = self.pin(n).level
            if level == (self.edge_levels & bit != 0) then continue
            self.edge_levels ^= bit
            self.pin_edges.push(PinEdge(w, n, level))

    // Something outside the block may see the pins of a sleeping board: an enabled interrupt line, a DMA
    // channel waiting on a FIFO, a GPIO interrupt or power-up request on a pin a block drives.
    private pio_watched(*self) -> bool
        if self.pio.irq_armed && self.pio.irq_enabled() then return true
        if self.dma.busy != 0 && self.dma_on_pio() then return true
        if self.powman.watching() then return true
        for g in 0u32..<GPIO_COUNT
            val f = self.io.function(g)
            if f < PIO_FUNCSEL || f > PIO_FUNCSEL + 2 then continue
            if self.io.irq.watched(g) then return true
            val h = self.wires[g]
            if h != NO_WIRE && self.io.irq.watched(u32(h)) then return true
        false

    // The clk_sys cycles until a state machine next acts, where something is watching: a free-running
    // block nobody can see stays lazy, however tight its loop.
    private pio_due(*self) -> Option[u64]
        if !self.pio.running || !self.pio_watched() then return None
        self.pio_catch_up()
        val w = self.pio.next_wake()
        if w == NEVER then return None
        Some(if w > self.now then w - self.now else 1)

    /** DMA request `dreq` as the UARTs drive it (the SDK's `DREQ_UART0_TX` to `DREQ_UART1_RX`); None for
     * a request that is not a UART's.
     */
    uart_dreq(*self, dreq: u32) -> Option[bool]
        if dreq >= DREQ_SPI0_TX && dreq < DREQ_SPI0_TX + 4
            val k = usize((dreq - DREQ_SPI0_TX) / 2)
            return Some(if (dreq - DREQ_SPI0_TX) % 2 == 0 then self.spi.dreq_tx(k) else self.spi.dreq_rx(k))
        if dreq < DREQ_UART0_TX || dreq >= DREQ_UART0_TX + 4 then return None
        val k = usize((dreq - DREQ_UART0_TX) / 2)
        Some(if (dreq - DREQ_UART0_TX) % 2 == 0 then self.uarts[k].dreq_tx() else self.uarts[k].dreq_rx())

    // The crystal's frequency while it runs, else 0.
    private crystal_hz(*self) -> u64 = if self.xosc.stable() then XOSC_HZ else 0

    /** Bring the devices to clk_sys cycle `t`, where they are behind it. */
    catch_up(*self, t: u64) = if t > self.now then self.advance(t - self.now)

    /** The clk_sys cycles until the next device event that could wake a core: an alarm (a TIMER's or the
     * always-on timer's), MTIMECMP, or the watchdog firing, whose reset the board takes. While the
     * switched core is down only the always-on timer's alarm is one; a power-up GPIO changes only when
     * something outside drives it.
     */
    next_event(*self) -> Option[u64]
        var due = self.powman.next_alarm(self.sys_hz(), LPOSC_HZ, self.crystal_hz())
        if self.swcore_off then return due
        self.watchdog.ticks_to_fire(0) match
            Some(n) -> due = earliest(due, self.ticks_to_cycles(Tick.Watchdog, n))
            None -> ()
        for i in 0..<2
            val t = self.timers[i]
            t.next_alarm() match
                Some(n) -> due = earliest(due, if t.clk_sys then Some(n) else self.ticks_to_cycles(if i == 0 then Tick.Timer0 else Tick.Timer1, n))
                None -> ()
        for k in 0u32..<2
            self.sio.mtime_due(k) match
                Some(n) -> due = earliest(due, if self.sio.mtime_full_speed() then Some(n) else self.ticks_to_cycles(Tick.Riscv, n))
                None -> ()
        due = earliest(due, self.trng.due(self.now))
        if self.adc.wakes() then due = earliest(due, self.adc_due())
        due = earliest(earliest(due, self.line_due()), self.dma_due())
        if self.pio.running then due = earliest(due, self.pio_due())
        earliest(earliest(earliest(due, self.pwm_due()), self.i2c_due()), self.hstx_due())

    // The clk_sys cycles until generator `g`'s `n`th tick from now, rounded up; None while it is
    // stopped.
    private ticks_to_cycles(*self, g: Tick, n: u64) -> Option[u64]
        val sys = self.sys_hz()
        val ref_hz = self.ref_hz()
        if ref_hz == 0 then return None
        self.ticks.generator(g).cycles_to(n).map(c ->
            if c == NEVER then NEVER else u64(min(u128(NEVER), (u128(c) * u128(sys) + u128(ref_hz) - 1) / u128(ref_hz))))

    /** A read of `width` bytes at `a` by core `core`: the value, or why the chip refuses it. */
    read(*self, core: u32, a: u32, width: u32) -> Result[u32, string]
        if a >= XIP_BASE && a < XIP_WINDOWS_END then return self.xip_read(a, width)
        val (p, o) = self.placed(a)?
        val got = p.block match
            Resets -> self.resets.read(o, width)
            Clocks -> self.clocks.read(o, width)
            Xosc -> self.xosc.read(o, width)
            PllSys -> self.pll_sys.read(o, width)
            PllUsb -> self.pll_usb.read(o, width)
            Ticks -> self.ticks.read(o, width)
            Timer0 -> self.timers[0].read(o, width)
            Timer1 -> self.timers[1].read(o, width)
            Watchdog -> self.watchdog.read(o, width)
            IoBank0 ->
                if self.pio.running then self.pio_catch_up()
                if self.pwm.enabled != 0 then self.pwm_io_read(p, o)?
                self.io.read(o, width, self.pins(), self.drives())
            PadsBank0 -> self.pads.read(o, width)
            Uart0 -> self.uarts[0].read(o, width)
            Uart1 -> self.uarts[1].read(o, width)
            Spi0 -> self.spi.read(self, 0, o, width)
            Spi1 -> self.spi.read(self, 1, o, width)
            I2c0 | I2c1 -> return self.i2c_read(p, o, width)
            Sio -> self.sio.read(core, o, width, self.inputs())
            BootRam -> self.bootram.read(o, width)
            UsbCtrl ->
                self.usb.unmodelled_read(o) match
                    Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
                    None -> ()
                self.usb.read(o, width)
            UsbDpram -> self.usb.dpram_read(o, width)
            Psm -> self.psm.read(o, width)
            Rosc -> self.rosc.read(o, width)
            TrngBlock -> return self.trng.read(self.now, o, width).map_err(f -> trng_why(f))
            ShaBlock -> return self.sha.read(self.now + self.dma_t, o, width).map_err(f -> sha_why(f))
            SysInfo -> self.sysinfo.read(o, width)
            SysCfg -> self.syscfg.read(o, width)
            BusCtrlBlock -> return self.busctrl.read(o, width).map_err(f -> bus_refusal(p, o, f))
            TbMan -> return rp.tbman_read(o, width).map_err(f -> bus_refusal(p, o, f))
            GlitchBlock -> return self.glitch.read(o, width).map_err(f -> bus_refusal(p, o, f))
            Powman ->
                if self.powman.watching() then self.powman.sample(self.pwrup_levels())
                self.powman.read(o, width)
            AccessCtrl -> self.accessctrl.read(o, width)
            Pio0 | Pio1 | Pio2 ->
                self.pio_catch_up()
                return self.pio.read(pio_index(p.block), self.now, o, width).map_err(f -> pio_refusal(p, o, f))
            IoQspiBlock -> self.io_qspi.read(o, width)
            PadsQspi -> self.pads_qspi.read(o, width)
            OtpData | OtpDataRaw | OtpDataGuarded | OtpDataRawGuarded | OtpBlock -> return self.otp_read(p, o, width)
            XipCtrl -> return self.xip.read(o, width, &self.qmi, &self.flash).map_err(f -> xip_refusal(p, o, f))
            QmiBlock -> return self.qmi.read(o, width, &self.flash).map_err(f -> xip_refusal(p, o, f))
            XipAux -> return xip_aux_read(&self.xip, &self.qmi, &self.flash, o, width).map_err(f -> xip_refusal(p, o, f))
            DmaBlock -> self.dma.read(o, width)
            PwmBlock -> self.pwm.read(o, width)
            AdcBlock -> self.adc.read(o, width)
            HstxCtrl -> self.hstx.read(o, width)
            HstxFifo -> self.hstx.fifo_read(o, width)
        got.map_err(e -> refusal(p, o, e))

    /** A write of `width` bytes at `a` by core `core`, or why the chip refuses it. */
    write(*self, core: u32, a: u32, width: u32, x: u32) -> Result[unit, string]
        if a >= XIP_BASE && a < XIP_WINDOWS_END then return self.xip_write(a)
        val (p, o) = self.placed(a)?
        val got = p.block match
            Resets ->
                if self.pio.running then self.pio_catch_up()
                val before = self.resets.held
                val r = self.resets.write(o, width, x)
                self.reset_blocks(self.resets.held & ~before)
                // Every released block is ready at once.
                self.resets.complete(~self.resets.held)
                if (self.resets.held ^ before) & (resets_reg.RESET_IO_BANK0_MASK | resets_reg.RESET_PADS_BANK0_MASK | resets_reg.RESET_PWM_MASK) != 0 then self.gpio_changed()
                r
            Clocks ->
                val before = self.clocks
                val r = self.clocks.write(o, width, x)
                // Writing FC0_SRC starts frequency counter 0 on the tree as it stands; a source the
                // model cannot count is refused, and FC0_SRC keeps what it had.
                if o & 0xFFC == clocks_reg.FC0_SRC_OFFSET
                    val why = self.clocks.unmodelled_source()
                    if !why.is_empty()
                        val wrote = self.clocks.words[usize(clocks_reg.FC0_SRC_OFFSET / 4)] & clocks_reg.FC0_SRC_FC0_SRC_MASK
                        self.clocks = before
                        return Err(s"CLOCKS FC0_SRC = $wrote is not modelled: $why")
                    self.clocks.measure(self.sources())
                r
            Xosc ->
                if o & 0xFFC == xosc_reg.DORMANT_OFFSET && written(self.xosc.dormant, o, replicated(x, width)) == xosc_reg.DORMANT_DORMANT_DORMANT
                    return Err(s"${p.name} + 0x${hex(o)}: DORMANT, the crystal stopped until a dormant wake, is not modelled (the ROSC's DORMANT is)")
                self.xosc.write(o, width, x)
            PllSys -> self.pll_sys.write(o, width, x)
            PllUsb -> self.pll_usb.write(o, width, x)
            Ticks -> self.ticks.write(o, width, x)
            Timer0 -> self.timers[0].write(o, width, x)
            Timer1 -> self.timers[1].write(o, width, x)
            Watchdog ->
                // TRIGGER resets the chip at once.
                val r = self.watchdog.write(o, width, x)
                self.watchdog_reset()
                r
            IoBank0 ->
                self.io.unmodelled(o, width, x) match
                    Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
                    None -> ()
                if self.pio.running then self.pio_catch_up()
                val r = self.io.write(o, width, x)
                self.gpio_changed()
                r
            PadsBank0 ->
                if self.pio.running then self.pio_catch_up()
                val r = self.pads.write(o, width, x)
                self.gpio_changed()
                r
            HstxCtrl ->
                self.hstx.unmodelled(o, width, x) match
                    Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
                    None -> ()
                self.hstx.write(o, width, x)
            HstxFifo ->
                if o & 0xFFC == hstx_fifo_reg.FIFO_OFFSET && width != 4 then return Err(s"${p.name} + 0x${hex(o)}: a narrow write to the HSTX FIFO is not modelled")
                self.hstx.fifo_write(o, width, x)
            Uart0 -> return self.uart_write(0, p, o, width, x)
            Uart1 -> return self.uart_write(1, p, o, width, x)
            Spi0 -> return self.spi_write(0, p, o, width, x)
            Spi1 -> return self.spi_write(1, p, o, width, x)
            I2c0 | I2c1 -> return self.i2c_write(p, o, width, x)
            Pio0 | Pio1 | Pio2 ->
                self.pio_catch_up()
                val k = pio_index(p.block)
                val base = self.pio.blocks[k].gpiobase
                val r = self.pio.write(k, self.now, o, width, x).map_err(f -> pio_refusal(p, o, f))
                // The first state machine to run starts the blocks reading the GPIOs, which have been
                // at these levels all along.
                if !self.pio.listening && self.pio.live()
                    self.pio.listening = true
                    self.pio.settle_levels(self.inputs_now())
                if self.pio.blocks[k].gpiobase != base then self.gpio_changed()
                return r
            Sio ->
                tmds_unmodelled(o, x) match
                    Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
                    None -> ()
                val gpio = o & 0xFFC >= sio_reg.GPIO_OUT_OFFSET && o & 0xFFC <= sio_reg.GPIO_HI_OE_XOR_OFFSET
                // The blocks run with the old levels up to the write.
                if gpio && self.pio.running then self.pio_catch_up()
                val r = self.sio.write(core, o, width, x)
                if gpio then self.gpio_changed()
                r
            BootRam -> self.bootram.write(o, width, x)
            UsbCtrl ->
                self.usb.unmodelled(o, width, x) match
                    Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
                    None -> ()
                self.usb.write(o, width, x)
            UsbDpram -> self.usb.dpram_write(o, width, x)
            Psm ->
                // Only PROC1 can be held in reset: the stages of the chip's own start-up have no state
                // to lose here, and holding PROC0 would stop the core that is writing.
                val before = self.psm
                val r = self.psm.write(o, width, x)
                val newly = self.psm.off & ~before.off
                if newly & ~psm_reg.FRCE_OFF_PROC1_MASK != 0
                    self.psm = before
                    return Err(s"PSM FRCE_OFF of ${psm_stage_name(newly & ~psm_reg.FRCE_OFF_PROC1_MASK)} is not modelled: only PROC1 can be forced off")
                self.core1_held(before.held(), self.psm.held())
                r
            Rosc ->
                val r = self.rosc.write(o, width, x)
                // DORMANT with a dormant-wake interrupt already asserted wakes again at once.
                if self.io.irq.line(rp.DORMANT_WAKE) then self.rosc.wake()
                r
            TrngBlock -> return self.trng.write(self.now, o, width, x).map_err(f -> trng_why(f))
            ShaBlock -> return self.sha.write(self.now + self.dma_t, o, width, x).map_err(f -> sha_why(f))
            SysInfo -> self.sysinfo.write(o, width, x)
            SysCfg -> self.syscfg.write(o, width, x)
            BusCtrlBlock -> return self.busctrl.write(o, width, x).map_err(f -> bus_refusal(p, o, f))
            TbMan -> return rp.tbman_write(o, width).map_err(f -> bus_refusal(p, o, f))
            GlitchBlock -> return self.glitch.write(o, width, x).map_err(f -> bus_refusal(p, o, f))
            Powman ->
                self.powman.unmodelled(o, width, x) match
                    Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
                    None -> ()
                // The power-up requests as they stand, for a STATE request to be judged against; then
                // a request just enabled takes its GPIO's level, latching no edge.
                if self.powman.watching() then self.powman.sample(self.pwrup_levels())
                val r = self.powman.write(o, width, x)
                if self.powman.watching() then self.powman.sample(self.pwrup_levels())
                r
            AccessCtrl ->
                self.accessctrl.memory_restriction(core, o, width, x) match
                    Some(why) -> return Err(why)
                    None -> ()
                self.pio_catch_up()
                val r = self.accessctrl.write(core, o, width, x)
                self.pio.ns = self.pio_ns()
                r
            IoQspiBlock -> self.io_qspi.write(o, width, x)
            PadsQspi -> self.pads_qspi.write(o, width, x)
            OtpData | OtpDataRaw | OtpDataGuarded | OtpDataRawGuarded ->
                return Err(s"${p.name} + 0x${hex(o)}: the OTP's read windows are read-only; a row is programmed through the OTP block's SBPI bridge")
            OtpBlock -> return self.otp.write(o, width, x).map_err(f -> otp_refusal(p, o, f))
            XipCtrl | QmiBlock | XipAux ->
                val r = p.block match
                    XipCtrl -> self.xip.write(o, width, x, &self.qmi, &self.flash)
                    QmiBlock -> self.qmi.write(o, width, x, &self.flash)
                    _ -> xip_aux_write(&self.qmi, &self.flash, o, width, x)
                self.xip_changed = true
                return r.map_err(f -> xip_refusal(p, o, f))
            DmaBlock -> return self.dma_write(p, o, width, x)
            PwmBlock -> return self.pwm_write(p, o, width, x)
            AdcBlock -> return self.adc_write(p, o, width, x)
        got.map_err(e -> refusal(p, o, e))

    // PROC1 has gone into reset or come out of it, between the stages held `before` and `after`. Going
    // in stops the core (the board takes it from `take_core1_reset`); coming out starts it from reset,
    // in the boot ROM (`take_core1_release`), whose own code drains its FIFO, answers core 0 with a 0
    // and waits for the launch sequence.
    private core1_held(*self, before: u32, after: u32)
        val bit = psm_reg.FRCE_OFF_PROC1_MASK
        if before & bit == 0 && after & bit != 0
            self.core1_reset = true
        elif before & bit != 0 && after & bit == 0
            self.core1_release = true

    // Where the watchdog has fired (by TRIGGER or by its counter reaching 0), the reset it makes
    // (datasheet 7.4, "Power-on state machine", and 12.9, "Watchdog"): each PSM stage PSM.WDSEL selects
    // goes back to its power-on state, one by one, as the SDK's `_watchdog_enable` relies on when it
    // selects every stage but ROSC and XOSC. Where RESETS' own stage is not selected, the peripherals
    // RESETS.WDSEL names go into reset instead. What survives is what no selected stage holds: the
    // watchdog's REASON and SCRATCH registers, POWMAN, PSM's own registers, the SRAM's contents (a
    // stage's reset is of its controller, not its array) and BOOTRAM's, the flash part and the OTP's
    // array (OTP's stage resets its registers, reloading the locks from the array). Stages with no
    // state benchtop keeps (PROC_COLD, PSM_READY, BUSFABRIC, ROM, SRAM0–9) change nothing here;
    // PROC0 and PROC1 are the board's to restart (`take_restart`). TICKS goes with CLOCKS, an assumption:
    // the headers give TICKS no stage of its own.
    private watchdog_reset(*self)
        if self.watchdog.take_fired() == 0 then return
        val sel = self.psm.wdsel
        val fresh = rp2350()
        if sel & psm_reg.WDSEL_ROSC_MASK != 0
            self.rosc = fresh.rosc
            self.rosc_rest = 0
        if sel & psm_reg.WDSEL_XOSC_MASK != 0
            self.xosc = fresh.xosc
            self.xosc_rest = 0
        if sel & psm_reg.WDSEL_OTP_MASK != 0
            // The OTP's registers go back to power-on, the locks loaded again from the array.
            val was = self.otp
            self.otp = fresh.otp
            self.otp.power_on(was)
        if sel & psm_reg.WDSEL_RESETS_MASK != 0
            self.resets = fresh.resets
            self.reset_blocks(self.resets.held)
        else
            val asserted = self.resets.watchdog & ~self.resets.held
            self.resets.held |= self.resets.watchdog
            self.resets.done &= ~self.resets.held
            self.reset_blocks(asserted)
        if sel & psm_reg.WDSEL_CLOCKS_MASK != 0
            self.clocks = fresh.clocks
            self.ticks = fresh.ticks
            self.ref_rest = 0
        if sel & psm_reg.WDSEL_BOOTRAM_MASK != 0
            val words = self.bootram.words
            self.bootram = fresh.bootram
            self.bootram.words = words
        if sel & psm_reg.WDSEL_XIP_MASK != 0
            self.xip = fresh.xip
            self.qmi = fresh.qmi
            self.xip_changed = true
        if sel & psm_reg.WDSEL_SIO_MASK != 0 then self.sio = fresh.sio
        if sel & psm_reg.WDSEL_ACCESSCTRL_MASK != 0 then self.accessctrl = fresh.accessctrl
        if sel & psm_reg.WDSEL_PROC1_MASK != 0
            // Core 1 stops; the board starts it again from reset (`take_restart`).
            self.core1_reset = true
        val before = self.restart match
            Some(s) -> s
            None -> 0
        self.restart = Some(before | sel)
    end watchdog_reset

    /** The PSM stages the watchdog's resets have taken down since the last call (bit n for stage n),
     * where it has fired at all; the board restarts PROC0 and PROC1 where they are among them.
     */
    take_restart(*self) -> Option[u32]
        val r = self.restart
        self.restart = None
        r

    /** Whether a watchdog reset the board has not yet taken has reset core `k`'s PSM stage. */
    restarting(*self, k: u32) -> bool = self.restart match
        Some(s) -> s & (if k == 0 then psm_reg.WDSEL_PROC0_MASK else psm_reg.WDSEL_PROC1_MASK) != 0
        None -> false

    /** Whether PSM has put core 1 in reset since the last call; the board stops the core. */
    take_core1_reset(*self) -> bool
        val held = self.core1_reset
        self.core1_reset = false
        held

    /** What the boot ROM's boot path leaves out of reset for the image it hands over, which the SDK's
     * own start-up then leaves alone: the QSPI bank's pins, which the ROM's flash set-up uses.
     */
    rom_boot_releases(*self)
        self.resets.held &= ~(resets_reg.RESET_IO_QSPI_MASK | resets_reg.RESET_PADS_QSPI_MASK)
        self.resets.complete(~self.resets.held)

    /** Whether PSM has taken core 1 out of reset since the last call; the board starts the core from
     * reset.
     */
    take_core1_release(*self) -> bool
        val released = self.core1_release
        self.core1_release = false
        released

    /** Whether a power-down of the switched core waits for the processors to halt (POWMAN's
     * STATE.WAITING); the board, which knows when they have, makes it (`power_down`).
     */
    power_down_due(*self) -> bool = self.powman.power_down_due()

    /** The processors have halted, and POWMAN powers the switched core down to the state STATE.REQ asked
     * for (datasheet 6, "Power management"; Q7: the time it spends there is skipped). Everything in the
     * switched core goes back to power-on, as at a power-on with the always-on domain kept: POWMAN with
     * its timer, the flash part, and what drives the pins from outside. The pads' isolation latches hold
     * each pad as it was (`held_*`), for POWMAN's power-up requests to see. Answers the state powered
     * down to (STATE.CURRENT's bits), whose SRAM banks and XIP cache the board clears where they are
     * off. Until it powers up again only the always-on domain runs (`advance`).
     */
    power_down(*self) -> u32
        var driven: u64 = 0
        var level: u64 = 0
        var ie: u64 = 0
        for n in 0..<GPIO_COUNT
            val p = self.pin(n)
            val bit = 1u64 << u64(n)
            if p.drives then driven |= bit
            if p.level then level |= bit
            if self.pads.pads[n] & pads_reg.GPIO0_IE_MASK != 0 then ie |= bit
        val state = self.powman.power_down()
        val powman = self.powman
        val now = self.now
        val outside = (self.outside_driven, self.outside_level)
        val bytes = self.flash.bytes
        val size = self.flash.size
        val wires = self.wires
        val array = self.otp
        val memory = self.memory
        val analog = self.analog
        *self = rp2350()
        if size != 0 then self.flash.connect(bytes, size)
        self.otp.power_on(array)
        self.wires = wires
        self.memory = memory
        self.analog = analog
        self.powman = powman
        self.now = now
        self.dma.paced_at = now
        self.outside_driven = outside.0
        self.outside_level = outside.1
        self.held_driven = driven
        self.held_level = level
        self.held_ie = ie
        self.swcore_off = true
        self.xip_changed = true
        state
    end power_down

    // A power-up request while the switched core is down: it powers up, with core 1 in the boot ROM and
    // every block at power-on, and the board boots core 0 (`take_power_up`).
    private power_up(*self)
        self.woke = Some(self.powman.power_up())
        self.swcore_off = false

    /** The state POWMAN has powered the switched core up to since the last call (STATE.CURRENT's bits),
     * where it has; the board boots core 0 through the boot ROM's power-up path.
     */
    take_power_up(*self) -> Option[u32]
        val w = self.woke
        self.woke = None
        w

    /** Drive GPIO `n` from off the chip at `level`, or leave it undriven with None: the level its pad
     * sees where it does not drive itself, and the level a power-up request sees while the switched core
     * is down.
     */
    drive_from_outside(*self, n: u32, level: Option[bool])
        if self.pio.running then self.pio_catch_up()
        val bit = 1u64 << u64(n)
        level match
            Some(v) ->
                self.outside_driven |= bit
                self.outside_level = if v then self.outside_level | bit else self.outside_level & ~bit
            None -> self.outside_driven &= ~bit
        if !self.swcore_off then self.gpio_changed()

    // What POWMAN's power-up requests see on the GPIOs they watch, bit n for GPIO n: the pad's level
    // where its input is enabled. While the switched core is down, a pad's isolation latch holds it: a
    // pad that drove keeps its level, and one that did not follows what drives it from outside, or
    // keeps the level its pulls gave it.
    private pwrup_levels(*self) -> u64
        var levels: u64 = 0
        for k in 0u32..<4
            self.powman.pwrup_gpio(k) match
                Some(g) ->
                    val bit = 1u64 << u64(g)
                    val high =
                        if self.swcore_off
                            val from_outside = self.held_driven & bit == 0 && self.outside_driven & bit != 0
                            self.held_ie & bit != 0 && (if from_outside then self.outside_level & bit != 0 else self.held_level & bit != 0)
                        else self.pads.pads[g] & pads_reg.GPIO0_IE_MASK != 0 && self.pin(g).level
                    if high then levels |= bit
                None -> ()
        levels
    end pwrup_levels

    // A read of the XIP address space outside XIP_SRAM, which the board runs: the flash through a
    // window, or why it is a bus error.
    private xip_read(*self, a: u32, width: u32) -> Result[u32, string]
        if a >= XIP_MAINTENANCE_BASE && a < XIP_MAINTENANCE_BASE + 0x04000000 then return Err(s"0x${hex(a, 8)}: the cache maintenance window takes writes only")
        read_xip(self.xip.ctrl, self.qmi, &self.flash, a, width).map_err(f -> xip_why(f))

    // A write to the XIP address space: a cache maintenance operation, or one through a flash window,
    // which XIP_CTRL.WRITABLE_M0 clear downgrades to a read, with no effect.
    private xip_write(*self, a: u32) -> Result[unit, string]
        if a >= XIP_MAINTENANCE_BASE && a < XIP_MAINTENANCE_BASE + 0x04000000
            self.xip_changed = true
            return self.xip.maintain(a - XIP_MAINTENANCE_BASE).map_err(f -> xip_why(f))
        xip_target(self.xip.ctrl, self.qmi, a).map_err(f -> xip_why(f))?
        if self.xip.ctrl & xip_ctrl_reg.CTRL_WRITABLE_M0_MASK == 0 then return Ok(())
        Err(s"0x${hex(a, 8)}: a write through XIP with XIP_CTRL.WRITABLE_M0 set becomes a QMI write command, which benchtop does not send (the Pico 2's flash is not written through XIP)")

    // A read of the OTP: one of its four windows, or the OTP block's registers.
    private otp_read(*self, p: Placed, o: u32, width: u32) -> Result[u32, string]
        val got = p.block match
            OtpData -> self.otp.read_window(false, false, o, width)
            OtpDataRaw -> self.otp.read_window(true, false, o, width)
            OtpDataGuarded -> self.otp.read_window(false, true, o, width)
            OtpDataRawGuarded -> self.otp.read_window(true, true, o, width)
            _ -> self.otp.read(o, width)
        got.map_err(f -> otp_refusal(p, o, f))

    // The block an access lands in, refused where none is there, or where RESETS holds it: on silicon
    // that access hangs the bus.
    private placed(*self, a: u32) -> Result[(Placed, u32), string]
        val (p, o) = block_at(a) match
            Some(found) -> found
            None -> return Err(s"0x${hex(a, 8)} is not on the RP2350's bus as benchtop runs it")
        if self.resets.held & p.reset != 0 then return Err(s"${p.name} is held in reset (RESETS bit ${p.reset.trailing_zeros()}): release it before touching 0x${hex(a)}")
        Ok((p, o))

    // Power-on state for each block whose reset has just been asserted.
    private reset_blocks(*self, asserted: u32)
        if asserted == 0 then return
        // USBCTRL is placed ungated (`BLOCKS`), so its reset is not found by the walk below.
        if asserted & resets_reg.RESET_USBCTRL_MASK != 0 then self.usb.reset_controller()
        // The PIO blocks to this cycle first: a neighbour of one reset saw it running until now.
        if asserted & (resets_reg.RESET_PIO0_MASK | resets_reg.RESET_PIO1_MASK | resets_reg.RESET_PIO2_MASK) != 0 then self.pio_catch_up()
        for p in BLOCKS
            if p.reset & asserted == 0 then continue
            p.block match
                PllSys -> self.pll_sys.reset()
                PllUsb -> self.pll_usb.reset()
                Timer0 -> self.timers[0].reset()
                Timer1 -> self.timers[1].reset()
                IoBank0 -> self.io.reset()
                PadsBank0 -> self.pads.reset()
                Uart0 -> self.uarts[0].reset()
                Uart1 -> self.uarts[1].reset()
                Spi0 -> self.spi.reset(0)
                Spi1 -> self.spi.reset(1)
                I2c0 -> self.i2c.reset_unit(0)
                I2c1 -> self.i2c.reset_unit(1)
                Pio0 -> self.pio.reset_block(0, self.now)
                Pio1 -> self.pio.reset_block(1, self.now)
                Pio2 -> self.pio.reset_block(2, self.now)
                IoQspiBlock -> self.io_qspi.reset()
                PadsQspi -> self.pads_qspi.reset()
                DmaBlock -> self.dma.reset()
                TrngBlock -> self.trng.reset()
                ShaBlock -> self.sha.reset()
                PwmBlock -> self.pwm.reset()
                AdcBlock -> self.adc.reset()
                HstxCtrl -> self.hstx.reset()
                _ -> ()
        // A block's reset lets go of its pins.
        if asserted & (resets_reg.RESET_PIO0_MASK | resets_reg.RESET_PIO1_MASK | resets_reg.RESET_PIO2_MASK) != 0
            self.pio.pins_moved = false
            self.pio.moved = [0, 0, 0]
            self.gpio_changed()

    // A write to SPI `k`, refused where it asks for something benchtop does not model
    // (`Spis.unmodelled`), or enables a port whose pins the GPIO interrupts watch: they sample levels
    // at accesses, not at the clock's edges. A refused write leaves the SPI as it was.
    private spi_write(*self, k: usize, p: Placed, o: u32, width: u32, x: u32) -> Result[unit, string]
        self.spi.unmodelled(k, o, width, x) match
            Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
            None -> ()
        if o & 0xFFC == 4 && x & 2 != 0
            for g in 0..<GPIO_COUNT
                val mine = rp.route(g, self.io.function(g)) match
                    SpiSck | SpiTx | SpiRx -> spi_of(g) == k
                    _ -> false
                if mine && self.io.irq.watched(g) then return Err(s"${p.name} + 0x${hex(o)}: enabled with GPIO $g, one of its pins, watched by the GPIO interrupts, which do not sample the clock's edges")
        self.spi.write(self, k, o, width, x).map_err(e -> refusal(p, o, e))

    // A write to UART `k`, refused where it asks for something benchtop does not model: a setting
    // (`Uart.unmodelled`), a character to send with no divisor to time it, or a frame its pins cannot show.
    // A refused write leaves the UART as it was.
    private uart_write(*self, k: usize, p: Placed, o: u32, width: u32, x: u32) -> Result[unit, string]
        self.uarts[k].unmodelled(o, width, x) match
            Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
            None -> ()
        if self.pio.running then self.pio_catch_up()
        val before = self.uarts[k]
        self.uarts[k].write(o, width, x).map_err(e -> refusal(p, o, e))?
        if self.uarts[k].unclocked()
            self.uarts[k] = before
            return Err(s"${p.name} + 0x${hex(o)}: a character waits to be sent and the latched baud divisor has IBRD 0, which times no frame (IBRD takes effect at an LCR_H write)")
        if self.uarts[k].take_started()
            self.check_frame(k) match
                Some(why) ->
                    self.uarts[k] = before
                    return Err(s"${p.name} + 0x${hex(o)}: $why")
                None -> ()
        // A frame starting, a break: the line's level, which the PIO blocks read.
        if self.pio.listening then self.pio.drive(self.now, self.inputs_now())
        Ok(())

    /** What the producer FUNCSEL routes to GPIO `n` drives it with, after CTRL's overrides. */
    drive(*self, n: u32) -> Drive
        val d = rp.route(n, self.io.function(n)) match
            Sio -> Drive(self.sio.out & (1u64 << n) != 0, self.sio.oe & (1u64 << n) != 0)
            // A UART's TX drives its line: high while idle, a frame's bits, low through a break.
            UartTx -> Drive(self.uarts[uart_of(n)].line_level(), true)
            Pio0 -> self.pio_output(0, n)
            Pio1 -> self.pio_output(1, n)
            Pio2 -> self.pio_output(2, n)
            Pwm -> rp.pwm_drive(&self.pwm, n)
            // An SPI's SCK and TX drive the clock and MOSI levels while its port is enabled.
            SpiSck -> Drive(self.spi.sck(spi_of(n)), self.spi.enabled(spi_of(n)))
            SpiTx -> Drive(self.spi.tx(spi_of(n)), self.spi.enabled(spi_of(n)))
            // I2C's lines are open drain; between transfers they idle released.
            UartRx | SpiRx | Null | I2cSda | I2cScl -> Drive(false, false)
            Hstx -> Drive(self.hstx.output(n - 12, 0), true)
        self.io.after_overrides(n, d)

    /** What GPIO `n` is doing: whether its pad drives, and its level. Something outside drives it, or
     * else the GPIO at the other end of its wire, where that drives.
     */
    pin(*self, n: u32) -> Pin
        val bit = 1u64 << u64(n)
        if self.outside_driven & bit != 0 then return self.pads.pin(n, self.drive(n), Some(self.outside_level & bit != 0))
        val h = self.wires[n]
        if h == NO_WIRE then return self.pads.pin(n, self.drive(n), None)
        val far = self.pads.pin(u32(h), self.drive(u32(h)), None)
        self.pads.pin(n, self.drive(n), if far.drives then Some(far.level) else None)

    private drives(*self) -> [GPIO_COUNT]Drive
        var all: [GPIO_COUNT]Drive
        for n in 0..<GPIO_COUNT do all[n] = self.drive(n)
        all

    private pins(*self) -> [GPIO_COUNT]Pin
        var all: [GPIO_COUNT]Pin
        for n in 0..<GPIO_COUNT do all[n] = self.pin(n)
        all

    // GPIO_IN: what the SIO reads of each GPIO, its pad's input after INOVER, bit n for GPIO n.
    private[chip] inputs(*self) -> u64
        if self.pio.running then self.pio_catch_up()
        self.inputs_now()

    // The same, with the PIO blocks where they stand.
    private inputs_now(*self) -> u64
        var bits: u64 = 0
        for n in 0..<GPIO_COUNT do if self.io.peripheral_input(n, self.pin(n).input) then bits |= 1u64 << n
        bits

    // What the GPIO interrupts see: each pad's input after IRQOVER, bit n for GPIO n.
    private irq_inputs(*self) -> u64
        var bits: u64 = 0
        for n in 0..<GPIO_COUNT do if self.io.irq_input(n, self.pin(n).input) then bits |= 1u64 << n
        bits

    /** Something that decides a GPIO's level may have changed (a function, an override, a pad, the SIO,
     * or what drives it from outside): the GPIO interrupts sample their inputs again, latching each
     * edge, except while RESETS holds IO_BANK0. A dormant-wake interrupt wakes a dormant ROSC. The PIO
     * blocks read the new levels from the end of this cycle, and `pin_edges` records any change.
     */
    gpio_changed(*self)
        if self.pio.running then self.pio_catch_up()
        if self.edge_mask != 0 then self.record_edges(self.now)
        self.gpio_sample()
        if self.pio.listening then self.pio.drive(self.now, self.inputs_now())

    private gpio_sample(*self)
        self.io.irq.sample(self.irq_inputs(), self.resets.held & resets_reg.RESET_IO_BANK0_MASK == 0)
        if self.io.irq.line(rp.DORMANT_WAKE) then self.rosc.wake()
        if self.pwm.enabled != 0 || self.pwm_stepping then self.pwm_gpio_changed()

    /** The interrupt lines both cores share, high at the moment, bit n for IRQ n. */
    shared_interrupts(*self) -> u64
        var lines = u64(self.timers[0].irqs() & 0xF) << TIMER0_IRQ_0 | u64(self.timers[1].irqs() & 0xF) << (TIMER0_IRQ_0 + 4)
        if self.powman.irq_pow() then lines |= 1u64 << POWMAN_IRQ_POW
        if self.powman.irq_timer() then lines |= 1u64 << POWMAN_IRQ_TIMER
        if self.uarts[0].irq() then lines |= 1u64 << UART0_IRQ
        if self.uarts[1].irq() then lines |= 1u64 << UART1_IRQ
        if self.usb.irq() then lines |= 1u64 << USBCTRL_IRQ
        for j in 0u32..<4 do if self.dma.irq(j) then lines |= 1u64 << (DMA_IRQ_0 + j)
        if self.spi.irq(0) then lines |= 1u64 << SPI0_IRQ
        if self.spi.irq(1) then lines |= 1u64 << SPI1_IRQ
        self.trng.settle(self.now)
        if self.trng.irq() then lines |= 1u64 << TRNG_IRQ
        for j in 0u32..<2 do if self.pwm.irq(j) then lines |= 1u64 << (PWM_IRQ_WRAP_0 + j)
        if self.adc.irq() then lines |= 1u64 << ADC_IRQ_FIFO
        // Until a block enables an interrupt its lines are low, and this is one test.
        if self.pio.irq_armed then lines |= self.pio_lines() << PIO0_IRQ_0
        lines | u64(self.i2c.lines & 3) << I2C0_IRQ

    /** The lines only core `k` has, high at the moment: its GPIO, FIFO and doorbell interrupts. */
    core_interrupts(*self, k: u32) -> u64
        var lines: u64 = 0
        if self.io.irq.line(k) then lines |= 1u64 << rp.IO_IRQ_BANK0
        if self.sio.fifo_irq(k) then lines |= 1u64 << SIO_IRQ_FIFO
        if self.sio.bell_irq(k) then lines |= 1u64 << SIO_IRQ_BELL
        lines

    // The PIO blocks' six lines, bit 2b + j for block b's IRQ_j: each high now or up on some cycle since
    // the last look (`Pio.take_lines`). Out of line, as `shared_interrupts` runs each quantum.
    @noinline
    private pio_lines(*self) -> u64
        if self.pio.running then self.pio_catch_up()
        u64(self.pio.take_lines())

    /** Drive `p`'s interrupt inputs from the devices' levels. */
    signal(*self, p: *Processor)
        val k = p.number()
        val lines = self.shared_interrupts() | self.core_interrupts(k)
        var left = WIRED_LINES
        while left != 0
            val irq = u32(left.trailing_zeros())
            p.interrupt(irq, (lines >> irq) & 1 != 0)
            left &= left - 1
        p.machine_timer(self.sio.software_irq(k), self.sio.timer_irq(k))
end Rp2350

// An SPI's MISO is the level its RX pin reads: the GPIO of its group whose function is its RX, after
// the pad and INOVER; low where no pin is selected.
impl SpiHost for Rp2350
    spi_miso(*self, unit: usize) -> bool
        for b in 0u32..<6
            val n = 16 * (b / 2) + 4 * (b % 2) + 8 * u32(unit)
            if rp.route(n, self.io.function(n)) == rp.Route.SpiRx then return self.io.peripheral_input(n, self.pin(n).input)
        false

/** The chip at power-on, with core 1 in the boot ROM. */
rp2350() -> Rp2350 =
    Rp2350(rp.rp2350_resets(), rp.clocks(), rp.xosc(), rp.pll(), rp.pll(), rp.ticks(), [rp.timer(), rp.timer()], rp.watchdog(),
        rp.sio(), rp.io_bank0(), rp.pads_bank0(), [rp.uart(), rp.uart()], rp.pio(), rp.bootram(), rp.usb_ctrl(),
        rp.psm(), rp.rosc(), rp.sysinfo(), rp.syscfg(), rp.busctrl(true), rp.glitch_detector(), rp.powman(), rp.accessctrl(), rp.io_qspi(), rp.qspi_pads(),
        rp.xip(), rp.qmi(), qspi_flash(), rp.otp(), rp.trng(), rp.sha256(), 0, false,
        rcp(), dcp(), false, false, None, 0, 0, 0, 0, false, None, 0, 0, 0, 0, 0, 0, [NO_WIRE; GPIO_COUNT], "", rp.rp2350_dma(), None, pwm_rp2350(), false, false, rp.spis(),
        adc("RP2350A", adc_reg.CS_AINSEL_MASK, adc_reg.CS_RROBIN_MASK), 0, analog_in(), i2c_bus(buf()), rp.hstx(), 0, None, 0, 0, buf())

// The chip as `ArmBoard` drives it: its inherent methods under the trait's names.
impl ArmChip for Rp2350
    const rp2350() -> bool = true
    @inline
    clock(*self) -> u64 = self.now
    @inline
    run_to(*self, t: u64) = self.catch_up(t)
    pass(*self, cycles: u64) = self.advance(cycles)
    due(*self) -> Option[u64] = self.next_event()
    @inline
    load(*self, core: u32, a: u32, width: u32) -> Result[u32, string] = self.read(core, a, width)
    @inline
    store(*self, core: u32, a: u32, width: u32, x: u32) -> Result[unit, string] = self.write(core, a, width, x)
    shared_lines(*self) -> u64 = self.shared_interrupts()
    core_lines(*self, k: u32) -> u64 = self.core_interrupts(k)
    @inline
    read_lowers(*self, a: u32) -> bool
        val w = a & ~3u32
        w == uart0_reg.BASE + uart0_reg.UARTDR_OFFSET || w == uart1_reg.BASE + uart1_reg.UARTDR_OFFSET ||
            w == spi0_reg.BASE + spi0_reg.SSPDR_OFFSET || w == spi1_reg.BASE + spi1_reg.SSPDR_OFFSET ||
            w == adc_reg.BASE + adc_reg.FIFO_OFFSET || w -% i2c0_reg.BASE < WINDOW || w -% i2c1_reg.BASE < WINDOW ||
            // A PIO block's RXF0–3: the pop can lower RXNEMPTY.
            w -% (pio0_reg.BASE + pio0_reg.RXF0_OFFSET) < 16 || w -% (pio1_reg.BASE + pio0_reg.RXF0_OFFSET) < 16 ||
            w -% (pio2_reg.BASE + pio0_reg.RXF0_OFFSET) < 16
    core1_stopped(*self) -> bool = self.take_core1_reset()
    core1_started(*self) -> bool = self.take_core1_release()
    @inline
    resetting(*self, k: u32) -> bool = self.restarting(k)
    take_reset(*self) -> Option[u32] = self.take_restart()
    take_fault(*self) -> Option[string] = self.take_line_fault()
    console(*self) -> Option[u8] = self.uarts[0].take()
    console_due(*self) -> Option[u64] = self.sending_due(0)

private[chip] earliest(a: Option[u64], b: Option[u64]) -> Option[u64] = a match
    Some(x) -> b match
        Some(y) -> Some(min(x, y))
        None -> a
    None -> b

// Why the XIP or QMI blocks refused an access, as a person reads it.
private xip_refusal(p: Placed, o: u32, f: XipFault) -> string = f match
    Access(e) -> refusal(p, o, e)
    Refused(why) -> s"${p.name} + 0x${hex(o)}: $why"

// Which PIO block `b` is.
private pio_index(b: Block) -> u32 = if b == Block.Pio0 then 0 elif b == Block.Pio1 then 1 else 2

// Why a PIO block refused an access, as a person reads it.
private pio_refusal(p: Placed, o: u32, f: PioFault) -> string = f match
    Access(e) -> refusal(p, o, e)
    Refused(why) -> s"${p.name} + 0x${hex(o)}: $why"

// Why BUSCTRL, TBMAN or the glitch detector refused an access, as a person reads it.
private bus_refusal(p: Placed, o: u32, f: BusFault) -> string = f match
    Access(e) -> refusal(p, o, e)
    Refused(why) -> s"${p.name} + 0x${hex(o)}: $why"

// Why the OTP refused an access, as a person reads it.
private otp_refusal(p: Placed, o: u32, f: OtpFault) -> string = f match
    Access(e) -> refusal(p, o, e)
    Refused(why) -> s"${p.name} + 0x${hex(o)}: $why"

private xip_why(f: XipFault) -> string = f match
    Access(_) -> "XIP: not an access width the window takes"
    Refused(why) -> s"XIP: $why"

// Why a block refused an access, as a person reads it.
private[chip] refusal(p: Placed, o: u32, e: AccessError) -> string
    val what = e match
        Unmapped -> "is not a register benchtop runs"
        InvalidWidth -> "is not an access width the block takes"
        Unaligned -> "is not aligned to its width"
        UnsupportedAlias -> "cannot be written through an atomic alias"
    s"${p.name} + 0x${hex(o)} $what"
