// The RP2040 as its two Cortex-M0+ cores see it (RP2040 datasheet chapter 2, "System Description"):
// the RP2350's models where the two chips share a block, at the RP2040's addresses and in its shape,
// and the RP2040's own where they differ. `ArmBoard` runs it on the `pico` board.
//
// **What differs from the RP2350**, block by block:
//
// - **CLOCKS has no TICKS beside it.** clk_ref is divided into the 1 µs tick by the watchdog's TICK
//   (`rp2040.Watchdog`), which the TIMER counts and the watchdog's counter counts twice (RP2040-E1).
//   CLOCKS itself is `ClocksRp2040`: its generators, dividers and FC0 table are the RP2040's.
// - **Pads have no ISO** and come up with their inputs enabled; **IO_BANK0** has 30 GPIOs, INTR0 at
//   0xF0 and no IRQSUMMARY, and keeps CTRL's overrides where the RP2040 has them.
// - **The SIO** has FIFOs eight deep, interpolators that shift right rather than rotate, each core's
//   hardware divider at 0x060–0x078 (`rp2040.Divider`, eight clk_sys cycles a division), and its GPIO
//   registers at the RP2040's offsets; each core's FIFO interrupt is a line of its own (SIO_IRQ_PROC0,
//   IRQ 15, into core 0; SIO_IRQ_PROC1, IRQ 16, into core 1). Of its GPIO_HI bank, the QSPI pins as
//   levels, GPIO_HI_IN answers SS, the flash's chip select (the boot ROM's BOOTSEL read); the rest of
//   the bank is refused by name.
// - **26 interrupt lines** into each M0+'s NVIC: the TIMER's four (0–3), IO_IRQ_BANK0 (13), the SIO's
//   (15, 16), the UARTs' (20, 21) and the RTC's (25) are driven; the rest belong to blocks not on the
//   chip yet.
// - **The flash is behind the SSI** (`rp2040.Ssi`), not a QMI: the Pico's W25Q16JV, 2 MB, the RP2350's
//   flash model with its own ID (`parts/qspi_flash`). XIP reads it through four 16 MB aliases from
//   0x1000_0000 where the SSI is set for them, as a second stage sets it; the SSI's direct transfers
//   reach it with chip select from IO_QSPI's SS override. XIP_CTRL (`rp2040.XipCtrl`) has no QMI's
//   windows and its cache is SRAM at 0x1500_0000 while disabled. IO_QSPI and PADS_QSPI are the RP2350's
//   models in the RP2040's shape.
// - **The RTC** (`rp2040.Rtc`) counts clk_rtc, and **VREG_AND_CHIP_RESET** (`rp2040.Vreg`) stores the
//   regulator and reports a power-on reset.
// - **PSM** has 17 stages; only PROC1 can be forced off, which stops core 1, and its release starts
//   core 1 from reset in the boot ROM, whose wait drains its FIFO and answers core 0 with a 0.
// - **XOSC's COUNT** is at 0x1C; **ROSC** has no RANDOM register and runs at a nominal 6.5 MHz.
// - **The memory map**: the ROM at 0 (16 KB), XIP at 0x1000_0000 through the SSI (the board's fast path
//   while the SSI is set for XIP, the chip's otherwise), XIP_CTRL at 0x1400_0000, the cache as SRAM at
//   0x1500_0000 (the board's), the SSI at 0x1800_0000, the 264 KB of SRAM at 0x2000_0000 (the board's,
//   striped over banks 0–3 with banks 4 and 5 after them) and its non-striped aliases at 0x2100_0000
//   (the board's, off the fast path).
//
// **The boot ROM** is benchtop's own (`rom/rp2040/`, written in sysl to work as the RP2040's does):
// core 1's launch wait, core 0's boot path (boot2 from flash) and every function and table the SDK
// looks up run as its code. What it reaches that no other item built is here: USB's DPRAM, memory,
// where core 1 waits on its stack; and the ROM's doorbell (`rom_doorbell_refusal`), the store by which
// it refuses by name what benchtop does not model, USB boot first. SYSCFG's NMI masks and TBMAN's
// PLATFORM are stored for programs that read them. **The watchdog's reset** takes down the PSM stages
// WDSEL selects (`watchdog_fired`), and the board starts each reset core in the ROM again
// (`take_reset`); one whose boot vector is `reset_usb_boot`'s ends the run with USB boot named
// (`take_fault`), as does a refused access.
//
// **Time is clk_sys cycles** (`now`), as on the RP2350 chip.

/** The Pico's crystal. */
const XOSC_HZ_RP2040: u64 = 12000000
/** The RP2040 ring oscillator's nominal frequency, which clk_ref and clk_sys run from at power-on. */
const ROSC_HZ_RP2040: u64 = 6500000

/** The RP2040's external interrupt lines, IRQ 0 to 25. */
const RP2040_IRQS: u32 = 26

// Interrupt numbers (RP2040 datasheet 2.3.2, "Interrupts"; the SDK's `intctrl.h`).
private const TIMER_IRQ_0: u32 = 0
private const IO_IRQ_BANK0_RP2040: u32 = 13
private const SIO_IRQ_PROC0: u32 = 15
private const SIO_IRQ_PROC1: u32 = 16
private const SPI0_IRQ_RP2040: u32 = 18
private const SPI1_IRQ_RP2040: u32 = 19
private const UART0_IRQ_RP2040: u32 = 20
private const UART1_IRQ_RP2040: u32 = 21
private const ADC_IRQ_FIFO_RP2040: u32 = 22
private const I2C0_IRQ_RP2040: u32 = 23
private const RTC_IRQ_RP2040: u32 = 25

/** The boot ROM: benchtop's own (`rom/rp2040/`, built by its `image/build.sh`), all 16 KB of it mapped
 * read-only at 0.
 */
const ROM_BYTES_RP2040: u32 = 16 * 1024
private[chip] val ROM_RP2040 = embed("rom/rp2040/rom.bin")

/** Where in the ROM its USB boot starts after a watchdog reboot (`usb_boot_entry`, placed there by
 * `rom.ld`), the PC `reset_usb_boot` leaves in SCRATCH7's boot vector, Thumb bit set.
 */
const ROM_USB_BOOT_RP2040: u32 = 0x201

/** The ROM's doorbell (`rom/rp2040/image/boot.sysl`): its last word, a store to which is the ROM
 * refusing by name what benchtop does not model, the word stored saying what.
 */
const ROM_DOORBELL_RP2040: u32 = 0x3FFC

/** The XIP address space, through the SSI; XIP_CTRL, the cache as SRAM and the SSI follow it. */
const XIP_BASE_RP2040: u32 = 0x10000000
private const XIP_END_RP2040: u32 = 0x20000000
/** The Pico's flash: the W25Q16JV's 2 MB, which each of XIP's 16 MB aliases repeats. */
const FLASH_BYTES_RP2040: u32 = 2 * 1024 * 1024
/** The XIP cache's 16 KB, SRAM while the cache is disabled. */
const XIP_SRAM_BASE_RP2040: u32 = 0x15000000
const XIP_SRAM_BYTES_RP2040: u32 = 16384
// The cached alias's end, where the uncached ones start, and where XIP_CTRL starts.
private const XIP_NOALLOC_RP2040: u32 = 0x11000000
private const XIP_ALIASES_END: u32 = 0x14000000

// Each APB device's window: its registers and their XOR, SET and CLR aliases.
private const WINDOW_RP2040: u32 = 0x4000

/** The devices on the RP2040's bus that benchtop runs. */
enum Block40
    Resets = 0
    Clocks
    Xosc
    PllSys
    PllUsb
    Watchdog
    Timer
    IoBank0
    PadsBank0
    Uart0
    Uart1
    Spi0
    Spi1
    I2c0
    I2c1
    Psm
    Rosc
    SysInfo
    TbMan
    SysCfg
    BusCtrlBlock
    Rtc
    AdcBlock
    Vreg
    IoQspi
    PadsQspi
    PwmBlock

/** A block, its base address, its name in a refusal, and the RESETS bit holding it (0 for none). */
struct Placed40
    block: Block40
    base: u32
    name: string
    reset: u32

val BLOCKS_RP2040: [27]Placed40 = [
    Placed40(Block40.Resets, resets_reg.BASE, "RESETS", 0),
    Placed40(Block40.Clocks, clocks_reg.BASE, "CLOCKS", 0),
    Placed40(Block40.Xosc, xosc_reg.BASE, "XOSC", 0),
    Placed40(Block40.PllSys, pll_sys_reg.BASE, "PLL_SYS", resets_reg.RESET_PLL_SYS_MASK),
    Placed40(Block40.PllUsb, pll_usb_reg.BASE, "PLL_USB", resets_reg.RESET_PLL_USB_MASK),
    Placed40(Block40.Watchdog, watchdog_reg.BASE, "WATCHDOG", 0),
    Placed40(Block40.Timer, timer_reg.BASE, "TIMER", resets_reg.RESET_TIMER_MASK),
    Placed40(Block40.IoBank0, io_reg.BASE, "IO_BANK0", resets_reg.RESET_IO_BANK0_MASK),
    Placed40(Block40.PadsBank0, pads_reg.BASE, "PADS_BANK0", resets_reg.RESET_PADS_BANK0_MASK),
    Placed40(Block40.Uart0, uart0_reg.BASE, "UART0", resets_reg.RESET_UART0_MASK),
    Placed40(Block40.Uart1, uart1_reg.BASE, "UART1", resets_reg.RESET_UART1_MASK),
    Placed40(Block40.Spi0, spi0_reg.BASE, "SPI0", resets_reg.RESET_SPI0_MASK),
    Placed40(Block40.Spi1, spi1_reg.BASE, "SPI1", resets_reg.RESET_SPI1_MASK),
    Placed40(Block40.Psm, psm_reg.BASE, "PSM", 0),
    Placed40(Block40.Rosc, rosc_reg.BASE, "ROSC", 0),
    // Read while RESETS holds it: the boot ROM's USB boot reads GITREF_RP2040 straight after a watchdog
    // reset has put every block back in reset.
    Placed40(Block40.SysInfo, sysinfo_reg.BASE, "SYSINFO", 0),
    // Neither gated by its RESETS bit: the boot ROM reads PLATFORM and writes the NMI masks at
    // power-on, with every block held.
    Placed40(Block40.TbMan, tbman_reg.BASE, "TBMAN", 0),
    Placed40(Block40.SysCfg, syscfg_reg.BASE, "SYSCFG", 0),
    Placed40(Block40.BusCtrlBlock, busctrl_reg.BASE, "BUSCTRL", 0),
    Placed40(Block40.Rtc, rtc_reg.BASE, "RTC", resets_reg.RESET_RTC_MASK),
    Placed40(Block40.AdcBlock, adc_reg.BASE, "ADC", resets_reg.RESET_ADC_MASK),
    Placed40(Block40.Vreg, vreg_reg.BASE, "VREG_AND_CHIP_RESET", 0),
    Placed40(Block40.IoQspi, io_qspi_reg.BASE, "IO_QSPI", resets_reg.RESET_IO_QSPI_MASK),
    Placed40(Block40.PadsQspi, pads_qspi_reg.BASE, "PADS_QSPI", resets_reg.RESET_PADS_QSPI_MASK),
    Placed40(Block40.PwmBlock, pwm_reg.BASE, "PWM", resets_reg.RESET_PWM_MASK),
    Placed40(Block40.I2c0, i2c0_reg.BASE, "I2C0", resets_reg.RESET_I2C0_MASK),
    Placed40(Block40.I2c1, i2c1_reg.BASE, "I2C1", resets_reg.RESET_I2C1_MASK),
]

/** A block on the RP2040's bus that benchtop does not run yet: its window, its name and why. */
struct Absent40
    base: u32
    size: u32
    name: string
    why: string

val ABSENT_RP2040: [4]Absent40 = [
    Absent40(dma_reg.BASE, 0x1000, "DMA", "not on the chip yet (docs/rp-coverage.md item 11)"),
    Absent40(pio0_reg.BASE, 0x1000, "PIO0", "not on the chip yet (docs/rp-coverage.md items 13 and 14)"),
    Absent40(pio1_reg.BASE, 0x1000, "PIO1", "not on the chip yet (docs/rp-coverage.md items 13 and 14)"),
    Absent40(usb_reg.BASE, WINDOW_RP2040, "USBCTRL", "the RP2040's USB controller is not on the chip yet beyond SIE_CTRL, which the SDK's runtime_init stores (docs/rp-coverage.md item 20 built the RP2350's)"),
]

// IO_QSPI's pins, in register order.
private val QSPI_PIN_NAMES: [6]string = ["SCLK", "SS", "SD0", "SD1", "SD2", "SD3"]

// The SIO's GPIO registers on the RP2040 (OUT, OUT_SET, OUT_CLR, OUT_XOR, OE, OE_SET, OE_CLR, OE_XOR
// from 0x010, a word apart) at the shared model's offsets, which interleave the high bank.
private val SIO_GPIO_RP2350: [8]u32 = [0x10, 0x18, 0x20, 0x28, 0x30, 0x38, 0x40, 0x48]

// The RP2040's GPIOs as a mask of bits.
private const GPIO_MASK_RP2040: u32 = 0x3FFFFFFF

struct Rp2040
    resets: Resets
    clocks: ClocksRp2040
    xosc: Xosc
    pll_sys: Pll
    pll_usb: Pll
    watchdog: r40.Watchdog
    timer: r40.Timer
    sio: Sio
    dividers: [2]Divider
    io: IoBank0
    pads: Pads
    uarts: [2]Uart
    psm: Psm
    rosc: Rosc
    sysinfo: SysInfo
    busctrl: BusCtrl
    // USBCTRL's SIE_CTRL, stored: the SDK's `runtime_init_usb_power_down` reads it and powers the
    // transceiver down, before it has released USBCTRL from reset, so it is not gated by RESETS.
    usb_sie_ctrl: u32
    // USB's 4 KB of DPRAM, as memory: the boot ROM keeps its variables there (its `.bss`, 0x50100400 on),
    // `watchdog_reboot` among them. The controller that would read it is not on the chip.
    usb_dpram: [1024]u32
    // SYSCFG's PROC0_NMI_MASK and PROC1_NMI_MASK, stored: the boot ROM clears both as core 0 boots, and no
    // line raises an NMI.
    nmi_masks: [2]u32
    // The flash and the path to it: the SSI, XIP_CTRL, the QSPI pins and pads.
    ssi: r40.Ssi
    xip: r40.XipCtrl
    flash: QspiFlash
    io_qspi: IoQspi
    pads_qspi: QspiPads
    vreg: r40.Vreg
    rtc: r40.Rtc
    // The remainder carried into the next clk_rtc cycle.
    rtc_rest: u64
    // Something that decides whether XIP reaches the flash, or the cache is SRAM, may have changed
    // since the board last asked (`take_xip_changed`).
    xip_changed: bool
    // Core 1 has been put in reset by PSM since the board last asked, or taken out of it.
    core1_reset: bool
    core1_release: bool
    // The PSM stages the watchdog's resets have taken down since the board last asked (`take_reset`),
    // bit n for stage n; 0 for none.
    restart: u32
    // clk_sys cycles since power-on, and the remainders carried into the next clk_ref, crystal,
    // ring-oscillator and clk_peri cycle.
    now: u64
    ref_rest: u64
    xosc_rest: u64
    rosc_rest: u64
    peri_rest: u64
    // What drives each GPIO from off the chip, bit n for GPIO n (`drive_from_outside`).
    outside_driven: u64
    outside_level: u64
    // Why the chip did something benchtop does not model while time passed (a watchdog reset into USB
    // boot, a UART frame its pins cannot show), for the board to stop on; empty for nothing.
    fault: string
    // The PWM block (pwm.sysl runs it), as on the RP2350.
    pwm: r40.Pwm
    pwm_watched: bool
    pwm_stepping: bool
    // The two SPIs, and the clock they share while one is busy.
    spi: Spis
    // The ADC (adc.sysl gives it time), the clk_sys remainder it carries, and what the board puts on its
    // inputs, which a reset of the chip leaves there.
    adc: r40.Adc
    adc_rest: u64
    analog: r40.AnalogIn
    // I2C0 and I2C1, with the I2C parts on the workbench (chip/i2c.sysl).
    i2c: I2cBus

    /** Power-on, with core 1 in the boot ROM; the I2C parts stay on the workbench. */
    reset(*self)
        val analog = self.analog
        val parts = self.i2c.parts
        *self = rp2040()
        self.analog = analog
        self.i2c.parts = parts

    /** What each clock source runs at now; the PLLs take the crystal as their reference. */
    sources(*self) -> Sources
        val xosc = if self.xosc.stable() then XOSC_HZ_RP2040 else 0
        Sources(self.rosc.hz(ROSC_HZ_RP2040), xosc, 0, self.pll_sys.hz(xosc), self.pll_usb.hz(xosc))

    sys_hz(*self) -> u64 = self.clocks.sys_hz(self.sources())
    ref_hz(*self) -> u64 = self.clocks.ref_hz(self.sources())

    // `cycles` of clk_sys pass: the dividers, the oscillators, the watchdog's tick with the timer and
    // the watchdog's counter on it, and the UARTs' lines while they are busy.
    private advance(*self, cycles: u64)
        if cycles == 0 then return
        val sys = self.sys_hz()
        self.now += cycles
        self.dividers[0].advance(cycles)
        self.dividers[1].advance(cycles)
        if sys == 0 then return
        self.ref_rest += cycles * self.ref_hz()
        val ref_cycles = self.ref_rest / sys
        self.ref_rest %= sys
        if self.xosc.on
            self.xosc_rest += cycles * XOSC_HZ_RP2040
            self.xosc.advance(self.xosc_rest / sys)
            self.xosc_rest %= sys
        if self.rosc.running()
            self.rosc_rest += cycles * ROSC_HZ_RP2040
            self.rosc.advance(self.rosc_rest / sys)
            self.rosc_rest %= sys
        if self.rtc.enabled() then self.advance_rtc(cycles, sys)
        // No debugger halts a core, so no PAUSE applies.
        val ticks = self.watchdog.advance(ref_cycles)
        self.timer.advance(ticks, 0)
        self.watchdog_fired()
        if self.uarts[0].active() || self.uarts[1].active() then self.advance_lines(cycles, sys)
        if self.pwm.enabled != 0 then self.advance_pwm(cycles)
        if self.spi.live() then self.spi.pass(self, cycles, sys, self.clocks.peri_hz(self.sources()))
        if self.adc.active() then self.advance_adc(cycles, sys)
        if self.i2c.next_due() <= self.now then self.i2c_steps()
    end advance

    // `cycles` of clk_sys at `sys` Hz pass for the RTC, as clk_rtc's cycles.
    private advance_rtc(*self, cycles: u64, sys: u64)
        val hz = self.clocks.rtc_hz(self.sources())
        if hz == 0 then return
        val total = u128(self.rtc_rest) + u128(cycles) * u128(hz)
        self.rtc.advance(u64(total / u128(sys)))
        self.rtc_rest = u64(total % u128(sys))

    /** The clk_sys cycles until the RTC's next second, while its alarm could raise its interrupt then. */
    rtc_due(*self) -> Option[u64]
        if !self.rtc.alarm_armed() then return None
        val hz = self.clocks.rtc_hz(self.sources())
        val sys = self.sys_hz()
        if hz == 0 || sys == 0 then return None
        val need = u128(self.rtc.cycles_to_second()) * u128(sys) - u128(self.rtc_rest)
        Some(u64((need + u128(hz) - 1) / u128(hz)))

    /** Whether something that decides the XIP mapping has changed since the last call. */
    take_xip_changed(*self) -> bool
        val changed = self.xip_changed
        self.xip_changed = false
        changed

    /** Whether an XIP read reaches the flash now: the board's fast path follows it. */
    xip_ready(*self) -> bool = self.ssi.xip_ready(&self.flash, self.qspi_cs(), self.qspi_pins()).is_ok()

    // IO_QSPI's SS OUTOVER: the SSI's chip select, or forced low or high.
    private qspi_cs(*self) -> u32 = (self.io_qspi.ctrl[1] & io_qspi_reg.GPIO_QSPI_SS_CTRL_OUTOVER_MASK) >> io_qspi_reg.GPIO_QSPI_SS_CTRL_OUTOVER_SHIFT

    // Why the QSPI pins do not reach the SSI; empty where every one has FUNCSEL 0 (XIP).
    private qspi_pins(*self) -> string
        val held = if self.resets.held & resets_reg.RESET_IO_QSPI_MASK != 0 then ", as RESETS holds IO_QSPI in reset" else ""
        for i in 0..<6
            val f = self.io_qspi.ctrl[i] & io_qspi_reg.GPIO_QSPI_SS_CTRL_FUNCSEL_MASK
            if f != 0 then return s"IO_QSPI's GPIO_QSPI_${QSPI_PIN_NAMES[i]} has FUNCSEL 0x${hex(f)}$held, not XIP (0), so the pin is not the SSI's"
        ""

    // The SSI brought up to now.
    private ssi_catch_up(*self) -> Result[unit, string]
        self.xip_changed = true
        self.ssi.catch_up(self.now, &self.flash, self.qspi_cs())

    // The flash's chip select follows IO_QSPI's override, or the SSI's transfer where it is normal.
    private cs_changed(*self) -> Result[unit, string]
        val cs = self.qspi_cs()
        val low = if cs == CS_LOW then true elif cs == CS_HIGH then false else self.ssi.active()
        if low && !self.flash.selected
            self.flash.select()
        elif !low && self.flash.selected
            self.flash.deselect()?
        Ok(())

    // An access to the XIP address space, read: the flash through any of its four aliases, XIP_CTRL,
    // the cache as SRAM while it is not (the board maps it while it is), and the SSI.
    private xip_load(*self, a: u32, width: u32) -> Result[u32, string]
        if a < XIP_ALIASES_END
            self.ssi_catch_up()?
            val got = r40.xip_word(self.ssi, &self.flash, self.qspi_cs(), self.qspi_pins(), a).map_err(why -> s"0x${hex(a, 8)} is the flash through XIP, read through the SSI, but $why")?
            return Ok(r40.read_lane(got, a, width))
        if a >= xip_ctrl_reg.BASE && a < xip_ctrl_reg.BASE + WINDOW_RP2040
            return self.xip.read(a - xip_ctrl_reg.BASE, width, self.ssi, &self.flash, self.qspi_cs(), self.qspi_pins())
        if a >= ssi_reg.BASE && a < ssi_reg.BASE + 0x1000
            self.xip_changed = true
            return self.ssi.read(a - ssi_reg.BASE, width, self.now, &self.flash, self.qspi_cs())
        Err(xip_refusal40(a, self.xip.sram_closed()))

    // An access to the XIP address space, written.
    private xip_store(*self, a: u32, width: u32, x: u32) -> Result[unit, string]
        if a < XIP_NOALLOC_RP2040
            // A write to the cached alias deallocates the line it hits; no line is held to forget.
            return Ok(())
        if a < XIP_ALIASES_END
            if self.xip.bad_write_faults() then return Err(s"0x${hex(a, 8)} is an uncached XIP alias, a write to which is a bus fault while XIP_CTRL CTRL.ERR_BADWRITE is set, as it is at reset: not modelled")
            return Ok(())
        if a >= xip_ctrl_reg.BASE && a < xip_ctrl_reg.BASE + WINDOW_RP2040
            self.xip_changed = true
            return self.xip.write(a - xip_ctrl_reg.BASE, width, x, self.ssi, &self.flash, self.qspi_cs(), self.qspi_pins())
        if a >= ssi_reg.BASE && a < ssi_reg.BASE + 0x1000
            self.xip_changed = true
            return self.ssi.write(a - ssi_reg.BASE, width, x, self.now, &self.flash, self.qspi_cs(), self.qspi_pins())
        Err(xip_refusal40(a, self.xip.sram_closed()))

    // The watchdog has fired, by its counter or by TRIGGER: the reset the RP2040 makes (datasheet 2.13,
    // "Power-On State Machine", and 4.7, "Watchdog"). Each PSM stage PSM.WDSEL selects goes back to its
    // power-on state, as on the RP2350 (`Rp2350.watchdog_reset`); where RESETS' own stage is not
    // selected, the peripherals RESETS.WDSEL names go into reset instead. What survives is what no
    // selected stage holds: the watchdog itself (its REASON and SCRATCH, and the tick), PSM, the SRAM's
    // contents and USB's DPRAM, and the flash part, still in whatever mode it was left. PROC0 and PROC1
    // are the board's to restart from reset in the boot ROM (`take_reset`), whose boot path then runs:
    // a boot vector in SCRATCH4–7, or boot2 from flash. A vector into the ROM's own USB boot
    // (`reset_usb_boot`'s) ends the run instead, named: USB is not on the chip.
    private watchdog_fired(*self)
        val why = self.watchdog.counter.take_fired()
        if why == 0 || !self.fault.is_empty() then return
        if self.boot_vector_pc() == Some(ROM_USB_BOOT_RP2040)
            val cause = if why == watchdog_reg.REASON_FORCE_MASK then "by TRIGGER" else "by its counter reaching 0"
            self.fault = s"the watchdog has fired $cause, and its reset boots core 0 into the boot ROM's USB boot (reset_usb_boot): the RP2040's USB device controller is not on the chip yet"
            return
        val sel = self.psm.wdsel
        val fresh = rp2040()
        if sel & psm_reg.WDSEL_ROSC_MASK != 0
            self.rosc = fresh.rosc
            self.rosc_rest = 0
        if sel & psm_reg.WDSEL_XOSC_MASK != 0
            self.xosc = fresh.xosc
            self.xosc_rest = 0
        if sel & psm_reg.WDSEL_CLOCKS_MASK != 0
            self.clocks = fresh.clocks
            self.ref_rest = 0
            self.peri_rest = 0
        if sel & psm_reg.WDSEL_RESETS_MASK != 0
            self.resets = fresh.resets
            self.reset_blocks(self.resets.held)
            self.usb_sie_ctrl = 0
            self.nmi_masks = [0, 0]
        else
            val asserted = self.resets.watchdog & ~self.resets.held
            self.resets.held |= self.resets.watchdog
            self.resets.done &= ~self.resets.held
            self.reset_blocks(asserted)
        if sel & psm_reg.WDSEL_XIP_MASK != 0
            self.ssi = fresh.ssi
            self.xip = fresh.xip
            self.xip_changed = true
        if sel & psm_reg.WDSEL_VREG_AND_CHIP_RESET_MASK != 0 then self.vreg = fresh.vreg
        if sel & psm_reg.WDSEL_SIO_MASK != 0
            self.sio = fresh.sio
            self.dividers = fresh.dividers
        // The flash's data pins and chip select follow the SSI and the QSPI bank as their resets leave them.
        self.ssi.undriven = self.data_pads()
        self.cs_changed() match
            Ok(_) -> ()
            Err(e) -> self.fault = s"the watchdog's reset moved the flash's chip select: $e"
        if sel & psm_reg.WDSEL_PROC1_MASK != 0 then self.core1_reset = true
        self.restart |= sel

    // The PC of the boot vector in SCRATCH4–7, as the ROM's `check_wdog` takes it: the magic, the PC
    // XORed with the magic's negation, the SP, the PC.
    private boot_vector_pc(*self) -> Option[u32]
        val s = self.watchdog.counter.scratch
        if s[4] == WATCHDOG_BOOT_MAGIC && s[5] == s[7] ^ (0 -% WATCHDOG_BOOT_MAGIC) then Some(s[7]) else None

    // `cycles` of clk_sys at `sys` Hz pass on the UARTs' lines, as clk_peri's cycles (`Rp2350.advance_lines`,
    // with no wires on this chip's workbench yet).
    private advance_lines(*self, cycles: u64, sys: u64)
        val peri = self.clocks.peri_hz(self.sources())
        if peri == 0 then return
        var left: u64 = 0
        if cycles <= 0xFFFFFFFF && peri <= 0xFFFFFFFF
            val total = self.peri_rest + cycles * peri
            left = total / sys * UART_UNITS_PER_CYCLE
            self.peri_rest = total % sys
        else
            val total = u128(self.peri_rest) + u128(cycles) * u128(peri)
            left = u64(total / u128(sys)) * UART_UNITS_PER_CYCLE
            self.peri_rest = u64(total % u128(sys))
        if left < self.uarts[0].until_event() && left < self.uarts[1].until_event()
            self.uarts[0].pass(left)
            self.uarts[1].pass(left)
            return
        while left > 0
            val step = min(left, min(self.uarts[0].until_event(), self.uarts[1].until_event()))
            self.uarts[0].pass(step)
            self.uarts[1].pass(step)
            for k in 0..<2
                if self.uarts[k].take_started()
                    self.check_frame(k) match
                        Some(why) -> if self.fault.is_empty() then self.fault = why
                        None -> ()
            left -= step
            if !self.uarts[0].active() && !self.uarts[1].active() then break
    end advance_lines

    // The clk_sys cycles until a UART's line next does something; None while both are idle or clk_peri
    // is stopped.
    private line_due(*self) -> Option[u64]
        earliest(self.uart_due(), self.spi.due(self.sys_hz(), self.clocks.peri_hz(self.sources())))

    private uart_due(*self) -> Option[u64]
        if !self.uarts[0].active() && !self.uarts[1].active() then return None
        val peri = self.clocks.peri_hz(self.sources())
        val sys = self.sys_hz()
        if peri == 0 || sys == 0 then return None
        val units = min(self.uarts[0].until_event(), self.uarts[1].until_event())
        val peri_cycles = (units + UART_UNITS_PER_CYCLE - 1) / UART_UNITS_PER_CYCLE
        val need = u128(peri_cycles) * u128(sys) - u128(self.peri_rest)
        Some(u64((need + u128(peri) - 1) / u128(peri)))

    // Why the frame UART `k` has just started cannot be shown as benchtop models it: a GPIO its TX drives
    // has its interrupts enabled, which do not sample a frame's bits.
    private check_frame(*self, k: usize) -> Option[string]
        for g in 0u32..<GPIO_COUNT_RP2040
            if rp.route(g, self.io.function(g)) != rp.Route.UartTx || uart_of(g) != k then continue
            if self.io.irq.watched(g) then return Some(s"UART$k sends a frame on GPIO $g, whose interrupts are enabled: the GPIO interrupts do not sample a frame's bits")
        None

    // The clk_sys cycles until the watchdog's tick generator has made `n` ticks from now, rounded up;
    // None while it is stopped.
    private ticks_to_cycles(*self, n: u64) -> Option[u64]
        val sys = self.sys_hz()
        val ref_hz = self.ref_hz()
        if ref_hz == 0 then return None
        self.watchdog.cycles_to(n).map(c ->
            if c == NEVER then NEVER else u64(min(u128(NEVER), (u128(c) * u128(sys) + u128(ref_hz) - 1) / u128(ref_hz))))

    // A read the chip answers, or why it refuses it.
    private read(*self, core: u32, a: u32, width: u32) -> Result[u32, string]
        if a >= 0xD0000000 && a < 0xD0000000 + WINDOW_RP2040 then return self.sio_read(core, a - 0xD0000000, width)
        if is_sie_ctrl(a)
            r40.access(a - usb_reg.BASE, width, true).map_err(e -> s"USBCTRL + 0x${hex(a - usb_reg.BASE)} ${what_refused(e)}")?
            return Ok(r40.read_lane(self.usb_sie_ctrl, a - usb_reg.BASE, width))
        if a >= usb_dpram_reg.BASE && a - usb_dpram_reg.BASE < 0x1000
            val o = a - usb_dpram_reg.BASE
            if o & (width - 1) != 0 then return Err(s"USBCTRL_DPRAM + 0x${hex(o)} is not aligned to its width")
            val lane = self.usb_dpram[o >> 2] >> (8 * (o & 3))
            return Ok(if width == 4 then lane else lane & ((1u32 << (8 * width)) - 1))
        val (p, o) = self.placed(a)?
        val got = p.block match
            Resets -> self.resets.read(o, width)
            Clocks -> self.clocks.read(o, width)
            Xosc ->
                val r = xosc_offset(o)
                if r == NO_OFFSET then Err(AccessError.Unmapped) else self.xosc.read(r, width)
            PllSys -> if pll_lacks(o) then Err(AccessError.Unmapped) else self.pll_sys.read(o, width)
            PllUsb -> if pll_lacks(o) then Err(AccessError.Unmapped) else self.pll_usb.read(o, width)
            Watchdog -> self.watchdog.read(o, width)
            Timer -> self.timer.read(o, width)
            IoBank0 ->
                if self.pwm.enabled != 0 then self.pwm_io_read(p, o)?
                self.io.read(o, width, self.pins(), self.drives())
            PadsBank0 -> self.pads.read(o, width)
            PwmBlock -> self.pwm.read(o, width)
            Uart0 -> self.uarts[0].read(o, width)
            Uart1 -> self.uarts[1].read(o, width)
            Spi0 -> self.spi.read(self, 0, o, width)
            Spi1 -> self.spi.read(self, 1, o, width)
            I2c0 | I2c1 -> return self.i2c_read40(p, o, width)
            Psm -> self.psm.read(o, width)
            Rosc -> self.rosc.read(rosc_offset(o), width)
            SysInfo -> sysinfo_read(o, width)
            TbMan -> tbman_read(o, width)
            SysCfg -> self.syscfg_read(o, width)
            BusCtrlBlock -> return self.busctrl.read(o, width).map_err(f -> bus_refusal40(p, o, f))
            Rtc -> self.rtc.read(o, width, self.clocks.rtc_hz(self.sources()) != 0)
            AdcBlock -> self.adc.read(o, width)
            Vreg -> self.vreg.read(o, width)
            IoQspi -> self.io_qspi.read(o, width)
            PadsQspi -> self.pads_qspi.read(o, width)
        got.map_err(e -> refusal40(p, o, e))

    // A write the chip takes, or why it refuses it.
    private write(*self, core: u32, a: u32, width: u32, x: u32) -> Result[unit, string]
        if a >= 0xD0000000 && a < 0xD0000000 + WINDOW_RP2040 then return self.sio_write(core, a - 0xD0000000, width, x)
        if is_sie_ctrl(a)
            val o = a - usb_reg.BASE
            r40.access(o, width, true).map_err(e -> s"USBCTRL + 0x${hex(o)} ${what_refused(e)}")?
            self.usb_sie_ctrl = written(self.usb_sie_ctrl, o, replicated(x, width))
            return Ok(())
        if a >= usb_dpram_reg.BASE && a - usb_dpram_reg.BASE < 0x1000
            val o = a - usb_dpram_reg.BASE
            if o & (width - 1) != 0 then return Err(s"USBCTRL_DPRAM + 0x${hex(o)} is not aligned to its width")
            val shift = 8 * (o & 3)
            val mask = if width == 4 then 0xFFFFFFFF else ((1u32 << (8 * width)) - 1) << shift
            self.usb_dpram[o >> 2] = (self.usb_dpram[o >> 2] & ~mask) | ((x << shift) & mask)
            return Ok(())
        val (p, o) = self.placed(a)?
        val got = p.block match
            Resets ->
                val before = self.resets.held
                val r = self.resets.write(o, width, x)
                val asserted = self.resets.held & ~before
                if asserted & resets_reg.RESET_IO_QSPI_MASK != 0 then self.ssi_catch_up()?
                self.reset_blocks(asserted)
                // IO_QSPI's reset puts chip select back to the SSI's.
                if asserted & resets_reg.RESET_IO_QSPI_MASK != 0 then self.cs_changed()?
                // Every released block is ready at once.
                self.resets.complete(~self.resets.held)
                if (self.resets.held ^ before) & (resets_reg.RESET_IO_BANK0_MASK | resets_reg.RESET_PADS_BANK0_MASK | resets_reg.RESET_PWM_MASK) != 0 then self.gpio_changed()
                r
            Clocks ->
                val before = self.clocks
                val r = self.clocks.write(o, width, x)
                if o & 0xFFC == clocks_reg.FC0_SRC_OFFSET
                    val why = self.clocks.unmodelled_source()
                    if !why.is_empty()
                        val wrote = self.clocks.words[usize(clocks_reg.FC0_SRC_OFFSET / 4)] & clocks_reg.FC0_SRC_FC0_SRC_MASK
                        self.clocks = before
                        return Err(s"CLOCKS FC0_SRC = $wrote is not modelled: $why")
                    self.clocks.measure(self.sources())
                r
            Xosc ->
                if o & 0xFFC == xosc_reg.DORMANT_OFFSET && written(self.xosc.dormant, o, replicated(x, width)) == xosc_reg.DORMANT_DORMANT_DORMANT
                    return Err(s"${p.name} + 0x${hex(o)}: DORMANT, the crystal stopped until a dormant wake, is not modelled")
                val r = xosc_offset(o)
                if r == NO_OFFSET then Err(AccessError.Unmapped) else self.xosc.write(r, width, x)
            PllSys -> if pll_lacks(o) then Err(AccessError.Unmapped) else self.pll_sys.write(o, width, x)
            PllUsb -> if pll_lacks(o) then Err(AccessError.Unmapped) else self.pll_usb.write(o, width, x)
            Watchdog ->
                // TRIGGER resets the chip at once.
                val r = self.watchdog.write(o, width, x)
                self.watchdog_fired()
                r
            Timer -> self.timer.write(o, width, x)
            IoBank0 ->
                self.io.unmodelled(o, width, x) match
                    Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
                    None -> ()
                val r = self.io.write(o, width, x)
                self.gpio_changed()
                r
            PadsBank0 ->
                val r = self.pads.write(o, width, x)
                self.gpio_changed()
                r
            PwmBlock -> return self.pwm_write(p, o, width, x)
            Uart0 -> return self.uart_write(0, p, o, width, x)
            Uart1 -> return self.uart_write(1, p, o, width, x)
            Spi0 -> return self.spi_write(0, p, o, width, x)
            Spi1 -> return self.spi_write(1, p, o, width, x)
            I2c0 | I2c1 -> return self.i2c_write40(p, o, width, x)
            Psm ->
                val before = self.psm
                val r = self.psm.write(o, width, x)
                val newly = self.psm.off & ~before.off
                if newly & ~psm_reg.FRCE_OFF_PROC1_MASK != 0
                    self.psm = before
                    return Err(s"PSM FRCE_OFF of ${psm_stage_name_rp2040(newly & ~psm_reg.FRCE_OFF_PROC1_MASK)} is not modelled: only PROC1 can be forced off")
                self.core1_held(before.held(), self.psm.held())
                r
            Rosc ->
                val r = self.rosc.write(rosc_offset(o), width, x)
                // DORMANT with a dormant-wake interrupt already asserted wakes again at once.
                if self.io.irq.line(rp.DORMANT_WAKE) then self.rosc.wake()
                r
            SysInfo -> sysinfo_write(o, width)
            TbMan -> tbman_write(o, width)
            SysCfg -> self.syscfg_write(o, width, x)
            BusCtrlBlock -> return self.busctrl.write(o, width, x).map_err(f -> bus_refusal40(p, o, f))
            Rtc -> return self.rtc.write(o, width, x)
            AdcBlock -> return self.adc_write(p, o, width, x)
            Vreg -> return self.vreg.write(o, width, x)
            IoQspi -> return self.io_qspi_write(p, o, width, x)
            PadsQspi -> return self.pads_qspi_write(p, o, width, x)
        got.map_err(e -> refusal40(p, o, e))

    // A write to IO_QSPI, after the SSI is brought up to now: chip select follows SS's override at once.
    // Inverting the SSI's chip select is refused, leaving IO_QSPI as it was.
    private io_qspi_write(*self, p: Placed40, o: u32, width: u32, x: u32) -> Result[unit, string]
        self.ssi_catch_up()?
        val before = self.io_qspi
        self.io_qspi.write(o, width, x).map_err(e -> refusal40(p, o, e))?
        if self.qspi_cs() == io_qspi_reg.GPIO_QSPI_SS_CTRL_OUTOVER_INVERT
            self.io_qspi = before
            return Err(s"${p.name} + 0x${hex(o)}: GPIO_QSPI_SS_CTRL OUTOVER 1 inverts the SSI's chip select, which is not modelled")
        self.cs_changed()

    // A write to PADS_QSPI, after the SSI is brought up to now: what the flash sees on its data pins
    // follows their output disables and pulls at once.
    private pads_qspi_write(*self, p: Placed40, o: u32, width: u32, x: u32) -> Result[unit, string]
        self.ssi_catch_up()?
        self.pads_qspi.write(o, width, x).map_err(e -> refusal40(p, o, e))?
        self.ssi.undriven = self.data_pads()
        Ok(())

    // What the flash sees on SD0, its data in from the SSI in SPI mode, as PADS_QSPI leaves the pad (OD
    // bit 7, PUE bit 3, PDE bit 2): the SSI's bits, or the pad's pull with its output disabled.
    private data_pads(*self) -> u32
        val pad = self.pads_qspi.pads[2]
        if pad & 0x80 == 0 then return r40.DRIVEN
        val up = pad & 0x08 != 0
        val down = pad & 0x04 != 0
        if up && !down then r40.PULLED_HIGH elif down && !up then r40.PULLED_LOW else r40.FLOATING

    // The SIO at the RP2040's offsets: the shared model's FIFOs, spinlocks, interpolators and low GPIO
    // bank, and each core's own divider.
    private sio_read(*self, core: u32, o: u32, width: u32) -> Result[u32, string]
        val address = o & 0xFFC
        if address >= sio_reg.DIV_UDIVIDEND_OFFSET && address <= sio_reg.DIV_CSR_OFFSET
            return self.dividers[core].read(o, width).map_err(e -> sio_refusal(o, e))
        if address == sio_reg.GPIO_HI_IN_OFFSET then return self.gpio_hi_in(o, width)
        val mapped = sio_offset(o)?
        self.sio.read(core, mapped, width, self.inputs()).map_err(e -> sio_refusal(o, e))

    // SYSCFG's two NMI masks, a bit per IRQ line; the rest of SYSCFG (PROC_CONFIG, the input
    // synchronizer bypasses, DBGFORCE, MEMPOWERDOWN) is refused.
    private syscfg_read(*self, o: u32, width: u32) -> Result[u32, AccessError]
        r40.access(o, width, true)?
        val k = o & 0xFFC
        if k > syscfg_reg.PROC1_NMI_MASK_OFFSET then return Err(AccessError.Unmapped)
        Ok(r40.read_lane(self.nmi_masks[k >> 2], o, width))

    private syscfg_write(*self, o: u32, width: u32, x: u32) -> Result[unit, AccessError]
        r40.access(o, width, true)?
        val k = o & 0xFFC
        if k > syscfg_reg.PROC1_NMI_MASK_OFFSET then return Err(AccessError.Unmapped)
        self.nmi_masks[k >> 2] = written(self.nmi_masks[k >> 2], o, replicated(x, width)) & ((1u32 << RP2040_IRQS) - 1)
        Ok(())

    // GPIO_HI_IN, of which only SS (bit 1) is modelled: the flash's chip select line, high unless the
    // SSI or IO_QSPI's override drives it low. That is the boot ROM's BOOTSEL read, and the button is
    // never pressed. The other five pins (SCLK, SD0–3) read 0: their levels are not modelled.
    private gpio_hi_in(*self, o: u32, width: u32) -> Result[u32, string]
        r40.access(o, width, false).map_err(e -> sio_refusal(o, e))?
        self.ssi_catch_up()?
        self.cs_changed()?
        Ok(r40.read_lane(if self.flash.selected then 0 else 2, o, width))

    private sio_write(*self, core: u32, o: u32, width: u32, x: u32) -> Result[unit, string]
        val address = o & 0xFFC
        if address >= sio_reg.DIV_UDIVIDEND_OFFSET && address <= sio_reg.DIV_CSR_OFFSET
            return self.dividers[core].write(o, width, x).map_err(e -> sio_refusal(o, e))
        val mapped = sio_offset(o)?
        val gpio = address >= sio_reg.GPIO_OUT_OFFSET && address <= sio_reg.GPIO_OE_XOR_OFFSET
        self.sio.write(core, mapped, width, if gpio then x & GPIO_MASK_RP2040 else x).map_err(e -> sio_refusal(o, e))?
        if gpio then self.gpio_changed()
        Ok(())

    // PROC1 has gone into reset or come out of it, between the stages held `before` and `after`.
    private core1_held(*self, before: u32, after: u32)
        val bit = psm_reg.FRCE_OFF_PROC1_MASK
        if before & bit == 0 && after & bit != 0
            self.core1_reset = true
        elif before & bit != 0 && after & bit == 0
            self.core1_release = true

    // The block an access lands in, refused where none is there, or where RESETS holds it.
    private placed(*self, a: u32) -> Result[(Placed40, u32), string]
        for p in BLOCKS_RP2040
            if a >= p.base && a - p.base < WINDOW_RP2040
                if self.resets.held & p.reset != 0 then return Err(s"${p.name} is held in reset (RESETS bit ${p.reset.trailing_zeros()}): release it before touching 0x${hex(a)}")
                return Ok((p, a - p.base))
        Err(absent_refusal(a))

    // Power-on state for each block whose reset has just been asserted.
    private reset_blocks(*self, asserted: u32)
        if asserted == 0 then return
        for p in BLOCKS_RP2040
            if p.reset & asserted == 0 then continue
            p.block match
                PllSys -> self.pll_sys.reset()
                PllUsb -> self.pll_usb.reset()
                Timer -> self.timer.reset()
                IoBank0 -> self.io.reset()
                PadsBank0 -> self.pads.reset()
                Uart0 -> self.uarts[0].reset()
                Uart1 -> self.uarts[1].reset()
                Spi0 -> self.spi.reset(0)
                Spi1 -> self.spi.reset(1)
                I2c0 -> self.i2c.reset_unit(0)
                I2c1 -> self.i2c.reset_unit(1)
                Rtc -> self.rtc.reset()
                PwmBlock -> self.pwm.reset()
                AdcBlock -> self.adc.reset()
                IoQspi -> self.io_qspi.reset()
                PadsQspi ->
                    self.pads_qspi.reset()
                    self.ssi.undriven = self.data_pads()
                _ -> ()

    // A write to SPI `k` (`Rp2350.spi_write`).
    private spi_write(*self, k: usize, p: Placed40, o: u32, width: u32, x: u32) -> Result[unit, string]
        self.spi.unmodelled(k, o, width, x) match
            Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
            None -> ()
        if o & 0xFFC == 4 && x & 2 != 0
            for g in 0..<GPIO_COUNT_RP2040
                val mine = rp.route(g, self.io.function(g)) match
                    SpiSck | SpiTx | SpiRx -> spi_of(g) == k
                    _ -> false
                if mine && self.io.irq.watched(g) then return Err(s"${p.name} + 0x${hex(o)}: enabled with GPIO $g, one of its pins, watched by the GPIO interrupts, which do not sample the clock's edges")
        self.spi.write(self, k, o, width, x).map_err(e -> refusal40(p, o, e))

    // A write to UART `k`, refused where it asks for something benchtop does not model; a refused write
    // leaves the UART as it was (`Rp2350.uart_write`).
    private uart_write(*self, k: usize, p: Placed40, o: u32, width: u32, x: u32) -> Result[unit, string]
        self.uarts[k].unmodelled(o, width, x) match
            Some(why) -> return Err(s"${p.name} + 0x${hex(o)}: $why")
            None -> ()
        val before = self.uarts[k]
        self.uarts[k].write(o, width, x).map_err(e -> refusal40(p, o, e))?
        if self.uarts[k].unclocked()
            self.uarts[k] = before
            return Err(s"${p.name} + 0x${hex(o)}: a character waits to be sent and the latched baud divisor has IBRD 0, which times no frame (IBRD takes effect at an LCR_H write)")
        if self.uarts[k].take_started()
            self.check_frame(k) match
                Some(why) ->
                    self.uarts[k] = before
                    return Err(s"${p.name} + 0x${hex(o)}: $why")
                None -> ()
        Ok(())

    /** What the producer FUNCSEL routes to GPIO `n` drives it with, after CTRL's overrides. */
    drive(*self, n: u32) -> Drive
        val d = rp.route(n, self.io.function(n)) match
            Sio -> Drive(self.sio.out & (1u64 << n) != 0, self.sio.oe & (1u64 << n) != 0)
            UartTx -> Drive(self.uarts[uart_of(n)].line_level(), true)
            Pwm -> rp.pwm_drive(&self.pwm, n)
            SpiSck -> Drive(self.spi.sck(spi_of(n)), self.spi.enabled(spi_of(n)))
            SpiTx -> Drive(self.spi.tx(spi_of(n)), self.spi.enabled(spi_of(n)))
            UartRx | SpiRx | Null | I2cSda | I2cScl -> Drive(false, false)
            // The RP2040 has no HSTX: its FUNCSEL 0 on GPIOs 12 to 19 is refused before it can route.
            Hstx -> Drive(false, false)
            // PIO's FUNCSELs are refused while the blocks are not on this chip (`unmodelled_function`).
            Pio0 | Pio1 | Pio2 -> Drive(false, false)
        self.io.after_overrides(n, d)

    /** What GPIO `n` is doing: whether its pad drives, and its level. */
    pin(*self, n: u32) -> Pin
        val bit = 1u64 << u64(n)
        self.pads.pin(n, self.drive(n), if self.outside_driven & bit != 0 then Some(self.outside_level & bit != 0) else None)

    /** Drive GPIO `n` from off the chip at `level`, or leave it undriven with None. */
    drive_from_outside(*self, n: u32, level: Option[bool])
        val bit = 1u64 << u64(n)
        level match
            Some(v) ->
                self.outside_driven |= bit
                self.outside_level = if v then self.outside_level | bit else self.outside_level & ~bit
            None -> self.outside_driven &= ~bit
        self.gpio_changed()

    private drives(*self) -> [GPIO_COUNT]Drive
        var all: [GPIO_COUNT]Drive
        for n in 0..<GPIO_COUNT_RP2040 do all[n] = self.drive(n)
        all

    private pins(*self) -> [GPIO_COUNT]Pin
        var all: [GPIO_COUNT]Pin
        for n in 0..<GPIO_COUNT_RP2040 do all[n] = self.pin(n)
        all

    // GPIO_IN: each pad's input after INOVER, bit n for GPIO n.
    private inputs(*self) -> u64
        var bits: u64 = 0
        for n in 0..<GPIO_COUNT_RP2040 do if self.io.peripheral_input(n, self.pin(n).input) then bits |= 1u64 << n
        bits

    // What the GPIO interrupts see: each pad's input after IRQOVER.
    private irq_inputs(*self) -> u64
        var bits: u64 = 0
        for n in 0..<GPIO_COUNT_RP2040 do if self.io.irq_input(n, self.pin(n).input) then bits |= 1u64 << n
        bits

    /** Something that decides a GPIO's level may have changed: the GPIO interrupts sample their inputs
     * again, except while RESETS holds IO_BANK0. A dormant-wake interrupt wakes a dormant ROSC.
     */
    gpio_changed(*self)
        self.io.irq.sample(self.irq_inputs(), self.resets.held & resets_reg.RESET_IO_BANK0_MASK == 0)
        if self.io.irq.line(rp.DORMANT_WAKE) then self.rosc.wake()
        if self.pwm.enabled != 0 || self.pwm_stepping then self.pwm_gpio_changed()
end Rp2040

/** The RP2040 at power-on, with core 1 in the boot ROM. */
rp2040() -> Rp2040 =
    Rp2040(r40.resets(), rp.clocks_rp2040(), rp.xosc(), rp.pll(), rp.pll(), r40.watchdog(), r40.timer(), rp.sio_rp2040(),
        [divider(), divider()], rp.io_bank0_rp2040(), rp.pads_bank0_rp2040(), [rp.uart(), rp.uart()], rp.psm_rp2040(), rp.rosc(),
        rp.sysinfo(), rp.busctrl(false), 0, [0; 1024], [0, 0], r40.ssi(), r40.xip_ctrl(), w25q16jv(), rp.io_qspi_rp2040(), rp.qspi_pads_rp2040(), r40.vreg(), r40.rtc(), 0, true,
        false, false, 0, 0, 0, 0, 0, 0, 0, 0, "", r40.pwm_rp2040(), false, false, rp.spis(),
        r40.adc("RP2040", adc_reg.CS_AINSEL_MASK, adc_reg.CS_RROBIN_MASK), 0, r40.analog_in(), i2c_bus(buf()))

// An SPI's MISO is the level its RX pin reads (`Rp2350`'s SpiHost).
impl SpiHost for Rp2040
    spi_miso(*self, unit: usize) -> bool
        for b in 0u32..<6
            val n = 16 * (b / 2) + 4 * (b % 2) + 8 * u32(unit)
            if n < GPIO_COUNT_RP2040 && rp.route(n, self.io.function(n)) == rp.Route.SpiRx then return self.io.peripheral_input(n, self.pin(n).input)
        false

impl ArmChip for Rp2040
    const rp2350() -> bool = false
    clock(*self) -> u64 = self.now
    run_to(*self, t: u64) = if t > self.now then self.advance(t - self.now)
    pass(*self, cycles: u64) = self.advance(cycles)

    /** The clk_sys cycles until the next device event that could wake a core: a timer alarm, the
     * watchdog firing, a UART line's next event, the RTC's next second while its alarm is armed, an ADC
     * sample something waits for, or a PWM wrap an interrupt waits for (or the next PWM edge while the
     * chip walks them).
     */
    due(*self) -> Option[u64]
        var due: Option[u64] = None
        self.watchdog.counter.ticks_to_fire(0) match
            Some(n) -> due = self.ticks_to_cycles(n)
            None -> ()
        self.timer.next_alarm(0) match
            Some(n) -> due = earliest(due, self.ticks_to_cycles(n))
            None -> ()
        if self.adc.wakes() then due = earliest(due, self.adc_due())
        earliest(earliest(earliest(earliest(due, self.line_due()), self.rtc_due()), self.pwm_due()), self.i2c_due())

    load(*self, core: u32, a: u32, width: u32) -> Result[u32, string]
        // The board maps the ROM on the cores' fast path; an access that reaches the bus reads the same bytes.
        if a < ROM_BYTES_RP2040
            if a & (width - 1) != 0 then return Err(s"0x${hex(a, 8)} in the boot ROM is not aligned to its width")
            return Ok(rom_read_rp2040(a, width))
        if a >= XIP_BASE_RP2040 && a < XIP_END_RP2040 then return self.xip_load(a, width)
        self.read(core, a, width)

    store(*self, core: u32, a: u32, width: u32, x: u32) -> Result[unit, string]
        if a == ROM_DOORBELL_RP2040 && width == 4 then return Err(rom_doorbell_refusal(x))
        if a < ROM_BYTES_RP2040 then return Err(s"0x${hex(a, 8)} is the boot ROM, which is read-only: what a write there does on silicon is not modelled")
        if a >= XIP_BASE_RP2040 && a < XIP_END_RP2040 then return self.xip_store(a, width, x)
        self.write(core, a, width, x)

    /** The lines both cores share, high at the moment: the TIMER's alarms, the SPIs, the UARTs, the RTC,
     * the ADC's FIFO and the PWM's wrap.
     */
    shared_lines(*self) -> u64
        var lines = u64(self.timer.irqs() & 0xF) << TIMER_IRQ_0
        if self.spi.irq(0) then lines |= 1u64 << SPI0_IRQ_RP2040
        if self.spi.irq(1) then lines |= 1u64 << SPI1_IRQ_RP2040
        if self.uarts[0].irq() then lines |= 1u64 << UART0_IRQ_RP2040
        if self.uarts[1].irq() then lines |= 1u64 << UART1_IRQ_RP2040
        if self.rtc.irq() then lines |= 1u64 << RTC_IRQ_RP2040
        if self.pwm.irq(0) then lines |= 1u64 << PWM_IRQ_WRAP_RP2040
        if self.adc.irq() then lines |= 1u64 << ADC_IRQ_FIFO_RP2040
        lines | u64(self.i2c.lines & 3) << I2C0_IRQ_RP2040

    /** The lines only core `k` has, high at the moment: its IO_IRQ_BANK0 and its SIO FIFO line. */
    core_lines(*self, k: u32) -> u64
        var lines: u64 = 0
        if self.io.irq.line(k) then lines |= 1u64 << IO_IRQ_BANK0_RP2040
        if self.sio.fifo_irq(k) then lines |= 1u64 << (if k == 0 then SIO_IRQ_PROC0 else SIO_IRQ_PROC1)
        lines

    /** Whether a read of `a` can lower a shared line: a UART's UARTDR, an SPI's SSPDR or the ADC's FIFO,
     * each popping a FIFO, or any read of an I2C controller, whose IC_CLR_* reads clear its interrupts
     * and whose IC_DATA_CMD pops its receive FIFO.
     */
    @inline
    read_lowers(*self, a: u32) -> bool
        val w = a & ~3u32
        w == uart0_reg.BASE + uart0_reg.UARTDR_OFFSET || w == uart1_reg.BASE + uart1_reg.UARTDR_OFFSET ||
            w == spi0_reg.BASE + spi0_reg.SSPDR_OFFSET || w == spi1_reg.BASE + spi1_reg.SSPDR_OFFSET ||
            w == adc_reg.BASE + adc_reg.FIFO_OFFSET || w -% i2c0_reg.BASE < WINDOW_RP2040 || w -% i2c1_reg.BASE < WINDOW_RP2040

    core1_stopped(*self) -> bool
        val held = self.core1_reset
        self.core1_reset = false
        held

    core1_started(*self) -> bool
        val released = self.core1_release
        self.core1_release = false
        released

    /** Whether a watchdog reset the board has not yet taken has reset core `k`'s PSM stage. */
    resetting(*self, k: u32) -> bool = self.restart & (if k == 0 then psm_reg.WDSEL_PROC0_MASK else psm_reg.WDSEL_PROC1_MASK) != 0

    take_reset(*self) -> Option[u32]
        if self.restart == 0 then return None
        val r = self.restart
        self.restart = 0
        Some(r)

    take_fault(*self) -> Option[string]
        if !self.i2c.fault.is_empty()
            val why = self.i2c.fault
            self.i2c.fault = ""
            return Some(why)
        if self.fault.is_empty() then return None
        val why = self.fault
        self.fault = ""
        Some(why)

    console(*self) -> Option[u8] = self.uarts[0].take()
    console_due(*self) -> Option[u64] = if self.uarts[0].sending() then self.uart_due() else None

// Whether `a` is USBCTRL's SIE_CTRL, through any of its aliases.
private is_sie_ctrl(a: u32) -> bool = a >= usb_reg.BASE && a < usb_reg.BASE + WINDOW_RP2040 && (a - usb_reg.BASE) & 0xFFC == usb_reg.SIE_CTRL_OFFSET

// No offset: a register the RP2350's model has where the RP2040 has none.
private const NO_OFFSET: u32 = 0xFFFFFFFF

// XOSC's offset in the shared model: COUNT is at 0x1C on the RP2040 and 0x10 on the RP2350, and the
// RP2040 has nothing between STARTUP and COUNT.
private xosc_offset(o: u32) -> u32
    val address = o & 0xFFC
    if address == xosc_reg.COUNT_OFFSET then return (o & ~0xFFCu32) | 0x10
    if address >= 0x10 then NO_OFFSET else o

// Whether `o` is one of the shared PLL model's INTR, INTE, INTF and INTS, which the RP2040's PLL lacks.
private pll_lacks(o: u32) -> bool = o & 0xFFC >= 0x10

// ROSC's offset in the shared model, which has RANDOM at 0x0C, before DORMANT: the RP2040's registers
// from DORMANT on sit a word lower.
private rosc_offset(o: u32) -> u32 = if o & 0xFFC >= rosc_reg.DORMANT_OFFSET then o + 4 else o

// The SIO offset `o` as the shared model has it, or why it is refused.
private sio_offset(o: u32) -> Result[u32, string]
    val address = o & 0xFFC
    if address >= sio_reg.GPIO_OUT_OFFSET && address <= sio_reg.GPIO_OE_XOR_OFFSET
        return Ok(SIO_GPIO_RP2350[(address - sio_reg.GPIO_OUT_OFFSET) / 4] | (o & 3))
    if address >= sio_reg.GPIO_HI_OUT_OFFSET && address <= sio_reg.GPIO_HI_OE_XOR_OFFSET
        return Err(s"SIO + 0x${hex(o)}: the GPIO_HI bank drives the QSPI pins as levels, which benchtop does not model: the pins are the flash's, reached through the SSI")
    if address > sio_reg.SPINLOCK31_OFFSET then return Err(s"SIO + 0x${hex(o)} is not a register of the RP2040's SIO")
    Ok(o)

private sio_refusal(o: u32, e: AccessError) -> string = s"SIO + 0x${hex(o)} ${what_refused(e)}"

// SYSINFO: the B2 stepping's CHIP_ID (revision 2, part 0x0002, manufacturer 0x927), an ASIC, and a
// GITREF of 0, as the RP2350 model has it. Writes to the read-only registers are dropped.
private const CHIP_ID_RP2040: u32 = 0x20002927

private sysinfo_read(o: u32, width: u32) -> Result[u32, AccessError]
    r40.access(o, width, true)?
    val value = o & 0xFFC match
        sysinfo_reg.CHIP_ID_OFFSET -> CHIP_ID_RP2040
        sysinfo_reg.PLATFORM_OFFSET -> 0x2
        sysinfo_reg.GITREF_RP2040_OFFSET -> 0
        _ -> return Err(AccessError.Unmapped)
    Ok(r40.read_lane(value, o, width))

private sysinfo_write(o: u32, width: u32) -> Result[unit, AccessError]
    r40.access(o, width, true)?
    o & 0xFFC match
        sysinfo_reg.CHIP_ID_OFFSET | sysinfo_reg.PLATFORM_OFFSET | sysinfo_reg.GITREF_RP2040_OFFSET -> Ok(())
        _ -> Err(AccessError.Unmapped)

// TBMAN, its one register: PLATFORM reads ASIC, which the boot ROM's `watchdog_reboot` and boot path
// check before choosing their timings (`tbman.h`). It is read-only; a write is dropped.
private tbman_read(o: u32, width: u32) -> Result[u32, AccessError]
    r40.access(o, width, true)?
    if o & 0xFFC != tbman_reg.PLATFORM_OFFSET then return Err(AccessError.Unmapped)
    Ok(r40.read_lane(tbman_reg.PLATFORM_ASIC_MASK, o, width))

private tbman_write(o: u32, width: u32) -> Result[unit, AccessError]
    r40.access(o, width, true)?
    if o & 0xFFC != tbman_reg.PLATFORM_OFFSET then Err(AccessError.Unmapped) else Ok(())

/** `width` bytes at `at` in the ROM, little-endian; `at` must be inside it. */
rom_read_rp2040(at: u32, width: u32) -> u32
    var v: u32 = 0
    for k in 0u32..<width do v |= u32(ROM_RP2040[usize(at + k)]) << (8 * k)
    v

/** The little-endian word at `at` in the ROM. */
rom_word_rp2040(at: u32) -> u32 = rom_read_rp2040(at, 4)

/** What the ROM's doorbell refuses, by the word it was rung with (`rom/rp2040/image/boot.sysl`'s
 * `BELL_*`).
 */
rom_doorbell_refusal(why: u32) -> string
    val usb = "the RP2040's USB device controller is not on the chip yet"
    if why == 1 then return s"the boot ROM's USB boot, entered because BOOTSEL is held: $usb"
    if why == 2 then return s"the boot ROM's USB boot, entered because the flash holds no valid boot2 (its CRC32 does not match): $usb"
    if why == 3 then return s"the boot ROM's USB boot, entered from reset_usb_boot's watchdog reboot: $usb"
    val code = why & 0xFFFF
    if why >> 16 == 1
        val name = s"${char_from_u32(code & 0xFF).unwrap_or('?')}${char_from_u32(code >> 8).unwrap_or('?')}"
        return s"the boot ROM's table entry '$name' (code 0x${hex(code, 4)}), which the RP2040's ROM has, is not provided by benchtop's ROM"
    if why >> 16 == 2
        val table = if code >= 0x100 then "soft double" else "soft float"
        return s"the boot ROM's $table table entry at 0x${hex(code & 0xFF, 2)} (the comparison that answers in the flags) is not provided by benchtop's ROM"
    if why >> 16 == 3 then return s"exception ${code} taken through the boot ROM's own vector table (VTOR 0): the ROM has no handler for it"
    s"the boot ROM rang its doorbell with 0x${hex(why, 8)}, which names nothing"

// An access to the XIP address space that reaches nothing: XIP_SRAM while the cache is not SRAM
// (`closed` says why), or an address between the blocks.
private xip_refusal40(a: u32, closed: string) -> string
    if a >= XIP_SRAM_BASE_RP2040 && a < XIP_SRAM_BASE_RP2040 + XIP_SRAM_BYTES_RP2040 then return s"0x${hex(a, 8)} is XIP_SRAM: $closed"
    s"0x${hex(a, 8)} is in the RP2040's XIP address space, where nothing is: not the flash's aliases, XIP_CTRL, XIP_SRAM or the SSI"

// An access that no running block takes: a named block not on the chip yet, or nothing at all.
private absent_refusal(a: u32) -> string
    for b in ABSENT_RP2040 do if a >= b.base && a - b.base < b.size then return s"${b.name} + 0x${hex(a - b.base)}: ${b.why}"
    s"0x${hex(a, 8)} is not on the RP2040's bus as benchtop runs it"

private bus_refusal40(p: Placed40, o: u32, f: BusFault) -> string = f match
    Access(e) -> refusal40(p, o, e)
    Refused(why) -> s"${p.name} + 0x${hex(o)}: $why"

private[chip] refusal40(p: Placed40, o: u32, e: AccessError) -> string = s"${p.name} + 0x${hex(o)} ${what_refused(e)}"

private[chip] what_refused(e: AccessError) -> string = e match
    Unmapped -> "is not a register benchtop runs"
    InvalidWidth -> "is not an access width the block takes"
    Unaligned -> "is not aligned to its width"
    UnsupportedAlias -> "cannot be written through an atomic alias"
