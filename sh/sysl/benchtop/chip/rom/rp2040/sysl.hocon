// benchtop's own RP2040 boot ROM, the library half: the soft float and double routines, the bit and
// memory functions, the flash functions through the SSI, core 0's boot path and core 1's launch wait.
// `image/` builds it for the Cortex-M0+ into the 16 KB the `pico` board maps at 0 (`image/build.sh`);
// benchtop's own tests also compile it for the host, to check the emulated ROM against the same code.

package {
  name    = "rp2040rom"
  version = "0.0.0"
  sysl    = "0.8.9"
}

dependencies {
  // SVD-generated register offsets and masks.
  rp2040 { git = "github.com/sysl-lang/rp2040", version = "0.1.2" }
}
