import sh.sysl.rp2040rom as rom
import sh.sysl.rp2040rom.oracle.*
import sysl.time.monotonic

// The ROM's float and double routines against the host, at a scale benchtop's own tests do not run:
// every one of the 2^32 inputs of each binary32 function of one operand, and millions of edge-biased
// inputs for the rest (`oracle.sysl` says what the oracle is and where the ROM documents a difference).
// Run it built for speed, one part a process:
//
//     sysl build -O2 . -o sweep && ./sweep sqrt32
//
// Each part prints `<part> <cases> pass <mismatches> mismatch`, up to five mismatches, and its time.

/** The parts, in the order `all` runs them. */
val PARTS: [9]string = ["sqrt32", "from32", "to32", "binary32", "sci32", "binary64", "unary64", "sci64", "from64"]

/** A run's count, its mismatches and the first few. */
struct Count
    n: u64
    bad: u64
    first: string

    add(*self, why: string)
        self.n += 1
        if why == "" then return
        self.bad += 1
        if self.bad <= 5 then self.first = s"${self.first}  $why\n"
end Count

// The binary32 operation of one operand's oracle check, the whole 2^32.
private all32(c: *Count, check: (u32) -> string)
    var a: u64 = 0
    while a < 0x100000000
        c.add(check(u32(a)))
        a += 1

/** Run one part. */
run(part: string) -> Count
    var c = Count(0, 0, "")
    var r = Rng(0x5DEECE66D1234567)
    part match
        "sqrt32" -> all32(&c, a -> check1f(Op1f.Sqrt, a))
        "from32" -> all32(&c, a -> check_from_float(a, i32((a >> 3) % 65) - 32))
        "to32" -> all32(&c, v -> check_to_float(v, (u64(v) << 32) | u64(v.reverse_bits()), i32(v % 121) - 60))
        "binary32" ->
            for op in [Op2f.Add, Op2f.Sub, Op2f.Mul, Op2f.Div]
                for k in 0..<4000000
                    val a = edge32(&r)
                    c.add(check2f(op, a, partner32(&r, a)))
        "sci32" ->
            for op in [Op1f.Sin, Op1f.Cos, Op1f.Tan, Op1f.Exp, Op1f.Ln]
                for k in 0..<1000000
                    var a = edge32(&r)
                    if (op == Op1f.Sin || op == Op1f.Cos || op == Op1f.Tan) && a & 0x7FFFFFFF >= 0x43000000 && a & 0x7FFFFFFF < 0x7F800000 then a = a & 0xC2FFFFFF
                    c.add(check1f(op, a))
            for k in 0..<1000000
                val a = edge32(&r)
                c.add(check2f(Op2f.Atan2, a, partner32(&r, a)))
        "binary64" ->
            for op in [Op2f.Add, Op2f.Sub, Op2f.Mul, Op2f.Div]
                for k in 0..<4000000
                    val a = edge64(&r)
                    c.add(check2d(op, a, partner64(&r, a)))
        "unary64" ->
            for k in 0..<4000000 do c.add(check1d(Op1f.Sqrt, edge64(&r)))
        "sci64" ->
            for op in [Op1f.Sin, Op1f.Cos, Op1f.Tan, Op1f.Exp, Op1f.Ln]
                for k in 0..<1000000
                    var a = edge64(&r)
                    if (op == Op1f.Sin || op == Op1f.Cos || op == Op1f.Tan) && a & 0x7FFFFFFFFFFFFFFF >= 0x4090000000000000 && a & 0x7FFFFFFFFFFFFFFF < 0x7FF0000000000000 then a = a & 0xC08FFFFFFFFFFFFF
                    c.add(check1d(op, a))
            for k in 0..<1000000
                val a = edge64(&r)
                c.add(check2d(Op2f.Atan2, a, partner64(&r, a)))
        "from64" ->
            for k in 0..<4000000 do c.add(check_from_double(edge64(&r), i32(r.next() % 101) - 50))
        _ -> c.add(s"no part called $part: one of ${PARTS}")
    c
end run

main(args: []string)
    val parts: []const string = if args.len > 1 && args[1] != "all" then args[1..] else PARTS
    var failed = 0
    for part in parts
        val start = monotonic()
        val c = run(part)
        val secs = (monotonic().us - start.us) / 1000000
        print(s"$part ${c.n} pass ${c.bad} mismatch, ${secs} s")
        if c.bad != 0
            print(c.first)
            failed += 1
    exit(failed)
