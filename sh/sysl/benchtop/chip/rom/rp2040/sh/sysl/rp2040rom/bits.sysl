module sh.sysl.rp2040rom

import sysl.raw.ptr_cast

// The ROM's bit functions (`popcount32`, `clz32`, `ctz32`, `reverse32`) and its memory functions
// (`memset`, `memset4`, `memcpy`, `memcpy44`), which the SDK's `pico_bit_ops` and `pico_mem_ops` call
// in place of the compiler's.

/** The number of set bits. */
popcount32(x: u32) -> u32 = x.count_ones()
/** The leading zeros: 32 for 0. */
clz32(x: u32) -> u32 = x.leading_zeros()
/** The trailing zeros: 32 for 0. */
ctz32(x: u32) -> u32 = x.trailing_zeros()
/** The bits in the opposite order. */
reverse32(x: u32) -> u32 = x.reverse_bits()

/** `n` bytes at `ptr` set to `c`, a word at a time where `ptr` is aligned; answers `ptr`. */
memset(ptr: *u8, c: u8, n: usize) -> *u8
    var i: usize = 0
    if usize(ptr) & 3 == 0 && n >= 4
        val w: *u32 = ptr_cast(ptr)
        val word = u32(c) * 0x01010101
        while i + 4 <= n
            w[i >> 2] = word
            i += 4
    while i < n
        ptr[i] = c
        i += 1
    ptr

/** `memset` where `ptr` is word-aligned (`__aeabi_memset4`), any `n`. */
memset4(ptr: *u8, c: u8, n: usize) -> *u8 = memset(ptr, c, n)

/** `n` bytes copied from `src` to `dest`, which do not overlap, a word at a time where both are
 * aligned; answers `dest`.
 */
memcpy(dest: *u8, src: *u8, n: usize) -> *u8
    var i: usize = 0
    if (usize(dest) | usize(src)) & 3 == 0
        val d: *u32 = ptr_cast(dest)
        val s: *u32 = ptr_cast(src)
        while i + 4 <= n
            d[i >> 2] = s[i >> 2]
            i += 4
    while i < n
        dest[i] = src[i]
        i += 1
    dest

/** `memcpy` where both are word-aligned (`__aeabi_memcpy4`), any `n`. */
memcpy44(dest: *u8, src: *u8, n: usize) -> *u8 = memcpy(dest, src, n)
