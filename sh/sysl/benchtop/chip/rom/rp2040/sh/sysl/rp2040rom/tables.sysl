module sh.sysl.rp2040rom

// The soft float and double tables (`SF_TABLE_*` in the SDK's `pico/bootrom/sf_table.h`): a struct of
// typed function pointers each, in the table's order. The ROM image places one of each with its size
// in words in the byte two before it; the cross-check firmware (`examples/pico/rom_crosscheck`) holds
// another of each, to call this code beside the chip's own ROM through the same offsets.

/** A table's size in words, in the byte two before it, as the SDK's setup reads it. */
const TABLE_WORDS: u8 = 32

/** The soft float table. */
struct SoftFloat
    fadd: *extern(u32, u32) -> u32
    fsub: *extern(u32, u32) -> u32
    fmul: *extern(u32, u32) -> u32
    fdiv: *extern(u32, u32) -> u32
    fcmp_fast: *extern(u32, u32) -> i32
    fcmp_fast_flags: *extern(u32, u32) -> i32
    fsqrt: *extern(u32) -> u32
    float2int: *extern(u32) -> i32
    float2fix: *extern(u32, i32) -> i32
    float2uint: *extern(u32) -> u32
    float2ufix: *extern(u32, i32) -> u32
    int2float: *extern(i32) -> u32
    fix2float: *extern(i32, i32) -> u32
    uint2float: *extern(u32) -> u32
    ufix2float: *extern(u32, i32) -> u32
    fcos: *extern(u32) -> u32
    fsin: *extern(u32) -> u64
    ftan: *extern(u32) -> u32
    fsincos: *extern(u32) -> u64
    fexp: *extern(u32) -> u32
    fln: *extern(u32) -> u32
    fcmp_basic: *extern(u32, u32) -> i32
    fatan2: *extern(u32, u32) -> u32
    int642float: *extern(i64) -> u32
    fix642float: *extern(i64, i32) -> u32
    uint642float: *extern(u64) -> u32
    ufix642float: *extern(u64, i32) -> u32
    float2int64: *extern(u32) -> i64
    float2fix64: *extern(u32, i32) -> i64
    float2uint64: *extern(u32) -> u64
    float2ufix64: *extern(u32, i32) -> u64
    float2double: *extern(u32) -> u64

/** The soft double table, at the same offsets with doubles for floats: `float2double`'s entry is
 * `double2float`, and the V3 `sincos` entry answers the sine in r0:r1 and the cosine in r2:r3.
 */
struct SoftDouble
    dadd: *extern(u64, u64) -> u64
    dsub: *extern(u64, u64) -> u64
    dmul: *extern(u64, u64) -> u64
    ddiv: *extern(u64, u64) -> u64
    dcmp_fast: *extern(u64, u64) -> i32
    dcmp_fast_flags: *extern(u64, u64) -> i32
    dsqrt: *extern(u64) -> u64
    double2int: *extern(u64) -> i32
    double2fix: *extern(u64, i32) -> i32
    double2uint: *extern(u64) -> u32
    double2ufix: *extern(u64, i32) -> u32
    int2double: *extern(i32) -> u64
    fix2double: *extern(i32, i32) -> u64
    uint2double: *extern(u32) -> u64
    ufix2double: *extern(u32, i32) -> u64
    dcos: *extern(u64) -> u64
    dsin: *extern(u64) -> u64
    dtan: *extern(u64) -> u64
    dsincos: *extern(u64) -> u128
    dexp: *extern(u64) -> u64
    dln: *extern(u64) -> u64
    dcmp_basic: *extern(u64, u64) -> i32
    datan2: *extern(u64, u64) -> u64
    int642double: *extern(i64) -> u64
    fix642double: *extern(i64, i32) -> u64
    uint642double: *extern(u64) -> u64
    ufix642double: *extern(u64, i32) -> u64
    double2int64: *extern(u64) -> i64
    double2fix64: *extern(u64, i32) -> i64
    double2uint64: *extern(u64) -> u64
    double2ufix64: *extern(u64, i32) -> u64
    double2float: *extern(u64) -> u32

/** The float sine with the cosine in r1, as the SDK's `sincosf` reads the FSIN entry. */
fsin_cos(x: u32) -> u64
    val s, c = fsincos(x)
    u64(s) | (u64(c) << 32)

/** The double sine and cosine in r0 to r3, the V3 `sincos` entry's registers. */
dsin_cos(x: u64) -> u128
    val s, c = dsincos(x)
    u128(s) | (u128(c) << 64)

/** The soft float table of this package's routines; `flags` answers the comparison in the flags. */
soft_float(flags: *extern(u32, u32) -> i32) -> SoftFloat = SoftFloat(&fadd, &fsub, &fmul, &fdiv, &fcmp,
    flags, &fsqrt, &float2int, &float2fix, &float2uint, &float2ufix, &int2float, &fix2float, &uint2float,
    &ufix2float, &fcos, &fsin_cos, &ftan, &fsin_cos, &fexp, &fln, &fcmp, &fatan2, &int642float,
    &fix642float, &uint642float, &ufix642float, &float2int64, &float2fix64, &float2uint64, &float2ufix64,
    &float2double)

/** The soft double table of this package's routines. */
soft_double(flags: *extern(u64, u64) -> i32) -> SoftDouble = SoftDouble(&dadd, &dsub, &dmul, &ddiv, &dcmp,
    flags, &dsqrt, &double2int, &double2fix, &double2uint, &double2ufix, &int2double, &fix2double,
    &uint2double, &ufix2double, &dcos, &dsin, &dtan, &dsin_cos, &dexp, &dln, &dcmp, &datan2, &int642double,
    &fix642double, &uint642double, &ufix642double, &double2int64, &double2fix64, &double2uint64,
    &double2ufix64, &double2float)
