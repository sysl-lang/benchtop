module sh.sysl.rp2040rom.oracle

import sh.sysl.rp2040rom as rom
import sysl.fmt.hex

// One case of each routine against its oracle: the empty string where the ROM's answer is the
// oracle's, and a line naming the routine, the input and both answers where it is not.

/** The binary32 operations of two operands. */
enum Op2f
    Add
    Sub
    Mul
    Div
    Atan2

/** The binary32 operations of one operand. */
enum Op1f
    Sqrt
    Sin
    Cos
    Tan
    Exp
    Ln

/** How many units in the last place a float scientific function may lie from the host's libm, whose
 * double result rounded to a float is all but exact.
 */
const SCI_ULPS: u64 = 1
/** How many a double one may: the ROM's are within a hair of half a unit of the true value, and the
 * host's libm (macOS's) is not correctly rounded: its tan(1) is 3FF8EB245CBEE3A5 where the true
 * value 1.557407724654902230507 rounds to …A6, and its tan(2.0982…) (4000C905D3FEE913) is three units
 * from the true value, which the ROM's answer is. Correct rounding is checked against exact values
 * (`chip/rom40_float_tests.sysl`, `CORRECT64`) instead.
 */
const SCI_ULPS64: u64 = 3

/** The ROM's answer to a binary32 operation of two operands. */
rom2f(op: Op2f, a: u32, b: u32) -> u32 = op match
    Add -> rom.fadd(a, b)
    Sub -> rom.fsub(a, b)
    Mul -> rom.fmul(a, b)
    Div -> rom.fdiv(a, b)
    Atan2 -> rom.fatan2(a, b)

/** The oracle's. */
want2f(op: Op2f, a: u32, b: u32) -> u32
    val x = in32(a)
    val y = in32(b)
    op match
        Add -> out32(x + y)
        Sub -> out32(x - y)
        Mul -> out32(x * y)
        Div -> out32(x / y)
        Atan2 -> out32(f32(f64(x).atan2(f64(y))))

/** One case of a binary32 operation of two operands. */
check2f(op: Op2f, a: u32, b: u32) -> string
    val got = rom2f(op, a, b)
    val want = want2f(op, a, b)
    val ok = if op == Op2f.Atan2 then ulps32(got, want) <= SCI_ULPS else same32(got, want)
    if ok then "" else s"$op(0x${hex(a, 8)}, 0x${hex(b, 8)}) = 0x${hex(got, 8)}, want 0x${hex(want, 8)}"

/** The ROM's answer to a binary32 operation of one operand. */
rom1f(op: Op1f, a: u32) -> u32 = op match
    Sqrt -> rom.fsqrt(a)
    Sin -> rom.fsin(a)
    Cos -> rom.fcos(a)
    Tan -> rom.ftan(a)
    Exp -> rom.fexp(a)
    Ln -> rom.fln(a)

/** The oracle's: the host's double function rounded to a float, a ROM-range argument assumed. */
want1f(op: Op1f, a: u32) -> u32
    val x = f64(in32(a))
    op match
        Sqrt -> out32(in32(a).sqrt())
        Sin -> out32(f32(x.sin()))
        Cos -> out32(f32(x.cos()))
        Tan -> out32(f32(x.tan()))
        Exp -> out32(f32(x.exp()))
        Ln -> out32(f32(x.ln()))

/** One case of a binary32 operation of one operand. */
check1f(op: Op1f, a: u32) -> string
    val got = rom1f(op, a)
    val want = want1f(op, a)
    val ok = if op == Op1f.Sqrt then same32(got, want) else ulps32(got, want) <= SCI_ULPS
    if ok then "" else s"$op(0x${hex(a, 8)}) = 0x${hex(got, 8)}, want 0x${hex(want, 8)}"

/** The binary64 equivalents. */
rom2d(op: Op2f, a: u64, b: u64) -> u64 = op match
    Add -> rom.dadd(a, b)
    Sub -> rom.dsub(a, b)
    Mul -> rom.dmul(a, b)
    Div -> rom.ddiv(a, b)
    Atan2 -> rom.datan2(a, b)

want2d(op: Op2f, a: u64, b: u64) -> u64
    val x = in64(a)
    val y = in64(b)
    op match
        Add -> out64(x + y)
        Sub -> out64(x - y)
        Mul -> out64(x * y)
        Div -> out64(x / y)
        Atan2 -> out64(x.atan2(y))

check2d(op: Op2f, a: u64, b: u64) -> string
    val got = rom2d(op, a, b)
    val want = want2d(op, a, b)
    val ok = if op == Op2f.Atan2 then ulps64(got, want) <= SCI_ULPS64 else same64(got, want)
    if ok then "" else s"d$op(0x${hex(a, 16)}, 0x${hex(b, 16)}) = 0x${hex(got, 16)}, want 0x${hex(want, 16)}"

rom1d(op: Op1f, a: u64) -> u64 = op match
    Sqrt -> rom.dsqrt(a)
    Sin -> rom.dsin(a)
    Cos -> rom.dcos(a)
    Tan -> rom.dtan(a)
    Exp -> rom.dexp(a)
    Ln -> rom.dln(a)

want1d(op: Op1f, a: u64) -> u64
    val x = in64(a)
    op match
        Sqrt -> out64(x.sqrt())
        Sin -> out64(x.sin())
        Cos -> out64(x.cos())
        Tan -> out64(x.tan())
        Exp -> out64(x.exp())
        Ln -> out64(x.ln())

check1d(op: Op1f, a: u64) -> string
    val got = rom1d(op, a)
    val want = want1d(op, a)
    val ok = if op == Op1f.Sqrt then same64(got, want) else ulps64(got, want) <= SCI_ULPS64
    if ok then "" else s"d$op(0x${hex(a, 16)}) = 0x${hex(got, 16)}, want 0x${hex(want, 16)}"

/** Every conversion of one binary32, `n` the fixed-point scale (|n| ≤ 64): to the four integer kinds,
 * to the four fixed-point kinds, and to a double.
 */
check_from_float(a: u32, n: i32) -> string
    val pairs = [
        (u64(u32.wrap(rom.float2int(a))), want_float2fixed(a, 0, true, 32), "float2int"),
        (u64(u32.wrap(rom.float2fix(a, n))), want_float2fixed(a, n, true, 32), "float2fix"),
        (u64(rom.float2uint(a)), want_float2fixed(a, 0, false, 32), "float2uint"),
        (u64(rom.float2ufix(a, n)), want_float2fixed(a, n, false, 32), "float2ufix"),
        (u64.wrap(rom.float2int64(a)), want_float2fixed(a, 0, true, 64), "float2int64"),
        (u64.wrap(rom.float2fix64(a, n)), want_float2fixed(a, n, true, 64), "float2fix64"),
        (rom.float2uint64(a), want_float2fixed(a, 0, false, 64), "float2uint64"),
        (rom.float2ufix64(a, n), want_float2fixed(a, n, false, 64), "float2ufix64")]
    for p in pairs
        if p.0 != p.1 then return s"${p.2}(0x${hex(a, 8)}, $n) = 0x${hex(p.0)}, want 0x${hex(p.1)}"
    val d = rom.float2double(a)
    val wd = out64(f64(in32(a)))
    if !same64(d, wd) then return s"float2double(0x${hex(a, 8)}) = 0x${hex(d, 16)}, want 0x${hex(wd, 16)}"
    ""

/** Every conversion of one binary64, |n| ≤ 50. */
check_from_double(a: u64, n: i32) -> string
    val pairs = [
        (u64(u32.wrap(rom.double2int(a))), want_double2fixed(a, 0, true, 32), "double2int"),
        (u64(u32.wrap(rom.double2fix(a, n))), want_double2fixed(a, n, true, 32), "double2fix"),
        (u64(rom.double2uint(a)), want_double2fixed(a, 0, false, 32), "double2uint"),
        (u64(rom.double2ufix(a, n)), want_double2fixed(a, n, false, 32), "double2ufix"),
        (u64.wrap(rom.double2int64(a)), want_double2fixed(a, 0, true, 64), "double2int64"),
        (u64.wrap(rom.double2fix64(a, n)), want_double2fixed(a, n, true, 64), "double2fix64"),
        (rom.double2uint64(a), want_double2fixed(a, 0, false, 64), "double2uint64"),
        (rom.double2ufix64(a, n), want_double2fixed(a, n, false, 64), "double2ufix64")]
    for p in pairs
        if p.0 != p.1 then return s"${p.2}(0x${hex(a, 16)}, $n) = 0x${hex(p.0)}, want 0x${hex(p.1)}"
    val f = rom.double2float(a)
    val wf = out32(f32(in64(a)))
    if !same32(f, wf) then return s"double2float(0x${hex(a, 16)}) = 0x${hex(f, 8)}, want 0x${hex(wf, 8)}"
    ""

/** Every conversion to binary32 and binary64 of the 32-bit word `v` read as signed and unsigned, and
 * of the 64-bit `w`, scaled by 2^−n (|n| ≤ 60).
 */
check_to_float(v: u32, w: u64, n: i32) -> string
    val i = i32.wrap(v)
    val l = i64.wrap(w)
    val down = pow2(-n)
    val pairs32 = [
        (rom.int2float(i), out32(f32(i)), "int2float"),
        (rom.uint2float(v), out32(f32(v)), "uint2float"),
        (rom.fix2float(i, n), out32(f32(f64(i) * down)), "fix2float"),
        (rom.ufix2float(v, n), out32(f32(f64(v) * down)), "ufix2float"),
        (rom.int642float(l), out32(f32(l)), "int642float"),
        (rom.uint642float(w), out32(f32(w)), "uint642float"),
        (rom.fix642float(l, n), out32(f32(l) * f32(down)), "fix642float"),
        (rom.ufix642float(w, n), out32(f32(w) * f32(down)), "ufix642float")]
    for p in pairs32
        if p.0 != p.1 then return s"${p.2}(0x${hex(v)}/0x${hex(w)}, $n) = 0x${hex(p.0, 8)}, want 0x${hex(p.1, 8)}"
    val pairs64 = [
        (rom.int2double(i), out64(f64(i)), "int2double"),
        (rom.uint2double(v), out64(f64(v)), "uint2double"),
        (rom.fix2double(i, n), out64(f64(i) * down), "fix2double"),
        (rom.ufix2double(v, n), out64(f64(v) * down), "ufix2double"),
        (rom.int642double(l), out64(f64(l)), "int642double"),
        (rom.uint642double(w), out64(f64(w)), "uint642double"),
        (rom.fix642double(l, n), out64(f64(l) * down), "fix642double"),
        (rom.ufix642double(w, n), out64(f64(w) * down), "ufix642double")]
    for p in pairs64
        if p.0 != p.1 then return s"${p.2}(0x${hex(v)}/0x${hex(w)}, $n) = 0x${hex(p.0, 16)}, want 0x${hex(p.1, 16)}"
    ""
end check_to_float
