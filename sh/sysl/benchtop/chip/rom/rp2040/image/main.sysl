import sh.sysl.rp2040rom as rom
import sysl.raw.ptr_cast

// benchtop's own RP2040 boot ROM: the layout the SDK reads (RP2040 datasheet 2.8.3, "Bootrom
// Contents"; the SDK's `pico/bootrom.h`, `bootrom_constants.h` and `pico/bootrom/sf_table.h`).
//
// - 0x00: the vector table's first four words, SP and the reset, NMI and HardFault handlers (`VECTORS`);
// - 0x10: the magic 'M', 'u', 1 and the version, 3 (`VECTORS` too);
// - 0x14, 0x16, 0x18: 16-bit pointers to the function table, the data table and `rom_table_lookup`.
//
// A table is pairs of 16-bit words, a two-letter code and a 16-bit pointer, ended by a 0 code. A
// 16-bit pointer is the low half of a link-time address, which no language's constant expressions can
// produce, so the header's pointers and both tables are written in the linker script (`rom.ld`), as
// `SHORT` data naming the symbols exported here. Everything else is here, in sysl.

/** The ROM's version byte: the B2 stepping's, which the SDK's soft float and double setup reads. */
const ROM_VERSION: u8 = 3

/** The vector table's words and the magic. */
struct Vectors
    sp: u32
    reset: *extern() -> never
    nmi: *extern() -> never
    hard_fault: *extern() -> never
    magic: [3]u8
    version: u8

@section(".rom.vectors")
val VECTORS = Vectors(CORE0_STACK, &reset, &nmi, &hard_fault, [u8('M'), u8('u'), 1], ROM_VERSION)

/** An NMI taken while the vector table is the ROM's: refused by name. */
nmi() -> never = refuse(BELL_EXCEPTION | 2)
/** A HardFault taken while the vector table is the ROM's. */
hard_fault() -> never = refuse(BELL_EXCEPTION | 3)
/** Rung, with the exception number in the low bits, by an exception taken through the ROM's vectors. */
const BELL_EXCEPTION: u32 = 0x30000

/** `rom_table_lookup`: the 16-bit pointer `table` holds for `code`, or null. A code the RP2040's ROM
 * has and this one leaves out is refused by name.
 */
@export("rom_table_lookup")
table_lookup(table: *u16, code: u32) -> *u8
    var i: usize = 0
    while table[i] != 0
        if u32(table[i]) == code then return ptr_cast(usize(table[i + 1]))
        i += 2
    for left in LEFT_OUT
        if code == left then refuse(BELL_LOOKUP | code)
    null

// The codes of the RP2040's ROM this one does not provide: `debug_trampoline` ('D', 'T'),
// `debug_trampoline_end` ('D', 'E'), `wait_for_vector` ('W', 'V'), and the bounds of the float
// library's code ('F', 'S' and 'F', 'E').
private val LEFT_OUT: [5]u32 = [0x5444, 0x4544, 0x5657, 0x5346, 0x4546]

/** The data table's 'C', 'R'. */
@export("rom_copyright")
@section(".rodata.rom_copyright")
val COPYRIGHT: [64]u8 = "benchtop's own RP2040 boot ROM, ISC licence; not Raspberry Pi's\0"

/** The data table's 'G', 'R': this ROM's revision, a word. */
@export("rom_git_revision")
@section(".rodata.rom_git_revision")
val GIT_REVISION: u32 = 1

// The bit and memory functions, under the names the linker script's function table gives.

@export("rom_popcount32")
popcount32(x: u32) -> u32 = rom.popcount32(x)
@export("rom_reverse32")
reverse32(x: u32) -> u32 = rom.reverse32(x)
@export("rom_clz32")
clz32(x: u32) -> u32 = rom.clz32(x)
@export("rom_ctz32")
ctz32(x: u32) -> u32 = rom.ctz32(x)
@export("rom_memset")
memset(p: *u8, c: u8, n: usize) -> *u8 = rom.memset(p, c, n)
@export("rom_memset4")
memset4(p: *u8, c: u8, n: usize) -> *u8 = rom.memset4(p, c, n)
@export("rom_memcpy")
memcpy(d: *u8, s: *u8, n: usize) -> *u8 = rom.memcpy(d, s, n)
@export("rom_memcpy44")
memcpy44(d: *u8, s: *u8, n: usize) -> *u8 = rom.memcpy44(d, s, n)

// What the compiled code itself calls for a struct copy or clear: the same routines.
@export("memcpy")
c_memcpy(d: *u8, s: *u8, n: usize) -> *u8 = rom.memcpy(d, s, n)
@export("memset")
c_memset(p: *u8, c: i32, n: usize) -> *u8 = rom.memset(p, u8.wrap(c), n)

// The flash functions.

@export("rom_connect_internal_flash")
rom_connect_internal_flash() = connect_internal_flash()
@export("rom_flash_exit_xip")
rom_flash_exit_xip() = flash_exit_xip()
@export("rom_flash_range_erase")
rom_flash_range_erase(addr: u32, count: usize, block_size: u32, block_cmd: u8) = flash_range_erase(addr, count, block_size, block_cmd)
@export("rom_flash_range_program")
rom_flash_range_program(addr: u32, data: *u8, count: usize) = flash_range_program(addr, data, count)
@export("rom_flash_flush_cache")
rom_flash_flush_cache() = flash_flush_cache()
@export("rom_flash_enter_cmd_xip")
rom_flash_enter_cmd_xip() = flash_enter_cmd_xip()

// The soft float and double tables (`rom.SoftFloat`, `rom.SoftDouble`), each preceded by its size in
// words. The one entry of each the ROM leaves out, the comparison that answers in the flags (which no
// function's result can), is refused by name.

private fcmp_flags(a: u32, b: u32) -> i32 = refuse(BELL_FLOAT_ENTRY | 0x14)
private dcmp_flags(a: u64, b: u64) -> i32 = refuse(BELL_FLOAT_ENTRY | 0x114)

@section(".rom.sf_size")
val SF_SIZE: [2]u8 = [rom.TABLE_WORDS, 0]

@export("rom_sf_table")
@section(".rom.sf")
val SF_TABLE = rom.soft_float(&fcmp_flags)

@section(".rom.sd_size")
val SD_SIZE: [2]u8 = [rom.TABLE_WORDS, 0]

@export("rom_sd_table")
@section(".rom.sd")
val SD_TABLE = rom.soft_double(&dcmp_flags)
