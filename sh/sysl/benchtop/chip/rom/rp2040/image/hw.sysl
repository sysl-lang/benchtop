import sysl.raw.ptr_cast

// The ROM's reach into the chip: registers by address, and the few instructions no language's
// statements produce. Each `asm` here is one of those: the jumps that set
// the stack pointer or the link register to a value of the ROM's choosing, which is what starting a
// program from its vector table (or entering boot2 as the boot ROM does, with lr 0) is.

/** A register's word. */
reg(at: u32) -> *volatile u32 = ptr_cast(usize(at))

/** Read the register at `at`. */
rd(at: u32) -> u32 = *reg(at)

/** Write `v` to the register at `at`. */
wr(at: u32, v: u32)
    *reg(at) = v

/** Start running at `pc` (Thumb bit set) on the stack `sp`, as a reset does from a vector table; never
 * returns.
 */
enter(sp: u32, pc: u32) -> never
    asm
        [thumb]
            "msr msp, {sp}"
            "bx {pc}"
            in sp : reg
            in pc : reg
        [x86_64, aarch64, riscv64, riscv32, craft, wasm32] unavailable "benchtop's RP2040 boot ROM runs on the Cortex-M0+"
    loop
        wfe()

/** Branch to `pc` with the link register 0: how the boot ROM enters boot2, which reads lr 0 as "vector
 * into the flash image" rather than "return to my caller" (the SDK's `exit_from_boot2.S`).
 */
enter_lr0(pc: u32) -> never
    asm
        [thumb]
            "movs r3, #0"
            "mov lr, r3"
            "bx {pc}"
            in pc : reg
            clobbers "r3"
        [x86_64, aarch64, riscv64, riscv32, craft, wasm32] unavailable "benchtop's RP2040 boot ROM runs on the Cortex-M0+"
    loop
        wfe()
