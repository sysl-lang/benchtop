// benchtop's own RP2040 boot ROM, the image: the header, the tables, core 0's boot path, core 1's
// launch wait and the flash functions, linked with the routines of the package above into the 16 KB
// the `pico` board maps at 0. `build.sh` builds it for the Cortex-M0+ (`thumbv6m-freestanding`) and
// links it with `rom.ld`.

package {
  name    = "rp2040rom-image"
  version = "0.0.0"
  sysl    = "0.8.9"
}

dependencies {
  rp2040rom { path = ".." }
  rp2040 { git = "github.com/sysl-lang/rp2040", version = "0.1.2" }
}
