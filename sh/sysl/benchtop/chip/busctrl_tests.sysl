module sh.sysl.benchtop.chip
@tests

import sh.sysl.rp2350.busctrl as bc
import sh.sysl.rp2350.glitch_detector as gd
import sh.sysl.rp2350.tbman as tb

// BUSCTRL, TBMAN and GLITCH_DETECTOR on the RP2350 (`peripheral/rp2350/busctrl.sysl`), at their
// registers through the chip's bus. The RP2040's BUSCTRL is in `pico_tests.sysl`.

private rd(c: *Rp2350, a: u32) -> u32 = c.read(0, a, 4).unwrap()
private wr(c: *Rp2350, a: u32, x: u32) = c.write(0, a, 4, x).unwrap()
private const SET: u32 = 0x2000
private const CLR: u32 = 0x3000

@test("BUSCTRL's BUS_PRIORITY holds its four bits through the aliases, and BUS_PRIORITY_ACK reads 1 and drops a write")
bus_priority()
    var c = rp2350()
    assert(rd(&c, bc.BASE + bc.BUS_PRIORITY_OFFSET) == 0)
    wr(&c, bc.BASE + bc.BUS_PRIORITY_OFFSET, 0xFFFFFFFF)
    assert(rd(&c, bc.BASE + bc.BUS_PRIORITY_OFFSET) == 0x1111, "only DMA_W, DMA_R, PROC1 and PROC0")
    wr(&c, bc.BASE + bc.BUS_PRIORITY_OFFSET + CLR, 0x1010)
    assert(rd(&c, bc.BASE + bc.BUS_PRIORITY_OFFSET) == 0x0101)
    wr(&c, bc.BASE + bc.BUS_PRIORITY_OFFSET + SET, 0x10)
    assert(rd(&c, bc.BASE + bc.BUS_PRIORITY_OFFSET) == 0x0111)
    assert(rd(&c, bc.BASE + bc.BUS_PRIORITY_ACK_OFFSET) == 1)
    wr(&c, bc.BASE + bc.BUS_PRIORITY_ACK_OFFSET, 0)
    assert(rd(&c, bc.BASE + bc.BUS_PRIORITY_ACK_OFFSET) == 1)
    // A halfword write replicates over the word, as the bus does.
    c.write(0, bc.BASE + bc.BUS_PRIORITY_OFFSET, 2, 0x0001).unwrap()
    assert(rd(&c, bc.BASE + bc.BUS_PRIORITY_OFFSET) == 0x0001)

@test("BUSCTRL's counters: PERFSEL is stored 7 bits wide, a counter reads 0 while PERFCTR_EN is clear, for a contested or stall event, and for an event that does not exist")
bus_counters_zero()
    var c = rp2350()
    for k in 0u32..<4
        assert(rd(&c, bc.BASE + bc.PERFSEL0_OFFSET + 8 * k) == 0x1f, "reset value")
    assert(rd(&c, bc.BASE + bc.PERFCTR_EN_OFFSET) == 0)
    wr(&c, bc.BASE + bc.PERFSEL0_OFFSET, 0xFFFFFFFF)
    assert(rd(&c, bc.BASE + bc.PERFSEL0_OFFSET) == 0x7f)
    // An access event, but nothing counts while PERFCTR_EN is clear.
    wr(&c, bc.BASE + bc.PERFSEL1_OFFSET, 19)
    assert(rd(&c, bc.BASE + bc.PERFCTR1_OFFSET) == 0)
    // Counting: a stall (events 0, 1), a contested access (2) and an event number past the last (68).
    wr(&c, bc.BASE + bc.PERFSEL0_OFFSET, 1)
    wr(&c, bc.BASE + bc.PERFSEL1_OFFSET, 0)
    wr(&c, bc.BASE + bc.PERFSEL2_OFFSET, 2)
    wr(&c, bc.BASE + bc.PERFSEL3_OFFSET, 68)
    wr(&c, bc.BASE + bc.PERFCTR_EN_OFFSET, 0xFF)
    assert(rd(&c, bc.BASE + bc.PERFCTR_EN_OFFSET) == 1)
    assert(rd(&c, bc.BASE + bc.PERFCTR0_OFFSET) == 0 && rd(&c, bc.BASE + bc.PERFCTR2_OFFSET) == 0 && rd(&c, bc.BASE + bc.PERFCTR3_OFFSET) == 0)
    // A write clears a counter; the SDK's `busctrl_hw->counter[i].value = 0`.
    wr(&c, bc.BASE + bc.PERFCTR0_OFFSET, 0)
    assert(rd(&c, bc.BASE + bc.PERFCTR0_OFFSET) == 0)

@test("BUSCTRL refuses by name a read of a counter that has counted an access event, and a counter cleared with PERFCTR_EN clear reads 0 again")
bus_counters_refused()
    var c = rp2350()
    for k in 0u32..<4 do wr(&c, bc.BASE + bc.PERFSEL0_OFFSET + 8 * k, 0)
    wr(&c, bc.BASE + bc.PERFSEL2_OFFSET, 3)
    wr(&c, bc.BASE + bc.PERFCTR_EN_OFFSET, 1)
    val r = c.read(0, bc.BASE + bc.PERFCTR2_OFFSET, 4)
    assert(r.is_err() && r.unwrap_err().contains("BUSCTRL") && r.unwrap_err().contains("PERFCTR2") && r.unwrap_err().contains("event 3"), s"${r}")
    // Enabling with the reset selection (event 31, SRAM6 access) is the same for the counters left on it.
    var d = rp2350()
    wr(&d, bc.BASE + bc.PERFCTR_EN_OFFSET, 1)
    assert(d.read(0, bc.BASE + bc.PERFCTR1_OFFSET, 4).unwrap_err().contains("event 31"))
    // The other counters and the select register are still readable.
    assert(rd(&c, bc.BASE + bc.PERFCTR0_OFFSET) == 0 && rd(&c, bc.BASE + bc.PERFSEL2_OFFSET) == 3)
    // Counting continues after a clear, so the refusal stays; stopping the count and clearing lifts it.
    wr(&c, bc.BASE + bc.PERFCTR2_OFFSET, 0)
    assert(c.read(0, bc.BASE + bc.PERFCTR2_OFFSET, 4).is_err())
    wr(&c, bc.BASE + bc.PERFCTR_EN_OFFSET, 0)
    wr(&c, bc.BASE + bc.PERFCTR2_OFFSET, 0)
    assert(rd(&c, bc.BASE + bc.PERFCTR2_OFFSET) == 0)
    // Selecting an access event after enabling is the same.
    wr(&c, bc.BASE + bc.PERFCTR_EN_OFFSET, 1)
    wr(&c, bc.BASE + bc.PERFSEL0_OFFSET, 67)
    assert(c.read(0, bc.BASE + bc.PERFCTR0_OFFSET, 4).is_err())

@test("BUSCTRL refuses an address between its registers, an unaligned access and a bad width by name")
bus_access_rules()
    var c = rp2350()
    for a in [bc.BASE + 0x2C, bc.BASE + 0x100]
        val r = c.read(0, a, 4)
        assert(r.is_err() && r.unwrap_err().contains("BUSCTRL"), s"${r}")
        assert(c.write(0, a, 4, 0).is_err())
    assert(c.read(0, bc.BASE + 1, 4).unwrap_err().contains("BUSCTRL"))
    assert(c.read(0, bc.BASE, 8).unwrap_err().contains("BUSCTRL"))

@test("TBMAN's PLATFORM reads ASIC, a write is dropped, and nothing else is a register")
tbman_platform()
    var c = rp2350()
    assert(rd(&c, tb.BASE + tb.PLATFORM_OFFSET) == tb.PLATFORM_ASIC_MASK)
    wr(&c, tb.BASE + tb.PLATFORM_OFFSET, 4)
    assert(rd(&c, tb.BASE + tb.PLATFORM_OFFSET) == 1)
    assert(c.read(0, tb.BASE + tb.PLATFORM_OFFSET + 1, 1).unwrap() == 0)
    val r = c.read(0, tb.BASE + 4, 4)
    assert(r.is_err() && r.unwrap_err().contains("TBMAN"))
    val w = c.write(0, tb.BASE + 4, 4, 0)
    assert(w.is_err() && w.unwrap_err().contains("TBMAN"))

@test("GLITCH_DETECTOR stores ARM, DISARM and SENSITIVITY, clears TRIG_STATUS by writing ones, and sets it from TRIG_FORCE while disarmed")
glitch_stores()
    var c = rp2350()
    assert(rd(&c, gd.BASE + gd.ARM_OFFSET) == 0x5bad, "not forced armed")
    assert(rd(&c, gd.BASE + gd.DISARM_OFFSET) == 0 && rd(&c, gd.BASE + gd.SENSITIVITY_OFFSET) == 0 && rd(&c, gd.BASE + gd.LOCK_OFFSET) == 0)
    wr(&c, gd.BASE + gd.DISARM_OFFSET, 0xFFFFDCAF)
    assert(rd(&c, gd.BASE + gd.DISARM_OFFSET) == 0xDCAF, "16 bits")
    wr(&c, gd.BASE + gd.SENSITIVITY_OFFSET, 0xFFFFFFFF)
    assert(rd(&c, gd.BASE + gd.SENSITIVITY_OFFSET) == 0xFF00FFFF)
    wr(&c, gd.BASE + gd.SENSITIVITY_OFFSET + CLR, 0xFF000000)
    assert(rd(&c, gd.BASE + gd.SENSITIVITY_OFFSET) == 0x0000FFFF)
    wr(&c, gd.BASE + gd.TRIG_FORCE_OFFSET, 0xFF)
    assert(rd(&c, gd.BASE + gd.TRIG_STATUS_OFFSET) == 0xF, "four detectors")
    assert(rd(&c, gd.BASE + gd.TRIG_FORCE_OFFSET) == 0)
    wr(&c, gd.BASE + gd.TRIG_STATUS_OFFSET, 0x5)
    assert(rd(&c, gd.BASE + gd.TRIG_STATUS_OFFSET) == 0xA)
    wr(&c, gd.BASE + gd.TRIG_STATUS_OFFSET + CLR, 0x2)
    assert(rd(&c, gd.BASE + gd.TRIG_STATUS_OFFSET) == 0x8, "write-1-to-clear through the CLR alias too")
    wr(&c, gd.BASE + gd.TRIG_FORCE_OFFSET, 0)
    assert(rd(&c, gd.BASE + gd.TRIG_STATUS_OFFSET) == 0x8)

@test("GLITCH_DETECTOR refuses by name a TRIG_FORCE while armed, which would reset the switched core, and leaves TRIG_STATUS as it was")
glitch_force_armed()
    var c = rp2350()
    wr(&c, gd.BASE + gd.TRIG_FORCE_OFFSET, 1)
    wr(&c, gd.BASE + gd.ARM_OFFSET, 0)
    val r = c.write(0, gd.BASE + gd.TRIG_FORCE_OFFSET, 4, 2)
    assert(r.is_err() && r.unwrap_err().contains("GLITCH_DETECTOR") && r.unwrap_err().contains("TRIG_FORCE") && r.unwrap_err().contains("POWMAN_CHIP_RESET"), s"${r}")
    assert(rd(&c, gd.BASE + gd.TRIG_STATUS_OFFSET) == 1)
    // A force of nothing does nothing, armed or not; any ARM value but 0x5bad is armed.
    wr(&c, gd.BASE + gd.TRIG_FORCE_OFFSET, 0)
    wr(&c, gd.BASE + gd.ARM_OFFSET, 0x1234)
    assert(c.write(0, gd.BASE + gd.TRIG_FORCE_OFFSET, 4, 8).is_err())
    wr(&c, gd.BASE + gd.ARM_OFFSET, 0x5bad)
    wr(&c, gd.BASE + gd.TRIG_FORCE_OFFSET, 8)
    assert(rd(&c, gd.BASE + gd.TRIG_STATUS_OFFSET) == 9)

@test("GLITCH_DETECTOR's LOCK, once nonzero, drops writes to ARM, DISARM, SENSITIVITY and LOCK, and leaves TRIG_STATUS and TRIG_FORCE working")
glitch_lock()
    var c = rp2350()
    wr(&c, gd.BASE + gd.SENSITIVITY_OFFSET, 0x55)
    wr(&c, gd.BASE + gd.LOCK_OFFSET, 0xFFF)
    assert(rd(&c, gd.BASE + gd.LOCK_OFFSET) == 0xFF)
    wr(&c, gd.BASE + gd.ARM_OFFSET, 0)
    wr(&c, gd.BASE + gd.DISARM_OFFSET, 0xDCAF)
    wr(&c, gd.BASE + gd.SENSITIVITY_OFFSET, 0xAA)
    wr(&c, gd.BASE + gd.LOCK_OFFSET, 0)
    assert(rd(&c, gd.BASE + gd.ARM_OFFSET) == 0x5bad && rd(&c, gd.BASE + gd.DISARM_OFFSET) == 0)
    assert(rd(&c, gd.BASE + gd.SENSITIVITY_OFFSET) == 0x55 && rd(&c, gd.BASE + gd.LOCK_OFFSET) == 0xFF)
    wr(&c, gd.BASE + gd.TRIG_FORCE_OFFSET, 3)
    wr(&c, gd.BASE + gd.TRIG_STATUS_OFFSET, 1)
    assert(rd(&c, gd.BASE + gd.TRIG_STATUS_OFFSET) == 2)

@test("GLITCH_DETECTOR refuses an address past TRIG_FORCE and a narrow access that is not aligned, by name")
glitch_access_rules()
    var c = rp2350()
    val r = c.read(0, gd.BASE + 0x18, 4)
    assert(r.is_err() && r.unwrap_err().contains("GLITCH_DETECTOR"))
    assert(c.write(0, gd.BASE + 0x18, 4, 0).unwrap_err().contains("GLITCH_DETECTOR"))
    assert(c.read(0, gd.BASE + 2, 4).unwrap_err().contains("GLITCH_DETECTOR"))
    assert(c.read(0, gd.BASE + gd.ARM_OFFSET + 1, 1).unwrap() == 0x5b)
