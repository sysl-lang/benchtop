module sh.sysl.benchtop.chip

import sh.sysl.rp2040rom as rom
import sh.sysl.rp2040rom.oracle.*
import sysl.fmt.hex

// benchtop's own RP2040 boot ROM's float and double routines (`chip/rom/rp2040`), compiled for the
// host, against the host's IEEE arithmetic and libm (`sh.sysl.rp2040rom.oracle`, which says where the
// ROM documents a difference): a sampled, edge-biased set of inputs for every routine the SDK's soft
// float and double tables reach. The exhaustive and multi-million runs are the package's
// `examples/sweep`, run once per change to the routines (`docs/rp-coverage.md`, item 23).

/** Failing cases counted, the first few kept. */
struct Tally
    n: int
    failed: int
    first: string

    add(*self, why: string)
        self.n += 1
        if why == "" then return
        self.failed += 1
        if self.failed <= 5 then self.first = s"${self.first}\n  $why"

    /** Empty where every case passed. */
    report(self) -> string = if self.failed == 0 then "" else s"${self.failed} of ${self.n} failed:${self.first}"
end Tally

private tally() -> Tally = Tally(0, 0, "")

@test("the ROM's binary32 fadd, fsub, fmul, fdiv and fatan2 against the host: edge-biased pairs, ties, neighbours and cancellations")
rom40_float_binary()
    var r = Rng(0x9E3779B97F4A7C15)
    for op in [Op2f.Add, Op2f.Sub, Op2f.Mul, Op2f.Div, Op2f.Atan2]
        var t = tally()
        for k in 0..<30000
            val a = edge32(&r)
            t.add(check2f(op, a, partner32(&r, a)))
        assert(t.failed == 0, s"$op: ${t.report()}")

@test("the ROM's binary32 fsqrt, fsin, fcos, ftan, fexp and fln against the host, each over its documented range")
rom40_float_unary()
    var r = Rng(0xD1B54A32D192ED03)
    for op in [Op1f.Sqrt, Op1f.Sin, Op1f.Cos, Op1f.Tan, Op1f.Exp, Op1f.Ln]
        var t = tally()
        for k in 0..<30000
            var a = edge32(&r)
            // The trigonometric functions take |x| < 128 from the SDK, which reduces larger angles.
            if (op == Op1f.Sin || op == Op1f.Cos || op == Op1f.Tan) && a & 0x7FFFFFFF >= 0x43000000 && a & 0x7FFFFFFF < 0x7F800000 then a = a & 0xC2FFFFFF
            t.add(check1f(op, a))
        assert(t.failed == 0, s"$op: ${t.report()}")

@test("the ROM's binary64 dadd, dsub, dmul, ddiv and datan2 against the host: edge-biased pairs, ties, neighbours and cancellations")
rom40_double_binary()
    var r = Rng(0x2545F4914F6CDD1D)
    for op in [Op2f.Add, Op2f.Sub, Op2f.Mul, Op2f.Div, Op2f.Atan2]
        var t = tally()
        for k in 0..<30000
            val a = edge64(&r)
            t.add(check2d(op, a, partner64(&r, a)))
        assert(t.failed == 0, s"$op: ${t.report()}")

@test("the ROM's binary64 dsqrt, dsin, dcos, dtan, dexp and dln against the host, each over its documented range")
rom40_double_unary()
    var r = Rng(0x94D049BB133111EB)
    for op in [Op1f.Sqrt, Op1f.Sin, Op1f.Cos, Op1f.Tan, Op1f.Exp, Op1f.Ln]
        var t = tally()
        for k in 0..<30000
            var a = edge64(&r)
            // The trigonometric functions take |x| < 1024 from the SDK.
            if (op == Op1f.Sin || op == Op1f.Cos || op == Op1f.Tan) && a & 0x7FFFFFFFFFFFFFFF >= 0x4090000000000000 && a & 0x7FFFFFFFFFFFFFFF < 0x7FF0000000000000 then a = a & 0xC08FFFFFFFFFFFFF
            t.add(check1d(op, a))
        assert(t.failed == 0, s"$op: ${t.report()}")

@test("the ROM's conversions from binary32 and binary64 to integers and fixed point, toward −∞ and saturated, and between the two widths")
rom40_from_float()
    var r = Rng(0xBF58476D1CE4E5B9)
    var t = tally()
    for k in 0..<60000
        val n = i32(r.next() % 81) - 40
        t.add(check_from_float(edge32(&r), n))
        t.add(check_from_double(edge64(&r), n))
    assert(t.failed == 0, t.report())

@test("the ROM's conversions from 32- and 64-bit integers and fixed point to binary32 and binary64, rounded")
rom40_to_float()
    var r = Rng(0x6A09E667F3BCC909)
    var t = tally()
    for k in 0..<60000
        val v = r.next()
        val w = r.next()
        // Small magnitudes, near powers of two and the words' edges, as well as plain random words.
        val word = if v & 3 == 0 then u32.wrap(v >> 40) elif v & 3 == 1 then 0xFFFFFFFF -% u32.wrap(v >> 60) else u32.wrap(v >> 8)
        val wide = if w & 3 == 0 then w >> u32(w % 64) elif w & 3 == 1 then (1u64 << u32(w % 64)) +% (w >> 60) else w
        t.add(check_to_float(word, wide, i32((v >> 32) % 121) - 60))
    assert(t.failed == 0, t.report())

@test("the ROM's fcmp and dcmp order as IEEE does, −0 equal to +0, denormals flushed, and a NaN on either side answers 1")
rom40_compare()
    var r = Rng(0x3C6EF372FE94F82B)
    for k in 0..<30000
        val a = edge32(&r)
        val b = partner32(&r, a)
        val x = in32(a)
        val y = in32(b)
        val want = if x != x || y != y then 1 elif x < y then -1 elif x > y then 1 else 0
        assert(rom.fcmp(a, b) == want, s"fcmp(0x${hex(a, 8)}, 0x${hex(b, 8)}) = ${rom.fcmp(a, b)}, want $want")
        val c = edge64(&r)
        val d = partner64(&r, c)
        val p = in64(c)
        val q = in64(d)
        val dwant = if p != p || q != q then 1 elif p < q then -1 elif p > q then 1 else 0
        assert(rom.dcmp(c, d) == dwant, s"dcmp(0x${hex(c, 16)}, 0x${hex(d, 16)}) = ${rom.dcmp(c, d)}, want $dwant")

@test("the ROM's documented edges, each named: denormals in and out, the carry into the smallest normal, saturation, NaN conversions, invalid operations, and the angles out of range")
rom40_documented_edges()
    // A denormal input is a zero of its sign: 1.0 + the largest denormal is 1.0, and −denormal × 2 is −0.
    assert(rom.fadd(0x3F800000, 0x007FFFFF) == 0x3F800000 && rom.fmul(0x807FFFFF, 0x40000000) == 0x80000000)
    // A denormal result is flushed: the smallest normal halved is +0; the same in a double.
    assert(rom.fmul(0x00800000, 0x3F000000) == 0 && rom.dmul(0x0010000000000000, 0x3FE0000000000000) == 0)
    // A result IEEE rounds up into the smallest normal is that normal: (2 − 2^−23) × 2^−126 / 2 lies on
    // the tie between the largest denormal and the smallest normal, and goes to the even one.
    assert(rom.fdiv(0x00FFFFFF, 0x40000000) == 0x00800000, s"0x${hex(rom.fdiv(0x00FFFFFF, 0x40000000), 8)}")
    assert(rom.ddiv(0x001FFFFFFFFFFFFF, 0x4000000000000000) == 0x0010000000000000)
    // Conversions toward −∞, saturated; ∞ and a NaN by their sign.
    assert(rom.float2int(0xBFC00000) == -2 && rom.float2int(0x3FC00000) == 1)
    assert(rom.float2int(0x7F800000) == 2147483647 && rom.float2int(0xFF800000) == -2147483648)
    assert(rom.float2int(0x7FC00000) == 2147483647 && rom.float2int(0xFFC00000) == -2147483648)
    assert(rom.float2uint(0xBF800000) == 0 && rom.float2uint(0x4F800000) == 0xFFFFFFFF)
    assert(rom.double2int64(0x43E0000000000000) == 9223372036854775807 && rom.double2uint64(0xFFF8000000000000) == 0)
    // Invalid operations answer the default NaN; the root of −0 is −0.
    assert(rom.fsqrt(0xBF800000) == 0x7FC00000 && rom.fsqrt(0x80000000) == 0x80000000)
    assert(rom.fadd(0x7F800000, 0xFF800000) == 0x7FC00000 && rom.dmul(0x7FF0000000000000, 0) == 0x7FF8000000000000)
    // Sine, cosine and tangent at |x| ≥ 2048 answer NaN, as at ∞; just inside, a number.
    assert(rom.is_nan64(rom.dsin(0x40A0000000000000)) && rom.is_nan32(rom.fcos(0x45000000)) && rom.is_nan32(rom.fsin(0x7F800000)))
    assert(!rom.is_nan64(rom.dsin(0x409FFFFFFFFFFFFF)) && !rom.is_nan32(rom.ftan(0x44FFFFFF)))

// The correctly rounded double of each function at a few arguments, from `bc -l` at 80 digits: the
// oracle for the scientific functions that is exact, where the host's libm is within a unit (it answers
// tan(1) with …A5). Rows: the function, its arguments, the double.
private val CORRECT64: [25](u32, u64, u64, u64) = [
    (0, 0x3FF0000000000000, 0, 0x3FEAED548F090CEE), (1, 0x3FF0000000000000, 0, 0x3FE14A280FB5068C),
    (2, 0x3FF0000000000000, 0, 0x3FF8EB245CBEE3A6), (0, 0x4008000000000000, 0, 0x3FC210386DB6D55B),
    (1, 0x4008000000000000, 0, 0xBFEFAE04BE85E5D2), (2, 0x4008000000000000, 0, 0xBFC23EF71254B86F),
    (0, 0x4059000000000000, 0, 0xBFE03425B78C4DB8), (1, 0x4059000000000000, 0, 0x3FEB981DBF665FDF),
    (2, 0x4059000000000000, 0, 0xBFE2CA74D62B5D38), (0, 0x408F400000000000, 0, 0x3FEA75CC150A206B),
    (2, 0x408F400000000000, 0, 0x3FF786729F34311A), (3, 0x3FF0000000000000, 0, 0x4005BF0A8B145769),
    (3, 0xBFF0000000000000, 0, 0x3FD78B56362CEF38), (3, 0x4059000000000000, 0, 0x48F3494A9B171BF5),
    (3, 0xC034000000000000, 0, 0x3E21B48655F37267), (4, 0x4000000000000000, 0, 0x3FE62E42FEFA39EF),
    (4, 0x4024000000000000, 0, 0x40026BB1BBB55516), (4, 0x4008000000000000, 0, 0x3FF193EA7AAD030B),
    (4, 0x412E848000000000, 0, 0x402BA18A998FFFA0), (4, 0x3FE0000000000000, 0, 0xBFE62E42FEFA39EF),
    (5, 0x3FF0000000000000, 0x4000000000000000, 0x3FDDAC670561BB4F),
    (5, 0xC008000000000000, 0xC010000000000000, 0xC003FC176B7A8560),
    (5, 0x4014000000000000, 0xBFF0000000000000, 0x3FFC4A83936311DA),
    (5, 0x3FF0000000000000, 0x3FF0000000000000, 0x3FE921FB54442D18),
    // macOS's libm answers this tan three units away (…8BD2).
    (2, 0x4000C905D3FEE913, 0, 0xBFFB794409328BCF)]

@test("the ROM's double sin, cos, tan, exp, ln and atan2 are correctly rounded at arguments whose exact values bc computes")
rom40_double_correctly_rounded()
    for row in CORRECT64
        val f, a, b, want = row
        val got = f match
            0 -> rom.dsin(a)
            1 -> rom.dcos(a)
            2 -> rom.dtan(a)
            3 -> rom.dexp(a)
            4 -> rom.dln(a)
            _ -> rom.datan2(a, b)
        assert(got == want, s"function $f of 0x${hex(a, 16)}, 0x${hex(b, 16)}: 0x${hex(got, 16)}, want 0x${hex(want, 16)}")
