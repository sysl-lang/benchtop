module sh.sysl.benchtop.chip

import sh.sysl.benchtop.peripheral.rp2350.{ARCH_RISCV, factory_otp}
import sh.sysl.benchtop.riscv as rv
import sh.sysl.benchtop.riscv.{Insn, Stop}
import sh.sysl.elf
import sh.sysl.rp2350.psm as psm_reg
import sysl.buf.{Buf, buf}
import sysl.fmt.hex
import sysl.math.min

// An RP2350 booted on its two Hazard3 cores (`mcus/rp2350-hazard3.hocon`): the chip, its SRAM as both
// harts' RAM window, and the harts reaching every other address through the chip.
//
// **Boot** is DESIGN.md §9.2's debugger entry, as a probe loads a RAM image: the ELF's segments are
// written into SRAM and hart 0 starts at the ELF entry. Hart 1 starts at the Hazard3 reset vector in
// Raspberry Pi's boot ROM (bootrom.sysl), which both harts read and fetch through the bus, and waits
// there, the ROM's own RISC-V code, blocked (h3.block) between the words of core 0's launch through
// the SIO FIFOs (§9.6), until it jumps to the entry it was sent with the stack pointer and `mtvec` it
// was sent. Hart 0's boot path through the ROM (its Armv8-M emulator, varmulet) is not run. Flash
// (XIP) is not on this board's bus yet, so an image is linked to run from SRAM.
//
// **Time** runs in quanta of clk_sys cycles, one per retired instruction: each started hart runs the
// quantum through its decode cache, a device access is timed at the quantum's start plus the hart's
// instructions into it, and the chip is brought to the quantum's end before the next. While both
// harts sleep the board skips to the next device event. A hart that EBREAKs ends the run.
//
// **A watchdog reset that takes down a hart's PSM stage ends the run**, named: restarting the harts
// through the boot ROM is the Arm board's (`ArmBoard`) and comes to this one with the RISC-V boot
// path (docs/rp-coverage.md Q13, Arm first). The chip's own reset (`Rp2350.watchdog_reset`) is made.

// Why a watchdog reset of a hart ends the run.
private const RESTART_REFUSED: string = "the watchdog has reset the chip, and restarting the RISC-V harts through the boot ROM is not modelled (docs/rp-coverage.md Q13: Arm first)"

/** Where and how large the SRAM is: the description's `ram`. */
struct SramMap
    base: u32
    size: u32

/** How a run ended. */
enum RunEnd
    // The cycle budget is spent.
    Budget
    // A hart executed EBREAK.
    Breakpoint
    // The chip refused an access (`RiscvBoard.refused` says which), or a hart stopped on a fault.
    Fault
    // Both harts sleep and no device will wake them.
    Asleep

struct RiscvBoard
    chip: Rp2350
    harts: [2]rv.Cpu
    sram: Buf[u8]
    base: u32
    records: [2]Buf[Insn]
    lines: [2]Buf[u8]
    started: [2]bool
    // The chip's clock at the start of the running quantum, and each hart's retired count there.
    quantum_at: u64
    retired_at: [2]u64
    quantum: u64
    refused: string
    // Every byte UART0 has sent.
    console: Buf[u8]
    // The OTP's array, a row in the low 24 bits of each word, for the run (`factory_otp`).
    otp_rows: [4096]u32

/** A board with `map`'s SRAM, powered on, holding no image. */
riscv_board(map: SramMap) -> &RiscvBoard
    // Harts and records before `boot`, every field zero; `boot` resets the harts and forgets the records.
    var harts: [2]rv.Cpu
    var blank: Insn
    val b = RiscvBoard(rp2350(), harts, buf(), map.base, [buf(), buf()], [buf(), buf()], [false, false], 0, [0, 0], 1000, "", buf(), [0; 4096])
    for i in 0..<map.size do b.sram.push(0)
    for k in 0..<2
        for i in 0..<rv.code_records(usize(map.size)) do b.records[k].push(blank)
        for i in 0..<rv.code_lines(usize(map.size)) do b.lines[k].push(0)
    b

impl RiscvBoard
    /** Power on with `image` (an ELF) in SRAM: hart 0 at its entry, hart 1 in the boot ROM. */
    boot(*self, image: []const u8) -> Result[unit, string]
        val e = elf.read(image).map_err(why -> s"$why")?
        for i in 0..<self.sram.len() do self.sram.set(i, 0)
        var regions = [elf.Region(u64(self.base), self.sram.view())]
        val entry = elf.load(e, regions[..]).map_err(why -> s"$why: the image must be linked into the SRAM")?
        self.chip.reset()
        self.chip.rom_boot_releases()
        self.chip.connect_memory(self)
        factory_otp(&self.otp_rows)
        self.chip.otp.connect(&self.otp_rows[0])
        self.chip.otp.runs(ARCH_RISCV)
        self.reset_hart(0, u32(entry))
        self.reset_hart(1, RISCV_RESET_VECTOR)
        self.quantum_at = 0
        self.refused = ""
        self.console.clear()
        Ok(())

    // Hart `k` from reset at `entry`, on this board's bus and its own code cache, paired with the other.
    private reset_hart(*self, k: usize, entry: u32)
        val h = &self.harts[k]
        rv.reset(h, rv.model_named("hazard3").unwrap(), rv.RP2350, self.sram.view(), self.base, entry)
        h.bus = self
        // EBREAK is the guest's way to end a run; other faults trap as on silicon.
        h.halt_breakpoint = true
        rv.use_code_cache(h, self.records[k].view(), self.lines[k].view())
        rv.pair(&self.harts[0], &self.harts[1])
        self.started[k] = true

    /** Run until `cycles` more clk_sys cycles have passed, or something ends the run first. */
    run(*self, cycles: u64) -> RunEnd
        val limit = self.chip.now + cycles
        while self.chip.now < limit
            var q = min(self.quantum, limit - self.chip.now)
            self.chip.hstx_irq_due() match
                Some(n) -> q = min(q, n)
                None -> ()
            self.quantum_at = self.chip.now
            for k in 0..<2
                if !self.started[k] then continue
                val h = &self.harts[k]
                self.retired_at[k] = h.retired
                rv.run_threaded(h, q)
                if !self.refused.is_empty() then return RunEnd.Fault
                h.stop match
                    Budget | Sleep -> ()
                    Breakpoint ->
                        // What the chip has done up to the breakpoint is the console's now, not at a
                        // quantum's end that does not come.
                        self.settle()
                        return RunEnd.Breakpoint
                    _ -> return RunEnd.Fault
            self.chip.catch_up(self.quantum_at + q)
            self.settle()
            if self.watchdog_reset() then return RunEnd.Fault
            if self.asleep()
                if self.chip.power_down_due()
                    self.refused = "the chip: POWMAN would power the switched core down with both harts asleep, and powering the RISC-V harts down and up through the boot ROM is not modelled (docs/rp-coverage.md Q13: Arm first)"
                    return RunEnd.Fault
                val next = self.chip.next_event() match
                    Some(n) -> n
                    None -> return RunEnd.Asleep
                self.chip.advance(min(next, limit - self.chip.now))
                self.settle()
                if self.watchdog_reset() then return RunEnd.Fault
        RunEnd.Budget
    end run

    /** UART0 finishes sending what it holds while the harts stay where they stopped, as the chip runs on
     * while a debugger holds them: the console then has every character the program wrote. False, with
     * `refused` saying why, where the chip refuses something on the way.
     */
    finish_sending(*self) -> bool
        // A run that ends at a breakpoint ends inside a quantum, before the board has taken what the line
        // sent during it.
        self.settle()
        loop
            val n = self.chip.sending_due(0) match
                Some(n) -> n
                None -> return true
            self.chip.advance(n)
            self.settle()
            if self.watchdog_reset() then return false

    // Whether the UARTs' lines did something benchtop does not model, or a watchdog reset since the last
    // call has taken down a hart's PSM stage; either ends the run with `refused` saying so.
    private watchdog_reset(*self) -> bool
        self.chip.take_line_fault() match
            Some(why) ->
                if self.refused.is_empty() then self.refused = s"the chip: $why"
                return true
            None -> ()
        val stages = self.chip.take_restart() match
            Some(s) -> s
            None -> return false
        if stages & (psm_reg.WDSEL_PROC0_MASK | psm_reg.WDSEL_PROC1_MASK) == 0 then return false
        if self.refused.is_empty() then self.refused = s"the chip: $RESTART_REFUSED"
        true

    /** The harts that have started are all asleep, with nothing that would wake one now (an interrupt
     * the last `settle` raised, such as a GPIO edge driven from outside between runs).
     */
    asleep(*self) -> bool
        for k in 0..<2 do if self.started[k] && (self.harts[k].stop != Stop.Sleep || rv.wakes_now(&self.harts[k])) then return false
        true

    // After the chip has moved: the bytes UART0 sent, core 1's launch, and every hart's interrupts.
    private settle(*self)
        loop
            self.chip.uarts[0].take() match
                Some(c) -> self.console.push(c)
                None -> break
        // PSM holding core 1 stops it; releasing it starts it from reset, in the boot ROM.
        if self.chip.take_core1_reset() then self.started[1] = false
        if self.chip.take_core1_release() then self.reset_hart(1, RISCV_RESET_VECTOR)
        for k in 0..<2 do self.chip.signal(&self.harts[k])

    // The chip's clock at hart `cpu`'s `n`th retired instruction.
    private at(*self, cpu: *rv.Cpu, n: u64) -> u64 = self.quantum_at + (n - self.retired_at[usize(cpu.hart)])

    // The first refusal is the run's reason; what the hart does after its trap is not.
    private refuse(*self, cpu: *rv.Cpu, a: u32, why: string)
        if self.refused.is_empty() then self.refused = s"hart ${cpu.hart} at pc 0x${hex(cpu.pc, 8)}: $why"
        rv.halt(cpu, Stop.Unmapped, a)
end RiscvBoard

impl rv.Bus for RiscvBoard
    read(*self, cpu: *rv.Cpu, a: u32, width: u32, n: u64) -> u32
        self.chip.catch_up(self.at(cpu, n))
        if self.chip.restarting(cpu.hart)
            self.refuse(cpu, a, RESTART_REFUSED)
            return 0
        // The boot ROM, read and fetched through the bus: a hart's RAM window is the SRAM.
        if a < ROM_BYTES then return rom_read(a, width)
        self.chip.read(cpu.hart, a, width) match
            Ok(v) -> v
            Err(why) ->
                self.refuse(cpu, a, why)
                0

    write(*self, cpu: *rv.Cpu, a: u32, width: u32, x: u32, n: u64)
        self.chip.catch_up(self.at(cpu, n))
        if self.chip.restarting(cpu.hart)
            self.refuse(cpu, a, RESTART_REFUSED)
            return
        if a < ROM_BYTES
            self.refuse(cpu, a, s"0x${hex(a, 8)} is in the boot ROM, which is read-only")
            return
        self.chip.write(cpu.hart, a, width, x) match
            Ok(_) ->
                self.settle()
                if self.chip.restarting(cpu.hart) then self.refuse(cpu, a, RESTART_REFUSED)
            Err(why) -> self.refuse(cpu, a, why)

// The DMA reaches SRAM and the boot ROM here, as the harts do: a store into SRAM is another master's
// (`rv.external_write`), so code decoded from it decodes again and a reservation on it is broken; a
// write to the ROM is ignored.
impl DmaMemory for RiscvBoard
    dma_read(*self, a: u32, width: u32) -> Reach
        if a < ROM_BYTES then return Reach.Done(rom_read(a, width))
        if a < self.base || a - self.base >= u32(self.sram.len()) then return Reach.Chip
        val at = usize(a - self.base)
        var v: u32 = 0
        for k in 0..<usize(width) do v |= u32(self.sram[at + k]) << u32(8 * k)
        Reach.Done(v)

    dma_write(*self, a: u32, width: u32, x: u32) -> Reach
        if a < ROM_BYTES then return Reach.Done(0)
        if a < self.base || a - self.base >= u32(self.sram.len()) then return Reach.Chip
        if rv.external_write(&self.harts[0], a, width, x) then Reach.Done(0) else Reach.BusError
