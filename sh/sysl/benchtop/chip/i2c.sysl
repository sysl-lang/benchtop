module sh.sysl.benchtop.chip

import sh.sysl.benchtop.peripheral.rp2040.AccessError
import sh.sysl.benchtop.peripheral.rp2350.{GPIO_COUNT, I2cFault, I2cPart, Wiring, i2c_wiring}
import sysl.fmt.hex

// I2C0 and I2C1 on both chips (`peripheral/rp2350/i2c.sysl`): the controllers' registers on the bus, the
// lines the GPIO mux, the pads and the workbench give them (`i2c_lines`), the parts on the workbench
// (`attach_i2c`), their interrupts and the RP2350's DMA requests. The bus runs only where a master's step
// ends (`i2c_due`), so an idle bus, or one a slave holds while its CPU answers, costs nothing.

/** The RP2350's I2C DMA requests (the SDK's `dreq.h`): I2C0 TX, then RX, then I2C1's. */
const DREQ_I2C0_TX: u32 = 44

impl Rp2350
    /** A part on the workbench's I2C lines, on GPIOs `p.sda` and `p.scl`. */
    attach_i2c(*self, p: I2cPart) = self.i2c.parts.push(p)

    /** Each controller's lines as the chip stands now. */
    i2c_lines(*self) -> [2]Wiring
        var driving: u64 = 0
        for n in 0u32..<GPIO_COUNT do if self.pin(n).drives then driving |= 1u64 << n
        i2c_wiring(&self.io, &self.pads, self.wires, self.outside_driven, driving, self.i2c.parts)

    // Every I2C step that has ended by `now`.
    private[chip] i2c_steps(*self)
        val w = self.i2c_lines()
        self.i2c.run(self.now, w)

    // The clk_sys cycles until an I2C step ends, None while no master's step is timed.
    private[chip] i2c_due(*self) -> Option[u64]
        val t = self.i2c.next_due()
        if t == 0xffffffffffffffff then None else Some(if t > self.now then t - self.now else 0)

    /** DMA request `dreq` as the I2C controllers drive it (`DREQ_I2C0_TX` to `DREQ_I2C1_RX`); None for a
     * request that is not theirs.
     */
    i2c_dreq(*self, dreq: u32) -> Option[bool]
        if dreq < DREQ_I2C0_TX || dreq >= DREQ_I2C0_TX + 4 then return None
        val u = self.i2c.units[usize((dreq - DREQ_I2C0_TX) / 2)]
        Some(if (dreq - DREQ_I2C0_TX) % 2 == 0 then u.dreq_tx() else u.dreq_rx())

    private[chip] i2c_read(*self, p: Placed, o: u32, width: u32) -> Result[u32, string]
        val k: usize = if p.block == Block.I2c0 then 0 else 1
        self.i2c.read(k, o, width, self.now).map_err(f -> i2c_refusal(p.name, o, f, (e -> refusal(p, o, e))))

    private[chip] i2c_write(*self, p: Placed, o: u32, width: u32, x: u32) -> Result[unit, string]
        val k: usize = if p.block == Block.I2c0 then 0 else 1
        val w = self.i2c_lines()
        val before = self.i2c
        self.i2c.write(k, o, width, x, self.now, w) match
            Ok(_) -> Ok(())
            Err(f) ->
                self.i2c = before
                Err(i2c_refusal(p.name, o, f, (e -> refusal(p, o, e))))
end Rp2350

impl Rp2040
    /** A part on the workbench's I2C lines, on GPIOs `p.sda` and `p.scl`. */
    attach_i2c(*self, p: I2cPart) = self.i2c.parts.push(p)

    /** Each controller's lines as the chip stands now: the RP2040's workbench has no wires. */
    i2c_lines(*self) -> [2]Wiring
        var driving: u64 = 0
        for n in 0u32..<self.io.count do if self.pin(n).drives then driving |= 1u64 << n
        i2c_wiring(&self.io, &self.pads, [0xFF; GPIO_COUNT], self.outside_driven, driving, self.i2c.parts)

    private[chip] i2c_steps(*self)
        val w = self.i2c_lines()
        self.i2c.run(self.now, w)

    private[chip] i2c_due(*self) -> Option[u64]
        val t = self.i2c.next_due()
        if t == 0xffffffffffffffff then None else Some(if t > self.now then t - self.now else 0)

    private[chip] i2c_read40(*self, p: Placed40, o: u32, width: u32) -> Result[u32, string]
        val k: usize = if p.block == Block40.I2c0 then 0 else 1
        self.i2c.read(k, o, width, self.now).map_err(f -> i2c_refusal(p.name, o, f, (e -> refusal40(p, o, e))))

    private[chip] i2c_write40(*self, p: Placed40, o: u32, width: u32, x: u32) -> Result[unit, string]
        val k: usize = if p.block == Block40.I2c0 then 0 else 1
        val w = self.i2c_lines()
        val before = self.i2c
        self.i2c.write(k, o, width, x, self.now, w) match
            Ok(_) -> Ok(())
            Err(f) ->
                self.i2c = before
                Err(i2c_refusal(p.name, o, f, (e -> refusal40(p, o, e))))
end Rp2040

// Why a controller refused an access, as a person reads it; `access` words an access error.
private i2c_refusal(name: string, o: u32, f: I2cFault, access: &Fn(AccessError) -> string) -> string = f match
    Access(e) -> access(e)
    Refused(why) -> s"$name + 0x${hex(o)}: $why"
