module sh.sysl.benchtop.chip

import sh.sysl.benchtop.v6m.IdauRegion

// The RP2350's boot ROM: Raspberry Pi's own image for the A4 stepping, built from
// github.com/raspberrypi/pico-bootrom-rp2350 (rom/README.md), which both boards map at address 0, and
// the facts about it each board relies on where it runs its own side of a boot.
//
// **What runs it.** On the Arm board each M33 starts from reset in it (its vector table at 0), so core
// 1's wait for a launch is the ROM's own code, and every function the SDK looks up through the ROM's
// table (`rom_func_lookup`) is the ROM's. On the RISC-V board hart 1 starts at the Hazard3 reset vector
// in it and waits there the same way. **Core 0's boot path is not run**: power-on and the watchdog's
// reset hand an image over as the ROM's boot path would (`ArmBoard`), writing what its BOOT_INFO
// reports, and the chip ID it copies from the OTP, where the ROM keeps them. That path needs the TRNG
// and SHA-256 blocks and the image and partition parsing (docs/rp-coverage.md items 25 and 30); the OTP
// it reads is modelled (item 26).

/** The boot ROM's window at address 0. */
const ROM_BYTES: u32 = 32 * 1024
private[chip] val ROM = embed("rom/bootrom-rp2350-a4.bin")

/** Where a Hazard3 hart starts: the ROM's RISC-V reset vector (`__reset_vector`). */
const RISCV_RESET_VECTOR: u32 = 0x7DFC

/** What the ROM's Arm start-up writes on each core (`arm8_bootrom_rt0.S`): CPACR's and NSACR's CP7
 * fields, and SAU region 7, from the end of its Secure-only text to its secure gateways' end.
 */
const ROM_CPACR: u32 = 0xC000
const ROM_NSACR: u32 = 0x80
const ROM_SAU_RBAR: u32 = 0x4780
const ROM_SAU_RLAR: u32 = 0x7FE1

/** The IDAU's one region with a number: the ROM's secure gateways, Non-secure callable. */
val ROM_NSC: IdauRegion = IdauRegion(0x7E00, 0x7FFF, 2)

/** The boot types the ROM's BOOT_INFO reports (`boot/bootrom_constants.h`). */
const BOOT_TYPE_NORMAL: u32 = 0
const BOOT_TYPE_BOOTSEL: u32 = 2
const BOOT_TYPE_PC_SP: u32 = 0xD
/** The magic of a watchdog boot request in SCRATCH4 (the SDK's `watchdog_reboot`). */
const WATCHDOG_BOOT_MAGIC: u32 = 0xB007C0D3
/** The first word of an image's block (`boot/picobin.h`), which the ROM's normal boot looks for in the
 * flash's first 4 KB.
 */
const BLOCK_MARKER_START: u32 = 0xFFFFDED3

/** Where in BOOTRAM's 1 KB the ROM keeps what `get_sys_info`'s BOOT_INFO answers (its `bootram_t`,
 * `always`): the boot word and the boot diagnostic, and the two reboot parameters.
 */
const BOOTRAM_BOOT_WORD: u32 = 0x358
const BOOTRAM_REBOOT_PARAMS: u32 = 0x340
/** Where its boot path copies the chip ID from OTP rows 0–3, which `get_sys_info`'s CHIP_INFO answers
 * (BOOTRAM's last 8 bytes).
 */
const BOOTRAM_CHIP_ID: u32 = 0x3F8

/** The little-endian word at `at` in the ROM. */
rom_word(at: u32) -> u32 = rom_read(at, 4)

/** `width` bytes at `at` in the ROM, little-endian; `at` must be inside it. */
rom_read(at: u32, width: u32) -> u32
    var v: u32 = 0
    for k in 0u32..<width do v |= u32(ROM[usize(at + k)]) << (8 * k)
    v
