module sh.sysl.benchtop.chip
@tests

import sh.sysl.benchtop.{library, load}
import sh.sysl.benchtop.v6m as arm
import sh.sysl.benchtop.v6m.{CoprocessorKind, CoprocessorOp, Stop}
import sh.sysl.parsing.source_of
import sh.sysl.rp2350.sio as sio_reg
import sysl.buf.{Buf, buf}
import sysl.fmt.hex
import sysl.text.from_utf8_lossy

// The Arm Pico 2 (`ArmBoard`): the SDK's own programs end to end (examples/pico2, built by its
// build.sh), and each piece of the chip they needed on the way — the boot, core 1's launch, the boot
// ROM, the coprocessors and the plan that picks the board.

private val HELLO_SERIAL = embed("../../../../examples/pico2/hello_serial.elf")
private val ARM_BLINK = embed("../../../../examples/pico2/blink.elf")
private val ARM_RCP = embed("../../../../examples/pico2/rcp.elf")
private val ARM_GPIOC = embed("../../../../examples/pico2/gpioc.elf")
private val ARM_ROM = embed("../../../../examples/pico2/rom.elf")

private val PICO2_ARM_SRAM = SramMap(0x20000000, 520 * 1024)

// 0.1 ms of clk_sys at 150 MHz: how finely the end-to-end tests sample.
private const TENTH_MS: u64 = 15000
private const MS: u64 = 150000

@test("a Pico 2 on its Cortex-M33s runs the SDK's hello_serial: UART0 prints a numbered line every 100 ms of guest time")
arm_hello_serial()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(HELLO_SERIAL).unwrap()
    var lines: Buf[u64] = buf()
    var seen: usize = 0
    while b.chip.now < 360 * MS
        val end = b.run(TENTH_MS)
        assert(end == RunEnd.Budget, s"${b.refused}; core 0 stopped ${b.cores[0].stop} at 0x${hex(b.cores[0].stop_at, 8)}")
        for i in seen..<b.console.len() do if b.console[i] == u8('\n') then lines.push(b.chip.now)
        seen = b.console.len()
    val text = from_utf8_lossy(b.console.view())
    assert(text == "hello, serial 0\r\nhello, serial 1\r\nhello, serial 2\r\nhello, serial 3\r\n", text)
    assert(b.chip.sys_hz() == 150000000 && b.chip.ref_hz() == 12000000, "runtime_init clocked the chip from the PLL and the crystal")
    // stdio_init_all and the first line within the first millisecond; then sleep_ms(100) each time.
    assert(lines[0] < MS, s"the first line at ${lines[0]}")
    for k in 1..<lines.len()
        val gap = lines[k] - lines[k - 1]
        assert(gap >= 100 * MS && gap <= 100 * MS + 5 * TENTH_MS, s"line $k came ${gap} cycles after the one before")
    assert(waits_in_rom(b, 1), s"core 1 is still in the boot ROM, asleep: pc 0x${hex(b.cores[1].pc, 8)}")

@test("a Pico 2 on its Cortex-M33s runs the SDK's blink: GPIO 25 drives the LED and toggles every 250 ms of guest time")
arm_blink()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_BLINK).unwrap()
    var toggles: Buf[u64] = buf()
    var level = false
    while b.chip.now < 1100 * MS
        val end = b.run(TENTH_MS)
        assert(end == RunEnd.Budget, s"${b.refused}; core 0 stopped ${b.cores[0].stop} at 0x${hex(b.cores[0].stop_at, 8)}")
        val led = b.chip.pin(25)
        assert(toggles.is_empty() || led.drives, "once set up, GPIO 25 always drives")
        if led.drives && led.level != level
            toggles.push(b.chip.now)
            level = led.level
    // On at once, then off, on, off, on: five edges in 1.1 s.
    assert(toggles.len() == 5, s"${toggles.len()} toggles")
    assert(toggles[0] < MS, s"the first toggle at ${toggles[0]}")
    for k in 1..<toggles.len()
        val gap = toggles[k] - toggles[k - 1]
        assert(gap >= 250 * MS && gap <= 250 * MS + 5 * TENTH_MS, s"toggle $k came ${gap} cycles after the one before")
    assert(level, "the LED is on after the fifth edge")
    // gpio_put went through the GPIO coprocessor into the SIO.
    assert(b.chip.sio.out & (1u64 << 25) != 0 && b.chip.sio.oe & (1u64 << 25) != 0)

private val STACK_LIMIT = embed("../../../../examples/pico2/stack_limit.elf")
private val ARM_TT = embed("../../../../examples/pico2/tt.elf")

// Run `image` on a Pico 2 until a BKPT ends it, within `ms` of guest time, answering UART0's text.
private[chip] run_to_breakpoint(image: []const u8, ms: u64) -> string
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(image).unwrap()
    var end = RunEnd.Budget
    while end == RunEnd.Budget && b.chip.now < ms * MS do end = b.run(TENTH_MS)
    assert(end == RunEnd.Breakpoint, s"${end} ${b.refused}; core 0 stopped ${b.cores[0].stop} at 0x${hex(b.cores[0].stop_at, 8)}")
    from_utf8_lossy(b.console.view())

@test("the SDK's stack_limit: MSPLIM 1 KB below SP, a 2 KB frame is the UsageFault STKOF in its handler, which lifts the limit, and the SUB runs again")
arm_stack_limit()
    val text = run_to_breakpoint(STACK_LIMIT, 50)
    val want = "msplim 1 KB below sp\r\ndeep returned 42 after 1 fault(s)\r\ncfsr 0x00100000 (STKOF set), in deep: yes\r\nmsplim now 0x00000000, cfsr now 0x00000000\r\n"
    assert(text == want, text)

// One line of tt.c's: the name in ten columns (`name` comes padded), then the four answers.
private tt_line(name: string, tt: u32, ttt: u32, tta: u32, ttat: u32) -> string =
    s"$name TT ${hex(tt, 8)} TTT ${hex(ttt, 8)} TTA ${hex(tta, 8)} TTAT ${hex(ttat, 8)}\r\n"

@test("the SDK's tt: ACLE's cmse_TT, TTT, TTA and TTAT of SRAM and the PPB, before and after two SAU regions, one Non-secure and one Non-secure callable")
arm_tt()
    val text = run_to_breakpoint(ARM_TT, 50)
    val ppb = tt_line("ppb       ", 0x004C0000, 0x00400000, 0x004C0000, 0x00400000)
    val sram = tt_line("sram      ", 0x004C0000, 0x004C0000, 0x004C0000, 0x004C0000)
    val ns = tt_line("ns        ", 0x003E0000, 0x003E0000, 0x003E0000, 0x003E0000)
    val nsc = tt_line("nsc       ", 0x004E0500, 0x004E0500, 0x004E0500, 0x004E0500)
    val secure = tt_line("secure    ", 0x004C0000, 0x004C0000, 0x004C0000, 0x004C0000)
    val want = s"sau ctrl 0 type 8\r\n$sram$ppb$ns$nsc$secure$ppb"
    assert(text == want, text)

// Thumb halfwords into SRAM at `at`, for core `k` to run next from there.
private place(b: &ArmBoard, at: u32, code: []const u16)
    for i in 0..<code.len
        b.mem.ram[at - b.map.base + 2 * u32(i)] = u8.wrap(code[i])
        b.mem.ram[at - b.map.base + 2 * u32(i) + 1] = u8(code[i] >> 8)

// Core 0 parked in `wfi; b .` at 0x20070100, out of the way of what the test does from outside it.
private[chip] park_core0(b: &ArmBoard)
    place(b, 0x20070100, [0xBF30, 0xE7FD])
    b.cores[0].pc = 0x20070100

// What crt0's debugger entry does on core 0 before anything else: CP7 enabled in CPACR and both RCP
// salts set, with an SEV, which lets core 1's boot ROM past its wait for them.
private[chip] salted(b: &ArmBoard)
    b.cores[0].cpacr = ROM_CPACR
    b.chip.rcp.salted = [true, true]
    b.cores[1].event = true

// Core 0's side of one word of the SDK's launch (`multicore_launch_core1_raw`), made from the test:
// a 0 drains core 0's FIFO first; the word goes into core 1's with an event, and the board runs until
// the boot ROM's own code on core 1 answers it. The answer.
private[chip] push_and_echo(b: &ArmBoard, x: u32) -> u32
    val st = sio_reg.BASE + sio_reg.FIFO_ST_OFFSET
    val rd = sio_reg.BASE + sio_reg.FIFO_RD_OFFSET
    if x == 0 then while b.chip.read(0, st, 4).unwrap() & sio_reg.FIFO_ST_VLD_MASK != 0 do b.chip.read(0, rd, 4).unwrap()
    b.chip.write(0, sio_reg.BASE + sio_reg.FIFO_WR_OFFSET, 4, x).unwrap()
    b.cores[1].event = true
    for i in 0..<100
        if b.chip.read(0, st, 4).unwrap() & sio_reg.FIFO_ST_VLD_MASK != 0 then return b.chip.read(0, rd, 4).unwrap()
        b.run(1000)
    assert(false, s"core 1's boot ROM never answered 0x${hex(x)}: core 1 at 0x${hex(b.cores[1].pc, 8)}")
    0

// The whole launch, from the test, the salts set first: 0, 0, 1, the vector table, the stack pointer
// and the entry, each echoed.
private[chip] launch_from_test(b: &ArmBoard, vtor: u32, sp: u32, entry: u32)
    salted(b)
    for x in [0u32, 0, 1, vtor, sp, entry] do assert(push_and_echo(b, x) == x, s"the ROM echoes 0x${hex(x)}")

// Whether core `k` waits in the boot ROM: started, asleep, at a ROM address.
private[chip] waits_in_rom(b: &ArmBoard, k: usize) -> bool = b.started[k] && b.cores[k].sleeping && b.cores[k].pc < ROM_BYTES

@test("a refused access ends the Arm run with the chip's reason, at the core's PC; a write to the read-only ROM is refused by name")
arm_refused_access()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_BLINK).unwrap()
    // ldr r1, [r0]; bkpt — r0 IO_BANK0's GPIO0_CTRL, still held in reset.
    place(b, 0x20070000, [0x6801, 0xBE00])
    b.cores[0].pc = 0x20070000
    b.cores[0].r[0] = 0x40028004
    assert(b.run(1000) == RunEnd.Fault)
    assert(b.refused == "core 0 at pc 0x20070000: IO_BANK0 is held in reset (RESETS bit 6): release it before touching 0x40028004", b.refused)
    val w = arm_board(PICO2_ARM_SRAM)
    w.boot(ARM_BLINK).unwrap()
    // str r1, [r0]
    place(w, 0x20070000, [0x6001, 0xBE00])
    w.cores[0].pc = 0x20070000
    w.cores[0].r[0] = 0x100
    val before = w.mem.ram[w.rom_at + 0x100]
    assert(w.run(1000) == RunEnd.Fault)
    assert(w.refused == "core 0 at pc 0x20070000: 0x00000100 is in the boot ROM, which is read-only", w.refused)
    assert(w.cores[0].stop == Stop.Unmapped && w.cores[0].stop_at == 0x100 && w.mem.ram[w.rom_at + 0x100] == before, "the ROM is unchanged")

@test("a way to Non-secure state ends the Arm run with its name, on either core: BXNS on core 0, MRS of MSP_NS on core 1")
arm_non_secure()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_BLINK).unwrap()
    // bxns r0, r0 an even address; bkpt
    place(b, 0x20070000, [0x4704, 0xBE00])
    b.cores[0].pc = 0x20070000
    b.cores[0].r[0] = 0x20070100
    assert(b.run(1000) == RunEnd.Fault)
    assert(b.refused == "core 0 at pc 0x20070000: BXNS to a Non-secure address: Non-secure state is not modelled", b.refused)
    assert(b.cores[0].stop == Stop.NonSecure && b.cores[0].pc == 0x20070000)

    val s = arm_board(PICO2_ARM_SRAM)
    s.boot(ARM_BLINK).unwrap()
    // Core 1: mrs r0, msp_ns. Core 0: wfi, b . (asleep until core 1 ends the run).
    place(s, 0x20070000, [0xF3EF, 0x8088, 0xBE00])
    park_core0(s)
    launch_from_test(s, 0x20000000, 0x20080000, 0x20070001)
    assert(s.run(100000) == RunEnd.Fault)
    assert(s.refused == "core 1 at pc 0x20070000: MRS or MSR of a Non-secure register: Non-secure state is not modelled", s.refused)

@test("core 1 leaves the boot ROM's own wait at the entry, stack pointer and VTOR core 0 sends it, and runs on the Arm board")
arm_core1_launch()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_BLINK).unwrap()
    // Core 1: movs r0, #42; bkpt. Core 0: wfi, b . (asleep until core 1 ends the run).
    place(b, 0x20070000, [0x202A, 0xBE00])
    park_core0(b)
    launch_from_test(b, 0x20000000, 0x20080000, 0x20070001)
    assert(b.run(100000) == RunEnd.Breakpoint, s"${b.refused}")
    val c = &b.cores[1]
    assert(b.started[1] && c.r[0] == 42 && c.vtor == 0x20000000 && c.r[13] == 0x20080000 && c.stop_at == 0x20070002)
    assert(c.core == 1 && c.security && c.coprocessors == 0xB1 && c.nvic_irqs == 52)
    // Called from the ROM's `core1_launch` (its BLX at 0x240): an entry that returns goes back into the
    // ROM, to its `native_wait_rescue`.
    assert(c.r[14] == 0x243, s"lr 0x${hex(c.r[14], 8)}")
    // The ROM left its own security set-up on the core: CP7 in CPACR, NSACR and the Non-secure CPACR,
    // and SAU region 7 enabled.
    assert(c.cpacr == ROM_CPACR && c.nsacr == ROM_NSACR && c.cpacr_ns == ROM_CPACR, s"0x${hex(c.cpacr)} 0x${hex(c.nsacr)}")
    assert(c.sau_ctrl == 1 && c.sau_rbar[7] == ROM_SAU_RBAR && c.sau_rlar[7] == ROM_SAU_RLAR)

@test("the boot ROM's handshake as its code has it: a word other than 1 in the 1's place is answered with 0 and the handshake starts again; a 0 in the vector table's place restarts it too; the launch after")
arm_core1_launch_edges()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_BLINK).unwrap()
    // Core 1: movs r0, #42; bkpt.
    place(b, 0x20070000, [0x202A, 0xBE00])
    park_core0(b)
    salted(b)
    assert(push_and_echo(b, 0) == 0, "the first 0, the ROM's own 0 drained")
    assert(push_and_echo(b, 7) == 0, "a stray word: the ROM answers 0 and waits for the handshake again")
    for x in [0u32, 1] do assert(push_and_echo(b, x) == x)
    assert(push_and_echo(b, 0) == 0, "a 0 where the vector table goes: back to the handshake")
    for x in [0u32, 0, 1, 0x20000000, 0x20080000, 0x20070001] do assert(push_and_echo(b, x) == x, s"echo of 0x${hex(x)}")
    assert(b.run(100000) == RunEnd.Breakpoint, b.refused)
    assert(b.cores[1].r[0] == 42 && b.cores[1].vtor == 0x20000000)

@test("the boot ROM's lookup through 0x16 finds bootrom_state_reset for Arm Secure and for RISC-V callers, and answers 0 for a code it lacks")
arm_rom_lookup()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_BLINK).unwrap()
    // The ROM's lookup checks itself with the RCP, whose salt crt0 sets.
    salted(b)
    // movs r6, #0x16; ldrh r6, [r6]; then lookup('SR', Arm Secure) into r4, lookup('A', Arm Secure)
    // into r5, and lookup('SR', RISC-V) into r0; bkpt.
    place(b, 0x20070000, [0x2616, 0x8836, 0xF245, 0x2053, 0x2104, 0x47B0, 0x4604, 0x2041, 0x2104, 0x47B0, 0x4605,
        0xF245, 0x2053, 0x2101, 0x47B0, 0xBE00])
    val c = &b.cores[0]
    c.pc = 0x20070000
    c.r[13] = 0x20080000
    assert(b.run(10000) == RunEnd.Breakpoint, s"${b.refused} ${c.stop} 0x${hex(c.stop_at, 8)}")
    // The A4 ROM's own table: s_varm_step_safe_api_crit_bootrom_state_reset, and its RISC-V twin.
    assert(c.r[4] == 0x28CD, s"state_reset at 0x${hex(c.r[4])}")
    assert(c.r[5] == 0, s"'A' found at 0x${hex(c.r[5])}")
    // The table's RISC-V entry for 'SR' is the A4 ROM's own value for it, not the Arm one.
    assert(c.r[0] == 0xB4A1, s"RISC-V state_reset at 0x${hex(c.r[0])}")
    // The magic, version 2.4, and the well-known halfwords where the SDK reads them.
    assert(rom_read(0x10, 2) == 0x754D && rom_read(0x12, 1) == 2 && rom_read(0x13, 1) == 4)
    assert(b.mem.ram[b.rom_at + 0x16] == 0x8D && b.mem.ram[b.rom_at + 0x18] == 0x4D, "lookup_val and lookup_entry")

@test("the SDK calling Raspberry Pi's ROM on a Pico 2: its header and git revision, the lookup found and not, BOOT_INFO, the flash erased, programmed and its unique ID read through the ROM's flash functions, and a PC/SP reboot through the ROM's own reboot")
arm_rom_program()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_ROM).unwrap()
    var end = RunEnd.Budget
    while end == RunEnd.Budget && b.chip.now < 200 * MS do end = b.run(MS)
    val text = from_utf8_lossy(b.console.view())
    assert(end == RunEnd.Breakpoint, s"$end ${b.refused}: $text")
    val want = "rom: magic Mu version 2.4, git revision 0xc6cdb171\r\n" +
        "lookup: 10 of 10 found, 'ZZ' not found\r\n" +
        "power-on: get_sys_info 5 words, flags 0x40, boot word 0x00ff02ff, diagnostic 0x00000000, params 0x0 0x0\r\n" +
        "flash: erased ok, programmed ok, next page erased\r\n" +
        "unique id: e6 60 58 38 83 2b 4a 2e\r\n" +
        "rebooting to PC/SP\r\n" +
        "reboot returned 0\r\n" +
        "rebooted: reason 0x1, sp in the stack given 1\r\n" +
        "after the reboot: get_sys_info 5 words, flags 0x40, boot word 0x00ff0dff, diagnostic 0x00000000, params 0x0 0x0\r\n" +
        "done\r\n"
    assert(text == want, text)
    // The page the ROM programmed is in the flash's array, 1 MB in; the rest of its sector erased.
    for i in 0u32..<256 do assert(b.mem.flash[0x100000 + i] == u8.wrap(i * 7 + 3), s"byte $i")
    assert(b.mem.flash[0x100000 + 256] == 0xFF && b.mem.flash[0x100000 + 4095] == 0xFF)
    // The ROM's reboot spares PROC_COLD, so the salts survived; core 1 went back to the ROM's wait.
    assert(b.chip.rcp.salted[0] && b.chip.rcp.salted[1] && b.chip.psm.wdsel == 0x01FFFFFE, s"wdsel 0x${hex(b.chip.psm.wdsel)}")
    assert(b.started[1] && b.cores[1].pc < ROM_BYTES, s"core 1 at 0x${hex(b.cores[1].pc, 8)}")

@test("SEV on core 0 wakes core 1's boot ROM from its wait for the salts: core 1 then reports to core 0 with a 0")
arm_sev_wakes_the_rom()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_BLINK).unwrap()
    park_core0(b)
    b.run(5000)
    assert(waits_in_rom(b, 1) && b.cores[1].pc < 0x1D8, s"core 1 waits for its salt: 0x${hex(b.cores[1].pc, 8)}")
    // The salts set as crt0 sets them, but no event: core 1 sleeps on.
    b.chip.rcp.salted = [true, true]
    b.run(5000)
    val st = sio_reg.BASE + sio_reg.FIFO_ST_OFFSET
    assert(b.chip.read(0, st, 4).unwrap() & sio_reg.FIFO_ST_VLD_MASK == 0 && waits_in_rom(b, 1), "asleep without an event")
    // Core 0: sev; then its park.
    place(b, 0x20070200, [0xBF40, 0xBF30, 0xE7FD])
    b.cores[0].pc = 0x20070200
    b.cores[0].sleeping = false
    b.run(5000)
    assert(b.chip.read(0, st, 4).unwrap() & sio_reg.FIFO_ST_VLD_MASK != 0, s"core 1 at 0x${hex(b.cores[1].pc, 8)}")
    assert(b.chip.read(0, sio_reg.BASE + sio_reg.FIFO_RD_OFFSET, 4).unwrap() == 0 && waits_in_rom(b, 1), "its 0, then the wait for a launch")
    assert(b.cores[0].event, "core 0's own SEV set its own register too, which its WFI does not consume")

@test("the boot ROM image is the A4 release, whole: its size, the magic, its Arm and RISC-V reset vectors")
arm_rom_image()
    assert(ROM.len == usize(ROM_BYTES))
    assert(rom_word(0) == 0xF0000000 && rom_word(4) == 0xA1, "the Arm vector table: SP, then s_arm8_entry_point with its Thumb bit")
    // The RISC-V reset vector: `j riscv_entry_point` (0x7660).
    assert(rom_word(RISCV_RESET_VECTOR) == 0x865FF06F, s"0x${hex(rom_word(RISCV_RESET_VECTOR), 8)}")
    // The ROM's git revision, the tag's commit (ROM_DATA_SOFTWARE_GIT_REVISION).
    var found = false
    for at in 0u32..<(ROM_BYTES / 4) do if rom_word(4 * at) == 0xC6CDB171 then found = true
    assert(found, "the A4 tag's commit is in the image")
private gpioc(kind: CoprocessorKind, opc1: u32, crm: u32, low: u32, high: u32) -> CoprocessorOp = CoprocessorOp(kind, 0, opc1, 0, 0, crm, low, high, false)

@test("the GPIO coprocessor is the SIO's GPIO registers: masks low, high and both, single bits, indexed writes and the reads")
arm_gpioc()
    var c = rp2350()
    val w = CoprocessorKind.Write
    val p = CoprocessorKind.WritePair
    c.coprocessor(0, gpioc(w, 0, 0, 0x0F, 0)).unwrap().unwrap()
    c.coprocessor(0, gpioc(w, 1, 0, 0x03, 0)).unwrap().unwrap()
    c.coprocessor(0, gpioc(w, 2, 0, 0x100, 0)).unwrap().unwrap()
    c.coprocessor(0, gpioc(w, 3, 0, 0x04, 0)).unwrap().unwrap()
    assert(c.sio.out == 0x108, s"put, xor, set, clr: ${c.sio.out}")
    c.coprocessor(0, gpioc(w, 2, 1, 0x1, 0)).unwrap().unwrap()
    assert(c.sio.out == 0x1_0000_0108, "the high word")
    c.coprocessor(0, gpioc(p, 0, 4, 0xF0, 0x2)).unwrap().unwrap()
    assert(c.sio.oe == 0x2_0000_00F0, "OE, both words at once")
    // Single bits: put 1 and 0, then xor, set and clr, and conditional forms that do nothing on 0.
    c.coprocessor(0, gpioc(p, 4, 0, 25, 1)).unwrap().unwrap()
    assert(c.sio.out & (1u64 << 25) != 0)
    c.coprocessor(0, gpioc(p, 4, 0, 25, 0)).unwrap().unwrap()
    assert(c.sio.out & (1u64 << 25) == 0)
    c.coprocessor(0, gpioc(w, 5, 0, 40, 0)).unwrap().unwrap()
    c.coprocessor(0, gpioc(w, 6, 4, 25, 0)).unwrap().unwrap()
    c.coprocessor(0, gpioc(w, 7, 4, 4, 0)).unwrap().unwrap()
    assert(c.sio.out & (1u64 << 40) != 0 && c.sio.oe & (1u64 << 25) != 0 && c.sio.oe & 0x10 == 0)
    c.coprocessor(0, gpioc(p, 6, 0, 5, 0)).unwrap().unwrap()
    assert(c.sio.out & 0x20 == 0, "a conditional set with 0 sets nothing")
    c.coprocessor(0, gpioc(p, 6, 0, 5, 1)).unwrap().unwrap()
    assert(c.sio.out & 0x20 != 0)
    // Indexed: Rt2 picks the register.
    c.coprocessor(0, gpioc(p, 10, 0, 0x80, 1)).unwrap().unwrap()
    assert(c.sio.out & (0x80u64 << 32) != 0)
    // Reads: OUT, OE and IN, alone and as pairs.
    val r = CoprocessorKind.Read
    assert(c.coprocessor(0, gpioc(r, 0, 0, 0, 0)).unwrap().unwrap() == c.sio.out & 0xFFFFFFFF)
    assert(c.coprocessor(0, gpioc(r, 0, 5, 0, 0)).unwrap().unwrap() == c.sio.oe >> 32)
    assert(c.coprocessor(0, gpioc(CoprocessorKind.ReadPair, 0, 0, 0, 0)).unwrap().unwrap() == c.sio.out)
    assert(c.coprocessor(0, gpioc(CoprocessorKind.ReadPair, 0, 8, 0, 0)).unwrap().unwrap() == 0, "every pad's input is 0 at power-on")
    // What the coprocessor does not have is refused by name.
    val bad = c.coprocessor(0, gpioc(w, 0, 2, 0, 0)).unwrap().unwrap_err()
    assert(!bad.fault && bad.why.contains("MCR p0, #0, c0, c2, #0 is not a GPIO coprocessor instruction"), bad.why)
    assert(c.coprocessor(0, gpioc(p, 4, 0, 64, 1)).unwrap().unwrap_err().why.contains("no GPIO 64"))
    assert(c.coprocessor(0, gpioc(p, 8, 0, 1, 2)).unwrap().is_err(), "index 2 names no register")

@test("the GPIO coprocessor's edges: GPIO 0 and 47 at the ends, 64 refused by every single-bit form, index 2 by every indexed one, the encodings it lacks by name")
arm_gpioc_edges()
    var c = rp2350()
    val w = CoprocessorKind.Write
    val p = CoprocessorKind.WritePair
    for crm in [0u32, 4]
        c.coprocessor(0, gpioc(w, 6, crm, 47, 0)).unwrap().unwrap()
        c.coprocessor(0, gpioc(p, 4, crm, 0, 1)).unwrap().unwrap()
    assert(c.sio.out == (1u64 << 47) | 1 && c.sio.oe == (1u64 << 47) | 1, s"${c.sio.out} ${c.sio.oe}")
    // GPIO 56–63 are the SIO's QSPI and USB pads (high-word bits 24–31): stored. 48–55 are reserved.
    assert(c.coprocessor(0, gpioc(w, 5, 0, 63, 0)).unwrap().is_ok())
    assert(c.sio.out == (1u64 << 63) | (1u64 << 47) | 1)
    c.coprocessor(0, gpioc(w, 5, 0, 50, 0)).unwrap().unwrap()
    assert(c.sio.out == (1u64 << 63) | (1u64 << 47) | 1, "pad 50 is reserved")
    c.coprocessor(0, gpioc(w, 7, 0, 63, 0)).unwrap().unwrap()
    c.coprocessor(0, gpioc(w, 7, 0, 47, 0)).unwrap().unwrap()
    c.coprocessor(0, gpioc(w, 7, 0, 0, 0)).unwrap().unwrap()
    assert(c.sio.out == 0)
    // The OE bank and the indexed high-register write reach the same pads.
    c.coprocessor(0, gpioc(w, 6, 4, 60, 0)).unwrap().unwrap()
    assert(c.sio.oe == (1u64 << 60) | (1u64 << 47) | 1)
    c.coprocessor(0, gpioc(CoprocessorKind.WritePair, 8, 0, 0xFF00FFFF, 1)).unwrap().unwrap()
    assert(c.sio.out == 0xFF00_FFFF_0000_0000, s"${c.sio.out}")
    assert(c.coprocessor(0, gpioc(CoprocessorKind.ReadPair, 0, 0, 0, 0)).unwrap().unwrap() == c.sio.out)
    for crm in [0u32, 4]
        for opc1 in [5u32, 6, 7]
            assert(c.coprocessor(0, gpioc(w, opc1, crm, 64, 0)).unwrap().unwrap_err().why.contains("no GPIO 64"))
        for opc1 in [4u32, 5, 6, 7]
            assert(c.coprocessor(0, gpioc(p, opc1, crm, 0xFFFFFFFF, 1)).unwrap().unwrap_err().why.contains("no GPIO 4294967295"))
        for opc1 in [8u32, 9, 10, 11]
            for index in [2u32, 0xFFFFFFFF]
                val e = c.coprocessor(0, gpioc(p, opc1, crm, 1, index)).unwrap().unwrap_err()
                assert(!e.fault && e.why.contains("is not a GPIO coprocessor instruction"), e.why)
    // Encodings outside gpio_coproc.h: reads of CRm 2, 3, 6, 7, 10 and 15, or with opc1 1; pairs of
    // CRm 1; MCR #4 (put needs a value); MCR to CRm 2; MCRR #12; and any CDP.
    val r = CoprocessorKind.Read
    for op in [gpioc(r, 0, 2, 0, 0), gpioc(r, 0, 3, 0, 0), gpioc(r, 0, 6, 0, 0), gpioc(r, 0, 7, 0, 0), gpioc(r, 0, 10, 0, 0),
            gpioc(r, 0, 15, 0, 0), gpioc(r, 1, 0, 0, 0), gpioc(CoprocessorKind.ReadPair, 0, 1, 0, 0), gpioc(w, 4, 0, 1, 0),
            gpioc(w, 0, 2, 0, 0), gpioc(p, 12, 0, 0, 0), gpioc(p, 0, 1, 0, 0), gpioc(CoprocessorKind.Data, 0, 0, 0, 0),
            CoprocessorOp(w, 0, 0, 0, 1, 0, 0, 0, false)]
        val e = c.coprocessor(0, op).unwrap().unwrap_err()
        assert(!e.fault && e.why.ends_with("is not a GPIO coprocessor instruction benchtop runs"), e.why)
    // Each core's write is its own: core 1 sets GPIO 2 through the same SIO.
    c.coprocessor(1, gpioc(w, 6, 0, 2, 0)).unwrap().unwrap()
    assert(c.sio.out & 4 != 0)

@test("the chip's DCP is on CP4 and CP5, each core's own (dcp_tests.sysl); runtime_init's RCMP reads it idle; an MCR is refused by name; CP1 has nothing on its port")
arm_dcp()
    var c = rp2350()
    assert(c.coprocessor(0, CoprocessorOp(CoprocessorKind.Read, 4, 0, 1, 0, 0, 0, 0, false)).unwrap().unwrap() == 0, "RCMP")
    // WXUP of 1.0 on core 1's CP5, read back by RXMD there and nowhere else.
    assert(c.coprocessor(1, CoprocessorOp(CoprocessorKind.WritePair, 5, 1, 0, 0, 0, 0, 0x3FF00000, false)).unwrap().unwrap() == 0)
    assert(c.coprocessor(1, CoprocessorOp(CoprocessorKind.ReadPair, 5, 0, 0, 0, 8, 0, 0, false)).unwrap().unwrap() == 0x4000000000000000)
    assert(c.coprocessor(1, CoprocessorOp(CoprocessorKind.ReadPair, 4, 0, 0, 0, 8, 0, 0, false)).unwrap().unwrap() == 0)
    val other = c.coprocessor(0, CoprocessorOp(CoprocessorKind.Write, 4, 1, 0, 0, 0, 0, 0, false)).unwrap().unwrap_err()
    assert(!other.fault && other.why.contains("double-precision (DCP)"), other.why)
    assert(c.coprocessor(0, CoprocessorOp(CoprocessorKind.Write, 1, 0, 0, 0, 0, 0, 0, false)).is_none(), "nothing on CP1")

// Core 0 of a booted board runs `code` at 0x20070000, then a BKPT, under `exec`, with r0 upward from
// `regs` and the coprocessors `cpacr` enables (CP0 and CP7 unless it says), until it stops.
private[chip] on_core0(exec: *extern(*arm.Cpu) -> unit, code: []const u16, regs: []const u32, cpacr: u32 = 0xC003) -> &ArmBoard
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_BLINK).unwrap()
    place(b, 0x20070000, code)
    place(b, 0x20070000 + 2 * u32(code.len), [0xBE00])
    val c = &b.cores[0]
    c.pc = 0x20070000
    c.cpacr = cpacr
    for i in 0..<regs.len do c.r[i] = regs[i]
    while c.stop == Stop.Running && c.retired < 100000
        arm.set_limit(c, c.retired + 1000)
        exec(c)
    b

@test("under both executors the GPIO coprocessor's high-bank instructions reach GPIO 56-63 in OUT and OE, and the low bank is untouched")
arm_gpioc_high_executors()
    for exec in [&arm.run_match, &arm.run_threaded]
        // mcr p0, #6, r0, c0, c0 (set OUT bit r0); mcr p0, #6, r1, c0, c4 (set OE bit r1); mcr p0, #6, r2, c0, c0
        val code = [0xEEC0u16, 0x0010, 0xEEC0, 0x1014, 0xEEC0, 0x2010]
        val b = on_core0(exec, code, [60, 63, 57])
        val c = &b.cores[0]
        assert(c.stop == Stop.Breakpoint && c.retired == 3 && b.why.is_empty(), s"${c.stop}: ${b.why}")
        assert(b.chip.sio.out == (1u64 << 60) | (1u64 << 57), hex(b.chip.sio.out, 16))
        assert(b.chip.sio.oe == 1u64 << 63, hex(b.chip.sio.oe, 16))
        assert(b.chip.sio.out & 0xFFFFFFFF == 0 && b.chip.sio.oe & 0xFFFFFFFF == 0)

@test("under both executors the RCP's instructions reach it from the core: salt, canary, check, count, random byte and status land in the core's registers")
arm_rcp_executors()
    for exec in [&arm.run_match, &arm.run_threaded]
        // The salt; mrc p7, #0, r2, c5, c10, #1; mcr p7, #0, r2, c5, c10, #1; mcr p7, #2, r3, c0, c0, #0;
        // mcrr2 p7, #7, r0, r0, c0; mcr p7, #4, r0, c0, c7, #0; mcr2 p7, #5, r0, c0, c7, #1;
        // mrc2 p7, #2, r4, c0, c0, #0; mrc p7, #1, r5, c0, c0, #0
        val code = [0xEC41u16, 0x0780, 0xEE15, 0x273A, 0xEE05, 0x273A, 0xEE40, 0x3710, 0xFC40, 0x0770, 0xEE80, 0x0717,
            0xFEA0, 0x0737, 0xFE50, 0x4710, 0xEE30, 0x5710]
        val b = on_core0(exec, code, [0x89abcdef, 0x01234567, 0, RCP_TRUE])
        val c = &b.cores[0]
        assert(c.stop == Stop.Breakpoint && c.retired == 9 && b.why.is_empty(), s"${c.stop} at 0x${hex(c.stop_at, 8)}: ${b.why}")
        assert(b.chip.rcp.salt[0] == 0x0123456789abcdef && b.chip.rcp.count[0] == 8)
        val canary = b.chip.coprocessor(0, CoprocessorOp(CoprocessorKind.Read, 7, 0, 1, 5, 10, 0, 0, true)).unwrap().unwrap()
        assert(u64(c.r[2]) == canary && c.r[4] < 256 && c.r[5] == RCP_TRUE, s"r2 ${c.r[2]} r4 ${c.r[4]} r5 ${c.r[5]}")

@test("under both executors the DCP runs from the core: dcp_dadd_m into r4:r5, RCMP into the flags, PCMP after it, CP5's own state; CRd not c0 is refused, CP5 without CPACR is NOCP, CP6 has nothing")
arm_dcp_executors()
    for exec in [&arm.run_match, &arm.run_threaded]
        // WXUP r0,r1; WYUP r2,r3; ADD0; ADD1; NRDD; RDDA r4,r5; WXUP; WYUP; ADD0; RCMP APSR_nzcv; mrs r6, apsr;
        // PCMP r7; mcrr p5,#1,r0,r1,c0 (CP5's WXUP); mrrc2 p5,#0,r8,r9,c8 (CP5's PXMD)
        val code = [0xEC41u16, 0x0410, 0xEC43, 0x2411, 0xEE00, 0x0401, 0xEE10, 0x0401, 0xEE80, 0x0420, 0xEC55, 0x4410,
            0xEC41, 0x0410, 0xEC43, 0x2411, 0xEE00, 0x0401, 0xEE10, 0xF430, 0xF3EF, 0x8600, 0xFE10, 0x7430, 0xEC41, 0x0510,
            0xFC59, 0x8508]
        // 1.5 + 2.25, and 1.5 against 2.25.
        val b = on_core0(exec, code, [0, 0x3FF80000, 0, 0x40020000], 0xFF00)
        val c = &b.cores[0]
        assert(c.stop == Stop.Breakpoint && c.retired == 14 && b.why.is_empty(), s"${c.stop} at 0x${hex(c.stop_at, 8)}: ${b.why}")
        assert(c.r[4] == 0 && c.r[5] == 0x400E0000, s"r4:r5 0x${hex(c.r[5], 8)}${hex(c.r[4], 8)}")
        // RCMP: N the engaged flag, Z, C and V clear (less); PCMP after it reads the flag cleared.
        assert(c.r[6] >> 28 == 0x8 && c.r[7] >> 28 == 0, s"r6 0x${hex(c.r[6], 8)} r7 0x${hex(c.r[7], 8)}")
        assert(c.r[8] == 0 && c.r[9] == 0x60000000 && b.chip.dcp.units[0].xm == 0x6000000000000000)
        // cdp p4, #0, c1, c0, c1, #0: ADD0's encoding with CRd c1.
        val crd = on_core0(exec, [0xEE00, 0x1401], [], 0xFF00)
        assert(crd.cores[0].stop == Stop.Unmapped && crd.cores[0].stop_at == 0x20070000, s"${crd.cores[0].stop}")
        assert(crd.why == "CDP p4, #0, c0, c1, #0 is not a double-precision (DCP) coprocessor instruction benchtop runs", crd.why)
        // CP5 with only CP4 enabled; CP6, which has nothing on its port.
        val nocp = on_core0(exec, [0xEC41, 0x0510], [], 0x0300)
        assert(nocp.cores[0].stop == Stop.Fault && nocp.cores[0].stop_at == 0x20070000 && nocp.cores[0].retired == 0, s"${nocp.cores[0].stop}")
        val none = on_core0(exec, [0xEC41, 0x0610], [], 0xFFFF)
        assert(none.cores[0].stop == Stop.Undefined && none.cores[0].stop_at == 0x20070000, s"${none.cores[0].stop}")

@test("under both executors a failed RCP check, rcp_panic and an instruction before the salt stop the core at Fault on the instruction, named; an encoding outside the RCP is refused")
arm_rcp_fault_executors()
    for exec in [&arm.run_match, &arm.run_threaded]
        // The salt, then mcr p7, #2, r3, c0, c0, #0 (rcp_btrue) of false.
        val b = on_core0(exec, [0xEC41, 0x0780, 0xEE40, 0x3710], [1, 2, 0, RCP_FALSE])
        assert(b.cores[0].stop == Stop.Fault && b.cores[0].stop_at == 0x20070004 && b.cores[0].retired == 1, s"${b.cores[0].stop}")
        assert(b.why == "the RCP faults: core 0's rcp_btrue(0x00c300c3) is not true", b.why)
        // cdp p7, #0, c0, c0, c0, #1
        val p = on_core0(exec, [0xEC41, 0x0780, 0xEE00, 0x0720], [1, 2])
        assert(p.cores[0].stop == Stop.Fault && p.cores[0].stop_at == 0x20070004 && p.why == "the RCP faults: core 0 ran rcp_panic", p.why)
        // rcp_btrue of true with no salt yet.
        val early = on_core0(exec, [0xEE40, 0x3710], [0, 0, 0, RCP_TRUE])
        assert(early.cores[0].stop == Stop.Fault && early.cores[0].stop_at == 0x20070000 && early.why.contains("before its salt was set"), early.why)
        // mcrr p7, #1, r3, r3, c8: rcp_b2and's opcode with b2valid's CRm.
        val outside = on_core0(exec, [0xEC41, 0x0780, 0xEC43, 0x3718], [1, 2, 0, RCP_TRUE])
        assert(outside.cores[0].stop == Stop.Unmapped && outside.cores[0].stop_at == 0x20070004, s"${outside.cores[0].stop}")
        assert(outside.why == "MCRR p7, #1, c0, c8, #0 is not a redundancy (RCP) coprocessor instruction benchtop runs", outside.why)
    // Through a run, the fault is the run's reason, at the core's PC.
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_BLINK).unwrap()
    place(b, 0x20070000, [0xEC41, 0x0780, 0xEE40, 0x3710, 0xBE00])
    b.cores[0].pc = 0x20070000
    b.cores[0].cpacr = 0xC000
    b.cores[0].r[3] = 0x1234
    assert(b.run(1000) == RunEnd.Fault)
    assert(b.refused == "core 0 at pc 0x20070004: the RCP faults: core 0's rcp_btrue(0x00001234) is not true", b.refused)

@test("the SDK's rcp_* functions and macros run clean on a Pico 2, every one in both forms, and a corrupted canary stops core 0 at Fault with the check named")
arm_rcp_program()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_RCP).unwrap()
    var end = RunEnd.Budget
    while end == RunEnd.Budget && b.chip.now < 200 * MS do end = b.run(MS)
    val text = from_utf8_lossy(b.console.view())
    assert(text == "salt set\r\ncanary stable, tags differ\r\nbooleans and integers pass\r\nsequence counts pass\r\nrandom bytes read\r\nchecking a corrupted canary\r\n", text)
    val c = &b.cores[0]
    assert(end == RunEnd.Fault && c.stop == Stop.Fault && c.stop_at == c.pc, s"$end ${c.stop}")
    assert(b.refused.starts_with(s"core 0 at pc 0x${hex(c.pc, 8)}: the RCP faults: core 0's rcp_canary_check(90) was given 0x"), b.refused)
    assert(b.refused.ends_with(", not the canary for tag 90"), b.refused)

@test("every function of the SDK's gpio_coproc.h is the SIO write or read the header says it is equivalent to, on a Pico 2")
arm_gpioc_program()
    val b = arm_board(PICO2_ARM_SRAM)
    b.boot(ARM_GPIOC).unwrap()
    var end = RunEnd.Budget
    while end == RunEnd.Budget && b.chip.now < 200 * MS do end = b.run(MS)
    val text = from_utf8_lossy(b.console.view())
    assert(end == RunEnd.Breakpoint, s"$end: ${b.refused} $text")
    val want = s"gpioc: 87 checks, 0 mismatches; out ${hex(b.chip.sio.out, 16)} oe ${hex(b.chip.sio.oe, 16)}\r\n"
    assert(text == want, text)

@test("pico2 is an Arm RP2350 board with the chip's SRAM; pico2-riscv and the Cortex-M boards are not; the Pico 2 W's radio is refused by name")
arm_plans()
    val m = arm_named("pico2").unwrap().unwrap()
    assert(m.base == 0x20000000 && m.size == 520 * 1024)
    assert(arm_named("pico2-riscv").is_none() && arm_named("virt").is_none() && riscv_named("pico2").is_none())
    val text = "board { name = b, mcu = rp2350 }"
    val got = load(source_of("b.hocon", text), library())
    assert(!got.report.has_errors(), got.report.render(source_of("b.hocon", text)))
    assert(arm_plan(got.description.board).is_ok())
    val w = arm_named("pico2w").unwrap()
    assert(w.unwrap_err().contains("`wifi` is a cyw43439"), w.unwrap_err())
