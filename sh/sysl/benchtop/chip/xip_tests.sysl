module sh.sysl.benchtop.chip
@tests

import sh.sysl.benchtop.peripheral.rp2350.{XIP_BASE, XIP_SRAM_BASE}
import sh.sysl.benchtop.v6m as arm
import sh.sysl.benchtop.v6m.Stop
import sh.sysl.rp2350.qmi as qmi_reg
import sh.sysl.rp2350.xip_ctrl as xip_ctrl_reg
import sysl.buf.{Buf, buf}
import sysl.fmt.hex
import sysl.text.from_utf8_lossy

// The Arm Pico 2 with its flash and XIP cache: the SDK's programs built as flash images, as a UF2 and
// as an XIP-cache-only image (examples/pico2), and each edge of the board's XIP memory map.

private val HELLO_FLASH = embed("../../../../examples/pico2/hello_serial_flash.elf")
private val HELLO_FLASH_UF2 = embed("../../../../examples/pico2/hello_serial_flash.uf2")
private val BLINK_FLASH = embed("../../../../examples/pico2/blink_flash.elf")
private val QMI_FLASH = embed("../../../../examples/pico2/qmi_flash.elf")
private val XIP_SRAM_ELF = embed("../../../../examples/pico2/xip_sram.elf")
private val PLAIN_BLINK = embed("../../../../examples/pico2/blink.elf")
private val XIP_LOOP = embed("../../../../examples/pico2/xip_loop.elf")
private val SRAM_LOOP = embed("../../../../examples/pico2/sram_loop.elf")

private val PICO2_SRAM = SramMap(0x20000000, 520 * 1024)
private const MS_150: u64 = 150000

// Run `b` for `ms` of guest time in 0.1 ms steps, every step to its budget, and answer UART0's text.
// A program that returns from `main` ends at crt0's breakpoint, which ends the run early.
private console_after(b: &ArmBoard, ms: u64) -> string
    while b.chip.now < ms * MS_150
        val end = b.run(MS_150 / 10)
        if end == RunEnd.Breakpoint then break
        assert(end == RunEnd.Budget, s"${b.refused}; core 0 stopped ${b.cores[0].stop} at 0x${hex(b.cores[0].stop_at, 8)}, pc 0x${hex(b.cores[0].pc, 8)}")
    from_utf8_lossy(b.console.view())

@test("hello_serial built for flash runs in place from XIP: its segments written into flash, .data copied out by crt0")
xip_hello_serial_flash()
    val b = arm_board(PICO2_SRAM)
    b.boot(HELLO_FLASH).unwrap()
    assert(b.cores[0].pc >= XIP_BASE && b.cores[0].pc < XIP_BASE + FLASH_BYTES, "entered in flash")
    assert(b.mem.flash[0] != 0xFF && b.mem.flash[FLASH_BYTES - 1] == 0xFF, "the image at the flash's start, the rest erased")
    val text = console_after(b, 250)
    assert(text == "hello, serial 0\r\nhello, serial 1\r\nhello, serial 2\r\n", text)

@test("blink built for flash toggles GPIO 25 every 250 ms of guest time from XIP")
xip_blink_flash()
    val b = arm_board(PICO2_SRAM)
    b.boot(BLINK_FLASH).unwrap()
    var edges = 0
    var level = false
    while b.chip.now < 600 * MS_150
        assert(b.run(MS_150 / 10) == RunEnd.Budget, b.refused)
        val led = b.chip.pin(25)
        if led.drives && led.level != level
            edges += 1
            level = led.level
    assert(edges == 3, s"$edges edges")

@test("hello_serial's UF2 is written into flash block by block and boots as the boot ROM hands a flash image over")
xip_hello_serial_uf2()
    val b = arm_board(PICO2_SRAM)
    b.boot(HELLO_FLASH_UF2).unwrap()
    val c = &b.cores[0]
    assert(c.vtor == XIP_BASE && c.r[13] == 0x20082000 && c.pc >= XIP_BASE, s"vtor 0x${hex(c.vtor)} sp 0x${hex(c.r[13])}")
    assert(b.chip.rcp.salted[0] && b.chip.rcp.salted[1], "the boot ROM set the RCP's salts")
    val text = console_after(b, 150)
    assert(text == "hello, serial 0\r\nhello, serial 1\r\n", text)

@test("an image linked into the XIP cache runs there whole, its lines pinned by the loader: code, data and stack at 0x13ffc000")
xip_sram_program()
    val b = arm_board(PICO2_SRAM)
    b.boot(XIP_SRAM_ELF).unwrap()
    for p in 0u32..<4 do assert(b.mem.page_table[(XIP_SRAM_BASE >> 12) + p] != 0, s"page $p on the fast path")
    val text = console_after(b, 560)
    assert(text.starts_with("xip_sram begins: main at 13ffc") && text.contains(", stack at 13fff"), text)
    assert(text.ends_with("running... 0\r\nrunning... 1\r\nrunning... 2\r\nrunning... 3\r\nrunning... 4\r\nPASSED\r\n"), text)

@test("a flash program reprograms its own flash through QMI direct mode and reads it back through every XIP window")
xip_qmi_flash_program()
    val b = arm_board(PICO2_SRAM)
    b.boot(QMI_FLASH).unwrap()
    val text = console_after(b, 20)
    assert(text.starts_with("qmi_flash begins: xip_ctrl 00000083\r\njedec ef 40 16\r\nuid e6605838832b4a2e\r\n"), text)
    for line in ["direct read ok", "cached ok", "uncached ok", "untranslated ok", "erased ok", "stream ok, ctr 0", "pinned ok", "PASSED"]
        assert(text.contains(s"$line\r\n"), s"$line: $text")
    for i in 0u32..<256 do assert(b.mem.flash[(1 << 20) + i] == u8.wrap(i * 7 + 3), s"flash byte $i")
    assert(b.mem.flash[(1 << 20) + 256] == 0xFF && b.mem.flash[(1 << 20) - 1] == 0xFF, "the sector's rest erased, the byte below untouched")
    assert(!b.direct && b.mem.page_table[XIP_BASE >> 12] != 0, "direct mode left, the flash back on the fast path")

// Thumb halfwords into SRAM at `at`, and core 0 started there with `regs` in r0 to r5.
private run_code(b: &ArmBoard, code: []const u16, regs: [6]u32) -> RunEnd
    val at: u32 = 0x20070000
    val c = &b.cores[0]
    // Stored as a device stores, so code decoded there before decodes again.
    for i in 0..<code.len do assert(arm.device_store(c, at + 2 * u32(i), 2, u32(code[i])))
    c.stop = Stop.Running
    c.pc = at
    for i in 0..<6 do c.r[i] = regs[i]
    b.why = ""
    b.refused = ""
    b.run(10000)

// Thumb: strb r1, [r0]; str r1, [r0]; str r2, [r3]; ldr r4, [r3]; ldr r5, [r3, #8]; bkpt.
private const STRB_R1_R0: u16 = 0x7001
private const STR_R1_R0: u16 = 0x6001
private const STR_R2_R3: u16 = 0x601A
private const LDR_R4_R3: u16 = 0x681C
private const LDR_R5_R3_8: u16 = 0x689D
private const BKPT: u16 = 0xBE00
private const MAINTENANCE: u32 = 0x18000000
private const SRAM_OFFSET: u32 = 0x03FFC000

@test("XIP_SRAM: an unpinned line is a named bus error; a core's pin through the maintenance window makes one line hold its bytes, off the fast path")
xip_sram_lines()
    val b = arm_board(PICO2_SRAM)
    b.boot(PLAIN_BLINK).unwrap()
    for p in 0u32..<4 do assert(b.mem.page_table[(XIP_SRAM_BASE >> 12) + p] == 0, "nothing pinned, nothing mapped")
    assert(run_code(b, [LDR_R4_R3, BKPT], [0, 0, 0, XIP_SRAM_BASE, 0, 0]) == RunEnd.Fault)
    assert(b.refused.contains("0x13ffc000 is in XIP_SRAM, and no cache line is pinned"), b.refused)
    // Pin the first line (operation 7) and the last, then store and load through them.
    val last = XIP_SRAM_BASE + 16384 - 8
    assert(run_code(b, [STRB_R1_R0, STR_R2_R3, LDR_R4_R3, BKPT], [MAINTENANCE + SRAM_OFFSET + 7, 0, 0xCAFEF00D, XIP_SRAM_BASE, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(b.cores[0].r[4] == 0xCAFEF00D && b.mem.ram[b.sram_at] == 0x0D && b.mem.ram[b.sram_at + 3] == 0xCA)
    assert(run_code(b, [STRB_R1_R0, STR_R2_R3, LDR_R4_R3, BKPT], [MAINTENANCE + SRAM_OFFSET + 16384 - 8 + 7, 0, 0x5A5A1234, last + 4, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(b.cores[0].r[4] == 0x5A5A1234 && b.mem.ram[b.sram_at + 16383] == 0x5A, "the last word of XIP_SRAM")
    // The line after the first is not pinned.
    assert(run_code(b, [LDR_R5_R3_8, BKPT], [0, 0, 0, XIP_SRAM_BASE, 0, 0]) == RunEnd.Fault)
    assert(b.refused.contains("0x13ffc008"), b.refused)
    for p in 0u32..<4 do assert(b.mem.page_table[(XIP_SRAM_BASE >> 12) + p] == 0, "a page with one line pinned stays off the fast path")
    // Invalidating the first line by address (operation 2) unpins it.
    assert(run_code(b, [STRB_R1_R0, LDR_R4_R3, BKPT], [MAINTENANCE + SRAM_OFFSET + 2, 0, 0, XIP_SRAM_BASE, 0, 0]) == RunEnd.Fault)
    assert(b.refused.contains("0x13ffc000"), b.refused)
    // A pin over flash and a read of the maintenance window are refused by name.
    assert(run_code(b, [STRB_R1_R0, BKPT], [MAINTENANCE + 7, 0, 0, 0, 0, 0]) == RunEnd.Fault)
    assert(b.refused.contains("pinning a cache line over flash"), b.refused)
    assert(run_code(b, [LDR_R4_R3, BKPT], [0, 0, 0, MAINTENANCE, 0, 0]) == RunEnd.Fault)
    assert(b.refused.contains("takes writes only"), b.refused)

@test("XIP_SRAM: a page whose every line is pinned joins the fast path, and leaves it when the cache is disabled")
xip_sram_pages()
    val b = arm_board(PICO2_SRAM)
    b.boot(PLAIN_BLINK).unwrap()
    for k in 0u32..<512 do b.chip.xip.maintain(SRAM_OFFSET + 4096 + k * 8 + 7).unwrap()
    b.sync_xip()
    assert(b.mem.page_table[(XIP_SRAM_BASE >> 12) + 1] != 0 && b.mem.page_table[XIP_SRAM_BASE >> 12] == 0)
    assert(run_code(b, [STR_R2_R3, LDR_R4_R3, BKPT], [0, 0, 77, XIP_SRAM_BASE + 4096 + 4092, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(b.cores[0].r[4] == 77, s"r4 = ${b.cores[0].r[4]}")
    // XIP_CTRL's CLR alias takes EN_SECURE away: the page leaves the fast path and the access is refused.
    assert(run_code(b, [STR_R1_R0, LDR_R4_R3, BKPT], [xip_ctrl_reg.BASE + 0x3000, xip_ctrl_reg.CTRL_EN_SECURE_MASK, 0, XIP_SRAM_BASE + 4096, 0, 0]) == RunEnd.Fault)
    assert(b.mem.page_table[(XIP_SRAM_BASE >> 12) + 1] == 0 && b.refused.contains("0x13ffd000"), b.refused)

@test("direct mode takes the flash off the cores' fast path, where a load from XIP is refused by name, and puts it back when it ends")
xip_direct_mode_map()
    val b = arm_board(PICO2_SRAM)
    b.boot(PLAIN_BLINK).unwrap()
    val csr = qmi_reg.BASE + qmi_reg.DIRECT_CSR_OFFSET
    assert(run_code(b, [LDR_R4_R3, BKPT], [0, 0, 0, XIP_BASE, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(b.cores[0].r[4] == 0xFFFFFFFF, s"erased flash, r4 = 0x${hex(b.cores[0].r[4], 8)}")
    assert(run_code(b, [STR_R1_R0, LDR_R4_R3, BKPT], [csr, qmi_reg.DIRECT_CSR_EN_MASK, 0, XIP_BASE + FLASH_BYTES - 4, 0, 0]) == RunEnd.Fault)
    assert(b.direct && b.mem.page_table[XIP_BASE >> 12] == 0 && b.mem.page_table[((XIP_BASE + FLASH_BYTES) >> 12) - 1] == 0)
    assert(b.refused.contains("0x103ffffc: a memory-mapped flash access while the QMI is in direct mode"), b.refused)
    assert(run_code(b, [STR_R1_R0, LDR_R4_R3, BKPT], [csr, 0, 0, XIP_BASE, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(!b.direct && b.mem.page_table[XIP_BASE >> 12] == usize(&b.mem.flash[0]))

@test("the XIP windows off the fast path: past the first 4 MB the flash wraps, the uncached and untranslated windows read it, chip select 1 and flash writes with WRITABLE_M0 are refused")
xip_windows_on_the_board()
    val b = arm_board(PICO2_SRAM)
    b.boot(HELLO_FLASH).unwrap()
    val first = b.chip.read(0, XIP_BASE, 4).unwrap()
    assert(first != 0xFFFFFFFF)
    for a in [XIP_BASE + FLASH_BYTES, 0x14000000u32, 0x14000000 + FLASH_BYTES, 0x1C000000, XIP_BASE + 0x00C00000]
        assert(b.chip.read(0, a, 4).unwrap() == first, s"0x${hex(a, 8)}")
    assert(b.chip.read(0, XIP_BASE + FLASH_BYTES - 1, 1).unwrap() == 0xFF)
    assert(b.chip.read(0, 0x11000000, 4).unwrap_err().contains("chip select 1"))
    assert(b.chip.read(0, 0x15000000, 4).unwrap_err().contains("chip select 1"))
    assert(b.chip.read(0, 0x12000000, 4).unwrap_err().contains("past the QMI's two 16 MB windows"))
    // A store through an XIP window is downgraded to a read while WRITABLE_M0 is clear.
    assert(run_code(b, [STR_R2_R3, LDR_R4_R3, BKPT], [0, 0, 0x12345678, 0x14000000, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(b.cores[0].r[4] == first, "the flash is unchanged")
    b.chip.write(0, xip_ctrl_reg.BASE + 0x2000, 4, xip_ctrl_reg.CTRL_WRITABLE_M0_MASK).unwrap()
    assert(run_code(b, [STR_R2_R3, BKPT], [0, 0, 1, 0x14000000, 0, 0]) == RunEnd.Fault)
    assert(b.refused.contains("WRITABLE_M0 set"), b.refused)
    // The first 4 MB of the cached window is the cores' read-only flash.
    assert(run_code(b, [STR_R2_R3, BKPT], [0, 0, 1, XIP_BASE + 0x100, 0, 0]) == RunEnd.Fault && b.cores[0].stop == Stop.Fault)

@test("XIP_CTRL, the QMI and XIP_AUX on the chip's bus: their refusals named with the block and offset, the same flash for either core, and a chip with no flash connected")
xip_blocks_on_the_chip()
    val b = arm_board(PICO2_SRAM)
    b.boot(HELLO_FLASH).unwrap()
    assert(b.chip.read(0, xip_ctrl_reg.BASE, 4).unwrap() == 0x83 && b.chip.read(1, xip_ctrl_reg.BASE, 4).unwrap() == 0x83)
    assert(b.chip.read(0, xip_ctrl_reg.BASE + 0xC, 4).unwrap_err() == "XIP_CTRL + 0xc: the cache's hit and access counters are not counted: benchtop does not simulate the cache's lookups")
    assert(b.chip.read(0, qmi_reg.BASE + 0x54, 4).unwrap_err() == "QMI + 0x54 is not a register benchtop runs")
    assert(b.chip.read(0, 0x50500000 + 0x1000, 4).unwrap_err() == "XIP_AUX + 0x1000 is not a register benchtop runs")
    assert(b.chip.read(0, qmi_reg.BASE + 0x8, 4).unwrap_err().starts_with("QMI + 0x8: DIRECT_RX is empty"))
    assert(b.chip.read(1, 0x14000000, 4).unwrap() == b.chip.read(0, XIP_BASE, 4).unwrap(), "core 1 reads the same flash")
    var bare = rp2350()
    bare.write(0, qmi_reg.BASE, 4, qmi_reg.DIRECT_CSR_EN_MASK | qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK).unwrap()
    assert(bare.write(0, qmi_reg.BASE + 4, 4, 0x9F).unwrap_err().contains("connects no flash"))
    assert(bare.take_xip_changed() && !bare.take_xip_changed(), "a write to the QMI marks the chip's XIP state changed, once")

// Direct mode, from the chip's side: `bytes` as one frame on chip select 0.
private flash_frame(b: &ArmBoard, bytes: []const u32)
    val csr = qmi_reg.BASE + qmi_reg.DIRECT_CSR_OFFSET
    b.chip.write(0, csr, 4, qmi_reg.DIRECT_CSR_EN_MASK | qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK).unwrap()
    for x in bytes do b.chip.write(0, qmi_reg.BASE + qmi_reg.DIRECT_TX_OFFSET, 4, x | qmi_reg.DIRECT_TX_NOPUSH_MASK).unwrap()
    b.chip.write(0, csr, 4, 0).unwrap()

@test("erasing the flash under a running program makes the code decoded from it decode again: the program stops on the erased words")
xip_erase_running_code()
    val b = arm_board(PICO2_SRAM)
    b.boot(BLINK_FLASH).unwrap()
    while b.chip.now < 10 * MS_150 do assert(b.run(MS_150 / 10) == RunEnd.Budget, b.refused)
    flash_frame(b, [0x06])
    flash_frame(b, [0xC7])
    assert(b.chip.take_xip_changed())
    b.sync_xip()
    assert(b.mem.flash[0] == 0xFF && b.mem.flash[FLASH_BYTES - 1] == 0xFF)
    var end = RunEnd.Budget
    while end == RunEnd.Budget && b.chip.now < 400 * MS_150 do end = b.run(MS_150 / 10)
    assert(end == RunEnd.Fault, "the next instruction fetched from flash is an erased one")
// One UF2 block: `payload` at `target`, with `flags` and `family`.
private uf2_block(into: *Buf[u8], target: u32, payload: []const u8, flags: u32, family: u32)
    val words: [8]u32 = [0x0A324655, 0x9E5D5157, flags, target, u32(payload.len), 0, 1, family]
    for w in words do for k in 0u32..<4 do into.push(u8.wrap(w >> (8 * k)))
    for i in 0..<476 do into.push(if i < payload.len then payload[i] else 0)
    for k in 0u32..<4 do into.push(u8.wrap(0x0AB16F30u32 >> (8 * k)))

@test("a RAM UF2 starts at its first byte, an XIP_SRAM one is pinned first; a block not for main memory is skipped")
xip_uf2_ram_images()
    // movs r0, #5; bkpt
    val code: [4]u8 = [0x05, 0x20, 0x00, 0xBE]
    var ram: Buf[u8] = buf()
    uf2_block(&ram, 0x30000000, code, 0x1, 0)
    uf2_block(&ram, 0x20000000, code, 0x2000, 0xE48BFF59)
    val b = arm_board(PICO2_SRAM)
    b.boot(ram.view()).unwrap()
    assert(b.cores[0].pc == 0x20000000 && b.cores[0].r[13] == 0x20082000 && !b.chip.rcp.salted[0])
    assert(b.run(1000) == RunEnd.Breakpoint && b.cores[0].r[0] == 5)
    var sram: Buf[u8] = buf()
    uf2_block(&sram, XIP_SRAM_BASE, code, 0x2000, 0xE48BFF57)
    val s = arm_board(PICO2_SRAM)
    s.boot(sram.view()).unwrap()
    assert(s.mem.page_table[XIP_SRAM_BASE >> 12] != 0 && s.run(1000) == RunEnd.Breakpoint && s.cores[0].r[0] == 5)

@test("a UF2 is refused by name: a partial block, a wrong magic, no family, another family, an address off the memory, a block past SRAM's end, a flash image not at XIP_BASE, no main-memory block")
xip_uf2_refusals()
    val code: [4]u8 = [0x05, 0x20, 0x00, 0xBE]
    val b = arm_board(PICO2_SRAM)
    var good: Buf[u8] = buf()
    uf2_block(&good, 0x20000000, code, 0x2000, 0xE48BFF59)
    var short: Buf[u8] = buf()
    for i in 0..<511 do short.push(good[i])
    for i in 0..<9 do short.push(0)
    assert(b.boot(short.view()).unwrap_err().contains("whole 512-byte blocks"))
    var magic: Buf[u8] = buf()
    for i in 0..<512 do magic.push(good[i])
    magic.set(508, 0)
    assert(b.boot(magic.view()).unwrap_err().contains("magic"))
    val cases: [6](u32, u32, u32, string) = [
        (0x20000000, 0, 0, "names no family"),
        (0x20000000, 0x2000, 0xE48BFF5A, "family 0xe48bff5a"),
        (0x30000000, 0x2000, 0xE48BFF59, "0x30000000, which is not in"),
        (0x20081FFE, 0x2000, 0xE48BFF59, "0x20081ffe, which is not in"),
        (0x10001000, 0x2000, 0xE48BFF59, "partition search"),
        (0x20000000, 0x1, 0xE48BFF59, "no block for the main memory"),
    ]
    for c in cases
        var image: Buf[u8] = buf()
        uf2_block(&image, c.0, code, c.1, c.2)
        val got = b.boot(image.view())
        assert(got.is_err() && got.unwrap_err().contains(c.3), c.3)
    var big: Buf[u8] = buf()
    uf2_block(&big, 0x20000000, code, 0x2000, 0xE48BFF59)
    big.set(16, 0xDD)
    big.set(17, 0x01)
    assert(b.boot(big.view()).unwrap_err().contains("477 bytes"))

@test("a flash image's .bss, linked to load in flash and run in SRAM, writes nothing into the flash: the block-end marker after it survives")
xip_flash_bss_writes_nothing()
    val b = arm_board(PICO2_SRAM)
    b.boot(HELLO_FLASH).unwrap()
    // hello_serial_flash's .flash_end (20 bytes at 0x10003d24, from file offset 0x5d24), then the
    // .bss whose load address is the same and whose 0x210 bytes are zero only in SRAM.
    for i in 0..<20 do assert(b.mem.flash[0x3d24 + i] == HELLO_FLASH[0x5d24 + i], s"marker byte $i")
    assert(b.mem.flash[0x3d24] == 0xD3 && b.mem.flash[0x3d24 + 19] == 0xAB)
    for i in 20..<0x210 do assert(b.mem.flash[0x3d24 + i] == 0xFF, s"byte $i after the marker is erased flash")

@test("a busy loop in XIP_SRAM runs on the cores' fast path, to the checksum the same loop gives from SRAM")
xip_sram_loop()
    var sums: Buf[string] = buf()
    for k in 0..<2
        val b = arm_board(PICO2_SRAM)
        b.boot(if k == 0 then XIP_LOOP else SRAM_LOOP).unwrap()
        if k == 0 then for p in 0u32..<4 do assert(b.mem.page_table[(XIP_SRAM_BASE >> 12) + p] != 0, s"page $p on the fast path")
        val text = console_after(b, 10000)
        assert(text.ends_with("PASSED\r\n"), text)
        sums.push(text[text.index_of("checksum").unwrap()..])
    assert(sums.at(0) == "checksum d0a54a76\r\nPASSED\r\n" && sums.at(1) == sums.at(0), s"${sums.at(0)} ${sums.at(1)}")

@test("XIP_SRAM's fast path: both ends of the window, nothing either side of it, a page leaving when one line is unpinned and returning when it is pinned again")
xip_sram_fast_path_edges()
    val b = arm_board(PICO2_SRAM)
    b.boot(PLAIN_BLINK).unwrap()
    for k in 0u32..<(16384 / 8) do b.chip.xip.maintain(SRAM_OFFSET + k * 8 + 7).unwrap()
    b.sync_xip()
    val last = XIP_SRAM_BASE + 16384 - 4
    for a in [XIP_SRAM_BASE, XIP_SRAM_BASE + 4092, XIP_SRAM_BASE + 4096, last]
        assert(fast(b, a, 4), s"0x${hex(a, 8)} on the fast path")
    assert(fast(b, last + 3, 1), "the last byte")
    for a in [XIP_SRAM_BASE - 4, XIP_SRAM_BASE + 16384, last + 2]
        assert(!fast(b, a, 4), s"0x${hex(a, 8)} off it")
    // A store and a load at each end, through the cores' own path, land in the backing.
    assert(run_code(b, [STR_R2_R3, LDR_R4_R3, BKPT], [0, 0, 0x11223344, XIP_SRAM_BASE, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(b.cores[0].r[4] == 0x11223344 && b.mem.ram[b.sram_at] == 0x44)
    assert(run_code(b, [STR_R2_R3, LDR_R4_R3, BKPT], [0, 0, 0x55667788, last, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(b.cores[0].r[4] == 0x55667788 && b.mem.ram[b.sram_at + 16383] == 0x55)
    // Invalidating the last line by address (operation 2) unpins it: its page leaves the fast path
    // at once, the load is refused by name, and the other pages stay.
    assert(run_code(b, [STRB_R1_R0, LDR_R4_R3, BKPT], [MAINTENANCE + SRAM_OFFSET + 16384 - 8 + 2, 0, 0, last, 0, 0]) == RunEnd.Fault)
    assert(b.refused.contains("0x13fffffc is in XIP_SRAM, and no cache line is pinned"), b.refused)
    assert(!fast(b, last, 4) && fast(b, XIP_SRAM_BASE + 8192, 4))
    // A line of that page still pinned is reached off the fast path, and its store lands in the backing.
    assert(run_code(b, [STR_R2_R3, LDR_R4_R3, BKPT], [0, 0, 0x0BADCAFE, last - 8, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(b.cores[0].r[4] == 0x0BADCAFE && b.mem.ram[b.sram_at + 16372] == 0xFE)
    // Pinning it again puts the page back.
    assert(run_code(b, [STRB_R1_R0, BKPT], [MAINTENANCE + SRAM_OFFSET + 16384 - 8 + 7, 0, 0, 0, 0, 0]) == RunEnd.Breakpoint, b.refused)
    assert(fast(b, last, 4), "pinned again, on the fast path")

// Whether core 0 reaches the `width` bytes at `a` on its fast path, its loads and its stores alike.
private fast(b: &ArmBoard, a: u32, width: u32) -> bool
    val load = arm.page_for(&b.cores[0], a, width) != 0
    assert(load == (arm.store_page(&b.cores[0], a, width) != 0), s"0x${hex(a, 8)}: loads and stores agree")
    load

@test("an ELF segment outside the SRAM, the flash and XIP_SRAM is refused by name")
xip_elf_outside()
    var image: Buf[u8] = buf()
    for x in HELLO_FLASH do image.push(x)
    // The first program header's p_paddr, moved off every region.
    val phoff = usize(image[28]) | (usize(image[29]) << 8) | (usize(image[30]) << 16) | (usize(image[31]) << 24)
    val phentsize = usize(image[42]) | (usize(image[43]) << 8)
    for k in 0..<8
        val at = phoff + k * phentsize
        // PT_LOAD, whose low byte ARM_EXIDX (0x70000001) shares.
        if image[at] == 1 && image[at + 3] == 0
            image.set(at + 12, 0)
            image.set(at + 13, 0)
            image.set(at + 14, 0)
            image.set(at + 15, 0x30)
            break
    val b = arm_board(PICO2_SRAM)
    assert(b.boot(image.view()).unwrap_err().contains("every segment must be in the SRAM, the flash or XIP_SRAM"))
