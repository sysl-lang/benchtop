module sh.sysl.benchtop.chip

// The parts of an RP2040 or RP2350 board on its chip's pins: buttons and switches that drive a GPIO
// from off the chip, leaving it to the pad's pulls when open; potentiometers and joysticks that put a
// level on an ADC input; seven-segment displays and HD44780s that watch the GPIOs they are wired to;
// buzzers that sound the PWM's waveform or a pin's level; LEDs that show a pin; a CYW43439 that hears
// its gSPI terminals and answers on its data line.
//
// `PartPins` is the one seam between them and the chip: a part model never reaches past it, so every
// part runs on both chips and on every board built on them (`ArmBoard`, `RiscvBoard`). The models are
// the workbench's own (`virt.Displays`, `virt.pot_voltage`, `audio.Synth`, `virt.PartInput`), shown the
// chip's pins instead of the workbench's GPIO panel.

import sh.sysl.benchtop.{Board, Part, Target, article_of, part_model, part_text, part_whole}
import sh.sysl.benchtop.audio as audio
import sh.sysl.benchtop.parts.cyw43 as cyw43
import sh.sysl.benchtop.parts.ds3231 as rtc
import sh.sysl.benchtop.parts.hd44780.Lcd
import sh.sysl.benchtop.parts.ssd1306 as oled
import sh.sysl.benchtop.peripheral.i2c.Device
import sh.sysl.benchtop.peripheral.rp2040.{Pwm, pwm_slice_of}
import sh.sysl.benchtop.peripheral.rp2350 as rp
import sh.sysl.benchtop.peripheral.rp2350.{I2cPart, Pin}
import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.virt.PartInput
import sysl.buf.{Buf, buf}

/** A change in what the GPIOs a `PinWatch` watches show: from clk_sys cycle `cycle` on, the level of
 * each (bit n for GPIO n) and whether the chip drives it.
 */
struct PinChange
    cycle: u64
    levels: u64
    driven: u64

/** A part that hears the GPIOs of `mask` (bit n for GPIO n) as they change rather than when the parts
 * next look: an SPI panel, whose every byte is sixteen edges of a clock at megahertz. `heard` is told
 * their levels and the ones the chip drives each time something that decides one may have changed,
 * and at each edge an SPI controller makes.
 */
struct PinHook
    mask: u64
    heard: &Fn(u64, u64) -> unit

/** A part that drives a GPIO back as it hears the GPIOs of `mask` change: a gSPI device, which turns its
 * data line at a clock edge a PIO block makes and which the block reads at the next. `heard` is told
 * their levels where a hook is, and answers how the part drives GPIO `pin` from then on: at a level, or
 * not at all. The chip takes the answer as of the cycle the levels were heard, before anything runs
 * on, so a PIO block reads it on the next cycle of its own.
 */
struct PinAnswer
    mask: u64
    pin: u32
    heard: &Fn(u64) -> Option[bool]

/** What a board's parts watch of the chip's GPIOs (`part_watch`): which, what they last showed, and
 * each change since the parts last looked; the parts that hear them as they change (`part_hook`) and
 * those that answer on a GPIO (`part_answer`), and whether an answer has moved a GPIO the chip has not
 * yet taken in; and whether anything watches or hears at all, which is the one test the chip makes for
 * them. It is the board's, as the wires are: a reset of the chip keeps it.
 */
struct PinWatch
    mask: u64
    levels: u64
    driven: u64
    changes: Buf[PinChange]
    hooks: Buf[PinHook]
    answers: Buf[PinAnswer]
    watching: bool
    hooked: bool
    answered: bool

/** Watching no GPIO. */
pin_watch() -> PinWatch = PinWatch(0, 0, 0, buf(), buf(), buf(), false, false, false)

/** Watching the GPIOs of `mask`, hearing and answering nothing. */
private watching(mask: u64) -> PinWatch = PinWatch(mask, 0, 0, buf(), buf(), buf(), mask != 0, false, false)

// Drive GPIO `n` from off the chip as `answer` says, in the chip's `driven` and `level` bits, and say
// whether that changed either.
private take_answer(driven: *u64, level: *u64, n: u32, answer: Option[bool]) -> bool
    val bit = 1u64 << u64(n)
    val (d, l) = answer match
        Some(v) -> (*driven | bit, if v then *level | bit else *level & ~bit)
        None -> (*driven & ~bit, *level)
    if d == *driven && l == *level then return false
    *driven = d
    *level = l
    true

impl PinWatch
    // The watched GPIOs show `levels`, the chip driving `driven`, at `cycle`: a change is kept.
    private[chip] note(*self, cycle: u64, levels: u64, driven: u64)
        if levels == self.levels && driven == self.driven && !self.changes.is_empty() then return
        self.levels = levels
        self.driven = driven
        self.changes.push(PinChange(cycle, levels, driven))

/** The seam between a board's parts and its RP chip (`Rp2350`, `Rp2040`): everything a part does to the
 * chip, or learns from it, goes through these.
 */
trait PartPins
    /** clk_sys cycles since power-on. */
    part_clock(*self) -> u64
    /** clk_sys's rate now, in Hz. */
    part_hz(*self) -> u64
    /** What GPIO `n` is doing: whether its pad drives, its level, and what its input reads. */
    part_pin(*self, n: u32) -> Pin
    /** Drive GPIO `n` from off the chip at `level`, as a closed button does, or let it go with None,
     * leaving it to its pad's pulls.
     */
    part_drive(*self, n: u32, level: Option[bool])
    /** Put `uv` microvolts on GPIO `pin` from off the chip, or nothing; a pin that is not an ADC input hears nothing. */
    part_analog(*self, pin: u32, uv: Option[u32])
    /** Watch the GPIOs of `mask`, bit n for GPIO n, noting what they show now and each change after. */
    part_watch(*self, mask: u64)
    /** The changes on the watched GPIOs since the last call, oldest first. */
    part_changes(*self) -> Buf[PinChange]
    /** The waveform the PWM puts on GPIO `n`, where FUNCSEL gives it a free-running slice: its period and
     * the part of it the pin is high, in sixteenths of a clk_sys cycle. None otherwise.
     */
    part_pwm(*self, n: u32) -> Option[(u64, u64)]
    /** Tell `h` what its GPIOs show now and each time they may have changed from now on. */
    part_hook(*self, h: PinHook)
    /** Let `a` hear its GPIOs now and each time they may have changed from now on, and drive its GPIO as
     * it answers.
     */
    part_answer(*self, a: PinAnswer)
    /** Put the part `p` on the chip's I2C lines, on the GPIOs it names. */
    part_i2c(*self, p: I2cPart)

impl Rp2350
    // What the watched GPIOs show now, kept where it changed; and the hooks hear it.
    private[chip] note_pins(*self) = self.note_pins_at(self.now)

    // The same, as at the end of clk_sys cycle `cycle`: a PIO block's levels as it catches up.
    private[chip] note_pins_at(*self, cycle: u64)
        if self.watch.mask != 0
            val (levels, driven) = shown(self.watch.mask, n -> self.pin(n))
            self.watch.note(cycle, levels, driven)
        if self.watch.hooked then self.tell_hooks()

    // Each hook hears its GPIOs as they stand now, and each answer is taken; the caller settles a GPIO
    // an answer moved (`answered`).
    @noinline
    private[chip] tell_hooks(*self)
        for h in self.watch.hooks
            val (levels, driven) = shown(h.mask, n -> self.pin(n))
            (h.heard)(levels, driven)
        for a in self.watch.answers
            val (levels, _) = shown(a.mask, n -> self.pin(n))
            if take_answer(&self.outside_driven, &self.outside_level, a.pin, (a.heard)(levels)) then self.watch.answered = true

impl Rp2040
    private[chip] note_pins(*self)
        if self.watch.mask != 0
            val (levels, driven) = shown(self.watch.mask, n -> self.pin(n))
            self.watch.note(self.now, levels, driven)
        if self.watch.hooked then self.tell_hooks()

    @noinline
    private[chip] tell_hooks(*self)
        for h in self.watch.hooks
            val (levels, driven) = shown(h.mask, n -> self.pin(n))
            (h.heard)(levels, driven)
        for a in self.watch.answers
            val (levels, _) = shown(a.mask, n -> self.pin(n))
            if take_answer(&self.outside_driven, &self.outside_level, a.pin, (a.heard)(levels)) then self.watch.answered = true

// The levels of `mask`'s GPIOs and the ones the chip drives, bit n for GPIO n, as `pin` gives each.
private shown(mask: u64, pin: (u32) -> Pin) -> (u64, u64)
    var levels: u64 = 0
    var driven: u64 = 0
    var bits = mask
    while bits != 0
        val n = u32(bits.trailing_zeros())
        bits &= bits - 1
        val p = pin(n)
        if p.level then levels |= 1u64 << n
        if p.drives then driven |= 1u64 << n
    (levels, driven)

// A free-running slice's waveform on GPIO `n`, where FUNCSEL routes the PWM to it.
private pwm_on(f: u32, n: u32, pwm: *Pwm) -> Option[(u64, u64)] =
    if rp.route(n, f) != rp.Route.Pwm then None else pwm.wave(pwm_slice_of(n), n & 1 == 1)

impl PartPins for Rp2350
    part_clock(*self) -> u64 = self.now
    part_hz(*self) -> u64 = self.sys_hz()
    part_pin(*self, n: u32) -> Pin = self.pin(n)
    part_drive(*self, n: u32, level: Option[bool]) = self.drive_from_outside(n, level)
    part_analog(*self, pin: u32, uv: Option[u32])
        self.adc.input_of(pin) match
            Some(input) -> self.set_analog(input, uv)
            None -> ()
    part_watch(*self, mask: u64)
        self.watch = watching(mask)
        if mask != 0 then self.note_pins()
    // The PIO blocks catch up first, so what they gave the pins up to now is among the changes.
    part_changes(*self) -> Buf[PinChange]
        if self.pio.running then self.pio_catch_up()
        val all = self.watch.changes
        self.watch.changes = buf()
        all
    part_pwm(*self, n: u32) -> Option[(u64, u64)] = pwm_on(self.io.function(n), n, &self.pwm)
    part_hook(*self, h: PinHook)
        self.watch.hooks.push(h)
        self.watch.watching = true
        self.watch.hooked = true
        self.tell_hooks()
        if self.watch.answered then self.settle_answers()
    part_answer(*self, a: PinAnswer)
        if self.pio.running then self.pio_catch_up()
        self.watch.answers.push(a)
        self.watch.watching = true
        self.watch.hooked = true
        self.tell_hooks()
        if self.watch.answered then self.settle_answers()
    part_i2c(*self, p: I2cPart) = self.attach_i2c(p)

impl PartPins for Rp2040
    part_clock(*self) -> u64 = self.now
    part_hz(*self) -> u64 = self.sys_hz()
    part_pin(*self, n: u32) -> Pin = self.pin(n)
    part_drive(*self, n: u32, level: Option[bool]) = self.drive_from_outside(n, level)
    part_analog(*self, pin: u32, uv: Option[u32])
        self.adc.input_of(pin) match
            Some(input) -> self.set_analog(input, uv)
            None -> ()
    part_watch(*self, mask: u64)
        self.watch = watching(mask)
        if mask != 0 then self.note_pins()
    part_changes(*self) -> Buf[PinChange]
        val all = self.watch.changes
        self.watch.changes = buf()
        all
    part_pwm(*self, n: u32) -> Option[(u64, u64)] = pwm_on(self.io.function(n), n, &self.pwm)
    part_hook(*self, h: PinHook)
        self.watch.hooks.push(h)
        self.watch.watching = true
        self.watch.hooked = true
        self.tell_hooks()
        if self.watch.answered then self.settle_answers()
    part_answer(*self, a: PinAnswer)
        self.watch.answers.push(a)
        self.watch.watching = true
        self.watch.hooked = true
        self.tell_hooks()
        if self.watch.answered then self.settle_answers()
    part_i2c(*self, p: I2cPart) = self.attach_i2c(p)

// ---------------------------------------------------------------------------------------------------
// Which parts run on an RP board.

// The parts that work through a pin or an ADC input, which run on an RP board.
private pin_level(model: string) -> bool = model match
    "led" | "button" | "switch" | "potentiometer" | "joystick" | "buzzer" | "seven-segment" | "hd44780" | "led-matrix-5x5" -> true
    _ -> false

/** Why benchtop cannot run board `b`'s parts on its RP chip, or None where it can. A part whose pins
 * are GPIOs runs; an LED may also be wired to another part's port, which shows nothing until that part
 * runs. An SPI panel or an SSD1306 runs with its terminals on GPIOs (an ST7796's clock and data the SPI
 * bus's), a WS2812 with its DIN on one, and a touch controller or a DS3231 on an I2C bus that routes SDA
 * and SCL; a terminal is the console on UART0. The checker has already held each wire to a pin the board
 * has, and a potentiometer's or a joystick's to an ADC pin.
 */
rp_parts_refusal(b: Board) -> Option[string]
    val chip = b.chip.name
    var clocks = 0
    for p in b.parts
        val model = part_model(p)
        if pin_level(model) || model == "st7789" || model == "st7796" || model == "ssd1306" || model == "ws2812" || model == "cyw43439"
            if model == "led" then continue
            for w in p.wires
                if model == "st7796" && w.port == "spi" then continue
                if virt.connection_pin(w.to) < 0 then return Some(s"`${p.name}.${w.port}` is wired to ${wired_to(w.to)}, and on an $chip board a ${model}'s wires go to the chip's GPIOs")
            continue
        if model == "gt911" || model == "ft6x06"
            for w in p.wires
                if w.port != "i2c" then return Some(s"`${p.name}.${w.port}` is wired, and benchtop's ${model} is polled over I2C: its INT and RESET are left unwired")
            continue
        if model == "ds3231"
            if clocks > 0 then return Some("two DS3231 parts share the fixed I2C address 0x68")
            clocks += 1
            continue
        if model == "terminal"
            for w in p.wires
                val on_uart0 = w.to match
                    Bus(name) -> name == "uart0"
                    _ -> false
                if !on_uart0 then return Some(s"`${p.name}` is a terminal on ${wired_to(w.to)}, and an $chip board's console is UART0")
            continue
        return Some(s"benchtop does not emulate the parts on an $chip board yet, and `${p.name}` is ${article_of(p.kind)} ${p.kind}")
    virt.bus_part_refusal(b, true)

private wired_to(t: Target) -> string = t match
    Pin(n) -> n
    Bus(n) -> s"the bus `$n`"
    Port(part, port) -> s"`$part.$port`"

// ---------------------------------------------------------------------------------------------------
// The parts on the chip.

/** A buzzer on the chip's pins, sounding through benchtop's synthesiser as the workbench's do
 * (`virt/sound.sysl`): the PWM's waveform where a free-running slice drives its pin, otherwise the
 * pin's level, or an active buzzer's own tone while the pin is high. Its clock is sixteenths of a
 * clk_sys cycle (`hz` of them a second), the PWM divider's unit; a new clk_sys rate starts it again.
 */
struct RpBuzzer
    name: string
    pin: u32
    active: bool
    tone: u64
    gain: real
    synth: &audio.Synth
    hz: u64
    level: bool
    driven: bool

/** A touch controller of an RP board and the GPIOs its bus's SDA and SCL are on. */
struct RpTouch
    model: &virt.Touchscreen
    sda: u32
    scl: u32

/** A DS3231 of an RP board: the machine's model (`virt.rtc_model`), counting nanoseconds, so a new
 * clk_sys rate does not change how fast it keeps time; the GPIOs its bus's SDA and SCL are on; and the
 * clk_sys cycle its count was last brought up to, the nanoseconds that came to and the rate since. A
 * chip's reset starts its cycles again from 0; the clock, on its own battery, runs on.
 */
struct RpRtc
    name: string
    model: rtc.Rtc
    sda: u32
    scl: u32
    cycle: u64
    ns: u64
    hz: u64

impl RpRtc
    /** The nanoseconds clk_sys cycle `cycle` comes to. */
    at(*self, cycle: u64) -> u64 = self.ns + (if cycle > self.cycle then virt.nanos(cycle - self.cycle, self.hz) else 0)

    /** The count brought up to cycle `cycle`, from which clk_sys runs at `hz`. */
    rate(*self, cycle: u64, hz: u64)
        self.ns = self.at(cycle)
        self.cycle = cycle
        self.hz = hz

/** A CYW43439 of an RP board, on the GPIOs its terminals are wired to (`parts/cyw43`). */
struct RpRadio
    name: string
    chip: &cyw43.Cyw43

/** The parts of an RP board on its chip: each part's control as the window or a script sets it (as the
 * workbench's session keeps them), the displays its GPIOs drive, its buzzers, its SPI panels and OLEDs,
 * its I2C touch controllers, its real-time clocks and its radios.
 */
struct RpParts
    parts: Buf[Part]
    inputs: Buf[PartInput]
    displays: virt.Displays
    buzzers: Buf[RpBuzzer]
    panels: Buf[&virt.Panel]
    oleds: Buf[&virt.Oled]
    touches: Buf[RpTouch]
    rtcs: Buf[&RpRtc]
    radios: Buf[RpRadio]

/** The parts of `b`, which `rp_parts_refusal` has passed, every control at rest, on no chip yet. A
 * DS3231 whose `initial-time` is the host's, where the host's time cannot be read, starts from its
 * `initial-*` date as a fixed one does.
 */
rp_parts(b: Board) -> RpParts
    var inputs: Buf[PartInput] = buf()
    var buzzers: Buf[RpBuzzer] = buf()
    var panels: Buf[&virt.Panel] = buf()
    var oleds: Buf[&virt.Oled] = buf()
    var touches: Buf[RpTouch] = buf()
    var rtcs: Buf[&RpRtc] = buf()
    var radios: Buf[RpRadio] = buf()
    for p in b.parts
        inputs.push(virt.resting(p))
        if part_model(p) == "cyw43439"
            val w = cyw43.Wiring(radio_pin(p, "wl-on"), radio_pin(p, "data"), radio_pin(p, "cs"), radio_pin(p, "clock"))
            radios.push(RpRadio(p.name, cyw43.cyw43(w)))
        virt.panel_of(b, p) match
            Some(panel) -> panels.push(panel)
            None -> ()
        virt.oled_of(p) match
            Some(o) -> oleds.push(o)
            None -> ()
        virt.touchscreen_of(p) match
            Some(t) -> touches.push(RpTouch(t, u32(virt.bus_signal_pin(b, p, "i2c", "sda")), u32(virt.bus_signal_pin(b, p, "i2c", "scl"))))
            None -> ()
        if part_model(p) == "ds3231"
            val model = virt.rtc_model(p, NANOSECOND_HZ) match
                Ok(m) -> m
                Err(_) -> virt.rtc_epoch(p, NANOSECOND_HZ)
            val r: &RpRtc = RpRtc(p.name, model, u32(virt.bus_signal_pin(b, p, "i2c", "sda")), u32(virt.bus_signal_pin(b, p, "i2c", "scl")), 0, 0, 0)
            rtcs.push(r)
        if part_model(p) != "buzzer" then continue
        val pin = virt.terminal_pin(p, "pin")
        if pin < 0 then continue
        val gain = real(part_whole(p, "gain", 12)) / 100.0
        buzzers.push(RpBuzzer(p.name, u32(pin), part_text(p, "kind", "passive") == "active", u64(part_whole(p, "tone", 4000)),
            gain, audio.synth(48000, 48000, gain), 0, false, false))
    RpParts(b.parts, inputs, virt.displays_of(b), buzzers, panels, oleds, touches, rtcs, radios)

// An RP board's DS3231 counts nanoseconds.
private const NANOSECOND_HZ: u64 = 1000000000

// The GPIOs a CYW43439 offers other parts (`gpio0` to `gpio2`, CYW43_WL_GPIO_COUNT in the SDK's
// boards/pico2_w.h:85).
private const RADIO_GPIOS: u32 = 3

// The GPIO a CYW43439's `terminal` is wired to, which `rp_parts_refusal` has seen is one of the chip's.
private radio_pin(p: Part, terminal: string) -> u32 = u32(virt.terminal_pin(p, terminal))

impl RpParts
    /** The part named `name`, if the board has it. */
    part(*self,name: string) -> Option[Part]
        for p in self.parts do if p.name == name then return Some(p)
        None

    /** The CYW43439 named `name`, if the board has it. */
    radio(*self, name: string) -> Option[&cyw43.Cyw43]
        for r in self.radios do if r.name == name then return Some(r.chip)
        None

    /** The level of the radio GPIO that part `p`'s `terminal` is wired to (`wifi.gpio0`), or None where
     * it is wired to no radio's GPIO.
     */
    radio_gpio(*self, p: Part, terminal: string) -> Option[bool]
        for w in p.wires
            if w.port != terminal then continue
            val (owner, port) = w.to match
                Port(owner, port) -> (owner, port)
                _ -> return None
            val radio = self.radio(owner) match
                Some(r) -> r
                None -> return None
            for n in 0u32..<RADIO_GPIOS do if port == s"gpio$n" then return Some(radio.gpio(n))
        None

    /** What a radio has refused that the board has not yet reported, once. */
    take_note(*self) -> Option[string]
        for r in self.radios
            r.chip.take_note() match
                Some(note) -> return Some(note)
                None -> ()
        None

    /** What the named part's control is doing; `Inert` for a part with none. */
    input(*self,name: string) -> PartInput
        for i in 0..<self.parts.len() do if self.parts[i].name == name then return self.inputs[i]
        PartInput.Inert

    /** Set the named part's control; `apply_parts` puts it on the chip. A position is held to the
     * control's travel.
     */
    set_input(*self,name: string, input: PartInput)
        for i in 0..<self.parts.len()
            if self.parts[i].name == name
                self.inputs[i] = input match
                    Position(at) -> PartInput.Position(travel(at))
                    Axes(x, y) -> PartInput.Axes(travel(x), travel(y))
                    other -> other

    /** What each digit of the seven-segment display `name` shows at clk_sys cycle `cycle`: its
     * segments, bit i for a..g, dp.
     */
    segments(*self,name: string, cycle: u64) -> [8]u8 = virt.segments_of(&self.displays, name, cycle)

    /** The HD44780 `name`, as its controller stands. */
    lcd(*self,name: string) -> Option[Lcd] = virt.lcd_of(&self.displays, name)

    /** What the buzzer `name` has sounded since the last call, at 48 kHz. */
    sound(*self,name: string) -> Buf[f32]
        for b in self.buzzers do if b.name == name then return audio.take(b.synth)
        buf()

    /** What the glass of the panel `name` shows now; None where the board has no such panel. */
    frame(*self, name: string) -> Option[virt.TftFrame]
        for p in self.panels do if p.name() == name then return Some(p.glass())
        None

    /** The touch controller `name`'s coordinate range as its configuration stands. */
    touch_size(*self, name: string) -> Option[(int, int)]
        for t in self.touches do if t.model.name == name then return Some(t.model.size())
        None

    /** A finger at (x, y) on the touch controller `name`, or lifted. */
    touch(*self, name: string, x: int, y: int, down: bool)
        for t in self.touches do if t.model.name == name then t.model.point(x, y, down)

    /** Every finger lifted from every touch controller. */
    lift_touches(*self)
        for t in self.touches do t.model.lift()

    /** The SSD1306 `name`'s controller as it stands; None where the board has no such OLED. */
    oled(*self, name: string) -> Option[oled.Display]
        for o in self.oleds do if o.name() == name then return Some(o.display())
        None

    /** The LED matrix `name`'s brightness at clk_sys cycle `cycle`, row * 8 + column. */
    matrix(*self, name: string, cycle: u64) -> [64]u8 = virt.brightness_of(&self.displays, name, cycle)

    /** What each LED of the WS2812 chain `name` shows at clk_sys cycle `cycle`, the parts having seen the
     * pins up to it; empty where the board has no such chain.
     */
    pixels(*self, name: string, cycle: u64) -> Buf[u32] = virt.pixels_of(&self.displays, name, cycle)

    /** The DS3231 `name`'s time and date registers at clk_sys cycle `cycle`; None where the board has
     * no such clock.
     */
    rtc(*self, name: string, cycle: u64) -> Option[[7]u8]
        for r in self.rtcs
            if r.name != name then continue
            rtc.advance(&r.model, r.at(cycle))
            var result: [7]u8 = [0; 7]
            for i in 0..<7 do result[i] = r.model.registers[i]
            return Some(result)
        None

private travel(at: int) -> int = if at < 0 then 0 elif at > virt.POSITION_MAX then virt.POSITION_MAX else at

/** Put the parts on chip `c`, a new board: it watches the pins the displays, WS2812s and buzzers are
 * wired to, each from power-on; each SPI panel and OLED, its controller fresh, hears its terminals'
 * GPIOs; each CYW43439, powered down, hears its terminals' GPIOs and answers on its data line; each
 * touch controller, booted, and each DS3231, its count running on from where it was, goes on the I2C
 * lines; and every control is put on its pins as it stands.
 */
connect_parts[C: PartPins](ps: *RpParts, c: *C)
    var mask: u64 = 0
    for p in ps.parts
        val model = part_model(p)
        if model != "seven-segment" && model != "hd44780" && model != "led-matrix-5x5" && model != "ws2812" && model != "buzzer" then continue
        for w in p.wires
            val n = virt.connection_pin(w.to)
            if n >= 0 then mask |= 1u64 << u64(n)
    virt.restart_pixels(&ps.displays)
    c.part_watch(mask)
    for panel in ps.panels
        panel.restart()
        c.part_hook(PinHook(port_mask(panel.pins()), (levels, driven) -> panel.hear(levels, driven)))
    for o in ps.oleds
        o.restart()
        c.part_hook(PinHook(port_mask(o.pins()), (levels, driven) -> o.hear(levels, driven)))
    for r in ps.radios
        val radio = r.chip
        radio.restart()
        val w = radio.wiring
        val mask = (1u64 << u64(w.wl_on)) | (1u64 << u64(w.data)) | (1u64 << u64(w.cs)) | (1u64 << u64(w.clock))
        c.part_answer(PinAnswer(mask, w.data, levels -> radio.hear(levels)))
    for t in ps.touches
        val model = t.model
        model.boot()
        c.part_i2c(I2cPart(t.sda, t.scl, Device(model.address, (w, reading, time) -> model.start(reading),
            (w, byte, time) -> model.write(byte), (w, time) -> model.read()), true))
    for r in ps.rtcs
        r.cycle = c.part_clock()
        r.hz = c.part_hz()
        c.part_i2c(I2cPart(r.sda, r.scl, Device(0x68, (w, reading, time) -> rtc.start(&r.model, reading, r.at(time)),
            (w, byte, time) -> rtc.write(&r.model, byte, r.at(time)), (w, time) -> rtc.read(&r.model, r.at(time))), true))
    apply_parts(ps, c)

// The GPIOs a four-wire SPI port's terminals are on, bit n for GPIO n.
private port_mask(pins: virt.PortPins) -> u64
    var heard: u64 = 0
    for n in [pins.cs, pins.sck, pins.mosi, pins.dc, pins.reset] do if n >= 0 then heard |= 1u64 << u64(n)
    heard

/** Put every part's control on chip `c`'s pins: a closed button or switch drives its GPIO to its active
 * level and an open one lets it go; a potentiometer or a joystick puts its wiper's level on its ADC
 * inputs.
 */
apply_parts[C: PartPins](ps: *RpParts, c: *C)
    for i in 0..<ps.parts.len()
        val p = ps.parts[i]
        ps.inputs[i] match
            Pressed(down) -> close(c, p, down)
            Closed(on) -> close(c, p, on)
            Position(at) -> analog(c, virt.terminal_pin(p, "wiper"), virt.pot_voltage(p, at))
            Axes(x, y) ->
                analog(c, virt.terminal_pin(p, "x"), virt.pot_voltage(p, x))
                analog(c, virt.terminal_pin(p, "y"), virt.pot_voltage(p, y))
            Inert -> ()

private close[C: PartPins](c: *C, p: Part, closed: bool)
    val pin = virt.terminal_pin(p, "pin")
    if pin >= 0 then c.part_drive(u32(pin), if closed then Some(part_text(p, "active", "low") == "high") else None)

private analog[C: PartPins](c: *C, pin: int, uv: u32)
    if pin >= 0 then c.part_analog(u32(pin), Some(uv))

/** The parts see what chip `c`'s pins have done since they last looked: the displays and WS2812s each
 * change, and the buzzers the sound up to the chip's clock; and the DS3231s' counts are brought up to
 * it, at the rate clk_sys runs at from now.
 */
observe_parts[C: PartPins](ps: *RpParts, c: *C)
    val hz = c.part_hz()
    for ch in c.part_changes()
        sound_to(ps, c, ch.cycle)
        for i in 0..<ps.buzzers.len()
            val bit = 1u64 << u64(ps.buzzers[i].pin)
            ps.buzzers[i].level = ch.levels & bit != 0
            ps.buzzers[i].driven = ch.driven & bit != 0
        virt.observe_pins(&ps.displays, u32.wrap(ch.levels), u32.wrap(ch.driven), ch.cycle, hz)
    sound_to(ps, c, c.part_clock())
    for r in ps.rtcs do r.rate(c.part_clock(), hz)

// The buzzers sounded up to clk_sys cycle `cycle`, each as it stands.
private sound_to[C: PartPins](ps: *RpParts, c: *C, cycle: u64)
    val hz = c.part_hz() * 16
    if hz < 48000 then return
    for i in 0..<ps.buzzers.len()
        if ps.buzzers[i].hz != hz
            ps.buzzers[i].synth = audio.synth(hz, 48000, ps.buzzers[i].gain)
            ps.buzzers[i].hz = hz
            audio.clear(ps.buzzers[i].synth, cycle * 16)
        val b = ps.buzzers[i]
        audio.advance(b.synth, cycle * 16, wave(b, c))

// What buzzer `b` sounds while its pin stands as it does.
private wave[C: PartPins](b: RpBuzzer, c: *C) -> audio.Wave
    c.part_pwm(b.pin) match
        Some((period, high)) -> return audio.Wave(true, period, high, 0, false)
        None -> ()
    if b.active
        val period = b.hz / b.tone
        return audio.Wave(b.driven && b.level, period, period / 2, 0, false)
    audio.Wave(b.driven, 0, 0, 0, b.level)

/** The pitch the buzzer `name` sounds on chip `c` now, in Hz: the PWM's rate where a free-running slice
 * drives its pin with a duty between none and all, an active buzzer's tone while its pin is high, and
 * otherwise 0.
 */
pitch[C: PartPins](ps: *RpParts, c: *C, name: string) -> u64
    for b in ps.buzzers
        if b.name != name then continue
        c.part_pwm(b.pin) match
            Some((period, high)) -> return if high == 0 || high >= period then 0 else c.part_hz() * 16 / period
            None -> ()
        val p = c.part_pin(b.pin)
        return if b.active && p.drives && p.level then b.tone else 0
    0

/** Whether the LED `name` is lit on chip `c`: its anode's GPIO driven to its active level, or the GPIO
 * of the radio it is wired to at that level.
 */
lit[C: PartPins](ps: *RpParts, c: *C, name: string) -> bool
    val p = ps.part(name) match
        Some(p) -> p
        None -> return false
    ps.radio_gpio(p, "anode") match
        Some(high) -> return high == (part_text(p, "active", "high") == "high")
        None -> ()
    val pin = virt.terminal_pin(p, "anode")
    if pin < 0 then return false
    val s = c.part_pin(u32(pin))
    s.drives && s.level == (part_text(p, "active", "high") == "high")
