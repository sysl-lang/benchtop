module sh.sysl.benchtop.chip

// The exit report of an RP board (`virt.ExitReport`, `benchtop run --report`): its clock and its cores
// or harts as the run left them. Read once, after the run has ended.

import sh.sysl.benchtop.riscv as rv
import sh.sysl.benchtop.virt as virt
import sh.sysl.benchtop.virt.{CoreArch, CoreReport, CoreState, ExitKind, ExitReport}
import sh.sysl.benchtop.v6m.{ExplainOptions, FaultSummary, SymbolTable, explain_faults, fault_summary}
import sysl.buf.{Buf, buf}

/** The run end a run that `run` ended at `end` is, its cores' stops deciding a fault's sort. */
private kind_of_end(end: RunEnd, cores: []const CoreReport) -> ExitKind = end match
    Budget -> ExitKind.Budget
    Breakpoint -> ExitKind.Breakpoint
    Exit -> ExitKind.Exit
    Asleep -> ExitKind.Asleep
    Fault -> virt.ended_kind(cores, ExitKind.Fault)

impl[C: ArmChip] ArmBoard[C]
    /** Both cores as the exit report gives them. */
    report_cores(*self) -> Buf[CoreReport]
        var cores: Buf[CoreReport] = buf()
        for k in 0..<2 do cores.push(virt.cortex_core_report(&self.cores[k], u32(k), self.started[k]))
        cores

    /** The exit report of a run `run` ended at `end`, after which `benchtop run` exits with `status`
     * saying `message`.
     */
    end_report(*self, end: RunEnd, status: int, message: string) -> ExitReport
        val cores = self.report_cores()
        var r = virt.exit_report(kind_of_end(end, cores.view()), status, message)
        if end == RunEnd.Exit then r.exit_status = long(self.exit_status)
        // The chip catches up at a quantum's end, so where a core stopped inside one, the board's time
        // is that core's.
        r.cycles = self.chip.clock()
        for c in cores do if c.started && c.cycles > r.cycles then r.cycles = c.cycles
        val hz = self.chip.clock_rate()
        r.rated = hz != 0
        r.ns = virt.nanos(r.cycles, hz)
        r.cores = cores
        r.fault = self.faults()
        r

    /** The faults of both cores, each that started (v6m/explain.sysl), read once the run has ended. */
    faults(*self) -> FaultSummary
        var s = fault_summary()
        for k in 0..<2 do if self.started[k] then s.add_core(&self.cores[k], u32(k))
        s

    /** Record both cores' faults from now on, as `o` asks, after `boot`; `table` names addresses and
     * stays alive while they run. */
    record_faults(*self, o: ExplainOptions, table: &SymbolTable)
        for k in 0..<2 do explain_faults(&self.cores[k], o, Some(table))

impl RiscvBoard
    /** Both harts as the exit report gives them: the pc, mstatus and the privilege level. */
    report_cores(*self) -> Buf[CoreReport]
        var cores: Buf[CoreReport] = buf()
        for k in 0..<2
            if !self.started[k]
                cores.push(virt.unstarted_core(u32(k), CoreArch.RiscV))
                continue
            val h = &self.harts[k]
            val (state, stop) = h.stop match
                Budget -> (CoreState.Running, ExitKind.Budget)
                Sleep -> (CoreState.Sleeping, ExitKind.Budget)
                Breakpoint -> (CoreState.Halted, ExitKind.Breakpoint)
                Exit -> (CoreState.Halted, ExitKind.Exit)
                Ecall | Undefined | Misaligned | Unmapped | AccessFault -> (CoreState.Halted, ExitKind.Fault)
            // Both harts run on clk_sys, so a hart's cycles are the chip's.
            cores.push(CoreReport(u32(k), true, CoreArch.RiscV, state, stop, h.pc, self.chip.now, h.retired,
                0, 0, 0, 0, 0, 0, 0, 0, false, false, h.cs.mstatus, h.cs.privilege))
        cores

    /** The exit report of a run `run` ended at `end`, after which `benchtop run` exits with `status`
     * saying `message`.
     */
    end_report(*self, end: RunEnd, status: int, message: string) -> ExitReport
        val cores = self.report_cores()
        var r = virt.exit_report(kind_of_end(end, cores.view()), status, message)
        if r.exit == ExitKind.Exit
            for k in 0..<2 do if self.started[k] && self.harts[k].stop == rv.Stop.Exit then r.exit_status = long(self.harts[k].exit_code)
        r.cycles = self.chip.now
        val hz = self.chip.sys_hz()
        r.rated = hz != 0
        r.ns = virt.nanos(r.cycles, hz)
        r.cores = cores
        r
