module sh.sysl.benchtop.chip

import sh.sysl.benchtop.peripheral.rp2350.{XIP_BASE, XIP_SRAM_BASE, XIP_SRAM_BYTES}
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.benchtop.v6m as arm
import sh.sysl.benchtop.v6m.{CoprocessorOp, Fpu, Kind, MemoryMap, RamBank, Stop}
import sh.sysl.elf
import sh.sysl.rp2350.psm as psm_reg
import sysl.buf.{Buf, buf}
import sysl.fmt.hex
import sysl.math.min

// An RP2350 booted on its two Cortex-M33 cores (`mcus/rp2350.hocon`, the `pico2` board): the chip, its
// SRAM as the cores' RAM, and the cores reaching every other address, and their coprocessor ports,
// through the chip. It is `RiscvBoard`'s twin, around the same `Rp2350`.
//
// **Boot** is DESIGN.md §9.2's debugger entry, as a probe loads an image: an ELF's loadable segments
// are written where their physical addresses say, into SRAM, the 4 MB flash behind XIP_BASE, or the
// XIP cache's lines at XIP_SRAM_BASE, which are pinned first when an image lands there, as the boot
// ROM pins them for an image that asks; core 0 starts at the ELF entry with the stack pointer at the
// top of SRAM. A UF2 is written the same way, block by block; a flash UF2 starts as the boot ROM hands
// a flash image over (the RCP's salts set, VTOR, SP and PC from the vector table at XIP_BASE) and a
// RAM one at its first byte. Core 1 waits in the boot ROM until core 0 launches it through the SIO
// FIFOs (§9.6), when it starts at the entry it was sent, with the stack pointer and VTOR it was sent.
//
// **The watchdog's reset** (`Rp2350.watchdog_reset`) stops each core whose PSM stage it took down at
// once, at `Stop.Reset`, before the access that found it; at the end of the quantum the board restarts
// them. Core 1 goes back to the boot ROM. Core 0 boots as the boot ROM boots it after a watchdog reset
// (datasheet chapter 5, "Bootrom", its boot sequence; the SDK's `watchdog_reboot` and crt0 write the requests): SCRATCH4
// holding 0xb007c0d3 with SCRATCH5 = SCRATCH7 ^ -0xb007c0d3 asks for SCRATCH7 as the PC and SCRATCH6
// as the SP, a request the ROM consumes (it clears SCRATCH4; that it does is an assumption); a
// SCRATCH7 of the magic itself asks for a boot of the type in SCRATCH6, which is the ROM's real boot
// path and refused by name (items 6 and 30). Otherwise it is the normal boot: the flash image, handed
// over as a flash UF2 is at power-on. A flash with no image in its first 4 KB (no block marker
// 0xffffded3) would leave the ROM in BOOTSEL's USB boot, which is not modelled, so that run ends,
// named. The ROM's `get_sys_info` answers BOOT_INFO with the boot each took (`write_boot_info`): at
// power-on NORMAL where the flash holds an image and BOOTSEL where it does not, as the ROM had booted
// before the debugger entered; NORMAL or PC_SP after a watchdog reset.
//
// **Memory** is on the cores' fast path: SRAM; the flash, read and executed in place from the cached
// window's first 4 MB (the other windows and the rest of it reach the chip, `Rp2350.read`); the boot
// ROM, read-only; and the XIP_SRAM page whose every cache line is pinned. The board keeps the map in
// step with the chip (`sync_xip`): a flash program or erase makes code decoded from it decode again,
// direct mode takes the flash off the fast path (where memory-mapped access is a bus error), and an
// XIP_SRAM page with a line unpinned leaves it, so each access there is checked line by line.
//
// **The cores are the RP2350's**: ARMv8-M Mainline with the DSP extension and the single-precision
// FPU, an NVIC of the chip's 52 interrupt lines with four priority bits, and the chip's coprocessors
// on CP0, CP4, CP5 and CP7 (coprocessors.sysl).
//
// **Time** runs in quanta of clk_sys cycles, one per instruction: each started core runs the quantum,
// a device access is timed at the quantum's start plus the core's cycles into it, and the chip is
// brought to the quantum's end before the next. A core in `WFI` sleeps to the quantum's end unless
// an interrupt or its SysTick wakes it; while both sleep the board skips to the next device event or
// SysTick. A core that executes `BKPT` ends the run.

/** The RP2350's external interrupt lines, IRQ 0 to 51. */
const RP2350_IRQS: u32 = 52
/** The coprocessors on each M33's port: GPIOC (CP0), the DCP's two instances (CP4, CP5) and the RCP (CP7). */
const COPROCESSORS: u32 = 0xB1
/** The boot ROM's window at address 0, and benchtop's ROM in it (rom/rom.S). */
const ROM_BYTES: u32 = 32 * 1024
/** Where core 1 waits in benchtop's ROM (`park`), and where a launched entry returns to. */
const ROM_PARK: u32 = 0x40
private val ROM = embed("rom/rom.bin")
/** The Pico 2's flash: 4 MB on QSPI chip select 0. */
const FLASH_BYTES: u32 = 4 * 1024 * 1024

/** Where benchtop's ROM keeps the four words of BOOT_INFO that `get_sys_info` answers (rom/rom.S). */
const BOOT_INFO_AT: u32 = 0x100
/** The boot types BOOT_INFO reports (`boot/bootrom_constants.h`). */
const BOOT_TYPE_NORMAL: u32 = 0
const BOOT_TYPE_BOOTSEL: u32 = 2
const BOOT_TYPE_PC_SP: u32 = 0xD
/** The magic of a watchdog boot request in SCRATCH4 (the SDK's `watchdog_reboot`). */
const WATCHDOG_BOOT_MAGIC: u32 = 0xB007C0D3
// The first word of an image's block (`boot/picobin.h`), which the ROM's normal boot looks for in the
// flash's first 4 KB.
private const BLOCK_MARKER_START: u32 = 0xFFFFDED3

// UF2 (github.com/microsoft/uf2): 512-byte blocks, their magic numbers, the flag that marks a block
// not for the device's main memory and the one that says a family ID is present, and the families an
// Arm RP2350 running Secure code takes (the SDK's `boot/uf2.h`).
private const UF2_BLOCK: usize = 512
private const UF2_MAGIC_START0: u32 = 0x0A324655
private const UF2_MAGIC_START1: u32 = 0x9E5D5157
private const UF2_MAGIC_END: u32 = 0x0AB16F30
private const UF2_NOT_MAIN_FLASH: u32 = 0x1
private const UF2_FAMILY_PRESENT: u32 = 0x2000
private const UF2_PAYLOAD_MAX: u32 = 476
private const FAMILY_ABSOLUTE: u32 = 0xE48BFF57
private const FAMILY_DATA: u32 = 0xE48BFF58
private const FAMILY_RP2350_ARM_S: u32 = 0xE48BFF59
private const RP2350_E10_BLOCK: u32 = 0x10FFFF00

/** Where an image starts: core 0's PC and SP, the VTOR it starts with, whether the XIP cache's lines
 * over XIP_SRAM are pinned for it, and whether the boot ROM's hand-off (the RCP's salts) precedes it.
 */
struct Start
    pc: u32
    sp: u32
    vtor: u32
    pin: bool
    handoff: bool

struct ArmBoard
    chip: Rp2350
    cores: [2]arm.Cpu
    mem: &sync arm.Memory
    map: SramMap
    started: [2]bool
    // The chip's clock at the start of the running quantum, and each core's clock there.
    quantum_at: u64
    clock_at: [2]u64
    quantum: u64
    // Why the chip refused the running core's access, or faulted it (the RCP), before the core has
    // said where it stopped; then the run's reason, with the core and its PC.
    why: string
    refused: string
    // Every byte UART0 has sent.
    console: Buf[u8]
    // Where the boot ROM and XIP_SRAM sit in the RAM backing, after SRAM and each one's guard records.
    rom_at: u32
    sram_at: u32
    // Whether the flash is off the fast path (direct mode), and the XIP block's epoch the XIP_SRAM pages
    // were last mapped for.
    direct: bool
    xip_epoch: u32

/** A board with `map`'s SRAM, powered on, holding no image. */
arm_board(map: SramMap) -> &ArmBoard
    // Cores before `boot`, every field zero; `boot` resets them.
    var cores: [2]arm.Cpu
    val rom_at = page_up(map.size) + arm.GUARD_BYTES
    val sram_at = rom_at + ROM_BYTES + arm.GUARD_BYTES
    ArmBoard(rp2350(), cores, arm.memory(), map, [false, false], 0, [0, 0], 1000, "", "", buf(), rom_at, sram_at, false, 0)

impl ArmBoard
    /** Power on with `image`, an ELF or a UF2, written into SRAM, flash and XIP_SRAM: core 0 at its
     * entry, core 1 in the boot ROM.
     */
    boot(*self, image: []const u8) -> Result[unit, string]
        if self.sram_at + XIP_SRAM_BYTES + arm.GUARD_BYTES > arm.RAM_BYTES then return Err("the SRAM leaves no room for the boot ROM and XIP_SRAM in the cores' memory")
        // The packed image `reset_mapped` lays out: the RAM backing (SRAM, the ROM, XIP_SRAM), then the
        // flash, erased. The image is written into it where its addresses say.
        var packed: Buf[u8] = buf()
        for i in 0..<arm.RAM_BYTES do packed.push(0)
        for i in 0..<ROM.len do packed.set(usize(self.rom_at) + i, ROM[i])
        for i in 0..<FLASH_BYTES do packed.push(0xFF)
        val all = packed.view()
        var regions = [
            elf.Region(u64(self.map.base), all[..<usize(self.map.size)]),
            elf.Region(u64(XIP_BASE), all[usize(arm.RAM_BYTES)..]),
            elf.Region(u64(XIP_SRAM_BASE), all[usize(self.sram_at)..<usize(self.sram_at + XIP_SRAM_BYTES)]),
        ]
        val start = if is_uf2(image) then self.load_uf2(image, regions[..])? else self.load_elf(image, regions[..])?
        var banks: Buf[RamBank] = buf()
        banks.push(RamBank(0, ROM_BYTES, self.rom_at))
        banks.push(RamBank(XIP_SRAM_BASE, XIP_SRAM_BYTES, self.sram_at))
        val first = &self.cores[0]
        first.kind = Kind.V8mMain
        arm.reset_mapped(first, self.mem, packed.view(), MemoryMap(self.map.base, self.map.size, XIP_BASE, FLASH_BYTES, banks.freeze()))
        arm.read_only(self.mem, 0)
        self.chip.reset()
        self.chip.flash.connect(&self.mem.flash[0], FLASH_BYTES)
        if start.pin
            for k in 0u32..<(XIP_SRAM_BYTES / 8) do self.chip.xip.maintain(XIP_SRAM_BASE - XIP_BASE + k * 8 + 7).unwrap()
        if start.handoff then self.chip.rcp.salted = [true, true]
        self.direct = false
        self.xip_epoch = self.chip.xip.epoch +% 1
        self.sync_xip()
        self.configure(first, 0)
        first.pc = start.pc & ~1
        first.r[13] = start.sp
        first.vtor = start.vtor
        val second = &self.cores[1]
        second.kind = Kind.V8mMain
        arm.attach_memory(second, self.mem)
        arm.clear(second, 0)
        self.configure(second, 1)
        self.started = [true, false]
        self.quantum_at = 0
        self.why = ""
        self.refused = ""
        self.console.clear()
        self.write_boot_info(if self.flash_image() then BOOT_TYPE_NORMAL else BOOT_TYPE_BOOTSEL)
        if start.pc & 1 == 0 then return Err(s"the entry 0x${hex(start.pc, 8)} is not a Thumb address")
        Ok(())
    end boot

    /** Whether the flash holds an image the boot ROM's normal boot would find: a block marker in its
     * first 4 KB.
     */
    flash_image(self) -> bool
        for at in 0u32..<1024 do if self.flash_word(4 * at) == BLOCK_MARKER_START then return true
        false

    // The little-endian word at byte `at` of the flash.
    private flash_word(self, at: u32) -> u32
        var v: u32 = 0
        for k in 0u32..<4 do v |= u32(self.mem.flash[at + k]) << (8 * k)
        v

    // BOOT_INFO in benchtop's ROM: the boot `boot_type` with no partition table (diagnostic partition
    // and partition both BOOT_PARTITION_NONE, -1), no diagnostic and no reboot parameters.
    private write_boot_info(*self, boot_type: u32)
        val info = [0xFF | (boot_type << 8) | (0xFF << 16), 0, 0, 0]
        for i in 0..<4
            for k in 0..<4 do self.mem.ram[self.rom_at + BOOT_INFO_AT + u32(4 * i + k)] = u8.wrap(info[i] >> u32(8 * k))

    /** The boot ROM's boot of core 0 after a watchdog reset: the request in SCRATCH4–7, or the normal
     * boot of the flash image; or why benchtop cannot make it.
     */
    private watchdog_boot(*self) -> Result[Start, string]
        val s = self.chip.watchdog.scratch
        if s[4] == WATCHDOG_BOOT_MAGIC && s[5] == s[7] ^ (0 -% WATCHDOG_BOOT_MAGIC)
            self.chip.watchdog.scratch[4] = 0
            if s[7] == WATCHDOG_BOOT_MAGIC
                return Err(s"the watchdog's reset asks the boot ROM for a boot of type ${s[6]} (SCRATCH6), which is the ROM's own boot path, not modelled (docs/rp-coverage.md items 6 and 30)")
            self.write_boot_info(BOOT_TYPE_PC_SP)
            return Ok(Start(s[7], s[6], 0, false, true))
        if !self.flash_image()
            return Err("the watchdog's reset leaves the boot ROM a normal boot, and the flash holds no image (no block marker 0xffffded3 in its first 4 KB): the ROM would enter BOOTSEL's USB boot, which is not modelled")
        self.write_boot_info(BOOT_TYPE_NORMAL)
        Ok(Start(self.flash_word(4), self.flash_word(0), XIP_BASE, false, true))

    // The watchdog's reset has taken down the PSM `stages`: the XIP block's mapping follows it, and the
    // cores among the stages restart, core 1 in the boot ROM (`settle` has stopped it) and core 0
    // through `watchdog_boot`. A boot benchtop cannot make ends the run with its reason.
    private restart(*self, stages: u32) -> Result[unit, string]
        if self.chip.take_xip_changed()
            self.xip_epoch = self.chip.xip.epoch +% 1
            self.sync_xip()
        if stages & psm_reg.WDSEL_PROC0_MASK == 0 then return Ok(())
        val start = self.watchdog_boot()?
        val c = &self.cores[0]
        arm.clear(c, start.pc & ~1)
        self.configure(c, 0)
        c.r[13] = start.sp
        c.vtor = start.vtor
        self.started[0] = true
        // The ROM salts the RCP before it hands over, as at power-on.
        self.chip.rcp = rcp()
        self.chip.rcp.salted = [true, true]
        if start.pc & 1 == 0 then arm.halt(c, Stop.Fault, start.pc)
        Ok(())

    // An ELF's loadable segments, each at its physical address: the entry, the stack at SRAM's top, and
    // the XIP_SRAM lines pinned where a segment lands there.
    private load_elf(self, image: []const u8, regions: []elf.Region) -> Result[Start, string]
        val e = elf.read(image).map_err(why -> s"$why")?
        val entry = elf.load(e, regions).map_err(why -> s"$why: every segment must be in the SRAM, the flash or XIP_SRAM")?
        var pin = false
        for s in e.segments().view() do if s.kind == elf.PT_LOAD && s.memsz != 0 && in_xip_sram(s.paddr) then pin = true
        Ok(Start(u32(entry), self.map.base + self.map.size, 0, pin, false))

    // A UF2's blocks for the main memory, each written at its target address. A flash image starts as
    // the boot ROM hands one over, through the vector table at XIP_BASE; a RAM image at its first byte.
    private load_uf2(self, image: []const u8, regions: []elf.Region) -> Result[Start, string]
        if image.len % UF2_BLOCK != 0 then return Err(s"a UF2 is whole 512-byte blocks, and this one is ${image.len} bytes")
        var lowest: u32 = 0xFFFFFFFF
        var pin = false
        for b in 0..<(image.len / UF2_BLOCK)
            val block = image[b * UF2_BLOCK..<(b + 1) * UF2_BLOCK]
            if word(block, 0) != UF2_MAGIC_START0 || word(block, 4) != UF2_MAGIC_START1 || word(block, 508) != UF2_MAGIC_END
                return Err(s"UF2 block $b: its magic numbers are wrong")
            val flags = word(block, 8)
            if flags & UF2_NOT_MAIN_FLASH != 0 then continue
            if flags & UF2_FAMILY_PRESENT == 0 then return Err(s"UF2 block $b names no family, which the RP2350's boot ROM requires")
            val family = word(block, 28)
            if family != FAMILY_RP2350_ARM_S && family != FAMILY_ABSOLUTE && family != FAMILY_DATA
                return Err(s"UF2 block $b is for family 0x${hex(family, 8)}, not the RP2350's Arm Secure (0xe48bff59), absolute or data families")
            val target = word(block, 12)
            val size = word(block, 16)
            // The block picotool puts first for erratum RP2350-E10 (an absolute-family block at
            // 0x10ffff00), which only gets the boot ROM past the erratum and is discarded.
            if family == FAMILY_ABSOLUTE && target == RP2350_E10_BLOCK then continue
            if size > UF2_PAYLOAD_MAX then return Err(s"UF2 block $b carries $size bytes, more than a block holds")
            val r = region_holding(regions, target, size) match
                Some(found) -> found
                None -> return Err(s"UF2 block $b writes 0x${hex(target, 8)}, which is not in the SRAM, the flash or XIP_SRAM")
            val at = usize(u64(target) - r.base)
            for i in 0..<usize(size) do r.bytes[at + i] = block[32 + i]
            if target < lowest then lowest = target
            if in_xip_sram(u64(target)) then pin = true
        if lowest == 0xFFFFFFFF then return Err("the UF2 has no block for the main memory")
        if lowest >= XIP_BASE && lowest < XIP_BASE + FLASH_BYTES
            if lowest != XIP_BASE then return Err(s"the UF2 starts at 0x${hex(lowest, 8)}: finding an image elsewhere in flash is the boot ROM's partition search (docs/rp-coverage.md item 30)")
            val flash = regions[1].bytes
            return Ok(Start(word(flash, 4), word(flash, 0), XIP_BASE, pin, true))
        Ok(Start(lowest | 1, self.map.base + self.map.size, 0, pin, false))

    // Core `k`, just cleared, made one of the RP2350's on this board's bus.
    private configure(*self, c: *arm.Cpu, k: u32)
        c.core = k
        c.dsp = true
        c.fpu = Fpu.Single
        c.nvic_irqs = RP2350_IRQS
        c.priority_bits = 4
        c.coprocessors = COPROCESSORS
        c.security = true
        c.bus = self

    /** Run until `cycles` more clk_sys cycles have passed, or something ends the run first. */
    run(*self, cycles: u64) -> RunEnd
        val limit = self.chip.now + cycles
        while self.chip.now < limit
            val q = min(self.quantum, limit - self.chip.now)
            self.quantum_at = self.chip.now
            for k in 0..<2
                if !self.started[k] then continue
                val end = self.run_core(k, q)
                if end != RunEnd.Budget then return end
            self.chip.catch_up(self.quantum_at + q)
            self.settle()
            if !self.take_restart() then return RunEnd.Fault
            if self.asleep()
                val next = self.next_wake() match
                    Some(n) -> min(n, limit - self.chip.now)
                    None -> return RunEnd.Asleep
                self.sleep(next)
                if !self.take_restart() then return RunEnd.Fault
        RunEnd.Budget
    end run

    // Restart what a watchdog reset since the last call took down; false, with `refused` saying why,
    // where the boot it asks for is not one benchtop makes. Only between quanta: no core is running.
    private take_restart(*self) -> bool
        val stages = self.chip.take_restart() match
            Some(s) -> s
            None -> return true
        self.restart(stages) match
            Ok(_) -> true
            Err(why) ->
                self.refused = s"core 0: $why"
                false

    // Core `k` through `q` cycles of the quantum: run while awake, sleep the rest.
    private run_core(*self, k: usize, q: u64) -> RunEnd
        val c = &self.cores[k]
        val start = arm.clock(c, c.retired)
        self.clock_at[k] = start
        val end = start + q
        loop
            if c.sleeping && !arm.wake_by(c, end) then break
            val now = arm.clock(c, c.retired)
            if now >= end then break
            arm.set_limit(c, c.retired + (end - now))
            arm.run_threaded(c)
            if !self.why.is_empty()
                self.refused = s"core $k at pc 0x${hex(c.pc, 8)}: ${self.why}"
                return RunEnd.Fault
            c.stop match
                Running -> ()
                Breakpoint -> return RunEnd.Breakpoint
                // The watchdog's reset stopped it: the board restarts it once the quantum is over.
                // Any other reset (AIRCR.SYSRESETREQ) is not modelled, and ends the run.
                Reset -> if self.chip.restarting(u32(k)) then break else return RunEnd.Fault
                NonSecure ->
                    self.refused = s"core $k at pc 0x${hex(c.stop_at, 8)}: ${arm.transition_name(c.transition)}: Non-secure state is not modelled"
                    return RunEnd.Fault
                _ -> return RunEnd.Fault
        RunEnd.Budget
    end run_core

    /** The cores that have started are all asleep. */
    asleep(self) -> bool
        for k in 0..<2 do if self.started[k] && !self.cores[k].sleeping then return false
        true

    // The cycles until a device event or a sleeping core's SysTick could wake a core.
    private next_wake(*self) -> Option[u64]
        var due = self.chip.next_event()
        for k in 0..<2
            if !self.started[k] then continue
            val c = &self.cores[k]
            val t = arm.next_wake(c)
            if t != NEVER then due = earliest(due, Some(t - arm.clock(c, c.retired)))
        due

    // Both cores sleep through `cycles`, the chip with them; a core whose SysTick is due wakes.
    private sleep(*self, cycles: u64)
        for k in 0..<2
            if !self.started[k] then continue
            val c = &self.cores[k]
            arm.wake_by(c, arm.clock(c, c.retired) + cycles)
        self.chip.advance(cycles)
        self.settle()

    // After the chip has moved: the bytes UART0 sent, core 1's launch, and every core's interrupts.
    private settle(*self)
        loop
            self.chip.uarts[0].take() match
                Some(c) -> self.console.push(c)
                None -> break
        if self.chip.take_core1_reset() then self.started[1] = false
        self.chip.take_launch() match
            Some(l) -> self.launch(l)
            None -> ()
        for k in 0..<2 do if self.started[k] then self.chip.signal(&self.cores[k])

    // Core 1 leaves the boot ROM as it was told to, called from it: an entry that returns comes back
    // to the ROM's wait (`park`, rom/rom.S), as on the chip. An entry without its Thumb bit stops it at
    // `Fault`, there, as the M33 faults on its first instruction.
    private launch(*self, l: Launch)
        val c = &self.cores[1]
        arm.clear(c, l.entry & ~1)
        self.configure(c, 1)
        c.vtor = l.vector_table
        c.r[13] = l.stack_pointer
        c.r[14] = ROM_PARK | 1
        self.started[1] = true
        if l.entry & 1 == 0 then arm.halt(c, Stop.Fault, l.entry)

    // The chip's clock at core `cpu`'s `n`th retired instruction.
    private at(self, cpu: *arm.Cpu, n: u64) -> u64 = self.quantum_at + (arm.clock(cpu, n) - self.clock_at[usize(cpu.core)])

    // Where the watchdog has reset `cpu`'s PSM stage by the time of its access to `a`, the reset came
    // first: the core stops there, at `Stop.Reset`, and the access is not made.
    private reset_first(self, cpu: *arm.Cpu, a: u32) -> bool
        if !self.chip.restarting(cpu.core) then return false
        arm.halt(cpu, Stop.Reset, a)
        true

    // The first refusal is the run's reason.
    private refuse(*self, cpu: *arm.Cpu, a: u32, why: string)
        if self.why.is_empty() then self.why = why
        arm.halt(cpu, Stop.Unmapped, a)

    /** Bring the cores' memory map into step with the chip's XIP state: code decoded from flash bytes a
     * program or erase changed decodes again; the flash leaves the fast path while direct mode is on;
     * and each XIP_SRAM page is on it while every one of its cache lines is pinned.
     */
    sync_xip(*self)
        loop
            self.chip.flash.take_changed() match
                Some((from, length)) -> arm.flash_changed(self.mem, from, length)
                None -> break
        val direct = self.chip.qmi.direct_enabled()
        if direct != self.direct
            self.direct = direct
            for p in 0u32..<(FLASH_BYTES >> 12) do self.mem.page_table[(XIP_BASE >> 12) + p] = if direct then 0 else usize(&self.mem.flash[p << 12])
        if self.chip.xip.epoch == self.xip_epoch then return
        self.xip_epoch = self.chip.xip.epoch
        for p in 0u32..<(XIP_SRAM_BYTES >> 12)
            self.mem.page_table[(XIP_SRAM_BASE >> 12) + p] = if self.chip.xip.sram_page_live(p) then usize(&self.mem.ram[self.sram_at + (p << 12)]) else 0

    // An access to XIP_SRAM off the fast path, in a page not every line of which is pinned: the line's
    // bytes in the cores' memory where it is pinned, or why the access is a bus error.
    private sram_line(self, a: u32, width: u32) -> Result[usize, string]
        if a & (width - 1) != 0 then return Err(s"0x${hex(a, 8)}: an unaligned access to XIP_SRAM")
        if !self.chip.xip.sram_live(a)
            return Err(s"0x${hex(a, 8)} is in XIP_SRAM, and no cache line is pinned there with the cache enabled: on silicon the access misses, and the miss is a bus error")
        Ok(usize(self.sram_at + (a - XIP_SRAM_BASE)))
end ArmBoard

impl arm.Bus for ArmBoard
    read(*self, cpu: *arm.Cpu, a: u32, width: u32, n: u64) -> u32
        self.chip.catch_up(self.at(cpu, n))
        if self.reset_first(cpu, a) then return 0
        if in_xip_sram(u64(a))
            self.sram_line(a, width) match
                Ok(at) ->
                    var v: u32 = 0
                    for k in 0..<usize(width) do v |= u32(self.mem.ram[at + k]) << u32(8 * k)
                    return v
                Err(why) ->
                    self.refuse(cpu, a, why)
                    return 0
        self.chip.read(cpu.core, a, width) match
            Ok(v) -> v
            Err(why) ->
                self.refuse(cpu, a, why)
                0

    write(*self, cpu: *arm.Cpu, a: u32, width: u32, x: u32, n: u64)
        self.chip.catch_up(self.at(cpu, n))
        if self.reset_first(cpu, a) then return
        if a < ROM_BYTES
            self.refuse(cpu, a, s"0x${hex(a, 8)} is in the boot ROM, which is read-only")
            return
        if in_xip_sram(u64(a))
            self.sram_line(a, width) match
                Ok(at) ->
                    for k in 0..<usize(width) do self.mem.ram[at + k] = u8.wrap(x >> u32(8 * k))
                    arm.bus_stored(cpu, a, width)
                Err(why) -> self.refuse(cpu, a, why)
            return
        val r = self.chip.write(cpu.core, a, width, x)
        if self.chip.take_xip_changed() then self.sync_xip()
        r match
            Ok(_) ->
                self.settle()
                // TRIGGER: the core stops after the store that made the reset.
                if self.chip.restarting(cpu.core) then arm.halt(cpu, Stop.Reset, a)
            Err(why) -> self.refuse(cpu, a, why)

    override coprocessor(*self, cpu: *arm.Cpu, op: CoprocessorOp, n: u64) -> Option[u64]
        // The DCP is the core's own and touches no device, so its instructions need no catch-up.
        if op.coprocessor == 4 || op.coprocessor == 5
            self.chip.dcp.run(cpu.core, op) match
                Ok(x) -> return Some(x)
                Err(e) ->
                    self.refuse(cpu, 0, e.why)
                    return Some(0)
        self.chip.catch_up(self.at(cpu, n))
        if self.reset_first(cpu, 0) then return Some(0)
        self.chip.coprocessor(cpu.core, op) match
            None -> None
            Some(Ok(x)) ->
                self.settle()
                Some(x)
            Some(Err(e)) ->
                // The core stops on the instruction (coproc.sysl): at `Fault` for the RCP's fault, which
                // names the check that failed, as for a refusal.
                if e.fault
                    if self.why.is_empty() then self.why = e.why
                    arm.halt(cpu, Stop.Fault, 0)
                else
                    self.refuse(cpu, 0, e.why)
                Some(0)

// Whether `a` is in XIP_SRAM, the 16 KB of the XIP cache's lines pinned as SRAM.
private in_xip_sram(a: u64) -> bool = a >= u64(XIP_SRAM_BASE) && a < u64(XIP_SRAM_BASE) + u64(XIP_SRAM_BYTES)

// The little-endian word at byte `at` of `bytes`.
private word(bytes: []const u8, at: usize) -> u32 =
    u32(bytes[at]) | (u32(bytes[at + 1]) << 8) | (u32(bytes[at + 2]) << 16) | (u32(bytes[at + 3]) << 24)

// Whether `image` starts with a UF2 block's first magic number.
private is_uf2(image: []const u8) -> bool = image.len >= UF2_BLOCK && word(image, 0) == UF2_MAGIC_START0

// The region holding all `size` bytes from `at`.
private region_holding(regions: []elf.Region, at: u32, size: u32) -> Option[elf.Region]
    for r in regions do if u64(at) >= r.base && u64(at) + u64(size) <= r.base + u64(r.bytes.len) then return Some(r)
    None

// `n` rounded up to a whole 4 KB page.
private page_up(n: u32) -> u32 = (n + 4095) & ~4095u32
