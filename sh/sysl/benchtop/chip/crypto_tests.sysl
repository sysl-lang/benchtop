module sh.sysl.benchtop.chip
@tests

import sysl.text.from_utf8_lossy

private val RAND = embed("../../../../examples/pico2/rand.elf")
private val HELLO_SHA256 = embed("../../../../examples/pico2/hello_sha256.elf")
private val SRAM = SramMap(0x20000000, 520 * 1024)

private run_to_end(b: &ArmBoard, cycles: u64) -> string
    val end = b.run(cycles)
    assert(end == RunEnd.Breakpoint, s"$end ${b.refused}: ${from_utf8_lossy(b.console.view())}")
    assert(b.finish_sending(), b.refused)
    from_utf8_lossy(b.console.view())

@test("probe: hello_sha256")
probe_sha()
    val b = arm_board(SRAM)
    b.boot(HELLO_SHA256).unwrap()
    val text = run_to_end(b, 4000000000)
    assert(text.starts_with("Text: 445 bytes\r\nLorem ipsum dolor sit amet"), text)
    assert(text.contains("\r\nResult:\r\n2d 8c 2f 6d 97 8c a2 17 12 b5 f6 de 36 c9 d3 1f \r\na8 e9 6a 4f a5 d8 ff 8b 01 88 df b9 e7 c1 71 bb \r\n"), text)
    assert(text.contains("Time for sha256 of 1M bytes without DMA "), text)
    assert(text.contains("Time for sha256 of 1M bytes with DMA "), text)
    assert(text.ends_with("Success\r\n"), text)

@test("probe: rand")
probe_rand()
    val b = arm_board(SRAM)
    b.boot(RAND).unwrap()
    val text = run_to_end(b, 4000000000)
    assert(text.starts_with("Random 32bits b9abb7ff\r\nRandom 64bits 5a1c8409dacbfaec\r\nRandom 128bits 3d7136ea8db777d26d113ebf75ad2b23\r\n"), text)
    assert(text.contains("Generating 500000 random numbers\r\n"), text)
    assert(text.contains("count of 31: 15692\r\n"), text)
    assert(text.contains("Biggest count: 15834\r\nSmallest count: 15429\r\n"), text)
    assert(text.ends_with("All done\r\n"), text)
