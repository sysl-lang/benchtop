module sh.sysl.benchtop.chip

import sh.sysl.benchtop.{Board, built_in_shelf, library, load, open_description, unemulated_core_option}
import sh.sysl.benchtop.riscv as rv
import sh.sysl.benchtop.virt.runnable
import sh.sysl.parsing.Span

/** For the description `which` names, a board of RISC-V cores: its SRAM, or why benchtop cannot run
 * it. None where `which` is not such a board, or does not load; the Cortex-M machine reports that.
 */
riscv_named(which: string) -> Option[Result[SramMap, string]]
    val (b, name) = described(which)?
    if !riscv_cores(b) then return None
    Some(riscv_plan(b).map_err(why -> s"$name: $why\n"))

/** For the description `which` names, an RP2350 on its Cortex-M33 cores, which `ArmBoard` runs: its
 * SRAM, or why benchtop cannot run it. None where `which` is not such a board, or does not load.
 */
arm_named(which: string) -> Option[Result[SramMap, string]]
    val (b, name) = described(which)?
    if b.chip.name != "rp2350" then return None
    Some(arm_plan(b).map_err(why -> s"$name: $why\n"))

// The checked board `which` names, and the name its description goes by; None where it does not load
// or check.
private described(which: string) -> Option[(Board, string)]
    val src = open_description(built_in_shelf(), which, "", Span(0, 0)) match
        Ok(s) -> s
        Err(_) -> return None
    val got = load(src, library())
    if got.report.has_errors() then return None
    runnable(got.description) match
        Ok(b) -> Some((b, src.name))
        Err(_) -> None

// Which boards `RiscvBoard` and `ArmBoard` run, decided from a checked description and setting
// nothing: an RP2350 (`rp2350-hazard3` for the two Hazard3 cores, `rp2350` for the two Cortex-M33s),
// its SRAM where the description puts it, and parts that only show a pin (an LED). Everything else on
// such a board is the chip layer's, at the SVD's addresses.

/** Whether `b` is a board of RISC-V cores, which `RiscvBoard` runs rather than the Cortex-M machine. */
riscv_cores(b: Board) -> bool
    for c in b.chip.cores do if rv.model_named(c.name).is_some() then return true
    false

/** The SRAM a RISC-V board runs with, or why benchtop cannot run it. */
riscv_plan(b: Board) -> Result[SramMap, string]
    val chip = b.chip
    if chip.name != "rp2350-hazard3" then return Err(s"benchtop runs RISC-V cores on the RP2350 (`rp2350-hazard3`), and this board's mcu is `${chip.name}`")
    if chip.cores.len() != 2 then return Err("benchtop runs the RP2350's two Hazard3 cores, and this mcu describes another number")
    for c in chip.cores
        if c.name != "hazard3" then return Err(s"benchtop runs the RP2350's Hazard3 cores, not `${c.name}`")
        unemulated_core_option(c) match
            Some(why) -> return Err(why)
            None -> ()
    rp2350_sram(b, false)

/** The SRAM an Arm RP2350 board runs with, or why benchtop cannot run it. The cores are the chip's
 * own (`ArmBoard`), so a core's `fpu`, `dsp`, `security` and `mpu-regions` describe them rather than
 * choose them; the image runs Secure, and no program reaches the MPU yet.
 */
arm_plan(b: Board) -> Result[SramMap, string]
    val chip = b.chip
    if chip.cores.len() != 2 then return Err("benchtop runs the RP2350's two Cortex-M33 cores, and this mcu describes another number")
    for c in chip.cores
        if c.name != "cortex-m33" then return Err(s"benchtop runs the RP2350's Cortex-M33 cores, not `${c.name}`")
        for option in c.options
            val n = option.name
            if n != "fpu" && n != "dsp" && n != "security" && n != "mpu-regions" then return Err(s"benchtop runs the RP2350's own Cortex-M33s, and `${c.name}.$n` is not one of their settings")
    rp2350_sram(b, true)

// The `ram` region of an RP2350 board, refusing a part that does more than show a pin and, on a
// RISC-V board, any device in the description: on an Arm board the description also lists the
// peripherals the checker routes pins for, which are the chip layer's, refused by name where it does
// not run them.
private rp2350_sram(b: Board, arm: bool) -> Result[SramMap, string]
    val chip = b.chip
    for p in b.parts
        if p.kind != "led" then return Err(s"benchtop does not emulate the parts on an RP2350 board yet, and `${p.name}` is a ${p.kind}")
    var sram: Option[SramMap] = None
    for p in chip.peripherals
        p.kind match
            "ram" -> sram = Some(SramMap(u32(p.at.unwrap().n), u32(p.size.unwrap().n)))
            "rom" -> ()
            _ -> if !arm then return Err(s"the RP2350's devices are benchtop's own on a RISC-V board, and `${p.name}` (${p.kind}) is not one of them")
    sram match
        Some(m) -> Ok(m)
        None -> Err(s"the ${chip.name} has no `ram` region")
