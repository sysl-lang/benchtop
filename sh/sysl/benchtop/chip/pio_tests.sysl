module sh.sysl.benchtop.chip
@tests

import sh.sysl.rp2350.accessctrl as ac
import sh.sysl.rp2350.io_bank0 as io
import sh.sysl.rp2350.pads_bank0 as pads
import sh.sysl.rp2350.pio0 as pr
import sh.sysl.rp2350.pio1 as pr1
import sh.sysl.rp2350.pio2 as pr2
import sh.sysl.rp2350.resets as rr
import sysl.buf.{Buf, buf}
import sysl.fmt.hex
import sysl.text.{fields, from_utf8_lossy, parse_ulong_base, split}

// The PIO blocks on the chip, run by clk_sys through `advance`, at register level: pico-examples'
// pio/hello_pio, pio/ws2812 (its bit timing on the pin vector, cycle by cycle), pio/uart_tx (its line
// read back by a UART decoder) and pio/uart_rx (fed a line waveform), and the RP2350-only pair in
// examples/pico2/pio/rp2350_only.pio. The instructions are pioasm's (examples/pico2/pio/*.pio.h) and the
// registers the configuration the SDK's own `sm_config_*` calls build, both as examples/pico2/pio_programs.c
// prints them on the Arm board. The pins are the PIO's vector (`pio_drive`, `pio_pins`), not GPIOs
// through the mux, which is item 14's.

private val PIO_PROGRAMS = embed("../../../../examples/pico2/pio_programs.elf")
private val HELLO_H = embed("../../../../examples/pico2/pio/hello.pio.h")
private val WS2812_H = embed("../../../../examples/pico2/pio/ws2812.pio.h")
private val UART_TX_H = embed("../../../../examples/pico2/pio/uart_tx.pio.h")
private val UART_RX_H = embed("../../../../examples/pico2/pio/uart_rx.pio.h")
private val RP2350_ONLY_H = embed("../../../../examples/pico2/pio/rp2350_only.pio.h")
private val SRAM = SramMap(0x20000000, 520 * 1024)
private const SET: u32 = 0x2000
private const CLR: u32 = 0x3000

private rd(c: *Rp2350, a: u32) -> u32 = c.read(0, a, 4).unwrap()
private wr(c: *Rp2350, a: u32, x: u32) = c.write(0, a, 4, x).unwrap()
private pio_base(k: u32) -> u32 = if k == 0 then pr.BASE elif k == 1 then pr1.BASE else pr2.BASE
private sm_reg(k: u32, s: u32, index: u32) -> u32 = pio_base(k) + pr.SM0_CLKDIV_OFFSET + 0x18 * s + index

/** A program as pio_programs.elf prints it: the registers pio_sm_init writes, and the instructions. */
struct Program
    clkdiv: u32
    execctrl: u32
    shiftctrl: u32
    pinctrl: u32
    words: Buf[u32]

// What examples/pico2/pio_programs.c prints on the Arm board.
private printed() -> string
    val b = arm_board(SRAM)
    b.boot(PIO_PROGRAMS).unwrap()
    var end = RunEnd.Budget
    // About 400 characters at 115200 baud: some 6 million cycles of waiting on UART0.
    for i in 0..<10000
        end = b.run(10000)
        if end != RunEnd.Budget then break
    assert(end == RunEnd.Breakpoint, s"$end ${b.refused}")
    assert(b.finish_sending(), b.refused)
    from_utf8_lossy(b.console.view())

// Program `name` from pio_programs' output.
private program(name: string) -> Program
    for line in split(printed(), "\n")
        val f = fields(line)
        if f.len < 6 || f[0] != name then continue
        val hex = (s: string) -> u32(parse_ulong_base(s, 16).unwrap())
        var words: Buf[u32] = buf()
        for i in 5..<f.len do words.push(hex(f[i]))
        return Program(hex(f[1]), hex(f[2]), hex(f[3]), hex(f[4]), words)
    panic(s"pio_programs printed no $name")

// The chip with PIO0, PIO1 and PIO2 out of reset.
private released() -> Rp2350
    var c = rp2350()
    wr(&c, rr.BASE + rr.RESET_OFFSET + CLR, rr.RESET_PIO0_MASK | rr.RESET_PIO1_MASK | rr.RESET_PIO2_MASK | rr.RESET_IO_BANK0_MASK | rr.RESET_PADS_BANK0_MASK)
    c

// One SDK register write, and the clk_sys cycle the core takes over it.
private sdk_wr(c: *Rp2350, a: u32, x: u32)
    wr(c, a, x)
    c.advance(1)

// The SDK's pio_sm_exec, pinctrl set for it: as pio_sm_set_consecutive_pindirs and
// pio_sm_set_pins_with_mask64 run SET PINDIRS and SET PINS one pin at a time.
private sdk_set(c: *Rp2350, k: u32, s: u32, pin: u32, pindirs: bool, value: u32)
    val pinctrl = rd(c, sm_reg(k, s, 20))
    sdk_wr(c, sm_reg(k, s, 20), (1 << 26) | (pin << 5))
    sdk_wr(c, sm_reg(k, s, 16), 0xe000 | (if pindirs then 0x80 else 0) | value)
    sdk_wr(c, sm_reg(k, s, 20), pinctrl)

// pio_add_program at offset 0, then pio_sm_init(pio, sm, 0, &c) as hardware/pio.c does it.
private sdk_init(c: *Rp2350, k: u32, s: u32, p: Program) = sdk_init_at(c, k, s, p, 0)

// The same at `offset`, as pio_add_program relocates: each JMP's target and the wrap moved by it.
private sdk_init_at(c: *Rp2350, k: u32, s: u32, p: Program, offset: u32)
    for i in 0..<p.words.len()
        val w = p.words[i]
        val placed = if w >> 13 == 0 then (w & ~0x1fu32) | ((w + offset) & 0x1f) else w
        sdk_wr(c, pio_base(k) + pr.INSTR_MEM0_OFFSET + 4 * (u32(i) + offset), placed)
    sdk_wr(c, pio_base(k) + pr.CTRL_OFFSET + CLR, 1 << s)
    sdk_wr(c, sm_reg(k, s, 0), p.clkdiv)
    sdk_wr(c, sm_reg(k, s, 4), p.execctrl + (offset << 12) + (offset << 7))
    sdk_wr(c, sm_reg(k, s, 8), p.shiftctrl)
    sdk_wr(c, sm_reg(k, s, 20), p.pinctrl)
    sdk_wr(c, sm_reg(k, s, 8) + 0x1000, pr.SM0_SHIFTCTRL_FJOIN_RX_MASK)
    sdk_wr(c, sm_reg(k, s, 8) + 0x1000, pr.SM0_SHIFTCTRL_FJOIN_RX_MASK)
    sdk_wr(c, pio_base(k) + pr.FDEBUG_OFFSET, 0x01010101 << s)
    sdk_wr(c, pio_base(k) + pr.CTRL_OFFSET + SET, 1 << (4 + s))
    sdk_wr(c, pio_base(k) + pr.CTRL_OFFSET + SET, 1 << (8 + s))
    sdk_wr(c, sm_reg(k, s, 16), offset)

private pin(c: *Rp2350, k: u32, n: u32) -> bool = (c.pio_pins(k).0 >> n) & 1 != 0

@test("examples/pico2/pio_programs.c on the Arm Pico 2: each program as pioasm assembled it, with the registers its pico-examples init has the SDK compute")
pio_programs_printed()
    val text = printed()
    // ws2812's divisor is 18.0, not 18.75: the example divides clock_get_hz's integer by an integer
    // before the float is made, so the LEDs are clocked at 833 kHz on silicon too.
    val want = "hello 00010000 00002000 000c0000 00100019 80a0 6001 0000\r\n" +
        "ws2812 00120000 00003000 70060000 20000800 6321 1223 1200 a242\r\n" +
        "uart_tx 00a2c300 40003000 400c0000 40100000 9fa0 f727 6001 0642\r\n" +
        "uart_rx 00a2c300 03008000 800c0000 00018000 2020 ea27 4001 0642 00c8 c014 20a0 0000 8020\r\n" +
        "table 00010000 06007000 000c8000 00400008 80a0 a0cf 8010 a0d7 801b 20e1 a06b c002\r\n" +
        "follower 00010000 00002000 000c0000 04000180 20ca e001 c01b\r\n"
    assert(text == want, text)
    // The words are pioasm's, line for line as the committed headers have them.
    for (name, header) in [("hello", HELLO_H), ("ws2812", WS2812_H), ("uart_tx", UART_TX_H), ("uart_rx", UART_RX_H), ("table", RP2350_ONLY_H), ("follower", RP2350_ONLY_H)]
        val h = from_utf8_lossy(header)
        val p = program(name)
        for i in 0..<p.words.len()
            val line = s"    0x${hex(p.words[i], 4)}, // ${if i < 10 then " " else ""}$i: "
            assert(h.contains(line), s"$name: $line")

// State machine `s` of block `k` on, as pio_sm_set_enabled writes CTRL.
private sdk_enable(c: *Rp2350, k: u32, s: u32) = sdk_wr(c, pio_base(k) + pr.CTRL_OFFSET, rd(c, pio_base(k) + pr.CTRL_OFFSET) | (1 << s))

@test("pico-examples' pio/hello_pio: each word the SDK puts in the TX FIFO reaches pin 25 two cycles later, through PULL and OUT PINS, the pin an output from pio_sm_set_consecutive_pindirs")
pio_hello()
    var c = released()
    sdk_set(&c, 0, 0, 25, true, 1)
    sdk_init(&c, 0, 0, program("hello"))
    sdk_enable(&c, 0, 0)
    c.advance(10)
    assert(c.pio_pins(0).1 == 1 << 25 && !pin(&c, 0, 25))
    assert(rd(&c, pr.BASE + pr.FDEBUG_OFFSET) == 0x01000000, "stalled on its PULL: TXSTALL")
    for level in [1u32, 0, 1, 1, 0]
        val before = pin(&c, 0, 25)
        wr(&c, pr.BASE + pr.TXF0_OFFSET, level)
        c.advance(1)
        assert(pin(&c, 0, 25) == before, "the PULL in the next cycle")
        c.advance(1)
        assert(pin(&c, 0, 25) == (level == 1), "the OUT in the one after")
        c.advance(100)

// The clk_sys cycle of the `k`th fire of a divider of `d` / 256 restarted at cycle `t0`.
private fire(t0: u64, d: u64, k: u64) -> u64 = t0 + (k * d + 255) / 256

// Whether ws2812's pin is high in cycle `t`, for the bits of `grb` (most significant first), the first
// OUT executing on fire `c0`: low through the OUT [3], high from the JMP !X side 1, low again from the NOP
// side 0 of a 0 or the next OUT of a 1.
private ws2812_high(t: u64, t0: u64, d: u64, c0: u64, grb: u32) -> bool
    for i in 0u64..<24
        val one = (grb >> (23 - u32(i))) & 1 != 0
        if t >= fire(t0, d, c0 + 10 * i + 4) && t < fire(t0, d, c0 + 10 * i + (if one then 10 else 7)) then return true
    false

// ws2812 initialised and enabled as pico-examples' ws2812_program_init does: answers the chip and the
// cycle of its CLKDIV_RESTART.
private ws2812() -> (Rp2350, u64)
    var c = released()
    val p = program("ws2812")
    sdk_set(&c, 0, 0, 2, true, 1)
    sdk_init(&c, 0, 0, p)
    // sdk_init's last two writes, a cycle each, follow the CLKDIV_RESTART.
    val t0 = c.now - 2
    sdk_enable(&c, 0, 0)
    (c, t0)

@test("pico-examples' pio/ws2812: one pixel's 24 bits on pin 2, cycle by cycle at the SDK's divisor 18.0: a 1 high for 6 state-machine cycles (108 clk_sys cycles), a 0 for 3 (54), 10 to a bit (180); low after; the same whether the chip runs a cycle or 13 at a time")
pio_ws2812()
    val grb: u32 = 0xa53c0f
    for step in [1u64, 13]
        var (c, t0) = ws2812()
        val d: u64 = 18 * 256
        c.advance(500)
        assert(!pin(&c, 0, 2) && rd(&c, pr.BASE + pr.FDEBUG_OFFSET) == 0x01000000, "stalled on autopull, its side-set 0")
        val tw = c.now
        // put_pixel: pio_sm_put_blocking(pio, sm, pixel_grb << 8u).
        wr(&c, pr.BASE + pr.TXF0_OFFSET, grb << 8)
        // The OUT tries on the next fire and stalls while the refill comes in at its end; it runs on the fire after.
        var a: u64 = 0
        while fire(t0, d, a) <= tw do a += 1
        val c0 = a + 1
        val end = fire(t0, d, c0 + 240) + 100
        var rises: Buf[u64] = buf()
        var highs: Buf[u64] = buf()
        var last = false
        var rose: u64 = 0
        while c.now < end
            c.advance(step)
            val t = c.now
            val level = pin(&c, 0, 2)
            assert(level == ws2812_high(t, t0, d, c0, grb), s"step $step: cycle ${t - tw} after the write: $level")
            if step == 1 && level && !last
                rises.push(t)
                rose = t
            if step == 1 && !level && last then highs.push(t - rose)
            last = level
        if step == 1
            assert(rises.len() == 24 && highs.len() == 24)
            for i in 0u32..<24
                val one = (grb >> (23 - i)) & 1 != 0
                assert(highs[i] == (if one then 108u64 else 54), s"bit $i high for ${highs[i]}")
                if i > 0 then assert(rises[i] - rises[i - 1] == 180, s"bit $i")
        assert(rd(&c, pr.BASE + pr.FLEVEL_OFFSET) == 0 && !pin(&c, 0, 2), "the reset code: low, stalled for the next pixel")

// A UART line read back: the bytes, sampled mid-bit at `bit256` / 256 cycles a bit from each falling edge.
private uart_decode(line: Buf[bool], bit256: u64) -> string
    var out = ""
    var i: u64 = 1
    while i < line.len()
        if line[i] || !line[i - 1]
            i += 1
            continue
        val at = (k: u64) -> line[i + (k * bit256 + bit256 / 2) / 256]
        assert(!at(0), s"a start bit at $i")
        var byte: u32 = 0
        for j in 0u64..<8 do if at(1 + j) then byte |= 1 << u32(j)
        assert(at(9), s"the stop bit of 0x${hex(byte, 2)}")
        out = out + from_utf8_lossy([u8(byte)])
        i += (9 * bit256 + bit256 / 2) / 256
    out

@test("pico-examples' pio/uart_tx: \"Hello, world! (from PIO!)\" put a character at a time as uart_tx_program_puts does, read back off pin 0 by a UART receiver at 115200 baud from the SDK's divisor 162.76: 8N1, idle high")
pio_uart_tx()
    // At offset 0, and at 28 where pio_add_program puts it, its JMP relocated and its wrap at the top.
    for offset in [0u32, 28]
        var c = released()
        val p = program("uart_tx")
        sdk_set(&c, 0, 0, 0, false, 1)
        sdk_set(&c, 0, 0, 0, true, 1)
        sdk_init_at(&c, 0, 0, p, offset)
        sdk_enable(&c, 0, 0)
        val text = "Hello, world! (from PIO!)\r\n"
        var line: Buf[bool] = buf()
        var next: usize = 0
        var idle = 0
        while idle < 3000
            if next < text.len && rd(&c, pr.BASE + pr.FSTAT_OFFSET) & (1 << 16) == 0
                wr(&c, pr.BASE + pr.TXF0_OFFSET, u32(text.bytes[next]))
                next += 1
            c.advance(1)
            line.push(pin(&c, 0, 0))
            idle = if next == text.len && pin(&c, 0, 0) && rd(&c, pr.BASE + pr.FLEVEL_OFFSET) == 0 then idle + 1 else 0
        // 8 state machine cycles a bit at 162 + 195/256.
        val got = uart_decode(line, 8 * u64(p.clkdiv >> 8))
        assert(got == text, s"at $offset: $got")
    // GPIO 0 given to PIO0 through the mux and run 1000 cycles at a time, the line read off the edges.
    var c = released()
    val p = program("uart_tx")
    // pio_gpio_init: the pad's input on, its output and isolation off, FUNCSEL PIO2, where the SDK's
    // pio_claim_free_sm_and_add_program_for_gpio_range puts it.
    wr(&c, pads.BASE + pads.GPIO0_OFFSET + SET, pads.GPIO0_IE_MASK)
    wr(&c, pads.BASE + pads.GPIO0_OFFSET + CLR, pads.GPIO0_OD_MASK)
    wr(&c, io.BASE + io.GPIO0_CTRL_OFFSET, 8)
    wr(&c, pads.BASE + pads.GPIO0_OFFSET + CLR, pads.GPIO0_ISO_MASK)
    c.capture_edges(1)
    sdk_set(&c, 2, 0, 0, false, 1)
    sdk_set(&c, 2, 0, 0, true, 1)
    sdk_init_at(&c, 2, 0, p, 28)
    sdk_enable(&c, 2, 0)
    val text = "Hello, world! (from PIO!)\r\n"
    val from = c.now
    var next: usize = 0
    while next < text.len || rd(&c, pr2.BASE + pr.FLEVEL_OFFSET) != 0
        while next < text.len && rd(&c, pr2.BASE + pr.FSTAT_OFFSET) & (1 << 16) == 0
            wr(&c, pr2.BASE + pr.TXF0_OFFSET, u32(text.bytes[next]))
            next += 1
        c.advance(1000)
    c.advance(40000)
    var line: Buf[bool] = buf()
    var level = true
    var k: usize = 0
    for t in from..<c.now
        while k < c.pin_edges.len() && c.pin_edges[k].cycle < t
            level = c.pin_edges[k].level
            k += 1
        line.push(level)
    val got = uart_decode(line, 8 * u64(p.clkdiv >> 8))
    assert(got == text, s"through the mux: $got")

// Drive GPIO 3 as a UART line at 115200 baud from 150 MHz for `bits` (LSB first after a start bit, then
// a stop bit at `stop`), from bit edge `at` of a free-running bit clock; answers the next edge.
private send(c: *Rp2350, at: u64, byte: u32, stop: bool) -> u64
    var k = at
    for j in 0u32..<10
        val level = if j == 0 then false elif j == 9 then stop else (byte >> (j - 1)) & 1 != 0
        c.pio_drive(if level then 1u64 << 3 else 0)
        k += 1
        c.catch_up(k * 150000000 / 115200)
    k

@test("pico-examples' pio/uart_rx: bytes on a line waveform driven onto GPIO 3 at 115200 baud arrive in the RX FIFO's top byte, read as uart_rx_program_getc does; a framing error raises IRQ 4 and pushes nothing, and the line's return to idle lets the next byte in")
pio_uart_rx()
    var c = released()
    c.pio_drive(1 << 3)
    sdk_set(&c, 0, 0, 3, true, 0)
    sdk_init(&c, 0, 0, program("uart_rx"))
    sdk_enable(&c, 0, 0)
    var k = c.now * 115200 / 150000000 + 2
    c.catch_up(k * 150000000 / 115200)
    var got = ""
    for ch in "PIO!".bytes
        k = send(&c, k, u32(ch), true)
        k += 1
        c.catch_up(k * 150000000 / 115200)
        assert(rd(&c, pr.BASE + pr.FSTAT_OFFSET) & (1 << 8) == 0, "a byte in the FIFO")
        got = got + from_utf8_lossy([u8(c.read(0, pr.BASE + pr.RXF0_OFFSET + 3, 1).unwrap())])
    assert(got == "PIO!", got)
    // 0x55 with its stop bit low: a framing error.
    k = send(&c, k, 0x55, false)
    k += 1
    c.catch_up(k * 150000000 / 115200)
    assert(rd(&c, pr.BASE + pr.IRQ_OFFSET) == 0x10 && rd(&c, pr.BASE + pr.INTR_OFFSET) & (1 << 12) != 0, "IRQ 4 (REL from SM0)")
    assert(rd(&c, pr.BASE + pr.FLEVEL_OFFSET) == 0, "nothing pushed")
    c.pio_drive(1 << 3)
    k += 2
    c.catch_up(k * 150000000 / 115200)
    wr(&c, pr.BASE + pr.IRQ_OFFSET, 0x10)
    k = send(&c, k, u32('k'), true)
    k += 1
    c.catch_up(k * 150000000 / 115200)
    assert(c.read(0, pr.BASE + pr.RXF0_OFFSET + 3, 1).unwrap() == u32('k'))

@test("the RP2350-only pair: MOV to RX FIFO entries read through RXF0_PUTGETn, WAIT JMPPIN + 1, MOV PINDIRS, IRQ set and WAIT IRQ PREV across PIO0 and PIO1, IRQ NEXT into PIO2, cycle by cycle; then with GPIOBASE 16")
pio_rp2350_only()
    for base in [0u32, 16]
        var c = released()
        if base != 0 then wr(&c, pr.BASE + pr.GPIOBASE_OFFSET, base)
        sdk_init(&c, 0, 0, program("table"))
        sdk_init(&c, 1, 0, program("follower"))
        sdk_enable(&c, 0, 0)
        sdk_enable(&c, 1, 0)
        wr(&c, pr.BASE + pr.TXF0_OFFSET, 0x12345678)
        c.advance(10)
        assert(rd(&c, pr.BASE + pr.RXF0_PUTGET0_OFFSET) == 0xedcba987 && rd(&c, pr.BASE + pr.RXF0_PUTGET3_OFFSET) == 0x1e6a2c48, "inverted into entry Y (0), reversed into entry 3")
        assert(rd(&c, sm_reg(0, 0, 12)) == 5, "waiting on JMP pin + 1")
        // The state machine's pin 7: GPIO 7, or 23 above GPIOBASE 16.
        c.pio_drive(1u64 << (7 + u64(base)))
        c.advance(2)
        assert(rd(&c, sm_reg(0, 0, 12)) == 5, "through the synchroniser")
        c.advance(1)
        assert(rd(&c, sm_reg(0, 0, 12)) == 6)
        c.advance(1)
        assert(c.pio_pins(0).1 == 0xf00 && rd(&c, pr.BASE + pr.DBG_PADOE_OFFSET) == 0xf00, "OUT pins 8–11 outputs")
        c.advance(1)
        assert(rd(&c, pr.BASE + pr.IRQ_OFFSET) == 4, "flag 2 at the end of the IRQ's cycle")
        c.advance(1)
        assert(rd(&c, pr.BASE + pr.IRQ_OFFSET) == 0, "PIO1 saw it on its next cycle and cleared it")
        c.advance(1)
        assert(pin(&c, 1, 12))
        assert(rd(&c, pr2.BASE + pr.IRQ_OFFSET) == 0)
        c.advance(1)
        assert(rd(&c, pr2.BASE + pr.IRQ_OFFSET) == 8, "PIO2's flag 3")
        if base == 0
            // GPIO 23 means nothing to PIO0 below GPIOBASE 16.
            var low = released()
            sdk_init(&low, 0, 0, program("table"))
            sdk_enable(&low, 0, 0)
            wr(&low, pr.BASE + pr.TXF0_OFFSET, 1)
            low.pio_drive(1 << 23)
            low.advance(20)
            assert(rd(&low, sm_reg(0, 0, 12)) == 5)

@test("on the chip: PIO0–2 behind their RESETS bits, back at power-on when reset; a reserved instruction stops the run through take_line_fault; refusals named with the block and offset; FUNCSEL PIO accepted; ACCESSCTRL disconnects a Non-secure block from its neighbours")
pio_on_chip()
    var c = rp2350()
    assert(c.read(0, pr1.BASE + pr.CTRL_OFFSET, 4) == Err("PIO1 is held in reset (RESETS bit 12): release it before touching 0x50300000"))
    c = released()
    wr(&c, pr.BASE + pr.INSTR_MEM0_OFFSET, 0xa042)
    wr(&c, pr.BASE + pr.CTRL_OFFSET, 1)
    c.advance(5)
    assert(rd(&c, pr.BASE + pr.CTRL_OFFSET) == 1 && c.pio.running)
    wr(&c, rr.BASE + rr.RESET_OFFSET + SET, rr.RESET_PIO0_MASK)
    wr(&c, rr.BASE + rr.RESET_OFFSET + CLR, rr.RESET_PIO0_MASK)
    assert(rd(&c, pr.BASE + pr.CTRL_OFFSET) == 0 && !c.pio.running, "power-on again")
    wr(&c, sm_reg(0, 2, 16), 0xe060)
    c.advance(1)
    assert(c.take_line_fault() == Some("PIO0 SM2 at 0: instruction 0xe060: SET destination 3 is reserved"))
    assert(c.take_line_fault() == None)
    assert(c.write(0, sm_reg(0, 0, 20), 4, 6 << 29) == Err("PIO0 + 0xdc: SM0_PINCTRL.SIDESET_COUNT 6 is more than 5"))
    assert(c.write(0, pr1.BASE + pr.TXF0_OFFSET + SET, 4, 1) == Err("PIO1 + 0x2010 cannot be written through an atomic alias"))
    assert(c.read(0, pr2.BASE + pr.TXF1_OFFSET, 4) == Err("PIO2 + 0x14: TXF1 is write-only: what a read returns is not modelled"))
    assert(c.write(0, io.BASE + io.GPIO25_CTRL_OFFSET, 4, 6) == Ok(()), "FUNCSEL PIO0 reaches the mux")
    // PIO1 reachable from Non-secure code: PIO0's NEXT operations stop at it.
    wr(&c, ac.BASE + ac.PIO1_OFFSET, 0xacce00ff)
    assert(c.pio.ns == 2)
    wr(&c, pr.BASE + pr.CTRL_OFFSET, (1 << 20) | pr.CTRL_NEXTPREV_SM_ENABLE_MASK)
    assert(rd(&c, pr1.BASE + pr.CTRL_OFFSET) == 0)
    wr(&c, ac.BASE + ac.PIO1_OFFSET, 0xacce00fc)
    wr(&c, pr.BASE + pr.CTRL_OFFSET, (1 << 20) | pr.CTRL_NEXTPREV_SM_ENABLE_MASK)
    assert(c.pio.ns == 0 && rd(&c, pr1.BASE + pr.CTRL_OFFSET) == 1)
