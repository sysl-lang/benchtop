module sh.sysl.benchtop.chip
@tests

import sh.sysl.benchtop.{library, load}
import sh.sysl.benchtop.riscv as rv
import sh.sysl.parsing.source_of
import sh.sysl.rp2350.io_bank0 as io_reg
import sh.sysl.rp2350.io_qspi as io_qspi_reg
import sh.sysl.rp2350.pads_bank0 as pads_reg
import sh.sysl.rp2350.pads_qspi as pads_qspi_reg
import sh.sysl.rp2350.psm as psm_reg
import sh.sysl.rp2350.resets as resets_reg
import sh.sysl.rp2350.sio as sio_reg
import sh.sysl.rp2350.uart0 as uart0_reg
import sysl.fmt.hex
import sysl.text.from_utf8_lossy

private val BLINK = embed("../../../../examples/pico2-riscv/blink.elf")

private val PICO2_SRAM = SramMap(0x20000000, 520 * 1024)

@test("a Pico 2 on its Hazard3 cores runs blink.elf: UART0 prints, core 1 launches through the boot ROM and drives GP15, GP25 blinks")
riscv_blink()
    val b = riscv_board(PICO2_SRAM)
    b.boot(BLINK).unwrap()
    assert(b.started[1] && b.harts[1].pc == RISCV_RESET_VECTOR, "core 1 starts in the boot ROM, at the Hazard3 reset vector")
    var lit = 0
    var was = false
    var end = RunEnd.Budget
    // Sample the LED every 0.1 ms of clk_sys at 150 MHz.
    while end == RunEnd.Budget && b.chip.now < 200000000
        end = b.run(15000)
        val led = b.chip.pin(25)
        if led.drives && led.level && !was then lit += 1
        was = led.drives && led.level
    assert(end == RunEnd.Breakpoint, s"${b.refused}")
    val text = from_utf8_lossy(b.console.view())
    assert(text == "hello from hazard3\ncore 1 launched\nled on\nled off\nled on\nled off\nled on\nled off\ndone\n", text)
    assert(lit == 3, s"the LED lit $lit times")
    assert(b.started[1] && b.chip.pin(15).drives && b.chip.pin(15).level, "core 1 drives GP15 high")
    assert(!b.chip.pin(25).level, "the LED ends off")
    assert(b.chip.sys_hz() == 150000000 && b.chip.ref_hz() == 12000000, "the PLL and crystal clock the chip")
    // Six 10 ms sleeps at 150 MHz: at least 9 M cycles of clk_sys, most of them skipped asleep.
    assert(b.chip.now >= 9000000 && b.chip.now < 12000000, s"${b.chip.now} cycles")
    assert(b.harts[0].retired < 1000000, s"hart 0 slept through its delays: ${b.harts[0].retired} retired")

@test("a guest's access to a block held in reset ends the run with the chip's reason, at the hart's PC")
riscv_refused_access()
    val b = riscv_board(PICO2_SRAM)
    b.boot(BLINK).unwrap()
    // lui t0, 0x40028; lw t1, 4(t0); ebreak — IO_BANK0's GPIO0_CTRL, still held in reset.
    val code = [0x400282B7u32, 0x0042A303, 0x00100073]
    for i in 0..<3
        for j in 0..<4 do b.sram.set(4 * i + j, u8.wrap(code[i] >> (8 * u32(j))))
    rv.forget_code(&b.harts[0])
    assert(b.run(1000) == RunEnd.Fault)
    assert(b.refused == "hart 0 at pc 0x20000004: IO_BANK0 is held in reset (RESETS bit 6): release it before touching 0x40028004", b.refused)

@test("pico2-riscv is a RISC-V board with the RP2350's SRAM; Cortex-M boards are not; another RISC-V chip is refused by name")
riscv_plans()
    val m = riscv_named("pico2-riscv").unwrap().unwrap()
    assert(m.base == 0x20000000 && m.size == 520 * 1024)
    assert(riscv_named("pico2").is_none() && riscv_named("virt").is_none())
    val text = "board { name = b, mcu = rp2350-hazard3 }"
    val got = load(source_of("b.hocon", text), library())
    assert(!got.report.has_errors(), got.report.render(source_of("b.hocon", text)))
    var b = got.description.board
    assert(riscv_cores(b) && riscv_plan(b).is_ok())
    b.chip.name = "m"
    assert(riscv_plan(b).unwrap_err().contains("`m`"))

@test("the chip refuses a block held in reset, an address nothing answers, and the ROM, naming each")
riscv_refusals()
    var c = rp2350()
    val held = c.read(0, io_reg.BASE + io_reg.GPIO0_CTRL_OFFSET, 4)
    assert(held.is_err() && held.unwrap_err().contains("IO_BANK0 is held in reset"), held.unwrap_err())
    assert(c.read(0, 0x00000010, 4).unwrap_err().contains("not on the RP2350's bus"))
    assert(c.read(0, 0x40fff000, 4).is_err())
    c.write(0, resets_reg.BASE + 0x3000 + resets_reg.RESET_OFFSET, 4, resets_reg.RESET_IO_BANK0_MASK).unwrap()
    assert(c.read(0, resets_reg.BASE + resets_reg.RESET_DONE_OFFSET, 4).unwrap() & resets_reg.RESET_IO_BANK0_MASK != 0)
    assert(c.read(0, io_reg.BASE + io_reg.GPIO0_CTRL_OFFSET, 4).unwrap() == io_reg.GPIO0_CTRL_FUNCSEL_NULL)
    val unmapped = c.read(0, io_reg.BASE + 0x200, 4)
    assert(unmapped.unwrap_err().contains("IO_BANK0 + 0x200"), unmapped.unwrap_err())

@test("asserting a block's reset puts it back as at power-on")
reset_fanout()
    var c = rp2350()
    val clr = resets_reg.BASE + 0x3000 + resets_reg.RESET_OFFSET
    val set = resets_reg.BASE + 0x2000 + resets_reg.RESET_OFFSET
    c.write(0, clr, 4, resets_reg.RESET_UART0_MASK).unwrap()
    c.write(0, uart0_reg.BASE + uart0_reg.UARTIBRD_OFFSET, 4, 81).unwrap()
    c.write(0, set, 4, resets_reg.RESET_UART0_MASK).unwrap()
    assert(c.read(0, uart0_reg.BASE, 4).is_err(), "held again")
    assert(c.read(0, resets_reg.BASE + resets_reg.RESET_DONE_OFFSET, 4).unwrap() & resets_reg.RESET_UART0_MASK == 0, "RESET_DONE falls")
    c.write(0, clr, 4, resets_reg.RESET_UART0_MASK).unwrap()
    assert(c.read(0, uart0_reg.BASE + uart0_reg.UARTIBRD_OFFSET, 4).unwrap() == 0, "the divisor is gone")

@test("CPUID answers the core, and a pin drives only once IO_BANK0 selects SIO and its pad leaves isolation")
pins_and_cpuid()
    var c = rp2350()
    assert(c.read(0, sio_reg.BASE + sio_reg.CPUID_OFFSET, 4).unwrap() == 0 && c.read(1, sio_reg.BASE + sio_reg.CPUID_OFFSET, 4).unwrap() == 1)
    c.write(0, resets_reg.BASE + 0x3000, 4, resets_reg.RESET_IO_BANK0_MASK | resets_reg.RESET_PADS_BANK0_MASK).unwrap()
    c.write(0, sio_reg.BASE + sio_reg.GPIO_OE_SET_OFFSET, 4, 1 << 25).unwrap()
    c.write(0, sio_reg.BASE + sio_reg.GPIO_OUT_SET_OFFSET, 4, 1 << 25).unwrap()
    assert(!c.pin(25).drives, "IO_BANK0 still selects NULL")
    c.write(0, io_reg.BASE + io_reg.GPIO25_CTRL_OFFSET, 4, io_reg.GPIO25_CTRL_FUNCSEL_SIO_25).unwrap()
    assert(!c.pin(25).drives, "the pad is isolated: the RP2350's power-on state")
    c.write(0, pads_reg.BASE + 0x3000 + pads_reg.GPIO25_OFFSET, 4, pads_reg.GPIO25_ISO_MASK).unwrap()
    assert(c.pin(25).drives && c.pin(25).level)
    assert(c.read(0, io_reg.BASE + io_reg.GPIO25_STATUS_OFFSET, 4).unwrap() & (io_reg.GPIO25_STATUS_OUTTOPAD_MASK | io_reg.GPIO25_STATUS_OETOPAD_MASK)
        == io_reg.GPIO25_STATUS_OUTTOPAD_MASK | io_reg.GPIO25_STATUS_OETOPAD_MASK)
    assert(c.read(0, sio_reg.BASE + sio_reg.GPIO_IN_OFFSET, 4).unwrap() & (1 << 25) == 0, "IE is clear at power-on, so the input reads 0")
    c.write(0, pads_reg.BASE + 0x2000 + pads_reg.GPIO25_OFFSET, 4, pads_reg.GPIO25_IE_MASK).unwrap()
    assert(c.read(1, sio_reg.BASE + sio_reg.GPIO_IN_OFFSET, 4).unwrap() & (1 << 25) != 0, "both cores read the pin")
    // OUTOVER LOW wins over SIO's high.
    c.write(0, io_reg.BASE + 0x2000 + io_reg.GPIO25_CTRL_OFFSET, 4, io_reg.GPIO25_CTRL_OUTOVER_LOW << io_reg.GPIO25_CTRL_OUTOVER_SHIFT).unwrap()
    assert(c.pin(25).drives && !c.pin(25).level)

@test("the QSPI bank's pins and the OTP's read windows sit at their datasheet bases: the pins behind their RESETS bits, which the boards' boot releases; the OTP reads blank and refuses a write, and its control block, by name")
chip_rom_blocks()
    var c = rp2350()
    val pads = pads_qspi_reg.BASE + pads_qspi_reg.GPIO_QSPI_SCLK_OFFSET
    assert(c.read(0, pads, 4).unwrap_err().contains("PADS_QSPI is held in reset"), c.read(0, pads, 4).unwrap_err())
    assert(c.read(0, io_qspi_reg.BASE + io_qspi_reg.GPIO_QSPI_SS_CTRL_OFFSET, 4).unwrap_err().contains("IO_QSPI is held in reset"))
    c.rom_boot_releases()
    assert(c.read(0, pads, 4).unwrap() == 0x156 && c.read(0, io_qspi_reg.BASE + io_qspi_reg.GPIO_QSPI_SS_CTRL_OFFSET, 4).unwrap() == 0x1F)
    assert(c.resets.held == 0x1FFFFFFF & ~(resets_reg.RESET_IO_QSPI_MASK | resets_reg.RESET_PADS_QSPI_MASK), "nothing else released")
    c.write(0, pads + 0x2000, 4, 0x1).unwrap()
    assert(c.read(0, pads, 4).unwrap() == 0x157, "the SET alias")
    // Held again, the pads go back to their reset values.
    c.write(0, resets_reg.BASE + 0x2000, 4, resets_reg.RESET_PADS_QSPI_MASK).unwrap()
    c.rom_boot_releases()
    assert(c.read(0, pads, 4).unwrap() == 0x156)
    assert(c.read(0, io_qspi_reg.BASE + io_qspi_reg.GPIO_QSPI_SS_STATUS_OFFSET, 4).unwrap_err() == "IO_QSPI + 0x18 is not a register benchtop runs")
    for base in [0x40130000u32, 0x40134000, 0x40138000, 0x4013C000]
        assert(c.read(0, base, 4).unwrap() == 0 && c.read(0, base + 0x1FFC, 4).unwrap() == 0, s"0x${hex(base)}")
        val w = c.write(0, base, 4, 0)
        assert(w.unwrap_err().contains("read-only") && w.unwrap_err().contains("item 26"), w.unwrap_err())
    assert(c.read(0, 0x40132000, 4).unwrap_err() == "OTP_DATA + 0x2000 is not a register benchtop runs", "past the ECC window's 4096 rows")
    assert(c.read(0, 0x40137FFC, 4).unwrap() == 0, "the raw window's last row")
    assert(c.read(0, 0x40120000, 4).unwrap_err().contains("not on the RP2350's bus"), "the OTP's control block is rp-coverage item 26")

@test("the chip answers nothing for the boot ROM: core 1's FIFO keeps what core 0 sends, and PSM's hold and release are the board's to act on")
chip_runs_no_rom()
    var c = rp2350()
    val wr = sio_reg.BASE + sio_reg.FIFO_WR_OFFSET
    val rd = sio_reg.BASE + sio_reg.FIFO_RD_OFFSET
    c.write(0, wr, 4, 0).unwrap()
    c.write(0, wr, 4, 9).unwrap()
    assert(c.read(0, sio_reg.BASE + sio_reg.FIFO_ST_OFFSET, 4).unwrap() & sio_reg.FIFO_ST_VLD_MASK == 0, "no echo")
    assert(c.read(1, rd, 4).unwrap() == 0 && c.read(1, rd, 4).unwrap() == 9)
    val off = psm_reg.BASE + psm_reg.FRCE_OFF_OFFSET
    c.write(0, off + 0x2000, 4, psm_reg.FRCE_OFF_PROC1_MASK).unwrap()
    assert(c.take_core1_reset() && !c.take_core1_release())
    c.write(0, off + 0x3000, 4, psm_reg.FRCE_OFF_PROC1_MASK).unwrap()
    assert(!c.take_core1_reset() && c.take_core1_release() && !c.take_core1_release(), "one release, reported once")
