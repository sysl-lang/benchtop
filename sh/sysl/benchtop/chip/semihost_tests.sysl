module sh.sysl.benchtop.chip
@tests

import sh.sysl.benchtop.v6m as arm
import sh.sysl.benchtop.v6m.Stop
import sh.sysl.rp2350.clocks as clk
import sh.sysl.rp2350.resets as rr
import sh.sysl.rp2350.uart0 as ur
import sh.sysl.rp2350.uart1 as ur1
import sysl.buf.{Buf, buf}
import sysl.fs.{make_temp_dir, read_bytes, remove_dir_all}
import sysl.text.from_utf8_lossy

// Semihosting (`BKPT 0xAB`, v6m/semihost.sysl) and a UART's output sent to a file, on the Pico 2's
// Cortex-M33s and the Pico's Cortex-M0+s, under both executors, driven the way a guest drives them: a
// call's number in R0 and its argument in R1.

private val SEMI_PICO2 = embed("../../../../examples/pico2/blink.elf")
private val SEMI_PICO = embed("../../../../examples/pico/blink.elf")

private const CODE: u32 = 0x20030000
private const DATA: u32 = 0x20032000
private const EXIT_OK: u32 = 0x20026

private const WRITEC: u32 = 3
private const WRITE0: u32 = 4
private const WRITE: u32 = 5
private const OPEN: u32 = 1
private const CLOSE: u32 = 2
private const EXIT: u32 = 0x18
private const EXIT_EXTENDED: u32 = 0x20

private semi_options(on: bool) -> ArmOptions
    var o = arm_options()
    o.semihosting = on
    o

private semi_pico2(on: bool) -> &ArmBoard
    val b = arm_board(SramMap(0x20000000, 520 * 1024))
    b.apply_options(semi_options(on))
    b.boot(SEMI_PICO2).unwrap()
    b

private semi_pico(on: bool) -> &ArmBoard[Rp2040]
    val b = pico_board(SramMap(0x20000000, 264 * 1024))
    b.apply_options(semi_options(on))
    b.boot(SEMI_PICO).unwrap()
    b

private put32(c: *arm.Cpu, at: u32, x: u32) = arm.store32(c, at, x)

// The NUL-terminated `text` at `at`.
private put_text(c: *arm.Cpu, at: u32, text: string)
    for i in 0..<text.bytes.len do arm.store8(c, at + u32(i), u32(text.bytes[i]))
    arm.store8(c, at + u32(text.bytes.len), 0)

// Core `k` makes the call `op` with `arg`: `BKPT 0xAB` then `BKPT 0`, run to a stop under `exec`. Answers R0.
private call[C: ArmChip](b: &ArmBoard[C], k: usize, exec: *extern(*arm.Cpu) -> unit, op: u32, arg: u32) -> u32
    val c = &b.cores[k]
    arm.store16(c, CODE, 0xBEAB)
    arm.store16(c, CODE + 2, 0xBE00)
    c.r[0] = op
    c.r[1] = arg
    c.pc = CODE
    c.stop = Stop.Running
    c.sleeping = false
    var rounds = 0
    while c.stop == Stop.Running && rounds < 100
        arm.set_limit(c, c.retired + 1000)
        exec(c)
        rounds += 1
    c.r[0]

private console_of[C: ArmChip](b: &ArmBoard[C]) -> string = from_utf8_lossy(b.console.view())

private exits_with[C: ArmChip](b: &ArmBoard[C], k: usize, exec: *extern(*arm.Cpu) -> unit, op: u32, arg: u32, want: u32)
    val c = &b.cores[k]
    call(b, k, exec, op, arg)
    assert(c.stop == Stop.Exit && c.exit_code == want, s"call $op: ${c.stop}, status ${c.exit_code}, wanted $want")

private writes_text[C: ArmChip](b: &ArmBoard[C], exec: *extern(*arm.Cpu) -> unit)
    val c = &b.cores[0]

    put_text(c, DATA, "hi\n")
    assert(call(b, 0, exec, WRITE0, DATA) == 0xDEADBEEF && c.stop == Stop.Breakpoint && c.stop_at == CODE + 2 && c.retired == 1, "SYS_WRITE0 runs on")
    assert(console_of(b) == "hi\n", console_of(b))

    arm.store8(c, DATA, u32('Z'))
    call(b, 0, exec, WRITEC, DATA)
    assert(c.stop == Stop.Breakpoint && console_of(b) == "hi\nZ", console_of(b))

    // SYS_OPEN of ":tt" for writing, then SYS_WRITE through the descriptor it answers.
    put_text(c, DATA + 0x100, ":tt")
    put32(c, DATA + 0x200, DATA + 0x100)
    put32(c, DATA + 0x204, 4)
    put32(c, DATA + 0x208, 3)
    val fd = call(b, 0, exec, OPEN, DATA + 0x200)
    assert(fd == 1, s"fd $fd")
    put_text(c, DATA + 0x300, "abcdef")
    put32(c, DATA + 0x400, fd)
    put32(c, DATA + 0x404, DATA + 0x300)
    put32(c, DATA + 0x408, 6)
    assert(call(b, 0, exec, WRITE, DATA + 0x400) == 0 && console_of(b) == "hi\nZabcdef", console_of(b))

    // Standard error is another descriptor, whose text is not the console's; a read-mode one cannot be written.
    put32(c, DATA + 0x204, 8)
    val err = call(b, 0, exec, OPEN, DATA + 0x200)
    put32(c, DATA + 0x204, 0)
    val inp = call(b, 0, exec, OPEN, DATA + 0x200)
    assert(err == 2 && inp == 3, s"$err $inp")
    put32(c, DATA + 0x400, err)
    put32(c, DATA + 0x408, 2)
    assert(call(b, 0, exec, WRITE, DATA + 0x400) == 0 && console_of(b) == "hi\nZabcdef", "stderr is not the console")
    put32(c, DATA + 0x400, inp)
    assert(call(b, 0, exec, WRITE, DATA + 0x400) == 2, "nothing written to a descriptor open for reading")

    // Closing: once answers 0, a second time -1, and a closed descriptor writes nothing.
    put32(c, DATA + 0x400, fd)
    put32(c, DATA + 0x500, fd)
    put32(c, DATA + 0x408, 6)
    assert(call(b, 0, exec, CLOSE, DATA + 0x500) == 0 && call(b, 0, exec, CLOSE, DATA + 0x500) == 0xFFFFFFFF)
    assert(call(b, 0, exec, WRITE, DATA + 0x400) == 6, "a closed descriptor")
    put_text(c, DATA + 0x100, ":xx")
    assert(call(b, 0, exec, OPEN, DATA + 0x200) == 0xFFFFFFFF, "only the console opens")

    // A call that is not implemented stops the core where it is.
    call(b, 0, exec, 0x99, 0)
    assert(c.stop == Stop.Undefined && c.stop_at == CODE, s"${c.stop}")

@test("semihosting: SYS_WRITEC, SYS_WRITE0, SYS_OPEN, SYS_WRITE and SYS_CLOSE on both cores' models and under both executors; the core runs on after each")
semihost_writes()
    for exec in [&arm.run_match, &arm.run_threaded]
        writes_text(semi_pico2(true), exec)
        writes_text(semi_pico(true), exec)

private crossing[C: ArmChip](b: &ArmBoard[C], exec: *extern(*arm.Cpu) -> unit)
    val c = &b.cores[0]
    var want: Buf[u8] = buf()
    // 5000 bytes from 0x20032F00 span three 4 KB pages.
    for i in 0..<5000
        val ch = u8('a') + u8.wrap(i % 26)
        want.push(ch)
        arm.store8(c, DATA + 0xF00 + u32(i), u32(ch))
    put_text(c, DATA + 0x100, ":tt")
    put32(c, DATA + 0x200, DATA + 0x100)
    put32(c, DATA + 0x204, 4)
    put32(c, DATA + 0x208, 3)
    val fd = call(b, 0, exec, OPEN, DATA + 0x200)
    put32(c, DATA + 0x400, fd)
    put32(c, DATA + 0x404, DATA + 0xF00)
    put32(c, DATA + 0x408, 5000)
    assert(call(b, 0, exec, WRITE, DATA + 0x400) == 0)
    assert(b.console.view() == want.view(), "5000 bytes across pages")
    // Memory with no page, and a length that runs off the end of the address space: nothing is written, all is left.
    put32(c, DATA + 0x404, 0xF0000000)
    assert(call(b, 0, exec, WRITE, DATA + 0x400) == 5000 && c.stop == Stop.Breakpoint)
    put32(c, DATA + 0x404, 0xFFFFFFF0)
    put32(c, DATA + 0x408, 64)
    assert(call(b, 0, exec, WRITE, DATA + 0x400) == 64 && c.stop == Stop.Breakpoint)
    assert(b.console.len() == 5000, "none of it written")
    // An argument block with no page is no fault of the core's.
    call(b, 0, exec, WRITE, 0xF0000000)
    assert(c.stop == Stop.Breakpoint && b.console.len() == 5000)
    assert(call(b, 0, exec, WRITE0, 0xF0000000) == 0xDEADBEEF && c.stop == Stop.Breakpoint)

@test("semihosting: SYS_WRITE of a buffer that crosses pages arrives whole; a buffer or block off the pages answers the length and writes nothing")
semihost_page_crossing()
    for exec in [&arm.run_match, &arm.run_threaded]
        crossing(semi_pico2(true), exec)
        crossing(semi_pico(true), exec)

private exit_statuses[C: ArmChip](make: &Fn() -> &ArmBoard[C], exec: *extern(*arm.Cpu) -> unit)
    for code in [0u32, 3, 99, 255]
        val b = make()
        val c = &b.cores[0]
        put32(c, DATA, EXIT_OK)
        put32(c, DATA + 4, code)
        exits_with(b, 0, exec, EXIT_EXTENDED, DATA, code)
        assert(c.stop_at == CODE && c.pc == CODE, "stopped at the BKPT")
    // A reason that is not an application exit is status 1 whatever the subcode.
    val b = make()
    put32(&b.cores[0], DATA, 0x20023)
    put32(&b.cores[0], DATA + 4, 7)
    exits_with(b, 0, exec, EXIT_EXTENDED, DATA, 1)
    // SYS_EXIT's R1 is the reason itself, never an address.
    exits_with(make(), 0, exec, EXIT, EXIT_OK, 0)
    exits_with(make(), 0, exec, EXIT, 0x20023, 1)
    exits_with(make(), 0, exec, EXIT, DATA, 1)
    // An exit block off the pages is a failed call, and the core runs on.
    val d = make()
    assert(call(d, 0, exec, EXIT_EXTENDED, 0xF0000000) == 0xFFFFFFFF && d.cores[0].stop == Stop.Breakpoint)
    // Handler mode makes no difference.
    val h = make()
    h.cores[0].ipsr = 11
    put32(&h.cores[0], DATA, EXIT_OK)
    put32(&h.cores[0], DATA + 4, 3)
    exits_with(h, 0, exec, EXIT_EXTENDED, DATA, 3)

@test("semihosting: SYS_EXIT_EXTENDED and SYS_EXIT give the run QEMU's status, 0, 3 and 99 among them, under both executors, from Handler mode too")
semihost_exit_statuses()
    for exec in [&arm.run_match, &arm.run_threaded]
        exit_statuses(() -> semi_pico2(true), exec)
        exit_statuses(() -> semi_pico(true), exec)

private ends_run[C: ArmChip](b: &ArmBoard[C], k: usize, op: u32, arg: u32, want: u32)
    // Core 0 sleeps in a loop where core 1 is the one that calls.
    val c = &b.cores[k]
    arm.store16(&b.cores[0], CODE + 0x100, 0xBF30)
    arm.store16(&b.cores[0], CODE + 0x102, 0xE7FD)
    arm.store16(c, CODE, 0xBEAB)
    b.cores[0].pc = CODE + 0x100
    c.pc = CODE
    c.r[0] = op
    c.r[1] = arg
    c.sleeping = false
    assert(b.run(100000) == RunEnd.Exit, s"${b.refused}")
    assert(b.exit_status == want && c.stop == Stop.Exit, s"status ${b.exit_status}")

@test("semihosting: the exit status of a call on core 0 or core 1 is the board's, on the Pico 2 and the Pico, 0, 3 and 99")
semihost_board_exit()
    for k in 0..<2
        for code in [0u32, 3, 99]
            val a = semi_pico2(true)
            put32(&a.cores[k], DATA, EXIT_OK)
            put32(&a.cores[k], DATA + 4, code)
            ends_run(a, k, EXIT_EXTENDED, DATA, code)
            val p = semi_pico(true)
            put32(&p.cores[k], DATA, EXIT_OK)
            put32(&p.cores[k], DATA + 4, code)
            ends_run(p, k, EXIT_EXTENDED, DATA, code)
            ends_run(semi_pico2(true), k, EXIT, if code == 0 then EXIT_OK else 0x20023, if code == 0 then 0 else 1)
            ends_run(semi_pico(true), k, EXIT, if code == 0 then EXIT_OK else 0x20023, if code == 0 then 0 else 1)

private writes_from_core1[C: ArmChip](b: &ArmBoard[C])
    // Core 1 prints a line while core 0 sleeps; the run goes on after it.
    put_text(&b.cores[1], DATA, "from core 1\n")
    arm.store16(&b.cores[0], CODE + 0x100, 0xBF30)
    arm.store16(&b.cores[0], CODE + 0x102, 0xE7FD)
    arm.store16(&b.cores[1], CODE, 0xBEAB)
    arm.store16(&b.cores[1], CODE + 2, 0xBE00)
    b.cores[0].pc = CODE + 0x100
    b.cores[1].pc = CODE
    b.cores[1].r[0] = WRITE0
    b.cores[1].r[1] = DATA
    b.cores[1].sleeping = false
    assert(b.run(100000) == RunEnd.Breakpoint, s"${b.refused}")
    assert(console_of(b) == "from core 1\n" && b.cores[1].stop_at == CODE + 2, console_of(b))

@test("semihosting: a call from core 1 while core 0 runs writes to the console, on the Pico 2 and the Pico")
semihost_core1_writes()
    writes_from_core1(semi_pico2(true))
    writes_from_core1(semi_pico(true))

private off_stops[C: ArmChip](b: &ArmBoard[C], exec: *extern(*arm.Cpu) -> unit)
    val c = &b.cores[0]
    put_text(c, DATA, "no")
    call(b, 0, exec, WRITE0, DATA)
    assert(c.stop == Stop.Breakpoint && c.stop_at == CODE && c.retired == 0, s"${c.stop} at ${c.stop_at}")
    assert(b.console.len() == 0, "nothing written")
    put32(c, DATA, EXIT_OK)
    put32(c, DATA + 4, 5)
    call(b, 0, exec, EXIT_EXTENDED, DATA)
    assert(c.stop == Stop.Breakpoint, "no exit")

@test("without semihosting a BKPT 0xAB stops the core as any BKPT does, under both executors, on both models")
semihost_off()
    for exec in [&arm.run_match, &arm.run_threaded]
        off_stops(semi_pico2(false), exec)
        off_stops(semi_pico(false), exec)
    val b = semi_pico2(false)
    b.cores[0].pc = CODE
    arm.store16(&b.cores[0], CODE, 0xBEAB)
    assert(b.run(1000) == RunEnd.Breakpoint)

// ---------------------------------------------------------------------------------------------------
// UARTs to files.

private wr(c: *Rp2350, a: u32, x: u32) = c.write(0, a, 4, x).unwrap()

// UART `k` out of reset at IBRD 6, 8N1, enabled, with clk_peri running.
private uart_on(c: *Rp2350, k: u32)
    wr(c, rr.BASE + rr.RESET_OFFSET + 0x3000, rr.RESET_UART0_MASK | rr.RESET_UART1_MASK)
    wr(c, clk.BASE + clk.CLK_PERI_CTRL_OFFSET, clk.CLK_PERI_CTRL_ENABLE_MASK)
    val base = if k == 0 then ur.BASE else ur1.BASE
    wr(c, base + ur.UARTIBRD_OFFSET, 6)
    wr(c, base + ur.UARTFBRD_OFFSET, 0)
    wr(c, base + ur.UARTLCR_H_OFFSET, 0x70)
    wr(c, base + ur.UARTCR_OFFSET, 0x301)

private send(c: *Rp2350, k: u32, text: string)
    val base = if k == 0 then ur.BASE else ur1.BASE
    for ch in text.bytes do wr(c, base + ur.UARTDR_OFFSET, u32(ch))

private file_text(file: string) -> string = from_utf8_lossy(read_bytes(file).unwrap())

@test("--serial: UART1 to a file while UART0 stays the console; both to two files; a file is emptied at boot; UART1 unredirected sends nothing to the console")
serial_files()
    val dir = make_temp_dir("benchtop-serial").unwrap()
    val one = s"$dir/one.txt"
    val zero = s"$dir/zero.txt"

    var o = arm_options()
    take_serial(&o, s"uart1=file:$one").unwrap()
    val b = arm_board(SramMap(0x20000000, 520 * 1024))
    b.apply_options(o)
    b.boot(SEMI_PICO2).unwrap()
    uart_on(&b.chip, 0)
    uart_on(&b.chip, 1)
    send(&b.chip, 0, "AB")
    send(&b.chip, 1, "xyz")
    assert(b.finish_sending(), b.refused)
    assert(console_of(b) == "AB", console_of(b))
    assert(file_text(one) == "xyz", file_text(one))

    var both = arm_options()
    take_serial(&both, s"uart0=file:$zero").unwrap()
    take_serial(&both, s"uart1=file:$one").unwrap()
    val c = arm_board(SramMap(0x20000000, 520 * 1024))
    c.apply_options(both)
    c.boot(SEMI_PICO2).unwrap()
    assert(file_text(one) == "" && file_text(zero) == "", "emptied at boot")
    uart_on(&c.chip, 0)
    uart_on(&c.chip, 1)
    send(&c.chip, 0, "core0\n")
    send(&c.chip, 1, "core1\n")
    assert(c.finish_sending(), c.refused)
    assert(file_text(zero) == "core0\n" && file_text(one) == "core1\n", s"${file_text(zero)} ${file_text(one)}")
    assert(c.console.len() == 0, "the console has neither")

    val plain = arm_board(SramMap(0x20000000, 520 * 1024))
    plain.boot(SEMI_PICO2).unwrap()
    uart_on(&plain.chip, 0)
    uart_on(&plain.chip, 1)
    send(&plain.chip, 0, "A")
    send(&plain.chip, 1, "B")
    assert(plain.finish_sending(), plain.refused)
    assert(console_of(plain) == "A", "as before")
    _ = remove_dir_all(dir)

@test("--serial: the argument names uart0 or uart1 and a file, once each; the Hazard3 and virtual boards refuse --semihosting and --serial")
serial_arguments()
    var o = arm_options()
    assert(take_serial(&o, "uart1=file:a.txt").is_ok() && o.serial[1] == "a.txt" && o.serial[0] == "" && o.named())
    assert(take_serial(&o, "uart1=file:b.txt").is_err(), "twice")
    assert(take_serial(&o, "uart2=file:b.txt").unwrap_err().contains("uart0 or uart1"))
    assert(take_serial(&o, "uart0=tcp:b").is_err() && take_serial(&o, "uart0").is_err() && take_serial(&o, "uart0=file:").is_err())
    val none = arm_options()
    assert(!none.named())
    var s = arm_options()
    s.semihosting = true
    assert(rp_guest("pico2-riscv", false, false, s).unwrap().is_err(), "Hazard3 refuses")
    assert(rp_guest("pico2", false, false, s).unwrap().is_ok() && rp_guest("pico", false, false, s).unwrap().is_ok())
