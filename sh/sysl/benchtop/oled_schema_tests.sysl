module sh.sysl.benchtop
@tests

import sh.sysl.parsing.source_of
import sysl.raw.str_cast
import sysl.text.replace_all

private val OLED_BOARD = str_cast(embed("../../../boards/workbench.hocon"))

@test("SSD1306 OLED: catalog requires SPI GPIO terminals, accepts ref and round trips board configuration")
oled_schema()
    val src = source_of("oled.hocon", OLED_BOARD)
    val got = load(src, library())
    assert(!got.report.has_errors(), got.report.render(src))
    val p = got.description.board.parts.at(8)
    assert(p.kind == "ssd1306" && p.reference == "DS3" && p.wires.len() == 5)
    val written = description_text(got.description)
    val again = load(source_of("again.hocon", written), library())
    assert(!again.report.has_errors() && description_text(again.description) == written)
    for pair in [("sck = controller.GP6,", ""), ("mosi = controller.GP7", "mosi = controller.GP32"), ("ref = DS3", "ref = DS2")]
        val bad = source_of("bad.hocon", replace_all(OLED_BOARD, pair.0, pair.1))
        assert(load(bad, library()).report.has_errors())
