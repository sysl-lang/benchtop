module sh.sysl.benchtop.peripheral.rp2350
@tests

import sh.sysl.benchtop.peripheral.rp2040.AccessError
import sh.sysl.rp2040.io_bank0 as io40
import sh.sysl.rp2350.io_bank0 as io

// The GPIO interrupt registers (`gpio_irq.sysl`) on their own, at the RP2350's layout and the RP2040's.

private const SET: u32 = 0x2000
private const CLR: u32 = 0x3000
private const XOR: u32 = 0x1000

private rd(g: GpioIrq, a: u32) -> u32 = g.read(a, a, 4).unwrap()
private wr(g: *GpioIrq, a: u32, x: u32) = g.write(a & 0xFFC, a, x).unwrap()

@test("INTR: LEVEL_LOW and LEVEL_HIGH follow each input; a rising input latches EDGE_HIGH and a falling one EDGE_LOW until a 1 clears them, through any alias; level bits take no clear")
gpio_irq_levels_and_edges()
    var g = gpio_irq(48, io.INTR0_OFFSET)
    assert(rd(g, io.INTR0_OFFSET) == 0x11111111 && rd(g, io.INTR5_OFFSET) == 0x11111111, "every input low")
    g.sample(1u64 << 2, true)
    assert(rd(g, io.INTR0_OFFSET) == 0x11111A11, s"GPIO 2 rose: 0x${rd(g, io.INTR0_OFFSET)}")
    g.sample(0, true)
    assert(rd(g, io.INTR0_OFFSET) == 0x11111D11, "and fell: LEVEL_LOW, EDGE_LOW and the EDGE_HIGH still latched")
    wr(&g, io.INTR0_OFFSET, 0x00000400)
    assert(rd(g, io.INTR0_OFFSET) == 0x11111911, "a 1 clears EDGE_LOW alone")
    wr(&g, io.INTR0_OFFSET + CLR, 0x00000800)
    assert(rd(g, io.INTR0_OFFSET) == 0x11111111, "the CLR alias clears too")
    g.sample(0, true)
    g.sample(1u64 << 47, true)
    wr(&g, io.INTR5_OFFSET + SET, 0x30000000)
    assert(rd(g, io.INTR5_OFFSET) == 0xA1111111, "a 1 in a level bit clears nothing, and SET clears nothing it names but edges")
    wr(&g, io.INTR5_OFFSET + XOR, 0x80000000)
    assert(rd(g, io.INTR5_OFFSET) == 0x21111111, "XOR clears the edge too")
    // An input the bank is held in reset through changes INTR's levels and latches no edge.
    g.sample(0, false)
    assert(rd(g, io.INTR5_OFFSET) == 0x11111111)

@test("INTS = (INTR | INTF) & INTE for processor 0, processor 1 and the dormant wake, each with its own INTE and INTF; a line is asserted while its INTS is not 0; INTS and the summary are read-only results")
gpio_irq_destinations()
    var g = gpio_irq(48, io.INTR0_OFFSET)
    wr(&g, io.PROC0_INTE0_OFFSET, 0x00000800)
    assert(!g.line(0) && rd(g, io.PROC0_INTS0_OFFSET) == 0, "nothing latched yet")
    g.sample(1u64 << 2, true)
    assert(g.line(0) && !g.line(1) && !g.line(DORMANT_WAKE), "only processor 0 enables GPIO 2's EDGE_HIGH")
    assert(rd(g, io.PROC0_INTS0_OFFSET) == 0x800 && rd(g, io.PROC1_INTS0_OFFSET) == 0 && g.summary(0) == 0x4)
    wr(&g, io.PROC0_INTS0_OFFSET, 0)
    assert(rd(g, io.PROC0_INTS0_OFFSET) == 0x800, "INTS takes no write")
    wr(&g, io.INTR0_OFFSET, 0x800)
    assert(!g.line(0))
    // Processor 1: a level enabled is asserted at once and stays.
    wr(&g, io.PROC1_INTE0_OFFSET + SET, 0x00000200)
    assert(g.line(1) && rd(g, io.PROC1_INTS0_OFFSET) == 0x200 && !g.line(0))
    wr(&g, io.PROC1_INTE0_OFFSET + CLR, 0x00000200)
    assert(!g.line(1))
    // A force without an enable does nothing; with it, it is asserted until the force is cleared.
    wr(&g, io.PROC1_INTF0_OFFSET + 4, 0x8)
    assert(!g.line(1) && rd(g, io.PROC1_INTF0_OFFSET + 4) == 0x8)
    wr(&g, io.PROC1_INTE0_OFFSET + 4, 0x8)
    assert(g.line(1) && rd(g, io.PROC1_INTS0_OFFSET + 4) == 0x8 && g.summary(1) == 1u64 << 8)
    wr(&g, io.PROC1_INTF0_OFFSET + 4 + XOR, 0x8)
    assert(!g.line(1) && rd(g, io.PROC1_INTF0_OFFSET + 4) == 0)
    // The dormant wake: GPIO 47's LEVEL_LOW.
    wr(&g, io.DORMANT_WAKE_INTE5_OFFSET, 0x10000000)
    assert(g.line(DORMANT_WAKE) && rd(g, io.DORMANT_WAKE_INTS5_OFFSET) == 0x10000000 && g.summary(DORMANT_WAKE) == 1u64 << 47)
    g.sample((1u64 << 47) | (1u64 << 2), true)
    assert(!g.line(DORMANT_WAKE), "GPIO 47 high")
    // Reset: nothing latched, enabled or forced.
    wr(&g, io.PROC0_INTF0_OFFSET, 0xFFFFFFFF)
    g.reset()
    for a in [io.PROC0_INTE0_OFFSET, io.PROC0_INTF0_OFFSET, io.PROC1_INTE0_OFFSET + 4, io.DORMANT_WAKE_INTE5_OFFSET] do assert(rd(g, a) == 0)
    assert(rd(g, io.INTR0_OFFSET) == 0x11111211 && !g.line(0) && !g.line(1) && !g.line(DORMANT_WAKE), "the levels stay")

@test("byte and halfword reads take their lane; outside INTR0 to DORMANT_WAKE_INTS5 is unmapped")
gpio_irq_lanes_and_bounds()
    var g = gpio_irq(48, io.INTR0_OFFSET)
    wr(&g, io.PROC1_INTE0_OFFSET + 8, 0x12345678)
    assert(g.read(io.PROC1_INTE0_OFFSET + 8, io.PROC1_INTE0_OFFSET + 9, 1).unwrap() == 0x56)
    assert(g.read(io.PROC1_INTE0_OFFSET + 8, io.PROC1_INTE0_OFFSET + 10, 2).unwrap() == 0x1234)
    assert(g.read(io.DORMANT_WAKE_INTS5_OFFSET + 4, io.DORMANT_WAKE_INTS5_OFFSET + 4, 4) == Err(AccessError.Unmapped))
    assert(g.write(io.DORMANT_WAKE_INTS5_OFFSET + 4, io.DORMANT_WAKE_INTS5_OFFSET + 4, 1) == Err(AccessError.Unmapped))
    assert(g.read(io.INTR0_OFFSET - 4, io.INTR0_OFFSET - 4, 4) == Err(AccessError.Unmapped))

@test("the RP2040's layout: 30 GPIOs in four words from INTR0 at 0xF0, the last word's two missing GPIOs reading 0 and taking no enable")
gpio_irq_rp2040_layout()
    var g = gpio_irq(30, io40.INTR0_OFFSET)
    assert(rd(g, io40.INTR0_OFFSET) == 0x11111111 && rd(g, io40.INTR3_OFFSET) == 0x00111111, "GPIO 24-29")
    wr(&g, io40.PROC0_INTE3_OFFSET, 0xFFFFFFFF)
    assert(rd(g, io40.PROC0_INTE3_OFFSET) == 0x00FFFFFF && g.line(0))
    g.sample(1u64 << 29, true)
    assert(rd(g, io40.PROC0_INTS3_OFFSET) == 0x00A11111)
    wr(&g, io40.DORMANT_WAKE_INTF3_OFFSET, 0x1)
    assert(rd(g, io40.DORMANT_WAKE_INTF3_OFFSET) == 1 && rd(g, io40.PROC1_INTE0_OFFSET) == 0)
    assert(g.read(io40.DORMANT_WAKE_INTS3_OFFSET + 4, io40.DORMANT_WAKE_INTS3_OFFSET + 4, 4) == Err(AccessError.Unmapped))
