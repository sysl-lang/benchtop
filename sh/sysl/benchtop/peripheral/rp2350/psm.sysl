module sh.sysl.benchtop.peripheral.rp2350

import sh.sysl.benchtop.peripheral.rp2040.{AccessError, access, read_lane, replicated, written}
import sh.sysl.rp2350.psm as psm_reg

// PSM, the power-on state machine (datasheet 7.4). Its 25 stages come out of reset one after another,
// bit 0 first (PROC_COLD) to bit 24 last (PROC1); a stage waits for the one before it. Three registers
// steer the sequence, each with one bit per stage:
//
// - FRCE_OFF holds a stage in reset, and with it every stage after it, which keep waiting on it.
// - FRCE_ON brings a stage out of reset whatever the stage before it is doing. FRCE_OFF wins where both
//   name one stage.
// - WDSEL marks the stages a watchdog reset takes down (stored; the watchdog's reset path reads it).
//
// DONE reads a 1 for each stage that is out of reset. A release completes at once, as RESETS' does.

/** The number of stages, and the mask of their bits in each register. */
const PSM_STAGES: u32 = 25
const PSM_MASK: u32 = 0x01FFFFFF

/** The stages, bit 0 first. */
val PSM_NAMES: [25]string = ["PROC_COLD", "OTP", "ROSC", "XOSC", "RESETS", "CLOCKS", "PSM_READY", "BUSFABRIC", "ROM", "BOOTRAM",
    "SRAM0", "SRAM1", "SRAM2", "SRAM3", "SRAM4", "SRAM5", "SRAM6", "SRAM7", "SRAM8", "SRAM9", "XIP", "SIO", "ACCESSCTRL", "PROC0", "PROC1"]

/** PSM: FRCE_ON, FRCE_OFF and WDSEL stored; DONE worked out from them. */
struct Psm
    on: u32
    off: u32
    wdsel: u32

    reset(*self)
        self.on = 0
        self.off = 0
        self.wdsel = 0

    /** The stages held in reset, bit n for stage n. */
    held(self) -> u32
        var all: u32 = 0
        var previous = false
        for i in 0u32..<PSM_STAGES
            val bit = 1u32 << i
            val h = self.off & bit != 0 || (self.on & bit == 0 && previous)
            if h then all |= bit
            previous = h
        all

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val value = offset & 0xFFC match
            psm_reg.FRCE_ON_OFFSET -> self.on
            psm_reg.FRCE_OFF_OFFSET -> self.off
            psm_reg.WDSEL_OFFSET -> self.wdsel
            psm_reg.DONE_OFFSET -> ~self.held() & PSM_MASK
            _ -> return Err(AccessError.Unmapped)
        Ok(read_lane(value, offset, width))

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val data = replicated(value, width)
        offset & 0xFFC match
            psm_reg.FRCE_ON_OFFSET -> self.on = written(self.on, offset, data) & PSM_MASK
            psm_reg.FRCE_OFF_OFFSET -> self.off = written(self.off, offset, data) & PSM_MASK
            psm_reg.WDSEL_OFFSET -> self.wdsel = written(self.wdsel, offset, data) & PSM_MASK
            psm_reg.DONE_OFFSET -> ()
            _ -> return Err(AccessError.Unmapped)
        Ok(())
end Psm

psm() -> Psm
    var state: Psm
    state.reset()
    state

/** The name of the lowest stage in `bits`, for a refusal. */
psm_stage_name(bits: u32) -> string
    for i in 0u32..<PSM_STAGES do if bits & (1u32 << i) != 0 then return PSM_NAMES[i]
    "none"
