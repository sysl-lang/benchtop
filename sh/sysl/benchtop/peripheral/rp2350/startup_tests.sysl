module sh.sysl.benchtop.peripheral.rp2350
@tests

import sh.sysl.benchtop.peripheral.rp2040.AccessError
import sh.sysl.rp2350.bootram as bootram_reg

@test("BOOTRAM's boot locks claim on a read, answering 1 << n once, release on any write, and show in BOOTLOCK_STAT")
bootram_locks()
    var b = bootram()
    val lock7 = bootram_reg.BOOTLOCK7_OFFSET
    assert(b.read(bootram_reg.BOOTLOCK_STAT_OFFSET, 4).unwrap() == 0xFF, "every lock free at power-on")
    assert(b.read(lock7, 4).unwrap() == 0x80, "claimed")
    assert(b.read(lock7, 4).unwrap() == 0, "a second claim fails")
    assert(b.read(bootram_reg.BOOTLOCK_STAT_OFFSET, 4).unwrap() == 0x7F)
    b.write(lock7, 4, 0).unwrap()
    assert(b.read(bootram_reg.BOOTLOCK_STAT_OFFSET, 4).unwrap() == 0xFF, "released by a write of any value")
    assert(b.read(bootram_reg.BOOTLOCK0_OFFSET, 4).unwrap() == 1)
    // STAT is writable: clearing a bit claims that lock, setting it frees it.
    b.write(bootram_reg.BOOTLOCK_STAT_OFFSET + 0x2000, 4, 0x01).unwrap()
    assert(b.read(bootram_reg.BOOTLOCK0_OFFSET, 4).unwrap() == 1, "freed through STAT's SET alias")
    b.reset()
    assert(b.read(bootram_reg.BOOTLOCK_STAT_OFFSET, 4).unwrap() == 0xFF)

@test("BOOTRAM's SRAM keeps bytes, halfwords and words; WRITE_ONCE only ORs; past them nothing is mapped")
bootram_memory()
    var b = bootram()
    b.write(0x3FC, 4, 0x11223344).unwrap()
    b.write(0x3FD, 1, 0xAA).unwrap()
    b.write(0x3FE, 2, 0xBBCC).unwrap()
    assert(b.read(0x3FC, 4).unwrap() == 0xBBCCAA44, s"${b.read(0x3FC, 4).unwrap()}")
    assert(b.read(0x3FE, 2).unwrap() == 0xBBCC && b.read(0x3FD, 1).unwrap() == 0xAA)
    b.write(bootram_reg.WRITE_ONCE0_OFFSET, 4, 0x5).unwrap()
    b.write(bootram_reg.WRITE_ONCE0_OFFSET + 0x3000, 4, 0x1).unwrap()
    b.write(bootram_reg.WRITE_ONCE0_OFFSET, 4, 0x8).unwrap()
    assert(b.read(bootram_reg.WRITE_ONCE0_OFFSET, 4).unwrap() == 0xD, "even a CLR-alias write ORs in")
    assert(b.read(bootram_reg.WRITE_ONCE1_OFFSET, 4).unwrap() == 0)
    assert(b.read(0x400, 4).unwrap_err() == AccessError.Unmapped && b.write(0x82C, 4, 0).unwrap_err() == AccessError.Unmapped)
    assert(b.read(0x3FD, 4).unwrap_err() == AccessError.Unaligned)
