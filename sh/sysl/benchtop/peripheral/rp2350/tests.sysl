module sh.sysl.benchtop.peripheral.rp2350
@tests

import sh.sysl.rp2350.clocks as clk
import sh.sysl.rp2350.pads_bank0 as pad
import sh.sysl.rp2350.pll_sys as pll_reg
import sh.sysl.rp2350.resets as rst
import sh.sysl.rp2350.sio as sr
import sh.sysl.rp2350.ticks as tk
import sh.sysl.rp2350.timer0 as tm
import sh.sysl.rp2350.uart0 as ur
import sh.sysl.rp2350.watchdog as wd
import sh.sysl.rp2350.xosc as xr

@test("RP2350 RESETS holds all 29 outputs at power-on and completes only what is released")
rp2350_resets_outputs()
    var r = rp2350_resets()
    assert(r.read(rst.RESET_OFFSET, 4).unwrap() == 0x1FFFFFFF, "datasheet reset value")
    r.write(rst.RESET_OFFSET + 0x3000, 4, rst.RESET_UART0_MASK | rst.RESET_USBCTRL_MASK).unwrap()
    r.complete(~r.held)
    assert(r.read(rst.RESET_DONE_OFFSET, 4).unwrap() == rst.RESET_DONE_UART0_MASK | rst.RESET_DONE_USBCTRL_MASK)
    r.write(rst.RESET_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(r.held == 0x1FFFFFFF && r.done == 0, "bits past USBCTRL do not exist; holding clears DONE")

@test("TICKS: each generator powers up stopped, divides clk_ref by CYCLES once enabled, and reads COUNT and RUNNING")
rp2350_ticks()
    var t = ticks()
    assert(t.advance(1000)[usize(Tick.Timer0)] == 0, "disabled at power-on")
    t.write(tk.TIMER0_CYCLES_OFFSET, 4, 12).unwrap()
    assert(t.advance(1000)[usize(Tick.Timer0)] == 0, "CYCLES alone does not start it")
    t.write(tk.TIMER0_CTRL_OFFSET, 4, tk.TIMER0_CTRL_ENABLE_MASK).unwrap()
    assert(t.read(tk.TIMER0_CTRL_OFFSET, 4).unwrap() == tk.TIMER0_CTRL_ENABLE_MASK | tk.TIMER0_CTRL_RUNNING_MASK)
    val made = t.advance(25)
    assert(made[usize(Tick.Timer0)] == 2 && made[usize(Tick.Timer1)] == 0 && made[usize(Tick.Riscv)] == 0, "only TIMER0's generator")
    assert(t.read(tk.TIMER0_COUNT_OFFSET, 4).unwrap() == 11)
    t.write(tk.TIMER0_COUNT_OFFSET, 4, 3).unwrap()
    assert(t.read(tk.TIMER0_COUNT_OFFSET, 4).unwrap() == 11, "COUNT is read-only")
    t.write(tk.RISCV_CYCLES_OFFSET, 4, 0xFFFF).unwrap()
    assert(t.read(tk.RISCV_CYCLES_OFFSET, 4).unwrap() == 511, "nine bits")
    t.write(tk.TIMER0_CTRL_OFFSET + 0x3000, 4, tk.TIMER0_CTRL_ENABLE_MASK).unwrap()
    assert(t.read(tk.TIMER0_CTRL_OFFSET, 4).unwrap() == 0, "the CLR alias stops it")
    assert(t.read(tk.RISCV_COUNT_OFFSET + 4, 4).is_err(), "past the last generator")

@test("RP2350 TIMER: alarms fire at the tick they name, the interrupt registers sit past LOCKED and SOURCE, LOCKED freezes the time")
rp2350_timer()
    var t = timer()
    t.write(tm.INTE_OFFSET, 4, 1).unwrap()
    t.write(tm.ALARM0_OFFSET, 4, 100).unwrap()
    assert(t.next_alarm().unwrap() == 100 && t.read(tm.ARMED_OFFSET, 4).unwrap() == 1)
    t.advance(99)
    assert(t.irqs() == 0)
    t.advance(1)
    assert(t.irqs() == 1 && t.read(tm.INTR_OFFSET, 4).unwrap() == 1 && t.read(tm.INTS_OFFSET, 4).unwrap() == 1)
    t.write(tm.INTR_OFFSET, 4, 1).unwrap()
    assert(t.irqs() == 0 && t.read(tm.INTE_OFFSET, 4).unwrap() == 1)
    t.write(tm.INTF_OFFSET, 4, 4).unwrap()
    assert(t.irqs() == 4, "a forced alarm 2")
    assert(t.read(tm.TIMELR_OFFSET, 4).unwrap() == 100 && t.read(tm.TIMERAWL_OFFSET, 4).unwrap() == 100)
    t.write(tm.SOURCE_OFFSET, 4, tm.SOURCE_CLK_SYS_CLK_SYS).unwrap()
    assert(t.clk_sys && t.read(tm.SOURCE_OFFSET, 4).unwrap() == 1)
    t.write(tm.LOCKED_OFFSET, 4, 1).unwrap()
    t.write(tm.TIMELW_OFFSET, 4, 5).unwrap()
    t.write(tm.TIMEHW_OFFSET, 4, 0).unwrap()
    assert(t.read(tm.TIMERAWL_OFFSET, 4).unwrap() == 100, "locked")
    t.write(tm.LOCKED_OFFSET, 4, 0).unwrap()
    assert(t.locked, "LOCKED clears only on a reset")
    t.reset()
    assert(!t.locked && !t.clk_sys && t.read(tm.INTR_OFFSET, 4).unwrap() == 0)

@test("the RP2350 watchdog stores CTRL and its scratch registers, and TRIGGER makes no reset")
rp2350_watchdog()
    var w = watchdog()
    assert(w.read(wd.CTRL_OFFSET, 4).unwrap() == 0x07000000, "the pause bits power up set")
    w.write(wd.SCRATCH4_OFFSET, 4, 0xB007).unwrap()
    w.write(wd.SCRATCH4_OFFSET + 0x1000, 4, 0xFF).unwrap()
    assert(w.read(wd.SCRATCH4_OFFSET, 4).unwrap() == 0xB0F8)
    w.write(wd.CTRL_OFFSET, 4, wd.CTRL_TRIGGER_MASK | wd.CTRL_ENABLE_MASK | 1000).unwrap()
    assert(w.read(wd.CTRL_OFFSET, 4).unwrap() == wd.CTRL_ENABLE_MASK | 1000)
    assert(w.read(wd.REASON_OFFSET, 4).unwrap() == 0 && w.read(0x30, 4).is_err())

@test("XOSC is STABLE only after STARTUP.DELAY x 256 of its cycles, and a PLL locks once powered with a feedback divisor")
rp2350_oscillators()
    var x = xosc()
    x.write(xr.STARTUP_OFFSET, 4, 47).unwrap()
    x.write(xr.CTRL_OFFSET, 4, xr.CTRL_ENABLE_ENABLE << xr.CTRL_ENABLE_SHIFT).unwrap()
    assert(x.read(xr.STATUS_OFFSET, 4).unwrap() & (xr.STATUS_STABLE_MASK | xr.STATUS_ENABLED_MASK) == xr.STATUS_ENABLED_MASK)
    x.advance(47 * 256 - 1)
    assert(!x.stable())
    x.advance(1)
    assert(x.read(xr.STATUS_OFFSET, 4).unwrap() & xr.STATUS_STABLE_MASK != 0)
    x.write(xr.CTRL_OFFSET, 4, xr.CTRL_ENABLE_DISABLE << xr.CTRL_ENABLE_SHIFT).unwrap()
    assert(!x.stable() && !x.on)
    x.write(xr.STARTUP_OFFSET, 4, xr.STARTUP_X4_MASK | 1).unwrap()
    x.write(xr.CTRL_OFFSET, 4, xr.CTRL_ENABLE_ENABLE << xr.CTRL_ENABLE_SHIFT).unwrap()
    x.advance(1023)
    assert(!x.stable(), "X4 multiplies the delay")
    x.advance(1)
    assert(x.stable())

    var p = pll()
    assert(!p.locked() && p.hz(12000000) == 0)
    p.write(pll_reg.FBDIV_INT_OFFSET, 4, 125).unwrap()
    p.write(pll_reg.PWR_OFFSET + 0x3000, 4, pll_reg.PWR_PD_MASK).unwrap()
    assert(!p.locked(), "the VCO is still down")
    p.write(pll_reg.PWR_OFFSET + 0x3000, 4, pll_reg.PWR_VCOPD_MASK).unwrap()
    assert(p.read(pll_reg.CS_OFFSET, 4).unwrap() & pll_reg.CS_LOCK_MASK != 0)
    assert(p.hz(12000000) == 0, "post dividers still powered down")
    p.write(pll_reg.PRIM_OFFSET, 4, (5 << pll_reg.PRIM_POSTDIV1_SHIFT) | (2 << pll_reg.PRIM_POSTDIV2_SHIFT)).unwrap()
    p.write(pll_reg.PWR_OFFSET + 0x3000, 4, pll_reg.PWR_POSTDIVPD_MASK).unwrap()
    assert(p.hz(12000000) == 150000000, "the Pico 2's 150 MHz")

@test("CLOCKS: clk_ref and clk_sys follow their muxes and dividers, and SELECTED reads one-hot")
rp2350_clocks()
    var c = clocks()
    val s = Sources(11000000, 12000000, 32768, 150000000, 48000000)
    assert(c.ref_hz(s) == 11000000 && c.sys_hz(s) == 11000000, "the ring oscillator at power-on")
    assert(c.read(clk.CLK_REF_SELECTED_OFFSET, 4).unwrap() == 1 && c.read(clk.CLK_SYS_SELECTED_OFFSET, 4).unwrap() == 1)
    c.write(clk.CLK_REF_CTRL_OFFSET, 4, clk.CLK_REF_CTRL_SRC_XOSC_CLKSRC).unwrap()
    assert(c.read(clk.CLK_REF_SELECTED_OFFSET, 4).unwrap() == 4 && c.ref_hz(s) == 12000000)
    c.write(clk.CLK_SYS_CTRL_OFFSET, 4, clk.CLK_SYS_CTRL_SRC_CLKSRC_CLK_SYS_AUX).unwrap()
    assert(c.read(clk.CLK_SYS_SELECTED_OFFSET, 4).unwrap() == 2 && c.sys_hz(s) == 150000000)
    c.write(clk.CLK_SYS_DIV_OFFSET, 4, (2 << clk.CLK_SYS_DIV_INT_SHIFT) | 0x8000).unwrap()
    assert(c.sys_hz(s) == 60000000, "divide by 2.5")
    c.write(clk.CLK_REF_DIV_OFFSET, 4, 4 << clk.CLK_REF_DIV_INT_SHIFT).unwrap()
    assert(c.ref_hz(s) == 3000000)
    assert(c.read(clk.CLK_PERI_SELECTED_OFFSET, 4).unwrap() == 1, "no glitchless mux")
    assert(c.read(clk.INTS_OFFSET + 4, 4).is_err())

@test("SIO: the FIFOs are four deep each way with sticky WOF and ROE; spinlocks claim on read; MTIMECMP is per core")
rp2350_sio()
    var s = sio()
    for i in 0u32..<4 do s.write(0, sr.FIFO_WR_OFFSET, 4, i).unwrap()
    assert(s.read(0, sr.FIFO_ST_OFFSET, 4, 0).unwrap() == 0, "core 0: nothing to read, no room")
    s.write(0, sr.FIFO_WR_OFFSET, 4, 9).unwrap()
    assert(s.read(0, sr.FIFO_ST_OFFSET, 4, 0).unwrap() == sr.FIFO_ST_WOF_MASK && s.fifo_irq(0))
    assert(s.read(1, sr.FIFO_ST_OFFSET, 4, 0).unwrap() == sr.FIFO_ST_VLD_MASK | sr.FIFO_ST_RDY_MASK && s.fifo_irq(1))
    for i in 0u32..<4 do assert(s.read(1, sr.FIFO_RD_OFFSET, 4, 0).unwrap() == i, "in order; the fifth was dropped")
    assert(s.read(1, sr.FIFO_RD_OFFSET, 4, 0).unwrap() == 0 && s.read(1, sr.FIFO_ST_OFFSET, 4, 0).unwrap() & sr.FIFO_ST_ROE_MASK != 0)
    s.write(1, sr.FIFO_ST_OFFSET, 4, 0).unwrap()
    s.write(0, sr.FIFO_ST_OFFSET, 4, 0).unwrap()
    assert(!s.fifo_irq(0) && !s.fifo_irq(1))

    assert(s.read(0, sr.SPINLOCK0_OFFSET + 12, 4, 0).unwrap() == 8 && s.read(1, sr.SPINLOCK0_OFFSET + 12, 4, 0).unwrap() == 0)
    assert(s.read(0, sr.SPINLOCK_ST_OFFSET, 4, 0).unwrap() == 8)
    s.write(1, sr.SPINLOCK0_OFFSET + 12, 4, 0).unwrap()
    assert(s.read(1, sr.SPINLOCK0_OFFSET + 12, 4, 0).unwrap() == 8, "released by any write, claimed by the other core")

    s.write(0, sr.GPIO_OUT_SET_OFFSET, 4, 0x30).unwrap()
    s.write(1, sr.GPIO_OUT_XOR_OFFSET, 4, 0x11).unwrap()
    s.write(0, sr.GPIO_HI_OE_SET_OFFSET, 4, 0x8001).unwrap()
    assert(s.read(0, sr.GPIO_OUT_OFFSET, 4, 0).unwrap() == 0x21 && s.oe == 0x800100000000)
    assert(s.read(1, sr.GPIO_IN_OFFSET, 4, 0x123456789A).unwrap() == 0x3456789A && s.read(1, sr.GPIO_HI_IN_OFFSET, 4, 0x123456789A).unwrap() == 0x12)
    assert(s.write(0, sr.GPIO_OUT_OFFSET, 1, 1).is_err(), "SIO takes whole words")

    s.write(0, sr.MTIMECMP_OFFSET, 4, 10).unwrap()
    s.write(0, sr.MTIMECMPH_OFFSET, 4, 0).unwrap()
    assert(s.mtime_due(0).unwrap() == 10 && s.mtime_due(1).is_none() == false)
    s.advance_mtime(10)
    assert(s.timer_irq(0) && !s.timer_irq(1) && s.read(1, sr.MTIMECMP_OFFSET, 4, 0).unwrap() == 0xFFFFFFFF)
    s.write(0, sr.MTIME_CTRL_OFFSET, 4, 0).unwrap()
    s.advance_mtime(5)
    assert(s.read(0, sr.MTIME_OFFSET, 4, 0).unwrap() == 10, "EN clear stops MTIME")
    s.write(1, sr.RISCV_SOFTIRQ_OFFSET, 4, sr.RISCV_SOFTIRQ_CORE1_SET_MASK).unwrap()
    assert(s.software_irq(1) && !s.software_irq(0))
    s.write(0, sr.RISCV_SOFTIRQ_OFFSET, 4, sr.RISCV_SOFTIRQ_CORE1_CLR_MASK).unwrap()
    assert(!s.software_irq(1))
    assert(s.read(0, sr.DOORBELL_OUT_SET_OFFSET, 4, 0).is_err(), "doorbells are not modelled")

@test("pads come up isolated, an isolated or output-disabled pad does not drive, and an undriven pin follows its pulls")
rp2350_pads()
    var p = pads_bank0()
    val on = Drive(true, true)
    assert(p.read(pad.GPIO7_OFFSET, 4).unwrap() == 0x116, "datasheet reset value")
    assert(!p.pin(7, on, None).drives && !p.pin(7, on, None).level, "ISO, and the pull-down")
    p.write(pad.GPIO7_OFFSET + 0x3000, 4, pad.GPIO7_ISO_MASK).unwrap()
    assert(p.pin(7, on, None).drives && p.pin(7, on, None).level && !p.pin(7, on, None).input, "IE is clear")
    p.write(pad.GPIO7_OFFSET + 0x2000, 4, pad.GPIO7_OD_MASK | pad.GPIO7_IE_MASK | pad.GPIO7_PUE_MASK).unwrap()
    val off = p.pin(7, on, None)
    assert(!off.drives && off.level && off.input, "OD stops the drive; the pull-up reads high")
    assert(!p.pin(7, on, Some(false)).input, "a level from outside wins over the pull")
    assert(p.read(pad.SWD_OFFSET + 4, 4).is_err())

@test("IO_BANK0 overrides: OUTOVER and OEOVER invert, force or pass the function's drive")
rp2350_overrides()
    var io = io_bank0()
    val d = Drive(true, false)
    assert(io.function(3) == 31, "NULL at power-on")
    io.write(3 * 8 + 4, 4, (1 << 12) | (3 << 14) | 5).unwrap()
    val got = io.after_overrides(3, d)
    assert(!got.out && got.oe && io.function(3) == 5)
    io.write(3 * 8 + 4, 4, (3 << 12) | (2 << 14)).unwrap()
    val forced = io.after_overrides(3, Drive(false, true))
    assert(forced.out && !forced.oe, "HIGH and DISABLE")
    assert(io.write(48 * 8, 4, 0).is_err(), "48 GPIOs")

@test("the PL011 sends while enabled, receives into its FIFO, and raises RX and TX through IMSC")
rp2350_uart()
    var u = uart()
    u.write(ur.UARTDR_OFFSET, 4, 65).unwrap()
    assert(u.take().is_none(), "UARTEN is clear at power-on")
    assert(!u.receive(1))
    u.write(ur.UARTCR_OFFSET + 0x2000, 4, ur.UARTCR_UARTEN_MASK).unwrap()
    assert(u.read(ur.UARTCR_OFFSET, 4).unwrap() == 0x301)
    u.write(ur.UARTDR_OFFSET, 4, 0x142).unwrap()
    assert(u.read(ur.UARTFR_OFFSET, 4).unwrap() & ur.UARTFR_TXFE_MASK == 0, "a byte waits to go")
    assert(u.take().unwrap() == u8('B') && u.take().is_none(), "eight bits")
    assert(u.read(ur.UARTFR_OFFSET, 4).unwrap() == ur.UARTFR_TXFE_MASK | ur.UARTFR_RXFE_MASK)
    for i in 0..<33 do u.write(ur.UARTDR_OFFSET, 4, u32(i)).unwrap()
    assert(u.read(ur.UARTFR_OFFSET, 4).unwrap() & ur.UARTFR_TXFF_MASK != 0)
    for i in 0..<32 do assert(u.take().unwrap() == u8(i), "the 33rd is lost")
    assert(u.take().is_none())
    for i in 0..<32 do assert(u.receive(u8(i)))
    assert(!u.receive(99) && u.read(ur.UARTFR_OFFSET, 4).unwrap() & ur.UARTFR_RXFF_MASK != 0)
    assert(!u.irq())
    u.write(ur.UARTIMSC_OFFSET, 4, ur.UARTIMSC_RXIM_MASK).unwrap()
    assert(u.irq() && u.read(ur.UARTMIS_OFFSET, 4).unwrap() == ur.UARTRIS_RXRIS_MASK)
    for i in 0..<32 do assert(u.read(ur.UARTDR_OFFSET, 4).unwrap() == u32(i))
    assert(!u.irq())
    u.write(ur.UARTIMSC_OFFSET, 4, ur.UARTIMSC_TXIM_MASK).unwrap()
    assert(u.irq())
    u.write(ur.UARTICR_OFFSET, 4, ur.UARTICR_TXIC_MASK).unwrap()
    assert(!u.irq(), "TX cleared until the next byte")
    assert(u.write(ur.UARTDR_OFFSET + 0x2000, 4, 1).is_err() && u.read(ur.UARTDR_OFFSET + 0x1000, 4).is_err(), "no aliases on the data register")
