module sh.sysl.benchtop.peripheral.rp2350

import sh.sysl.benchtop.peripheral.rp2040.{AccessError, access, read_lane, replicated, written}
import sh.sysl.rp2350.syscfg as syscfg_reg
import sh.sysl.rp2350.sysinfo as sysinfo_reg

// SYSINFO and SYSCFG (datasheet 12.15, "System control").

/** CHIP_ID of the Pico 2's RP2350: revision 3, part 0x0004, JEP-106 manufacturer 0x493 (Raspberry Pi) and
 * the stop bit (`SYSINFO_CHIP_ID_RESET`).
 */
const CHIP_ID: u32 = 0x30004927
/** PLATFORM: the ASIC bit, which is what a chip reports. */
const PLATFORM_ASIC: u32 = 0x2
/** PACKAGE_SEL: 1 is the QFN60 of the RP2350A, which the Pico 2 carries (0 would be the QFN80 RP2350B). */
const PACKAGE_QFN60: u32 = 1

/** SYSINFO: four read-only registers. A write is dropped, as a write to a read-only register is. GITREF
 * reads 0, since the model has no source revision to name.
 */
struct SysInfo
    package: u32

    reset(*self) = self.package = PACKAGE_QFN60

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val value = offset & 0xFFC match
            sysinfo_reg.CHIP_ID_OFFSET -> CHIP_ID
            sysinfo_reg.PACKAGE_SEL_OFFSET -> self.package
            sysinfo_reg.PLATFORM_OFFSET -> PLATFORM_ASIC
            sysinfo_reg.GITREF_RP2350_OFFSET -> 0
            _ -> return Err(AccessError.Unmapped)
        Ok(read_lane(value, offset, width))

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        offset & 0xFFC match
            sysinfo_reg.CHIP_ID_OFFSET | sysinfo_reg.PACKAGE_SEL_OFFSET | sysinfo_reg.PLATFORM_OFFSET | sysinfo_reg.GITREF_RP2350_OFFSET -> ()
            _ -> return Err(AccessError.Unmapped)
        Ok(())
end SysInfo

sysinfo() -> SysInfo
    var state: SysInfo
    state.reset()
    state

/** SYSCFG's words: PROC_CONFIG, PROC_IN_SYNC_BYPASS, PROC_IN_SYNC_BYPASS_HI, DBGFORCE, MEMPOWERDOWN and
 * AUXCTRL, each at word index offset / 4.
 */
private const SYSCFG_WORDS: usize = 6

/** The bits of each SYSCFG register a write can change (the header's BITS less the read-only fields:
 * PROC_CONFIG.PROCn_HALTED and DBGFORCE.SWDO).
 */
private val SYSCFG_WRITABLE: [6]u32 = [0, 0xFFFFFFFF, 0xFF00FFFF, 0xE, 0x1FFF, 0xFF]

/** SYSCFG, stored. The registers act on parts of the chip benchtop has no model of (the input
 * synchronisers, the SWD port, the memories' power-down pins), so they hold what is written and
 * change nothing: memory is not lost by MEMPOWERDOWN. PROC_CONFIG's HALTED bits read 0, since no
 * debugger halts a core. DBGFORCE resets to 0x6.
 */
struct SysCfg
    words: [6]u32

    reset(*self)
        for i in 0..<SYSCFG_WORDS do self.words[i] = 0
        self.words[3] = 0x6

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        if address > syscfg_reg.AUXCTRL_OFFSET then return Err(AccessError.Unmapped)
        Ok(read_lane(self.words[usize(address / 4)], offset, width))

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        if address > syscfg_reg.AUXCTRL_OFFSET then return Err(AccessError.Unmapped)
        val i = usize(address / 4)
        val next = written(self.words[i], offset, replicated(value, width))
        self.words[i] = (self.words[i] & ~SYSCFG_WRITABLE[i]) | (next & SYSCFG_WRITABLE[i])
        Ok(())
end SysCfg

syscfg() -> SysCfg
    var state: SysCfg
    state.reset()
    state
