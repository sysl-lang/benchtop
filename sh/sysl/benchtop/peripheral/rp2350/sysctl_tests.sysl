module sh.sysl.benchtop.peripheral.rp2350
@tests

import sh.sysl.benchtop.peripheral.rp2040.AccessError
import sh.sysl.rp2350.accessctrl as ac
import sysl.buf.{Buf, buf}
import sh.sysl.rp2350.clocks as clk
import sh.sysl.rp2350.powman as pm
import sh.sysl.rp2350.psm as ps
import sh.sysl.rp2350.rosc as rs
import sh.sysl.rp2350.syscfg as sc
import sh.sysl.rp2350.sysinfo as si

// PSM, ROSC, SYSINFO, SYSCFG, POWMAN, ACCESSCTRL and CLOCKS' frequency counter.

private const PSM_ALL: u32 = 0x01FFFFFF
private const PW: u32 = 0x5AFE0000
private const ACCESS_PW: u32 = 0xACCE0000
// FC0_STATUS of a counter whose source never ran: DONE, DIED and FAIL.
private const DEAD: u32 = 0x10010010

@test("PSM: every stage is done at power-on; FRCE_OFF holds a stage and every stage after it, FRCE_ON releases from a later one")
psm_sequencing()
    var p = psm()
    assert(p.read(ps.FRCE_ON_OFFSET, 4).unwrap() == 0 && p.read(ps.FRCE_OFF_OFFSET, 4).unwrap() == 0 && p.read(ps.WDSEL_OFFSET, 4).unwrap() == 0)
    assert(p.read(ps.DONE_OFFSET, 4).unwrap() == PSM_ALL, "all 25 stages are out of reset")
    p.write(ps.FRCE_OFF_OFFSET, 4, ps.FRCE_OFF_PROC1_MASK).unwrap()
    assert(p.read(ps.DONE_OFFSET, 4).unwrap() == PSM_ALL & ~ps.DONE_PROC1_MASK, "PROC1 is the last stage")
    assert(p.read(ps.FRCE_OFF_OFFSET, 4).unwrap() == ps.FRCE_OFF_PROC1_MASK, "FRCE_OFF reads back, which multicore_reset_core1 polls")
    p.write(ps.FRCE_OFF_OFFSET + 0x3000, 4, ps.FRCE_OFF_PROC1_MASK).unwrap()
    assert(p.read(ps.DONE_OFFSET, 4).unwrap() == PSM_ALL, "the CLR alias releases it")
    // CLOCKS is stage 5: it and the nineteen after it wait.
    p.write(ps.FRCE_OFF_OFFSET + 0x2000, 4, ps.FRCE_OFF_CLOCKS_MASK).unwrap()
    assert(p.read(ps.DONE_OFFSET, 4).unwrap() == 0x1F, "stages 0 to 4 only")
    // FRCE_ON on SRAM0 (stage 10) starts the sequence again from there.
    p.write(ps.FRCE_ON_OFFSET, 4, ps.FRCE_ON_SRAM0_MASK).unwrap()
    assert(p.read(ps.DONE_OFFSET, 4).unwrap() == (PSM_ALL & ~0x3FF) | 0x1F, "stages 5 to 9 still wait")
    // FRCE_OFF wins over FRCE_ON for one stage, and takes the later ones with it.
    p.write(ps.FRCE_OFF_OFFSET + 0x2000, 4, ps.FRCE_OFF_SRAM0_MASK).unwrap()
    assert(p.read(ps.DONE_OFFSET, 4).unwrap() == 0x1F)
    p.write(ps.FRCE_OFF_OFFSET, 4, 0).unwrap()
    assert(p.read(ps.DONE_OFFSET, 4).unwrap() == PSM_ALL, "with nothing forced off every stage is done")
    p.write(ps.FRCE_ON_OFFSET + 0x1000, 4, ps.FRCE_ON_SRAM0_MASK).unwrap()
    assert(p.read(ps.FRCE_ON_OFFSET, 4).unwrap() == 0, "XOR toggles")

@test("PSM: WDSEL is stored, DONE is read-only, bits past PROC1 do not exist, and every width and alias works")
psm_registers()
    var p = psm()
    p.write(ps.WDSEL_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(p.read(ps.WDSEL_OFFSET, 4).unwrap() == PSM_ALL, "25 bits")
    p.write(ps.WDSEL_OFFSET + 0x3000, 4, 0x00FF00FF).unwrap()
    assert(p.read(ps.WDSEL_OFFSET, 4).unwrap() == 0x0100FF00)
    p.write(ps.DONE_OFFSET, 4, 0).unwrap()
    assert(p.read(ps.DONE_OFFSET, 4).unwrap() == PSM_ALL, "a write to DONE does nothing")
    assert(p.read(ps.DONE_OFFSET + 3, 1).unwrap() == 0x01, "the top byte")
    p.write(ps.FRCE_ON_OFFSET + 3, 1, 0xFF).unwrap()
    assert(p.read(ps.FRCE_ON_OFFSET, 4).unwrap() == PSM_ALL, "a byte write is replicated over the whole bus, as the APB does")
    p.write(ps.FRCE_ON_OFFSET + 1, 1, 0).unwrap()
    assert(p.read(ps.FRCE_ON_OFFSET, 4).unwrap() == 0, "and replicating a 0 clears the register")
    assert(p.write(ps.FRCE_ON_OFFSET, 3, 0).unwrap_err() == AccessError.InvalidWidth)
    assert(p.read(0x10, 4).unwrap_err() == AccessError.Unmapped && p.write(0x10, 4, 0).unwrap_err() == AccessError.Unmapped)
    assert(p.read(ps.DONE_OFFSET + 1, 4).unwrap_err() == AccessError.Unaligned)
    p.write(ps.FRCE_OFF_OFFSET, 4, 0x100).unwrap()
    p.reset()
    assert(p.read(ps.FRCE_OFF_OFFSET, 4).unwrap() == 0 && p.read(ps.WDSEL_OFFSET, 4).unwrap() == 0)

@test("ROSC powers up running with the datasheet's values, and STATUS says so")
rosc_reset_state()
    var r = rosc()
    assert(r.read(rs.CTRL_OFFSET, 4).unwrap() == 0x00FABAA0, "ENABLE and FREQ_RANGE at power-on")
    assert(r.read(rs.STATUS_OFFSET, 4).unwrap() == rs.STATUS_STABLE_MASK | rs.STATUS_DIV_RUNNING_MASK | rs.STATUS_ENABLED_MASK)
    assert(r.read(rs.DIV_OFFSET, 4).unwrap() == 0xAA20, "div 32")
    assert(r.read(rs.PHASE_OFFSET, 4).unwrap() == 0x008)
    assert(r.read(rs.RANDOM_OFFSET, 4).unwrap() == 0x3F04B16D)
    assert(r.read(rs.DORMANT_OFFSET, 4).unwrap() == rs.DORMANT_DORMANT_WAKE)
    assert(r.read(rs.FREQA_OFFSET, 4).unwrap() == 0 && r.read(rs.FREQB_OFFSET, 4).unwrap() == 0 && r.read(rs.COUNT_OFFSET, 4).unwrap() == 0)
    assert(r.hz(11000000) == 11000000)
    assert(r.read(0x28, 4).unwrap_err() == AccessError.Unmapped)

@test("ROSC: ENABLE takes DISABLE or ENABLE, any other code enables and latches BADWRITE, and BADWRITE clears on a write of 1")
rosc_enable()
    var r = rosc()
    r.write(rs.CTRL_OFFSET, 4, (rs.CTRL_ENABLE_DISABLE << 12) | 0xFA4).unwrap()
    assert(r.hz(11000000) == 0 && r.read(rs.STATUS_OFFSET, 4).unwrap() & (rs.STATUS_STABLE_MASK | rs.STATUS_ENABLED_MASK) == 0)
    assert(r.read(rs.CTRL_OFFSET, 4).unwrap() == 0x00D1EFA4, "the range took effect with it")
    r.write(rs.CTRL_OFFSET, 4, (0x123 << 12) | 0xFA5).unwrap()
    assert(r.hz(11000000) == 11000000, "an invalid code enables")
    assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0)
    r.write(rs.STATUS_OFFSET + 0x3000, 4, rs.STATUS_BADWRITE_MASK).unwrap()
    assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0, "the CLR alias writes no one")
    r.write(rs.STATUS_OFFSET, 4, rs.STATUS_BADWRITE_MASK).unwrap()
    assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK == 0)
    // A range that is not one of the four is refused and keeps the old one.
    r.write(rs.CTRL_OFFSET, 4, (rs.CTRL_ENABLE_ENABLE << 12) | 0x123).unwrap()
    assert(r.read(rs.CTRL_OFFSET, 4).unwrap() == 0x00FABFA5 && r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0)
    // The SDK's hw_write_masked goes through the XOR alias.
    r.write(rs.CTRL_OFFSET + 0x1000, 4, (0xFABu32 ^ 0xD1E) << 12).unwrap()
    assert(r.read(rs.CTRL_OFFSET, 4).unwrap() == 0x00D1EFA5)

@test("ROSC: FREQA, FREQB and PHASE need their passwords, DIV needs 0xAA in its top byte, DORMANT needs its magic words")
rosc_passwords()
    var r = rosc()
    r.write(rs.FREQA_OFFSET, 4, 0x96960000 | 0x7777).unwrap()
    assert(r.read(rs.FREQA_OFFSET, 4).unwrap() == 0x7777 && r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK == 0, "the password reads back as 0")
    r.write(rs.FREQA_OFFSET, 4, 0x00001111).unwrap()
    assert(r.read(rs.FREQA_OFFSET, 4).unwrap() == 0x7777 && r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0, "no password: dropped and latched")
    r.write(rs.STATUS_OFFSET, 4, rs.STATUS_BADWRITE_MASK).unwrap()
    r.write(rs.FREQB_OFFSET, 4, 0x96960000 | 0xFFFF).unwrap()
    assert(r.read(rs.FREQB_OFFSET, 4).unwrap() == 0x7777, "only the drive-strength bits exist")
    r.write(rs.FREQB_OFFSET, 4, 0x96970000).unwrap()
    assert(r.read(rs.FREQB_OFFSET, 4).unwrap() == 0x7777 && r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0)
    r.write(rs.STATUS_OFFSET, 4, rs.STATUS_BADWRITE_MASK).unwrap()
    r.write(rs.PHASE_OFFSET, 4, 0xAA0 | 0xF).unwrap()
    assert(r.read(rs.PHASE_OFFSET, 4).unwrap() == 0xF)
    r.write(rs.PHASE_OFFSET, 4, 0x550 | 0x1).unwrap()
    assert(r.read(rs.PHASE_OFFSET, 4).unwrap() == 0xF && r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0)
    r.write(rs.STATUS_OFFSET, 4, rs.STATUS_BADWRITE_MASK).unwrap()
    r.write(rs.DIV_OFFSET, 4, 0xAA00).unwrap()
    assert(r.read(rs.DIV_OFFSET, 4).unwrap() == 0xAA00, "div 0 is 256")
    r.write(rs.DIV_OFFSET, 4, 0xAA05).unwrap()
    assert(r.read(rs.DIV_OFFSET, 4).unwrap() == 0xAA05 && r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK == 0)
    r.write(rs.DIV_OFFSET, 4, 0x1205).unwrap()
    assert(r.read(rs.DIV_OFFSET, 4).unwrap() == 0xAA00, "any other value sets div 256")
    assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0)
    r.write(rs.STATUS_OFFSET, 4, rs.STATUS_BADWRITE_MASK).unwrap()
    r.write(rs.DORMANT_OFFSET, 4, rs.DORMANT_DORMANT_DORMANT).unwrap()
    assert(r.hz(11000000) == 0 && r.read(rs.DORMANT_OFFSET, 4).unwrap() == rs.DORMANT_DORMANT_DORMANT)
    assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_STABLE_MASK == 0 && r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_ENABLED_MASK != 0, "enabled but paused")
    r.write(rs.DORMANT_OFFSET, 4, 0x12345678).unwrap()
    assert(r.hz(11000000) == 11000000, "an invalid word selects WAKE")
    assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0)

@test("ROSC: RANDOMBIT is the low bit of a seeded 32-bit LFSR, stepping once per read; RANDOM reloads it")
rosc_randombit()
    var r = rosc()
    // The reference: Galois, taps x^32 + x^22 + x^2 + x + 1, first bit out is the seed's bit 0.
    var state: u32 = 0x3F04B16D
    var expected: Buf[u32] = buf()
    for i in 0..<64
        expected.push(state & 1)
        val feedback = state & 1
        state = state >> 1
        if feedback != 0 then state = state ^ 0x80200003
    assert(expected[0] == 1, "RANDOMBIT_RESET is 1")
    for i in 0..<64 do assert(r.read(rs.RANDOMBIT_OFFSET, 4).unwrap() == expected[i], s"read $i")
    assert(r.read(rs.RANDOM_OFFSET, 4).unwrap() == state, "RANDOM reads the present state")
    // The same seed again gives the same sequence; another seed a different one.
    r.write(rs.RANDOM_OFFSET, 4, 0x3F04B16D).unwrap()
    for i in 0..<64 do assert(r.read(rs.RANDOMBIT_OFFSET, 4).unwrap() == expected[i], s"after a reload, read $i")
    r.write(rs.RANDOM_OFFSET, 4, 0x00000002).unwrap()
    assert(r.read(rs.RANDOMBIT_OFFSET, 4).unwrap() == 0 && r.read(rs.RANDOMBIT_OFFSET, 4).unwrap() == 1, "seed 2: bit 0 is 0, then the next state's is 1")
    var ones = 0
    r.write(rs.RANDOM_OFFSET, 4, 0x3F04B16D).unwrap()
    for i in 0..<1000 do ones += i32(r.read(rs.RANDOMBIT_OFFSET, 4).unwrap())
    assert(ones > 400 && ones < 600, s"$ones ones in 1000 bits")
    // Stopped, it holds its level.
    r.write(rs.CTRL_OFFSET, 4, (rs.CTRL_ENABLE_DISABLE << 12) | 0xAA0).unwrap()
    val held = r.read(rs.RANDOMBIT_OFFSET, 4).unwrap()
    for i in 0..<8 do assert(r.read(rs.RANDOMBIT_OFFSET, 4).unwrap() == held)
    r.write(rs.RANDOMBIT_OFFSET, 4, 1).unwrap()
    r.reset()
    assert(r.read(rs.RANDOM_OFFSET, 4).unwrap() == 0x3F04B16D, "the seed at power-on")

@test("ROSC: COUNT counts down at the oscillator's rate and stops at 0, and does not count while stopped")
rosc_count()
    var r = rosc()
    r.write(rs.COUNT_OFFSET, 4, 0x10010).unwrap()
    assert(r.read(rs.COUNT_OFFSET, 4).unwrap() == 0x10, "sixteen bits")
    r.advance(5)
    assert(r.read(rs.COUNT_OFFSET, 4).unwrap() == 11)
    r.write(rs.CTRL_OFFSET, 4, (rs.CTRL_ENABLE_DISABLE << 12) | 0xAA0).unwrap()
    r.advance(100)
    assert(r.read(rs.COUNT_OFFSET, 4).unwrap() == 11, "stopped")
    r.write(rs.CTRL_OFFSET, 4, (rs.CTRL_ENABLE_ENABLE << 12) | 0xAA0).unwrap()
    r.advance(100)
    assert(r.read(rs.COUNT_OFFSET, 4).unwrap() == 0)

@test("SYSINFO: CHIP_ID, PACKAGE_SEL and PLATFORM read the RP2350A's values, GITREF reads 0, writes do nothing")
sysinfo_registers()
    var s = sysinfo()
    val id = s.read(si.CHIP_ID_OFFSET, 4).unwrap()
    assert(id == 0x30004927, "revision 3, part 4, manufacturer 0x493")
    assert((id >> si.CHIP_ID_REVISION_SHIFT) == 3 && ((id >> 12) & 0xFFFF) == 4 && ((id >> 1) & 0x7FF) == 0x493 && id & 1 == 1)
    assert(s.read(si.PACKAGE_SEL_OFFSET, 4).unwrap() == 1, "the QFN60 of the Pico 2's RP2350A")
    assert(s.read(si.PLATFORM_OFFSET, 4).unwrap() == si.PLATFORM_ASIC_MASK)
    assert(s.read(si.GITREF_RP2350_OFFSET, 4).unwrap() == 0)
    s.write(si.CHIP_ID_OFFSET, 4, 0).unwrap()
    s.write(si.PACKAGE_SEL_OFFSET + 0x2000, 4, 0).unwrap()
    assert(s.read(si.CHIP_ID_OFFSET, 4).unwrap() == 0x30004927 && s.read(si.PACKAGE_SEL_OFFSET, 4).unwrap() == 1)
    assert(s.read(si.CHIP_ID_OFFSET + 1, 1).unwrap() == 0x49 && s.read(si.CHIP_ID_OFFSET + 2, 2).unwrap() == 0x3000)
    assert(s.read(0xC, 4).unwrap_err() == AccessError.Unmapped && s.write(0x10, 4, 0).unwrap_err() == AccessError.Unmapped)

@test("SYSCFG: the stored registers keep their writable bits, DBGFORCE resets to 6, PROC_CONFIG is read-only")
syscfg_registers()
    var c = syscfg()
    assert(c.read(sc.PROC_CONFIG_OFFSET, 4).unwrap() == 0 && c.read(sc.PROC_IN_SYNC_BYPASS_OFFSET, 4).unwrap() == 0)
    assert(c.read(sc.PROC_IN_SYNC_BYPASS_HI_OFFSET, 4).unwrap() == 0 && c.read(sc.MEMPOWERDOWN_OFFSET, 4).unwrap() == 0 && c.read(sc.AUXCTRL_OFFSET, 4).unwrap() == 0)
    assert(c.read(sc.DBGFORCE_OFFSET, 4).unwrap() == 6)
    c.write(sc.PROC_CONFIG_OFFSET, 4, 3).unwrap()
    assert(c.read(sc.PROC_CONFIG_OFFSET, 4).unwrap() == 0, "the halted flags are read-only")
    c.write(sc.PROC_IN_SYNC_BYPASS_OFFSET, 4, 0xDEADBEEF).unwrap()
    assert(c.read(sc.PROC_IN_SYNC_BYPASS_OFFSET, 4).unwrap() == 0xDEADBEEF)
    c.write(sc.PROC_IN_SYNC_BYPASS_HI_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(c.read(sc.PROC_IN_SYNC_BYPASS_HI_OFFSET, 4).unwrap() == 0xFF00FFFF)
    c.write(sc.DBGFORCE_OFFSET, 4, 0xF).unwrap()
    assert(c.read(sc.DBGFORCE_OFFSET, 4).unwrap() == 0xE, "SWDO is read-only")
    c.write(sc.MEMPOWERDOWN_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(c.read(sc.MEMPOWERDOWN_OFFSET, 4).unwrap() == 0x1FFF, "thirteen memories")
    c.write(sc.MEMPOWERDOWN_OFFSET + 0x3000, 4, 0x1001).unwrap()
    assert(c.read(sc.MEMPOWERDOWN_OFFSET, 4).unwrap() == 0x0FFE)
    c.write(sc.AUXCTRL_OFFSET + 0x1000, 4, 0x1FF).unwrap()
    assert(c.read(sc.AUXCTRL_OFFSET, 4).unwrap() == 0xFF)
    assert(c.read(0x18, 4).unwrap_err() == AccessError.Unmapped && c.write(0x18, 4, 0).unwrap_err() == AccessError.Unmapped)
    c.reset()
    assert(c.read(sc.MEMPOWERDOWN_OFFSET, 4).unwrap() == 0 && c.read(sc.DBGFORCE_OFFSET, 4).unwrap() == 6)

@test("POWMAN: reset values, and a write without 0x5AFE in bits 31:16 is dropped and latches BADPASSWD")
powman_password()
    var p = powman()
    assert(p.read(pm.VREG_CTRL_OFFSET, 4).unwrap() == 0x8050 && p.read(pm.VREG_OFFSET, 4).unwrap() == 0xB0 && p.read(pm.VREG_LP_ENTRY_OFFSET, 4).unwrap() == 0xB4)
    assert(p.read(pm.VREG_LP_EXIT_OFFSET, 4).unwrap() == 0xB0 && p.read(pm.BOD_OFFSET, 4).unwrap() == 0xB1 && p.read(pm.BOD_LP_ENTRY_OFFSET, 4).unwrap() == 0xB0)
    assert(p.read(pm.BOD_LP_EXIT_OFFSET, 4).unwrap() == 0xB1 && p.read(pm.LPOSC_OFFSET, 4).unwrap() == 0x203 && p.read(pm.SEQ_CFG_OFFSET, 4).unwrap() == 0x001011F0)
    assert(p.read(pm.POW_FASTDIV_OFFSET, 4).unwrap() == 0x40 && p.read(pm.POW_DELAY_OFFSET, 4).unwrap() == 0x2011 && p.read(pm.EXT_CTRL0_OFFSET, 4).unwrap() == 0x3F)
    assert(p.read(pm.EXT_CTRL1_OFFSET, 4).unwrap() == 0x3F && p.read(pm.LPOSC_FREQ_KHZ_INT_OFFSET, 4).unwrap() == 0x20 && p.read(pm.LPOSC_FREQ_KHZ_FRAC_OFFSET, 4).unwrap() == 0xC49C)
    assert(p.read(pm.XOSC_FREQ_KHZ_INT_OFFSET, 4).unwrap() == 0x2EE0 && p.read(pm.XOSC_FREQ_KHZ_FRAC_OFFSET, 4).unwrap() == 0)
    assert(p.read(pm.VREG_STS_OFFSET, 4).unwrap() == 1, "VOUT_OK")
    assert(p.read(pm.CHIP_RESET_OFFSET, 4).unwrap() == pm.CHIP_RESET_HAD_POR_MASK, "the last reset was the power-on")
    assert(p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 0)
    p.write(pm.WDSEL_OFFSET, 4, 0x1111).unwrap()
    assert(p.read(pm.WDSEL_OFFSET, 4).unwrap() == 0, "no password")
    assert(p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 1)
    p.write(pm.WDSEL_OFFSET, 4, 0x5AFF0000 | 0x1111).unwrap()
    assert(p.read(pm.WDSEL_OFFSET, 4).unwrap() == 0, "a near miss")
    p.write(pm.WDSEL_OFFSET, 2, 0x5AFE).unwrap()
    assert(p.read(pm.WDSEL_OFFSET, 4).unwrap() == 0x1111 & 0x5AFE, "a halfword write is replicated, so its password lands in the top half too")
    p.write(pm.WDSEL_OFFSET, 4, PW | 0x1111).unwrap()
    assert(p.read(pm.WDSEL_OFFSET, 4).unwrap() == 0x1111, "the password is right and the data is 16 bits")
    p.write(pm.BADPASSWD_OFFSET, 4, 1).unwrap()
    assert(p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 1, "clearing BADPASSWD takes the password too")
    p.write(pm.BADPASSWD_OFFSET, 4, PW | 1).unwrap()
    assert(p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 0)

@test("POWMAN: SET, CLR and XOR aliases carry the password, as the SDK's powman_set_bits does; only the low 16 bits exist")
powman_aliases()
    var p = powman()
    p.write(pm.EXT_CTRL0_OFFSET + 0x3000, 4, PW | 0x3F).unwrap()
    assert(p.read(pm.EXT_CTRL0_OFFSET, 4).unwrap() == 0 && p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 0)
    p.write(pm.EXT_CTRL0_OFFSET + 0x2000, 4, PW | 0x4001).unwrap()
    assert(p.read(pm.EXT_CTRL0_OFFSET, 4).unwrap() == 0x4001)
    p.write(pm.EXT_CTRL0_OFFSET + 0x1000, 4, PW | 0x4000).unwrap()
    assert(p.read(pm.EXT_CTRL0_OFFSET, 4).unwrap() == 0x0001)
    p.write(pm.EXT_CTRL0_OFFSET + 0x2000, 4, 0x0000FFFF).unwrap()
    assert(p.read(pm.EXT_CTRL0_OFFSET, 4).unwrap() == 0x0001 && p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 1, "a SET without the password is dropped")
    p.write(pm.POW_DELAY_OFFSET, 4, PW | 0xFFFF).unwrap()
    assert(p.read(pm.POW_DELAY_OFFSET, 4).unwrap() == 0xFFFF)
    p.write(pm.POW_FASTDIV_OFFSET, 4, PW | 0xFFFF).unwrap()
    assert(p.read(pm.POW_FASTDIV_OFFSET, 4).unwrap() == 0x7FF, "eleven bits")

@test("POWMAN: SCRATCH0-7 and BOOT0-3 are 32 bits wide and take no password")
powman_scratch()
    var p = powman()
    for i in 0u32..<8
        p.write(pm.SCRATCH0_OFFSET + 4 * i, 4, 0xA5000000 | i).unwrap()
    for i in 0u32..<8
        assert(p.read(pm.SCRATCH0_OFFSET + 4 * i, 4).unwrap() == 0xA5000000 | i)
    for i in 0u32..<4
        p.write(pm.BOOT0_OFFSET + 4 * i, 4, 0xB0000000 | i).unwrap()
        assert(p.read(pm.BOOT0_OFFSET + 4 * i, 4).unwrap() == 0xB0000000 | i)
    p.write(pm.SCRATCH3_OFFSET + 0x3000, 4, 0xFF000000).unwrap()
    assert(p.read(pm.SCRATCH3_OFFSET, 4).unwrap() == 0x00000003)
    assert(p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 0, "none of it was a bad password")

@test("POWMAN: the regulator's registers drop writes until VREG_CTRL.UNLOCK is set, UNLOCK cannot be cleared, and VSEL is limited to 1.30 V")
powman_vreg()
    var p = powman()
    p.write(pm.VREG_OFFSET, 4, PW | (0x0F << 4)).unwrap()
    assert(p.read(pm.VREG_OFFSET, 4).unwrap() == 0xB0, "locked")
    p.write(pm.VREG_CTRL_OFFSET + 0x2000, 4, PW | pm.VREG_CTRL_UNLOCK_MASK).unwrap()
    assert(p.read(pm.VREG_CTRL_OFFSET, 4).unwrap() == 0x8050 | pm.VREG_CTRL_UNLOCK_MASK)
    // vreg_set_voltage's hw_write_masked: the XOR of the change, masked, with the password.
    p.write(pm.VREG_OFFSET + 0x1000, 4, PW | ((0x0B ^ 0x0F) << 4)).unwrap()
    assert(p.read(pm.VREG_OFFSET, 4).unwrap() == 0xF0 && p.vreg_vsel() == 0xF, "1.30 V")
    assert(p.read(pm.VREG_OFFSET, 4).unwrap() & 0x8000 == 0, "UPDATE_IN_PROGRESS is clear: the update is done at once")
    p.write(pm.VREG_OFFSET, 4, PW | (0x11 << 4)).unwrap()
    assert(p.read(pm.VREG_OFFSET, 4).unwrap() == 0x110 && p.vreg_vsel() == 0xF, "1.40 V is stored but the regulator holds 1.30 V")
    p.write(pm.VREG_CTRL_OFFSET + 0x2000, 4, PW | pm.VREG_CTRL_DISABLE_VOLTAGE_LIMIT_MASK).unwrap()
    assert(p.vreg_vsel() == 0x11, "the limit is off")
    p.write(pm.VREG_CTRL_OFFSET + 0x3000, 4, PW | pm.VREG_CTRL_UNLOCK_MASK | pm.VREG_CTRL_ISOLATE_MASK).unwrap()
    assert(p.read(pm.VREG_CTRL_OFFSET, 4).unwrap() & pm.VREG_CTRL_UNLOCK_MASK != 0, "UNLOCK stays")
    p.write(pm.VREG_CTRL_OFFSET, 4, PW).unwrap()
    assert(p.read(pm.VREG_CTRL_OFFSET, 4).unwrap() & pm.VREG_CTRL_UNLOCK_MASK != 0)
    p.write(pm.VREG_STS_OFFSET, 4, PW | 0x11).unwrap()
    assert(p.read(pm.VREG_STS_OFFSET, 4).unwrap() == 1, "read-only")
    p.write(pm.VREG_LP_ENTRY_OFFSET, 4, PW | 0x1FF).unwrap()
    assert(p.read(pm.VREG_LP_ENTRY_OFFSET, 4).unwrap() == 0x1F6, "VSEL, MODE and HIZ")
    p.reset()
    assert(p.read(pm.VREG_CTRL_OFFSET, 4).unwrap() == 0x8050, "a power-on locks it again")

@test("POWMAN: CHIP_RESET's flags, the interrupt registers, and the power-state registers refused by name")
powman_interrupts_and_refusals()
    var p = powman()
    p.write(pm.CHIP_RESET_OFFSET, 4, PW | 0xFFFF).unwrap()
    assert(p.read(pm.CHIP_RESET_OFFSET, 4).unwrap() == pm.CHIP_RESET_HAD_POR_MASK | pm.CHIP_RESET_DOUBLE_TAP_MASK, "HAD_* are read-only; DOUBLE_TAP is read-write")
    p.write(pm.INTE_OFFSET, 4, PW | 0xF).unwrap()
    assert(!p.irq_pow() && !p.irq_timer())
    p.write(pm.INTF_OFFSET, 4, PW | pm.INTR_TIMER_MASK).unwrap()
    assert(!p.irq_pow() && p.irq_timer() && p.read(pm.INTS_OFFSET, 4).unwrap() == pm.INTR_TIMER_MASK)
    p.write(pm.INTF_OFFSET, 4, PW | pm.INTR_VREG_OUTPUT_LOW_MASK).unwrap()
    assert(p.irq_pow() && p.read(pm.INTS_OFFSET, 4).unwrap() == pm.INTR_VREG_OUTPUT_LOW_MASK)
    p.write(pm.INTE_OFFSET, 4, PW).unwrap()
    assert(!p.irq_pow() && p.read(pm.INTS_OFFSET, 4).unwrap() == 0, "masked")
    p.write(pm.INTS_OFFSET, 4, PW | 0xF).unwrap()
    assert(p.read(pm.INTS_OFFSET, 4).unwrap() == 0, "INTS is read-only")
    // The power states and power-up requests: the chip never leaves its all-on state.
    for off in [pm.STATE_OFFSET, pm.PWRUP0_OFFSET, pm.PWRUP1_OFFSET, pm.PWRUP2_OFFSET, pm.PWRUP3_OFFSET, pm.CURRENT_PWRUP_REQ_OFFSET,
            pm.LAST_SWCORE_PWRUP_OFFSET, pm.BOOTDIS_OFFSET]
        assert(p.read(off, 4).unwrap_err() == AccessError.Unmapped, s"read 0x${off}")
        assert(p.write(off, 4, PW).unwrap_err() == AccessError.Unmapped, s"write 0x${off}")
    assert(p.read(0xF0, 4).unwrap_err() == AccessError.Unmapped)

@test("ACCESSCTRL: reset values, the 0xACCE password, unprotected GPIO_NSMASK, and the registers' masks")
accessctrl_registers()
    var a = accessctrl()
    assert(a.read(ac.LOCK_OFFSET, 4).unwrap() == 0x4 && a.read(ac.FORCE_CORE_NS_OFFSET, 4).unwrap() == 0 && a.read(ac.CFGRESET_OFFSET, 4).unwrap() == 0)
    assert(a.read(ac.GPIO_NSMASK0_OFFSET, 4).unwrap() == 0 && a.read(ac.GPIO_NSMASK1_OFFSET, 4).unwrap() == 0)
    assert(a.read(ac.ROM_OFFSET, 4).unwrap() == 0xFF && a.read(ac.XIP_MAIN_OFFSET, 4).unwrap() == 0xFF && a.read(ac.SRAM9_OFFSET, 4).unwrap() == 0xFF)
    assert(a.read(ac.DMA_OFFSET, 4).unwrap() == 0xFC && a.read(ac.PIO2_OFFSET, 4).unwrap() == 0xFC && a.read(ac.UART1_OFFSET, 4).unwrap() == 0xFC)
    assert(a.read(ac.CORESIGHT_TRACE_OFFSET, 4).unwrap() == 0xB8 && a.read(ac.CORESIGHT_PERIPH_OFFSET, 4).unwrap() == 0xB8)
    assert(a.read(ac.SYSINFO_OFFSET, 4).unwrap() == 0xFF && a.read(ac.RESETS_OFFSET, 4).unwrap() == 0xFC && a.read(ac.TBMAN_OFFSET, 4).unwrap() == 0xFC)
    assert(a.read(ac.POWMAN_OFFSET, 4).unwrap() == 0xB8 && a.read(ac.TRNG_OFFSET, 4).unwrap() == 0xB8 && a.read(ac.SHA256_OFFSET, 4).unwrap() == 0xF8)
    assert(a.read(ac.SYSCFG_OFFSET, 4).unwrap() == 0xB8 && a.read(ac.PSM_OFFSET, 4).unwrap() == 0xB8 && a.read(ac.XIP_QMI_OFFSET, 4).unwrap() == 0xB8 && a.read(ac.XIP_AUX_OFFSET, 4).unwrap() == 0xF8)
    a.write(0, ac.UART0_OFFSET, 4, 0x03).unwrap()
    assert(a.read(ac.UART0_OFFSET, 4).unwrap() == 0xFC, "no password: dropped")
    a.write(0, ac.UART0_OFFSET, 4, 0x5AFE0000 | 0x03).unwrap()
    assert(a.read(ac.UART0_OFFSET, 4).unwrap() == 0xFC, "the wrong password")
    a.write(0, ac.UART0_OFFSET, 4, ACCESS_PW | 0x03).unwrap()
    assert(a.read(ac.UART0_OFFSET, 4).unwrap() == 0x03, "written")
    a.write(0, ac.UART0_OFFSET + 0x2000, 4, ACCESS_PW | 0xFFFF).unwrap()
    assert(a.read(ac.UART0_OFFSET, 4).unwrap() == 0xFF, "eight bits")
    a.write(0, ac.UART0_OFFSET + 0x3000, 4, ACCESS_PW | 0x0F).unwrap()
    a.write(0, ac.UART0_OFFSET + 0x1000, 4, ACCESS_PW | 0x81).unwrap()
    assert(a.read(ac.UART0_OFFSET, 4).unwrap() == 0x71)
    a.write(0, ac.GPIO_NSMASK0_OFFSET, 4, 0xF0F0F0F0).unwrap()
    a.write(0, ac.GPIO_NSMASK1_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(a.read(ac.GPIO_NSMASK0_OFFSET, 4).unwrap() == 0xF0F0F0F0, "gpio_set_ns writes it with no password")
    assert(a.read(ac.GPIO_NSMASK1_OFFSET, 4).unwrap() == 0xFF00FFFF)
    a.write(0, ac.FORCE_CORE_NS_OFFSET, 4, ACCESS_PW | 0xFF).unwrap()
    assert(a.read(ac.FORCE_CORE_NS_OFFSET, 4).unwrap() == 0x2, "only core 1's bit")
    assert(a.read(0xEC, 4).unwrap_err() == AccessError.Unmapped && a.write(0, 0xEC, 4, ACCESS_PW).unwrap_err() == AccessError.Unmapped)
    assert(a.read(ac.UART0_OFFSET + 1, 4).unwrap_err() == AccessError.Unaligned)

@test("ACCESSCTRL: LOCK bits set and never clear, a locked core's writes are dropped, and CFGRESET restores all but LOCK and FORCE_CORE_NS")
accessctrl_lock_and_cfgreset()
    var a = accessctrl()
    a.write(0, ac.PWM_OFFSET, 4, ACCESS_PW | 0x11).unwrap()
    a.write(0, ac.GPIO_NSMASK0_OFFSET, 4, 0xFFFF).unwrap()
    a.write(0, ac.FORCE_CORE_NS_OFFSET, 4, ACCESS_PW | 0x2).unwrap()
    a.write(0, ac.CFGRESET_OFFSET, 4, ACCESS_PW | 1).unwrap()
    assert(a.read(ac.PWM_OFFSET, 4).unwrap() == 0xFC && a.read(ac.GPIO_NSMASK0_OFFSET, 4).unwrap() == 0, "CFGRESET")
    assert(a.read(ac.FORCE_CORE_NS_OFFSET, 4).unwrap() == 0x2 && a.read(ac.LOCK_OFFSET, 4).unwrap() == 0x4, "but not FORCE_CORE_NS")
    a.write(0, ac.PWM_OFFSET, 4, ACCESS_PW | 0x11).unwrap()
    a.write(0, ac.CFGRESET_OFFSET, 4, 1).unwrap()
    assert(a.read(ac.PWM_OFFSET, 4).unwrap() == 0x11, "CFGRESET needs the password too")
    a.write(0, ac.CFGRESET_OFFSET + 0x3000, 4, ACCESS_PW | 1).unwrap()
    assert(a.read(ac.PWM_OFFSET, 4).unwrap() == 0x11, "a clear alias writes no one")
    // Core 1 locks itself out.
    a.write(1, ac.LOCK_OFFSET, 4, ACCESS_PW | 0x2).unwrap()
    assert(a.read(ac.LOCK_OFFSET, 4).unwrap() == 0x6)
    a.write(1, ac.PWM_OFFSET, 4, ACCESS_PW | 0xFF).unwrap()
    assert(a.read(ac.PWM_OFFSET, 4).unwrap() == 0x11, "core 1 is locked out")
    a.write(0, ac.PWM_OFFSET, 4, ACCESS_PW | 0xFF).unwrap()
    assert(a.read(ac.PWM_OFFSET, 4).unwrap() == 0xFF, "core 0 is not")
    a.write(1, ac.LOCK_OFFSET, 4, ACCESS_PW).unwrap()
    a.write(0, ac.LOCK_OFFSET + 0x3000, 4, ACCESS_PW | 0xF).unwrap()
    a.write(0, ac.LOCK_OFFSET, 4, ACCESS_PW).unwrap()
    assert(a.read(ac.LOCK_OFFSET, 4).unwrap() == 0x6, "set once, never cleared, and DMA is hardwired")
    a.write(0, ac.LOCK_OFFSET, 4, ACCESS_PW | 0x1).unwrap()
    assert(a.read(ac.LOCK_OFFSET, 4).unwrap() == 0x7)
    a.write(0, ac.PWM_OFFSET, 4, ACCESS_PW).unwrap()
    a.write(0, ac.GPIO_NSMASK0_OFFSET, 4, 0).unwrap()
    assert(a.read(ac.PWM_OFFSET, 4).unwrap() == 0xFF, "now core 0 is locked out too, and its GPIO_NSMASK write")
    a.reset()
    assert(a.read(ac.LOCK_OFFSET, 4).unwrap() == 0x4 && a.read(ac.FORCE_CORE_NS_OFFSET, 4).unwrap() == 0 && a.read(ac.PWM_OFFSET, 4).unwrap() == 0xFC, "only a reset clears LOCK")

// The clock tree FC0 measures in the tests: ring 11 MHz, crystal 12 MHz, PLLs at 150 and 48 MHz.
private tree() -> Sources = Sources(11000000, 12000000, 32768, 150000000, 48000000)

// Clocks as runtime_init leaves them: clk_ref from the crystal, clk_sys from PLL_SYS, and the four
// auxiliary generators on and undivided.
private running_clocks() -> Clocks
    var c = clocks()
    c.write(clk.CLK_REF_CTRL_OFFSET, 4, clk.CLK_REF_CTRL_SRC_XOSC_CLKSRC).unwrap()
    c.write(clk.CLK_SYS_CTRL_OFFSET, 4, 1).unwrap()
    // clk_peri from clk_sys; clk_usb and clk_adc from PLL_USB; clk_hstx from clk_sys.
    c.write(clk.CLK_PERI_CTRL_OFFSET, 4, 0x800).unwrap()
    c.write(clk.CLK_USB_CTRL_OFFSET, 4, 0x800).unwrap()
    c.write(clk.CLK_ADC_CTRL_OFFSET, 4, 0x800).unwrap()
    c.write(clk.CLK_HSTX_CTRL_OFFSET, 4, 0x800).unwrap()
    c

// Count `src` the way the SDK's frequency_count_khz does, with FC0_REF_KHZ at `ref_khz`, and answer
// RESULT.
private count(c: *Clocks, src: u32, ref_khz: u32) -> u32
    c.write(clk.FC0_REF_KHZ_OFFSET, 4, ref_khz).unwrap()
    c.write(clk.FC0_SRC_OFFSET, 4, src).unwrap()
    c.measure(tree())
    c.read(clk.FC0_RESULT_OFFSET, 4).unwrap()

@test("CLOCKS FC0: reset values, and FC0_STATUS and FC0_RESULT read 0 until a count has run")
fc0_reset()
    var c = clocks()
    assert(c.read(clk.FC0_REF_KHZ_OFFSET, 4).unwrap() == 0 && c.read(clk.FC0_MIN_KHZ_OFFSET, 4).unwrap() == 0)
    assert(c.read(clk.FC0_MAX_KHZ_OFFSET, 4).unwrap() == 0x1FFFFFF && c.read(clk.FC0_DELAY_OFFSET, 4).unwrap() == 1)
    assert(c.read(clk.FC0_INTERVAL_OFFSET, 4).unwrap() == 8 && c.read(clk.FC0_SRC_OFFSET, 4).unwrap() == 0)
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == 0 && c.read(clk.FC0_RESULT_OFFSET, 4).unwrap() == 0)

@test("CLOCKS FC0: the registers keep only their own bits, STATUS and RESULT are read-only")
fc0_register_widths()
    var c = clocks()
    c.write(clk.FC0_REF_KHZ_OFFSET, 4, 0xFFFFFFFF).unwrap()
    c.write(clk.FC0_MIN_KHZ_OFFSET, 4, 0xFFFFFFFF).unwrap()
    c.write(clk.FC0_MAX_KHZ_OFFSET, 4, 0xFFFFFFFF).unwrap()
    c.write(clk.FC0_DELAY_OFFSET, 4, 0xFFFFFFFF).unwrap()
    c.write(clk.FC0_INTERVAL_OFFSET, 4, 0xFFFFFFFF).unwrap()
    c.write(clk.FC0_SRC_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(c.read(clk.FC0_REF_KHZ_OFFSET, 4).unwrap() == 0xFFFFF && c.read(clk.FC0_MIN_KHZ_OFFSET, 4).unwrap() == 0x1FFFFFF)
    assert(c.read(clk.FC0_MAX_KHZ_OFFSET, 4).unwrap() == 0x1FFFFFF && c.read(clk.FC0_DELAY_OFFSET, 4).unwrap() == 7)
    assert(c.read(clk.FC0_INTERVAL_OFFSET, 4).unwrap() == 0xF && c.read(clk.FC0_SRC_OFFSET, 4).unwrap() == 0xFF)
    c.measure(tree())
    val status = c.read(clk.FC0_STATUS_OFFSET, 4).unwrap()
    val result = c.read(clk.FC0_RESULT_OFFSET, 4).unwrap()
    c.write(clk.FC0_STATUS_OFFSET, 4, 0).unwrap()
    c.write(clk.FC0_RESULT_OFFSET + 0x2000, 4, 0xFFFFFFFF).unwrap()
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == status && c.read(clk.FC0_RESULT_OFFSET, 4).unwrap() == result)
    c.write(clk.FC0_SRC_OFFSET + 0x3000, 4, 0xFF).unwrap()
    assert(c.read(clk.FC0_SRC_OFFSET, 4).unwrap() == 0)

@test("CLOCKS FC0: every source reads the frequency of the tree, in kHz with five fractional bits")
fc0_each_source()
    var c = running_clocks()
    // clk_ref is the crystal, so FC0_REF_KHZ is 12000.
    assert(count(&c, clk.FC0_SRC_FC0_SRC_PLL_SYS_CLKSRC_PRIMARY, 12000) == 150000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_PLL_USB_CLKSRC_PRIMARY, 12000) == 48000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_ROSC_CLKSRC, 12000) == 11000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_ROSC_CLKSRC_PH, 12000) == 11000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_XOSC_CLKSRC, 12000) == 12000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_CLK_REF, 12000) == 12000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_CLK_SYS, 12000) == 150000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_CLK_PERI, 12000) == 150000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_CLK_USB, 12000) == 48000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_CLK_ADC, 12000) == 48000 * 32)
    assert(count(&c, clk.FC0_SRC_FC0_SRC_CLK_HSTX, 12000) == 150000 * 32)
    // 32768 Hz is 32.768 kHz: 1048 in 27.5 fixed point, 32 whole kHz.
    assert(count(&c, clk.FC0_SRC_FC0_SRC_LPOSC_CLKSRC, 12000) == 1048)
    val status = c.read(clk.FC0_STATUS_OFFSET, 4).unwrap()
    assert(status == 0x11, "DONE and PASS")
    assert(c.read(clk.FC0_RESULT_OFFSET, 4).unwrap() >> 5 == 32)
    // A source of 0 stops the counter and clears its result.
    c.write(clk.FC0_SRC_OFFSET, 4, 0).unwrap()
    c.measure(tree())
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == 0 && c.read(clk.FC0_RESULT_OFFSET, 4).unwrap() == 0)

@test("CLOCKS FC0: the reference setting scales the answer, a stopped source or reference finishes DIED and FAIL with a result of 0")
fc0_references_and_dead_sources()
    var c = running_clocks()
    assert(count(&c, clk.FC0_SRC_FC0_SRC_XOSC_CLKSRC, 0) == 0 && c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == 0x11, "FC0_REF_KHZ left at 0 reads 0")
    assert(count(&c, clk.FC0_SRC_FC0_SRC_XOSC_CLKSRC, 6000) == 6000 * 32, "half the real reference reads half")
    assert(count(&c, clk.FC0_SRC_FC0_SRC_XOSC_CLKSRC, 0xFFFFF) == 0xFFFFF * 32, "the largest setting")
    // GPIN0, GPIN1, OTP's clock and the DFT tap have no source in the model (the chip refuses them at
    // the write; the counter itself reads them as dead clocks).
    for src in [clk.FC0_SRC_FC0_SRC_CLKSRC_GPIN0, clk.FC0_SRC_FC0_SRC_CLKSRC_GPIN1, clk.FC0_SRC_FC0_SRC_OTP_CLK2FC, clk.FC0_SRC_FC0_SRC_PLL_USB_CLKSRC_PRIMARY_DFT, 0x11, 0xFF]
        assert(count(&c, src, 12000) == 0 && c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == DEAD, s"source $src died")
    // A stopped clock: clk_peri disabled, then killed.
    c.write(clk.CLK_PERI_CTRL_OFFSET, 4, 0).unwrap()
    assert(count(&c, clk.FC0_SRC_FC0_SRC_CLK_PERI, 12000) == 0 && c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == DEAD)
    c.write(clk.CLK_PERI_CTRL_OFFSET, 4, 0x800 | 0x400).unwrap()
    assert(count(&c, clk.FC0_SRC_FC0_SRC_CLK_PERI, 12000) == 0 && c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == DEAD, "KILL stops it")
    // With a minimum set, a dead clock is also too slow; the result is still 0 and the counter is done.
    c.write(clk.FC0_MIN_KHZ_OFFSET, 4, 1).unwrap()
    assert(count(&c, clk.FC0_SRC_FC0_SRC_CLK_PERI, 12000) == 0 && c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == DEAD | 0x100000)
    c.write(clk.FC0_MIN_KHZ_OFFSET, 4, 0).unwrap()
    // A stopped PLL, and a stopped reference (clk_ref from a crystal that is off).
    c.write(clk.FC0_SRC_OFFSET, 4, clk.FC0_SRC_FC0_SRC_PLL_SYS_CLKSRC_PRIMARY).unwrap()
    c.measure(Sources(11000000, 12000000, 32768, 0, 0))
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == DEAD && c.read(clk.FC0_RESULT_OFFSET, 4).unwrap() == 0, "PLL_SYS is down")
    c.write(clk.FC0_SRC_OFFSET, 4, clk.FC0_SRC_FC0_SRC_ROSC_CLKSRC).unwrap()
    c.measure(Sources(11000000, 0, 32768, 0, 0))
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == DEAD, "clk_ref has no crystal to run from, so nothing can be counted")
    // With the ring as clk_ref the reference is 11 MHz, and a FC0_REF_KHZ of 12000 is 9% too high:
    // the crystal reads 12000 x 12000 / 11000 kHz.
    c.write(clk.CLK_REF_CTRL_OFFSET, 4, 0).unwrap()
    assert(count(&c, clk.FC0_SRC_FC0_SRC_XOSC_CLKSRC, 12000) == 418909)
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == 0x11)

@test("CLOCKS FC0: MIN_KHZ and MAX_KHZ decide PASS, FAIL, SLOW and FAST on the whole kHz, at both edges")
fc0_pass_fail()
    var c = running_clocks()
    c.write(clk.FC0_REF_KHZ_OFFSET, 4, 12000).unwrap()
    c.write(clk.FC0_SRC_OFFSET, 4, clk.FC0_SRC_FC0_SRC_CLK_SYS).unwrap()
    c.write(clk.FC0_MIN_KHZ_OFFSET, 4, 150000).unwrap()
    c.write(clk.FC0_MAX_KHZ_OFFSET, 4, 150000).unwrap()
    c.measure(tree())
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == 0x11, "exactly on both limits passes")
    c.write(clk.FC0_MIN_KHZ_OFFSET, 4, 150001).unwrap()
    c.write(clk.FC0_MAX_KHZ_OFFSET, 4, 0x1FFFFFF).unwrap()
    c.measure(tree())
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == 0x10 | 0x10000 | 0x100000, "one kHz under MIN: DONE, FAIL, SLOW")
    c.write(clk.FC0_MIN_KHZ_OFFSET, 4, 0).unwrap()
    c.write(clk.FC0_MAX_KHZ_OFFSET, 4, 149999).unwrap()
    c.measure(tree())
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == 0x10 | 0x10000 | 0x1000000, "one kHz over MAX: DONE, FAIL, FAST")
    // The limits compare the whole kHz: 150000.97 kHz still counts as 150000.
    c.write(clk.FC0_MAX_KHZ_OFFSET, 4, 150000).unwrap()
    c.measure(Sources(11000000, 12000000, 32768, 150000970, 48000000))
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == 0x11)
    c.write(clk.FC0_MIN_KHZ_OFFSET, 4, 0x1FFFFFF).unwrap()
    c.write(clk.FC0_MAX_KHZ_OFFSET, 4, 0).unwrap()
    c.measure(tree())
    assert(c.read(clk.FC0_STATUS_OFFSET, 4).unwrap() == 0x10 | 0x10000 | 0x100000 | 0x1000000, "MIN above MAX misses on both sides")

@test("CLOCKS: clk_peri, clk_usb, clk_adc and clk_hstx follow their AUXSRC mux and DIV while enabled; a stopped or killed one reads 0")
generators_follow_their_muxes()
    var c = clocks()
    val s = tree()
    assert(c.peri_hz(s) == 0 && c.usb_hz(s) == 0 && c.adc_hz(s) == 0 && c.hstx_hz(s) == 0, "all stopped at power-on")
    // clk_peri: 0 clk_sys, 1 PLL_SYS, 2 PLL_USB, 3 ROSC, 4 XOSC, 5 and 6 pins.
    let_peri(&c, 0, 1)
    assert(c.peri_hz(s) == c.sys_hz(s) && c.peri_hz(s) == 11000000, "clk_sys at power-on is the ring")
    let_peri(&c, 1, 1)
    assert(c.peri_hz(s) == 150000000)
    let_peri(&c, 2, 1)
    assert(c.peri_hz(s) == 48000000)
    let_peri(&c, 3, 1)
    assert(c.peri_hz(s) == 11000000)
    let_peri(&c, 4, 1)
    assert(c.peri_hz(s) == 12000000)
    let_peri(&c, 5, 1)
    assert(c.peri_hz(s) == 0, "GPIN0 has no source")
    let_peri(&c, 7, 1)
    assert(c.peri_hz(s) == 0, "a reserved AUXSRC")
    // DIV.INT is two bits wide for clk_peri; 0 divides by 4.
    for k in 1u32..<4
        let_peri(&c, 1, k)
        assert(c.peri_hz(s) == 150000000 / u64(k), s"divisor $k")
    let_peri(&c, 1, 0)
    assert(c.peri_hz(s) == 150000000 / 4, "an INT of 0 divides by 4")
    c.write(clk.CLK_PERI_CTRL_OFFSET, 4, (1 << 5) | 0x800 | 0x400).unwrap()
    assert(c.peri_hz(s) == 0, "KILL")
    c.write(clk.CLK_PERI_CTRL_OFFSET, 4, 1 << 5).unwrap()
    assert(c.peri_hz(s) == 0, "not enabled")
    // clk_usb and clk_adc: 0 PLL_USB, 1 PLL_SYS, 2 ROSC, 3 XOSC; DIV.INT is four bits and 0 divides by 16.
    c.write(clk.CLK_USB_CTRL_OFFSET, 4, 0x800).unwrap()
    c.write(clk.CLK_USB_DIV_OFFSET, 4, 1 << 16).unwrap()
    assert(c.usb_hz(s) == 48000000)
    c.write(clk.CLK_USB_CTRL_OFFSET, 4, 0x800 | (1 << 5)).unwrap()
    assert(c.usb_hz(s) == 150000000)
    c.write(clk.CLK_USB_CTRL_OFFSET, 4, 0x800 | (2 << 5)).unwrap()
    assert(c.usb_hz(s) == 11000000)
    c.write(clk.CLK_USB_CTRL_OFFSET, 4, 0x800 | (3 << 5)).unwrap()
    assert(c.usb_hz(s) == 12000000)
    c.write(clk.CLK_USB_CTRL_OFFSET, 4, 0x800 | (4 << 5)).unwrap()
    assert(c.usb_hz(s) == 0)
    c.write(clk.CLK_USB_CTRL_OFFSET, 4, 0x800).unwrap()
    c.write(clk.CLK_USB_DIV_OFFSET, 4, 15 << 16).unwrap()
    assert(c.usb_hz(s) == 3200000)
    c.write(clk.CLK_USB_DIV_OFFSET, 4, 0).unwrap()
    assert(c.usb_hz(s) == 3000000, "0 is 16")
    c.write(clk.CLK_USB_DIV_OFFSET, 4, 0xFFFF0000).unwrap()
    assert(c.usb_hz(s) == 3200000, "only the four INT bits count")
    c.write(clk.CLK_ADC_CTRL_OFFSET, 4, 0x800).unwrap()
    c.write(clk.CLK_ADC_DIV_OFFSET, 4, 1 << 16).unwrap()
    assert(c.adc_hz(s) == 48000000)
    c.write(clk.CLK_ADC_CTRL_OFFSET, 4, 0x800 | 0x400).unwrap()
    assert(c.adc_hz(s) == 0)
    // clk_hstx: 0 clk_sys, 1 PLL_SYS, 2 PLL_USB, 3 and 4 pins.
    c.write(clk.CLK_HSTX_CTRL_OFFSET, 4, 0x800 | (1 << 5)).unwrap()
    c.write(clk.CLK_HSTX_DIV_OFFSET, 4, 2 << 16).unwrap()
    assert(c.hstx_hz(s) == 75000000)
    c.write(clk.CLK_HSTX_CTRL_OFFSET, 4, 0x800 | (2 << 5)).unwrap()
    assert(c.hstx_hz(s) == 24000000)
    c.write(clk.CLK_HSTX_CTRL_OFFSET, 4, 0x800 | (3 << 5)).unwrap()
    assert(c.hstx_hz(s) == 0)

// Point clk_peri at AUXSRC `aux`, enabled, with DIV.INT `div`.
private let_peri(c: *Clocks, aux: u32, div: u32)
    c.write(clk.CLK_PERI_CTRL_OFFSET, 4, (aux << 5) | 0x800).unwrap()
    c.write(clk.CLK_PERI_DIV_OFFSET, 4, div << 16).unwrap()
