module sh.sysl.benchtop.peripheral.rp2350
@tests

import sh.sysl.rp2350.hstx_ctrl as hr
import sh.sysl.rp2350.hstx_fifo as hf
import sh.sysl.rp2350.sio as sr

// HSTX (`hstx.sysl`) and the TMDS encoders (`tmds.sysl`) on their own: the shift register, the outputs and
// the clock generator against the register descriptions in `hardware/regs/hstx_ctrl.h`, the command
// expander with pico-examples' own command words, the FIFO's flags, and the encoder against symbols
// worked by hand from DVI 1.0's figure 3-5.

// Up to 64 cycles of the eight outputs, as HSTX reports them.
private struct Rec
    first: [64]u32
    second: [64]u32
    n: usize

impl HstxSink for Rec
    hstx_cycle(*self, first: u32, second: u32)
        self.first[self.n] = first
        self.second[self.n] = second
        self.n += 1

private csr(en: bool, expand: bool, clkdiv: u32, n_shifts: u32, shift: u32) -> u32 =
    (if en then hr.CSR_EN_MASK else 0) | (if expand then hr.CSR_EXPAND_EN_MASK else 0) | (clkdiv << hr.CSR_CLKDIV_SHIFT) | (n_shifts << hr.CSR_N_SHIFTS_SHIFT) | (shift << hr.CSR_SHIFT_SHIFT)

private bit_reg(i: u32) -> u32 = hr.BIT0_OFFSET + 4 * i
private sel(p: u32, n: u32) -> u32 = (p << hr.BIT0_SEL_P_SHIFT) | (n << hr.BIT0_SEL_N_SHIFT)
private push(h: *Hstx, x: u32) = h.fifo_write(hf.FIFO_OFFSET, 4, x).unwrap()
private stat(h: *Hstx) -> u32 = h.fifo_read(hf.STAT_OFFSET, 4).unwrap()

@test("HSTX at power-on: CSR 0x10050600 and EXPAND_SHIFT 0x01000100 as hstx_ctrl.h gives them, the BITn and EXPAND_TMDS zero, the FIFO empty")
hstx_power_on()
    val h = hstx()
    assert(h.read(hr.CSR_OFFSET, 4).unwrap() == 0x10050600)
    assert(h.read(hr.EXPAND_SHIFT_OFFSET, 4).unwrap() == 0x01000100)
    assert(h.read(hr.EXPAND_TMDS_OFFSET, 4).unwrap() == 0)
    for i in 0u32..<8 do assert(h.read(bit_reg(i), 4).unwrap() == 0)
    assert(h.fifo_read(hf.STAT_OFFSET, 4).unwrap() == hf.STAT_EMPTY_MASK)
    assert(!h.enabled() && h.dreq())
    assert(h.read(0x2C, 4).is_err(), "nothing past EXPAND_TMDS")

@test("HSTX's registers keep only their defined bits")
hstx_register_bits()
    var h = hstx()
    h.write(hr.CSR_OFFSET, 4, 0xFFFFFFFE).unwrap()
    assert(h.read(hr.CSR_OFFSET, 4).unwrap() == 0xFF1F1F72)
    h.write(bit_reg(5), 4, 0xFFFFFFFF).unwrap()
    assert(h.read(bit_reg(5), 4).unwrap() == 0x31F1F)
    h.write(hr.EXPAND_SHIFT_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(h.read(hr.EXPAND_SHIFT_OFFSET, 4).unwrap() == 0x1F1F1F1F)
    h.write(hr.EXPAND_TMDS_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(h.read(hr.EXPAND_TMDS_OFFSET, 4).unwrap() == 0xFFFFFF)

@test("the FIFO: LEVEL, FULL and EMPTY; a write to a full FIFO is dropped and sets WOF, which a 1 clears; DREQ while there is room")
hstx_fifo_flags()
    var h = hstx()
    for i in 0u32..<8
        assert(h.dreq())
        push(&h, i)
        assert(stat(&h) & hf.STAT_LEVEL_MASK == i + 1)
    assert(stat(&h) == 8 | hf.STAT_FULL_MASK && !h.dreq())
    push(&h, 99)
    assert(stat(&h) == 8 | hf.STAT_FULL_MASK | hf.STAT_WOF_MASK, "dropped, WOF")
    h.fifo_write(hf.STAT_OFFSET, 4, 0).unwrap()
    assert(stat(&h) & hf.STAT_WOF_MASK != 0, "a 0 leaves WOF")
    h.fifo_write(hf.STAT_OFFSET, 4, hf.STAT_WOF_MASK).unwrap()
    assert(stat(&h) == 8 | hf.STAT_FULL_MASK)
    assert(h.fifo_read(hf.FIFO_OFFSET, 4).unwrap() == 0, "FIFO is write-only")

@test("the raw path: each word shifts SHIFT bits a cycle for N_SHIFTS cycles, BITn taking SEL_P then SEL_N and INV; the register stops, reporting no cycles, when the FIFO is empty")
hstx_raw_shift()
    var h = hstx()
    // Output 0: bits 0 then 1; output 1: the same, inverted; output 7: bit 31 in both halves.
    h.write(bit_reg(0), 4, sel(0, 1)).unwrap()
    h.write(bit_reg(1), 4, sel(0, 1) | hr.BIT0_INV_MASK).unwrap()
    h.write(bit_reg(7), 4, sel(31, 31)).unwrap()
    h.write(hr.CSR_OFFSET, 4, csr(true, false, 1, 3, 2)).unwrap()
    push(&h, 0b10_01_11 | 0x80000000)
    push(&h, 0b00_00_10)
    var r: Rec
    h.pass(10, Some(&r))
    assert(r.n == 6, s"two words of three cycles, then stopped: ${r.n}")
    // Word 1, rotated right by 2 each cycle: bit pairs 11, 01, 10; bit 31 is 1 then, after rotation, bits 1 and 3.
    val want0 = [(1u32, 1u32), (1, 0), (0, 1), (0, 1), (0, 0), (0, 0)]
    for i in 0..<6
        val (p, n) = want0[i]
        assert(r.first[i] & 1 == p && r.second[i] & 1 == n, s"output 0, cycle $i")
        assert((r.first[i] >> 1) & 1 == p ^ 1 && (r.second[i] >> 1) & 1 == n ^ 1, s"output 1 inverted, cycle $i")
    assert(r.first[0] >> 7 == 1 && r.first[1] >> 7 == 1 && r.first[2] >> 7 == 0, "bit 31, then bits 1 and 3 rotated in")
    assert(stat(&h) == hf.STAT_EMPTY_MASK)
    push(&h, 3)
    h.pass(1, Some(&r))
    assert(r.n == 7 && r.first[6] & 1 == 1 && r.second[6] & 1 == 1, "a new word starts the register again")

@test("the clock generator: CLKDIV cycles a period, low for its first half, CLKPHASE half cycles already gone, advancing only while the register shifts; INV inverts it")
hstx_clock_generator()
    var h = hstx()
    h.write(bit_reg(2), 4, hr.BIT0_CLK_MASK).unwrap()
    h.write(bit_reg(3), 4, hr.BIT0_CLK_MASK | hr.BIT0_INV_MASK).unwrap()
    h.write(hr.CSR_OFFSET, 4, csr(true, false, 5, 5, 2)).unwrap()
    push(&h, 0)
    push(&h, 0)
    var r: Rec
    h.pass(10, Some(&r))
    assert(r.n == 10)
    // A period of 5 cycles is 10 halves: 5 low, 5 high.
    for c in 0..<10
        for half in 0u32..<2
            val level = if half == 0 then (r.first[c] >> 2) & 1 else (r.second[c] >> 2) & 1
            val inverted = if half == 0 then (r.first[c] >> 3) & 1 else (r.second[c] >> 3) & 1
            val want = if (2 * u32(c) + half) % 10 >= 5 then 1u32 else 0
            assert(level == want && inverted == want ^ 1, s"cycle $c half $half")
    var g = hstx()
    g.write(bit_reg(0), 4, hr.BIT0_CLK_MASK).unwrap()
    g.write(hr.CSR_OFFSET, 4, csr(true, false, 1, 2, 0) | (1u32 << hr.CSR_CLKPHASE_SHIFT)).unwrap()
    push(&g, 0)
    var q: Rec
    g.pass(2, Some(&q))
    assert(q.first[0] & 1 == 1 && q.second[0] & 1 == 0 && q.first[1] & 1 == 1, "CLKDIV 1, CLKPHASE 1: high first")
    var z = hstx()
    z.write(hr.CSR_OFFSET, 4, csr(true, false, 0, 1, 0)).unwrap()
    z.write(bit_reg(0), 4, hr.BIT0_CLK_MASK).unwrap()
    for _ in 0..<8 do push(&z, 0)
    var s: Rec
    z.pass(8, Some(&s))
    for c in 0..<8 do assert(s.first[c] & 1 == 0 && s.second[c] & 1 == 0, s"CLKDIV 0 is 16 cycles: still low at cycle $c")

@test("clearing EN stops the register and puts the clock back to its start, keeping the FIFO; nothing shifts while EN is clear")
hstx_disable()
    var h = hstx()
    h.write(bit_reg(0), 4, hr.BIT0_CLK_MASK).unwrap()
    h.write(hr.CSR_OFFSET, 4, csr(true, false, 4, 4, 0)).unwrap()
    for _ in 0..<3 do push(&h, 0)
    var r: Rec
    h.pass(3, Some(&r))
    assert(stat(&h) & hf.STAT_LEVEL_MASK == 2)
    h.write(hr.CSR_OFFSET, 4, csr(false, false, 4, 4, 0)).unwrap()
    h.pass(100, Some(&r))
    assert(r.n == 3 && stat(&h) & hf.STAT_LEVEL_MASK == 2, "nothing shifted, nothing popped")
    h.write(hr.CSR_OFFSET, 4, csr(true, false, 4, 4, 0)).unwrap()
    h.pass(1, Some(&r))
    assert(r.n == 4 && r.first[3] & 1 == 0 && stat(&h) & hf.STAT_LEVEL_MASK == 1, "a fresh word, the clock low again")

// The expander set up as pico-examples' dvi_out_hstx_encoder sets it: RGB332 pixels four to a word, a
// raw word a whole 32-bit push, and each push shifted out over 5 cycles of 2 bits.
private dvi_hstx() -> Hstx
    var h = hstx()
    h.write(hr.EXPAND_TMDS_OFFSET, 4, (2u32 << 21) | (0u32 << 16) | (2u32 << 13) | (29u32 << 8) | (1u32 << 5) | 26).unwrap()
    h.write(hr.EXPAND_SHIFT_OFFSET, 4, (4u32 << 24) | (8u32 << 16) | (1u32 << 8)).unwrap()
    for lane in 0u32..<3 do h.write(bit_reg(lane), 4, sel(10 * lane, 10 * lane + 1)).unwrap()
    h.write(hr.CSR_OFFSET, 4, csr(true, true, 5, 5, 2)).unwrap()
    h

// Each cycle's two bits of output `i`, collected LSB first into symbols of 10 bits.
private symbols(r: *Rec, i: u32, from: usize, count: usize) -> [8]u32
    var out = [0u32; 8]
    for k in 0..<count
        var s: u32 = 0
        for c in 0..<5
            s |= ((r.first[from + 5 * k + c] >> i) & 1) << (2 * u32(c))
            s |= ((r.second[from + 5 * k + c] >> i) & 1) << (2 * u32(c) + 1)
        out[k] = s
    out

@test("the expander's RAW_REPEAT: one word pushed the count's times; NOP is dropped and takes no time")
hstx_expander_raw_repeat()
    var h = dvi_hstx()
    push(&h, 0xF000)
    push(&h, 0x1003)
    push(&h, 0x154 | (0x354u32 << 10) | (0x354u32 << 20))
    var r: Rec
    h.pass(20, Some(&r))
    assert(r.n == 15, s"three pushes of 5 cycles: ${r.n}")
    for k in 0..<3
        val sym = symbols(&r, 0, 0, 3)
        assert(sym[k] == 0x154, s"lane 0 symbol $k: ${sym[k]}")
        assert(symbols(&r, 1, 0, 3)[k] == 0x354 && symbols(&r, 2, 0, 3)[k] == 0x354)
    assert(stat(&h) == hf.STAT_EMPTY_MASK)

@test("the expander's TMDS: each data word gives ENC_N_SHIFTS pixels, rotated by ENC_SHIFT between them, each lane its ROT and NBITS of the pixel, encoded with its running balance; a count ending mid-word drops the rest")
hstx_expander_tmds()
    var h = dvi_hstx()
    push(&h, 0x2006)
    push(&h, 0x00FFE01C)
    push(&h, 0x03FF00E0)
    var r: Rec
    h.pass(40, Some(&r))
    assert(r.n == 30, s"six pixels: ${r.n}")
    // The same pixels through the encoder by hand: RGB332 red 7:5, green 4:2, blue 1:0.
    val pixels = [0x1Cu32, 0xE0, 0xFF, 0x00, 0xE0, 0x00]
    var balance = [0i32; 3]
    for k in 0..<6
        val p = pixels[k]
        val blue = tmds_encode(&balance[0], u8((p << 6) & 0xC0))
        val green = tmds_encode(&balance[1], u8((p << 3) & 0xE0))
        val red = tmds_encode(&balance[2], u8(p & 0xE0))
        assert(symbols(&r, 0, 5 * k, 1)[0] == blue && symbols(&r, 1, 5 * k, 1)[0] == green && symbols(&r, 2, 5 * k, 1)[0] == red, s"pixel $k")
    assert(stat(&h) == hf.STAT_EMPTY_MASK, "the second word's last two pixels dropped")

@test("TMDS_REPEAT encodes one word's pixel the count's times, its balance running on; a raw command clears the balance")
hstx_expander_tmds_repeat()
    var h = dvi_hstx()
    h.write(hr.EXPAND_SHIFT_OFFSET, 4, (1u32 << 24) | (1u32 << 8)).unwrap()
    push(&h, 0x3003)
    push(&h, 0)
    var r: Rec
    h.pass(20, Some(&r))
    assert(r.n == 15)
    var balance = [0i32; 3]
    for k in 0..<3
        assert(symbols(&r, 0, 5 * k, 1)[0] == tmds_encode(&balance[0], 0), s"pixel $k")
    assert(symbols(&r, 0, 0, 3)[0] == 0x100 && symbols(&r, 0, 0, 3)[1] == 0x3FF && symbols(&r, 0, 0, 3)[2] == 0x100, "0x00 at balance 0, -8 and 2")
    // At a balance of -6 a fourth 0x00 would be 0x3FF; after a raw command it is 0x100, at balance 0.
    push(&h, 0x1001)
    push(&h, 0)
    push(&h, 0x2001)
    push(&h, 0)
    h.pass(10, Some(&r))
    assert(symbols(&r, 0, 20, 1)[0] == 0x100, "the balance back to 0 after a raw command")

@test("until_room: the clk_hstx cycles before a full FIFO pops, through the raw path and the expander")
hstx_until_room()
    var h = hstx()
    h.write(hr.CSR_OFFSET, 4, csr(true, false, 1, 4, 0)).unwrap()
    for _ in 0..<8 do push(&h, 0)
    assert(h.until_room() == Some(1), "the first word loads at once")
    h.pass(1, None)
    for _ in 0..<1 do push(&h, 0)
    assert(h.until_room() == Some(3), s"${h.until_room()}")
    h.pass(3, None)
    assert(h.dreq())
    var e = dvi_hstx()
    push(&e, 0x1003)
    for _ in 0..<7 do push(&e, 0)
    e.pass(1, None)
    push(&e, 0)
    push(&e, 0)
    assert(e.until_room() == Some(4 + 2 * 5), s"the repeat's other two pushes first: ${e.until_room()}")
    assert(hstx().until_room().is_none(), "disabled")

@test("refused by name: coupled mode, EXPAND_EN changed while EN stays set, a CLKPHASE of a period or more, a reserved opcode and a count of 0")
hstx_refusals()
    val h = hstx()
    assert(h.unmodelled(hr.CSR_OFFSET, 4, hr.CSR_COUPLED_MODE_MASK).unwrap().contains("coupled mode"))
    assert(h.unmodelled(hr.CSR_OFFSET, 4, csr(true, false, 2, 1, 0) | (4u32 << hr.CSR_CLKPHASE_SHIFT)).unwrap().contains("CLKPHASE of 4"))
    assert(h.unmodelled(hr.CSR_OFFSET, 4, csr(true, false, 2, 1, 0) | (3u32 << hr.CSR_CLKPHASE_SHIFT)).is_none())
    assert(h.unmodelled(bit_reg(0), 4, 0xFFFFFFFF).is_none())
    var e = dvi_hstx()
    assert(e.unmodelled(hr.CSR_OFFSET, 4, csr(true, false, 5, 5, 2)).unwrap().contains("EXPAND_EN"))
    assert(e.unmodelled(hr.CSR_OFFSET, 4, csr(false, false, 5, 5, 2)).is_none(), "together with EN low")
    for (word, want) in [(0x4000u32, "reserved opcode"), (0x10000, "reserved opcode"), (0x2000, "count of 0")]
        var x = dvi_hstx()
        push(&x, word)
        x.pass(5, None)
        assert(x.fault.contains(want) && x.fault.contains("HSTX command word"), x.fault)

@test("TMDS symbols worked by hand from DVI 1.0 figure 3-5: 0x00, 0xFF and 0x10 at balance 0, and 0x00's alternation")
tmds_worked()
    var b: i32 = 0
    assert(tmds_encode(&b, 0x00) == 0x100 && b == -8)
    assert(tmds_encode(&b, 0x00) == 0x3FF && b == 2)
    assert(tmds_encode(&b, 0x00) == 0x100 && b == -6)
    b = 0
    assert(tmds_encode(&b, 0xFF) == 0x200 && b == -8)
    b = 0
    assert(tmds_encode(&b, 0x10) == 0x1F0 && b == 0)

// TMDS_CTRL for RGB565 as the datasheet's example: red 15:11 rotated 8, green 10:5 rotated 3, blue 4:0
// rotated 13 (left 3), each its top bits kept.
private const RGB565: u32 = (8u32 << 8) | (3u32 << 4) | 13 | (4u32 << 18) | (5u32 << 15) | (4u32 << 12)

@test("the SIO's TMDS encoder: PEEK_SINGLE encodes all three lanes and leaves the colour, POP_SINGLE shifts it by PIX_SHIFT; INTERLEAVE packs two bits a lane; it matches HSTX's encoder")
sio_tmds_single()
    var s = sio()
    s.write(0, sr.TMDS_CTRL_OFFSET, 4, RGB565 | (5u32 << sr.TMDS_CTRL_PIX_SHIFT_SHIFT)).unwrap()
    assert(s.read(0, sr.TMDS_CTRL_OFFSET, 4, 0).unwrap() == RGB565 | (5u32 << sr.TMDS_CTRL_PIX_SHIFT_SHIFT))
    s.write(0, sr.TMDS_WDATA_OFFSET, 4, 0x0000F800).unwrap()
    var b = [0i32; 3]
    val red = tmds_encode(&b[2], 0xF8)
    val green = tmds_encode(&b[1], 0)
    val blue = tmds_encode(&b[0], 0)
    assert(s.read(0, sr.TMDS_PEEK_SINGLE_OFFSET, 4, 0).unwrap() == blue | (green << 10) | (red << 20))
    // The colour is unchanged, so a POP encodes the same pixel with each balance moved on.
    val red2 = tmds_encode(&b[2], 0xF8)
    val green2 = tmds_encode(&b[1], 0)
    val blue2 = tmds_encode(&b[0], 0)
    assert(s.read(0, sr.TMDS_POP_SINGLE_OFFSET, 4, 0).unwrap() == blue2 | (green2 << 10) | (red2 << 20))
    // Shifted by 16: the colour's high half, zero.
    val red3 = tmds_encode(&b[2], 0)
    assert((s.read(0, sr.TMDS_PEEK_SINGLE_OFFSET, 4, 0).unwrap() >> 20) == red3)
    assert(s.read(0, sr.TMDS_WDATA_OFFSET, 4, 0).unwrap() == 0, "WDATA reads 0")
    var t = sio()
    t.write(1, sr.TMDS_CTRL_OFFSET, 4, RGB565 | sr.TMDS_CTRL_INTERLEAVE_MASK).unwrap()
    t.write(1, sr.TMDS_WDATA_OFFSET, 4, 0x07E0).unwrap()
    var c = [0i32; 3]
    val sym = [tmds_encode(&c[0], 0), tmds_encode(&c[1], 0xFC), tmds_encode(&c[2], 0)]
    val got = t.read(1, sr.TMDS_PEEK_SINGLE_OFFSET, 4, 0).unwrap()
    for chunk in 0u32..<5
        for lane in 0..<3
            assert((got >> (6 * chunk + 2 * u32(lane))) & 3 == (sym[lane] >> (2 * chunk)) & 3, s"chunk $chunk lane $lane")
    assert(t.read(0, sr.TMDS_CTRL_OFFSET, 4, 0).unwrap() == 0, "core 0's encoder is its own")

@test("the SIO's TMDS encoder: PEEK/POP_DOUBLE give two symbols of one lane, the second from the colour shifted by PIX_SHIFT unless PIX2_NOSHIFT; a POP shifts by twice PIX_SHIFT, or once with PIX2_NOSHIFT; CLEAR_BALANCE")
sio_tmds_double()
    var s = sio()
    // RGB332-ish on lane 0: the colour's low byte, all 8 bits, 8 bits a pixel.
    s.write(0, sr.TMDS_CTRL_OFFSET, 4, (7u32 << 12) | (4u32 << sr.TMDS_CTRL_PIX_SHIFT_SHIFT)).unwrap()
    s.write(0, sr.TMDS_WDATA_OFFSET, 4, 0x44332211).unwrap()
    var b: i32 = 0
    val a1 = tmds_encode(&b, 0x11)
    val a2 = tmds_encode(&b, 0x22)
    assert(s.read(0, sr.TMDS_POP_DOUBLE_L0_OFFSET, 4, 0).unwrap() == a1 | (a2 << 10))
    val a3 = tmds_encode(&b, 0x33)
    val a4 = tmds_encode(&b, 0x44)
    assert(s.read(0, sr.TMDS_PEEK_DOUBLE_L0_OFFSET, 4, 0).unwrap() == a3 | (a4 << 10), "shifted by 16 after the POP")
    s.write(0, sr.TMDS_CTRL_OFFSET, 4, (7u32 << 12) | (4u32 << sr.TMDS_CTRL_PIX_SHIFT_SHIFT) | sr.TMDS_CTRL_PIX2_NOSHIFT_MASK | sr.TMDS_CTRL_CLEAR_BALANCE_MASK).unwrap()
    assert(s.read(0, sr.TMDS_CTRL_OFFSET, 4, 0).unwrap() & sr.TMDS_CTRL_CLEAR_BALANCE_MASK == 0, "CLEAR_BALANCE reads 0")
    var c: i32 = 0
    val d1 = tmds_encode(&c, 0x33)
    val d2 = tmds_encode(&c, 0x33)
    assert(s.read(0, sr.TMDS_POP_DOUBLE_L0_OFFSET, 4, 0).unwrap() == d1 | (d2 << 10), "pixel doubled, the balance cleared")
    val e1 = tmds_encode(&c, 0x44)
    val e2 = tmds_encode(&c, 0x44)
    assert(s.read(0, sr.TMDS_POP_DOUBLE_L0_OFFSET, 4, 0).unwrap() == e1 | (e2 << 10), "shifted by 8 alone")
    // Lane 2 sees its own balance: still at 0.
    var f: i32 = 0
    assert(s.read(0, sr.TMDS_PEEK_DOUBLE_L2_OFFSET, 4, 0).unwrap() & 0x3FF == tmds_encode(&f, 0))

@test("refused by name: TMDS_CTRL's reserved PIX_SHIFT values 6 and 7; the RP2040's SIO has no encoder")
sio_tmds_refusals()
    assert(tmds_unmodelled(sr.TMDS_CTRL_OFFSET, 6u32 << sr.TMDS_CTRL_PIX_SHIFT_SHIFT).unwrap().contains("PIX_SHIFT 6"))
    assert(tmds_unmodelled(sr.TMDS_CTRL_OFFSET, 7u32 << sr.TMDS_CTRL_PIX_SHIFT_SHIFT).is_some())
    assert(tmds_unmodelled(sr.TMDS_CTRL_OFFSET, 5u32 << sr.TMDS_CTRL_PIX_SHIFT_SHIFT).is_none())
    assert(tmds_unmodelled(sr.TMDS_WDATA_OFFSET, 0xFFFFFFFF).is_none())
