module sh.sysl.benchtop.peripheral.rp2350
@tests

import sh.sysl.rp2350.pio0 as pr

// The PIO blocks by themselves (`pio.sysl`), clocked by hand: each instruction against the datasheet's
// semantics, the divider, delay and side-set, the FIFOs and their joins, the shift registers' thresholds,
// the IRQ flags across blocks, the pins' priorities, and every refusal. The chip's side and the
// pico-examples programs are `chip/pio_tests.sysl`.

// The SDK's instruction encodings (`hardware/pio_instructions.h`): destinations and sources.
private const PINS: u32 = 0
private const X: u32 = 1
private const Y: u32 = 2
private const NUL: u32 = 3
private const PINDIRS: u32 = 4
private const STATUS: u32 = 5
private const ISR: u32 = 6
private const OSR: u32 = 7

private jmp(cond: u32, addr: u32) -> u32 = (cond << 5) | addr
private wait(polarity: u32, source: u32, index: u32) -> u32 = 0x2000 | (polarity << 7) | (source << 5) | index
private in_(source: u32, n: u32) -> u32 = 0x4000 | (source << 5) | (n & 31)
private out(dest: u32, n: u32) -> u32 = 0x6000 | (dest << 5) | (n & 31)
private push(if_full: bool, block: bool) -> u32 = 0x8000 | (if if_full then 0x40 else 0) | (if block then 0x20 else 0)
private pull(if_empty: bool, block: bool) -> u32 = 0x8080 | (if if_empty then 0x40 else 0) | (if block then 0x20 else 0)
private mov(dest: u32, op: u32, source: u32) -> u32 = 0xa000 | (dest << 5) | (op << 3) | source
private irq(clear: bool, wait_: bool, mode: u32, index: u32) -> u32 = 0xc000 | (if clear then 0x40 else 0) | (if wait_ then 0x20 else 0) | (mode << 3) | index
private set(dest: u32, data: u32) -> u32 = 0xe000 | (dest << 5) | data
private nop() -> u32 = mov(Y, 0, Y)
private delay(instr: u32, cycles: u32) -> u32 = instr | (cycles << 8)

// A state machine's register, `index` bytes into its six.
private sm_reg(s: u32, index: u32) -> u32 = pr.SM0_CLKDIV_OFFSET + 0x18 * s + index
private const CLKDIV: u32 = 0
private const EXECCTRL: u32 = 4
private const SHIFTCTRL: u32 = 8
private const ADDR: u32 = 12
private const INSTR: u32 = 16
private const PINCTRL: u32 = 20
private const SET: u32 = 0x2000
private const CLR: u32 = 0x3000

/** The three blocks and a clock, advanced by hand. */
struct Rig
    p: Pio
    t: u64

impl Rig
    run(*self, n: u64)
        self.t += n
        self.p.advance_to(self.t)
    wr(*self, o: u32, x: u32) = self.wrb(0, o, x)
    wrb(*self, b: u32, o: u32, x: u32) = self.p.write(b, self.t, o, 4, x).unwrap()
    rd(*self, o: u32) -> u32 = self.rdb(0, o)
    rdb(*self, b: u32, o: u32) -> u32 = self.p.read(b, self.t, o, 4).unwrap()
    // `words` from address 0 of block `b`.
    load(*self, b: u32, words: []u32)
        for i in 0..<words.len do self.wrb(b, pr.INSTR_MEM0_OFFSET + 4 * u32(i), words[i])
    // Run `instr` on state machine `s` now (SMx_INSTR) and give it its cycle.
    exec(*self, s: u32, instr: u32)
        self.wr(sm_reg(s, INSTR), instr)
        self.run(1)
    enable(*self, mask: u32) = self.wr(pr.CTRL_OFFSET, mask)
    // SM_RESTART for state machine `s`, through CTRL's SET alias.
    restart(*self, s: u32) = self.wr(pr.CTRL_OFFSET + SET, 1 << (4 + s))
    pc(*self, s: u32) -> u32 = self.rd(sm_reg(s, ADDR))
    // A register of state machine `s`, through MOV ISR and a PUSH (which empties the ISR).
    peek(*self, s: u32, source: u32) -> u32
        self.exec(s, mov(ISR, 0, source))
        self.exec(s, push(false, false))
        self.rd(pr.RXF0_OFFSET + 4 * s)
    // Put `x` in state machine `s`'s X through its TX FIFO.
    put_x(*self, s: u32, x: u32)
        self.wr(pr.TXF0_OFFSET + 4 * s, x)
        self.exec(s, pull(false, false))
        self.exec(s, mov(X, 0, OSR))
    fault(*self) -> string = self.p.take_fault().unwrap_or("")

private rig() -> Rig = Rig(pio(), 0)

@test("power-on: DBG_CFGINFO says version 1, 32 instructions, 4 state machines, FIFOs 4 deep; every register at its reset value; nothing runs")
pio_power_on()
    var r = rig()
    assert(r.rd(pr.DBG_CFGINFO_OFFSET) == 0x10200404)
    assert(r.rd(pr.CTRL_OFFSET) == 0 && r.rd(pr.FSTAT_OFFSET) == 0x0f000f00 && r.rd(pr.FLEVEL_OFFSET) == 0)
    assert(r.rd(sm_reg(2, CLKDIV)) == 0x10000 && r.rd(sm_reg(2, EXECCTRL)) == 0x1f000 && r.rd(sm_reg(2, SHIFTCTRL)) == 0xc0000 && r.rd(sm_reg(2, PINCTRL)) == 0x14000000)
    assert(r.rd(pr.INTR_OFFSET) == 0xf0, "TXNFULL for each state machine")
    assert(!r.p.running)
    r.run(1000000)
    assert(r.pc(0) == 0)
    assert(r.p.read(0, 0, 0x188, 4).is_err())

// State machine 0 holds a stalled instruction the system wrote (EXECCTRL.EXEC_STALLED).
private stalled(r: *Rig) -> bool = r.rd(sm_reg(0, EXECCTRL)) & pr.SM0_EXECCTRL_EXEC_STALLED_MASK != 0

// A write was refused by name.
private refused(res: Result[unit, PioFault]) -> bool = res match
    Ok(_) -> false
    Err(f) -> f match
        Refused(_) -> true
        Access(_) -> false

// A read was refused by name.
private read_refused(res: Result[u32, PioFault]) -> bool = res match
    Ok(_) -> false
    Err(f) -> f match
        Refused(_) -> true
        Access(_) -> false

// The cycles, of the next `n`, on which state machine 0's PC moves.
private moves(r: *Rig, n: u32) -> string
    var seen = ""
    var last = r.pc(0)
    for i in 1u32..n
        r.run(1)
        if r.pc(0) != last then seen = seen + s"$i "
        last = r.pc(0)
    seen

private nops() -> []u32 = [nop(); 32]

@test("the divider: 1.0 runs every cycle, 2.5 runs 3, 2, 3, 2 cycles apart from CLKDIV_RESTART, INT 0 is 65536; it keeps running while its state machine is off, and CLKDIV_RESTART puts its phase back to 0")
pio_divider()
    var r = rig()
    r.load(0, nops())
    r.enable(1)
    assert(moves(&r, 4) == "1 2 3 4 ")
    var h = rig()
    h.load(0, nops())
    h.wr(sm_reg(0, CLKDIV), 0x00028000)
    h.wr(pr.CTRL_OFFSET, 0x101)
    assert(moves(&h, 16) == "3 5 8 10 13 15 ", moves(&h, 0))
    var q = rig()
    q.load(0, nops())
    q.wr(sm_reg(0, CLKDIV), 0x00014000)
    q.wr(pr.CTRL_OFFSET, 0x101)
    val quarter = moves(&q, 12)
    assert(quarter == "2 3 4 5 7 8 9 10 12 ", s"1.25: a fire as each 1.25 is reached, never before: $quarter")
    var z = rig()
    z.load(0, nops())
    z.wr(sm_reg(0, CLKDIV), 0)
    z.wr(pr.CTRL_OFFSET, 0x101)
    z.run(65535)
    assert(z.pc(0) == 0)
    z.run(1)
    assert(z.pc(0) == 1, "INT 0 divides by 65536")
    var f = rig()
    f.load(0, nops())
    f.wr(sm_reg(0, CLKDIV), 0x30000)
    f.wr(pr.CTRL_OFFSET, 0x101)
    f.run(4)
    assert(f.pc(0) == 1)
    f.enable(0)
    f.run(6)
    assert(f.pc(0) == 1, "off from cycle 4 to 10")
    f.enable(1)
    assert(moves(&f, 2) == "2 ", "the phase ran on: the next cycle is 12, not 13")
    f.wr(pr.CTRL_OFFSET, 0x101)
    assert(moves(&f, 3) == "3 ", "restarted at 12: the next cycle is 15")
    // A new divisor mid-delay keeps the state machine's cycles left: a NOP [5] at 1.0, then 4.0.
    var d = rig()
    d.load(0, [delay(nop(), 5), nop(), nop()])
    d.enable(1)
    d.run(2)
    d.wr(sm_reg(0, CLKDIV), 0x40000)
    assert(moves(&d, 20) == "20 ", "five of its cycles left (four of delay, then the next) at 4.0 from cycle 2")
    // A refused divisor: INT 0 with a fraction.
    assert(refused(d.p.write(0, d.t, sm_reg(0, CLKDIV), 4, 0x8000)) && d.rd(sm_reg(0, CLKDIV)) == 0x40000)

@test("delay, and wrap: the delay follows the instruction; the PC wraps from WRAP_TOP to WRAP_BOTTOM, but a jump taken there goes where it says")
pio_delay_wrap()
    var r = rig()
    r.load(0, [delay(nop(), 3), nop(), jmp(0, 4), nop(), nop()])
    r.wr(sm_reg(0, EXECCTRL), 1 << 12)
    r.enable(1)
    r.run(1)
    assert(r.pc(0) == 1)
    r.run(3)
    assert(r.pc(0) == 1, "three cycles of delay")
    r.run(1)
    assert(r.pc(0) == 0, "wrapped")
    var j = rig()
    j.load(0, [nop(), jmp(0, 3), nop(), nop()])
    j.wr(sm_reg(0, EXECCTRL), 1 << 12)
    j.enable(1)
    j.run(2)
    assert(j.pc(0) == 3, "the jump at the top")
    var n = rig()
    n.load(0, [nop(), jmp(1, 3), nop(), nop()])
    n.wr(sm_reg(0, EXECCTRL), 1 << 12)
    n.exec(0, set(X, 1))
    n.enable(1)
    n.run(2)
    assert(n.pc(0) == 0, "a jump not taken wraps")

// Whether JMP `cond` from SMx_INSTR goes to 9.
private jumps(r: *Rig, cond: u32) -> bool
    r.exec(0, jmp(0, 0))
    r.exec(0, jmp(cond, 9))
    r.pc(0) == 9

@test("JMP: always, !X, X--, !Y, Y--, X!=Y, PIN (through the two-cycle synchroniser) and !OSRE; the decrement happens whether or not the jump does")
pio_jmp()
    var r = rig()
    assert(jumps(&r, 0))
    r.exec(0, set(X, 0))
    assert(jumps(&r, 1))
    r.exec(0, set(X, 1))
    assert(!jumps(&r, 1))
    assert(jumps(&r, 2) && r.peek(0, X) == 0, "X-- from 1: taken, 0")
    assert(!jumps(&r, 2) && r.peek(0, X) == 0xffffffff, "X-- from 0: not taken, wrapped")
    r.exec(0, set(Y, 0))
    assert(jumps(&r, 3))
    r.exec(0, set(Y, 2))
    assert(!jumps(&r, 3))
    assert(jumps(&r, 4) && r.peek(0, Y) == 1)
    assert(jumps(&r, 5), "X != Y")
    r.exec(0, set(X, 1))
    assert(!jumps(&r, 5))
    // PIN: GPIO 5, driven high from the end of cycle t, is high in cycle t + 1 and reaches the state
    // machine through the synchroniser's two flip-flops in cycle t + 3.
    r.wr(sm_reg(0, EXECCTRL), r.rd(sm_reg(0, EXECCTRL)) | (5 << 24))
    assert(!jumps(&r, 6))
    r.p.drive(r.t, 1 << 5)
    r.exec(0, jmp(6, 9))
    r.exec(0, jmp(6, 9))
    assert(r.pc(0) != 9, "cycles t + 1 and t + 2: still low")
    r.exec(0, jmp(6, 9))
    assert(r.pc(0) == 9, "cycle t + 3")
    r.p.drive(r.t, 0)
    r.wr(pr.INPUT_SYNC_BYPASS_OFFSET, 1 << 5)
    r.exec(0, jmp(0, 0))
    r.p.drive(r.t, 1 << 5)
    r.exec(0, jmp(6, 9))
    assert(r.pc(0) == 9, "bypassed: at once")
    // !OSRE: OSR empty after restart; full after a PULL; empty again after PULL_THRESH bits out.
    assert(!jumps(&r, 7))
    r.wr(pr.TXF0_OFFSET, 0xffffffff)
    r.exec(0, pull(false, false))
    assert(jumps(&r, 7))
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | (8 << 25))
    r.exec(0, out(NUL, 7))
    assert(jumps(&r, 7))
    r.exec(0, out(NUL, 1))
    assert(!jumps(&r, 7))

@test("WAIT: GPIO relative to GPIOBASE, PIN through the IN mapping and IN_COUNT, JMPPIN + 0 to 3, IRQ (clearing the flag it waited for at polarity 1); a stalled WAIT moves on the cycle its input arrives")
pio_wait()
    var r = rig()
    r.load(0, [wait(1, 0, 24), nop(), nop(), nop()])
    r.wr(pr.GPIOBASE_OFFSET, 16)
    r.enable(1)
    r.run(10)
    assert(r.pc(0) == 0)
    r.p.drive(r.t, 1 << 24)
    r.run(10)
    assert(r.pc(0) == 0, "GPIO 24 is not the state machine's 24 with GPIOBASE 16")
    r.p.drive(r.t, 1 << 40)
    r.run(2)
    assert(r.pc(0) == 0, "the synchroniser's two cycles")
    r.run(1)
    assert(r.pc(0) == 1, "GPIO 40")
    // PIN 2 from IN_BASE 10 is GPIO 12; IN_COUNT 2 masks it to 0.
    var p = rig()
    p.wr(sm_reg(0, PINCTRL), 10 << 15)
    p.wr(pr.INPUT_SYNC_BYPASS_OFFSET, 0xffffffff)
    p.p.drive(p.t, 1 << 12)
    p.exec(0, wait(1, 1, 2))
    assert(!stalled(&p), "GPIO 12 high")
    p.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | 2)
    p.exec(0, wait(1, 1, 2))
    p.run(5)
    assert(stalled(&p), "masked by IN_COUNT 2")
    p.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | 3)
    p.run(1)
    assert(!stalled(&p), "IN_COUNT 3 lets it through, on the cycle after the register write")
    // JMPPIN + 2 from JMP_PIN 30 is pin 0; + 4 is refused.
    var j = rig()
    j.wr(sm_reg(0, EXECCTRL), 0x1f000 | (30 << 24))
    j.wr(pr.INPUT_SYNC_BYPASS_OFFSET, 0xffffffff)
    j.p.drive(j.t, 1)
    j.exec(0, wait(1, 3, 2))
    assert(!stalled(&j), "pin 0 high: done")
    j.exec(0, wait(0, 3, 2))
    assert(stalled(&j))
    j.p.drive(j.t, 0)
    j.run(1)
    assert(!stalled(&j), "done once it falls")
    j.exec(0, wait(1, 3, 4))
    assert(j.fault() == "PIO0 SM0 at 0: instruction 0x20e4: WAIT JMPPIN + 4: only 0 to 3 are defined")
    // IRQ 3: polarity 1 waits for it and clears it; polarity 0 waits for it to clear.
    var q = rig()
    q.load(0, [wait(1, 2, 3), wait(0, 2, 3), nop(), nop()])
    q.enable(1)
    q.run(5)
    assert(q.pc(0) == 0)
    q.wr(pr.IRQ_FORCE_OFFSET, 1 << 3)
    q.run(1)
    assert(q.pc(0) == 1 && q.rd(pr.IRQ_OFFSET) == 0, "taken and cleared")
    q.run(1)
    assert(q.pc(0) == 2)
    q.exec(0, jmp(0, 1))
    q.wr(pr.IRQ_FORCE_OFFSET, 1 << 3)
    q.run(3)
    assert(q.pc(0) == 1, "polarity 0 waits while it is set")
    q.wr(pr.IRQ_OFFSET, 1 << 3)
    q.run(1)
    assert(q.pc(0) == 2)

@test("IN: each source, shifting right or left, the count saturating at 32; autopush at PUSH_THRESH, stalling (RXSTALL) on a full RX FIFO until a read makes room; IN_COUNT masks the pins; source 4 is refused")
pio_in()
    var r = rig()
    r.exec(0, set(X, 0x0b))
    r.exec(0, set(Y, 0x05))
    r.exec(0, in_(X, 8))
    r.exec(0, in_(Y, 4))
    r.exec(0, push(false, false))
    assert(r.rd(pr.RXF0_OFFSET) == 0x50b00000, "right: data enters from the left")
    r.wr(sm_reg(0, SHIFTCTRL), 0x80000)
    r.exec(0, in_(X, 8))
    r.exec(0, in_(Y, 4))
    r.exec(0, push(false, false))
    assert(r.rd(pr.RXF0_OFFSET) == 0x0b5, "left")
    r.exec(0, in_(X, 32))
    r.exec(0, in_(NUL, 4))
    r.exec(0, push(false, false))
    assert(r.rd(pr.RXF0_OFFSET) == 0xb0, "null shifts zeroes in")
    r.wr(pr.TXF0_OFFSET, 0x12345678)
    r.exec(0, pull(false, false))
    r.exec(0, in_(OSR, 16))
    r.exec(0, in_(ISR, 16))
    r.exec(0, push(false, false))
    assert(r.rd(pr.RXF0_OFFSET) == 0x56785678, "OSR, then the ISR into itself")
    // Pins 3 and up through IN_BASE 3, IN_COUNT 4: GPIO 3–6 seen, 7 masked.
    r.wr(pr.INPUT_SYNC_BYPASS_OFFSET, 0xffffffff)
    r.wr(sm_reg(0, PINCTRL), 3 << 15)
    r.wr(sm_reg(0, SHIFTCTRL), 0x80000 | 4)
    r.p.drive(r.t, 0xf8)
    r.exec(0, in_(PINS, 8))
    r.exec(0, push(false, false))
    assert(r.rd(pr.RXF0_OFFSET) == 0x0f)
    // IfFull at threshold 12, then autopush at 8 to a full FIFO.
    r.wr(sm_reg(0, SHIFTCTRL), 0x80000 | (12 << 20))
    r.exec(0, in_(X, 8))
    r.exec(0, push(true, false))
    assert(r.rd(pr.FLEVEL_OFFSET) == 0, "8 bits: below 12, no push")
    r.exec(0, in_(X, 4))
    r.exec(0, push(true, false))
    assert(r.rd(pr.FLEVEL_OFFSET) == 0x10, "12 bits: pushed")
    assert(r.rd(pr.RXF0_OFFSET) == 0xbb)
    r.load(0, [in_(X, 8), jmp(0, 0)])
    r.wr(sm_reg(0, SHIFTCTRL), 0x80000 | pr.SM0_SHIFTCTRL_AUTOPUSH_MASK | (8 << 20))
    r.exec(0, jmp(0, 0))
    r.enable(1)
    r.run(10)
    assert(r.rd(pr.FLEVEL_OFFSET) == 0x40 && r.rd(pr.FDEBUG_OFFSET) == 1, "four pushed, the fifth stalls: RXSTALL")
    assert(r.rd(pr.RXF0_OFFSET) == 0x0b && r.rd(pr.FLEVEL_OFFSET) == 0x30)
    r.run(1)
    assert(r.rd(pr.FLEVEL_OFFSET) == 0x40, "the stalled IN pushed on the cycle after the read")
    r.enable(0)
    r.exec(0, in_(4, 1))
    assert(r.fault().ends_with("IN source 4 is reserved"))

@test("OUT: right and left, to PINS (OUT_BASE, OUT_COUNT, wrapping at 32), PINDIRS, X, Y, NULL, PC, ISR (setting its count) and EXEC (whose own delay is not taken)")
pio_out()
    var r = rig()
    r.wr(pr.TXF0_OFFSET, 0x12345678)
    r.exec(0, pull(false, false))
    r.exec(0, out(X, 8))
    r.exec(0, out(Y, 4))
    assert(r.peek(0, X) == 0x78 && r.peek(0, Y) == 0x6, "right")
    r.wr(sm_reg(0, SHIFTCTRL), 0x40000)
    r.wr(pr.TXF0_OFFSET, 0x12345678)
    r.exec(0, pull(false, false))
    r.exec(0, out(X, 8))
    r.exec(0, out(Y, 4))
    assert(r.peek(0, X) == 0x12 && r.peek(0, Y) == 0x3, "left")
    r.exec(0, out(NUL, 20))
    assert(r.peek(0, OSR) == 0, "all out")
    // PINS from OUT_BASE 30, OUT_COUNT 3: bits to pins 30, 31 and 0.
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000)
    r.wr(sm_reg(0, PINCTRL), 30 | (3 << 20))
    r.wr(pr.TXF0_OFFSET, 0b11101)
    r.exec(0, pull(false, false))
    r.exec(0, out(PINS, 3))
    assert(r.rd(pr.DBG_PADOUT_OFFSET) == 0x40000001 && r.rd(pr.DBG_PADOE_OFFSET) == 0, "101 onto 30, 31, 0")
    r.exec(0, out(PINDIRS, 2))
    assert(r.rd(pr.DBG_PADOE_OFFSET) == 0xc0000000 && r.rd(pr.DBG_PADOUT_OFFSET) == 0x40000001, "11 onto the directions; the third bit 0")
    r.wr(pr.TXF0_OFFSET, 0x15)
    r.exec(0, pull(false, false))
    r.exec(0, out(5, 5))
    assert(r.pc(0) == 0x15, "PC")
    r.wr(pr.TXF0_OFFSET, 0x3f)
    r.exec(0, pull(false, false))
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | (6 << 20))
    r.exec(0, out(ISR, 6))
    r.exec(0, push(true, false))
    assert(r.rd(pr.RXF0_OFFSET) == 0x3f, "ISR, with its count 6: a PUSH IFFULL at 6 pushes")
    // EXEC: SET X, 17 from the OSR, run on the next cycle; the OUT's delay of 5 is not taken.
    r.load(0, [delay(out(7, 16), 5), nop(), nop()])
    r.wr(pr.TXF0_OFFSET, set(X, 17))
    r.exec(0, pull(false, false))
    r.exec(0, jmp(0, 0))
    r.enable(1)
    r.run(2)
    assert(r.pc(0) == 1, "the executed SET ran in cycle 2 with the PC left after the OUT")
    r.run(1)
    assert(r.pc(0) == 2, "no delay")
    r.enable(0)
    assert(r.peek(0, X) == 17)

@test("autopull: the OSR refills at the end of the cycle that empties it to PULL_THRESH; an OUT finding it empty stalls (TXSTALL with the FIFO empty) and runs the cycle after a word arrives")
pio_autopull()
    var r = rig()
    r.load(0, [out(X, 8)])
    r.wr(sm_reg(0, EXECCTRL), 0)
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | pr.SM0_SHIFTCTRL_AUTOPULL_MASK | (16 << 25))
    r.wr(pr.TXF0_OFFSET, 0x2211)
    r.wr(pr.TXF0_OFFSET, 0x4433)
    r.enable(1)
    r.run(1)
    assert(r.rd(pr.FLEVEL_OFFSET) == 1 && r.rd(pr.FDEBUG_OFFSET) == 0, "OSR empty at restart: the OUT stalls on cycle 1, whose end refills it from the first word")
    r.run(2)
    assert(r.rd(pr.FLEVEL_OFFSET) == 0, "cycles 2 and 3 take 16 bits out, and the end of cycle 3 refills from the second word")
    r.run(2)
    assert(r.rd(pr.FDEBUG_OFFSET) == 0, "both bytes of the second word out by cycle 5")
    r.run(1)
    assert(r.rd(pr.FDEBUG_OFFSET) == 0x01000000, "cycle 6: empty, nothing to refill, TXSTALL")
    r.wr(pr.TXF0_OFFSET, 0x99)
    r.run(1)
    assert(r.rd(pr.FLEVEL_OFFSET) == 0, "the OUT stalls again on cycle 7, whose end refills")
    r.run(1)
    r.enable(0)
    assert(r.peek(0, X) == 0x99, "and runs on cycle 8")
    // With autopull a PULL is a no-op while the OSR is full, and pulls once a bit is out.
    r.exec(0, mov(OSR, 0, NUL))
    r.wr(pr.TXF0_OFFSET, 0x5)
    r.exec(0, pull(false, false))
    assert(r.rd(pr.FLEVEL_OFFSET) == 1)
    r.exec(0, out(NUL, 1))
    r.exec(0, pull(false, false))
    assert(r.rd(pr.FLEVEL_OFFSET) == 0)

@test("PUSH and PULL: IfFull and IfEmpty at their thresholds, Block stalling (RXSTALL, TXSTALL) and non-blocking ones: a PULL of an empty FIFO takes X, a PUSH to a full one is lost and still clears the ISR")
pio_push_pull()
    var r = rig()
    r.exec(0, set(X, 7))
    r.exec(0, pull(false, false))
    r.exec(0, mov(Y, 0, OSR))
    assert(r.peek(0, Y) == 7, "non-blocking PULL of an empty FIFO copies X")
    r.exec(0, pull(false, true))
    assert(r.rd(sm_reg(0, EXECCTRL)) & pr.SM0_EXECCTRL_EXEC_STALLED_MASK != 0 && r.rd(pr.FDEBUG_OFFSET) == 0x01000000, "blocking: stalled, TXSTALL")
    r.wr(pr.TXF0_OFFSET, 42)
    r.run(1)
    assert(r.rd(sm_reg(0, EXECCTRL)) & pr.SM0_EXECCTRL_EXEC_STALLED_MASK == 0 && r.peek(0, OSR) == 42)
    // IfEmpty: no pull until PULL_THRESH bits are out.
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | (8 << 25))
    r.wr(pr.TXF0_OFFSET, 43)
    r.exec(0, pull(true, false))
    assert(r.rd(pr.FLEVEL_OFFSET) == 1)
    r.exec(0, out(NUL, 8))
    r.exec(0, pull(true, false))
    assert(r.rd(pr.FLEVEL_OFFSET) == 0)
    // Four pushes fill the RX FIFO; a fifth blocking one stalls, a non-blocking one is lost.
    for i in 0u32..<4
        r.exec(0, set(X, i))
        r.exec(0, in_(X, 32))
        r.exec(0, push(false, true))
    assert(r.rd(pr.FSTAT_OFFSET) & 1 == 1, "RXFULL")
    r.wr(pr.FDEBUG_OFFSET, 0xffffffff)
    r.exec(0, set(X, 9))
    r.exec(0, in_(X, 32))
    r.exec(0, push(false, false))
    assert(r.rd(pr.FDEBUG_OFFSET) == 1, "RXSTALL for the lost word")
    r.exec(0, push(true, false))
    assert(r.rd(sm_reg(0, EXECCTRL)) & pr.SM0_EXECCTRL_EXEC_STALLED_MASK == 0, "the ISR was cleared: IfFull does nothing")
    r.exec(0, in_(X, 32))
    r.exec(0, push(false, true))
    assert(r.rd(sm_reg(0, EXECCTRL)) & pr.SM0_EXECCTRL_EXEC_STALLED_MASK != 0)
    assert(r.rd(pr.RXF0_OFFSET) == 0)
    r.run(1)
    assert(r.rd(pr.FSTAT_OFFSET) & 1 == 1 && r.rd(sm_reg(0, EXECCTRL)) & pr.SM0_EXECCTRL_EXEC_STALLED_MASK == 0, "pushed once there was room")
    for want in [1u32, 2, 3, 9] do assert(r.rd(pr.RXF0_OFFSET) == want)
    r.exec(0, 0x8001)
    assert(r.fault().ends_with("a PUSH or PULL with reserved bits set"))

@test("MOV: invert and bit-reverse; to PINS and PINDIRS through the OUT mapping, from PINS through the IN mapping and IN_COUNT; to ISR and OSR resetting their counts, to PC and EXEC; STATUS by TX level, RX level and IRQ flags of this block and both neighbours; the reserved encodings refused")
pio_mov()
    var r = rig()
    r.exec(0, set(X, 5))
    r.exec(0, mov(Y, 1, X))
    assert(r.peek(0, Y) == 0xfffffffa)
    r.exec(0, mov(Y, 2, X))
    assert(r.peek(0, Y) == 0xa0000000)
    r.wr(sm_reg(0, PINCTRL), 4 | (4 << 20) | (4 << 15))
    r.exec(0, mov(PINS, 1, NUL))
    r.exec(0, mov(3, 0, X))
    assert(r.rd(pr.DBG_PADOUT_OFFSET) == 0xf0 && r.rd(pr.DBG_PADOE_OFFSET) == 0x50, "~NULL to pins 4–7; 0101 to their directions")
    r.wr(pr.INPUT_SYNC_BYPASS_OFFSET, 0xffffffff)
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | 2)
    r.p.drive(r.t, 0xff0)
    r.exec(0, mov(Y, 0, PINS))
    assert(r.peek(0, Y) == 3, "pins 4 and 5: IN_COUNT 2")
    // ISR's count back to 0: IfFull at 8 then does nothing.
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | (8 << 20))
    r.exec(0, in_(X, 8))
    r.exec(0, mov(ISR, 0, Y))
    r.exec(0, push(true, false))
    assert(r.rd(pr.FLEVEL_OFFSET) == 0)
    // OSR's count to 0, full: !OSRE.
    r.exec(0, mov(OSR, 0, X))
    assert(jumps(&r, 7))
    r.exec(0, mov(5, 0, X))
    assert(r.pc(0) == 5, "PC")
    r.put_x(0, set(Y, 30))
    r.exec(0, mov(4, 0, X))
    r.run(1)
    assert(r.peek(0, Y) == 30, "EXEC ran the SET on the next cycle")
    // STATUS: TX level below 2; RX level below 1; IRQ 3, then the previous block's 2 and the next's 1.
    r.wr(sm_reg(0, EXECCTRL), 0x1f000 | 2)
    r.wr(pr.TXF0_OFFSET, 1)
    r.exec(0, mov(Y, 0, STATUS))
    assert(r.peek(0, Y) == 0xffffffff)
    r.wr(pr.TXF0_OFFSET, 1)
    r.exec(0, mov(Y, 0, STATUS))
    assert(r.peek(0, Y) == 0, "two words: not below 2")
    r.wr(sm_reg(0, EXECCTRL), 0x1f000 | (1 << 5) | 1)
    r.exec(0, mov(Y, 0, STATUS))
    assert(r.peek(0, Y) == 0xffffffff, "RX empty")
    for (n, block, flag) in [(3u32, 0u32, 3u32), (10, 2, 2), (17, 1, 1)]
        r.wr(sm_reg(0, EXECCTRL), 0x1f000 | (2 << 5) | n)
        r.exec(0, mov(Y, 0, STATUS))
        assert(r.peek(0, Y) == 0, s"STATUS_N $n clear")
        r.wrb(block, pr.IRQ_FORCE_OFFSET, 1 << flag)
        r.exec(0, mov(Y, 0, STATUS))
        assert(r.peek(0, Y) == 0xffffffff, s"STATUS_N $n set")
        r.wrb(block, pr.IRQ_OFFSET, 0xff)
    assert(refused(r.p.write(0, r.t, sm_reg(0, EXECCTRL), 4, 3 << 5)), "STATUS_SEL 3")
    r.wr(sm_reg(0, EXECCTRL), 0x1f000 | (2 << 5) | 24)
    r.exec(0, mov(Y, 0, STATUS))
    assert(r.fault().ends_with("EXECCTRL.STATUS_N 24 names no IRQ flag (0–7 this block, 8–15 the previous, 16–23 the next)"))
    var e = rig()
    e.wr(sm_reg(0, EXECCTRL), 0x1f000 | 5)
    e.exec(0, mov(Y, 0, STATUS))
    assert(e.fault().ends_with("EXECCTRL.STATUS_N 5 is more than the TX FIFO's depth 4, which is reserved"))
    e.exec(1, mov(Y, 3, X))
    assert(e.fault().ends_with("MOV operation 3 is reserved"))
    e.exec(2, mov(Y, 0, 4))
    assert(e.fault().ends_with("MOV source 4 is reserved"))

@test("IRQ: set and clear, made at the end of the cycle; REL adds the state machine's number to the low two bits; WAIT holds until the flag is cleared and then takes its delay; PREV and NEXT reach the neighbouring blocks unless ACCESSCTRL disconnects them; INTR, INTE, INTF, INTS and the two lines")
pio_irq()
    var r = rig()
    r.exec(0, irq(false, false, 0, 2))
    assert(r.rd(pr.IRQ_OFFSET) == 4 && r.rd(pr.INTR_OFFSET) == 0x4f0)
    r.exec(0, irq(true, false, 0, 2))
    assert(r.rd(pr.IRQ_OFFSET) == 0)
    r.exec(2, irq(false, false, 2, 1))
    assert(r.rd(pr.IRQ_OFFSET) == 8, "SM2's 1 REL is 3")
    r.exec(3, irq(false, false, 2, 5))
    assert(r.rd(pr.IRQ_OFFSET) == 0x18, "SM3's 5 REL is 4")
    r.wr(pr.IRQ_OFFSET + SET, 0x18)
    assert(r.rd(pr.IRQ_OFFSET) == 0, "a 1 clears through any alias")
    r.wr(pr.IRQ_FORCE_OFFSET + CLR, 0xff)
    assert(r.rd(pr.IRQ_OFFSET) == 0, "the CLR alias forces nothing")
    // WAIT: [0] raises 6 and waits, delay 2 after; [1] a NOP.
    var w = rig()
    w.load(0, [delay(irq(false, true, 0, 6), 2), nop(), nop()])
    w.enable(1)
    w.run(5)
    assert(w.pc(0) == 0 && w.rd(pr.IRQ_OFFSET) == 0x40)
    w.wr(pr.IRQ_OFFSET, 0x40)
    val after_clear = moves(&w, 5)
    assert(after_clear == "1 4 5 ", s"cleared: done on the next cycle, two of delay, then the NOPs: $after_clear")
    // PREV and NEXT: from block 0, NEXT is PIO1 and PREV PIO2.
    var n = rig()
    n.exec(0, irq(false, false, 3, 1))
    n.exec(0, irq(false, false, 1, 5))
    assert(n.rdb(1, pr.IRQ_OFFSET) == 2 && n.rdb(2, pr.IRQ_OFFSET) == 0x20 && n.rd(pr.IRQ_OFFSET) == 0)
    // PIO1's SM0 waits for PIO0's flag 1 through PREV, and clears it.
    n.wrb(1, sm_reg(0, INSTR), wait(1, 2, (1 << 3) | 1))
    n.run(3)
    assert(n.rdb(1, sm_reg(0, EXECCTRL)) & pr.SM0_EXECCTRL_EXEC_STALLED_MASK != 0)
    n.wr(pr.IRQ_FORCE_OFFSET, 2)
    n.run(1)
    assert(n.rdb(1, sm_reg(0, EXECCTRL)) & pr.SM0_EXECCTRL_EXEC_STALLED_MASK == 0 && n.rd(pr.IRQ_OFFSET) == 0, "taken, and PIO0's flag cleared")
    // PIO0 Non-secure, PIO1 not: disconnected.
    n.p.ns = 1
    n.exec(0, irq(false, false, 3, 7))
    assert(n.rdb(1, pr.IRQ_OFFSET) == 2, "PIO1's flag 7 not set")
    n.wrb(1, sm_reg(0, INSTR), wait(1, 2, (1 << 3) | 0))
    n.wr(pr.IRQ_FORCE_OFFSET, 1)
    n.run(3)
    assert(n.rdb(1, sm_reg(0, EXECCTRL)) & pr.SM0_EXECCTRL_EXEC_STALLED_MASK != 0 && n.rd(pr.IRQ_OFFSET) == 1, "PIO0's flag reads 0 from PIO1")
    // The interrupt lines.
    var l = rig()
    l.wr(pr.IRQ0_INTE_OFFSET, 1 << 8)
    assert(!l.p.irq_line(0, 0))
    l.wr(pr.IRQ_FORCE_OFFSET, 1)
    assert(l.p.irq_line(0, 0) && l.rd(pr.IRQ0_INTS_OFFSET) == 0x100 && !l.p.irq_line(0, 1))
    l.wr(pr.IRQ1_INTE_OFFSET, 0x10)
    assert(l.p.irq_line(0, 1) && l.rd(pr.IRQ1_INTS_OFFSET) == 0x10, "SM0's TX FIFO not full")
    l.wr(pr.IRQ1_INTE_OFFSET, 1)
    l.wr(pr.IRQ1_INTF_OFFSET, 1)
    assert(l.p.irq_line(0, 1) && l.rd(pr.IRQ1_INTS_OFFSET) == 1 && l.rd(pr.INTR_OFFSET) & 1 == 0, "forced: INTF, not INTR")
    l.exec(0, 0xc080)
    assert(l.fault().ends_with("IRQ with bit 7 set is reserved"))

@test("SET: X and Y take the five bits and clear the rest; PINS and PINDIRS through SET_BASE and SET_COUNT; destination 3 is reserved")
pio_set()
    var r = rig()
    r.exec(0, mov(X, 1, NUL))
    r.exec(0, set(X, 31))
    assert(r.peek(0, X) == 31)
    r.wr(sm_reg(0, PINCTRL), (2 << 5) | (3 << 26))
    r.exec(0, set(PINS, 0b11110))
    r.exec(0, set(PINDIRS, 0b101))
    assert(r.rd(pr.DBG_PADOUT_OFFSET) == 0x18 && r.rd(pr.DBG_PADOE_OFFSET) == 0x14, "three pins from 2: 110 and 101")
    r.exec(0, set(3, 1))
    assert(r.fault().ends_with("SET destination 3 is reserved"))

@test("side-set: the top bits of the delay field, optional with SIDE_EN, to directions with SIDE_PINDIR, made as the instruction issues even when it stalls, over its own OUT or SET; between state machines the higher-numbered wins; OUT_STICKY and INLINE_OUT_EN")
pio_side_set()
    var r = rig()
    r.wr(sm_reg(0, PINCTRL), (2 << 29) | (4 << 10))
    r.exec(0, delay(nop(), (2 << 3) | 1))
    assert(r.rd(pr.DBG_PADOUT_OFFSET) == 0x20, "side 2 on pins 4 and 5")
    r.wr(sm_reg(0, EXECCTRL), 0x1f000 | pr.SM0_EXECCTRL_SIDE_EN_MASK)
    r.exec(0, nop())
    assert(r.rd(pr.DBG_PADOUT_OFFSET) == 0x20, "no side-set")
    r.exec(0, delay(nop(), 0b11000))
    assert(r.rd(pr.DBG_PADOUT_OFFSET) == 0x30, "side 1 on pin 4 only: one data bit")
    r.wr(sm_reg(0, EXECCTRL), 0x1f000 | pr.SM0_EXECCTRL_SIDE_EN_MASK | pr.SM0_EXECCTRL_SIDE_PINDIR_MASK)
    r.exec(0, delay(nop(), 0b11000))
    assert(r.rd(pr.DBG_PADOE_OFFSET) == 0x10 && r.rd(pr.DBG_PADOUT_OFFSET) == 0x30, "to the direction")
    // A stalled PULL still makes its side-set; over a SET of the same pin.
    var s = rig()
    s.wr(sm_reg(0, PINCTRL), (1 << 29) | (1 << 26))
    s.exec(0, delay(pull(false, true), 16))
    assert(stalled(&s) && s.rd(pr.DBG_PADOUT_OFFSET) == 1)
    s.restart(0)
    s.exec(0, delay(set(PINS, 0), 16))
    assert(s.rd(pr.DBG_PADOUT_OFFSET) == 1, "side-set wins over SET")
    s.exec(0, set(PINS, 0))
    assert(s.rd(pr.DBG_PADOUT_OFFSET) == 0)
    // SM0 and SM1 SET pin 0 on one cycle: SM1's wins.
    var two = rig()
    for k in 0u32..<2 do two.wr(sm_reg(k, PINCTRL), 1 << 26)
    two.wr(sm_reg(0, INSTR), set(PINS, 1))
    two.wr(sm_reg(1, INSTR), set(PINS, 0))
    two.run(1)
    assert(two.rd(pr.DBG_PADOUT_OFFSET) == 0)
    // SM0 sticky at 1; SM1's 0 lasts its cycle.
    two.wr(sm_reg(0, EXECCTRL), 0x1f000 | pr.SM0_EXECCTRL_OUT_STICKY_MASK)
    two.exec(0, set(PINS, 1))
    two.exec(1, set(PINS, 0))
    assert(two.rd(pr.DBG_PADOUT_OFFSET) == 0)
    two.run(1)
    assert(two.rd(pr.DBG_PADOUT_OFFSET) == 1, "SM0's sticky write again")
    // INLINE_OUT_EN on OUT data bit 3: 1011 is written, 0101 is not and lets the sticky write go.
    two.wr(sm_reg(0, EXECCTRL), 0x1f000 | pr.SM0_EXECCTRL_OUT_STICKY_MASK | pr.SM0_EXECCTRL_INLINE_OUT_EN_MASK | (3 << 19))
    two.wr(sm_reg(0, PINCTRL), 4 << 20)
    two.wr(pr.TXF0_OFFSET, 0x5b)
    two.exec(0, pull(false, false))
    two.exec(0, out(PINS, 4))
    assert(two.rd(pr.DBG_PADOUT_OFFSET) == 0xb)
    two.exec(0, out(PINS, 4))
    assert(two.rd(pr.DBG_PADOUT_OFFSET) == 0xb, "0101: no write")
    two.exec(1, set(PINS, 0))
    two.run(1)
    assert(two.rd(pr.DBG_PADOUT_OFFSET) == 0xa, "the sticky write was let go")
    // SIDE_EN with no side-set bits is refused when an instruction runs.
    var z = rig()
    z.wr(sm_reg(0, PINCTRL), 0)
    z.wr(sm_reg(0, EXECCTRL), 0x1f000 | pr.SM0_EXECCTRL_SIDE_EN_MASK)
    z.exec(0, nop())
    assert(z.fault().ends_with("EXECCTRL.SIDE_EN with PINCTRL.SIDESET_COUNT 0 leaves no enable bit"))

@test("the FIFOs: 4 and 4, or 8 joined either way with the other reading full and empty; TXOVER and RXUNDER; flushed when a join bit changes; FSTAT, FLEVEL and INTR follow them")
pio_fifos()
    var r = rig()
    r.wr(sm_reg(1, SHIFTCTRL), 0xc0000 | pr.SM0_SHIFTCTRL_FJOIN_TX_MASK)
    for i in 0u32..<9 do r.wr(pr.TXF1_OFFSET, i)
    assert(r.rd(pr.FLEVEL_OFFSET) == 0x800 && r.rd(pr.FDEBUG_OFFSET) == 0x20000, "eight in, the ninth lost: TXOVER")
    assert(r.rd(pr.FSTAT_OFFSET) == 0x0d020f02, "SM1: TX full; RX full and empty")
    assert(r.rd(pr.INTR_OFFSET) == 0xd0, "SM1's TX full")
    r.wr(sm_reg(1, SHIFTCTRL), 0xc0000)
    assert(r.rd(pr.FLEVEL_OFFSET) == 0 && r.rd(pr.FSTAT_OFFSET) == 0x0f000f00, "flushed")
    r.wr(sm_reg(1, SHIFTCTRL), 0xc0000 | pr.SM0_SHIFTCTRL_FJOIN_RX_MASK)
    for i in 0u32..<8
        r.exec(1, set(X, i))
        r.exec(1, mov(ISR, 0, X))
        r.exec(1, push(false, false))
    assert(r.rd(pr.FLEVEL_OFFSET) == 0x8000 && r.rd(pr.FSTAT_OFFSET) == 0x0f020d02 && r.rd(pr.INTR_OFFSET) == 0xd2)
    r.wr(pr.FDEBUG_OFFSET, 0xffffffff)
    r.wr(pr.TXF1_OFFSET, 1)
    assert(r.rd(pr.FDEBUG_OFFSET) == 0x20000, "TX disabled: a write is lost")
    for i in 0u32..<8 do assert(r.rd(pr.RXF1_OFFSET) == i)
    assert(r.rd(pr.RXF1_OFFSET) == 0 && r.rd(pr.FDEBUG_OFFSET) == 0x20200, "RXUNDER")
    r.wr(pr.FDEBUG_OFFSET + CLR, 0x200)
    assert(r.rd(pr.FDEBUG_OFFSET) == 0x20000, "write 1 to clear, through the CLR alias too")
    assert(!r.p.write(0, r.t, pr.TXF1_OFFSET + SET, 4, 1).is_ok() && r.rd(pr.FLEVEL_OFFSET) == 0, "no FIFO through an alias")
    assert(read_refused(r.p.read(0, r.t, pr.TXF1_OFFSET, 4)), "TXF is write-only")
    assert(r.rd(pr.INSTR_MEM0_OFFSET + 8) == 0, "the instruction memory reads 0")

@test("FJOIN_RX_PUT and FJOIN_RX_GET: MOV RXFIFO[Y or n], ISR and MOV OSR, RXFIFO[Y or n] reach the RX entries, and RXFn_PUTGETm gives them to the processor while exactly one is set")
pio_putget()
    var r = rig()
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | pr.SM0_SHIFTCTRL_FJOIN_TX_MASK | pr.SM0_SHIFTCTRL_FJOIN_RX_PUT_MASK)
    assert(r.rd(sm_reg(0, SHIFTCTRL)) == 0xc8000, "setting PUT clears the joins")
    r.exec(0, set(X, 9))
    r.exec(0, mov(ISR, 0, X))
    r.exec(0, set(Y, 1))
    r.exec(0, 0x8010)
    r.exec(0, set(X, 21))
    r.exec(0, mov(ISR, 0, X))
    r.exec(0, 0x801b)
    assert(r.rd(pr.RXF0_PUTGET1_OFFSET) == 9 && r.rd(pr.RXF0_PUTGET3_OFFSET) == 21, "RXFIFO[Y] with Y 1, and RXFIFO[3]")
    assert(r.rd(pr.FSTAT_OFFSET) & 0x101 == 0x101, "the RX FIFO reads full and empty")
    r.wr(pr.RXF0_PUTGET2_OFFSET, 77)
    r.exec(0, 0x809a)
    assert(r.fault().ends_with("MOV OSR, RXFIFO[] needs SHIFTCTRL.FJOIN_RX_GET"))
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | pr.SM0_SHIFTCTRL_FJOIN_RX_GET_MASK)
    r.wr(pr.RXF0_PUTGET0_OFFSET, 0x1234)
    r.exec(0, set(Y, 0))
    r.exec(0, 0x8090)
    r.exec(0, mov(X, 0, OSR))
    r.exec(0, 0x809a)
    // The RX FIFO back, to read them with.
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000)
    assert(r.peek(0, X) == 0x1234, "RXFIFO[Y], Y 0")
    assert(r.peek(0, OSR) == 77, "RXFIFO[2], written while PUT was set")
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | pr.SM0_SHIFTCTRL_FJOIN_RX_GET_MASK)
    r.exec(0, 0x8010)
    assert(r.fault().ends_with("MOV RXFIFO[], ISR needs SHIFTCTRL.FJOIN_RX_PUT"))
    r.exec(0, 0x8014)
    assert(r.fault().ends_with("a MOV to or from the RX FIFO with reserved bits set"))
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | pr.SM0_SHIFTCTRL_FJOIN_RX_GET_MASK | pr.SM0_SHIFTCTRL_FJOIN_RX_PUT_MASK)
    assert(read_refused(r.p.read(0, r.t, pr.RXF0_PUTGET1_OFFSET, 4)), "both set: the processor's access is refused")
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000)
    assert(refused(r.p.write(0, r.t, pr.RXF0_PUTGET1_OFFSET, 4, 1)))

@test("SM_RESTART clears the ISR, both counts, the delay and a stalled system instruction, and keeps OSR, X and Y; SMx_INSTR runs on the next cycle, after a delay in progress, with EXEC_STALLED while it stalls")
pio_restart_exec()
    var r = rig()
    r.exec(0, set(X, 3))
    r.exec(0, set(Y, 4))
    r.wr(pr.TXF0_OFFSET, 0xabc)
    r.exec(0, pull(false, false))
    r.exec(0, in_(X, 8))
    r.restart(0)
    r.wr(sm_reg(0, SHIFTCTRL), 0xc0000 | (8 << 20))
    r.exec(0, push(true, false))
    assert(r.rd(pr.FLEVEL_OFFSET) == 0, "the ISR's count cleared")
    assert(!jumps(&r, 7), "the OSR empty")
    assert(r.peek(0, OSR) == 0xabc && r.peek(0, X) == 3 && r.peek(0, Y) == 4)
    r.exec(0, pull(false, true))
    assert(stalled(&r))
    r.restart(0)
    assert(!stalled(&r))
    r.wr(pr.TXF0_OFFSET, 5)
    r.run(3)
    assert(r.rd(pr.FLEVEL_OFFSET) == 1, "the PULL was cleared")
    var d = rig()
    d.load(0, [delay(nop(), 20), nop(), nop()])
    d.enable(1)
    d.run(2)
    d.wr(pr.CTRL_OFFSET, 0x11)
    val restarted = moves(&d, 2)
    assert(restarted == "1 2 ", s"the delay cleared: the NOPs run on: $restarted")
    var e = rig()
    e.load(0, [delay(nop(), 5), nop(), nop()])
    e.enable(1)
    e.run(1)
    e.wr(sm_reg(0, INSTR), set(X, 9))
    val moved = moves(&e, 7)
    assert(moved == "7 ", s"the SET at cycle 7, after the delay, leaves the PC; the NOP at 8 moves it: $moved")
    e.enable(0)
    assert(e.peek(0, X) == 9)
    assert(!e.p.write(0, e.t, sm_reg(0, INSTR) + SET, 4, 1).is_ok(), "no SMx_INSTR through an alias")

@test("CTRL's NEXTPREV operations start, stop and restart the dividers of the neighbouring blocks' state machines, disable winning; not between disconnected blocks")
pio_nextprev()
    var r = rig()
    r.wr(pr.CTRL_OFFSET, (1 << 20) | pr.CTRL_NEXTPREV_SM_ENABLE_MASK)
    assert(r.rdb(1, pr.CTRL_OFFSET) == 1 && r.rdb(2, pr.CTRL_OFFSET) == 0)
    r.wr(pr.CTRL_OFFSET, (3 << 16) | (1 << 20) | pr.CTRL_NEXTPREV_SM_ENABLE_MASK | pr.CTRL_NEXTPREV_SM_DISABLE_MASK)
    assert(r.rdb(1, pr.CTRL_OFFSET) == 0 && r.rdb(2, pr.CTRL_OFFSET) == 0, "disable wins")
    r.wrb(2, pr.CTRL_OFFSET, (2 << 20) | pr.CTRL_NEXTPREV_SM_ENABLE_MASK)
    assert(r.rd(pr.CTRL_OFFSET) == 2, "PIO2's next is PIO0")
    // PIO1's SM0 at 3.0 from cycle 0, restarted from PIO0 at cycle 4.
    var c = rig()
    c.load(1, nops())
    c.wrb(1, sm_reg(0, CLKDIV), 0x30000)
    c.wrb(1, pr.CTRL_OFFSET, 0x101)
    c.run(4)
    c.wr(pr.CTRL_OFFSET, (1 << 20) | pr.CTRL_NEXTPREV_CLKDIV_RESTART_MASK)
    c.run(2)
    assert(c.rdb(1, sm_reg(0, ADDR)) == 1, "would have moved at 6")
    c.run(1)
    assert(c.rdb(1, sm_reg(0, ADDR)) == 2, "moved at 7")
    c.p.ns = 2
    c.wr(pr.CTRL_OFFSET, (1 << 20) | pr.CTRL_NEXTPREV_SM_DISABLE_MASK)
    assert(c.rdb(1, pr.CTRL_OFFSET) == 1, "disconnected")

@test("refused writes change nothing: SIDESET_COUNT, SET_COUNT and OUT_COUNT beyond their ranges; with every state machine off the blocks have nothing to run")
pio_refusals()
    var r = rig()
    for (value, why) in [(6u32 << 29, "SM1_PINCTRL.SIDESET_COUNT 6 is more than 5"), (6 << 26, "SM1_PINCTRL.SET_COUNT 6 is more than 5"), (33 << 20, "SM1_PINCTRL.OUT_COUNT 33 is more than 32")]
        r.p.write(0, r.t, sm_reg(1, PINCTRL), 4, value) match
            Err(f) -> f match
                Refused(w) -> assert(w == why, w)
                Access(_) -> assert(false, why)
            Ok(_) -> assert(false, why)
        assert(r.rd(sm_reg(1, PINCTRL)) == 0x14000000)
    r.load(0, nops())
    r.enable(15)
    r.run(10)
    assert(r.p.running)
    r.enable(0)
    r.run(1)
    assert(!r.p.running, "nothing left to run")
