module sh.sysl.benchtop.peripheral.rp2350

import sh.sysl.benchtop.peripheral.rp2040.{Dma, DmaLayout, dma}
import sh.sysl.rp2350.dma as reg

// The RP2350's DMA (datasheet 12.6; `hardware/regs/dma.h`): the shared model (`peripheral/rp2040/dma.sysl`)
// at the RP2350's layout, 16 channels and four IRQ lines, with TRANS_COUNT.MODE, the INCR_*_REV bits and
// the SECCFG and MPU registers (stored at their reset values: rp-coverage item 12).

/** The RP2350's DMA layout. */
val RP2350_DMA: DmaLayout = DmaLayout("RP2350", 16, 4, true, reg.CH0_CTRL_TRIG_BUSY_MASK, reg.CH0_CTRL_TRIG_SNIFF_EN_MASK,
    reg.CH0_CTRL_TRIG_BSWAP_MASK, reg.CH0_CTRL_TRIG_IRQ_QUIET_MASK, reg.CH0_CTRL_TRIG_TREQ_SEL_MASK,
    reg.CH0_CTRL_TRIG_CHAIN_TO_MASK, reg.CH0_CTRL_TRIG_RING_SEL_MASK, reg.CH0_CTRL_TRIG_RING_SIZE_MASK,
    reg.CH0_CTRL_TRIG_INCR_WRITE_REV_MASK, reg.CH0_CTRL_TRIG_INCR_WRITE_MASK, reg.CH0_CTRL_TRIG_INCR_READ_REV_MASK,
    reg.CH0_CTRL_TRIG_INCR_READ_MASK, reg.CH0_CTRL_TRIG_DATA_SIZE_MASK, reg.CH0_CTRL_TRIG_HIGH_PRIORITY_MASK,
    reg.CH0_CTRL_TRIG_EN_MASK, reg.CH0_TRANS_COUNT_COUNT_MASK)

/** The TREQ_SEL values whose request the RP2350 drives today, bit n for value n: the SPIs' four DREQs
 * (24 to 27) and the UARTs' (28 to 31), both answered by `Rp2350.uart_dreq`, the 12 PWM wraps (32 to 43,
 * `Pwm.dreq`), the SHA-256 core's (54, `Rp2350.sha`), the four pacing timers (0x3b to 0x3e) and the
 * permanent request (0x3f). Each device that lands with a DREQ adds its bits here.
 */
const RP2350_TREQS: u64 = (0xFFu64 << 24) | (0xFFFu64 << 32) | (1u64 << 54) | (0x1Fu64 << 59)

/** The RP2350's DMA at power-on. */
rp2350_dma() -> Dma = dma(RP2350_DMA, RP2350_TREQS)

/** What the RP2350's TREQ_SEL value `sel` selects (`hardware/regs/dma.h`), as a refusal names it. */
treq_name(sel: u32) -> string
    if sel < 24 then return s"PIO${sel / 8}'s ${if sel % 8 < 4 then "TX" else "RX"} FIFO ${sel % 4}"
    if sel < 28 then return s"SPI${(sel - 24) / 2}'s ${if sel % 2 == 0 then "TX" else "RX"} FIFO"
    if sel < 32 then return s"UART${(sel - 28) / 2}'s ${if sel % 2 == 0 then "TX" else "RX"} FIFO"
    if sel < 44 then return s"PWM counter ${sel - 32}'s wrap"
    if sel < 48 then return s"I2C${(sel - 44) / 2}'s ${if sel % 2 == 0 then "TX" else "RX"} FIFO"
    if sel >= 0x3b && sel <= 0x3e then return s"pacing timer ${sel - 0x3b}"
    sel match
        48 -> "the ADC"
        49 -> "the XIP streaming FIFO"
        50 -> "XIP_QMITX"
        51 -> "XIP_QMIRX"
        52 -> "HSTX"
        53 -> "CORESIGHT"
        54 -> "SHA256"
        63 -> "the permanent request"
        _ -> "a reserved request"
