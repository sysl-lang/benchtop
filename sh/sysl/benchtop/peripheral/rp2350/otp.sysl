module sh.sysl.benchtop.peripheral.rp2350

import sh.sysl.benchtop.peripheral.rp2040.AccessError

// The OTP's read windows (datasheet 13.6, "OTP"; `hardware/regs/addressmap.h`'s OTP_DATA_* bases): the
// array of 4096 rows of 24 bits, as the boot ROM's functions read it (its `otp_access` and the guarded
// reads its flash and boot code make). The Pico 2's OTP as benchtop runs it is **blank**: no row has
// been programmed, so every row reads 0 through every window, the ECC ones included (an erased row is a
// valid codeword of 0, so the guarded windows raise no error either).
//
// - OTP_DATA and OTP_DATA_GUARDED: each row's 16 ECC-corrected bits, two rows to a word.
// - OTP_DATA_RAW and OTP_DATA_RAW_GUARDED: each row's 24 raw bits, a row to a word.
//
// Programming a row (the OTP block's SBPI bridge, or `otp_access` writing) and the OTP block's own
// registers (locks, the critical flags, ARCHSEL, keys) are rp-coverage item 26; an access to them is
// refused by name.

/** The OTP's rows. */
const OTP_ROWS: u32 = 4096

/** One of the OTP's read windows: ECC (two bytes a row) or raw (four), guarded or not. */
struct OtpWindow
    raw: bool

    /** A read of `width` bytes at `offset`: 0, the blank array, wherever a row is. Each window is
     * read-only.
     */
    read(self, offset: u32, width: u32) -> Result[u32, AccessError]
        if width != 1 && width != 2 && width != 4 then return Err(AccessError.InvalidWidth)
        if offset & (width - 1) != 0 then return Err(AccessError.Unaligned)
        val bytes_per_row: u32 = if self.raw then 4 else 2
        if offset >= OTP_ROWS * bytes_per_row then return Err(AccessError.Unmapped)
        Ok(0)
end OtpWindow
