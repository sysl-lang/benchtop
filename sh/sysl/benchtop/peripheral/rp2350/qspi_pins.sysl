module sh.sysl.benchtop.peripheral.rp2350

import sh.sysl.benchtop.peripheral.rp2040.{AccessError, access, read_lane, replicated, written}
import sh.sysl.rp2040.io_qspi as io_qspi40_reg
import sh.sysl.rp2350.io_qspi as io_qspi_reg

// The QSPI bank's pins, which the flash is wired to: PADS_QSPI and IO_QSPI (datasheet 9.11, "Pads",
// and 9.10, "IO user bank"; `hardware/regs/pads_qspi.h` and `io_qspi.h`). The boot ROM's flash
// functions (`connect_internal_flash`, `flash_exit_xip`) and the SDK's `hardware_flash`, which saves
// and restores the pads around a flash operation, write them. The flash itself is the QMI's
// (`parts/qspi_flash`), connected to it directly, so these registers drive nothing:
//
// - **PADS_QSPI**, stored: VOLTAGE_SELECT and the six pads' controls, with their reset values.
// - **IO_QSPI**, stored: the six pins' and the two USB PHY pins' CTRL, the raw interrupts (INTR,
//   write one to clear; no pin raises one), each core's and the dormant wake's enables and forces, and
//   their status (INTS, the enabled raw or forced bits). Each pin's STATUS, its levels in and out, is
//   refused by name: no pin of this bank is modelled as a level, so there is nothing to report.

//
// **The RP2040's** (RP2040 datasheet 2.19, `io_qspi.h` and `pads_qspi.h` for it) are the same blocks in
// their own shape (`io_qspi_rp2040`, `qspi_pads_rp2040`): six pins (SCLK, SS, SD0–SD3) and no USB PHY
// pins, and INTR at 0x30; CTRL's overrides at the RP2040's bits; pads with no ISO bit. There the
// SSI's chip select is SS's OUTOVER, which the chip reads (`Rp2040`), and a transfer needs every pin's
// FUNCSEL on the SSI.

/** PADS_QSPI's registers: VOLTAGE_SELECT, then SCLK, SD0–SD3 and SS. */
const QSPI_PADS: u32 = 7
/** IO_QSPI's pins: USBPHY_DP, USBPHY_DM, then SCLK, SS and SD0–SD3, in register order. */
const QSPI_IO_PINS: u32 = 8
/** The RP2040's IO_QSPI pins: SCLK, SS, SD0–SD3. */
const QSPI_IO_PINS_RP2040: u32 = 6

// Each pad's reset value (`*_RESET`), and the bits each register keeps (`*_BITS`), on each chip.
private val PAD_RESETS: [7]u32 = [0x000, 0x156, 0x156, 0x156, 0x15A, 0x15A, 0x15A]
private const PAD_BITS: u32 = 0x1FF
private val PAD_RESETS_RP2040: [7]u32 = [0x00, 0x56, 0x52, 0x52, 0x52, 0x52, 0x5A]
private const PAD_BITS_RP2040: u32 = 0xFF
private const CTRL_BITS: u32 = 0x3003F01F
private const CTRL_BITS_RP2040: u32 = 0x3003331F
private const CTRL_RESET: u32 = 0x1F

// INTR, then each core's INTE, INTF and INTS, then the dormant wake's, word by word.
private const INTERRUPT_WORDS: u32 = 10

/** PADS_QSPI: VOLTAGE_SELECT and each pad's controls, with the chip's reset values and bits. */
struct QspiPads
    pads: [7]u32
    resets: [7]u32
    bits: u32

    reset(*self)
        for i in 0..<QSPI_PADS do self.pads[i] = self.resets[i]

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val i = (offset & 0xFFF) >> 2
        if i >= QSPI_PADS then return Err(AccessError.Unmapped)
        Ok(read_lane(self.pads[i], offset, width))

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val i = (offset & 0xFFF) >> 2
        if i >= QSPI_PADS then return Err(AccessError.Unmapped)
        val bits: u32 = if i == 0 then 1 else self.bits
        self.pads[i] = written(self.pads[i], offset, replicated(value, width)) & bits
        Ok(())
end QspiPads

qspi_pads() -> QspiPads
    var state: QspiPads
    state.resets = PAD_RESETS
    state.bits = PAD_BITS
    state.reset()
    state

/** The RP2040's PADS_QSPI. */
qspi_pads_rp2040() -> QspiPads
    var state: QspiPads
    state.resets = PAD_RESETS_RP2040
    state.bits = PAD_BITS_RP2040
    state.reset()
    state

/** IO_QSPI: each pin's CTRL, and the interrupt registers from INTR on (`INTERRUPT_WORDS`), the INTS
 * words worked out when read; `pins` of them, CTRL keeping `ctrl_bits`.
 */
struct IoQspi
    ctrl: [8]u32
    irq: [10]u32
    pins: u32
    ctrl_bits: u32
    // Where INTR is.
    intr_at: u32

    reset(*self)
        for i in 0..<QSPI_IO_PINS do self.ctrl[i] = CTRL_RESET
        for i in 0..<INTERRUPT_WORDS do self.irq[i] = 0

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        if address < self.pins * 8
            if address & 4 == 0 then return Err(AccessError.Unmapped)
            return Ok(read_lane(self.ctrl[address >> 3], offset, width))
        val w = self.interrupt_word(address)?
        // INTS: what INTE lets through of INTR and INTF.
        val v = if w % 3 == 0 && w != 0 then (self.irq[0] | self.irq[w - 1]) & self.irq[w - 2] else self.irq[w]
        Ok(read_lane(v, offset, width))

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        val data = replicated(value, width)
        if address < self.pins * 8
            if address & 4 == 0 then return Err(AccessError.Unmapped)
            val i = address >> 3
            self.ctrl[i] = written(self.ctrl[i], offset, data) & self.ctrl_bits
            return Ok(())
        val w = self.interrupt_word(address)?
        if w == 0
            // INTR is write one to clear, whatever the alias; no pin raises an edge here to clear.
            self.irq[0] &= ~data
        elif w % 3 != 0
            self.irq[w] = written(self.irq[w], offset, data)
        Ok(())

    // The interrupt register at `address`: 0 for INTR, then 1–3 core 0's INTE, INTF, INTS, 4–6 core
    // 1's, 7–9 the dormant wake's.
    private interrupt_word(self, address: u32) -> Result[usize, AccessError]
        if address < self.intr_at || address >= self.intr_at + 4 * INTERRUPT_WORDS then return Err(AccessError.Unmapped)
        Ok(usize((address - self.intr_at) >> 2))
end IoQspi

io_qspi() -> IoQspi
    var state: IoQspi
    state.pins = QSPI_IO_PINS
    state.ctrl_bits = CTRL_BITS
    state.intr_at = io_qspi_reg.INTR_OFFSET
    state.reset()
    state

/** The RP2040's IO_QSPI. */
io_qspi_rp2040() -> IoQspi
    var state: IoQspi
    state.pins = QSPI_IO_PINS_RP2040
    state.ctrl_bits = CTRL_BITS_RP2040
    state.intr_at = io_qspi40_reg.INTR_OFFSET
    state.reset()
    state
