module sh.sysl.benchtop.peripheral.rp2350
@tests

import sh.sysl.rp2350.accessctrl as ac
import sh.sysl.rp2350.powman as pm
import sh.sysl.rp2350.rosc as rs
import sh.sysl.rp2350.timer0 as tm
import sh.sysl.rp2350.usb as usb_reg

// Every RP2350 model's write-1-to-clear flags and self-clearing controls through the plain address
// and the XOR, SET and CLR aliases, against the one rule in `peripheral/rp2040/access.sysl`.

private val ALIASES: [4]u32 = [0, 0x1000, 0x2000, 0x3000]
private const CLR: u32 = 0x3000
private const PW: u32 = 0x5AFE0000
private const ACCESS_PW: u32 = 0xACCE0000

@test("ROSC STATUS.BADWRITE: a 0 leaves it and a 1 clears it, through the plain address and every alias")
rosc_badwrite_aliases()
    for alias in ALIASES
        var r = rosc()
        r.write(rs.PHASE_OFFSET, 4, 0).unwrap()
        assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0, "PHASE without its password latches BADWRITE")
        r.write(rs.STATUS_OFFSET + alias, 4, ~rs.STATUS_BADWRITE_MASK).unwrap()
        assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK != 0, f"alias 0x${alias}%x: a 0 leaves it")
        r.write(rs.STATUS_OFFSET + alias, 4, rs.STATUS_BADWRITE_MASK).unwrap()
        assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK == 0, f"alias 0x${alias}%x: a 1 clears it")
        r.write(rs.STATUS_OFFSET + alias, 4, rs.STATUS_BADWRITE_MASK).unwrap()
        assert(r.read(rs.STATUS_OFFSET, 4).unwrap() & rs.STATUS_BADWRITE_MASK == 0, f"alias 0x${alias}%x: a 1 on a clear flag does not set it")

@test("POWMAN's write-1-to-clear flags (BADPASSWD, CHIP_RESET.RESCUE_FLAG, TIMER.ALARM, INTR.VREG_OUTPUT_LOW): a 0 leaves each, a 1 clears it, through every alias")
powman_w1c_aliases()
    for alias in ALIASES
        var p = powman()
        // BADPASSWD latches on a write without the password.
        p.write(pm.WDSEL_OFFSET, 4, 0).unwrap()
        p.write(pm.BADPASSWD_OFFSET + alias, 4, PW).unwrap()
        assert(p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 1, f"alias 0x${alias}%x: BADPASSWD, a 0")
        p.write(pm.BADPASSWD_OFFSET + alias, 4, PW | 1).unwrap()
        assert(p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 0, f"alias 0x${alias}%x: BADPASSWD, a 1")
        // RESCUE_FLAG is set by the debugger, which nothing models.
        p.words[usize(pm.CHIP_RESET_OFFSET / 4)] |= pm.CHIP_RESET_RESCUE_FLAG_MASK
        p.write(pm.CHIP_RESET_OFFSET + alias, 4, PW).unwrap()
        assert(p.read(pm.CHIP_RESET_OFFSET, 4).unwrap() == pm.CHIP_RESET_HAD_POR_MASK | pm.CHIP_RESET_RESCUE_FLAG_MASK, f"alias 0x${alias}%x: RESCUE_FLAG, a 0")
        p.write(pm.CHIP_RESET_OFFSET + alias, 4, PW | pm.CHIP_RESET_RESCUE_FLAG_MASK).unwrap()
        val chip_reset = p.read(pm.CHIP_RESET_OFFSET, 4).unwrap()
        assert(chip_reset == pm.CHIP_RESET_HAD_POR_MASK, f"alias 0x${alias}%x: RESCUE_FLAG, a 1: 0x${chip_reset}%x")
        // ALARM latches with ALARM_ENAB at an alarm of 0, and stays latched once ALARM_ENAB is off.
        p.write(pm.TIMER_OFFSET, 4, PW | pm.TIMER_ALARM_ENAB_MASK).unwrap()
        p.write(pm.TIMER_OFFSET, 4, PW).unwrap()
        assert(p.read(pm.TIMER_OFFSET, 4).unwrap() == pm.TIMER_ALARM_MASK)
        p.write(pm.TIMER_OFFSET + alias, 4, PW).unwrap()
        assert(p.read(pm.TIMER_OFFSET, 4).unwrap() == pm.TIMER_ALARM_MASK, f"alias 0x${alias}%x: ALARM, a 0")
        p.write(pm.TIMER_OFFSET + alias, 4, PW | pm.TIMER_ALARM_MASK).unwrap()
        assert(p.read(pm.TIMER_OFFSET, 4).unwrap() == 0, f"alias 0x${alias}%x: ALARM, a 1")
        // VREG_OUTPUT_LOW is raised by the regulator, which nothing models.
        p.words[usize(pm.INTR_OFFSET / 4)] |= pm.INTR_VREG_OUTPUT_LOW_MASK
        p.write(pm.INTR_OFFSET + alias, 4, PW).unwrap()
        assert(p.read(pm.INTR_OFFSET, 4).unwrap() == pm.INTR_VREG_OUTPUT_LOW_MASK, f"alias 0x${alias}%x: VREG_OUTPUT_LOW, a 0")
        p.write(pm.INTR_OFFSET + alias, 4, PW | pm.INTR_VREG_OUTPUT_LOW_MASK).unwrap()
        assert(p.read(pm.INTR_OFFSET, 4).unwrap() == 0, f"alias 0x${alias}%x: VREG_OUTPUT_LOW, a 1")
        assert(p.read(pm.BADPASSWD_OFFSET, 4).unwrap() == 0, "every write carried the password")

@test("POWMAN TIMER's self-clearing controls: CLEAR and USE_XOSC fire on a 1 plainly, through XOR and through SET, never through CLR, and read 0")
powman_sc_aliases()
    for alias in ALIASES
        var p = powman()
        p.write(pm.SET_TIME_15TO0_OFFSET, 4, PW | 7).unwrap()
        p.write(pm.TIMER_OFFSET, 4, PW | pm.TIMER_RUN_MASK).unwrap()
        val running = p.read(pm.TIMER_OFFSET, 4).unwrap()
        assert(p.read(pm.READ_TIME_LOWER_OFFSET, 4).unwrap() == 7 && running == pm.TIMER_RUN_MASK | pm.TIMER_USING_LPOSC_MASK)
        // A plain write names RUN again, to keep the timer running.
        val keep = if alias == 0 then pm.TIMER_RUN_MASK else 0
        p.write(pm.TIMER_OFFSET + alias, 4, PW | keep).unwrap()
        assert(p.read(pm.READ_TIME_LOWER_OFFSET, 4).unwrap() == 7 && p.read(pm.TIMER_OFFSET, 4).unwrap() == running, f"alias 0x${alias}%x: a 0 fires nothing")
        p.write(pm.TIMER_OFFSET + alias, 4, PW | keep | pm.TIMER_CLEAR_MASK | pm.TIMER_USE_XOSC_MASK).unwrap()
        val timer = p.read(pm.TIMER_OFFSET, 4).unwrap()
        assert(timer & (pm.TIMER_CLEAR_MASK | pm.TIMER_USE_XOSC_MASK | pm.TIMER_USE_LPOSC_MASK) == 0, f"alias 0x${alias}%x: they read 0")
        if alias == CLR
            assert(p.read(pm.READ_TIME_LOWER_OFFSET, 4).unwrap() == 7 && timer & pm.TIMER_USING_LPOSC_MASK != 0, "CLR fires neither")
            assert(timer & pm.TIMER_RUN_MASK != 0, "and RUN, which it does not name, stays")
        else
            assert(p.read(pm.READ_TIME_LOWER_OFFSET, 4).unwrap() == 0 && timer & pm.TIMER_USING_XOSC_MASK != 0, f"alias 0x${alias}%x fires both")

@test("ACCESSCTRL CFGRESET is self-clearing: a 1 fires it plainly, through XOR and through SET, never through CLR, and a 0 never")
accessctrl_cfgreset_aliases()
    for alias in ALIASES
        var a = accessctrl()
        a.write(0, ac.PWM_OFFSET, 4, ACCESS_PW | 0x11).unwrap()
        a.write(0, ac.CFGRESET_OFFSET + alias, 4, ACCESS_PW).unwrap()
        assert(a.read(ac.PWM_OFFSET, 4).unwrap() == 0x11, f"alias 0x${alias}%x: a 0")
        a.write(0, ac.CFGRESET_OFFSET + alias, 4, ACCESS_PW | 1).unwrap()
        val pwm = a.read(ac.PWM_OFFSET, 4).unwrap()
        assert(pwm == (if alias == CLR then 0x11 else 0xFC), f"alias 0x${alias}%x: PWM 0x${pwm}%x")
        assert(a.read(ac.CFGRESET_OFFSET, 4).unwrap() == 0, "CFGRESET reads 0")

@test("TIMER0's ARMED and INTR, past LOCKED and SOURCE, are write-1-to-clear through every alias")
rp2350_timer_w1c_aliases()
    for alias in ALIASES
        var t = timer()
        t.write(tm.INTE_OFFSET, 4, 15).unwrap()
        t.write(tm.ALARM0_OFFSET, 4, 1).unwrap()
        t.write(tm.ALARM1_OFFSET, 4, 1).unwrap()
        t.write(tm.ALARM2_OFFSET, 4, 100).unwrap()
        t.write(tm.ALARM3_OFFSET, 4, 100).unwrap()
        t.advance(1)
        assert(t.read(tm.INTR_OFFSET, 4).unwrap() == 0b0011 && t.read(tm.ARMED_OFFSET, 4).unwrap() == 0b1100)
        t.write(tm.INTR_OFFSET + alias, 4, 0).unwrap()
        t.write(tm.ARMED_OFFSET + alias, 4, 0).unwrap()
        assert(t.read(tm.INTR_OFFSET, 4).unwrap() == 0b0011 && t.read(tm.ARMED_OFFSET, 4).unwrap() == 0b1100, f"alias 0x${alias}%x: a 0")
        t.write(tm.INTR_OFFSET + alias, 4, 0b0001).unwrap()
        t.write(tm.ARMED_OFFSET + alias, 4, 0b0100).unwrap()
        assert(t.read(tm.INTR_OFFSET, 4).unwrap() == 0b0010 && t.read(tm.ARMED_OFFSET, 4).unwrap() == 0b1000, f"alias 0x${alias}%x: a 1 clears only its own")
        assert(t.irqs() == 0b0010)

@test("USBCTRL SIE_CTRL's self-clearing controls read back 0 through every alias; the stored bits beside them keep the alias's operation")
usb_sie_ctrl_sc_aliases()
    val sc = usb_reg.SIE_CTRL_RESET_BUS_MASK | usb_reg.SIE_CTRL_RESUME_MASK | usb_reg.SIE_CTRL_STOP_TRANS_MASK | usb_reg.SIE_CTRL_START_TRANS_MASK
    val pd = usb_reg.SIE_CTRL_TRANSCEIVER_PD_MASK
    for alias in ALIASES
        var u = usb_ctrl()
        u.write(usb_reg.SIE_CTRL_OFFSET + alias, 4, sc | pd).unwrap()
        assert(u.read(usb_reg.SIE_CTRL_OFFSET, 4).unwrap() == (if alias == CLR then 0 else pd), f"alias 0x${alias}%x")
