module sh.sysl.benchtop.peripheral.rp2350

import sh.sysl.benchtop.peripheral.rp2040.{AccessError, access, read_lane, replicated, written}
import sh.sysl.rp2350.uart0 as reg

// UART0 and UART1: Arm PL011s (datasheet, "UART"; the PL011 TRM). Modelled: the data register both
// ways, the flags, the baud divisors, line and control registers stored as written, and the receive
// and transmit interrupts with their mask, raw, masked and clear registers. A byte written while the
// UART and its transmitter are enabled joins the 32-entry transmit FIFO, which the chip drains to the
// host (`take`) as the line would send it; the line's byte rate is not modelled, so the FIFO empties
// whenever the chip drains it. Received bytes wait in the 32-entry receive FIFO (`receive`). The
// modem lines, IrDA, break and the error flags are not modelled; the DMA control register is stored.

/** The PL011's FIFOs are 32 entries deep. */
const UART_FIFO: usize = 32

/** One of the PL011's byte FIFOs. */
struct ByteFifo
    bytes: [UART_FIFO]u8
    first: usize
    count: usize

    full(self) -> bool = self.count == UART_FIFO
    empty(self) -> bool = self.count == 0

    push(*self, b: u8)
        self.bytes[(self.first + self.count) % UART_FIFO] = b
        self.count += 1

    pop(*self) -> u8
        val b = self.bytes[self.first]
        self.first = (self.first + 1) % UART_FIFO
        self.count -= 1
        b
end ByteFifo

struct Uart
    ibrd: u32
    fbrd: u32
    lcr_h: u32
    cr: u32
    ifls: u32
    imsc: u32
    dmacr: u32
    // The transmit interrupt, which is latched until cleared rather than a level.
    tx_raw: bool
    rx: ByteFifo
    tx: ByteFifo

    reset(*self)
        self.ibrd = 0
        self.fbrd = 0
        self.lcr_h = 0
        // The receiver and transmitter enables power up set; the UART itself does not.
        self.cr = reg.UARTCR_RXE_MASK | reg.UARTCR_TXE_MASK
        // Both FIFO levels power up at half full.
        self.ifls = (2 << reg.UARTIFLS_RXIFLSEL_SHIFT) | (2 << reg.UARTIFLS_TXIFLSEL_SHIFT)
        self.imsc = 0
        self.dmacr = 0
        self.tx_raw = true
        self.rx = ByteFifo([0; UART_FIFO], 0, 0)
        self.tx = ByteFifo([0; UART_FIFO], 0, 0)

    private enabled(self, which: u32) -> bool = self.cr & reg.UARTCR_UARTEN_MASK != 0 && self.cr & which != 0

    /** A byte arrives on the receive line; false where the FIFO is full or the receiver is off. */
    receive(*self, b: u8) -> bool
        if !self.enabled(reg.UARTCR_RXE_MASK) || self.rx.full() then return false
        self.rx.push(b)
        true

    /** The next byte the line sends, if one waits. */
    take(*self) -> Option[u8] = if self.tx.empty() then None else Some(self.tx.pop())

    /** The raw interrupt status: receive while a byte waits, transmit while it is latched. */
    raw(self) -> u32 = (if self.rx.empty() then 0 else reg.UARTRIS_RXRIS_MASK) | (if self.tx_raw then reg.UARTRIS_TXRIS_MASK else 0)

    /** The UART's interrupt line. */
    irq(self) -> bool = self.raw() & self.imsc != 0

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        if address == reg.UARTDR_OFFSET && offset & 0x3000 != 0 then return Err(AccessError.UnsupportedAlias)
        val value = address match
            reg.UARTDR_OFFSET -> if self.rx.empty() then 0 else u32(self.rx.pop())
            reg.UARTRSR_OFFSET -> 0
            reg.UARTFR_OFFSET ->
                val rx_empty = if self.rx.empty() then reg.UARTFR_RXFE_MASK else 0
                val rx_full = if self.rx.full() then reg.UARTFR_RXFF_MASK else 0
                val tx_empty = if self.tx.empty() then reg.UARTFR_TXFE_MASK else 0
                val tx_full = if self.tx.full() then reg.UARTFR_TXFF_MASK else 0
                rx_empty | rx_full | tx_empty | tx_full
            reg.UARTILPR_OFFSET -> 0
            reg.UARTIBRD_OFFSET -> self.ibrd
            reg.UARTFBRD_OFFSET -> self.fbrd
            reg.UARTLCR_H_OFFSET -> self.lcr_h
            reg.UARTCR_OFFSET -> self.cr
            reg.UARTIFLS_OFFSET -> self.ifls
            reg.UARTIMSC_OFFSET -> self.imsc
            reg.UARTRIS_OFFSET -> self.raw()
            reg.UARTMIS_OFFSET -> self.raw() & self.imsc
            reg.UARTICR_OFFSET -> 0
            reg.UARTDMACR_OFFSET -> self.dmacr
            _ -> return Err(AccessError.Unmapped)
        Ok(read_lane(value, offset, width))

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        val data = replicated(value, width)
        if (address == reg.UARTDR_OFFSET || address == reg.UARTICR_OFFSET) && offset & 0x3000 != 0 then return Err(AccessError.UnsupportedAlias)
        address match
            reg.UARTDR_OFFSET ->
                // A byte written to a full FIFO is lost, as on the PL011.
                if self.enabled(reg.UARTCR_TXE_MASK) && !self.tx.full() then self.tx.push(u8(data & reg.UARTDR_DATA_MASK))
                self.tx_raw = true
            reg.UARTRSR_OFFSET | reg.UARTILPR_OFFSET | reg.UARTFR_OFFSET | reg.UARTRIS_OFFSET | reg.UARTMIS_OFFSET -> ()
            reg.UARTIBRD_OFFSET -> self.ibrd = written(self.ibrd, offset, data) & reg.UARTIBRD_BAUD_DIVINT_MASK
            reg.UARTFBRD_OFFSET -> self.fbrd = written(self.fbrd, offset, data) & reg.UARTFBRD_BAUD_DIVFRAC_MASK
            reg.UARTLCR_H_OFFSET -> self.lcr_h = written(self.lcr_h, offset, data) & ((reg.UARTLCR_H_SPS_MASK << 1) - 1)
            reg.UARTCR_OFFSET -> self.cr = written(self.cr, offset, data) & ((reg.UARTCR_CTSEN_MASK << 1) - 1)
            reg.UARTIFLS_OFFSET -> self.ifls = written(self.ifls, offset, data) & (reg.UARTIFLS_RXIFLSEL_MASK | reg.UARTIFLS_TXIFLSEL_MASK)
            reg.UARTIMSC_OFFSET -> self.imsc = written(self.imsc, offset, data) & ((reg.UARTIMSC_OEIM_MASK << 1) - 1)
            reg.UARTICR_OFFSET -> if data & reg.UARTICR_TXIC_MASK != 0 then self.tx_raw = false
            reg.UARTDMACR_OFFSET -> self.dmacr = written(self.dmacr, offset, data) & (reg.UARTDMACR_DMAONERR_MASK | reg.UARTDMACR_TXDMAE_MASK | reg.UARTDMACR_RXDMAE_MASK)
            _ -> return Err(AccessError.Unmapped)
        Ok(())
end Uart

uart() -> Uart
    var state: Uart
    state.reset()
    state
