module sh.sysl.benchtop.peripheral.rp2350

import sh.sysl.benchtop.peripheral.rp2040.{AccessError, Pwm, access, pwm_slice_of, read_lane, replicated, written}
import sh.sysl.rp2350.io_bank0 as io
import sh.sysl.rp2350.pads_bank0 as pads

// IO_BANK0 and PADS_BANK0 (datasheet, "GPIO", "Pads"): which function drives each of the 48 GPIOs,
// with the overrides, and the pads that let a pin drive at all. **Pads come up isolated on the
// RP2350**: a pad with ISO set does not drive, whatever its function asks, and IE clear reads its input
// as 0.
//
// **The function mux is one routing layer** (`route`): FUNCSEL picks a producer, every producer offers
// a level and an output enable (`Drive`), OUTOVER and OEOVER override them, and the pad decides. A
// function whose producer benchtop does not model is refused by name when it is selected, so no pin is
// ever silently driven by nothing (`unmodelled_function`). INOVER overrides what the functions read of
// the pad; IRQOVER what the GPIO interrupts see of it (`gpio_irq.sysl`), which are this bank's from
// INTR0 on, with IRQSUMMARY before them.

/** GPIOs in bank 0. */
const GPIO_COUNT: u32 = 48

/** IO_BANK0's interrupt line into each core (the SDK's `IO_IRQ_BANK0`). */
const IO_IRQ_BANK0: u32 = 21

// GPIOn_STATUS and GPIOn_CTRL repeat every 8 bytes; the pads' GPIOn every 4, after VOLTAGE_SELECT.
private const IO_STRIDE: u32 = io.GPIO1_STATUS_OFFSET - io.GPIO0_STATUS_OFFSET
private const PAD_STRIDE: u32 = pads.GPIO1_OFFSET - pads.GPIO0_OFFSET

/** What a function drives a pin with: an output level and an output enable. */
struct Drive
    out: bool
    oe: bool

/** What a pin does: whether its pad drives, the level on it, and what the pad reads back. */
struct Pin
    drives: bool
    level: bool
    input: bool

/** A producer FUNCSEL can route to a GPIO that benchtop models. */
enum Route
    // FUNCSEL 31: nothing drives the pin.
    Null
    // The SIO's GPIO_OUT and GPIO_OE bit.
    Sio
    // A UART's TX, which drives its line's level (`Uart.line_level`), and its RX, which drives nothing;
    // which UART is `uart_of`.
    UartTx
    UartRx
    // A PWM slice's channel: A on an even GPIO, B on an odd one (`pwm_slice_of`).
    Pwm
    // An SPI's SCK and TX, which drive its clock and MOSI levels (`Spis.sck`, `Spis.tx`), and its RX,
    // which drives nothing; which SPI is `spi_of`.
    SpiSck
    SpiTx
    SpiRx
    // An I2C controller's SDA and SCL (`i2c_of` says which), which drive nothing: the lines are open
    // drain, and benchtop carries their transfers a step at a time (`I2cBus`), not bit by bit.
    I2cSda
    I2cScl
    // HSTX output `n - 12` on GPIO 12 to 19 (`Hstx.output`).
    Hstx
    // PIO block 0, 1 or 2, which drives the pin GPIOBASE puts in its numbering.
    Pio0
    Pio1
    Pio2
end Route

/** Which UART a UART function on GPIO `n` belongs to: F2 and F11 alike, UART0 on GPIOs 0–3, 12–19,
 * 28–35 and 44–47, UART1 on the rest.
 */
uart_of(n: u32) -> usize = usize((n + 4) / 8 % 2)

/** FUNCSEL's value for PWM, on every GPIO of both chips. */
const PWM_FUNCTION: u32 = 4

/** What PWM offers GPIO `n` whose function it is: channel A always drives, and channel B unless its slice
 * reads the pin as an input. A stopped slice holds its level.
 */
pwm_drive(p: *Pwm, n: u32) -> Drive
    val k = pwm_slice_of(n)
    if n & 1 == 0 then Drive(p.level(k, false), true) else Drive(p.level(k, true), p.b_drives(k))

/** The producer FUNCSEL `f` routes to GPIO `n` (`f` one `unmodelled_function` lets through). */
route(n: u32, f: u32) -> Route
    // Most of the 48 GPIOs are NULL, and every pin is routed whenever the GPIOs are read: it goes first.
    if f == io.GPIO0_CTRL_FUNCSEL_NULL then return Route.Null
    if f == io.GPIO0_CTRL_FUNCSEL_SIO_0 then return Route.Sio
    if f == 0 && n >= 12 && n < 20 then return Route.Hstx
    // UARTs on F2 (TX, RX, CTS, RTS in each group of four) and F11 (TX and RX on the CTS and RTS pins).
    if f == io.GPIO0_CTRL_FUNCSEL_UART0_TX then return if n % 4 == 0 then Route.UartTx else Route.UartRx
    if f == io.GPIO2_CTRL_FUNCSEL_UART0_TX then return if n % 4 == 2 then Route.UartTx else Route.UartRx
    if f == PWM_FUNCTION then return Route.Pwm
    // SPIs on F1 (RX, CSn, SCK, TX in each group of four; CSn is refused).
    if f == io.GPIO0_CTRL_FUNCSEL_SPI0_RX then return n % 4 match
        0 -> Route.SpiRx
        2 -> Route.SpiSck
        3 -> Route.SpiTx
        _ -> Route.Null
    // I2C on F3, on both chips: SDA on the even GPIO, SCL on the odd.
    if f == io.GPIO0_CTRL_FUNCSEL_I2C0_SDA then return if n % 2 == 0 then Route.I2cSda else Route.I2cScl
    // PIO0, PIO1 and PIO2 on F6, F7 and F8.
    if f == io.GPIO0_CTRL_FUNCSEL_PIO0_0 then return Route.Pio0
    if f == io.GPIO0_CTRL_FUNCSEL_PIO1_0 then return Route.Pio1
    if f == io.GPIO0_CTRL_FUNCSEL_PIO2_0 then return Route.Pio2
    Route.Null

/** Why selecting FUNCSEL `f` on GPIO `n` is refused, where its producer is not modelled or the GPIO has
 * no such function; None for SIO, a UART's TX and RX, PWM, SPI but its CSn, I2C, HSTX, PIO0–2 and NULL.
 */
unmodelled_function(n: u32, f: u32) -> Option[string]
    val uart = (n + 4) / 8 % 2
    val what = f match
        5 | 6 | 7 | 8 | 31 -> return None
        0 ->
            if n < 4 then "JTAG, whose debug port is not modelled (docs/rp-coverage.md Q5: the GDB stub instead)"
            elif n >= 12 && n < 20 then return None
            else ""
        1 ->
            if n % 4 != 1 then return None
            s"SPI${n / 8 % 2}_CSN: the PL022's frame signal (a pulse between words in modes 0 and 2) is not modelled; drive the chip select from a GPIO, as the SDK's examples do"
        2 ->
            if n % 4 < 2 then return None
            val signal = if n % 4 == 2 then "CTS" else "RTS"
            s"UART${uart}_$signal: UART flow control is not modelled (docs/rp-coverage.md item 8)"
        3 | 4 -> return None
        9 ->
            if n == 0 || n == 8 || n == 19 || n == 47 then "XIP_SS_N_1, the QMI's second chip select, which drives no part (the Pico 2 has one flash)"
            elif n >= 1 && n < 6 then "CORESIGHT_TRACE, which is not modelled (docs/rp-coverage.md Q5)"
            elif ((n >= 12 && n < 16) || (n >= 20 && n < 24)) && n % 2 == 0 then "CLOCKS_GPIN, a clock input, which is not modelled"
            elif (n >= 12 && n < 16) || (n >= 20 && n < 26) then "CLOCKS_GPOUT, a clock output, which is not modelled"
            else ""
        10 -> "USB_MUXING (VBUS and overcurrent), which is not modelled (docs/rp-coverage.md item 20)"
        11 ->
            if n % 4 >= 2 then return None
            ""
        _ -> ""
    if what.is_empty() then return Some(s"GPIO $n has no function $f")
    Some(s"GPIO $n FUNCSEL $f selects $what")
end unmodelled_function

/** The input `ctrl`'s override `field` (INOVER's or IRQOVER's encoding) makes of the pad's `input`. */
private overridden(ctrl: u32, mask: u32, shift: u32, input: bool) -> bool = (ctrl & mask) >> shift match
    1 -> !input
    2 -> false
    3 -> true
    _ -> input

// The RP2040's GPIOn_CTRL puts OUTOVER at bits 9:8 and OEOVER at 13:12, where the RP2350's has them
// at 13:12 and 15:14; FUNCSEL, INOVER and IRQOVER are where the RP2350's are. `ctrl` holds the
// RP2350's layout on both chips, and these convert a word as the RP2040 reads and writes it.
private const RP2040_OUTOVER: u32 = 0x300
private const RP2040_OEOVER: u32 = 0x3000
private const SAME_PLACE: u32 = io.GPIO0_CTRL_FUNCSEL_MASK | io.GPIO0_CTRL_INOVER_MASK | io.GPIO0_CTRL_IRQOVER_MASK

private from_rp2040(x: u32) -> u32 = (x & SAME_PLACE) | ((x & RP2040_OUTOVER) << 4) | ((x & RP2040_OEOVER) << 2)
private to_rp2040(x: u32) -> u32 = (x & SAME_PLACE) | ((x & io.GPIO0_CTRL_OUTOVER_MASK) >> 4) | ((x & io.GPIO0_CTRL_OEOVER_MASK) >> 2)

struct IoBank0
    ctrl: [GPIO_COUNT]u32
    irq: GpioIrq
    // The chip's: its GPIOs, where IRQSUMMARY starts (INTR0 on the RP2040, which has none), and whether
    // CTRL is read and written in the RP2040's layout. A reset keeps them.
    count: u32
    summary_at: u32
    rp2040: bool

    reset(*self)
        for i in 0..<GPIO_COUNT do self.ctrl[i] = io.GPIO0_CTRL_FUNCSEL_NULL
        self.irq.reset()

    // GPIO `n`'s CTRL as the chip's programs see it.
    private native(self, n: u32) -> u32 = if self.rp2040 then to_rp2040(self.ctrl[n]) else self.ctrl[n]

    // GPIO `n`'s CTRL after `data` is written at `offset` through its alias, in the stored layout.
    private next_ctrl(self, n: u32, offset: u32, data: u32) -> u32
        val next = written(self.native(n), offset, data)
        if self.rp2040 then from_rp2040(next) else next

    /** The function selected on GPIO `n` (`FUNCSEL`; SIO is 5, NULL 31). */
    function(self, n: u32) -> u32 = self.ctrl[n] & io.GPIO0_CTRL_FUNCSEL_MASK

    /** What the functions read of GPIO `n`, whose pad reads `input`: INOVER applied. */
    peripheral_input(self, n: u32, input: bool) -> bool =
        overridden(self.ctrl[n], io.GPIO0_CTRL_INOVER_MASK, io.GPIO0_CTRL_INOVER_SHIFT, input)

    /** What the interrupts see of GPIO `n`, whose pad reads `input`: IRQOVER applied. */
    irq_input(self, n: u32, input: bool) -> bool =
        overridden(self.ctrl[n], io.GPIO0_CTRL_IRQOVER_MASK, io.GPIO0_CTRL_IRQOVER_SHIFT, input)

    /** Why the write of `value` at `offset` is refused: a CTRL whose new FUNCSEL is not modelled. */
    unmodelled(self, offset: u32, width: u32, value: u32) -> Option[string]
        val address = offset & 0xFFC
        val n = address / IO_STRIDE
        if address >= self.summary_at || n >= self.count || address % IO_STRIDE != io.GPIO0_CTRL_OFFSET || access(offset, width, true).is_err() then return None
        val next = self.next_ctrl(n, offset, replicated(value, width)) & io.GPIO0_CTRL_FUNCSEL_MASK
        if next == self.function(n) then None elif self.rp2040 then unmodelled_function_rp2040(n, next) else unmodelled_function(n, next)

    /** GPIO `n`'s output and enable after CTRL's overrides of what its function drives. */
    after_overrides(self, n: u32, d: Drive) -> Drive
        val ctrl = self.ctrl[n]
        val out = (ctrl & io.GPIO0_CTRL_OUTOVER_MASK) >> io.GPIO0_CTRL_OUTOVER_SHIFT match
            io.GPIO0_CTRL_OUTOVER_INVERT -> !d.out
            io.GPIO0_CTRL_OUTOVER_LOW -> false
            io.GPIO0_CTRL_OUTOVER_HIGH -> true
            _ -> d.out
        val oe = (ctrl & io.GPIO0_CTRL_OEOVER_MASK) >> io.GPIO0_CTRL_OEOVER_SHIFT match
            io.GPIO0_CTRL_OEOVER_INVERT -> !d.oe
            io.GPIO0_CTRL_OEOVER_DISABLE -> false
            io.GPIO0_CTRL_OEOVER_ENABLE -> true
            _ -> d.oe
        Drive(out, oe)

    /** A register read; `pins` is what each GPIO is doing now, for GPIOn_STATUS. */
    read(*self, offset: u32, width: u32, pins: [GPIO_COUNT]Pin, drives: [GPIO_COUNT]Drive) -> Result[u32, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        if address >= self.irq.intr_at then return self.irq.read(address, offset, width)
        if address >= self.summary_at then return Ok(read_lane(self.summary(address), offset, width))
        val n = address / IO_STRIDE
        if n >= self.count then return Err(AccessError.Unmapped)
        if address % IO_STRIDE == io.GPIO0_CTRL_OFFSET then return Ok(read_lane(self.native(n), offset, width))
        val d = drives[n]
        val out = if d.out then io.GPIO0_STATUS_OUTTOPAD_MASK else 0
        val oe = if d.oe then io.GPIO0_STATUS_OETOPAD_MASK else 0
        val input = if pins[n].input then io.GPIO0_STATUS_INFROMPAD_MASK else 0
        val irq = if self.irq.inputs & (1u64 << u64(n)) != 0 then io.GPIO0_STATUS_IRQTOPROC_MASK else 0
        Ok(read_lane(out | oe | input | irq, offset, width))

    // IRQSUMMARY at `address`: for processor 0, processor 1 and the dormant wake in turn, the GPIOs with
    // an interrupt asserted, Secure 0–31 and 32–47, then Non-secure 0–31 and 32–47. Every GPIO is
    // Secure here (Q3: Non-secure state is not built), so the Non-secure words read 0.
    private summary(self, address: u32) -> u32
        val r = (address - io.IRQSUMMARY_PROC0_SECURE0_OFFSET) / 4
        if r % 4 >= 2 then return 0
        val bits = self.irq.summary(r / 4)
        if r % 4 == 0 then u32.wrap(bits) else u32(bits >> 32)

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        val data = replicated(value, width)
        if address >= self.irq.intr_at then return self.irq.write(address, offset, data)
        // IRQSUMMARY is read-only.
        if address >= self.summary_at then return Ok(())
        val n = address / IO_STRIDE
        if n >= self.count then return Err(AccessError.Unmapped)
        // GPIOn_STATUS is read-only.
        if address % IO_STRIDE == io.GPIO0_CTRL_OFFSET then self.ctrl[n] = self.next_ctrl(n, offset, data)
        Ok(())
end IoBank0

io_bank0() -> IoBank0
    var state: IoBank0
    state.irq = gpio_irq(GPIO_COUNT, io.INTR0_OFFSET)
    state.count = GPIO_COUNT
    state.summary_at = io.IRQSUMMARY_PROC0_SECURE0_OFFSET
    state.rp2040 = false
    state.reset()
    state

/** The RP2040's GPIOs in bank 0. */
const GPIO_COUNT_RP2040: u32 = 30
/** INTR0 on the RP2040 (`io_bank0.h`), straight after GPIO29_CTRL. */
const INTR0_RP2040: u32 = 0xF0

/** The RP2040's IO_BANK0: 30 GPIOs, INTR0 at 0xF0 with no IRQSUMMARY, and CTRL's overrides where the
 * RP2040 has them.
 */
io_bank0_rp2040() -> IoBank0
    var state: IoBank0
    state.irq = gpio_irq(GPIO_COUNT_RP2040, INTR0_RP2040)
    state.count = GPIO_COUNT_RP2040
    state.summary_at = INTR0_RP2040
    state.rp2040 = true
    state.reset()
    state

/** Why selecting FUNCSEL `f` on the RP2040's GPIO `n` is refused (its function table, RP2040 datasheet
 * 2.19.2: F1 SPI, F2 UART, F3 I2C, F4 PWM, F5 SIO, F6 and F7 PIO, F8 clocks, F9 USB); None for SIO, I2C, a
 * UART's TX and RX, and NULL.
 */
unmodelled_function_rp2040(n: u32, f: u32) -> Option[string]
    val uart = (n + 4) / 8 % 2
    val what = f match
        5 | 31 -> return None
        1 ->
            if n % 4 != 1 then return None
            s"SPI${n / 8 % 2}_CSN: the PL022's frame signal (a pulse between words in modes 0 and 2) is not modelled; drive the chip select from a GPIO, as the SDK's examples do"
        2 ->
            if n % 4 < 2 then return None
            val signal = if n % 4 == 2 then "CTS" else "RTS"
            s"UART${uart}_$signal: UART flow control is not modelled (docs/rp-coverage.md item 8)"
        3 | 4 -> return None
        6 | 7 -> s"PIO${f - 6}, which is not on the chip yet (docs/rp-coverage.md items 13 and 14)"
        8 ->
            if n == 20 || n == 22 then "CLOCKS_GPIN, a clock input, which is not modelled"
            elif n == 21 || (n >= 23 && n <= 25) then "CLOCKS_GPOUT, a clock output, which is not modelled"
            else ""
        9 -> "USB_MUXING (VBUS and overcurrent), which is not modelled (docs/rp-coverage.md item 20)"
        _ -> ""
    if what.is_empty() then return Some(s"GPIO $n has no function $f")
    Some(s"GPIO $n FUNCSEL $f selects $what")

/** A GPIO pad at power-on: isolated, input disabled, 4 mA, pull-down, Schmitt trigger. */
const PAD_RESET: u32 = pads.GPIO0_ISO_MASK | (pads.GPIO0_DRIVE_4MA << pads.GPIO0_DRIVE_SHIFT) | pads.GPIO0_PDE_MASK | pads.GPIO0_SCHMITT_MASK

/** An RP2040 GPIO pad at power-on: input enabled, 4 mA, pull-down, Schmitt trigger. It has no ISO. */
const PAD_RESET_RP2040: u32 = pads.GPIO0_IE_MASK | (pads.GPIO0_DRIVE_4MA << pads.GPIO0_DRIVE_SHIFT) | pads.GPIO0_PDE_MASK | pads.GPIO0_SCHMITT_MASK

struct Pads
    voltage: u32
    // GPIO 0 to count - 1, then SWCLK and SWD; the RP2040's 30 use the first 32.
    pads: [GPIO_COUNT + 2]u32
    // The chip's: its GPIOs, and whether its pads have ISO (the RP2350's). A reset keeps them.
    count: u32
    iso: bool

    reset(*self)
        self.voltage = 0
        for i in 0..<(GPIO_COUNT + 2) do self.pads[i] = if self.iso then PAD_RESET else PAD_RESET_RP2040

    /** What GPIO `n`'s pad does with `d`, given `outside`: the level something off the chip drives
     * onto it, if anything. A pad drives while its output is enabled and it is neither isolated nor
     * output-disabled; an undriven pin follows its pulls (pull-up wins a tie, as a weak keeper).
     */
    pin(self, n: u32, d: Drive, outside: Option[bool]) -> Pin
        val p = self.pads[n]
        val drives = d.oe && p & (pads.GPIO0_ISO_MASK | pads.GPIO0_OD_MASK) == 0
        val level = if drives then d.out else outside match
            Some(v) -> v
            None -> p & pads.GPIO0_PUE_MASK != 0
        val input = level && p & pads.GPIO0_IE_MASK != 0 && p & pads.GPIO0_ISO_MASK == 0
        Pin(drives, level, input)

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        if address == pads.VOLTAGE_SELECT_OFFSET then return Ok(read_lane(self.voltage, offset, width))
        val i = (address - pads.GPIO0_OFFSET) / PAD_STRIDE
        if i >= self.count + 2 then return Err(AccessError.Unmapped)
        Ok(read_lane(self.pads[i], offset, width))

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        val data = replicated(value, width)
        if address == pads.VOLTAGE_SELECT_OFFSET
            self.voltage = written(self.voltage, offset, data) & pads.VOLTAGE_SELECT_VOLTAGE_SELECT_MASK
            return Ok(())
        val i = (address - pads.GPIO0_OFFSET) / PAD_STRIDE
        if i >= self.count + 2 then return Err(AccessError.Unmapped)
        // Bits 7:0 on both chips, and ISO, bit 8, on the RP2350's.
        self.pads[i] = written(self.pads[i], offset, data) & (if self.iso then (pads.GPIO0_ISO_MASK << 1) - 1 else pads.GPIO0_ISO_MASK - 1)
        Ok(())
end Pads

pads_bank0() -> Pads
    var state: Pads
    state.count = GPIO_COUNT
    state.iso = true
    state.reset()
    state

/** The RP2040's PADS_BANK0: 30 GPIOs, then SWCLK and SWD at 0x7C and 0x80, with no ISO. */
pads_bank0_rp2040() -> Pads
    var state: Pads
    state.count = GPIO_COUNT_RP2040
    state.iso = false
    state.reset()
    state
