module sh.sysl.benchtop.peripheral.rp2350
@tests

import sh.sysl.benchtop.parts.qspi_flash.{QspiFlash, qspi_flash}
import sh.sysl.benchtop.peripheral.rp2040.AccessError
import sh.sysl.rp2350.io_qspi as io_qspi_reg
import sh.sysl.rp2350.pads_qspi as pads_qspi_reg
import sh.sysl.rp2350.qmi as qmi_reg
import sysl.fmt.hex

// The blocks the boot ROM's flash functions reach that nothing modelled before it: PADS_QSPI and
// IO_QSPI (qspi_pins.sysl), and what the ROM's `flash_exit_xip`
// asks of the QMI's direct mode (xip.sysl), against `hardware/regs/pads_qspi.h`, `io_qspi.h`,
// `qmi.h` and the ROM's own source (`varm_generic_flash.c`).

private const SET: u32 = 0x2000
private const CLR: u32 = 0x3000
private const XOR: u32 = 0x1000

@test("PADS_QSPI: VOLTAGE_SELECT and the six pads at their header reset values, each keeping its bits, through every alias; past SS refused")
qspi_pads_registers()
    var p = qspi_pads()
    val resets = [0u32, 0x156, 0x156, 0x156, 0x15A, 0x15A, 0x15A]
    for i in 0u32..<7 do assert(p.read(4 * i, 4).unwrap() == resets[i], s"pad $i reset")
    assert(p.read(pads_qspi_reg.GPIO_QSPI_SD0_OFFSET, 4).unwrap() == 0x156 && p.read(pads_qspi_reg.GPIO_QSPI_SS_OFFSET, 4).unwrap() == 0x15A)
    p.write(pads_qspi_reg.VOLTAGE_SELECT_OFFSET, 4, 0xFFFFFFFF).unwrap()
    p.write(pads_qspi_reg.GPIO_QSPI_SD0_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(p.read(0, 4).unwrap() == 1 && p.read(pads_qspi_reg.GPIO_QSPI_SD0_OFFSET, 4).unwrap() == 0x1FF, "VOLTAGE_SELECT one bit, a pad nine")
    p.write(pads_qspi_reg.GPIO_QSPI_SD0_OFFSET + CLR, 4, 0x0F0).unwrap()
    p.write(pads_qspi_reg.GPIO_QSPI_SD0_OFFSET + XOR, 4, 0x003).unwrap()
    assert(p.read(pads_qspi_reg.GPIO_QSPI_SD0_OFFSET, 4).unwrap() == 0x10C, "CLR then XOR")
    p.write(pads_qspi_reg.GPIO_QSPI_SS_OFFSET + SET, 4, 0x001).unwrap()
    assert(p.read(pads_qspi_reg.GPIO_QSPI_SS_OFFSET, 4).unwrap() == 0x15B, "SET")
    assert(p.read(pads_qspi_reg.GPIO_QSPI_SS_OFFSET + 4, 4).unwrap_err() == AccessError.Unmapped)
    assert(p.write(0x100, 4, 0).unwrap_err() == AccessError.Unmapped)
    assert(p.read(2, 4).unwrap_err() == AccessError.Unaligned)
    p.reset()
    assert(p.read(pads_qspi_reg.GPIO_QSPI_SD0_OFFSET, 4).unwrap() == 0x156 && p.read(0, 4).unwrap() == 0, "reset")

@test("IO_QSPI: each pin's and the USB PHY's CTRL at reset 0x1f keeping its bits, through the aliases; STATUS refused by name; INTR write-one-to-clear; INTE and INTF stored, INTS their sum, per core and dormant wake")
io_qspi_registers()
    var io = io_qspi()
    for i in 0u32..<8 do assert(io.read(8 * i + 4, 4).unwrap() == 0x1F, s"CTRL $i")
    io.write(io_qspi_reg.GPIO_QSPI_SS_CTRL_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(io.read(io_qspi_reg.GPIO_QSPI_SS_CTRL_OFFSET, 4).unwrap() == 0x3003F01F, "the bits CTRL has")
    io.write(io_qspi_reg.GPIO_QSPI_SS_CTRL_OFFSET + CLR, 4, 0x3000).unwrap()
    assert(io.read(io_qspi_reg.GPIO_QSPI_SS_CTRL_OFFSET, 4).unwrap() == 0x3003C01F, "OUTOVER cleared, as the ROM's BOOTSEL check does")
    assert(io.read(io_qspi_reg.GPIO_QSPI_SCLK_CTRL_OFFSET, 4).unwrap() == 0x1F, "the others untouched")
    // STATUS: the pin's levels, which nothing here drives.
    for a in [io_qspi_reg.USBPHY_DP_STATUS_OFFSET, io_qspi_reg.GPIO_QSPI_SS_STATUS_OFFSET, io_qspi_reg.GPIO_QSPI_SD3_STATUS_OFFSET]
        assert(io.read(a, 4).unwrap_err() == AccessError.Unmapped, s"0x${hex(a)}")
        assert(io.write(a, 4, 0).unwrap_err() == AccessError.Unmapped)
    // The interrupts: INTR is clear, nothing raises it; INTF forces, INTE enables, INTS reports.
    assert(io.read(io_qspi_reg.INTR_OFFSET, 4).unwrap() == 0)
    io.write(io_qspi_reg.PROC0_INTF_OFFSET, 4, 0x0000F00F).unwrap()
    io.write(io_qspi_reg.PROC0_INTE_OFFSET, 4, 0x000000FF).unwrap()
    assert(io.read(io_qspi_reg.PROC0_INTS_OFFSET, 4).unwrap() == 0x0F, "forced and enabled")
    assert(io.read(io_qspi_reg.PROC1_INTS_OFFSET, 4).unwrap() == 0 && io.read(io_qspi_reg.DORMANT_WAKE_INTS_OFFSET, 4).unwrap() == 0, "the other two their own")
    io.write(io_qspi_reg.DORMANT_WAKE_INTF_OFFSET, 4, 1).unwrap()
    io.write(io_qspi_reg.DORMANT_WAKE_INTE_OFFSET + SET, 4, 1).unwrap()
    assert(io.read(io_qspi_reg.DORMANT_WAKE_INTS_OFFSET, 4).unwrap() == 1)
    io.write(io_qspi_reg.PROC0_INTS_OFFSET, 4, 0).unwrap()
    assert(io.read(io_qspi_reg.PROC0_INTS_OFFSET, 4).unwrap() == 0x0F, "INTS is read-only")
    io.write(io_qspi_reg.INTR_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(io.read(io_qspi_reg.INTR_OFFSET, 4).unwrap() == 0, "write one to clear: nothing to clear")
    assert(io.read(io_qspi_reg.DORMANT_WAKE_INTS_OFFSET + 4, 4).unwrap_err() == AccessError.Unmapped, "past the last")
    assert(io.read(io_qspi_reg.INTR_OFFSET - 4, 4).unwrap_err() == AccessError.Unmapped, "the IRQSUMMARY words are not run")
    io.reset()
    assert(io.read(io_qspi_reg.GPIO_QSPI_SS_CTRL_OFFSET, 4).unwrap() == 0x1F && io.read(io_qspi_reg.PROC0_INTS_OFFSET, 4).unwrap() == 0, "reset")

// A QMI and a flash for the direct-mode cases.
private flash_array(array: *[8192]u8) -> QspiFlash
    var f = qspi_flash()
    f.connect(&array[0], 8192)
    f

@test("QMI direct mode with no chip select: NOPUSH entries clock the bus and reach no device, as flash_exit_xip's first 32 clocks; one that would push the floating lines is refused by name")
qmi_no_chip_select()
    var array = [0xFFu8; 8192]
    var f = flash_array(&array)
    var q = qmi()
    q.write(qmi_reg.DIRECT_CSR_OFFSET, 4, qmi_reg.DIRECT_CSR_EN_MASK, &f).unwrap()
    val ones = 0xFFFF | qmi_reg.DIRECT_TX_NOPUSH_MASK | qmi_reg.DIRECT_TX_DWIDTH_MASK
    q.write(qmi_reg.DIRECT_TX_OFFSET, 4, ones, &f).unwrap()
    q.write(qmi_reg.DIRECT_TX_OFFSET, 4, ones, &f).unwrap()
    val st = q.read(qmi_reg.DIRECT_CSR_OFFSET, 4, &f).unwrap()
    assert(st & qmi_reg.DIRECT_CSR_BUSY_MASK == 0 && st & qmi_reg.DIRECT_CSR_RXEMPTY_MASK != 0, "both shifted out, nothing back")
    // With CS0 now asserted the flash sees a whole instruction: the JEDEC ID.
    q.write(qmi_reg.DIRECT_CSR_OFFSET + SET, 4, qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK, &f).unwrap()
    q.write(qmi_reg.DIRECT_TX_OFFSET, 4, 0x9F | qmi_reg.DIRECT_TX_NOPUSH_MASK, &f).unwrap()
    q.write(qmi_reg.DIRECT_TX_OFFSET, 4, 0, &f).unwrap()
    assert(q.read(qmi_reg.DIRECT_RX_OFFSET, 4, &f).unwrap() == 0xEF, "the clocks before CS0 left the flash alone")
    q.write(qmi_reg.DIRECT_CSR_OFFSET + CLR, 4, qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK, &f).unwrap()
    val got = q.write(qmi_reg.DIRECT_TX_OFFSET, 4, 0x9F, &f)
    assert(got.is_err(), "a pushed entry with no device selected")

@test("QMI direct mode: a frame whose instruction comes at quad or dual width is ignored by the SPI-mode flash, its later bytes too, as the ROM's QPI exits F5h and FFh are; the next frame is heard")
qmi_wide_instruction_ignored()
    var array = [0xFFu8; 8192]
    var f = flash_array(&array)
    var q = qmi()
    val csr = qmi_reg.DIRECT_CSR_OFFSET
    val tx = qmi_reg.DIRECT_TX_OFFSET
    q.write(csr, 4, qmi_reg.DIRECT_CSR_EN_MASK | qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK, &f).unwrap()
    for width in [qmi_reg.DIRECT_TX_IWIDTH_Q, qmi_reg.DIRECT_TX_IWIDTH_D]
        // F5h at quad (or dual) width with OE, then a serial byte the flash would refuse as an
        // instruction (0x12): nothing reaches it.
        q.write(tx, 4, 0xF5 | qmi_reg.DIRECT_TX_NOPUSH_MASK | qmi_reg.DIRECT_TX_OE_MASK | (width << qmi_reg.DIRECT_TX_IWIDTH_SHIFT), &f).unwrap()
        q.write(tx, 4, 0x12 | qmi_reg.DIRECT_TX_NOPUSH_MASK, &f).unwrap()
        // A pushed entry in an ignored frame reads lines no one drives.
        assert(q.write(tx, 4, 0, &f).is_err(), "DIRECT_RX in an ignored frame")
        q = qmi()
        q.write(csr, 4, qmi_reg.DIRECT_CSR_EN_MASK | qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK, &f).unwrap()
    // The next frame, serial: heard.
    q.write(csr + CLR, 4, qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK, &f).unwrap()
    q.write(csr + SET, 4, qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK, &f).unwrap()
    q.write(tx, 4, 0x9F | qmi_reg.DIRECT_TX_NOPUSH_MASK, &f).unwrap()
    q.write(tx, 4, 0, &f).unwrap()
    assert(q.read(qmi_reg.DIRECT_RX_OFFSET, 4, &f).unwrap() == 0xEF)
    // A wide byte after a serial instruction is data, and is heard (a quad read's address).
    q.write(csr + CLR, 4, qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK, &f).unwrap()
    q.write(csr + SET, 4, qmi_reg.DIRECT_CSR_ASSERT_CS0N_MASK, &f).unwrap()
    q.write(tx, 4, 0x9F | qmi_reg.DIRECT_TX_NOPUSH_MASK, &f).unwrap()
    q.write(tx, 4, (qmi_reg.DIRECT_TX_IWIDTH_Q << qmi_reg.DIRECT_TX_IWIDTH_SHIFT), &f).unwrap()
    assert(q.read(qmi_reg.DIRECT_RX_OFFSET, 4, &f).unwrap() == 0xEF, "not ignored")
