module sh.sysl.benchtop.peripheral.rp2350
@tests

import sh.sysl.benchtop.peripheral.rp2040.{DMA_READ_ERROR, Dma, DmaFault, DmaLayout, RP2040_DMA, dma}
import sh.sysl.rp2040.dma as d40
import sh.sysl.rp2350.dma as d50

// The DMA's registers and channel state by themselves (`peripheral/rp2040/dma.sysl`), at both chips'
// layouts: the RP2350's 16 channels and four IRQ lines, the RP2040's 12 and two, with each chip's CTRL
// field positions and register offsets. The transfers through the chip's bus are `chip/dma_tests.sysl`.

private const SET: u32 = 0x2000
private const CLR: u32 = 0x3000
// Everything both chips drive in these tests: UART0's TX request (28), the timers and the permanent one.
private const MODELLED: u64 = (1u64 << 28) | (0x1Fu64 << 59)

private why_of(f: DmaFault) -> string = f match
    Access(_) -> "an access error"
    Refused(why) -> why
    Treq(k, sel) -> s"channel $k TREQ_SEL $sel"

private wr(d: *Dma, o: u32, x: u32)
    d.write(o, 4, x) match
        Ok(_) -> ()
        Err(f) -> assert(false, s"write 0x${o} = 0x${x}: ${why_of(f)}")

private rd(d: *Dma, o: u32) -> u32 = d.read(o, 4).unwrap()

// `value` put in the field `mask` covers.
private put(value: u32, mask: u32) -> u32 = (value << mask.trailing_zeros()) & mask

// CTRL for `l`: transfers of 2^`size` bytes, the read and write addresses incrementing as asked,
// chaining to `chain`, paced by `treq`, enabled.
private ctrl(l: DmaLayout, size: u32, incr_read: bool, incr_write: bool, chain: u32, treq: u32) -> u32 =
    put(size, l.size) | (if incr_read then l.incr_read else 0) | (if incr_write then l.incr_write else 0) | put(chain, l.chain) | put(treq, l.treq) | l.en

// Each chip's DMA, as the tests below run it on both.
private layouts() -> [2]DmaLayout = [RP2350_DMA, RP2040_DMA]

// The offset of the RP2350's register `o` from TIMER0 on, at layout `l` (the RP2040's are 0x20 lower).
private at(l: DmaLayout, o: u32) -> u32 = if l.rp2350 || o < 0x440 then o else o - 0x20

@test("power-on: N_CHANNELS, every channel idle with CHAIN_TO 0, SECCFG at its reset values, both chips' register offsets")
dma_power_on()
    var d50x = dma(RP2350_DMA, MODELLED)
    assert(rd(&d50x, d50.N_CHANNELS_OFFSET) == 16 && rd(&d50x, d50.CH15_DBG_TCR_OFFSET) == 0)
    assert(rd(&d50x, d50.SECCFG_CH0_OFFSET) == 3 && rd(&d50x, d50.SECCFG_IRQ3_OFFSET) == 3 && rd(&d50x, d50.SECCFG_MISC_OFFSET) == 0x3ff)
    assert(rd(&d50x, d50.MPU_CTRL_OFFSET) == 0 && rd(&d50x, d50.MPU_LAR7_OFFSET) == 0)
    var d40x = dma(RP2040_DMA, MODELLED)
    assert(rd(&d40x, d40.N_CHANNELS_OFFSET) == 12)
    assert(d40x.read(d40.CH11_DBG_TCR_OFFSET + 0x40, 4).is_err(), "no channel 12 on the RP2040")
    assert(d40x.read(0x424, 4).unwrap() == 0 && d40x.read(0x434, 4).is_ok(), "TIMER1 and SNIFF_CTRL, not INTE2 and INTS3")
    assert(d40x.read(0x480, 4).is_err(), "no SECCFG on the RP2040")
    for l in layouts()
        var d = dma(l, MODELLED)
        for k in 0u32..<l.channels do assert(rd(&d, k * 0x40 + 0xC) == 0 && d.busy == 0)
        assert(!d.running())

@test("the four alias sets reach each channel's four registers, and only the last of each set triggers")
dma_aliases()
    for l in layouts()
        var d = dma(l, MODELLED)
        val base: u32 = 3 * 0x40
        // Alias 1: CTRL, READ_ADDR, WRITE_ADDR, TRANS_COUNT_TRIG.
        wr(&d, base + 0x10, ctrl(l, 2, true, true, 3, 0x3f))
        wr(&d, base + 0x14, 0x20000100)
        wr(&d, base + 0x18, 0x20000200)
        assert(d.busy == 0, "no trigger yet")
        wr(&d, base + 0x1C, 5)
        assert(d.busy == 8 && rd(&d, base + 0x8) == 5, "TRANS_COUNT_TRIG starts it")
        assert(rd(&d, base) == 0x20000100 && rd(&d, base + 0x4) == 0x20000200)
        assert(rd(&d, base + 0xC) & l.busy != 0 && rd(&d, base + 0x10) == rd(&d, base + 0xC), "BUSY in CTRL through every alias")
        // Alias 2: CTRL, TRANS_COUNT, READ_ADDR, WRITE_ADDR_TRIG; alias 3: CTRL, WRITE_ADDR, TRANS_COUNT, READ_ADDR_TRIG.
        d.abort(8)
        wr(&d, base + 0x24, 7)
        assert(rd(&d, 0x800 + base + 4) == 7 && rd(&d, base + 0x8) == 5, "TRANS_COUNT sets RELOAD; the live count stays")
        wr(&d, base + 0x28, 0x20000400)
        wr(&d, base + 0x2C, 0x20000800)
        assert(d.busy == 8 && rd(&d, base + 0x8) == 7 && rd(&d, base + 0x4) == 0x20000800, "WRITE_ADDR_TRIG starts it with RELOAD")
        d.abort(8)
        wr(&d, base + 0x34, 0x20000900)
        wr(&d, base + 0x38, 9)
        wr(&d, base + 0x3C, 0x20000A00)
        assert(d.busy == 8 && rd(&d, base + 0x8) == 9 && rd(&d, base) == 0x20000A00 && rd(&d, base + 0x24) == 9)
        // A trigger to a busy channel is ignored; so is one to a disabled channel.
        wr(&d, base + 0x1C, 2)
        assert(rd(&d, base + 0x8) == 9, "busy: ignored")
        d.abort(8)
        wr(&d, base + 0x10, ctrl(l, 2, true, true, 3, 0x3f) & ~l.en)
        wr(&d, base + 0xC, ctrl(l, 2, true, true, 3, 0x3f) & ~l.en)
        assert(d.busy == 0, "disabled: ignored")

@test("a null trigger starts nothing, and raises the interrupt only with IRQ_QUIET; an ordinary end raises it only without")
dma_null_trigger()
    for l in layouts()
        var d = dma(l, MODELLED)
        wr(&d, 0x10, ctrl(l, 0, false, false, 0, 0x3f) | l.quiet)
        wr(&d, 0x14, 0)
        wr(&d, 0x3C, 0)
        assert(d.busy == 0 && rd(&d, 0x400) == 1, "null READ_ADDR_TRIG with IRQ_QUIET")
        wr(&d, 0x400, 1)
        assert(rd(&d, 0x400) == 0, "INTR is write-1-to-clear")
        wr(&d, 0x10, ctrl(l, 0, false, false, 0, 0x3f))
        wr(&d, 0x1C, 0)
        assert(d.busy == 0 && rd(&d, 0x400) == 0, "no IRQ_QUIET: a null trigger raises nothing")
        // With IRQ_QUIET a sequence ends silently; without, it raises the interrupt.
        wr(&d, 0x10, ctrl(l, 0, false, false, 0, 0x3f) | l.quiet)
        wr(&d, 0x1C, 1)
        d.transferred(0)
        assert(d.busy == 0 && rd(&d, 0x400) == 0)
        wr(&d, 0x10, ctrl(l, 0, false, false, 0, 0x3f))
        wr(&d, 0x1C, 1)
        d.transferred(0)
        assert(d.busy == 0 && rd(&d, 0x400) == 1)

@test("INTEn, INTFn and INTSn per IRQ line: INTS = INTR & INTE | INTF, a write to INTS clears INTR, the atomic aliases; the RP2040 has two lines")
dma_irq_lines()
    for l in layouts()
        var d = dma(l, MODELLED)
        d.intr = 0x5
        for n in 0u32..<l.irq_lines
            val inte: u32 = 0x404 + 0x10 * n
            wr(&d, inte, 1 << n)
            assert(d.irq(n) == (n == 0 || n == 2), s"line $n")
            assert(rd(&d, inte + 8) == 0x5 & (1 << n))
        wr(&d, 0x408 + SET, 0x10)
        assert(rd(&d, 0x40C) == 0x11 && d.irq(0), "INTF forces INTS")
        wr(&d, 0x408 + CLR, 0x10)
        wr(&d, 0x404 + SET, 0x4)
        assert(rd(&d, 0x404) == 0x5)
        wr(&d, 0x40C, 0x1)
        assert(d.intr == 0x4 && rd(&d, 0x40C) == 0x4, "INTS0 clears INTR's bit 0")
        wr(&d, 0x400 + CLR, 0x4)
        assert(d.intr == 0, "a 1 through the CLR alias clears it too")
        assert(!d.irq(4) && !d.irq(l.irq_lines))
    var d40x = dma(RP2040_DMA, MODELLED)
    assert(d40x.read(0x424, 4).is_ok() && !d40x.irq(2), "0x424 is TIMER1 on the RP2040")

@test("MULTI_CHAN_TRIGGER starts each enabled idle channel named; CHAN_ABORT stops one mid-sequence with its count left, no interrupt, no chain")
dma_multi_and_abort()
    for l in layouts()
        var d = dma(l, MODELLED)
        for k in 0u32..<3
            wr(&d, k * 0x40 + 0x8, 10)
            wr(&d, k * 0x40 + 0x10, ctrl(l, 2, true, true, if k == 0 then 2 else k, 0x3f))
        wr(&d, at(l, 0x450), 0x3)
        assert(d.busy == 0x3 && rd(&d, at(l, 0x450)) == 0)
        for i in 0..<4 do d.transferred(0)
        wr(&d, at(l, 0x464), 0x1)
        assert(d.busy == 0x2 && rd(&d, 0x8) == 6 && d.intr == 0 && rd(&d, at(l, 0x464)) == 0, "aborted at 6 left; channel 2 not chained")
        wr(&d, at(l, 0x450) + CLR, 0x4)
        assert(d.busy == 0x2, "the CLR alias triggers nothing")

@test("a sequence's end chains to CHAIN_TO, not to itself; RP2350 TRANS_COUNT.MODE: TRIGGER_SELF restarts it, ENDLESS never counts down")
dma_chain_and_modes()
    for l in layouts()
        var d = dma(l, MODELLED)
        wr(&d, 0x40 + 0x8, 2)
        wr(&d, 0x40 + 0x10, ctrl(l, 2, true, true, 1, 0x3f))
        wr(&d, 0x8, 1)
        wr(&d, 0x10, ctrl(l, 2, true, true, 1, 0x3f))
        wr(&d, 0x1C, 1)
        d.transferred(0)
        assert(d.busy == 2 && rd(&d, 0x40 + 0x8) == 2 && d.intr == 1, "channel 0 done, chained to 1")
        d.transferred(1)
        d.transferred(1)
        assert(d.busy == 0 && d.intr == 3, "channel 1 chains to itself: nothing more")
    var d = dma(RP2350_DMA, MODELLED)
    wr(&d, 0x10, ctrl(RP2350_DMA, 2, true, true, 0, 0x3f))
    wr(&d, 0x1C, (1 << 28) | 3)
    assert(rd(&d, 0x8) == (1 << 28) | 3, "MODE reads back with the count")
    for i in 0..<3 do d.transferred(0)
    assert(d.busy == 1 && rd(&d, 0x8) & 0x0FFFFFFF == 3 && d.intr == 1, "TRIGGER_SELF: done, interrupt, started again")
    d.abort(1)
    wr(&d, 0x1C, (15 << 28) | 0)
    assert(d.busy == 1, "ENDLESS starts with a count of 0")
    for i in 0..<1000 do d.transferred(0)
    assert(d.busy == 1 && rd(&d, 0x8) & 0x0FFFFFFF == 0)
    assert(d.completion_due(0).is_none(), "ENDLESS never ends")

@test("what the model refuses by name: DATA_SIZE 3, a TREQ_SEL with no source, reserved MODEs, a count of 0, a reserved sniffer CALC")
dma_refusals()
    for l in layouts()
        var d = dma(l, MODELLED)
        val reasons = [
            (0x10u32, ctrl(l, 3, false, false, 0, 0x3f), "DATA_SIZE 3 is reserved"),
            (at(l, 0x454), 4 << 5, "CALC 4 is reserved"),
            (at(l, 0x454), 13 << 5, "CALC 13 is reserved"),
        ]
        for (o, x, want) in reasons
            d.write(o, 4, x) match
                Ok(_) -> assert(false, s"0x$o = 0x$x was let through")
                Err(f) -> assert(why_of(f).contains(want), why_of(f))
        d.write(0x10, 4, ctrl(l, 0, false, false, 0, 24)) match
            Err(Treq(k, sel)) -> assert(k == 0 && sel == 24)
            _ -> assert(false, "TREQ_SEL 24 has no source here")
        // A refused CTRL write leaves CTRL as it was (the chip restores the copy it made).
        assert(rd(&d, 0xC) == 0)
        wr(&d, at(l, 0x454), 0)
        wr(&d, 0x10, ctrl(l, 2, false, false, 0, 0x3f))
        d.write(0x1C, 4, 0x0) match
            Ok(_) -> ()
            Err(f) -> assert(false, why_of(f))
        assert(d.busy == 0, "0 written to a trigger register is a null trigger, not a count of 0")
        wr(&d, 0x8, 0)
        d.write(at(l, 0x450), 4, 1) match
            Ok(_) -> assert(false, "a trigger with TRANS_COUNT 0")
            Err(f) -> assert(why_of(f).contains("TRANS_COUNT 0"), why_of(f))
    var d = dma(RP2350_DMA, MODELLED)
    d.write(0x8, 4, 2 << 28) match
        Ok(_) -> assert(false, "MODE 2")
        Err(f) -> assert(why_of(f).contains("MODE 2 is reserved"), why_of(f))
    d.write(d50.TIMER2_OFFSET, 4, 1 << 16) match
        Ok(_) -> assert(false, "Y 0")
        Err(f) -> assert(why_of(f).contains("Y 0"), why_of(f))

@test("RP2350 CTRL's REV bits: INCR with REV counts down, REV alone skips by twice the size; the ring wraps within 2^RING_SIZE, on either address")
dma_steps_and_ring()
    val l = RP2350_DMA
    var d = dma(l, MODELLED)
    wr(&d, 0x10, ctrl(l, 2, true, false, 0, 0x3f) | l.read_rev | l.write_rev)
    val c = d.ch[0]
    assert(c.read_step == 0 -% 4 && c.write_step == 8 && c.size == 4)
    wr(&d, 0x10, ctrl(l, 1, true, true, 0, 0x3f) | put(3, l.ring_size))
    val r = d.ch[0]
    assert(r.ring == 7 && !r.ring_write)
    assert(r.next(0x20000106, 2, true) == 0x20000100, "read address wraps on 8 bytes")
    assert(r.next(0x20000106, 2, false) == 0x20000108, "the write address does not")
    wr(&d, 0x10, ctrl(l, 1, true, true, 0, 0x3f) | put(3, l.ring_size) | l.ring_sel)
    assert(d.ch[0].ring_write)
    val down = d.ch[0]
    assert(down.next(0x20000100, 0 -% 2, true) == 0x20000106, "a decrementing address wraps the other way")
    var d4 = dma(RP2040_DMA, MODELLED)
    wr(&d4, 0x10, ctrl(RP2040_DMA, 0, true, true, 0, 0x3f) | put(15, RP2040_DMA.ring_size))
    assert(d4.ch[0].ring == 0x7FFF && d4.ch[0].read_step == 1 && d4.ch[0].write_step == 1)

@test("the pacing timers: X/Y requests per cycle counted into each busy channel they pace (at most 63), the wait to the next, and a completion bound")
dma_pacing_timers()
    for l in layouts()
        var d = dma(l, MODELLED)
        val timer0 = at(l, 0x440)
        wr(&d, timer0 + 4, (1 << 16) | 4)
        assert(rd(&d, timer0 + 4) == 0x10004)
        wr(&d, 0x8, 10)
        wr(&d, 0x10, ctrl(l, 2, true, true, 0, 0x3c))
        wr(&d, 0x1C, 10)
        assert(d.timer_wait() == Some(4), s"${d.timer_wait()}")
        d.pace_to(3)
        assert(d.ch[0].credit == 0 && d.timer_wait() == Some(1))
        d.pace_to(9)
        assert(d.ch[0].credit == 2 && rd(&d, 0x800) == 2 && d.timer_wait().is_none(), "two requests by cycle 9, one more at 12")
        assert(d.pulse_in(1, 1) == Some(3), "phase 1 of 4: the next request 3 cycles on")
        d.transferred(0)
        assert(d.ch[0].credit == 1 && rd(&d, 0x8) == 9)
        // Nine transfers to go with one request in hand: eight more requests, the last 31 cycles after
        // cycle 9, and its transfer in the cycle after.
        assert(d.completion_due(9) == Some(32), s"${d.completion_due(9)}")
        wr(&d, 0x800, 0)
        assert(d.ch[0].credit == 0, "a write to DBG_CTDREQ clears it")
        d.pace_to(100000)
        assert(d.ch[0].credit == 63, "six bits")
        // X ≥ Y is one request a cycle.
        wr(&d, timer0, (3 << 16) | 2)
        assert(d.pulse_in(0, 5) == Some(5))
        // Requests made while no channel is busy are no one's.
        d.abort(1)
        wr(&d, 0x800, 0)
        d.pace_to(200000)
        assert(d.ch[0].credit == 0)

@test("a bus error halts the channel with its flag, AHB_ERROR their OR, and raises the interrupt even with IRQ_QUIET; a write of 1 clears it")
dma_bus_error()
    for l in layouts()
        var d = dma(l, MODELLED)
        wr(&d, 0x10, ctrl(l, 2, true, true, 0, 0x3f) | l.quiet)
        wr(&d, 0x1C, 4)
        d.bus_error(0, DMA_READ_ERROR)
        assert(d.busy == 0 && d.intr == 1 && rd(&d, 0xC) & 0xC0000000 == 0xC0000000)
        wr(&d, 0x10, ctrl(l, 2, true, true, 0, 0x3f) | 0x40000000)
        assert(rd(&d, 0xC) & 0xE0000000 == 0)

@test("RESETS: the DMA's reset puts it back to power-on, keeping its layout and the timers' clock")
dma_reset()
    var d = dma(RP2350_DMA, MODELLED)
    wr(&d, 0x10, ctrl(RP2350_DMA, 2, true, true, 0, 0x3f))
    wr(&d, 0x1C, 4)
    d.pace_to(500)
    d.reset()
    assert(d.busy == 0 && rd(&d, 0xC) == 0 && rd(&d, 0x468) == 16 && d.paced_at == 500)

// Channel 0 sniffed by the sniffer with SNIFF_CTRL `sc` (EN, DMACH 0 and the rest as given) and seed `seed`.
private sniffed(l: DmaLayout, sc: u32, seed: u32) -> Dma
    var d = dma(l, MODELLED)
    wr(&d, 0x10, ctrl(l, 0, true, true, 0, 0x3f) | l.sniff)
    wr(&d, at(l, 0x454), sc | 1)
    wr(&d, at(l, 0x458), seed)
    d

// "123456789", one byte a transfer.
private feed(d: *Dma, size: u32)
    for b in [0x31u32, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39] do d.sniff(0, b, size)

private const OUT_REV: u32 = 0x400
private const OUT_INV: u32 = 0x800

@test("the sniffer on both chips: CRC-32 (plain and bit-reversed with the output reversed and inverted, the standard 0xCBF43926), CRC-16-CCITT, CRC-16 reflected, the XOR of all bits and the sum, each against the standard check value of \"123456789\"")
dma_sniff_algorithms()
    for l in layouts()
        var d = sniffed(l, 0, 0xFFFFFFFF)
        feed(&d, 1)
        assert(rd(&d, at(l, 0x458)) == 0x0376E6E7, "CRC-32/MPEG-2")
        d = sniffed(l, (1 << 5) | OUT_REV | OUT_INV, 0xFFFFFFFF)
        feed(&d, 1)
        assert(rd(&d, at(l, 0x458)) == 0xCBF43926, s"CRC-32 0x${rd(&d, at(l, 0x458))}")
        assert(d.sniff_data == 0x9B63D02C, "reading does not change the accumulator")
        d = sniffed(l, 2 << 5, 0xFFFF)
        feed(&d, 1)
        assert(rd(&d, at(l, 0x458)) == 0x29B1, "CRC-16/CCITT-FALSE")
        d = sniffed(l, (3 << 5) | OUT_REV, 0)
        feed(&d, 1)
        assert(rd(&d, at(l, 0x458)) >> 16 == 0x2189, "CRC-16/KERMIT through CRC16R and OUT_REV")
        d = sniffed(l, 15 << 5, 5)
        feed(&d, 1)
        assert(rd(&d, at(l, 0x458)) == 5 + 0x31 + 0x32 + 0x33 + 0x34 + 0x35 + 0x36 + 0x37 + 0x38 + 0x39)
        d = sniffed(l, 14 << 5, 0)
        d.sniff(0, 0b1011, 1)
        assert(rd(&d, at(l, 0x458)) == 1, "three bits set")
        d.sniff(0, 0b1, 1)
        assert(rd(&d, at(l, 0x458)) == 0, "four")

@test("the sniffer takes a transfer's bytes low byte first: one word is the same as its four bytes, a halfword the same as two; SNIFF_CTRL.BSWAP reverses them first; OUT_INV alone complements the read")
dma_sniff_sizes() 
    for l in layouts()
        var bytes = sniffed(l, 0, 0xFFFFFFFF)
        for b in [0x31u32, 0x32, 0x33, 0x34] do bytes.sniff(0, b, 1)
        var word = sniffed(l, 0, 0xFFFFFFFF)
        word.sniff(0, 0x34333231, 4)
        assert(word.sniff_data == bytes.sniff_data && word.sniff_data != 0xFFFFFFFF)
        var halves = sniffed(l, 0, 0xFFFFFFFF)
        halves.sniff(0, 0x3231, 2)
        halves.sniff(0, 0x3433, 2)
        assert(halves.sniff_data == bytes.sniff_data)
        var swapped = sniffed(l, 0x200, 0xFFFFFFFF)
        swapped.sniff(0, 0x31323334, 4)
        assert(swapped.sniff_data == bytes.sniff_data, "BSWAP then low byte first")
        var inverted = sniffed(l, OUT_INV, 0xFFFFFFFF)
        for b in [0x31u32, 0x32, 0x33, 0x34] do inverted.sniff(0, b, 1)
        assert(rd(&inverted, at(l, 0x458)) == ~bytes.sniff_data && inverted.sniff_data == bytes.sniff_data)

@test("the sniffer sees a transfer only with EN set, DMACH naming the channel and the channel's CTRL.SNIFF_EN; SNIFF_CTRL and SNIFF_DATA read back what was written (CTRL's DMACH, CALC and flags, not bits above 11)")
dma_sniff_selection()
    for l in layouts()
        var d = sniffed(l, 15 << 5, 0)
        d.sniff(1, 7, 1)
        assert(d.sniff_data == 0, "another channel")
        wr(&d, 0x10, ctrl(l, 0, true, true, 0, 0x3f))
        d.sniff(0, 7, 1)
        assert(d.sniff_data == 0, "the channel's SNIFF_EN is clear")
        wr(&d, 0x10, ctrl(l, 0, true, true, 0, 0x3f) | l.sniff)
        wr(&d, at(l, 0x454), 15 << 5)
        d.sniff(0, 7, 1)
        assert(d.sniff_data == 0, "the sniffer is disabled")
        wr(&d, at(l, 0x454), (15 << 5) | (3 << 1) | 1)
        d.sniff(3, 7, 1)
        assert(d.sniff_data == 0, "channel 3 has no SNIFF_EN")
        wr(&d, at(l, 0x454), 0xFFFFFFFF & ~(0xC << 5))
        assert(rd(&d, at(l, 0x454)) == 0xFFF & ~(0xC << 5))

@test("RP2350 SECCFG and the MPU: reset values, writable bits, SECCFG_CH.LOCK set by a channel register write and freezing the register; none of it on the RP2040")
dma_security_registers()
    var d = dma(RP2350_DMA, MODELLED)
    wr(&d, d50.SECCFG_CH1_OFFSET, 0xFFFFFFFF)
    assert(rd(&d, d50.SECCFG_CH1_OFFSET) == 7, "S, P and LOCK writable")
    wr(&d, d50.SECCFG_CH1_OFFSET, 0)
    assert(rd(&d, d50.SECCFG_CH1_OFFSET) == 7, "LOCK freezes it")
    wr(&d, d50.SECCFG_CH2_OFFSET, 2)
    assert(rd(&d, d50.SECCFG_CH2_OFFSET) == 2)
    wr(&d, 0x80, 0x1234)
    assert(rd(&d, d50.SECCFG_CH2_OFFSET) == 6, "a write to channel 2's READ_ADDR locks it")
    wr(&d, d50.SECCFG_CH2_OFFSET, 3)
    assert(rd(&d, d50.SECCFG_CH2_OFFSET) == 6)
    assert(rd(&d, d50.SECCFG_CH3_OFFSET) == 3, "channel 3 untouched")
    wr(&d, d50.SECCFG_IRQ1_OFFSET, 0xFFFFFFFF)
    assert(rd(&d, d50.SECCFG_IRQ1_OFFSET) == 3)
    wr(&d, d50.SECCFG_MISC_OFFSET, 0)
    assert(rd(&d, d50.SECCFG_MISC_OFFSET) == 0)
    wr(&d, d50.SECCFG_MISC_OFFSET, 0xFFFFFFFF)
    assert(rd(&d, d50.SECCFG_MISC_OFFSET) == 0x3ff)
    wr(&d, d50.MPU_CTRL_OFFSET, 0xFFFFFFFF)
    assert(rd(&d, d50.MPU_CTRL_OFFSET) == 0xe)
    wr(&d, d50.MPU_BAR2_OFFSET, 0xFFFFFFFF)
    wr(&d, d50.MPU_LAR2_OFFSET, 0xFFFFFFFF)
    assert(rd(&d, d50.MPU_BAR2_OFFSET) == 0xffffffe0 && rd(&d, d50.MPU_LAR2_OFFSET) == 0xffffffe7)
    d.reset()
    assert(rd(&d, d50.SECCFG_CH1_OFFSET) == 3 && rd(&d, d50.MPU_CTRL_OFFSET) == 0 && !d.mpu_live)
    var d40x = dma(RP2040_DMA, MODELLED)
    assert(d40x.write(0x480, 4, 0).is_err() && d40x.read(0x500, 4).is_err())

@test("SECCFG_IRQ masks the channels it may not see from that line's status and its acknowledge; a Non-secure channel is seen by every line")
dma_security_irq_masks()
    var d = dma(RP2350_DMA, MODELLED)
    wr(&d, d50.INTE0_OFFSET, 3)
    wr(&d, d50.INTE1_OFFSET, 3)
    d.intr = 3
    assert(d.irq(0) && d.irq(1))
    // Line 0 loses Secure channels; channel 1 becomes Non-secure privileged first.
    wr(&d, d50.SECCFG_CH1_OFFSET, 1)
    wr(&d, d50.SECCFG_IRQ0_OFFSET, 1)
    assert(rd(&d, d50.INTS0_OFFSET) == 2, "channel 0 is Secure and masked from line 0")
    assert(rd(&d, d50.INTS1_OFFSET) == 3 && d.irq(1))
    wr(&d, d50.INTS0_OFFSET, 3)
    assert(d.intr == 1, "line 0 acknowledged channel 1 only")
    assert(!d.irq(0), "channel 1's is cleared")
    wr(&d, d50.SECCFG_IRQ0_OFFSET, 2)
    wr(&d, d50.SECCFG_CH1_OFFSET, 3)
    wr(&d, d50.SECCFG_IRQ2_OFFSET, 0)
    d.intr = 0xFFFF
    wr(&d, d50.INTE2_OFFSET, 0xFFFF)
    assert(rd(&d, d50.INTS2_OFFSET) == 0, "line 2 sees only Non-secure unprivileged channels, none here")

@test("SECCFG_MISC: the sniffer cannot see a Secure channel when SNIFF_S is clear, nor a privileged one when SNIFF_P is clear; a pacing timer's requests do not reach a channel below its level")
dma_security_misc()
    var d = sniffed(RP2350_DMA, 15 << 5, 0)
    wr(&d, d50.SECCFG_MISC_OFFSET, 0x3ff & ~2)
    d.sniff(0, 5, 1)
    assert(d.sniff_data == 0, "channel 0 is Secure")
    wr(&d, d50.SECCFG_MISC_OFFSET, 0x3ff & ~1)
    d.sniff(0, 5, 1)
    assert(d.sniff_data == 0, "channel 0 is privileged")
    wr(&d, d50.SECCFG_MISC_OFFSET, 0x3ff)
    d.sniff(0, 5, 1)
    assert(d.sniff_data == 5)
    // Channel 1 on pacing timer 2 (TREQ_SEL 0x3d).
    var t = dma(RP2350_DMA, MODELLED)
    wr(&t, d50.SECCFG_CH1_OFFSET, 0)
    wr(&t, 0x50, ctrl(RP2350_DMA, 0, true, true, 0, 0x3d))
    assert(t.timer_of(1).is_none(), "a Non-secure unprivileged channel does not see timer 2 at its reset level")
    wr(&t, d50.SECCFG_MISC_OFFSET, 0x3ff & ~0xC0)
    assert(t.timer_of(1) == Some(2), "timer 2 open to every level")
    wr(&t, d50.SECCFG_MISC_OFFSET, (0x3ff & ~0xC0) | 0x40)
    assert(t.timer_of(1).is_none(), "TIMER2_P wants a privileged channel")
    wr(&t, 0x10, ctrl(RP2350_DMA, 0, true, true, 0, 0x3d))
    assert(t.timer_of(0) == Some(2), "channel 0 is Secure privileged")
    wr(&t, d50.TIMER2_OFFSET, (1 << 16) | 1)
    wr(&t, 0x1C, 4)
    wr(&t, 0x5C, 4)
    t.pace_to(10)
    assert(t.ch[0].credit == 10 && t.ch[1].credit == 0, "requests reach the channel that sees the timer")

@test("a core's access to the DMA by level: channel registers need the channel's level, SECCFG and the MPU's regions Secure privileged, MPU_CTRL privileged, IRQ lines, timers and the sniffer their own; the RP2040 has no levels")
dma_access_refusal()
    var d = dma(RP2350_DMA, MODELLED)
    // (ns, priv): Secure privileged reaches everything; Non-secure only what is not Secure.
    assert(d.access_refusal(0x10, true, 0, false, true).is_none() && d.access_refusal(0x10, true, 0, true, true).is_some())
    assert(d.access_refusal(0x10, true, 0, false, false).is_some(), "channel 0 is privileged")
    wr(&d, d50.SECCFG_CH0_OFFSET, 0)
    assert(d.access_refusal(0x10, true, 0, true, false).is_none(), "channel 0 Non-secure unprivileged")
    wr(&d, d50.SECCFG_CH4_OFFSET, 2)
    assert(d.access_refusal(0x110, true, 0, false, false).is_none() && d.access_refusal(0x110, true, 0, true, true).is_some(), "channel 4 is Secure unprivileged")
    assert(d.access_refusal(0x800 + 0x40 * 4, false, 0, true, true).is_some(), "its DBG registers too")
    assert(d.access_refusal(d50.CHAN_ABORT_OFFSET, true, 1, true, false).is_none() && d.access_refusal(d50.CHAN_ABORT_OFFSET, true, 3, true, false).is_some(), "an abort of a Secure channel")
    assert(d.access_refusal(d50.MULTI_CHAN_TRIGGER_OFFSET, true, 1 << 5, true, true).is_some())
    assert(d.access_refusal(d50.SECCFG_CH0_OFFSET, false, 0, true, false).is_none() && d.access_refusal(d50.SECCFG_CH0_OFFSET, true, 0, true, true).is_some() && d.access_refusal(d50.SECCFG_MISC_OFFSET, true, 0, false, false).is_some(), "world-readable, S+P writable")
    assert(d.access_refusal(d50.MPU_CTRL_OFFSET, false, 0, true, false).is_some() && d.access_refusal(d50.MPU_CTRL_OFFSET, true, 0, true, true).is_none())
    // The IRQ lines and the timers.
    wr(&d, d50.SECCFG_IRQ1_OFFSET, 1)
    assert(d.access_refusal(d50.INTE1_OFFSET, true, 0, true, true).is_none() && d.access_refusal(d50.INTE1_OFFSET, true, 0, true, false).is_some())
    assert(d.access_refusal(d50.INTE0_OFFSET, true, 0, true, true).is_some(), "IRQ 0 is Secure")
    assert(d.access_refusal(d50.TIMER1_OFFSET, true, 0, true, true).is_some())
    wr(&d, d50.SECCFG_MISC_OFFSET, 0x3ff & ~0x30)
    assert(d.access_refusal(d50.TIMER1_OFFSET, true, 0, true, false).is_none())
    // The sniffer: SNIFF_S alone, SNIFF_P alone (a Secure context may enter), neither.
    assert(d.access_refusal(d50.SNIFF_CTRL_OFFSET, true, 0, false, true).is_none() && d.access_refusal(d50.SNIFF_CTRL_OFFSET, true, 0, true, true).is_some())
    wr(&d, d50.SECCFG_MISC_OFFSET, 0x3ff & ~0x32)
    assert(d.access_refusal(d50.SNIFF_DATA_OFFSET, true, 0, true, true).is_none() && d.access_refusal(d50.SNIFF_DATA_OFFSET, true, 0, false, true).is_none())
    wr(&d, d50.SECCFG_MISC_OFFSET, 0x3ff & ~0x33)
    assert(d.access_refusal(d50.SNIFF_DATA_OFFSET, true, 0, true, false).is_none())
    wr(&d, d50.SECCFG_MISC_OFFSET, 0x3ff & ~2)
    assert(d.access_refusal(d50.SNIFF_DATA_OFFSET, true, 0, false, false).is_none() && d.access_refusal(d50.SNIFF_DATA_OFFSET, true, 0, true, false).is_some())
    var d40x = dma(RP2040_DMA, MODELLED)
    assert(d40x.access_refusal(0x10, true, 0, true, false).is_none(), "no levels on the RP2040")

@test("the MPU's regions: an address takes the first enabled region's attributes (base and limit inclusive, in 32-byte steps), else MPU_CTRL's; a channel below the address's level is refused it; two regions that disagree are refused by name; need() gives each level its ACCESSCTRL bit")
dma_mpu_regions()
    var d = dma(RP2350_DMA, MODELLED)
    assert(!d.mpu_live && d.mpu_allows(0, 0x20000000) == Ok(true))
    assert(d.need(0) == 0x48 && d.need(2) == 0x48)
    wr(&d, d50.SECCFG_CH1_OFFSET, 2)
    wr(&d, d50.SECCFG_CH2_OFFSET, 1)
    wr(&d, d50.SECCFG_CH3_OFFSET, 0)
    assert(d.need(1) == 0x44 && d.need(2) == 0x42 && d.need(3) == 0x41)
    // Region 0 covers 0x20000000..0x2000007F as Secure and privileged.
    wr(&d, d50.MPU_BAR0_OFFSET, 0x20000000)
    wr(&d, d50.MPU_LAR0_OFFSET, 0x20000060 | 7)
    assert(d.mpu_live)
    assert(d.mpu_allows(0, 0x2000007F) == Ok(true) && d.mpu_allows(3, 0x2000007F) == Ok(false) && d.mpu_allows(3, 0x20000080) == Ok(true))
    assert(d.mpu_allows(1, 0x20000000) == Ok(false) && d.mpu_allows(3, 0x1FFFFFFF) == Ok(true), "S+U is below S+P; below the base is outside")
    // Region 3 covers the same bytes with other attributes; a region left disabled counts for nothing.
    wr(&d, d50.MPU_BAR3_OFFSET, 0x20000040)
    wr(&d, d50.MPU_LAR3_OFFSET, 0x20000040 | 2)
    assert(d.mpu_allows(2, 0x20000044) == Ok(false), "region 3 is disabled, so it does not disagree with region 0")
    wr(&d, d50.MPU_LAR3_OFFSET, 0x20000040 | 3)
    d.mpu_allows(0, 0x20000044) match
        Err(why) -> assert(why.contains("two enabled MPU regions"), why)
        _ -> assert(false, "regions that disagree")
    assert(d.mpu_allows(0, 0x20000020) == Ok(true), "only region 0 covers it")
    // The default attributes: MPU_CTRL.S and P.
    wr(&d, d50.MPU_LAR0_OFFSET, 0)
    wr(&d, d50.MPU_LAR3_OFFSET, 0)
    assert(!d.mpu_live)
    wr(&d, d50.MPU_CTRL_OFFSET, 4)
    assert(d.mpu_live && d.mpu_allows(1, 0x1000) == Ok(true) && d.mpu_allows(2, 0x1000) == Ok(false), "Secure unprivileged default")
