module sh.sysl.benchtop.peripheral.dma

import sh.sysl.benchtop.peripheral.Model
import sh.sysl.stm32h747.dma1 as reg

// STM32 DMA1/DMA2 register banks, eight streams. Direct mode, single transfers,
// equal byte/halfword/word widths, circular and double buffering. Request timing
// and bus arbitration belong to the board adapter, not a host sleep or UI tick.
//
// Divergences from the silicon (policy: docs/peripheral-models.md, "Unsupported writes"):
// - Enabling a stream in a mode this model does not implement (FIFO mode, burst transfers,
//   unequal widths, memory-to-memory, a zero NDTR) and setting FCR.DMDIS are refused: `write`
//   answers false, which the bus adapter reports as a fault. Silicon would accept them.
// - Writes to the read-only status registers LISR/HISR are ignored, as on the silicon; they are
//   the one kind of write this model accepts without effect rather than refusing.

// Stream 0's register names stand for every stream's; a stream's flags are stream 0's bits of
// LISR, shifted into place by `flag_shift`.
const ENABLE: u32 = reg.S0CR_EN_MASK
const FIFO_ERROR: u32 = reg.LISR_FEIF0_MASK
const DIRECT_MODE_ERROR: u32 = reg.LISR_DMEIF0_MASK
const TRANSFER_ERROR: u32 = reg.LISR_TEIF0_MASK
const HALF_TRANSFER: u32 = reg.LISR_HTIF0_MASK
const TRANSFER_COMPLETE: u32 = reg.LISR_TCIF0_MASK
const STREAM_FLAGS: u32 = FIFO_ERROR | DIRECT_MODE_ERROR | TRANSFER_ERROR | HALF_TRANSFER | TRANSFER_COMPLETE
const CIRCULAR: u32 = reg.S0CR_CIRC_MASK
const DOUBLE_BUFFER: u32 = reg.S0CR_DBM_MASK
const CURRENT_TARGET: u32 = reg.S0CR_CT_MASK
// SxCR bits an enabled stream still takes: EN and the four interrupt enables.
const CR_LIVE: u32 = ENABLE | reg.S0CR_DMEIE_MASK | reg.S0CR_TEIE_MASK | reg.S0CR_HTIE_MASK | reg.S0CR_TCIE_MASK
// SxCR bits 24:0, the fields from EN to MBURST, as a disabled stream keeps them.
const CR_WRITABLE: u32 = 0x01ffffff
// SxCR DIR: 0 peripheral to memory, 1 memory to peripheral, 2 memory to memory (refused).
const DIR_MEMORY_TO_MEMORY: u32 = 2
// SxCR PSIZE/MSIZE: 0 byte, 1 halfword, 2 word, 3 reserved.
const SIZE_RESERVED: u32 = 3
// SxFCR: FS reads 100, FIFO empty, since the model moves each beat directly; FEIE and FTH are kept.
const FCR_EMPTY: u32 = 4 << reg.S0FCR_FS_SHIFT
const FCR_KEPT: u32 = reg.S0FCR_FEIE_MASK | reg.S0FCR_FTH_MASK
const FCR_RESET: u32 = FCR_EMPTY | 1
// One stream's registers, from its own CR; the eight streams follow each other from S0CR.
const CR: u32 = 0
const NDTR: u32 = reg.S0NDTR_OFFSET - reg.S0CR_OFFSET
const PAR: u32 = reg.S0PAR_OFFSET - reg.S0CR_OFFSET
const M0AR: u32 = reg.S0M0AR_OFFSET - reg.S0CR_OFFSET
const M1AR: u32 = reg.S0M1AR_OFFSET - reg.S0CR_OFFSET
const FCR: u32 = reg.S0FCR_OFFSET - reg.S0CR_OFFSET
const STREAM_STRIDE: u32 = reg.S1CR_OFFSET - reg.S0CR_OFFSET
const STREAMS_END: u32 = reg.S7FCR_OFFSET + 4

private field(word: u32, mask: u32, shift: u32) -> u32 = (word & mask) >> shift

struct Stream
    cr: u32
    ndtr: u32
    par: u32
    m0ar: u32
    m1ar: u32
    fcr: u32
    initial: u32
    done: u32

struct Controller
    streams: [8]Stream
    flags: [8]u32

/** The controller at reset — every stream disabled with FCR at its reset value `FCR_RESET` — and the one
 * place that state is written.
 */
private fresh() -> Controller
    var c: Controller
    for i in 0..<8 do c.streams[i].fcr = FCR_RESET
    c

controller() -> &Controller = fresh()

private flag_shift(stream: usize) -> u32 = [0u32,6,16,22][stream % 4]

private status(c: *Controller, high: bool) -> u32
    var value: u32 = 0
    for i in 0usize..<4
        val stream = i + (if high then 4 else 0)
        value |= c.flags[stream] << flag_shift(stream)
    value

impl Controller
    /** Whether `stream`'s interrupt line is high: a flag raised whose enable is set. */
    stream_irq(*self, stream: usize) -> bool
        require stream < 8, "DMA stream index"
        val cr = self.streams[stream].cr
        val flags = self.flags[stream]
        (flags & TRANSFER_ERROR != 0 && cr & reg.S0CR_TEIE_MASK != 0) ||
            (flags & HALF_TRANSFER != 0 && cr & reg.S0CR_HTIE_MASK != 0) ||
            (flags & TRANSFER_COMPLETE != 0 && cr & reg.S0CR_TCIE_MASK != 0)

// A controller moves a beat only when the board asks it to (`next_beat`, `finish_beat`): it has no
// clock or events of its own. Every register is a word, which the bus checks; its interrupt line is
// any stream's.
impl Model for Controller
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32] = read_register(self,offset)
    write(*self, offset: u32, width: u32, value: u32, time: u64) -> bool = write_register(self,offset,value)
    override irq(*self) -> bool
        for stream in 0usize..<8 do if self.stream_irq(stream) then return true
        false
    reset(*self) = *self = fresh()

private valid(s: *Stream, cr: u32) -> bool
    val peripheral = field(cr,reg.S0CR_PSIZE_MASK,reg.S0CR_PSIZE_SHIFT)
    val memory = field(cr,reg.S0CR_MSIZE_MASK,reg.S0CR_MSIZE_SHIFT)
    s.ndtr != 0 && peripheral < SIZE_RESERVED && peripheral == memory &&
        field(cr,reg.S0CR_DIR_MASK,reg.S0CR_DIR_SHIFT) < DIR_MEMORY_TO_MEMORY &&
        cr & (reg.S0CR_PFCTRL_MASK | reg.S0CR_PBURST_MASK | reg.S0CR_MBURST_MASK) == 0 && s.fcr & reg.S0FCR_DMDIS_MASK == 0

private read_register(c: *Controller, offset: u32) -> Option[u32]
    if offset == reg.LISR_OFFSET || offset == reg.HISR_OFFSET then return Some(status(c,offset == reg.HISR_OFFSET))
    if offset == reg.LIFCR_OFFSET || offset == reg.HIFCR_OFFSET then return Some(0)
    if offset < reg.S0CR_OFFSET || offset >= STREAMS_END || offset & 3 != 0 then return None
    val stream = usize((offset - reg.S0CR_OFFSET) / STREAM_STRIDE)
    val s = &c.streams[stream]
    val register = (offset - reg.S0CR_OFFSET) % STREAM_STRIDE
    register match
        CR -> Some(s.cr)
        NDTR -> Some(s.ndtr)
        PAR -> Some(s.par)
        M0AR -> Some(s.m0ar)
        M1AR -> Some(s.m1ar)
        _ -> Some(s.fcr)

private write_register(c: *Controller, offset: u32, value: u32) -> bool
    if offset == reg.LISR_OFFSET || offset == reg.HISR_OFFSET then return true
    if offset == reg.LIFCR_OFFSET || offset == reg.HIFCR_OFFSET
        for i in 0usize..<4
            val stream = i + (if offset == reg.HIFCR_OFFSET then 4 else 0)
            c.flags[stream] &= ~((value >> flag_shift(stream)) & STREAM_FLAGS)
        return true
    if offset < reg.S0CR_OFFSET || offset >= STREAMS_END || offset & 3 != 0 then return false
    val stream = usize((offset - reg.S0CR_OFFSET) / STREAM_STRIDE)
    val s = &c.streams[stream]
    val active = s.cr & ENABLE != 0
    val register = (offset - reg.S0CR_OFFSET) % STREAM_STRIDE
    register match
        CR ->
            if active then s.cr = (s.cr & ~CR_LIVE) | (value & CR_LIVE)
            else
                val cr = value & CR_WRITABLE
                if cr & ENABLE != 0
                    if !valid(s,cr) then return false
                    s.initial = s.ndtr
                    s.done = 0
                s.cr = cr
        NDTR -> if !active then s.ndtr = value & reg.S0NDTR_NDT_MASK
        PAR -> if !active then s.par = value
        M0AR -> if !active || (s.cr & DOUBLE_BUFFER != 0 && s.cr & CURRENT_TARGET != 0) then s.m0ar = value
        M1AR -> if !active || (s.cr & DOUBLE_BUFFER != 0 && s.cr & CURRENT_TARGET == 0) then s.m1ar = value
        FCR ->
            if !active
                if value & reg.S0FCR_DMDIS_MASK != 0 then return false
                s.fcr = (value & FCR_KEPT) | FCR_EMPTY
        _ -> return false
    true

/** One beat's bus transfer: `width` bytes read at `source` and written to `target`. */
struct Beat
    source: u32
    target: u32
    width: u32

/** Whether both ends of `b` are aligned to its width; a misaligned beat is a bus failure. */
aligned(b: Beat) -> bool = b.source % b.width == 0 && b.target % b.width == 0

/** The bits of a `width`-byte value. */
width_mask(width: u32) -> u32 = if width == 4 then 0xffffffff else (1u32 << (width * 8)) - 1

/** The transfer the next beat of `stream` makes, or None while the stream is disabled or has
 * nothing left to move. It changes nothing: `finish_beat` retires the beat once the bus has made it.
 */
next_beat(c: &Controller, stream: usize) -> Option[Beat]
    require stream < 8, "DMA stream index"
    val s = &c.streams[stream]
    if s.cr & ENABLE == 0 || s.ndtr == 0 then return None
    val width = 1u32 << field(s.cr,reg.S0CR_PSIZE_MASK,reg.S0CR_PSIZE_SHIFT)
    val base = if s.cr & CURRENT_TARGET != 0 && s.cr & DOUBLE_BUFFER != 0 then s.m1ar else s.m0ar
    val memory = base + (if s.cr & reg.S0CR_MINC_MASK != 0 then s.done * width else 0)
    // PINCOS steps the peripheral address by a word whatever PSIZE is.
    val peripheral = s.par + (if s.cr & reg.S0CR_PINC_MASK != 0 then s.done * (if s.cr & reg.S0CR_PINCOS_MASK != 0 then 4 else width) else 0)
    // DIR 1, memory to peripheral (2 is refused when the stream is enabled).
    val sending = s.cr & (1 << reg.S0CR_DIR_SHIFT) != 0
    Some(Beat(if sending then memory else peripheral, if sending then peripheral else memory, width))

/** Retire the beat `next_beat` answered for `stream`, which the bus made (`ok`) or failed: a failure
 * leaves NDTR unchanged, raises TEIF and disables the stream. Answers `ok`.
 */
finish_beat(c: &Controller, stream: usize, ok: bool) -> bool
    require stream < 8, "DMA stream index"
    val s = &c.streams[stream]
    if !ok
        c.flags[stream] |= TRANSFER_ERROR
        s.cr &= ~ENABLE
        return false
    s.ndtr -= 1
    s.done += 1
    if s.ndtr == s.initial / 2 then c.flags[stream] |= HALF_TRANSFER
    if s.ndtr == 0
        c.flags[stream] |= TRANSFER_COMPLETE
        if s.cr & (CIRCULAR | DOUBLE_BUFFER) != 0
            if s.cr & DOUBLE_BUFFER != 0 then s.cr ^= CURRENT_TARGET
            s.ndtr = s.initial
            s.done = 0
        else s.cr &= ~ENABLE
    true
