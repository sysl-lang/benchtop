module sh.sysl.benchtop.peripheral.dma

import sh.sysl.benchtop.peripheral.Model
import sh.sysl.stm32h747.dmamux1 as mux_reg

// DMAMUX1 channels 0..7 serve DMA1 streams; 8..15 serve DMA2 streams.
// Synchronization/event generation and request generators are not implemented.

// DMAMUX_CxCR DMAREQ_ID, bits 7:0 in RM0399 (the SVD gives it seven), and SOIE: what a channel
// keeps. Synchronization and event generation are refused.
const DMAREQ_ID_MASK: u32 = 0xff
const CHANNEL_WRITABLE: u32 = DMAREQ_ID_MASK | mux_reg.DMAMUX1_C0CR_SOIE_MASK
// The channel registers, one word each from C0CR.
const CHANNELS_END: u32 = 16 * 4

struct Mux
    channels: [16]u32

mux() -> &Mux = Mux([0;16])

// DMAMUX1_CSR and CFR: no synchronization overrun is ever flagged, so both read as zero.
private overrun_register(offset: u32) -> bool = offset == mux_reg.DMAMUX1_CSR_OFFSET || offset == mux_reg.DMAMUX1_CFR_OFFSET

// The mux only routes requests: no clock, events or interrupt of its own. Every register is a word,
// which the bus checks.
impl Model for Mux
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32]
        if offset < CHANNELS_END && offset & 3 == 0 then return Some(self.channels[usize(offset / 4)])
        if overrun_register(offset) then return Some(0)
        None

    write(*self, offset: u32, width: u32, value: u32, time: u64) -> bool
        if offset < CHANNELS_END && offset & 3 == 0
            if value & ~CHANNEL_WRITABLE != 0 then return false
            self.channels[usize(offset / 4)] = value
            return true
        overrun_register(offset)

    reset(*self) = self.channels = [0;16]

routed(m: &Mux, channel: usize, request_id: u32) -> bool
    require channel < 16, "DMAMUX channel index"
    request_id != 0 && m.channels[channel] & DMAREQ_ID_MASK == request_id
