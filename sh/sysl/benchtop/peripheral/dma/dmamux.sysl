module sh.sysl.benchtop.peripheral.dma

// DMAMUX1 channels 0..7 serve DMA1 streams; 8..15 serve DMA2 streams.
// Synchronization/event generation and request generators are not implemented.
struct Mux
    channels: [16]u32

mux() -> &Mux = &Mux([0;16])
reset_mux(m: *Mux) = *m = *mux()

read_mux(m: *Mux, offset: u32) -> Option[u32]
    if offset < 64 && offset & 3 == 0 then return Some(m.channels[usize(offset / 4)])
    if offset == 0x80 || offset == 0x84 then return Some(0)
    None

write_mux(m: *Mux, offset: u32, value: u32) -> bool
    if offset < 64 && offset & 3 == 0
        if value & ~0x1ff != 0 then return false
        m.channels[usize(offset / 4)] = value
        return true
    offset == 0x80 || offset == 0x84

routed(m: *Mux, channel: usize, request_id: u32) -> bool
    require channel < 16, "DMAMUX channel index"
    request_id != 0 && m.channels[channel] & 255 == request_id
