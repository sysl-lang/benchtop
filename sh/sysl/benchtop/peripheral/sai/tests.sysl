module sh.sysl.benchtop.peripheral.sai
@tests

import sysl.buf.{Buf,buf}
import sh.sysl.benchtop.peripheral.ContextModel
import sh.sysl.benchtop.timing.NEVER

// What a test's serial line has seen: the words a block sent and the time of each slot. It is the
// block's context, which each `advance` hands its endpoint.
private struct Line
    words: Buf[u32]
    times: Buf[u64]

private line() -> Line = Line(buf(), buf())

// A line that writes the word sent and the time of each slot, and answers zero.
private recording() -> Endpoint[Line] = (seen,slot,word,time) ->
    seen.words.push(word)
    seen.times.push(time)
    0

private get(b: &Block[Line], offset: u32) -> Option[u32] = b.read(offset,4,b.time)
// A register write reaches no slot, so it is handed a line of its own.
private put(b: &Block[Line], offset: u32, value: u32) -> bool
    var unused = line()
    b.write(&unused,offset,4,value,b.time)

private stereo(receive: bool = false, hz: u64 = 480000000, kernel: u64 = 12288000, endpoint: Endpoint[Line] = (seen,slot,word,time) -> 0) -> &Block[Line]
    val b: &Block[Line] = block(hz,kernel,endpoint)
    assert(put(b,8,63 | (31 << 8) | (1 << 16)))
    assert(put(b,12,(3 << 16) | (1 << 8) | (2 << 6)))
    assert(put(b,0,(4 << 5) | (1 << 20) | (if receive then 1u32 else 0)))
    b

@test("STM32 SAI: reset, protected registers, FIFO thresholds, interrupt masks and explicit unsupported modes")
sai_registers()
    val b = stereo()
    assert(get(b,8) == Some(0x11f3f) && get(b,28) == Some(0))
    assert(get(b,32).is_none() && !put(b,32,0))
    assert(b.fifo_level() == 0 && b.status() & FIFO_REQUEST != 0 && !b.irq())
    assert(put(b,16,FIFO_REQUEST) && b.irq())
    for n in 1u32..8
        assert(put(b,28,n))
        assert(b.fifo_level() == (if n == 8 then 5 else n / 2 + 1))
    assert(put(b,28,99) && b.fifo.len() == 8)
    for threshold in 0u32..4
        assert(put(b,4,threshold))
        assert(b.status() & FIFO_REQUEST == 0)
    assert(!put(b,4,5) && !put(b,4,1 << 14))
    assert(put(b,4,8) && b.fifo.is_empty() && b.cr2 & 8 == 0)
    assert(put(b,0,b.cr1 | ENABLE | DMA_ENABLE) && b.dma_request())
    val frame = b.frcr
    assert(put(b,8,7) && b.frcr == frame)
    assert(put(b,0,b.cr1 & ~ENABLE) && b.due() == NEVER)
    assert(!put(b,0,b.cr1 | ENABLE | (1 << 2)))
    assert(!put(b,0,b.cr1 | ENABLE | (1 << 12)))
    assert(!put(b,0,(b.cr1 & ~(7 << 5)) | ENABLE))
    b.reset()
    assert(b.hz == 480000000 && b.kernel_hz == 12288000 && b.cr1 == 0 && b.frcr == 7 && b.fifo.is_empty())

@test("STM32 SAI: timed slots, masks, inactive TDM slots, underrun, mute and write-one-to-clear")
sai_transmit()
    var seen = line()
    val b = stereo(endpoint = recording())
    assert(put(b,0,b.cr1 | ENABLE))
    assert(b.due() == NEVER,"master TX starts frames when data arrives")
    assert(put(b,28,0xffff8000) && put(b,28,0x7fff))
    assert(b.due() == 5000)
    b.advance(&seen,4999)
    assert(seen.words.is_empty())
    b.advance(&seen,15000)
    assert(seen.words.view() == [0x8000u32,0x7fff,0][..])
    assert(seen.times.view() == [5000u64,10000,15000][..] && b.flags == OVERRUN_UNDERRUN)
    assert(put(b,16,1) && b.irq())
    assert(put(b,24,1) && !b.irq())
    assert(put(b,28,123) && put(b,4,32))
    b.advance(&seen,20000)
    assert(seen.words.at(3) == 0 && b.fifo.is_empty(),"mute still consumes data")
    b.advance(&seen,20000)
    b.advance(&seen,10000)
    assert(seen.words.len() == 4,"repeated/backward time never replays slots")

    var output = line()
    val tdm = stereo(endpoint = recording())
    assert(put(tdm,8,127 | (63 << 8) | (1 << 16)))
    assert(put(tdm,12,(10 << 16) | (3 << 8) | (2 << 6)))
    assert(put(tdm,28,11) && put(tdm,28,22) && put(tdm,0,tdm.cr1 | ENABLE))
    tdm.advance(&output,10000)
    assert(output.words.view() == [0u32,11,0,22][..] && tdm.fifo.is_empty())

@test("STM32 SAI: each slot's endpoint is handed the context its advance was handed")
sai_context_per_advance()
    var first = line()
    var second = line()
    val b = stereo(endpoint = recording())
    assert(put(b,28,1) && put(b,28,2) && put(b,28,3) && put(b,0,b.cr1 | ENABLE))
    b.advance(&first,5000)
    b.advance(&second,15000)
    assert(first.words.view() == [1u32][..] && first.times.view() == [5000u64][..])
    assert(second.words.view() == [2u32,3][..] && second.times.view() == [10000u64,15000][..])

@test("STM32 SAI: receive FIFO, half-full DMA request, overflow and external slave slots")
sai_receive()
    var quiet = line()
    val b = stereo(true,endpoint = (seen,slot,word,time) -> u32(time) | 0xffff0000)
    assert(put(b,4,2) && put(b,0,b.cr1 | ENABLE | DMA_ENABLE))
    assert(!b.dma_request())
    b.advance(&quiet,15000)
    assert(b.fifo.len() == 3 && !b.dma_request())
    b.advance(&quiet,20000)
    assert(b.fifo.len() == 4 && b.dma_request())
    assert(get(b,28) == Some(5000) && !b.dma_request())
    b.endpoint = (seen,slot,word,time) -> u32(time)
    b.advance(&quiet,50000)
    assert(b.fifo.len() == 8 && b.flags & 1 != 0)
    assert(put(b,24,0xffffffff) && b.flags == 0)
    val slave = stereo(true)
    assert(put(slave,0,slave.cr1 | 2 | ENABLE))
    assert(slave.due() == NEVER)
    slave.clock_slot(0x12345678)
    assert(get(slave,28) == Some(0x5678))

@test("STM32 SAI: the transmit FIFO keeps its order across the wrap, and a full FIFO refuses a write")
sai_fifo_wraps()
    val slave = stereo()
    assert(put(slave,0,slave.cr1 | 2 | ENABLE))
    for n in 1u32..8 do assert(put(slave,28,n))
    assert(put(slave,28,99) && slave.fifo.len() == 8,"a ninth word is dropped")
    for n in 1u32..5 do assert(slave.clock_slot(0) == n)
    for n in 9u32..13 do assert(put(slave,28,n))
    assert(slave.fifo.len() == 8)
    for n in 6u32..13 do assert(slave.clock_slot(0) == n)
    assert(slave.fifo.is_empty() && slave.flags & OVERRUN_UNDERRUN == 0)
    assert(slave.clock_slot(0) == 0 && slave.flags & OVERRUN_UNDERRUN != 0,"an empty FIFO underruns")

@test("STM32 SAI: a reset mid-stream empties the FIFO and keeps the clocks and the endpoint")
sai_reset_mid_stream()
    var seen = line()
    val b = stereo(hz = 240000000, kernel = 6144000, endpoint = recording())
    for n in 1u32..5 do assert(put(b,28,n))
    assert(put(b,0,b.cr1 | ENABLE))
    b.advance(&seen,100000)
    assert(b.started && b.due() != NEVER)
    b.reset()
    assert(b.fifo.is_empty() && !b.started && b.due() == NEVER && b.time == 0 && b.phase == 0 && b.slot == 0)
    assert(b.cr1 == 0 && b.frcr == 7 && b.flags == 0)
    assert(b.hz == 240000000 && b.kernel_hz == 6144000)
    val before = seen.words.len()
    assert(put(b,8,63 | (31 << 8) | (1 << 16)) && put(b,12,(3 << 16) | (1 << 8) | (2 << 6)))
    assert(put(b,28,7) && put(b,0,(4 << 5) | (1 << 20) | ENABLE))
    b.advance(&seen,b.due())
    assert(seen.words.len() == before + 1 && seen.words.at(before) == 7, "the endpoint survives the reset")

@test("STM32 SAI: rational slot clock is independent of advance chunk size and NODIV uses frame length")
sai_clock()
    var left = line()
    var right = line()
    val a = stereo(false,100000000,13000000,recording())
    val b = stereo(false,100000000,13000000,recording())
    for c in [a,b] do assert(put(c,28,1) && put(c,0,c.cr1 | ENABLE))
    a.advance(&left,100000)
    var time: u64 = 317
    while time < 100000
        b.advance(&right,time)
        time += 317
    b.advance(&right,100000)
    assert(left.times.view() == right.times.view() && left.times.len() == 101 && left.times.at(0) == 985)
    assert(a.due() == b.due() && a.phase == b.phase)
    val direct = stereo()
    assert(put(direct,0,direct.cr1 | (1 << 19)))
    assert(put(direct,28,1) && put(direct,0,direct.cr1 | ENABLE))
    assert(direct.due() == 1250)

@test("STM32 SAI: every sample width and FIFO threshold boundary, plus divider and oversampling")
sai_widths_thresholds()
    val widths = [8u32,10,16,20,24,32]
    for i in 0usize..<widths.len
        val b = stereo()
        val control = (b.cr1 & ~(7 << 5)) | (u32(i + 2) << 5)
        assert(put(b,28,0xffffffff) && put(b,0,control | ENABLE))
        val expected = if widths[i] == 32 then 0xffffffff else (1u32 << widths[i]) - 1
        assert(b.clock_slot(0) == expected)
        val rx = stereo(true)
        assert(put(rx,0,(rx.cr1 & ~(7 << 5)) | (u32(i + 2) << 5) | 2 | ENABLE))
        rx.clock_slot(0xffffffff)
        assert(get(rx,28) == Some(expected))
    for receive in [false,true]
        val b = stereo(receive)
        assert(put(b,0,b.cr1 | 2 | ENABLE))
        val boundaries = [1u32,2,4,6,8]
        for count in 0u32..8
            if count != 0
                if receive then b.clock_slot(count)
                else assert(put(b,28,count))
            for threshold in 0usize..<5
                assert(put(b,4,u32(threshold)))
                val wanted = if receive then count >= boundaries[threshold] else count < boundaries[threshold]
                assert((b.status() & FIFO_REQUEST != 0) == wanted)
    val divided = stereo()
    assert(put(divided,0,(divided.cr1 & ~(63 << 20)) | (4 << 20) | (1 << 26)))
    assert(put(divided,28,1) && put(divided,0,divided.cr1 | ENABLE))
    assert(divided.due() == 40000)
