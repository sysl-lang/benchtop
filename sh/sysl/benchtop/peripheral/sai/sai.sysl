module sh.sysl.benchtop.peripheral.sai

import sysl.container.ring.InlineRing
import sh.sysl.benchtop.peripheral.ContextModel
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.stm32h747.sai1 as reg

// STM32H7 SAI audio sub-block, offsets relative to Block A/B (SAI base +4/+0x24).
// Word/slot-level free-protocol engine; register fields match ST RM0399/CMSIS.
// A board adapter supplies the kernel clock, serial endpoint and synchronization.

// Where each sub-block's registers start in the SAI, and the distance from A's to B's.
const BLOCK_A: u32 = reg.SAI_ACR1_OFFSET
const BLOCK_B: u32 = reg.SAI_BCR1_OFFSET
const BLOCK_STRIDE: u32 = BLOCK_B - BLOCK_A
// A sub-block's registers, from its own CR1; Block A's names stand for both.
const CR1: u32 = reg.SAI_ACR1_OFFSET - BLOCK_A
const CR2: u32 = reg.SAI_ACR2_OFFSET - BLOCK_A
const FRCR: u32 = reg.SAI_AFRCR_OFFSET - BLOCK_A
const SLOTR: u32 = reg.SAI_ASLOTR_OFFSET - BLOCK_A
const IM: u32 = reg.SAI_AIM_OFFSET - BLOCK_A
const SR: u32 = reg.SAI_ASR_OFFSET - BLOCK_A
const CLRFR: u32 = reg.SAI_ACLRFR_OFFSET - BLOCK_A
const DR: u32 = reg.SAI_ADR_OFFSET - BLOCK_A

const ENABLE: u32 = reg.SAI_ACR1_SAIXEN_MASK
const DMA_ENABLE: u32 = reg.SAI_ACR1_DMAEN_MASK
const OVERRUN_UNDERRUN: u32 = reg.SAI_ASR_OVRUDR_MASK
const FIFO_REQUEST: u32 = reg.SAI_ASR_FREQ_MASK
// CR1 MODE: bit 0 set receives, bit 1 set is a slave.
const MODE_RECEIVE: u32 = 1
const MODE_SLAVE: u32 = 2
// CR1 SYNCEN: 0 asynchronous, 1 synchronous with the other sub-block of the same SAI.
const SYNC_INTERNAL: u32 = 1
const MCKDIV_SHIFT: u32 = reg.SAI_ACR1_MCKDIV_SHIFT
const MCKDIV_MASK: u32 = reg.SAI_ACR1_MCKDIV_MASK
// CR1 MCKEN, bit 27 (RM0399).
const MCKEN: u32 = 1 << 27
// What a CR1 write keeps while the block is off: every field RM0399 defines.
const CR1_WRITABLE: u32 = reg.SAI_ACR1_MODE_MASK | reg.SAI_ACR1_PRTCFG_MASK | reg.SAI_ACR1_DS_MASK |
    reg.SAI_ACR1_LSBFIRST_MASK | reg.SAI_ACR1_CKSTR_MASK | reg.SAI_ACR1_SYNCEN_MASK | reg.SAI_ACR1_MONO_MASK |
    reg.SAI_ACR1_OUTDRIV_MASK | ENABLE | DMA_ENABLE | reg.SAI_ACR1_NOMCK_MASK | MCKDIV_MASK |
    reg.SAI_ACR1_OSR_MASK | MCKEN
// What a CR2 write keeps: everything below the companding fields but the self-clearing FFLUSH.
const CR2_KEPT: u32 = reg.SAI_ACR2_FTH_MASK | reg.SAI_ACR2_TRIS_MASK | reg.SAI_ACR2_MUTE_MASK |
    reg.SAI_ACR2_MUTEVAL_MASK | reg.SAI_ACR2_MUTECNT_MASK
const COMPANDING: u32 = reg.SAI_ACR2_CPL_MASK | reg.SAI_ACR2_COMP_MASK
// FTH 0-4 are the empty, quarter, half, three-quarter and full thresholds; 5-7 are reserved.
const FTH_FULL: u32 = 4
// FRCR bits 18:0: FRL, FSALL, FSDEF, FSPOL, FSOFF, and reserved bit 15 kept as written.
const FRCR_WRITABLE: u32 = 0x7ffff
const SLOTR_WRITABLE: u32 = reg.SAI_ASLOTR_FBOFF_MASK | reg.SAI_ASLOTR_SLOTSZ_MASK | reg.SAI_ASLOTR_NBSLOT_MASK |
    reg.SAI_ASLOTR_SLOTEN_MASK
const IM_WRITABLE: u32 = reg.SAI_AIM_OVRUDRIE_MASK | reg.SAI_AIM_MUTEDETIE_MASK | reg.SAI_AIM_WCKCFGIE_MASK |
    reg.SAI_AIM_FREQIE_MASK | reg.SAI_AIM_CNRDYIE_MASK | reg.SAI_AIM_AFSDETIE_MASK | reg.SAI_AIM_LFSDETIE_MASK
const CLRFR_WRITABLE: u32 = reg.SAI_ACLRFR_COVRUDR_MASK | reg.SAI_ACLRFR_CMUTEDET_MASK |
    reg.SAI_ACLRFR_CWCKCFG_MASK | reg.SAI_ACLRFR_CCNRDY_MASK | reg.SAI_ACLRFR_CAFSDET_MASK |
    reg.SAI_ACLRFR_CLFSDET_MASK

// The clocks a block has by default: the STM32H747's CM7 at 480 MHz, and a kernel clock of 256 × 48 kHz.
const DEFAULT_HZ: u64 = 480000000
const DEFAULT_KERNEL_HZ: u64 = 12288000

// The value a field holds in a register word.
private field(word: u32, mask: u32, shift: u32) -> u32 = (word & mask) >> shift
// CR1 SYNCEN of a CR1 word.
private sync_mode(cr1: u32) -> u32 = field(cr1,reg.SAI_ACR1_SYNCEN_MASK,reg.SAI_ACR1_SYNCEN_SHIFT)
/** CR1 SYNCEN = 1: the block runs on the clocks of the other sub-block of the same SAI. */
synchronous(cr1: u32) -> bool = sync_mode(cr1) == SYNC_INTERNAL
// SLOTR SLOTEN: one bit per slot that carries data.
private slot_enables(slotr: u32) -> u32 = slotr >> reg.SAI_ASLOTR_SLOTEN_SHIFT

/** The sub-block an offset from the SAI's base falls in: 0 for A, 1 for B, -1 for neither. */
block_index(offset: u32) -> int =
    if offset < BLOCK_A || offset > BLOCK_B + DR then -1 elif offset < BLOCK_B then 0 else 1
/** The register an offset from the SAI's base names within its sub-block. */
block_register(offset: u32) -> u32 = (offset - BLOCK_A) % BLOCK_STRIDE
/** The SAI's registers outside its sub-blocks (GCR, PDMCR, PDMDLY): no synchronization across SAIs and
 * no PDM, so each reads as zero and takes only zero. */
global_register(offset: u32) -> bool =
    offset == reg.SAI_GCR_OFFSET || offset == reg.SAI_PDMCR_OFFSET || offset == reg.SAI_PDMDLY_OFFSET
/** The offset from the SAI's base of sub-block `index`'s data register. */
data_register(index: usize) -> u32 = (if index == 0 then BLOCK_A else BLOCK_B) + DR

/** The serial line a block's slots cross: given the board's context, the slot, the word the block
 * sends in it (0 while receiving) and its time, answer the word it receives (ignored while sending).
 */
type Endpoint[C] = &Fn(*C,u32,u32,u64) -> u32

/** One sub-block. `endpoint` is set once by whoever puts the block on a board, and a reset keeps it;
 * it answers from a context of type C, which `advance` hands it.
 */
struct Block[C]
    hz: u64
    kernel_hz: u64
    cr1: u32
    cr2: u32
    frcr: u32
    slotr: u32
    imr: u32
    flags: u32
    fifo: InlineRing[u32, 8]
    slot: u32
    time: u64
    next_slot: u64
    phase: u64
    last: u32
    started: bool
    endpoint: Endpoint[C]

/** A block at reset with the given clocks — the one place its reset values are written. */
private fresh[C](hz: u64, kernel_hz: u64, endpoint: Endpoint[C]) -> Block[C]
    var fifo: InlineRing[u32, 8]
    // CR1, CR2, FRCR (FRL 7 at reset), SLOTR, IMR, SR; the FIFO, the slot, the clock, no slot due.
    Block(hz, kernel_hz, 0, 0, 7, 0, 0, 0, fifo, 0, 0, NEVER, 0, 0, false, endpoint)

/** A block; by default its line has nothing on it, so a receiving block hears zeros. */
block[C](hz: u64 = DEFAULT_HZ, kernel_hz: u64 = DEFAULT_KERNEL_HZ, endpoint: Endpoint[C] = (ctx,slot,word,time) -> 0) -> Block[C]
    require hz > 0 && hz <= 1000000000 && kernel_hz > 0 && kernel_hz <= 1000000000, "valid SAI clocks"
    fresh(hz,kernel_hz,endpoint)

private data_bits(cr1: u32) -> u32 = field(cr1,reg.SAI_ACR1_DS_MASK,reg.SAI_ACR1_DS_SHIFT) match
    2 -> 8
    3 -> 10
    4 -> 16
    5 -> 20
    6 -> 24
    7 -> 32
    _ -> 0

impl[C] Block[C]
    enabled(*self) -> bool = self.cr1 & ENABLE != 0
    receiving(*self) -> bool = self.cr1 & MODE_RECEIVE != 0
    slots(*self) -> u32 = field(self.slotr,reg.SAI_ASLOTR_NBSLOT_MASK,reg.SAI_ASLOTR_NBSLOT_SHIFT) + 1
    /** SLOTR SLOTEN: whether `slot` carries data. */
    slot_enabled(*self, slot: u32) -> bool = slot_enables(self.slotr) & (1u32 << slot) != 0
    sample_bits(*self) -> u32 = data_bits(self.cr1)

    fifo_level(*self) -> u32
        val count = self.fifo.len()
        if count == 0 then 0 elif count == self.fifo.capacity() then 5 else u32(count / 2 + 1)

    status(*self) -> u32
        val level = self.fifo_level()
        val threshold = (self.cr2 & reg.SAI_ACR2_FTH_MASK) + 1
        val request = if self.receiving() then level >= threshold else level < threshold
        self.flags | (level << reg.SAI_ASR_FLVL_SHIFT) | (if request then FIFO_REQUEST else 0)

    dma_request(*self) -> bool = self.enabled() && self.cr1 & DMA_ENABLE != 0 && self.status() & FIFO_REQUEST != 0

    // One complete externally clocked slot, also used by the autonomous master.
    // Inactive slots do not consume FIFO entries. Values are right-aligned words.
    clock_slot(*self, input: u32) -> u32
        if !self.enabled() then return 0
        var output: u32 = 0
        if self.slot_enabled(self.slot)
            if self.receiving()
                if !self.fifo.push_back(input & mask(self)) then self.flags |= OVERRUN_UNDERRUN
            else
                self.fifo.pop_front() match
                    Some(word) -> output = word & mask(self)
                    None -> self.flags |= OVERRUN_UNDERRUN
                if self.cr2 & reg.SAI_ACR2_MUTE_MASK != 0 then output = if self.cr2 & reg.SAI_ACR2_MUTEVAL_MASK != 0 then self.last else 0
                self.last = output
        self.slot = (self.slot + 1) % self.slots()
        output

private mask[C](b: *Block[C]) -> u32
    val bits = data_bits(b.cr1)
    if bits == 32 then 0xffffffff else (1u32 << bits) - 1

private autonomous[C](b: *Block[C]) -> bool = b.cr1 & MODE_SLAVE == 0 && b.cr1 & reg.SAI_ACR1_SYNCEN_MASK == 0
// FRCR FRL + 1: the frame's length in bit clocks.
private frame_length[C](b: *Block[C]) -> u32 = (b.frcr & reg.SAI_AFRCR_FRL_MASK) + 1
private frame_factor[C](b: *Block[C], cr1: u32) -> u64 =
    if cr1 & reg.SAI_ACR1_NOMCK_MASK != 0 then u64(frame_length(b))
    else (if cr1 & reg.SAI_ACR1_OSR_MASK != 0 then 512 else 256)

private divider(cr1: u32) -> u64
    val div = field(cr1,MCKDIV_MASK,MCKDIV_SHIFT)
    if div == 0 then 1 else u64(div)

private valid[C](b: *Block[C], cr1: u32) -> bool
    val bits = data_bits(cr1)
    // SLOTSZ: 0 the data size, 1 16 bits, 2 32 bits, 3 reserved.
    val size_code = field(b.slotr,reg.SAI_ASLOTR_SLOTSZ_MASK,reg.SAI_ASLOTR_SLOTSZ_SHIFT)
    val size = if size_code == 0 then bits else (if size_code == 1 then 16 else 32)
    val n = b.slots()
    if bits == 0 || size_code == 3 || bits > size || (b.slotr & reg.SAI_ASLOTR_FBOFF_MASK) + bits > size then return false
    val active_length = field(b.frcr,reg.SAI_AFRCR_FSALL_MASK,reg.SAI_AFRCR_FSALL_SHIFT)
    if n * size != frame_length(b) || active_length > (b.frcr & reg.SAI_AFRCR_FRL_MASK) then return false
    if b.frcr & reg.SAI_AFRCR_FSDEF_MASK != 0 && n & 1 != 0 then return false
    if slot_enables(b.slotr) == 0 || slot_enables(b.slotr) >> n != 0 then return false
    // Mono duplication, SPDIF/AC97, companding and external SAI synchronization routing are not
    // modelled, so a configuration that asks for them is refused. Internal sync/slave slots are.
    if cr1 & (reg.SAI_ACR1_PRTCFG_MASK | reg.SAI_ACR1_MONO_MASK) != 0 || sync_mode(cr1) > SYNC_INTERNAL then return false
    if b.cr2 & COMPANDING != 0 then return false
    b.hz * frame_factor(b,cr1) * divider(cr1) >= b.kernel_hz * u64(n)

private schedule[C](b: *Block[C])
    val numerator = b.hz * frame_factor(b,b.cr1) * divider(b.cr1)
    val denominator = b.kernel_hz * u64(b.slots())
    var ticks = numerator / denominator
    b.phase += numerator % denominator
    if b.phase >= denominator
        ticks += 1
        b.phase -= denominator
    b.next_slot += ticks

private start[C](b: *Block[C])
    if b.started || !b.enabled() || !autonomous(b) || (!b.receiving() && b.fifo.is_empty()) then return
    b.started = true
    b.slot = 0
    b.phase = b.kernel_hz * u64(b.slots()) - 1
    b.next_slot = b.time
    schedule(b)

// Offsets are a sub-block's own; every register is a word, which the bus checks.
impl[C] ContextModel[C] for Block[C]
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32] = offset match
        CR1 -> Some(self.cr1)
        CR2 -> Some(self.cr2)
        FRCR -> Some(self.frcr)
        SLOTR -> Some(self.slotr)
        IM -> Some(self.imr)
        SR -> Some(self.status())
        CLRFR -> Some(0)
        DR -> if self.receiving() then Some(self.fifo.pop_front().unwrap_or(0)) else Some(0)
        _ -> None

    write(*self, ctx: *C, offset: u32, width: u32, value: u32, time: u64) -> bool
        offset match
            CR1 ->
                val next = if self.enabled() then (self.cr1 & ~(ENABLE | DMA_ENABLE)) | (value & (ENABLE | DMA_ENABLE)) else value & CR1_WRITABLE
                if next & ENABLE != 0 && !valid(self,next) then return false
                self.cr1 = next
                if !self.enabled()
                    self.started = false
                    self.next_slot = NEVER
                else start(self)
            CR2 ->
                if value & reg.SAI_ACR2_FTH_MASK > FTH_FULL || value & COMPANDING != 0 then return false
                self.cr2 = value & CR2_KEPT
                if value & reg.SAI_ACR2_FFLUSH_MASK != 0 then self.fifo.clear()
            FRCR -> if !self.enabled() then self.frcr = value & FRCR_WRITABLE
            SLOTR -> if !self.enabled() then self.slotr = value & SLOTR_WRITABLE
            IM -> self.imr = value & IM_WRITABLE
            SR -> ()
            CLRFR -> self.flags &= ~(value & CLRFR_WRITABLE)
            DR -> if !self.receiving() && self.fifo.push_back(value) then start(self)
            _ -> return false
        true

    // Exact rational slot timing: advancing in one chunk or many emits the same
    // events. The caller serializes accesses and advances before MMIO operations.
    override advance(*self, ctx: *C, time: u64)
        if time <= self.time then return
        while self.next_slot != NEVER && self.next_slot <= time
            self.time = self.next_slot
            val slot = self.slot
            if self.receiving() then self.clock_slot((self.endpoint)(ctx,slot,0,self.time))
            else
                val word = self.clock_slot(0)
                (self.endpoint)(ctx,slot,word,self.time)
            schedule(self)
        self.time = time

    /** The next slot an autonomous block clocks, NEVER for none. */
    override due(*self) -> u64 = self.next_slot
    override irq(*self) -> bool = self.status() & self.imr & IM_WRITABLE != 0
    reset(*self) = *self = fresh(self.hz,self.kernel_hz,self.endpoint)
