module sh.sysl.benchtop.peripheral.stm32_gpio
@tests
import sh.sysl.benchtop.peripheral.Model

@test("STM32 GPIO: atomic BSRR, alternate functions and bank reset parameters")
registers()
    var b = bank(0xabffffff)
    assert(b.write(0,4,0xa900,0))
    assert(b.write(32,4,0x55500000,0))
    assert(alternate(b,5,5) && alternate(b,6,5) && alternate(b,7,5))
    assert(!alternate(b,4,5) && output_enabled(b,4))
    assert(b.write(24,4,1 << 4,0))
    assert(output_high(b,4))
    assert(b.write(24,4,1 << 20,0))
    assert(!output_high(b,4))
    assert(b.write(24,4,(1 << 20) | (1 << 4),0))
    assert(output_high(b,4),"set wins when both BSRR bits are written")
    assert(b.read(16,4,0).unwrap() == 0x10)
    b.reset()
    assert(b.mode == 0xabffffff && b.output == 0 && b.af[0] == 0)

@test("STM32 GPIO: IDR reads the output, the pull-ups and the levels the board holds, and a reset keeps those")
input_levels()
    var b = bank()
    assert(b.write(20,4,0x0003,0))
    // PUPDR 01 on pins 4 and 5 pulls them up; 10 on pin 6 pulls it down.
    assert(b.write(12,4,1 << 8 | 1 << 10 | 2 << 12,0))
    assert(b.read(16,4,0).unwrap() == 0x0033)
    hold(&b,1 << 4 | 1 << 0,1 << 9)
    assert(b.read(16,4,0).unwrap() == 0x0222, "held low beats output and pull-up; held high is high")
    b.reset()
    assert(b.read(16,4,0).unwrap() == 0x0200, "a reset clears the bank and keeps the board's levels")
    hold(&b,0,1 << 16)
    assert(b.read(16,4,0).unwrap() == 0, "IDR has sixteen pins")
