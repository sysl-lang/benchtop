module sh.sysl.benchtop.peripheral.stm32_gpio

// Register-only STM32 GPIO v2 bank. Routing/alternate-function endpoints live
// in the board adapter; output updates use atomic BSRR semantics.
struct Bank
    mode: u32
    output_type: u32
    speed: u32
    pull: u32
    output: u32
    af: [2]u32
    initial_mode: u32
bank(initial_mode: u32 = 0xffffffff) -> Bank = Bank(initial_mode,0,0,0,0,[0,0],initial_mode)
reset(b: *Bank) = *b = bank(b.initial_mode)
read(b: Bank, offset: u32, input: u32) -> Option[u32] = offset match
    0 -> Some(b.mode)
    4 -> Some(b.output_type)
    8 -> Some(b.speed)
    12 -> Some(b.pull)
    16 -> Some(input & 0xffff)
    20 -> Some(b.output)
    24 -> Some(0)
    32 -> Some(b.af[0])
    36 -> Some(b.af[1])
    _ -> None
write(b: *Bank, offset: u32, value: u32) -> bool
    offset match
        0 -> b.mode = value
        4 -> b.output_type = value & 0xffff
        8 -> b.speed = value
        12 -> b.pull = value
        20 -> b.output = value & 0xffff
        24 -> b.output = ((b.output & ~(value >> 16)) | (value & 0xffff)) & 0xffff
        32 -> b.af[0] = value
        36 -> b.af[1] = value
        _ -> return false
    true
alternate(b: Bank, pin: u32, af: u32) -> bool = (b.mode >> (pin * 2)) & 3 == 2 && (b.af[usize(pin / 8)] >> ((pin % 8) * 4)) & 15 == af
output_high(b: Bank, pin: u32) -> bool = (b.mode >> (pin * 2)) & 3 == 1 && b.output & (1u32 << pin) != 0
output_enabled(b: Bank, pin: u32) -> bool = (b.mode >> (pin * 2)) & 3 == 1
