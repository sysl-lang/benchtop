module sh.sysl.benchtop.peripheral.stm32_gpio

import sh.sysl.benchtop.peripheral.Model

// Register-only STM32 GPIO v2 bank. Routing/alternate-function endpoints live
// in the board adapter; output updates use atomic BSRR semantics. A pin reads its own output, high
// where its pull-up is on, and the levels the board holds pins at (`held_low`, `held_high`), which
// whoever puts the bank on a board sets once; a reset keeps them.
struct Bank
    mode: u32
    output_type: u32
    speed: u32
    pull: u32
    output: u32
    af: [2]u32
    initial_mode: u32
    held_low: u32
    held_high: u32
bank(initial_mode: u32 = 0xffffffff) -> Bank = Bank(initial_mode,0,0,0,0,[0,0],initial_mode,0,0)

/** Hold the pins of `low` low and those of `high` high, whatever the bank does with them. */
hold(b: *Bank, low: u32, high: u32)
    b.held_low = low
    b.held_high = high

/** IDR: each pin's output, high where its pull-up (PUPDR 01) is on, then the board's levels. */
input(b: *Bank) -> u32
    var levels = b.output
    for pin in 0u32..<16
        if (b.pull >> (pin * 2)) & 3 == 1 then levels |= 1u32 << pin
    (levels & ~b.held_low | b.held_high) & 0xffff

alternate(b: Bank, pin: u32, af: u32) -> bool = (b.mode >> (pin * 2)) & 3 == 2 && (b.af[usize(pin / 8)] >> ((pin % 8) * 4)) & 15 == af
output_high(b: Bank, pin: u32) -> bool = (b.mode >> (pin * 2)) & 3 == 1 && b.output & (1u32 << pin) != 0
output_enabled(b: Bank, pin: u32) -> bool = (b.mode >> (pin * 2)) & 3 == 1

// Every register is a word; the bus checks the width before it reaches the bank. A bank has no
// clock of its own.
impl Model for Bank
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32] = offset match
        0 -> Some(self.mode)
        4 -> Some(self.output_type)
        8 -> Some(self.speed)
        12 -> Some(self.pull)
        16 -> Some(input(self))
        20 -> Some(self.output)
        24 -> Some(0)
        32 -> Some(self.af[0])
        36 -> Some(self.af[1])
        _ -> None
    write(*self, offset: u32, width: u32, value: u32, time: u64) -> bool
        offset match
            0 -> self.mode = value
            4 -> self.output_type = value & 0xffff
            8 -> self.speed = value
            12 -> self.pull = value
            20 -> self.output = value & 0xffff
            24 -> self.output = ((self.output & ~(value >> 16)) | (value & 0xffff)) & 0xffff
            32 -> self.af[0] = value
            36 -> self.af[1] = value
            _ -> return false
        true
    reset(*self)
        val (low, high) = (self.held_low, self.held_high)
        *self = bank(self.initial_mode)
        hold(self, low, high)
