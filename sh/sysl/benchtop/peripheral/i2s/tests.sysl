module sh.sysl.benchtop.peripheral.i2s
@tests

import sh.sysl.benchtop.peripheral.Model
import sysl.math.Float

// Register `offset` of `c`, read and written at the controller's own time.
private get(c: *Controller, offset: u32) -> Option[u32] = c.read(offset, 4, c.time)
private put(c: *Controller, offset: u32, value: u32) -> bool = c.write(offset, 4, value, c.time)

@test("digital audio: signed 24-bit PCM, clipping, quantization and FIFO flags")
formats()
    var c = controller(48000)
    put(&c, 0, 3)
    for value in [0u32, 0x40000000, 0xC0000000, 0x7FFFFF00, 0x80000000]
        put(&c, 8, value)
    feed(&c, [0.0f32, 0.5f32, -0.5f32, 2.0f32, -2.0f32])
    c.advance(5)
    val out = take(&c)
    assert(out.len() == 5 && out.at(0) == 0.0 && out.at(1) == 0.5 && out.at(2) == -0.5 && out.at(4) == -1.0)
    val expected = [0u32, 0x40000000, 0xC0000000, 0x7FFFFF00, 0x80000000]
    for value in expected do assert(get(&c, 12).unwrap() == value)
    assert(get(&c, 12).unwrap() == 0 && (c.flags & 16) != 0)
    put(&c, 4, 16)
    assert(c.flags == 0)
    assert(get(&c, 16).unwrap() == 48000)
    assert(get(&c, 32).is_none() && !put(&c, 32, 0))

@test("digital audio: frame timing is independent of UI chunks and host stalls remain bounded")
timing()
    var a = controller(12000000)
    var b = controller(12000000)
    put(&a, 0, 3)
    put(&b, 0, 3)
    for i in 0..<64
        put(&a, 8, u32(i) << 24)
        put(&b, 8, u32(i) << 24)
    a.advance(16000)
    for time in [125u64, 417, 1901, 11999, 16000] do b.advance(time)
    val left = take(&a)
    val right = take(&b)
    assert(left.len() == 64 && right.len() == 64)
    for i in 0..<64 do assert(left.at(usize(i)) == right.at(usize(i)))
    a.advance(16000)
    assert(take(&a).is_empty(), "a paused guest produces no extra frames")
    a.advance(1000000000)
    assert(take(&a).len() == 4096 && (a.flags & 12) == 12)
    assert(a.rx.len() == 64)
    a.reset()
    assert(a.ctrl == 0 && a.tx.is_empty() && a.rx.is_empty() && a.flags == 0)

const CTRL: u32 = 0
const TXDATA: u32 = 8
const LEVEL: u32 = 28
const TX_AND_RX: u32 = 3
const UNDERRUN: u32 = 4
const OVERRUN: u32 = 8

loaded(input: f32) -> Controller
    var c = controller(48000)
    put(&c, CTRL, TX_AND_RX)
    for i in 0..<FIFO do put(&c, TXDATA, 0x40000000)
    for i in 0..<HISTORY do feed(&c, [input])
    c

@test("digital audio: a host gap longer than the history ring still applies every guest period")
long_gap()
    var c = loaded(0.5)
    c.advance(u64(HISTORY) + 1000)
    assert(get(&c, LEVEL).unwrap() == 0, "the latest period received silence once host input ran out")
    val out = take(&c)
    assert(out.len() == usize(HISTORY))
    for sample in out do assert(sample == 0.0, "the transmitted samples were played before the kept window")
    assert((c.flags & UNDERRUN) != 0)
    assert((c.flags & OVERRUN) != 0)

@test("digital audio: one long advance equals the same span in many short advances")
cadence()
    var one = loaded(0.25)
    var many = loaded(0.25)
    val span = u64(HISTORY) * 3
    one.advance(span)
    for step in 1..30 do many.advance(span * u64(step) / 30)
    assert(get(&one, LEVEL) == get(&many, LEVEL))
    assert(one.flags == many.flags)
    assert(one.rx.len() == many.rx.len())
    assert(one.input.len() == many.input.len())
    for i in 0..<FIFO do assert(get(&one, 12) == get(&many, 12))
    val left = take(&one)
    val right = take(&many)
    assert(left.len() == right.len())
    for i in 0..<left.len() do assert(left.at(i) == right.at(i))

@test("digital audio: FIFO overflow is explicit, host buffers drop old data, and reset clears history")
bounds()
    var c = controller(48000)
    for i in 0..<65 do put(&c, 8, 0x40000000)
    assert(c.tx.len() == 64 && (c.flags & 32) != 0)
    put(&c, 4, 32)
    assert(c.flags == 0)
    for i in 0..<5000 do feed(&c, [0.25f32])
    assert(c.input.len() == 4096)
    clear_host(&c)
    assert(c.input.is_empty() && c.tx.len() == 64)
    put(&c, 0, 0x80000003)
    assert(c.ctrl == 3 && c.tx.is_empty() && c.input.is_empty())

@test("digital audio: the host input keeps the newest samples, in order, once it is full")
input_keeps_newest()
    var c = controller(48000)
    for i in 0..<4100 do feed(&c, [f32(i) / 8388608.0f32])
    assert(c.input.len() == 4096)
    assert(c.input[0] == 4u32 << 8 && c.input[4095] == 4099u32 << 8,"the four oldest were dropped")
    put(&c, 0, 2)
    c.advance(1)
    assert(get(&c, 24) == Some(1) && get(&c, 12) == Some(4u32 << 8))
    assert(c.input[0] == 5u32 << 8)

@test("digital audio: the speaker history keeps the newest frames and take empties it in order")
output_keeps_newest()
    var c = controller(48000)
    put(&c, 0, 1)
    for i in 0..<64 do put(&c, 8, u32(i + 1) << 8)
    c.advance(4000)
    c.advance(4100)
    assert(c.output.len() == 4096 && (c.flags & 4) != 0,"the FIFO ran dry after 64 frames")
    val first = take(&c)
    assert(first.len() == 4096 && c.output.is_empty())
    assert(first.at(0) == f32(real(int(5u32 << 8)) / 2147483648.0),"the four oldest frames were dropped")
    assert(first.at(59) == f32(real(int(64u32 << 8)) / 2147483648.0) && first.at(60) == 0.0f32)
