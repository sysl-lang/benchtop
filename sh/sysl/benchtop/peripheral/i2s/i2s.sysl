module sh.sysl.benchtop.peripheral.i2s

import sysl.buf.{Buf, buf}
import sysl.container.ring.InlineRing
import sysl.math.{min, max}

const RATE: u64 = 48000
const FIFO: usize = 64
const HISTORY: usize = 4096

/** Mono left-channel I2S frame engine. Signed 24-bit samples occupy bits 31..8.
 * Right slots are silent. The virtual MCU adapter exposes completed frames, not pin edges.
 * `input` and `output` are the host side: microphone samples waiting to be clocked in, and
 * speaker samples clocked out and waiting for the host to take; both keep the newest `HISTORY`.
 */
struct Controller
    hz: u64
    ctrl: u32
    flags: u32
    time: u64
    phase: u64
    tx: InlineRing[u32, FIFO]
    rx: InlineRing[u32, FIFO]
    input: InlineRing[u32, HISTORY]
    output: InlineRing[f32, HISTORY]
    /** LEVEL: the magnitude of the latest received sample (not a held peak). */
    level: u32

controller(hz: u64 = 12000000) -> Controller
    require hz >= RATE && hz <= 1000000000, "valid digital audio clock"
    var c: Controller
    c.hz = hz
    c

reset(c: *Controller) = *c = controller(c.hz)

/** Host input is bounded and quantized exactly once into the microphone's 24-bit format. */
feed(c: *Controller, samples: []const f32)
    for sample in samples
        val clipped = if sample != sample then 0.0f32 else max(-1.0f32, min(1.0f32, sample))
        val signed = int(min(8388607.0, real(clipped) * 8388608.0))
        c.input.overwrite(u32(signed) << 8)

/** One rational guest clock drives playback and capture, independent of UI frame size and of
 * how long the host waited between calls: every elapsed sample period is applied to the guest's
 * FIFOs, flags and level, however many there are. Only the host-side history rings are bounded,
 * and they keep the newest `HISTORY` frames.
 */
advance(c: *Controller, time: u64)
    if time <= c.time then return
    val ticks = (time - c.time) * RATE + c.phase
    val count = ticks / c.hz
    c.phase = ticks % c.hz
    c.time = time
    var done: u64 = 0
    while done < count
        if c.tx.is_empty() && c.input.is_empty()
            idle(c, count - done)
            return
        period(c)
        done += 1

private receive(c: *Controller, input: u32)
    val signed = int(input)
    c.level = u32(if signed < 0 then -long(signed) else long(signed))
    if !c.rx.push_back(input) then c.flags |= 8

private period(c: *Controller)
    var value: u32 = 0
    if c.ctrl & 1 != 0
        c.tx.pop_front() match
            Some(word) -> value = word
            None -> c.flags |= 4
    c.output.overwrite(f32(real(int(value & 0xFFFFFF00)) / 2147483648.0))
    val input = c.input.pop_front().unwrap_or(0)
    if c.ctrl & 2 != 0 then receive(c, input)

/** `n` periods with nothing queued in either direction, in closed form: every one transmits and
 * receives silence, so the result is the same as `n` calls of `period` at a bounded cost.
 */
private idle(c: *Controller, n: u64)
    if c.ctrl & 1 != 0 then c.flags |= 4
    for i in 0..<min(n, u64(HISTORY)) do c.output.overwrite(0.0)
    if c.ctrl & 2 == 0 then return
    c.level = 0
    for i in 0..<min(n, u64(FIFO - c.rx.len()) + 1) do receive(c, 0)

read(c: *Controller, offset: u32) -> Option[u32] = offset match
    0 -> Some(c.ctrl)
    4 -> Some((if c.tx.is_full() then 0u32 else 1) | (if c.rx.is_empty() then 0u32 else 2) | c.flags)
    8 -> Some(0)
    12 -> c.rx.pop_front() match
        Some(sample) -> Some(sample)
        None ->
            c.flags |= 16
            Some(0)
    16 -> Some(u32(RATE))
    20 -> Some(u32(FIFO - c.tx.len()))
    24 -> Some(u32(c.rx.len()))
    28 -> Some(c.level)
    _ -> None

write(c: *Controller, offset: u32, value: u32) -> bool
    offset match
        0 ->
            if value & 0x80000000 != 0
                val time = c.time
                reset(c)
                c.time = time
            c.ctrl = value & 3
        4 -> c.flags &= ~(value & 60)
        8 -> if !c.tx.push_back(value & 0xFFFFFF00) then c.flags |= 32
        12 | 16 | 20 | 24 | 28 -> ()
        _ -> return false
    true

take(c: *Controller) -> Buf[f32]
    var samples: Buf[f32] = buf()
    loop
        c.output.pop_front() match
            Some(sample) -> samples.push(sample)
            None -> break
    samples

/** Dropping stale host sound at pause/reset never changes guest TX/RX FIFO contents. */
clear_host(c: *Controller)
    c.input.clear()
    c.output.clear()
