module sh.sysl.benchtop.peripheral.dsi
@tests

import sysl.buf.{Buf,buf}

private powered(lanes: u32 = 1) -> &Host
    val h = host(100000000,5000000)
    assert(write(h,0x430,0x01000001 | (100 << 2) | (5 << 11)))
    assert(write(h,0xa0,6) && write(h,0xa4,lanes - 1))
    assert(write(h,0x404,8) && write(h,4,1))
    h

@test("DSI PHY: DEN | CKE (the HAL's 6) brings the D-PHY up; bits 1:0 (3) or either bit alone do not")
dsi_phy_enable()
    val h = powered(2)
    // DSI_PSR (0xb0) reports the lanes' stop state only while the PHY is up.
    assert(read(h,0xb0).unwrap() != 0 && write(h,0x6c,0x29u32 << 8 | 5),"DEN | CKE: stop state reported, packets accepted")
    for value in [3u32,1,2,4,0]
        assert(write(h,0xa0,value))
        assert(read(h,0xb0).unwrap() == 0,"PHY not up without both DEN and CKE")
        assert(!h.busy,"a PHY taken down drops the packet in flight")
        assert(!write(h,0x6c,0x29u32 << 8 | 5),"no packets while the PHY is down")
    assert(write(h,0xa0,7) && read(h,0xb0).unwrap() != 0 && write(h,0x6c,0x29u32 << 8 | 5),"bit 0 is ignored")

@test("DSI packets: exact short/long payload, padding, virtual channels and timed delivery")
dsi_packets()
    val h = powered()
    var received: Buf[u8] = buf()
    var types: Buf[u32] = buf()
    var channels: Buf[u32] = buf()
    val sink: Endpoint = (vc,kind,bytes,request) ->
        received.extend(bytes)
        types.push(kind)
        channels.push(vc)
        buf()
    assert(write(h,0x6c,0x11u32 << 8 | 0x05))
    assert(h.due == 32 && h.busy)
    advance(h,31,sink)
    assert(received.is_empty() && read(h,0x74).unwrap() & 3 == 2)
    advance(h,32,sink)
    assert(received.view() == [0x11u8][..] && !h.busy)
    assert(write(h,0x70,0x0302012a) && write(h,0x70,0xffffff04))
    assert(write(h,0x6c,(5u32 << 8) | (3 << 6) | 0x39))
    assert(h.due == 120)
    advance(h,120,sink)
    assert(received.view() == [0x11u8,0x2a,1,2,3,4][..],"little-endian payload FIFO, padded bytes omitted")
    assert(types.view() == [5u32,0x39][..] && channels.view() == [0u32,3][..])
    assert(read(h,0x74).unwrap() == 0x15)
    advance(h,120,sink)
    advance(h,100,sink)
    assert(types.len() == 2,"rewind/repeated time must not replay packets")
    val dual = powered(2)
    assert(write(dual,0x6c,0x29u32 << 8 | 5))
    assert(dual.due == 16)

@test("DSI reads: maximum return size, busy status, byte packing and empty FIFO")
dsi_reads()
    val h = powered()
    val sink: Endpoint = (vc,kind,bytes,request) ->
        var result: Buf[u8] = buf()
        if kind == 6
            assert(bytes.len == 1 && bytes[0] == 0x0a)
            for b in 1..<8 do result.push(u8(b))
        result
    assert(write(h,0x6c,0x0au32 << 8 | 6))
    assert(read(h,0x74).unwrap() & 64 != 0)
    advance(h,32,sink)
    assert(read(h,0x70).unwrap() == 1 && read(h,0x70).unwrap() == 0)
    assert(write(h,0x6c,7u32 << 8 | 0x37))
    advance(h,64,sink)
    assert(write(h,0x6c,0x0au32 << 8 | 6))
    advance(h,96,sink)
    assert(read(h,0x74).unwrap() & 16 == 0)
    assert(read(h,0x70).unwrap() == 0x04030201)
    assert(read(h,0x70).unwrap() == 0x00070605)
    assert(read(h,0x74).unwrap() & 16 != 0)

@test("DSI boundaries: disabled host, unsupported video mode, FIFO limits, malformed packets and reset cancellation")
dsi_boundaries()
    val h = host(100000000)
    assert(!write(h,0x6c,5) && !write(h,0x70,0))
    assert(!write(h,0x430,0x01000001),"PLL cannot lock with zero divisors")
    assert(!write(h,0x34,0) && !write(h,0xa4,2))
    assert(!write(h,0x38,0) && read(h,0x38).is_none())
    assert(!write(h,0x6d,0) && read(h,0x71).is_none())
    val p = powered()
    assert(!write(p,0x6c,0xff) && !write(p,0x6c,0x37))
    assert(!write(p,0x6c,1025u32 << 8 | 0x37))
    assert(!write(p,0x6c,5u32 << 8 | 0x39))
    for i in 0..<256 do assert(write(p,0x70,u32(i)))
    assert(read(p,0x74).unwrap() & 8 != 0 && !write(p,0x70,0))
    assert(!write(p,0x6c,1025u32 << 8 | 0x39))
    assert(write(p,0x6c,1024u32 << 8 | 0x39))
    assert(!write(p,0x6c,5),"a busy command FIFO must not overwrite its packet")
    assert(write(p,4,0))
    assert(!p.busy && p.tx_count == 0 && p.rx.is_empty())
    val calls: Buf[u8] = buf()
    advance(p,100000,(vc,kind,bytes,request) ->
        calls.push(1)
        buf())
    assert(calls.len() == 0)

@test("DSI deferred reads: FIFO stays busy until reply and cancellation rejects stale completions")
dsi_deferred_reads()
    val h = powered()
    h.defer_reads = true
    var calls: Buf[u8] = buf()
    val sink: Endpoint = (vc,kind,bytes,request) ->
        calls.push(1)
        buf()
    assert(write(h,0x6c,0x0au32 << 8 | 6))
    val first = h.request_id
    advance(h,32,sink)
    assert(h.busy && h.response_pending && read(h,0x74).unwrap() & 64 != 0)
    advance(h,100,sink)
    assert(calls.len() == 1,"a queued read must not be submitted twice")
    assert(complete_read(h,first,[1u8,2][..]))
    assert(!h.busy && read(h,0x70).unwrap() == 1)
    assert(!complete_read(h,first,[9u8][..]))
    assert(write(h,0x6c,0x0au32 << 8 | 6))
    val cancelled = h.request_id
    advance(h,132,sink)
    assert(write(h,4,0) && write(h,4,1))
    assert(write(h,0x6c,0x0au32 << 8 | 6))
    val current = h.request_id
    advance(h,164,sink)
    assert(!complete_read(h,cancelled,[9u8][..]))
    assert(h.busy && complete_read(h,current,[3u8][..]))
    assert(read(h,0x70).unwrap() == 3)
