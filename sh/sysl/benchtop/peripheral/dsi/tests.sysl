module sh.sysl.benchtop.peripheral.dsi
@tests

import sh.sysl.benchtop.peripheral.Model
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.stm32h747.dsihost as reg
import sysl.buf.{Buf,buf}

// Register `offset` of `h`, read and written at the host's own time.
private get(h: &Host, offset: u32) -> Option[u32] = h.read(offset,4,h.time)
private put(h: &Host, offset: u32, value: u32) -> bool = h.write(offset,4,value,h.time)

private powered(lanes: u32 = 1, sink: Endpoint = no_sink) -> &Host
    val h = host(100000000,5000000,sink)
    assert(put(h,0x430,0x01000001 | (100 << 2) | (5 << 11)))
    assert(put(h,0xa0,6) && put(h,0xa4,lanes - 1))
    assert(put(h,0x404,8) && put(h,4,1))
    h

@test("DSI PHY: DEN | CKE (the HAL's 6) brings the D-PHY up; bits 1:0 (3) or either bit alone do not")
dsi_phy_enable()
    val h = powered(2)
    // DSI_PSR (0xb0) reports the lanes' stop state only while the PHY is up.
    assert(get(h,0xb0).unwrap() != 0 && put(h,0x6c,0x29u32 << 8 | 5),"DEN | CKE: stop state reported, packets accepted")
    for value in [3u32,1,2,4,0]
        assert(put(h,0xa0,value))
        assert(get(h,0xb0).unwrap() == 0,"PHY not up without both DEN and CKE")
        assert(!h.busy,"a PHY taken down drops the packet in flight")
        assert(!put(h,0x6c,0x29u32 << 8 | 5),"no packets while the PHY is down")
    assert(put(h,0xa0,7) && get(h,0xb0).unwrap() != 0 && put(h,0x6c,0x29u32 << 8 | 5),"bit 0 is ignored")

@test("DSI packets: exact short/long payload, padding, virtual channels and timed delivery")
dsi_packets()
    val received: Buf[u8] = buf()
    val types: Buf[u32] = buf()
    val channels: Buf[u32] = buf()
    val h = powered(sink = (vc,kind,bytes,request) ->
        received.extend(bytes)
        types.push(kind)
        channels.push(vc)
        buf())
    assert(h.due() == NEVER)
    assert(put(h,0x6c,0x11u32 << 8 | 0x05))
    assert(h.due() == 32 && h.busy)
    h.advance(31)
    assert(received.is_empty() && get(h,0x74).unwrap() & 3 == 2)
    h.advance(32)
    assert(received.view() == [0x11u8][..] && !h.busy && h.due() == NEVER)
    assert(put(h,0x70,0x0302012a) && put(h,0x70,0xffffff04))
    assert(put(h,0x6c,(5u32 << 8) | (3 << 6) | 0x39))
    assert(h.due() == 120)
    h.advance(120)
    assert(received.view() == [0x11u8,0x2a,1,2,3,4][..],"little-endian payload FIFO, padded bytes omitted")
    assert(types.view() == [5u32,0x39][..] && channels.view() == [0u32,3][..])
    assert(get(h,0x74).unwrap() == 0x15)
    h.advance(120)
    h.advance(100)
    assert(types.len() == 2,"rewind/repeated time must not replay packets")
    val dual = powered(2)
    assert(put(dual,0x6c,0x29u32 << 8 | 5))
    assert(dual.due() == 16)

@test("DSI reads: maximum return size, busy status, byte packing and empty FIFO")
dsi_reads()
    val h = powered(sink = (vc,kind,bytes,request) ->
        var result: Buf[u8] = buf()
        if kind == 6
            assert(bytes.len == 1 && bytes[0] == 0x0a)
            for b in 1..<8 do result.push(u8(b))
        result)
    assert(put(h,0x6c,0x0au32 << 8 | 6))
    assert(get(h,0x74).unwrap() & 64 != 0)
    h.advance(32)
    assert(get(h,0x70).unwrap() == 1 && get(h,0x70).unwrap() == 0)
    assert(put(h,0x6c,7u32 << 8 | 0x37))
    h.advance(64)
    assert(put(h,0x6c,0x0au32 << 8 | 6))
    h.advance(96)
    assert(get(h,0x74).unwrap() & 16 == 0)
    assert(get(h,0x70).unwrap() == 0x04030201)
    assert(get(h,0x70).unwrap() == 0x00070605)
    assert(get(h,0x74).unwrap() & 16 != 0)

@test("DSI boundaries: disabled host, unsupported video mode, FIFO limits, malformed packets and reset cancellation")
dsi_boundaries()
    val h = host(100000000)
    assert(!put(h,0x6c,5) && !put(h,0x70,0))
    assert(!put(h,0x430,0x01000001),"PLL cannot lock with zero divisors")
    assert(!put(h,0x34,0) && !put(h,0xa4,2))
    assert(!put(h,0x38,0) && get(h,0x38).is_none())
    assert(!put(h,0x6d,0) && get(h,0x71).is_none())
    val calls: Buf[u8] = buf()
    val p = powered(sink = (vc,kind,bytes,request) ->
        calls.push(1)
        buf())
    assert(!put(p,0x6c,0xff) && !put(p,0x6c,0x37))
    assert(!put(p,0x6c,1025u32 << 8 | 0x37))
    assert(!put(p,0x6c,5u32 << 8 | 0x39))
    for i in 0..<256 do assert(put(p,0x70,u32(i)))
    assert(get(p,0x74).unwrap() & 8 != 0 && !put(p,0x70,0))
    assert(!put(p,0x6c,1025u32 << 8 | 0x39))
    assert(put(p,0x6c,1024u32 << 8 | 0x39))
    assert(!put(p,0x6c,5),"a busy command FIFO must not overwrite its packet")
    assert(put(p,4,0))
    assert(!p.busy && p.tx_count == 0 && p.rx.is_empty())
    p.advance(100000)
    assert(calls.len() == 0)

@test("DSI deferred reads: FIFO stays busy until reply and cancellation rejects stale completions")
dsi_deferred_reads()
    val calls: Buf[u8] = buf()
    val h = powered(sink = (vc,kind,bytes,request) ->
        calls.push(1)
        buf())
    h.defer_reads = true
    assert(put(h,0x6c,0x0au32 << 8 | 6))
    val first = h.request_id
    h.advance(32)
    assert(h.busy && h.response_pending && get(h,0x74).unwrap() & 64 != 0)
    assert(h.due() == NEVER, "a deferred read has no event of its own until it is answered")
    h.advance(100)
    assert(calls.len() == 1,"a queued read must not be submitted twice")
    assert(h.complete_read(first,[1u8,2][..]))
    assert(!h.busy && get(h,0x70).unwrap() == 1)
    assert(!h.complete_read(first,[9u8][..]))
    assert(put(h,0x6c,0x0au32 << 8 | 6))
    val cancelled = h.request_id
    h.advance(132)
    assert(put(h,4,0) && put(h,4,1))
    assert(put(h,0x6c,0x0au32 << 8 | 6))
    val current = h.request_id
    h.advance(164)
    assert(!h.complete_read(cancelled,[9u8][..]))
    assert(h.busy && h.complete_read(current,[3u8][..]))
    assert(get(h,0x70).unwrap() == 3)

@test("DSI reset: the registers return to command mode at power-on, and the sink and read deferral are kept")
dsi_reset()
    val calls: Buf[u32] = buf()
    val h = powered(sink = (vc,kind,bytes,request) ->
        calls.push(kind)
        buf())
    h.defer_reads = true
    assert(put(h,0x6c,0x29u32 << 8 | 5))
    h.reset()
    assert(!h.busy && h.due() == NEVER && h.time == 0 && h.lane_rate == 0)
    assert(get(h,reg.DSI_MCR_OFFSET).unwrap() & reg.DSI_MCR_CMDM_MASK != 0, "MCR.CMDM is set at reset")
    assert(h.defer_reads, "a reset keeps the deferral the board chose")
    assert(put(h,0x430,0x01000001 | (100 << 2) | (5 << 11)))
    assert(put(h,0xa0,6) && put(h,0xa4,0))
    assert(put(h,0x404,8) && put(h,4,1))
    assert(put(h,0x6c,0x29u32 << 8 | 5))
    h.advance(h.due())
    assert(calls.view() == [5u32][..], "a reset keeps the sink; the packet before it never arrived")
