module sh.sysl.benchtop.peripheral.dsi

import sysl.buf.{Buf,buf}
import sysl.container.ring.InlineRing
import sysl.math.min

/** STM32 DSI command-mode host. Packets cross a timed link before the attached
 * endpoint receives them. Endpoints are independent of MCU addresses and GPIO.
 * No LTDC/video streaming, TE, ULPS, ECC/CRC fault injection or analog PHY model.
 */
struct Host
    hz: u64
    reference_hz: u64
    lane_rate: u64
    regs: [269]u32
    tx: [1024]u8
    tx_count: usize
    packet: [1024]u8
    packet_count: usize
    header: u32
    busy: bool
    due: u64
    time: u64
    rx: InlineRing[u8, 1024]
    max_return: usize
    defer_reads: bool
    response_pending: bool
    request_id: u64

host(hz: u64, reference_hz: u64 = 25000000) -> &Host
    require hz > 0 && hz <= 1000000000 && reference_hz > 0 && reference_hz <= 1000000000, "bounded DSI clock rates"
    var h: Host
    h.hz = hz
    h.reference_hz = reference_hz
    h.max_return = 1
    h.regs[0x34 / 4] = 1 // Command mode.
    h

/** Replaces the receive FIFO's contents with a read response, cut at the maximum return size. */
private receive(h: &Host, response: []const u8)
    h.rx.clear()
    for i in 0..<min(response.len,h.max_return) do h.rx.push_back(response[i])

/** Callback arguments are VC, packet data type, exact unpadded payload, and the host's request
 * number, which a deferred read's completion names. Read-request responses are raw device bytes. A
 * sink never sees host memory.
 */
type Endpoint = &Fn(u32,u32,[]const u8,u64) -> Buf[u8]

advance(h: &Host, time: u64, endpoint: Endpoint)
    if time <= h.time then return
    h.time = time
    if !h.busy || h.response_pending || time < h.due then return
    val kind = h.header & 63
    if kind == 0x37
        h.max_return = usize((h.header >> 8) & 0xffff)
    else
        val reading = kind == 0x06 || kind == 0x04 || kind == 0x14 || kind == 0x24
        if reading && h.defer_reads
            h.response_pending = true
            h.due = 0xffffffffffffffff
        val response = endpoint((h.header >> 6) & 3,kind,h.packet[..<h.packet_count],h.request_id)
        if reading && h.defer_reads then return
        if reading then receive(h,response.view())
    h.busy = false

private ready(h: &Host) -> bool = h.regs[1] & 1 != 0 && h.regs[0x34 / 4] & 1 != 0 &&
    h.regs[0xa0 / 4] & 3 == 3 && h.regs[0x404 / 4] & 8 != 0 && h.regs[0x430 / 4] & 0x01000001 == 0x01000001

/** Configuration registers for implemented command-mode behavior only. */
private configured(offset: u32) -> bool = offset match
    0x04 | 0x08 | 0x0c | 0x10 | 0x14 | 0x18 | 0x2c | 0x30 | 0x34 | 0x64 | 0x68 |
    0x78 | 0x7c | 0x80 | 0x84 | 0x88 | 0x8c | 0x94 | 0x98 | 0x9c | 0xa0 | 0xa4 |
    0x400 | 0x404 | 0x418 | 0x41c | 0x420 | 0x424 | 0x428 | 0x430 -> true
    _ -> false

read(h: &Host, offset: u32) -> Option[u32]
    if offset & 3 != 0 then return None
    if configured(offset) then return Some(h.regs[offset / 4])
    offset match
        0x00 -> Some(0x3133302a)
        0x6c -> Some(h.header)
        0x74 -> Some((if h.busy then 2u32 else 1u32) | (if h.tx_count == 0 then 4 else 0) |
            (if h.tx_count == 1024 then 8 else 0) | (if h.rx.is_empty() then 16 else 0) |
            (if h.rx.is_full() then 32 else 0) |
            (if h.busy && ((h.header & 63) == 6 || (h.header & 63) == 4 || (h.header & 63) == 0x14 || (h.header & 63) == 0x24) then 64 else 0))
        0x70 ->
            var result: u32 = 0
            for i in 0..<4
                h.rx.pop_front() match
                    Some(byte) -> result |= u32(byte) << u32(i * 8)
                    None -> break
            Some(result)
        0xb0 -> Some(if ready(h) then 0x15 | (if h.regs[0xa4 / 4] & 1 != 0 then 0x80 else 0) else 0)
        0x40c -> Some((if h.regs[0x430 / 4] & 0x01000000 != 0 then 0x1000u32 else 0) |
            (if h.regs[0x430 / 4] & 0x01000001 == 0x01000001 then 0x100 else 0))
        _ -> None

/** False means an unsupported or invalid operation; the bus adapter must report
 * it, rather than silently complete a mode it does not implement.
 */
write(h: &Host, offset: u32, value: u32) -> bool
    if offset & 3 != 0 then return false
    if configured(offset)
        if offset == 0x430 && value & 1 != 0
            val n = (value >> 2) & 127
            val input = (value >> 11) & 15
            val output = 1u64 << ((value >> 16) & 3)
            if n < 10 || n > 125 || input == 0 || input > 7 then return false
            val rate = h.reference_hz * u64(n) / u64(input) / output
            if rate == 0 || rate > 1000000000 then return false
            h.lane_rate = rate
        if offset == 0x34 && value & 1 == 0 then return false // No video mode yet.
        if offset == 0xa4 && value & 3 > 1 then return false // One or two lanes.
        if offset == 0x04 && value & 1 == 0
            h.busy = false
            h.response_pending = false
            h.request_id += 1
            h.tx_count = 0
            h.rx.clear()
        h.regs[offset / 4] = value
        if h.busy && !ready(h)
            h.busy = false
            h.response_pending = false
            h.request_id += 1
            h.tx_count = 0
        return true
    if offset == 0x70
        if !ready(h) || h.tx_count > 1020 then return false
        for i in 0..<4 do h.tx[h.tx_count + usize(i)] = u8(value >> u32(i * 8))
        h.tx_count += 4
        return true
    if offset != 0x6c || !ready(h) || h.busy then return false
    val kind = value & 63
    var size: usize = 0
    kind match
        0x03 | 0x04 | 0x37 -> size = 0
        0x05 | 0x06 | 0x13 | 0x14 -> size = 1
        0x15 | 0x23 | 0x24 -> size = 2
        0x29 | 0x39 ->
            size = usize((value >> 8) & 0xffff)
            if size == 0 || size > 1024 || h.tx_count != ((size + 3) / 4) * 4 then return false
        _ -> return false
    if kind == 0x37 && ((value >> 8) & 0xffff == 0 || (value >> 8) & 0xffff > 1024) then return false
    if kind == 0x29 || kind == 0x39
        for i in 0..<size do h.packet[i] = h.tx[i]
        h.tx_count = 0
    else
        if h.tx_count != 0 then return false
        if size > 0 then h.packet[0] = u8(value >> 8)
        if size > 1 then h.packet[1] = u8(value >> 16)
    h.request_id += 1
    h.response_pending = false
    h.header = value & 0xffffff
    h.packet_count = size
    h.busy = true
    val bytes = if kind == 0x29 || kind == 0x39 then u64(size) + 6 else 4u64
    val rate = h.lane_rate * u64((h.regs[0xa4 / 4] & 3) + 1)
    h.due = h.time + (bytes * 8 * h.hz + rate - 1) / rate
    true

/** Complete a deferred read on the device worker. A cancelled/reset request
 * cannot populate a newer transaction's receive FIFO.
 */
complete_read(h: &Host, request_id: u64, response: []const u8) -> bool
    if !h.busy || !h.response_pending || h.request_id != request_id then return false
    receive(h,response)
    h.response_pending = false
    h.busy = false
    true
