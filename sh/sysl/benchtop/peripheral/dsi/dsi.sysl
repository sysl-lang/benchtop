module sh.sysl.benchtop.peripheral.dsi

import sysl.buf.{Buf,buf}

/** STM32 DSI command-mode host. Packets cross a timed link before the attached
 * endpoint receives them. Endpoints are independent of MCU addresses and GPIO.
 * No LTDC/video streaming, TE, ULPS, ECC/CRC fault injection or analog PHY model.
 */
struct Host
    hz: u64
    lane_rate: u64
    regs: [269]u32
    tx: [1024]u8
    tx_count: usize
    packet: [1024]u8
    packet_count: usize
    header: u32
    busy: bool
    due: u64
    time: u64
    rx: [1024]u8
    rx_count: usize
    rx_at: usize
    max_return: usize

host(hz: u64, lane_rate: u64 = 500000000) -> &Host
    require hz > 0 && hz <= 1000000000 && lane_rate > 0 && lane_rate <= 1000000000, "bounded DSI clock rates"
    val h: &Host = Host(hz,lane_rate,[0;269],[0;1024],0,[0;1024],0,0,false,0,0,[0;1024],0,0,1)
    h.regs[0x34 / 4] = 1 // Command mode.
    h

/** Callback arguments are VC, packet data type and exact unpadded payload.
 * Read-request responses are raw device bytes. A sink never sees host memory.
 */
type Endpoint = &Fn(u32,u32,[]const u8) -> Buf[u8]

advance(h: &Host, time: u64, endpoint: Endpoint)
    if time <= h.time then return
    h.time = time
    if !h.busy || time < h.due then return
    val kind = h.header & 63
    if kind == 0x37
        h.max_return = usize((h.header >> 8) & 0xffff)
    else
        val response = endpoint((h.header >> 6) & 3,kind,h.packet[..<h.packet_count])
        if kind == 0x06 || kind == 0x04 || kind == 0x14 || kind == 0x24
            h.rx_count = if response.len() < h.max_return then response.len() else h.max_return
            h.rx_at = 0
            for i in 0..<h.rx_count do h.rx[i] = response.at(i)
    h.busy = false

private ready(h: &Host) -> bool = h.regs[1] & 1 != 0 && h.regs[0x34 / 4] & 1 != 0 &&
    h.regs[0xa0 / 4] & 3 == 3 && h.regs[0x404 / 4] & 8 != 0 && h.regs[0x430 / 4] & 0x01000001 == 0x01000001

/** Configuration registers for implemented command-mode behavior only. */
private configured(offset: u32) -> bool = offset match
    0x04 | 0x08 | 0x0c | 0x10 | 0x14 | 0x18 | 0x2c | 0x30 | 0x34 | 0x64 | 0x68 |
    0x78 | 0x7c | 0x80 | 0x84 | 0x88 | 0x8c | 0x94 | 0x98 | 0x9c | 0xa0 | 0xa4 |
    0x400 | 0x404 | 0x418 | 0x41c | 0x420 | 0x424 | 0x428 | 0x430 -> true
    _ -> false

read(h: &Host, offset: u32) -> Option[u32]
    if offset & 3 != 0 then return None
    if configured(offset) then return Some(h.regs[offset / 4])
    offset match
        0x00 -> Some(0x3133302a)
        0x6c -> Some(h.header)
        0x74 -> Some((if h.busy then 2u32 else 1u32) | (if h.tx_count == 0 then 4 else 0) |
            (if h.tx_count == 1024 then 8 else 0) | (if h.rx_at == h.rx_count then 16 else 0) |
            (if h.rx_count - h.rx_at == 1024 then 32 else 0) |
            (if h.busy && ((h.header & 63) == 6 || (h.header & 63) == 4 || (h.header & 63) == 0x14 || (h.header & 63) == 0x24) then 64 else 0))
        0x70 ->
            var result: u32 = 0
            for i in 0..<4
                if h.rx_at < h.rx_count
                    result |= u32(h.rx[h.rx_at]) << u32(i * 8)
                    h.rx_at += 1
            Some(result)
        0xb0 -> Some(if ready(h) then 0x15 else 0)
        0x40c -> Some((if h.regs[0x430 / 4] & 0x01000000 != 0 then 0x1000u32 else 0) |
            (if h.regs[0x430 / 4] & 0x01000001 == 0x01000001 then 0x100 else 0))
        _ -> None

/** False means an unsupported or invalid operation; the bus adapter must report
 * it, rather than silently complete a mode it does not implement.
 */
write(h: &Host, offset: u32, value: u32) -> bool
    if offset & 3 != 0 then return false
    if configured(offset)
        if offset == 0x34 && value & 1 == 0 then return false // No video mode yet.
        if offset == 0xa4 && value & 3 > 1 then return false // One or two lanes.
        if offset == 0x04 && value & 1 == 0
            h.busy = false
            h.tx_count = 0
            h.rx_at = 0
            h.rx_count = 0
        h.regs[offset / 4] = value
        return true
    if offset == 0x70
        if !ready(h) || h.tx_count > 1020 then return false
        for i in 0..<4 do h.tx[h.tx_count + i] = u8(value >> u32(i * 8))
        h.tx_count += 4
        return true
    if offset != 0x6c || !ready(h) || h.busy then return false
    val kind = value & 63
    var size: usize = 0
    kind match
        0x03 | 0x04 | 0x37 -> size = 0
        0x05 | 0x06 | 0x13 | 0x14 -> size = 1
        0x15 | 0x23 | 0x24 -> size = 2
        0x29 | 0x39 ->
            size = usize((value >> 8) & 0xffff)
            if size == 0 || size > 1024 || h.tx_count != ((size + 3) / 4) * 4 then return false
        _ -> return false
    if kind == 0x37 && ((value >> 8) & 0xffff == 0 || (value >> 8) & 0xffff > 1024) then return false
    if kind == 0x29 || kind == 0x39
        for i in 0..<size do h.packet[i] = h.tx[i]
        h.tx_count = 0
    else
        if h.tx_count != 0 then return false
        if size > 0 then h.packet[0] = u8(value >> 8)
        if size > 1 then h.packet[1] = u8(value >> 16)
    h.header = value & 0xffffff
    h.packet_count = size
    h.busy = true
    val bytes = if kind == 0x29 || kind == 0x39 then u64(size) + 6 else 4u64
    val rate = h.lane_rate * u64((h.regs[0xa4 / 4] & 3) + 1)
    h.due = h.time + (bytes * 8 * h.hz + rate - 1) / rate
    true
