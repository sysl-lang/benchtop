module sh.sysl.benchtop.peripheral.spi
@tests

import sh.sysl.benchtop.peripheral.Model
import sh.sysl.benchtop.timing.NEVER
import sysl.buf.{Buf,buf}

private val low: Pins = (enabled,sck,mosi,time) -> false
private val wire_loop: Pins = (enabled,sck,mosi,time) -> mosi

private setup(mode: u32 = 0, width: u32 = 8, pins: Pins = wire_loop) -> Controller
    var c = controller(pins = pins)
    assert(c.write(0,4,(width - 1) | (if mode & 2 != 0 then 64u32 else 0) | (if mode & 1 != 0 then 128u32 else 0),0))
    assert(c.write(16,4,4,0))
    assert(c.write(4,4,2,0))
    c

@test("PL022 SPI: all modes and frame widths shift MSB first and complete at the configured clock")
clocked_words()
    for mode in 0u32..<4
        for width in 4u32..16
            for value in [0u32,65535,0xA55A,1]
                var c = setup(mode,width)
                assert(c.write(8,4,value,0))
                assert(status(&c) & 16 != 0)
                val finish = u64(width) * 4
                assert(c.due() == finish)
                c.advance(finish - 1)
                assert(c.rx.is_empty() && c.shifting)
                c.advance(finish)
                assert(!c.shifting && c.sck == (mode & 2 != 0))
                assert(c.read(8,4,finish) == Some(value & ((1u32 << width) - 1)))
                assert(status(&c) == 3)

@test("PL022 SPI: FIFO capacity, full writes, receive overrun, timeout and IRQ acknowledgement")
fifos_and_interrupts()
    var c = setup()
    for i in 0u32..<10 do assert(c.write(8,4,i,0))
    assert(c.tx.len() == 8 && status(&c) & 2 == 0)
    c.write(20,4,15,0)
    assert(c.read(28,4,0).unwrap() & 8 == 0)
    c.advance(9 * 32)
    assert(!c.shifting && c.rx.len() == 8 && c.overrun)
    assert(c.read(24,4,c.time).unwrap() & 13 == 13)
    for i in 0u32..<8 do assert(c.read(8,4,c.time) == Some(i))
    assert(c.rx.is_empty())
    c.write(32,4,1,c.time)
    assert(!c.overrun)
    c.write(8,4,123,c.time)
    c.advance(10 * 32)
    assert(raw_irq(&c) & 2 == 0)
    assert(c.due() == 10 * 32 + 128, "the receive timeout is the next event while it is unmasked")
    c.advance(10 * 32 + 127)
    assert(raw_irq(&c) & 2 == 0)
    c.advance(10 * 32 + 128)
    assert(raw_irq(&c) & 2 != 0 && c.irq())
    c.write(32,4,2,c.time)
    assert(raw_irq(&c) & 2 == 0)

struct Trace
    points: Buf[(bool,bool,u64)]

@test("PL022 SPI: time chunking preserves every timestamped wire edge and FIFO result")
chunking()
    val one: &Trace = Trace(buf())
    val many: &Trace = Trace(buf())
    var a = setup(pins = (enabled,s,m,t) ->
        one.points.push((s,m,t))
        m)
    var b = setup(pins = (enabled,s,m,t) ->
        many.points.push((s,m,t))
        m)
    for value in [0x81u32,0x5A,0]
        a.write(8,4,value,0)
        b.write(8,4,value,0)
    a.advance(96)
    for t in 0u64..96 do b.advance(t)
    assert(one.points.view() == many.points.view())
    for i in 0..<3 do assert(a.read(8,4,96) == b.read(8,4,96))
    assert(status(&a) == status(&b))

@test("PL022 SPI: the pins see whether the port is enabled, and a reset keeps them")
pins_held()
    val seen: Buf[bool] = buf()
    var c = setup(pins = (enabled,sck,mosi,time) ->
        seen.push(enabled)
        mosi)
    c.write(8,4,0xff,0)
    c.advance(2)
    assert(seen.len() > 0 && seen[0], "an enabled port drives its pins")
    c.write(4,4,0,2)
    drive(&c,2)
    assert(!seen[seen.len() - 1], "a disabled port's pins are told so")
    c.reset()
    assert(c.due() == NEVER && !c.irq())
    assert(c.write(0,4,7,0) && c.write(16,4,2,0) && c.write(4,4,2,0) && c.write(8,4,1,0))
    val before = seen.len()
    c.advance(16)
    assert(seen.len() > before, "the pins survive the reset")

@test("PL022 SPI: reset, loopback, disable, prescaler bounds and unsupported modes are explicit")
configuration()
    var c = controller(pins = low)
    assert(status(&c) == 3 && !c.write(4,4,2,0))
    for divisor in [0u32,1,3,255,256] do assert(!c.write(16,4,divisor,0))
    for divisor in [2u32,4,254] do assert(c.write(16,4,divisor,0))
    c.write(0,4,7 | 0xFF00,0)
    assert(c.write(4,4,3,0))
    assert(!c.write(0,4,7,0) && !c.write(16,4,2,0) && !c.write(4,4,6,0))
    c.write(8,4,0xA5,0)
    assert(c.due() == 8u64 * 254 * 256)
    c.advance(8u64 * 254 * 256)
    assert(c.read(8,4,c.time) == Some(0xA5u32), "internal loopback ignores external MISO")
    c.write(8,4,42,c.time)
    c.write(4,4,0,c.time)
    assert(!c.shifting && !enabled(&c))
    c.reset()
    assert(c.cr0 == 0 && c.tx.is_empty() && c.rx.is_empty() && !c.overrun)
    assert(c.read(0xFE0,4,0) == Some(0x22u32) && c.read(0xFFC,4,0) == Some(0xB1u32))
    assert(c.read(0x40,4,0).is_none() && !c.write(0x40,4,0,0))
    for format in [16u32,32]
        c.write(0,4,7 | format,0)
        c.write(16,4,2,0)
        assert(!c.write(4,4,2,0))
