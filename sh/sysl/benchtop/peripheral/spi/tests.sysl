module sh.sysl.benchtop.peripheral.spi
@tests

import sh.sysl.benchtop.peripheral.ContextModel
import sh.sysl.benchtop.timing.NEVER
import sysl.buf.{Buf,buf}

// What a test's pins have seen: each edge's SCK, MOSI and time, and whether the port was enabled. It is
// the controller's context, which each `advance` and `drive` hands its pins.
struct Trace
    points: Buf[(bool,bool,u64)]
    enabled: Buf[bool]

private trace() -> Trace = Trace(buf(), buf())

private val low: Pins[Trace] = (seen,edge) -> false
private val wire_loop: Pins[Trace] = (seen,edge) -> edge.mosi
// Pins that write down every edge and loop MOSI back to MISO.
private val recording: Pins[Trace] = (seen,edge) ->
    seen.points.push((edge.sck,edge.mosi,edge.time))
    seen.enabled.push(edge.enabled)
    edge.mosi

private setup(mode: u32 = 0, width: u32 = 8, pins: Pins[Trace] = wire_loop) -> Controller[Trace]
    var c = controller(pins = pins)
    // A register write reaches no pin, so it is handed a trace of its own.
    var unused = trace()
    assert(c.write(&unused,0,4,(width - 1) | (if mode & 2 != 0 then 64u32 else 0) | (if mode & 1 != 0 then 128u32 else 0),0))
    assert(c.write(&unused,16,4,4,0))
    assert(c.write(&unused,4,4,2,0))
    c

@test("PL022 SPI: all modes and frame widths shift MSB first and complete at the configured clock")
clocked_words()
    var t = trace()
    for mode in 0u32..<4
        for width in 4u32..16
            for value in [0u32,65535,0xA55A,1]
                var c = setup(mode,width)
                assert(c.write(&t,8,4,value,0))
                assert(status(&c) & 16 != 0)
                val finish = u64(width) * 4
                assert(c.due() == finish)
                c.advance(&t,finish - 1)
                assert(c.rx.is_empty() && c.shifting)
                c.advance(&t,finish)
                assert(!c.shifting && c.sck == (mode & 2 != 0))
                assert(c.read(8,4,finish) == Some(value & ((1u32 << width) - 1)))
                assert(status(&c) == 3)

@test("PL022 SPI: FIFO capacity, full writes, receive overrun, timeout and IRQ acknowledgement")
fifos_and_interrupts()
    var t = trace()
    var c = setup()
    for i in 0u32..<10 do assert(c.write(&t,8,4,i,0))
    assert(c.tx.len() == 8 && status(&c) & 2 == 0)
    c.write(&t,20,4,15,0)
    assert(c.read(28,4,0).unwrap() & 8 == 0)
    c.advance(&t,9 * 32)
    assert(!c.shifting && c.rx.len() == 8 && c.overrun)
    assert(c.read(24,4,c.time).unwrap() & 13 == 13)
    for i in 0u32..<8 do assert(c.read(8,4,c.time) == Some(i))
    assert(c.rx.is_empty())
    c.write(&t,32,4,1,c.time)
    assert(!c.overrun)
    c.write(&t,8,4,123,c.time)
    c.advance(&t,10 * 32)
    assert(raw_irq(&c) & 2 == 0)
    assert(c.due() == 10 * 32 + 128, "the receive timeout is the next event while it is unmasked")
    c.advance(&t,10 * 32 + 127)
    assert(raw_irq(&c) & 2 == 0)
    c.advance(&t,10 * 32 + 128)
    assert(raw_irq(&c) & 2 != 0 && c.irq())
    c.write(&t,32,4,2,c.time)
    assert(raw_irq(&c) & 2 == 0)

@test("PL022 SPI: time chunking preserves every timestamped wire edge and FIFO result")
chunking()
    var one = trace()
    var many = trace()
    var a = setup(pins = recording)
    var b = setup(pins = recording)
    for value in [0x81u32,0x5A,0]
        a.write(&one,8,4,value,0)
        b.write(&many,8,4,value,0)
    a.advance(&one,96)
    for t in 0u64..96 do b.advance(&many,t)
    assert(one.points.view() == many.points.view())
    for i in 0..<3 do assert(a.read(8,4,96) == b.read(8,4,96))
    assert(status(&a) == status(&b))

@test("PL022 SPI: each edge reaches the pins of the context its advance was handed")
context_per_advance()
    var first = trace()
    var second = trace()
    var c = setup(pins = recording)
    c.write(&first,8,4,0x81,0)
    c.advance(&first,16)
    c.advance(&second,32)
    assert(!first.points.is_empty() && !second.points.is_empty(), "each half of the word drives the pins")
    for p in first.points.view()
        val (sck, mosi, at) = p
        assert(at <= 16, "the first advance's edges reach the first context only")
    for p in second.points.view()
        val (sck, mosi, at) = p
        assert(at > 16 && at <= 32, "the second advance's edges reach the second context only")
    var whole = trace()
    var d = setup(pins = recording)
    d.write(&whole,8,4,0x81,0)
    d.advance(&whole,32)
    assert(whole.points.len() == first.points.len() + second.points.len(), "no edge lost or doubled at the split")
    assert(c.read(8,4,32) == Some(0x81u32), "the word shifts whole across the two contexts")

@test("PL022 SPI: the pins see whether the port is enabled, and a reset keeps them")
pins_held()
    var seen = trace()
    var c = setup(pins = recording)
    c.write(&seen,8,4,0xff,0)
    c.advance(&seen,2)
    assert(seen.enabled.len() > 0 && seen.enabled[0], "an enabled port drives its pins")
    c.write(&seen,4,4,0,2)
    drive(&c,&seen,2)
    assert(!seen.enabled[seen.enabled.len() - 1], "a disabled port's pins are told so")
    c.reset()
    assert(c.due() == NEVER && !c.irq())
    assert(c.write(&seen,0,4,7,0) && c.write(&seen,16,4,2,0) && c.write(&seen,4,4,2,0) && c.write(&seen,8,4,1,0))
    val before = seen.enabled.len()
    c.advance(&seen,16)
    assert(seen.enabled.len() > before, "the pins survive the reset")

@test("PL022 SPI: reset, loopback, disable, prescaler bounds and unsupported modes are explicit")
configuration()
    var t = trace()
    var c = controller(pins = low)
    assert(status(&c) == 3 && !c.write(&t,4,4,2,0))
    for divisor in [0u32,1,3,255,256] do assert(!c.write(&t,16,4,divisor,0))
    for divisor in [2u32,4,254] do assert(c.write(&t,16,4,divisor,0))
    c.write(&t,0,4,7 | 0xFF00,0)
    assert(c.write(&t,4,4,3,0))
    assert(!c.write(&t,0,4,7,0) && !c.write(&t,16,4,2,0) && !c.write(&t,4,4,6,0))
    c.write(&t,8,4,0xA5,0)
    assert(c.due() == 8u64 * 254 * 256)
    c.advance(&t,8u64 * 254 * 256)
    assert(c.read(8,4,c.time) == Some(0xA5u32), "internal loopback ignores external MISO")
    c.write(&t,8,4,42,c.time)
    c.write(&t,4,4,0,c.time)
    assert(!c.shifting && !enabled(&c))
    c.reset()
    assert(c.cr0 == 0 && c.tx.is_empty() && c.rx.is_empty() && !c.overrun)
    assert(c.read(0xFE0,4,0) == Some(0x22u32) && c.read(0xFFC,4,0) == Some(0xB1u32))
    assert(c.read(0x40,4,0).is_none() && !c.write(&t,0x40,4,0,0))
    for format in [16u32,32]
        c.write(&t,0,4,7 | format,0)
        c.write(&t,16,4,2,0)
        assert(!c.write(&t,4,4,2,0))
