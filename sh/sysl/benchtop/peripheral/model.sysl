module sh.sysl.benchtop.peripheral

// What every register-level model under `peripheral/` answers, whatever chip it is part of: its
// registers, its clock, its next event, its interrupt line and its reset. A model knows nothing of
// cores, buses or boards. What it reaches outside itself (a card, an analogue input, the RAM a DMA
// engine moves, the pins a shifter drives, where a frame's packets go) is a connection the model holds,
// set once by whoever puts it on a board, never passed on each call; a reset keeps its connections.
//
// Time is the model's own clock, in its timebase's ticks (the board clock for the STM32H747's
// models). Members a model has no use for keep the default of a model that has no such thing.

import sh.sysl.benchtop.timing.NEVER

trait Model
    /** Register `offset`'s value, read `width` bytes wide at `time`; None where no register answers. */
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32]
    /** Store `value` in register `offset`, `width` bytes wide at `time`; false where the model refuses
     * the write (an unmapped register, or one it cannot honour).
     */
    write(*self, offset: u32, width: u32, value: u32, time: u64) -> bool
    /** Bring the model's own work up to `time`; a `time` before its own is ignored. */
    advance(*self, time: u64) = ()
    /** The time of its next event, which `advance` brings in, `NEVER` for none. */
    due(*self) -> u64 = NEVER
    /** Whether its interrupt line is high. */
    irq(*self) -> bool = false
    /** Put it as at reset, its connections kept. */
    reset(*self)
