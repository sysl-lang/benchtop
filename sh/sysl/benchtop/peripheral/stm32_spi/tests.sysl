module sh.sysl.benchtop.peripheral.stm32_spi
@tests
import sh.sysl.benchtop.peripheral.ContextModel
import sh.sysl.benchtop.peripheral.spi as serial

// A test's wire: how many times the controller has driven it. It is the controller's context.
private struct Wire
    drives: u32

@test("STM32 SPI: polling byte transfer uses kernel divider, preloaded FIFO and full duplex")
byte_transfer()
    var w = Wire(0)
    var c: Controller[Wire] = controller(8,(wire,edge) ->
        wire.drives += 1
        edge.mosi)
    assert(!c.write(&w,0,4,0x1201,0),"master/SSM must be configured")
    assert(c.write(&w,8,4,7 | (2 << 28),0))
    assert(c.write(&w,12,4,0x84400000,0))
    assert(c.write(&w,0,4,0x1001,0))
    assert(c.write(&w,0x20,1,0xa5,0))
    assert(!c.engine.shifting)
    assert(c.write(&w,0,4,0x1201,0))
    assert(c.engine.shifting)
    assert(c.due() == 512)
    c.advance(&w,511)
    assert(status(&c) & 1 == 0)
    val before = w.drives
    c.advance(&w,512)
    assert(w.drives > before && before > 0, "the engine drives the wire it is handed")
    assert(status(&c) & 4097 == 4097)
    assert(c.read(0x30,1,512).unwrap() == 0xa5, "the wire looped MOSI back")
    assert(!c.write(&w,8,4,7,512),"configuration locked while enabled")
    assert(!c.write(&w,4,4,1,512),"finite TSIZE explicitly unsupported")
    assert(!c.write(&w,0x20,4,0,512),"byte accesses required in this subset")
    c.reset()
    assert(c.engine.capacity == 64 && c.ratio == 8 && status(&c) == 4098)
    assert((c.engine.pins)(&w,serial.Edge(true,false,true,0)), "a reset keeps the pins")

@test("STM32 SPI: bounded 64-byte receive FIFO and overrun clearing")
fifo_overrun()
    var w = Wire(0)
    var c: Controller[Wire] = controller(1,(wire,edge) -> true)
    assert(c.write(&w,12,4,0x04400000,0))
    assert(c.write(&w,0,4,0x1201,0))
    for i in 0u64..<65
        assert(c.write(&w,0x20,1,0,0))
        c.advance(&w,(i + 1) * 16)
    assert(c.engine.rx.len() == 64 && status(&c) & 64 != 0)
    assert(c.write(&w,24,4,64,0))
    assert(status(&c) & 64 == 0)
