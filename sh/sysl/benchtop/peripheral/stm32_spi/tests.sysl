module sh.sysl.benchtop.peripheral.stm32_spi
@tests
import sh.sysl.benchtop.peripheral.spi as serial

@test("STM32 SPI: polling byte transfer uses kernel divider, preloaded FIFO and full duplex")
byte_transfer()
    var c = controller(8)
    assert(!write(&c,0,4,0x1201),"master/SSM must be configured")
    assert(write(&c,8,4,7 | (2 << 28)))
    assert(write(&c,12,4,0x84400000))
    assert(write(&c,0,4,0x1001))
    assert(write(&c,0x20,1,0xa5))
    assert(!c.engine.shifting)
    assert(write(&c,0,4,0x1201))
    assert(c.engine.shifting)
    val input: &Fn(bool,bool,u64) -> bool = (sck,mosi,time) -> mosi
    serial.advance(&c.engine,511,input)
    assert(status(c) & 1 == 0)
    serial.advance(&c.engine,512,input)
    assert(status(c) & 4097 == 4097)
    assert(read(&c,0x30,1).unwrap() == 0xa5)
    assert(!write(&c,8,4,7),"configuration locked while enabled")
    assert(!write(&c,4,4,1),"finite TSIZE explicitly unsupported")
    assert(!write(&c,0x20,4,0),"byte accesses required in this subset")
    reset(&c)
    assert(c.engine.capacity == 64 && c.ratio == 8 && status(c) == 4098)

@test("STM32 SPI: bounded 64-byte receive FIFO and overrun clearing")
fifo_overrun()
    var c = controller(1)
    assert(write(&c,12,4,0x04400000))
    assert(write(&c,0,4,0x1201))
    val input: &Fn(bool,bool,u64) -> bool = (sck,mosi,time) -> true
    for i in 0u64..<65
        assert(write(&c,0x20,1,0))
        serial.advance(&c.engine,(i + 1) * 16,input)
    assert(c.engine.rx.len() == 64 && status(c) & 64 != 0)
    assert(write(&c,24,4,64))
    assert(status(c) & 64 == 0)
