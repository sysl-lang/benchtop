module sh.sysl.benchtop.peripheral.stm32_spi

import sh.sysl.benchtop.peripheral.spi as serial

// STM32H7 enhanced SPI: eight-bit polling full-duplex master, software NSS,
// TSIZE=0 continuous transfers. The existing timed edge engine owns FIFO data.
// DMA, hardware CRC/NSS, suspend and finite TSIZE are explicitly unsupported.
struct Controller
    engine: serial.Controller
    cr1: u32
    cfg1: u32
    cfg2: u32
    ratio: u32

controller(ratio: u32 = 8) -> Controller
    require ratio > 0 && ratio <= 1024, "integer SPI kernel-clock ratio"
    Controller(serial.controller(64),0,7,0,ratio)
reset(c: *Controller) = *c = controller(c.ratio)

status(c: Controller) -> u32
    val rx = c.engine.rx_count > 0
    val tx = c.engine.tx_count < c.engine.capacity
    (if rx then 1u32 else 0) | (if tx then 2u32 else 0) | (if rx && tx then 4u32 else 0) |
        (if c.engine.overrun then 64u32 else 0) | (if !c.engine.shifting && c.engine.tx_count == 0 then 4096u32 else 0)
read(c: *Controller, offset: u32, width: u32) -> Option[u32]
    if offset == 0x30 && width == 1 then return serial.read(&c.engine,8)
    if width != 4 || offset & 3 != 0 then return None
    offset match
        0 -> Some(c.cr1)
        4 -> Some(0)
        8 -> Some(c.cfg1)
        12 -> Some(c.cfg2)
        16 -> Some(0)
        20 -> Some(status(*c))
        24 -> Some(0)
        _ -> None
write(c: *Controller, offset: u32, width: u32, value: u32) -> bool
    if offset == 0x20 && width == 1
        if c.cr1 & 1 == 0 then return false
        return serial.write(&c.engine,8,value)
    if width != 4 || offset & 3 != 0 then return false
    offset match
        0 ->
            if value & ~0x1201u32 != 0 then return false
            if value & 1 == 0
                serial.reset(&c.engine)
            else
                if c.cfg2 & 0x04400000 != 0x04400000 || value & 0x1000 == 0 then return false
                c.engine.cr0 = 7 | (if c.cfg2 & (1 << 25) != 0 then 64u32 else 0) | (if c.cfg2 & (1 << 24) != 0 then 128u32 else 0)
                c.engine.cpsr = c.ratio * (1u32 << ((c.cfg1 >> 28) + 1))
                c.engine.cr1 = if value & 512 != 0 then 2 else 0
                c.engine.sck = c.cfg2 & (1 << 25) != 0
                serial.kick(&c.engine)
            c.cr1 = value
        4 | 16 -> if value != 0 then return false
        8 ->
            if c.cr1 & 1 != 0 || value & ~0x70000007u32 != 0 || value & 31 != 7 then return false
            c.cfg1 = value
        12 ->
            if c.cr1 & 1 != 0 || value & ~0x87400000u32 != 0 then return false
            c.cfg2 = value
        24 -> if value & 64 != 0 then c.engine.overrun = false
        _ -> return false
    true
