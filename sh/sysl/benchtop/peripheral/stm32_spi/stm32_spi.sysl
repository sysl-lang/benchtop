module sh.sysl.benchtop.peripheral.stm32_spi

import sh.sysl.benchtop.peripheral.Model
import sh.sysl.benchtop.peripheral.spi as serial
import sh.sysl.stm32h747.spi1 as reg

// STM32H7 enhanced SPI: eight-bit polling full-duplex master, software NSS,
// TSIZE=0 continuous transfers. The existing timed edge engine owns FIFO data.
// DMA, hardware CRC/NSS, suspend and finite TSIZE are explicitly unsupported.
//
// Divergences from the silicon (policy: docs/peripheral-models.md, "Unsupported writes"):
// - A write that selects an unsupported feature is refused (`write` answers false, a bus fault)
//   rather than accepted: a CR1 bit other than SPE/CSTART/SSI, a nonzero CR2 (TSIZE) or IER,
//   a CFG1 data size other than eight bits or any DMA/CRC/FIFO-threshold field, a CFG2 field other
//   than CPOL/CPHA/SSM/MASTER/AFCNTR, enabling without master + software NSS, a CFG write while enabled,
//   and a TXDR write while disabled.
// - Only 32-bit accesses reach the configuration registers, and only 8-bit ones TXDR/RXDR.

// CFG1 DSIZE holds the frame size less one: 7 for the eight-bit frames this model shifts.
const DSIZE_8BIT: u32 = 7
const CR1_WRITABLE: u32 = reg.CR1_SPE_MASK | reg.CR1_CSTART_MASK | reg.CR1_SSI_MASK
const CFG1_WRITABLE: u32 = reg.CFG1_MBR_MASK | DSIZE_8BIT
const CFG2_WRITABLE: u32 = reg.CFG2_AFCNTR_MASK | reg.CFG2_SSM_MASK | reg.CFG2_CPOL_MASK | reg.CFG2_CPHA_MASK |
    reg.CFG2_MASTER_MASK
// A master that drives its own NSS in software: the only configuration the model enables.
const SOFTWARE_MASTER: u32 = reg.CFG2_SSM_MASK | reg.CFG2_MASTER_MASK

struct Controller
    engine: serial.Controller
    cr1: u32
    cfg1: u32
    cfg2: u32
    ratio: u32

/** A controller whose kernel clock is `ratio` times the engine's tick, its edges on `pins` (set once
 * by whoever puts it on a board; a reset keeps them).
 */
controller(ratio: u32 = 8, pins: serial.Pins = (enabled,sck,mosi,time) -> false) -> Controller
    require ratio > 0 && ratio <= 1024, "integer SPI kernel-clock ratio"
    Controller(serial.controller(64,pins),0,DSIZE_8BIT,0,ratio)

status(c: *Controller) -> u32
    val rx = !c.engine.rx.is_empty()
    val tx = c.engine.tx.len() < c.engine.capacity
    (if rx then reg.SR_RXP_MASK else 0) | (if tx then reg.SR_TXP_MASK else 0) | (if rx && tx then reg.SR_DXP_MASK else 0) |
        (if c.engine.overrun then reg.SR_OVR_MASK else 0) |
        (if !c.engine.shifting && c.engine.tx.is_empty() then reg.SR_TXC_MASK else 0)

// Only 32-bit accesses reach the configuration registers, and only 8-bit ones TXDR/RXDR. The engine
// is brought up by `advance` before an access, so an access itself needs no time.
impl Model for Controller
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32] = read_register(self,offset,width,time)
    write(*self, offset: u32, width: u32, value: u32, time: u64) -> bool = write_register(self,offset,width,value,time)
    override advance(*self, time: u64) = self.engine.advance(time)
    override due(*self) -> u64 = self.engine.due()
    reset(*self) = *self = controller(self.ratio,self.engine.pins)

private read_register(c: *Controller, offset: u32, width: u32, time: u64) -> Option[u32]
    if offset == reg.RXDR_OFFSET && width == 1 then return c.engine.read(8,width,time)
    if width != 4 || offset & 3 != 0 then return None
    offset match
        reg.CR1_OFFSET -> Some(c.cr1)
        reg.CR2_OFFSET -> Some(0)
        reg.CFG1_OFFSET -> Some(c.cfg1)
        reg.CFG2_OFFSET -> Some(c.cfg2)
        reg.IER_OFFSET -> Some(0)
        reg.SR_OFFSET -> Some(status(c))
        reg.IFCR_OFFSET -> Some(0)
        _ -> None
private write_register(c: *Controller, offset: u32, width: u32, value: u32, time: u64) -> bool
    if offset == reg.TXDR_OFFSET && width == 1
        if c.cr1 & reg.CR1_SPE_MASK == 0 then return false
        return c.engine.write(8,width,value,time)
    if width != 4 || offset & 3 != 0 then return false
    offset match
        reg.CR1_OFFSET ->
            if value & ~CR1_WRITABLE != 0 then return false
            if value & reg.CR1_SPE_MASK == 0
                c.engine.reset()
            else
                if c.cfg2 & SOFTWARE_MASTER != SOFTWARE_MASTER || value & reg.CR1_SSI_MASK == 0 then return false
                c.engine.cr0 = serial.CR0_DSS_8BIT | (if c.cfg2 & reg.CFG2_CPOL_MASK != 0 then serial.CR0_SPO else 0) |
                    (if c.cfg2 & reg.CFG2_CPHA_MASK != 0 then serial.CR0_SPH else 0)
                // MBR divides the kernel clock by 2^(MBR + 1).
                c.engine.cpsr = c.ratio * (1u32 << (((c.cfg1 & reg.CFG1_MBR_MASK) >> reg.CFG1_MBR_SHIFT) + 1))
                c.engine.cr1 = if value & reg.CR1_CSTART_MASK != 0 then serial.CR1_SSE else 0
                c.engine.sck = c.cfg2 & reg.CFG2_CPOL_MASK != 0
                serial.kick(&c.engine)
            c.cr1 = value
        reg.CR2_OFFSET | reg.IER_OFFSET -> if value != 0 then return false
        reg.CFG1_OFFSET ->
            if c.cr1 & reg.CR1_SPE_MASK != 0 || value & ~CFG1_WRITABLE != 0 || value & reg.CFG1_DSIZE_MASK != DSIZE_8BIT then return false
            c.cfg1 = value
        reg.CFG2_OFFSET ->
            if c.cr1 & reg.CR1_SPE_MASK != 0 || value & ~CFG2_WRITABLE != 0 then return false
            c.cfg2 = value
        reg.IFCR_OFFSET -> if value & reg.IFCR_OVRC_MASK != 0 then c.engine.overrun = false
        _ -> return false
    true
