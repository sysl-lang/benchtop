module sh.sysl.benchtop.peripheral.i2c

import sh.sysl.benchtop.peripheral.Model
import sysl.buf.{Buf, buf}

/** Byte-level I2C device callbacks are independent of the MCU register adapter. */
struct Device
    address: u8
    start: &Fn(bool, u64) -> unit
    write: &Fn(u8, u64) -> bool
    read: &Fn(u64) -> u8

struct Controller
    devices: Buf[Device]
    address: u8
    selected: int
    reading: bool
    data: u8
    status: u32

controller(devices: Buf[Device]) -> Controller = Controller(devices, 0, -1, false, 0, 0)

// The devices on the bus are the controller's connections, set when it is made. A transfer completes
// within the access that starts it, so the controller has no events of its own. Every register is a
// word, which the bus checks.
impl Model for Controller
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32] = offset match
        0 -> Some(u32(self.address))
        4 -> Some(u32(self.data))
        8 -> Some(0)
        12 -> Some(self.status)
        _ -> None

    write(*self, offset: u32, width: u32, value: u32, time: u64) -> bool = command(self, offset, value, time)

    /** Back to idle with no device selected; the devices on the bus are kept. */
    reset(*self) = *self = controller(self.devices)

/** COMMAND: START=1, READ=2, WRITE=4, STOP=8. START+READ selects a read transaction. */
private command(c: *Controller, offset: u32, value: u32, time: u64) -> bool
    offset match
        0 -> c.address = u8(value & 127)
        4 -> c.data = u8(value & 255)
        8 ->
            if value & ~15u32 != 0 || value & 6 == 6
                c.status = 2
                return true
            if value & 1 != 0
                c.selected = -1
                c.reading = value & 2 != 0
                for i in 0..<c.devices.len() do if c.devices.at(i).address == c.address then c.selected = int(i)
                if c.selected < 0 then c.status = 2
                else
                    (c.devices.at(usize(c.selected)).start)(c.reading, time)
                    c.status = 5 // ACK | ACTIVE
            elif value & 6 != 0
                if c.selected < 0 || ((value & 2 != 0) != c.reading) then c.status = 2
                else
                    val d = c.devices.at(usize(c.selected))
                    if c.reading
                        c.data = (d.read)(time)
                        c.status = 5
                    else c.status = if (d.write)(c.data, time) then 5 else 6
            if value & 8 != 0
                c.selected = -1
                c.status &= ~4u32
        12 -> c.status &= ~(value & 2)
        _ -> return false
    true
