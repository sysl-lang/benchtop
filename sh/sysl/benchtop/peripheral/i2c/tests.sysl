module sh.sysl.benchtop.peripheral.i2c
@tests

import sh.sysl.benchtop.parts.ds3231 as rtc
import sh.sysl.benchtop.peripheral.ContextModel
import sysl.buf.{Buf, buf}

@test("I2C controller: write-pointer/repeated-start/read/stop reaches a real RTC register model and reports NACKs")
transactions()
    // The RTC is the context the bus lends each transfer; its device reaches it only through that.
    var r = rtc.rtc(100)
    var devices: Buf[Device[rtc.Rtc]] = buf()
    devices.push(Device(0x68,(r,reading,time) -> rtc.start(r,reading,time), (r,byte,time) -> rtc.write(r,byte,time), (r,time) -> rtc.read(r,time)))
    var c = controller(devices)
    c.write(&r,0,4,0x68,0)
    c.write(&r,8,4,1,0)
    assert(c.status == 5)
    c.write(&r,4,4,0,0)
    c.write(&r,8,4,4,0)
    c.write(&r,8,4,3,100)
    c.write(&r,8,4,2,100)
    assert(c.read(4,4,100) == Some(1u32))
    assert(r.pointer == 1, "the write reached the context's RTC, not a copy")
    c.write(&r,8,4,8,100)
    assert(c.selected == -1 && c.status == 1)
    c.write(&r,0,4,0x69,100)
    c.write(&r,8,4,1,100)
    assert(c.status == 2)
    c.write(&r,8,4,4,100)
    assert(c.status == 2)
    c.write(&r,12,4,2,100)
    assert(c.status == 0)
    assert(!c.write(&r,16,4,0,100) && c.read(16,4,100).is_none())
    c.write(&r,0,4,0x68,100)
    c.write(&r,8,4,1,100)
    c.reset()
    assert(c.selected == -1 && c.status == 0 && c.address == 0)
    c.write(&r,0,4,0x68,100)
    c.write(&r,8,4,1,100)
    assert(c.status == 5, "a reset keeps the devices on the bus")
