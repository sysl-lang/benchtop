module sh.sysl.benchtop.peripheral.i2c
@tests

import sh.sysl.benchtop.parts.ds3231 as rtc
import sh.sysl.benchtop.peripheral.Model
import sysl.buf.{Buf, buf}

@test("I2C controller: write-pointer/repeated-start/read/stop reaches a real RTC register model and reports NACKs")
transactions()
    val r = rtc.rtc(100)
    var devices: Buf[Device] = buf()
    devices.push(Device(0x68,(reading,time) -> rtc.start(r,reading,time), (byte,time) -> rtc.write(r,byte,time), time -> rtc.read(r,time)))
    var c = controller(devices)
    c.write(0,4,0x68,0)
    c.write(8,4,1,0)
    assert(c.status == 5)
    c.write(4,4,0,0)
    c.write(8,4,4,0)
    c.write(8,4,3,100)
    c.write(8,4,2,100)
    assert(c.read(4,4,100) == Some(1u32))
    c.write(8,4,8,100)
    assert(c.selected == -1 && c.status == 1)
    c.write(0,4,0x69,100)
    c.write(8,4,1,100)
    assert(c.status == 2)
    c.write(8,4,4,100)
    assert(c.status == 2)
    c.write(12,4,2,100)
    assert(c.status == 0)
    assert(!c.write(16,4,0,100) && c.read(16,4,100).is_none())
    c.write(0,4,0x68,100)
    c.write(8,4,1,100)
    c.reset()
    assert(c.selected == -1 && c.status == 0 && c.address == 0)
    c.write(0,4,0x68,100)
    c.write(8,4,1,100)
    assert(c.status == 5, "a reset keeps the devices on the bus")
