module sh.sysl.benchtop.peripheral.adc
@tests
import sh.sysl.benchtop.peripheral.ContextModel
import sh.sysl.benchtop.timing.NEVER

// The level a test puts on the converter's input, on every channel; None leaves it undriven. It is the
// converter's context, which each write hands the input.
private struct Source
    uv: Option[u32]

// A converter whose input is the level of the source it is handed.
private wired(reference_uv: u32 = 3300000, cycles: u64 = 32) -> Adc[Source] =
    adc(reference_uv, cycles, (source, channel) -> source.uv)

@test("virtual ADC: reset state, register permissions, quantization and saturation")
registers()
    var none = Source(None)
    var a = wired()
    assert(a.read(0, 4, 0) == Some(0) && a.read(8, 4, 0) == Some(0) && a.read(12, 4, 0) == Some(0))
    assert(a.read(24, 4, 0) == Some(3300000) && a.read(28, 4, 0) == Some(12) && a.read(32, 4, 0) == Some(32))
    assert(a.read(36, 4, 0).is_none() && !a.write(&none, 36, 4, 7, 0))
    assert(quantize(0, 3300000) == 0 && quantize(1650000, 3300000) == 2048)
    assert(quantize(3300000, 3300000) == 4095 && quantize(5000000, 3300000) == 4095)
    assert(quantize(0, 1) == 0 && quantize(1, 1) == 4095)
    for offset in [12u32, 24, 28, 32] do assert(a.write(&none, offset, 4, 99, 0))
    assert(a.result == 0 && a.reference_uv == 3300000 && a.cycles == 32)

@test("virtual ADC: every named register reads back through its offset")
register_names()
    var a: Adc[Source] = adc()
    val names = ["CTRL", "CHANNEL", "STATUS", "RESULT", "IRQ_ENABLE", "IRQ_STATUS", "VREF", "RESOLUTION", "CONVERSION_CYCLES"]
    for i in 0..<names.len
        assert_eq(register_offset(names[i]), Some(u32(i * 4)))
        assert(a.read(u32(i * 4), 4, 0).is_some())
    assert(register_offset("UNKNOWN").is_none() && register_offset("ctrl").is_none())

@test("virtual ADC: the default input drives no channel, so a START is an error")
default_input()
    var none = Source(Some(1650000))
    var a: Adc[Source] = adc()
    assert(a.write(&none, 0, 4, 3, 0) && a.error && !a.busy && a.pending == 2)

@test("virtual ADC: start latches input, completion uses guest time, result persists until next completion")
sampling()
    var source = Source(Some(1650000))
    var a = wired(3300000, 32)
    assert(a.write(&source, 0, 4, 3, 100))
    assert(a.busy && !a.ready && a.result == 0 && a.due() == 132)
    source.uv = Some(0)
    a.advance(&source, 131)
    assert(a.busy && a.result == 0)
    a.advance(&source, 132)
    assert(!a.busy && a.ready && a.result == 2048 && a.pending == 1, "the level at START, not at completion")
    assert(a.due() == NEVER)
    source.uv = Some(3300000)
    a.write(&source, 0, 4, 3, 140)
    assert(a.busy && !a.ready && a.result == 2048)
    a.advance(&source, 172)
    assert(a.result == 4095 && a.ready)
    a.advance(&source, 150)
    assert(a.result == 4095)

@test("virtual ADC: the input answers from the context the write hands it, not from one it kept")
context_per_call()
    var low = Source(Some(0))
    var high = Source(Some(3300000))
    var none = Source(None)
    var a = wired(3300000, 4)
    assert(a.write(&high, 0, 4, 3, 0))
    a.advance(&low, 4)
    assert(a.result == 4095, "sampled from the START's context; advancing with another changes nothing")
    assert(a.write(&low, 0, 4, 3, 4))
    a.advance(&high, 8)
    assert(a.result == 0, "the second START asked the context it was handed")
    assert(a.write(&none, 0, 4, 3, 8) && a.error && a.result == 0, "an undriven context is an error")

@test("virtual ADC: disabled or unconnected starts and busy restarts signal errors without changing a sample")
errors()
    var source = Source(Some(0))
    var a = wired()
    a.write(&source, 0, 4, 2, 0)
    assert(a.error && !a.busy && a.pending == 2)
    a.write(&source, 8, 4, 4, 0)
    a.write(&source, 20, 4, 2, 0)
    assert(!a.error && a.pending == 0)
    source.uv = None
    a.write(&source, 0, 4, 3, 0)
    assert(a.error && !a.busy, "nothing drives the channel")
    source.uv = Some(0)
    a.write(&source, 0, 4, 3, 10)
    val due = a.due()
    source.uv = Some(3300000)
    a.write(&source, 0, 4, 3, 11)
    assert(a.busy && a.due() == due && a.error)
    a.advance(&source, due)
    assert(a.result == 0)
    a.write(&source, 0, 4, 3, 100)
    a.write(&source, 0, 4, 0, 101)
    assert(!a.enabled && !a.busy && !a.ready)
    a.advance(&source, 1000)
    assert(a.result == 0)

@test("virtual ADC: the input is asked for the channel CHANNEL selects, at START only")
channels()
    var asked = Source(None)
    var a: Adc[Source] = adc(input = (source, channel) ->
        source.uv = Some(channel)
        if channel == 2 then Some(3300000) else None)
    assert(a.write(&asked, 4, 4, 2, 0) && asked.uv.is_none(), "selecting a channel samples nothing")
    assert(a.write(&asked, 0, 4, 3, 0))
    assert(asked.uv == Some(2) && a.busy)
    a.advance(&asked, a.due())
    assert(a.result == 4095)
    a.reset()
    assert(a.channel == 0 && !a.enabled)
    assert(a.write(&asked, 0, 4, 3, 0) && asked.uv == Some(0) && a.error, "a reset keeps the input; channel 0 is undriven")

@test("virtual ADC: IRQ masking, sticky pending bits, write-one-to-clear and reset")
interrupts()
    var source = Source(Some(900000))
    var a = wired(1800000, 5)
    a.write(&source, 0, 4, 3, 0)
    a.advance(&source, 5)
    assert(!a.irq() && a.pending == 1)
    a.write(&source, 16, 4, 3, 5)
    assert(a.irq())
    a.write(&source, 20, 4, 2, 5)
    assert(a.irq() && a.pending == 1)
    a.write(&source, 20, 4, 1, 5)
    assert(!a.irq() && a.ready)
    a.write(&source, 8, 4, 2, 5)
    assert(!a.ready)
    a.reset()
    assert(a.reference_uv == 1800000 && a.cycles == 5 && a.result == 0 && !a.enabled && !a.irq())

@test("virtual ADC: every output code and half-step boundary rounds up deterministically")
all_codes()
    for code in 0u32..4095
        assert(quantize(code * 2, 8190) == code)
        assert(quantize(code * 2 + 1, 8190) == (if code == 4095 then code else code + 1))
        if code > 0 then assert(quantize(code * 2 - 1, 8190) == code)
