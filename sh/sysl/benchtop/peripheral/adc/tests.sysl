module sh.sysl.benchtop.peripheral.adc
@tests

@test("virtual ADC: reset state, register permissions, quantization and saturation")
registers()
    var a = adc()
    assert(read(a, 0) == Some(0) && read(a, 8) == Some(0) && read(a, 12) == Some(0))
    assert(read(a, 24) == Some(3300000) && read(a, 28) == Some(12) && read(a, 32) == Some(32))
    assert(read(a, 36).is_none() && !write(&a, 36, 7, 0, true, 0))
    assert(quantize(0, 3300000) == 0 && quantize(1650000, 3300000) == 2048)
    assert(quantize(3300000, 3300000) == 4095 && quantize(5000000, 3300000) == 4095)
    assert(quantize(0, 1) == 0 && quantize(1, 1) == 4095)
    for offset in [12u32, 24, 28, 32] do assert(write(&a, offset, 99, 0, true, 0))
    assert(a.result == 0 && a.reference_uv == 3300000 && a.cycles == 32)

@test("virtual ADC: start latches input, completion uses guest time, result persists until next completion")
sampling()
    var a = adc(3300000, 32)
    assert(write(&a, 0, 3, 1650000, true, 100))
    assert(a.busy && !a.ready && a.result == 0)
    advance(&a, 131)
    assert(a.busy && a.result == 0)
    advance(&a, 132)
    assert(!a.busy && a.ready && a.result == 2048 && a.pending == 1)
    write(&a, 0, 3, 3300000, true, 140)
    assert(a.busy && !a.ready && a.result == 2048)
    advance(&a, 172)
    assert(a.result == 4095 && a.ready)
    advance(&a, 150)
    assert(a.result == 4095)

@test("virtual ADC: disabled or unconnected starts and busy restarts signal errors without changing a sample")
errors()
    var a = adc()
    write(&a, 0, 2, 0, true, 0)
    assert(a.error && !a.busy && a.pending == 2)
    write(&a, 8, 4, 0, true, 0)
    write(&a, 20, 2, 0, true, 0)
    assert(!a.error && a.pending == 0)
    write(&a, 0, 3, 3300000, false, 0)
    assert(a.error && !a.busy)
    write(&a, 0, 3, 0, true, 10)
    val due = a.due
    write(&a, 0, 3, 3300000, true, 11)
    assert(a.busy && a.due == due && a.error)
    advance(&a, due)
    assert(a.result == 0)
    write(&a, 0, 3, 3300000, true, 100)
    write(&a, 0, 0, 0, true, 101)
    assert(!a.enabled && !a.busy && !a.ready)
    advance(&a, 1000)
    assert(a.result == 0)

@test("virtual ADC: IRQ masking, sticky pending bits, write-one-to-clear and reset")
interrupts()
    var a = adc(1800000, 5)
    write(&a, 0, 3, 900000, true, 0)
    advance(&a, 5)
    assert(!irq(a) && a.pending == 1)
    write(&a, 16, 3, 0, true, 5)
    assert(irq(a))
    write(&a, 20, 2, 0, true, 5)
    assert(irq(a) && a.pending == 1)
    write(&a, 20, 1, 0, true, 5)
    assert(!irq(a) && a.ready)
    write(&a, 8, 2, 0, true, 5)
    assert(!a.ready)
    reset(&a)
    assert(a.reference_uv == 1800000 && a.cycles == 5 && a.result == 0 && !a.enabled && !irq(a))

@test("virtual ADC: every output code and half-step boundary rounds up deterministically")
all_codes()
    for code in 0u32..4095
        assert(quantize(code * 2, 8190) == code)
        assert(quantize(code * 2 + 1, 8190) == (if code == 4095 then code else code + 1))
        if code > 0 then assert(quantize(code * 2 - 1, 8190) == code)
