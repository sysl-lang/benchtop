module sh.sysl.benchtop.peripheral.adc

// An ideal, deterministic virtual ADC register model. Analogue sources are integer
// microvolts; a conversion latches its input at START, completes on guest time, and
// quantizes to the nearest 12-bit code, saturating at either endpoint.
struct Adc
    reference_uv: u32
    cycles: u64
    channel: u32
    enabled: bool
    busy: bool
    ready: bool
    error: bool
    result: u32
    sampled: u32
    due: u64
    mask: u32
    pending: u32

adc(reference_uv: u32 = 3300000, cycles: u64 = 32) -> Adc
    require reference_uv > 0 && cycles > 0, "positive ADC reference and conversion duration"
    Adc(reference_uv, cycles, 0, false, false, false, false, 0, 0, 0, 0, 0)

reset(a: *Adc)
    *a = adc(a.reference_uv, a.cycles)

advance(a: *Adc, time: u64)
    if !a.busy || time < a.due then return
    a.result = a.sampled
    a.busy = false
    a.ready = true
    a.pending |= 1

irq(a: Adc) -> bool = a.pending & a.mask != 0

quantize(uv: u32, reference: u32) -> u32
    require reference > 0, "nonzero reference"
    val voltage = if uv > reference then reference else uv
    u32((u64(voltage) * 4095 + u64(reference / 2)) / u64(reference))

/** The byte offset of the register called `name`, or `None` for a name the ADC does not have. */
register_offset(name: string) -> Option[u32] = name match
    "CTRL" -> Some(0)
    "CHANNEL" -> Some(4)
    "STATUS" -> Some(8)
    "RESULT" -> Some(12)
    "IRQ_ENABLE" -> Some(16)
    "IRQ_STATUS" -> Some(20)
    "VREF" -> Some(24)
    "RESOLUTION" -> Some(28)
    "CONVERSION_CYCLES" -> Some(32)
    _ -> None

read(a: Adc, offset: u32) -> Option[u32] = offset match
    0 -> Some(if a.enabled then 1 else 0)
    4 -> Some(a.channel)
    8 -> Some((if a.busy then 1 else 0) | (if a.ready then 2 else 0) | (if a.error then 4 else 0))
    12 -> Some(a.result)
    16 -> Some(a.mask)
    20 -> Some(a.pending)
    24 -> Some(a.reference_uv)
    28 -> Some(12)
    32 -> Some(u32(a.cycles))
    _ -> None

write(a: *Adc, offset: u32, value: u32, uv: u32, connected: bool, time: u64) -> bool
    advance(a, time)
    offset match
        0 ->
            a.enabled = value & 1 != 0
            if !a.enabled
                a.busy = false
                a.ready = false
            if value & 2 != 0
                if !a.enabled || a.busy || !connected
                    a.error = true
                    a.pending |= 2
                else
                    a.busy = true
                    a.ready = false
                    a.sampled = quantize(uv, a.reference_uv)
                    a.due = time + a.cycles
        4 -> a.channel = value
        8 ->
            if value & 2 != 0 then a.ready = false
            if value & 4 != 0 then a.error = false
        16 -> a.mask = value & 3
        20 -> a.pending &= ~(value & 3)
        12 | 24 | 28 | 32 -> () // Read-only registers ignore writes.
        _ -> return false
    true
