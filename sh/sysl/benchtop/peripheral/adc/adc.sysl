module sh.sysl.benchtop.peripheral.adc

import sh.sysl.benchtop.peripheral.Model
import sh.sysl.benchtop.timing.NEVER

// An ideal, deterministic virtual ADC register model. Analogue sources are integer
// microvolts; a conversion latches its input at START, completes on guest time, and
// quantizes to the nearest 12-bit code, saturating at either endpoint.
struct Adc
    reference_uv: u32
    cycles: u64
    channel: u32
    enabled: bool
    busy: bool
    ready: bool
    error: bool
    result: u32
    sampled: u32
    done_at: u64
    mask: u32
    pending: u32
    /** The analogue input: the level in microvolts on a channel, None where nothing drives it. Set
     * once by whoever puts the converter on a board; a reset keeps it.
     */
    input: &Fn(u32) -> Option[u32]

/** An input with nothing on any channel. */
private val no_input: &Fn(u32) -> Option[u32] = channel -> None

private fresh(reference_uv: u32, cycles: u64, input: &Fn(u32) -> Option[u32]) -> Adc =
    Adc(reference_uv, cycles, 0, false, false, false, false, 0, 0, 0, 0, 0, input)

adc(reference_uv: u32 = 3300000, cycles: u64 = 32, input: &Fn(u32) -> Option[u32] = no_input) -> Adc
    require reference_uv > 0 && cycles > 0, "positive ADC reference and conversion duration"
    fresh(reference_uv, cycles, input)

quantize(uv: u32, reference: u32) -> u32
    require reference > 0, "nonzero reference"
    val voltage = if uv > reference then reference else uv
    u32((u64(voltage) * 4095 + u64(reference / 2)) / u64(reference))

/** The byte offset of the register called `name`, or `None` for a name the ADC does not have. */
register_offset(name: string) -> Option[u32] = name match
    "CTRL" -> Some(0)
    "CHANNEL" -> Some(4)
    "STATUS" -> Some(8)
    "RESULT" -> Some(12)
    "IRQ_ENABLE" -> Some(16)
    "IRQ_STATUS" -> Some(20)
    "VREF" -> Some(24)
    "RESOLUTION" -> Some(28)
    "CONVERSION_CYCLES" -> Some(32)
    _ -> None

// Every register is a word; the bus checks the width before it reaches the converter.
impl Model for Adc
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32] = offset match
        0 -> Some(if self.enabled then 1 else 0)
        4 -> Some(self.channel)
        8 -> Some((if self.busy then 1 else 0) | (if self.ready then 2 else 0) | (if self.error then 4 else 0))
        12 -> Some(self.result)
        16 -> Some(self.mask)
        20 -> Some(self.pending)
        24 -> Some(self.reference_uv)
        28 -> Some(12)
        32 -> Some(u32(self.cycles))
        _ -> None

    write(*self, offset: u32, width: u32, value: u32, time: u64) -> bool
        self.advance(time)
        offset match
            0 ->
                self.enabled = value & 1 != 0
                if !self.enabled
                    self.busy = false
                    self.ready = false
                if value & 2 != 0
                    val level = (self.input)(self.channel)
                    if !self.enabled || self.busy || level.is_none()
                        self.error = true
                        self.pending |= 2
                    else
                        self.busy = true
                        self.ready = false
                        self.sampled = quantize(level.unwrap(), self.reference_uv)
                        self.done_at = time + self.cycles
            4 -> self.channel = value
            8 ->
                if value & 2 != 0 then self.ready = false
                if value & 4 != 0 then self.error = false
            16 -> self.mask = value & 3
            20 -> self.pending &= ~(value & 3)
            12 | 24 | 28 | 32 -> () // Read-only registers ignore writes.
            _ -> return false
        true

    override advance(*self, time: u64)
        if !self.busy || time < self.done_at then return
        self.result = self.sampled
        self.busy = false
        self.ready = true
        self.pending |= 1

    override due(*self) -> u64 = if self.busy then self.done_at else NEVER
    override irq(*self) -> bool = self.pending & self.mask != 0
    reset(*self) = *self = fresh(self.reference_uv, self.cycles, self.input)
