module sh.sysl.benchtop.peripheral.sdmmc

import sh.sysl.benchtop.parts.sd_card as card
import sh.sysl.benchtop.peripheral.ContextModel
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.stm32h747.sdmmc1 as reg

/** What the host has done, for tests and instruments; nothing in the model reads it back. */
struct Stats
    commands: u64
    transfers: u64
    blocks: u64
    buffer_completions: u64
    multi_transfers: u64
    double_transfers: u64

// Every flag SDMMC_ICR can clear: bits 0-11 and 21-28 of SDMMC_STAR.
const STATIC_FLAGS: u32 = reg.ICR_CCRCFAILC_MASK | reg.ICR_DCRCFAILC_MASK | reg.ICR_CTIMEOUTC_MASK |
    reg.ICR_DTIMEOUTC_MASK | reg.ICR_TXUNDERRC_MASK | reg.ICR_RXOVERRC_MASK | reg.ICR_CMDRENDC_MASK |
    reg.ICR_CMDSENTC_MASK | reg.ICR_DATAENDC_MASK | reg.ICR_DHOLDC_MASK | reg.ICR_DBCKENDC_MASK |
    reg.ICR_DABORTC_MASK | reg.ICR_BUSYD0ENDC_MASK | reg.ICR_SDIOITC_MASK | reg.ICR_ACKFAILC_MASK |
    reg.ICR_ACKTIMEOUTC_MASK | reg.ICR_VSWENDC_MASK | reg.ICR_CKSTOPC_MASK | reg.ICR_IDMATEC_MASK |
    reg.ICR_IDMABTCC_MASK
const DATA_ERRORS: u32 = reg.STAR_DCRCFAIL_MASK | reg.STAR_DTIMEOUT_MASK | reg.STAR_TXUNDERR_MASK |
    reg.STAR_RXOVERR_MASK | reg.STAR_IDMATE_MASK
// SDMMC_CLKCR bits the model accepts: the divider, power saving, a 1- or 4-bit bus (WIDBUS = 1, never
// the 8-bit 2), the clock edge and hardware flow control.
const CLKCR_WRITABLE: u32 = reg.CLKCR_CLKDIV_MASK | reg.CLKCR_PWRSAV_MASK | (1 << reg.CLKCR_WIDBUS_SHIFT) |
    reg.CLKCR_NEGEDGE_MASK | reg.CLKCR_HWFC_EN_MASK
const CMDR_WRITABLE: u32 = reg.CMDR_CMDINDEX_MASK | reg.CMDR_CMDTRANS_MASK | reg.CMDR_CMDSTOP_MASK |
    reg.CMDR_WAITRESP_MASK | reg.CMDR_CPSMEN_MASK
// SDMMC_DCTRL: what is kept (enable, direction, block size), and FIFORST, which is accepted and acts at once.
const DCTRL_KEPT: u32 = reg.DCTRL_DTEN_MASK | reg.DCTRL_DTDIR_MASK | reg.DCTRL_DBLOCKSIZE_MASK
const DCTRL_WRITABLE: u32 = DCTRL_KEPT | reg.DCTRL_FIFORST_MASK
// SDMMC_MASKR enables the model can raise. The SVD has no IDMATEIE; RM0399 puts it at bit 27, under
// STAR's IDMATE, as every enable sits under its flag.
const MASKR_WRITABLE: u32 = reg.MASKR_CCRCFAILIE_MASK | reg.MASKR_DCRCFAILIE_MASK | reg.MASKR_CTIMEOUTIE_MASK |
    reg.MASKR_DTIMEOUTIE_MASK | reg.MASKR_TXUNDERRIE_MASK | reg.MASKR_RXOVERRIE_MASK | reg.MASKR_CMDRENDIE_MASK |
    reg.MASKR_CMDSENTIE_MASK | reg.MASKR_DATAENDIE_MASK | reg.MASKR_DBCKENDIE_MASK | reg.MASKR_DABORTIE_MASK |
    reg.MASKR_BUSYD0ENDIE_MASK | reg.STAR_IDMATE_MASK | reg.MASKR_IDMABTCIE_MASK
const IDMACTRLR_WRITABLE: u32 = reg.IDMACTRLR_IDMAEN_MASK | reg.IDMACTRLR_IDMABMODE_MASK | reg.IDMACTRLR_IDMABACT_MASK
// SDMMC_POWER PWRCTRL: off (0) and on (3); the two power-cycle states in between are refused.
const POWER_ON: u32 = reg.POWER_PWRCTRL_MASK
// The IP identification word past the SVD's map (SDMMC_VERR on the STM32 parts that list it):
// major revision 1, minor 0.
const VERR_OFFSET: u32 = 0x3fc
const VERR: u32 = 0x10
// Every error bit of an SD R1 card status (ST's SDMMC_OCR_ERRORBITS): a reply carrying any of them
// starts no data transfer.
const CARD_STATUS_ERRORS: u32 = 0xfdffe008
// The SD commands that move a block: 17/18 read one or many, 24/25 write one or many; 12 stops.
const CMD_STOP: u32 = 12
const CMD_READ_MULTIPLE: u32 = 18
const CMD_WRITE_SINGLE: u32 = 24
const CMD_WRITE_MULTIPLE: u32 = 25
// SDMMC_CMDR WAITRESP and the card's reply kind share one encoding: 0 none, 1 short, 2 short without
// CRC, 3 long.
const RESPONSE_NONE: u32 = 0
const RESPONSE_SHORT: u32 = 1
const RESPONSE_SHORT_NO_CRC: u32 = 2
const RESPONSE_LONG: u32 = 3
// SDMMC_RESPCMDR after a long response: R2 carries no command index, and the field reads all ones.
const RESPCMD_LONG: u32 = reg.RESPCMDR_RESPCMD_MASK

// Timed native SD command/data paths. IDMA advances in <=32-byte wire bursts,
// so inactive buffers can be replaced while the other buffer is in flight.
//
// Divergences from the silicon (policy: docs/peripheral-models.md, "Unsupported writes"):
// - Writes the model cannot honour are refused (`write` answers false, a bus fault): reserved bits
//   in CLKCR, CMDR, DCTRL, MASKR, IDMACTRL and IDMABSIZE, a clock divider that stops the card
//   clock, nonzero ACKTIMER, a command while the CPSM is busy, and data/IDMA configuration while
//   a transfer is in flight.
// - The data path starts only after an R1 response without error bits (0xfdffe008). The real DPSM
//   does not inspect the response: where the card answers an error and sends no data, silicon
//   would start the DPSM and end in a data timeout, while this model never starts it.
//
// The IDMA's RAM answers from a context of type C, which every call that can reach it hands it.
struct Host[C]
    hz: u64
    kernel: u64
    power: u32
    clock: u32
    arg: u32
    command: u32
    response_command: u32
    response: [4]u32
    timer: u32
    length: u32
    control: u32
    remaining: u32
    flags: u32
    mask: u32
    idma: u32
    base: u32
    at: u64
    command_due: u64
    data_due: u64
    command_arg: u32
    data_write: bool
    timeout_due: u64
    base1: u32
    buffer_size: u32
    buffer_used: u32
    transferred: u32
    block_size: u32
    block_used: u32
    chunk: u32
    loaded: bool
    payload: [512]u8
    busy_due: u64
    stats: Stats
    wiring: Wiring[C]

/** What the host reaches outside itself, set once by whoever puts it on a board (`connect`). */
struct Wiring[C]
    /** The card on its bus, if any. */
    card: Option[&card.Native]
    /** Whether the card's lines reach the host on a bus of the given data lanes (1 or 4). */
    routed: &Fn(u32) -> bool
    /** The IDMA's RAM, given the context the call that reached it was handed: fill the bytes from an
     * address, and store them at one; each answers whether the whole view was RAM it could reach.
     * They see complete views; no host file is touched here.
     */
    read_ram: &Fn(*C,u32,[]u8) -> bool
    write_ram: &Fn(*C,u32,[]const u8) -> bool

/** No card, every line routed, and no RAM the IDMA can reach. */
unwired[C]() -> Wiring[C] = Wiring(None, lanes -> true, (ctx,address,out) -> false, (ctx,address,bytes) -> false)

/** A host at reset with the given clocks and wiring: every register zero and nothing due. The one
 * place the reset state is written; `host` boxes it and `reset` stores it over a live host.
 */
private fresh[C](hz: u64, kernel: u64, wiring: Wiring[C]) -> Host[C]
    var stats: Stats
    // hz, kernel; POWER, CLKCR, ARGR, CMDR, RESPCMDR, RESP1-4, DTIMER, DLENR, DCTRL, DCNTR, STAR, MASKR,
    // IDMACTRLR, IDMABASE0R; the clock, command and data deadlines, the latched argument and direction,
    // the data timeout, IDMABASE1R, IDMABSIZER; the transfer's progress and its block buffer; the
    // busy deadline.
    Host(hz, kernel, 0, 0, 0, 0, 0, [0;4], 0, 0, 0, 0, 0, 0, 0, 0,
        0, NEVER, NEVER, 0, false, NEVER, 0, 0,
        0, 0, 0, 0, 0, false, [0;512], NEVER, stats, wiring)

host[C](hz: u64 = 480000000, kernel: u64 = 60000000) -> &Host[C]
    require hz > 0 && kernel > 0 && kernel <= hz, "SDMMC timebase and kernel clock"
    fresh(hz,kernel,unwired())

impl[C] Host[C]
    /** Wire the host to its card, its routing and the RAM its IDMA moves. */
    connect(*self, wiring: Wiring[C]) = self.wiring = wiring
    /** SDMMC_CK, the card clock CLKCR sets. */
    clock_hz(*self) -> u64 = self.kernel / divisor(self.clock)
    /** SDMMC_STAR at `time`: the latched flags, the state machines' activity and the card's busy. */
    status(*self, time: u64) -> u32
        val busy = self.wiring.card match
            Some(c) -> card.native_busy(c,time)
            None -> false
        self.flags | (if self.command_due != NEVER then reg.STAR_CPSMACT_MASK else 0) |
            (if self.data_due != NEVER then reg.STAR_DPSMACT_MASK else 0) | reg.STAR_TXFIFOE_MASK | reg.STAR_RXFIFOE_MASK |
            (if busy then reg.STAR_BUSYD0_MASK else 0)

// The SDMMC_CK divider of a CLKCR word: CLKDIV 0 passes the kernel clock through, n divides it by 2n.
private divisor(clock: u32) -> u64
    val clkdiv = clock & reg.CLKCR_CLKDIV_MASK
    if clkdiv == 0 then 1 else 2 * u64(clkdiv)
// The data lanes the bus is set to: CLKCR WIDBUS 1 is a 4-bit bus, 0 a 1-bit one.
private lanes[C](h: *Host[C]) -> u32 = if (h.clock & reg.CLKCR_WIDBUS_MASK) >> reg.CLKCR_WIDBUS_SHIFT == 1 then 4 else 1
// IDMACTRLR IDMABMODE: the IDMA alternates between two buffers, IDMABACT naming the one in use.
private double_buffered[C](h: *Host[C]) -> bool = h.idma & reg.IDMACTRLR_IDMABMODE_MASK != 0
private ticks[C](h: *Host[C], clocks: u64) -> u64
    val rate = h.clock_hz()
    (clocks * h.hz + rate - 1) / rate
private retry[C](h: *Host[C], time: u64) -> u64 = time + (if h.hz < 10000 then 1u64 else h.hz / 10000)
private next_event[C](h: *Host[C]) -> u64
    var next = if h.command_due < h.data_due then h.command_due else h.data_due
    if h.busy_due < next then next = h.busy_due
    next
private abort_data[C](h: *Host[C], time: u64, flag: u32)
    h.flags |= flag
    h.data_due = NEVER
    if h.wiring.card.is_some() then card.native_abort(h.wiring.card.unwrap(),time)
private schedule[C](h: *Host[C], time: u64)
    var count = h.block_size - h.block_used
    if count > 32 then count = 32
    if count > h.remaining then count = h.remaining
    if double_buffered(h) && count > h.buffer_size - h.buffer_used then count = h.buffer_size - h.buffer_used
    h.chunk = count
    val wires = u64(lanes(h))
    val overhead = (if h.block_used == 0 then 8u64 else 0) + (if count == h.block_size - h.block_used then 18u64 else 0)
    h.data_due = time + ticks(h,(u64(count) * 8 + wires - 1) / wires + overhead)
    if h.timeout_due < h.data_due then h.data_due = h.timeout_due
// Whether a card is on the bus and its lines reach the host at the bus width set.
private reachable[C](h: *Host[C]) -> bool = h.wiring.card.is_some() && (h.wiring.routed)(lanes(h))
private finish_command[C](h: *Host[C], reached: bool, at: u64)
    h.command_due = NEVER
    h.stats.commands += 1
    if !reached
        h.flags |= reg.STAR_CTIMEOUT_MASK
        return
    val native = h.wiring.card.unwrap()
    val index = h.command & reg.CMDR_CMDINDEX_MASK
    if index == CMD_STOP || h.command & reg.CMDR_CMDSTOP_MASK != 0
        if h.data_due != NEVER then h.flags |= reg.STAR_DABORT_MASK
        h.data_due = NEVER
    val reply = card.native_command(native,index,h.command_arg,at)
    if !reply.present
        h.flags |= reg.STAR_CTIMEOUT_MASK
        return
    if reply.kind != card.NoResponse
        h.response = reply.words
        h.response_command = if reply.kind.reports_no_index() then RESPCMD_LONG else index
    val expected = (h.command & reg.CMDR_WAITRESP_MASK) >> reg.CMDR_WAITRESP_SHIFT
    if expected == RESPONSE_NONE then h.flags |= reg.STAR_CMDSENT_MASK
    elif expected == u32(reply.kind) || (expected == RESPONSE_SHORT_NO_CRC && reply.kind == card.Short) then h.flags |= reg.STAR_CMDREND_MASK
    else h.flags |= reg.STAR_CCRCFAIL_MASK
    if reply.data == card.NoTransfer || reply.words[0] & CARD_STATUS_ERRORS != 0 then return
    val writing = reply.data.writes()
    val multiple = reply.data.multiple()
    val length = reply.data.block_length()
    val block = 1u32 << ((h.control & reg.DCTRL_DBLOCKSIZE_MASK) >> reg.DCTRL_DBLOCKSIZE_SHIFT)
    val total = if block <= 512 then h.length / block * block else 0
    val count_ok = total >= length && (multiple || total == length)
    val to_card = h.control & reg.DCTRL_DTDIR_MASK == 0
    if h.data_due != NEVER || h.command & reg.CMDR_CMDTRANS_MASK == 0 || h.idma & reg.IDMACTRLR_IDMAEN_MASK == 0 ||
            to_card != writing || !count_ok || block != length || h.base & 3 != 0 ||
            (double_buffered(h) && (h.buffer_size == 0 || h.base1 & 3 != 0))
        abort_data(h,at,reg.STAR_IDMATE_MASK)
        return
    if native.width != lanes(h)
        abort_data(h,at,reg.STAR_DCRCFAIL_MASK)
        return
    h.data_write = writing
    h.remaining = total
    h.transferred = 0
    h.block_size = block
    h.block_used = 0
    h.buffer_used = 0
    h.loaded = false
    h.timeout_due = at + ticks(h,u64(h.timer))
    if multiple then h.stats.multi_transfers += 1
    if double_buffered(h) then h.stats.double_transfers += 1
    schedule(h,at)

// The host's events up to `time`, the IDMA's RAM answering from `ctx`. Whether the card is reached is
// settled once per call: nothing that routes it changes while the host runs.
private run[C](h: *Host[C], ctx: *C, time: u64)
    if time < h.at then return
    val reached = reachable(h)
    val c = h.wiring.card
    while next_event(h) <= time && next_event(h) != NEVER
        val at = next_event(h)
        if h.command_due == at
            finish_command(h,reached,at)
            continue
        if h.busy_due == at
            if c.is_some() && card.native_busy(c.unwrap(),at) then h.busy_due = retry(h,at)
            else
                h.busy_due = NEVER
                h.flags |= reg.STAR_BUSYD0END_MASK
            continue
        h.data_due = NEVER
        if at >= h.timeout_due
            abort_data(h,at,reg.STAR_DTIMEOUT_MASK)
            continue
        if !reached
            abort_data(h,at,reg.STAR_DTIMEOUT_MASK)
            continue
        val native = c.unwrap()
        if h.data_write && h.block_used == 0 && card.native_busy(native,at)
            h.data_due = if native.card.busy_until > at then native.card.busy_until else retry(h,at)
            if h.data_due > h.timeout_due then h.data_due = h.timeout_due
            continue
        if !h.data_write && !h.loaded
            if !card.native_read(native,h.payload[..<usize(h.block_size)])
                abort_data(h,at,reg.STAR_DCRCFAIL_MASK)
                continue
            h.loaded = true
        val base = if double_buffered(h) && h.idma & reg.IDMACTRLR_IDMABACT_MASK != 0 then h.base1 else h.base
        val offset = if double_buffered(h) then h.buffer_used else h.transferred
        val address = u64(base) + u64(offset)
        if address + u64(h.chunk) > 0x100000000
            abort_data(h,at,reg.STAR_IDMATE_MASK)
            continue
        val piece = h.payload[usize(h.block_used)..<usize(h.block_used + h.chunk)]
        val moved = if h.data_write then (h.wiring.read_ram)(ctx,u32(address),piece) else (h.wiring.write_ram)(ctx,u32(address),piece)
        if !moved
            abort_data(h,at,reg.STAR_IDMATE_MASK)
            continue
        h.block_used += h.chunk
        h.buffer_used += h.chunk
        h.transferred += h.chunk
        h.remaining -= h.chunk
        if double_buffered(h) && h.buffer_used == h.buffer_size
            h.idma ^= reg.IDMACTRLR_IDMABACT_MASK
            h.buffer_used = 0
            h.stats.buffer_completions += 1
            h.flags |= reg.STAR_IDMABTC_MASK
        if h.block_used == h.block_size
            if h.data_write
                if !card.native_write(native,h.payload[..<usize(h.block_size)],at)
                    abort_data(h,at,reg.STAR_DCRCFAIL_MASK)
                    continue
                h.busy_due = if native.card.busy_until > at then native.card.busy_until else retry(h,at)
            else card.native_read_complete(native)
            h.stats.blocks += 1
            h.flags |= reg.STAR_DBCKEND_MASK
            h.block_used = 0
            h.loaded = false
            h.timeout_due = at + ticks(h,u64(h.timer))
        if h.remaining == 0
            h.flags |= reg.STAR_DATAEND_MASK
            h.stats.transfers += 1
        else schedule(h,at)
    h.at = time

private read_register[C](h: *Host[C], offset: u32, time: u64) -> Option[u32] = offset match
    reg.POWER_OFFSET -> Some(h.power)
    reg.CLKCR_OFFSET -> Some(h.clock)
    reg.ARGR_OFFSET -> Some(h.arg)
    reg.CMDR_OFFSET -> Some(h.command)
    reg.RESPCMDR_OFFSET -> Some(h.response_command)
    reg.RESP1R_OFFSET | reg.RESP2R_OFFSET | reg.RESP3R_OFFSET | reg.RESP4R_OFFSET ->
        Some(h.response[usize((offset - reg.RESP1R_OFFSET) / 4)])
    reg.DTIMER_OFFSET -> Some(h.timer)
    reg.DLENR_OFFSET -> Some(h.length)
    reg.DCTRL_OFFSET -> Some(h.control)
    reg.DCNTR_OFFSET -> Some(h.remaining)
    reg.STAR_OFFSET -> Some(h.status(time))
    reg.ICR_OFFSET -> Some(0)
    reg.MASKR_OFFSET -> Some(h.mask)
    reg.ACKTIMER_OFFSET -> Some(0)
    reg.IDMACTRLR_OFFSET -> Some(h.idma)
    reg.IDMABSIZER_OFFSET -> Some(h.buffer_size)
    reg.IDMABASE0R_OFFSET -> Some(h.base)
    reg.IDMABASE1R_OFFSET -> Some(h.base1)
    VERR_OFFSET -> Some(VERR)
    _ -> None
private write_register[C](h: *Host[C], offset: u32, value: u32, time: u64) -> bool
    offset match
        reg.POWER_OFFSET ->
            if value != 0 && value != POWER_ON then return false
            h.power = value
            if value == 0
                h.command_due = NEVER
                h.data_due = NEVER
                h.busy_due = NEVER
                h.idma = 0
                h.remaining = 0
                h.flags = 0
        reg.CLKCR_OFFSET ->
            if value & ~CLKCR_WRITABLE != 0 || h.command_due != NEVER || h.data_due != NEVER then return false
            if h.kernel / divisor(value) == 0 then return false
            h.clock = value
        reg.ARGR_OFFSET -> h.arg = value
        reg.CMDR_OFFSET ->
            if value & ~CMDR_WRITABLE != 0 || h.command_due != NEVER then return false
            h.command = value
            if value & reg.CMDR_CPSMEN_MASK != 0
                if h.power != POWER_ON then return false
                h.command_arg = h.arg
                val response = (value & reg.CMDR_WAITRESP_MASK) >> reg.CMDR_WAITRESP_SHIFT
                h.command_due = time + ticks(h,48 + (if response == RESPONSE_NONE then 0u64 elif response == RESPONSE_LONG then 144 else 56))
        reg.DTIMER_OFFSET ->
            if h.data_due != NEVER then return false
            h.timer = value
        reg.DLENR_OFFSET ->
            if h.data_due != NEVER || value & ~reg.DLENR_DATALENGTH_MASK != 0 then return false
            h.length = value
        reg.DCTRL_OFFSET ->
            if h.data_due != NEVER || value & ~DCTRL_WRITABLE != 0 then return false
            h.control = value & DCTRL_KEPT
        reg.ICR_OFFSET -> h.flags &= ~(value & STATIC_FLAGS)
        reg.MASKR_OFFSET ->
            if value & ~MASKR_WRITABLE != 0 then return false
            h.mask = value
        reg.ACKTIMER_OFFSET -> if value != 0 then return false
        reg.IDMACTRLR_OFFSET ->
            if value & ~IDMACTRLR_WRITABLE != 0 || h.data_due != NEVER then return false
            h.idma = value
        reg.IDMABSIZER_OFFSET ->
            if h.data_due != NEVER || value & ~reg.IDMABSIZER_IDMABNDT_MASK != 0 then return false
            h.buffer_size = value
        reg.IDMABASE0R_OFFSET | reg.IDMABASE1R_OFFSET ->
            if h.data_due != NEVER
                val active = if h.idma & reg.IDMACTRLR_IDMABACT_MASK != 0 then reg.IDMABASE1R_OFFSET else reg.IDMABASE0R_OFFSET
                if !double_buffered(h) || offset == active then return false
            if offset == reg.IDMABASE0R_OFFSET then h.base = value else h.base1 = value
        _ -> return false
    true

// Every register is a word; the bus checks the width before it reaches the host.
impl[C] ContextModel[C] for Host[C]
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32] = read_register(self,offset,time)
    write(*self, ctx: *C, offset: u32, width: u32, value: u32, time: u64) -> bool = write_register(self,offset,value,time)
    // RAM callbacks validate complete views before accessing memory. Card/media callbacks see
    // sectors; no host filesystem calls execute on CPU workers.
    override advance(*self, ctx: *C, time: u64) = run(self,ctx,time)
    override due(*self) -> u64 = next_event(self)
    override irq(*self) -> bool = self.flags & self.mask != 0
    reset(*self) = *self = fresh(self.hz,self.kernel,self.wiring)
