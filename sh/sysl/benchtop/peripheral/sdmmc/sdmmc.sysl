module sh.sysl.benchtop.peripheral.sdmmc

import sh.sysl.benchtop.parts.sd_card as card

const NEVER: u64 = 0xffffffffffffffff
const STATIC_FLAGS: u32 = 0x1fe00fff
const IDMABTC: u32 = 1 << 28
const BUSYEND: u32 = 1 << 21

/** What the host has done, for tests and instruments; nothing in the model reads it back. */
struct Stats
    commands: u64
    transfers: u64
    blocks: u64
    buffer_completions: u64
    multi_transfers: u64
    double_transfers: u64

// Timed native SD command/data paths. IDMA advances in <=32-byte wire bursts,
// so inactive buffers can be replaced while the other buffer is in flight.
struct Host
    hz: u64
    kernel: u64
    power: u32
    clock: u32
    arg: u32
    command: u32
    response_command: u32
    response: [4]u32
    timer: u32
    length: u32
    control: u32
    remaining: u32
    flags: u32
    mask: u32
    idma: u32
    base: u32
    at: u64
    command_due: u64
    data_due: u64
    command_arg: u32
    data_write: bool
    timeout_due: u64
    base1: u32
    buffer_size: u32
    buffer_used: u32
    transferred: u32
    block_size: u32
    block_used: u32
    chunk: u32
    loaded: bool
    payload: [512]u8
    busy_due: u64
    stats: Stats

/** A host at reset with the given clocks: every register zero and nothing due. The one place the
 * reset state is written; `host` boxes it and `reset` stores it over a live host.
 */
private fresh(hz: u64, kernel: u64) -> Host
    var h: Host
    h.hz = hz
    h.kernel = kernel
    h.command_due = NEVER
    h.data_due = NEVER
    h.timeout_due = NEVER
    h.busy_due = NEVER
    h

host(hz: u64 = 480000000, kernel: u64 = 60000000) -> &Host
    require hz > 0 && kernel > 0 && kernel <= hz, "SDMMC timebase and kernel clock"
    fresh(hz,kernel)

reset(h: &Host) = *h = fresh(h.hz,h.kernel)
clock_hz(h: &Host) -> u64 = if h.clock & 1023 == 0 then h.kernel else h.kernel / (2 * u64(h.clock & 1023))
private ticks(h: &Host, clocks: u64) -> u64
    val rate = clock_hz(h)
    (clocks * h.hz + rate - 1) / rate
private retry(h: &Host, time: u64) -> u64 = time + (if h.hz < 10000 then 1u64 else h.hz / 10000)
irq(h: &Host) -> bool = h.flags & h.mask != 0
due(h: &Host) -> u64
    var next = if h.command_due < h.data_due then h.command_due else h.data_due
    if h.busy_due < next then next = h.busy_due
    next
status(h: &Host, c: Option[&card.Native], time: u64) -> u32
    val busy = c match
        Some(c) -> card.native_busy(c,time)
        None -> false
    h.flags | (if h.command_due != NEVER then 1u32 << 13 else 0) | (if h.data_due != NEVER then 1u32 << 12 else 0) |
        (1u32 << 18) | (1u32 << 19) | (if busy then 1u32 << 20 else 0)
private abort_data(h: &Host, c: Option[&card.Native], time: u64, flag: u32)
    h.flags |= flag
    h.data_due = NEVER
    if c.is_some() then card.native_abort(c.unwrap(),time)
private schedule(h: &Host, time: u64)
    var count = h.block_size - h.block_used
    if count > 32 then count = 32
    if count > h.remaining then count = h.remaining
    if h.idma & 2 != 0 && count > h.buffer_size - h.buffer_used then count = h.buffer_size - h.buffer_used
    h.chunk = count
    val lanes: u64 = if h.clock & 0xc000 == 0x4000 then 4 else 1
    val overhead = (if h.block_used == 0 then 8u64 else 0) + (if count == h.block_size - h.block_used then 18u64 else 0)
    h.data_due = time + ticks(h,(u64(count) * 8 + lanes - 1) / lanes + overhead)
    if h.timeout_due < h.data_due then h.data_due = h.timeout_due
private finish_command(h: &Host, c: Option[&card.Native], routed: bool, at: u64)
    h.command_due = NEVER
    h.stats.commands += 1
    if c.is_none() || !routed
        h.flags |= 4
        return
    val native = c.unwrap()
    val index = h.command & 63
    if index == 12 || h.command & 128 != 0
        if h.data_due != NEVER then h.flags |= 1 << 11
        h.data_due = NEVER
    val reply = card.native_command(native,index,h.command_arg,at)
    if !reply.present
        h.flags |= 4
        return
    if reply.kind != card.NoResponse
        h.response = reply.words
        h.response_command = if reply.kind.reports_no_index() then 63 else index
    val expected = (h.command >> 8) & 3
    if expected == 0 then h.flags |= 128
    elif expected == u32(reply.kind) || (expected == u32(card.ShortNoCrc) && reply.kind == card.Short) then h.flags |= 64
    else h.flags |= 1
    if reply.data == card.NoTransfer || reply.words[0] & 0xfdffe008 != 0 then return
    val writing = reply.data.writes()
    val multiple = reply.data.multiple()
    val length = reply.data.block_length()
    val block = 1u32 << ((h.control >> 4) & 15)
    val total = if block <= 512 then h.length / block * block else 0
    val count_ok = total >= length && (multiple || total == length)
    if h.data_due != NEVER || h.command & 64 == 0 || h.idma & 1 == 0 || ((h.control & 2 == 0) != writing) || !count_ok || block != length || h.base & 3 != 0 || (h.idma & 2 != 0 && (h.buffer_size == 0 || h.base1 & 3 != 0))
        abort_data(h,c,at,1 << 27)
        return
    val lanes: u32 = if h.clock & 0xc000 == 0x4000 then 4 else 1
    if native.width != lanes
        abort_data(h,c,at,2)
        return
    h.data_write = writing
    h.remaining = total
    h.transferred = 0
    h.block_size = block
    h.block_used = 0
    h.buffer_used = 0
    h.loaded = false
    h.timeout_due = at + ticks(h,u64(h.timer))
    if multiple then h.stats.multi_transfers += 1
    if h.idma & 2 != 0 then h.stats.double_transfers += 1
    schedule(h,at)

// RAM callbacks validate complete views before accessing memory. Card/media
// callbacks see sectors; no host filesystem calls execute on CPU workers.
advance(h: &Host, time: u64, c: Option[&card.Native], routed: bool,
        read_ram: &Fn(u32,[]u8) -> bool, write_ram: &Fn(u32,[]const u8) -> bool)
    if time < h.at then return
    while due(h) <= time && due(h) != NEVER
        val at = due(h)
        if h.command_due == at
            finish_command(h,c,routed,at)
            continue
        if h.busy_due == at
            if c.is_some() && card.native_busy(c.unwrap(),at) then h.busy_due = retry(h,at)
            else
                h.busy_due = NEVER
                h.flags |= BUSYEND
            continue
        h.data_due = NEVER
        if at >= h.timeout_due
            abort_data(h,c,at,8)
            continue
        if c.is_none() || !routed
            abort_data(h,c,at,8)
            continue
        val native = c.unwrap()
        if h.data_write && h.block_used == 0 && card.native_busy(native,at)
            h.data_due = if native.card.busy_until > at then native.card.busy_until else retry(h,at)
            if h.data_due > h.timeout_due then h.data_due = h.timeout_due
            continue
        if !h.data_write && !h.loaded
            if !card.native_read(native,h.payload[..<usize(h.block_size)])
                abort_data(h,c,at,2)
                continue
            h.loaded = true
        val base = if h.idma & 2 != 0 && h.idma & 4 != 0 then h.base1 else h.base
        val offset = if h.idma & 2 != 0 then h.buffer_used else h.transferred
        val address = u64(base) + u64(offset)
        if address + u64(h.chunk) > 0x100000000
            abort_data(h,c,at,1 << 27)
            continue
        val piece = h.payload[usize(h.block_used)..<usize(h.block_used + h.chunk)]
        val moved = if h.data_write then (read_ram)(u32(address),piece) else (write_ram)(u32(address),piece)
        if !moved
            abort_data(h,c,at,1 << 27)
            continue
        h.block_used += h.chunk
        h.buffer_used += h.chunk
        h.transferred += h.chunk
        h.remaining -= h.chunk
        if h.idma & 2 != 0 && h.buffer_used == h.buffer_size
            h.idma ^= 4
            h.buffer_used = 0
            h.stats.buffer_completions += 1
            h.flags |= IDMABTC
        if h.block_used == h.block_size
            if h.data_write
                if !card.native_write(native,h.payload[..<usize(h.block_size)],at)
                    abort_data(h,c,at,2)
                    continue
                h.busy_due = if native.card.busy_until > at then native.card.busy_until else retry(h,at)
            else card.native_read_complete(native)
            h.stats.blocks += 1
            h.flags |= 1024
            h.block_used = 0
            h.loaded = false
            h.timeout_due = at + ticks(h,u64(h.timer))
        if h.remaining == 0
            h.flags |= 256
            h.stats.transfers += 1
        else schedule(h,at)
    h.at = time

read(h: &Host, offset: u32, c: Option[&card.Native], time: u64) -> Option[u32] = offset match
    0 -> Some(h.power)
    4 -> Some(h.clock)
    8 -> Some(h.arg)
    12 -> Some(h.command)
    16 -> Some(h.response_command)
    20 | 24 | 28 | 32 -> Some(h.response[usize((offset - 20) / 4)])
    36 -> Some(h.timer)
    40 -> Some(h.length)
    44 -> Some(h.control)
    48 -> Some(h.remaining)
    52 -> Some(status(h,c,time))
    56 -> Some(0)
    60 -> Some(h.mask)
    64 -> Some(0)
    80 -> Some(h.idma)
    84 -> Some(h.buffer_size)
    88 -> Some(h.base)
    92 -> Some(h.base1)
    0x3fc -> Some(0x10)
    _ -> None
write(h: &Host, offset: u32, value: u32, time: u64) -> bool
    offset match
        0 ->
            if value != 0 && value != 3 then return false
            h.power = value
            if value == 0
                h.command_due = NEVER
                h.data_due = NEVER
                h.busy_due = NEVER
                h.idma = 0
                h.remaining = 0
                h.flags = 0
        4 ->
            if value & ~0x000353ffu32 != 0 || value & 0xc000 > 0x4000 || h.command_due != NEVER || h.data_due != NEVER then return false
            if h.kernel / (if value & 1023 == 0 then 1u64 else 2 * u64(value & 1023)) == 0 then return false
            h.clock = value
        8 -> h.arg = value
        12 ->
            if value & ~0x13ffu32 != 0 || h.command_due != NEVER then return false
            h.command = value
            if value & 4096 != 0
                if h.power != 3 then return false
                h.command_arg = h.arg
                val response = (value >> 8) & 3
                h.command_due = time + ticks(h,48 + (if response == 0 then 0u64 elif response == 3 then 144 else 56))
        36 ->
            if h.data_due != NEVER then return false
            h.timer = value
        40 ->
            if h.data_due != NEVER || value > 0x1ffffff then return false
            h.length = value
        44 ->
            if h.data_due != NEVER || value & ~0x20f3u32 != 0 then return false
            h.control = value & 0xf3
        56 -> h.flags &= ~(value & STATIC_FLAGS)
        60 ->
            if value & ~0x18200dffu32 != 0 then return false
            h.mask = value
        64 -> if value != 0 then return false
        80 ->
            if value > 7 || h.data_due != NEVER then return false
            h.idma = value
        84 ->
            if h.data_due != NEVER || value & ~0x1fe0u32 != 0 then return false
            h.buffer_size = value
        88 | 92 ->
            if h.data_due != NEVER
                val active = if h.idma & 4 != 0 then 92u32 else 88
                if h.idma & 2 == 0 || offset == active then return false
            if offset == 88 then h.base = value else h.base1 = value
        _ -> return false
    true
