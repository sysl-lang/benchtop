module sh.sysl.benchtop.peripheral.sdmmc
@tests
import sh.sysl.benchtop.parts.sd_card as card
import sh.sysl.benchtop.peripheral.ContextModel
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.stm32h747.sdmmc1.{STAR_BUSYD0END_MASK as BUSYEND, STAR_IDMABTC_MASK as IDMABTC}

private struct Trace
    memory: [16384]u8
    output: [4096]u8
    count: usize
    writes: u32
    last_write: u64
private trace() -> &Trace = Trace([0;16384],[0;4096],0,0,0)
private native_ready(media: card.Media) -> &card.Native
    val c = card.native(card.card(media,32768))
    c.state = card.Tran
    c.width = 4
    c
private configure_double(h: &Host[Bus],size: u32, length: u32, writing: bool, active1: bool = false, sector: u32 = 3)
    assert(h.write(&bus,0,4,3,0) && h.write(&bus,4,4,0x4002,0))
    assert(h.write(&bus,36,4,1000000,0) && h.write(&bus,40,4,length,0))
    assert(h.write(&bus,44,4,0x90 | (if writing then 0u32 else 2),0))
    assert(h.write(&bus,84,4,size,0))
    assert(h.write(&bus,88,4,0x24000000,0) && h.write(&bus,92,4,0x24001000,0))
    assert(h.write(&bus,80,4,if active1 then 7 else 3,0))
    assert(h.write(&bus,8,4,sector,0))
    assert(h.write(&bus,12,4,(if writing then 25u32 else 18) | 64 | 256 | 4096,0))
private val reject_read: &Fn(*Bus,u32,[]u8) -> bool = (ctx,address,out) -> false
private val reject_write: &Fn(*Bus,u32,[]const u8) -> bool = (ctx,address,bytes) -> false
// A host with card `c` routed to it and the IDMA's RAM.
private wire(h: &Host[Bus], c: &card.Native, read_ram: &Fn(*Bus,u32,[]u8) -> bool = reject_read, write_ram: &Fn(*Bus,u32,[]const u8) -> bool = reject_write) =
    h.connect(Wiring(Some(c),lanes -> true,read_ram,write_ram))

@test("SDMMC double buffer: sub-sector switches, live inactive-base replacement, active-base protection and IRQ acknowledgment")
double_receive()
    val t = trace()
    val c = native_ready(card.Media((sector,out) ->
        for i in 0..<out.len do out[i] = u8((usize(sector) * 512 + i) % 251)
        true,(sector,bytes) -> false,() -> true,() -> true))
    val h: &Host[Bus] = host()
    configure_double(h,256,1536,false)
    assert(h.write(&bus,60,4,IDMABTC,0))
    wire(h,c,write_ram = (ctx,address,bytes) ->
        val at = usize(address - 0x24000000)
        assert(at + bytes.len <= t.memory.len)
        for i in 0..<bytes.len do t.memory[at + i] = bytes[i]
        true)
    h.advance(&bus,h.due())
    assert(!h.write(&bus,88,4,0x24002000,h.at),"active buffer 0 must be protected")
    assert(!h.write(&bus,84,4,512,h.at) && !h.write(&bus,80,4,0,h.at))
    while h.data_due != NEVER
        h.advance(&bus,h.data_due)
        if h.flags & IDMABTC == 0 then continue
        assert(h.irq())
        val completed: u32 = if h.idma & 4 != 0 then 88 else 92
        val base = h.read(completed,4,h.at).unwrap()
        for i in 0usize..<256
            t.output[t.count] = t.memory[usize(base - 0x24000000) + i]
            t.count += 1
        if h.data_due != NEVER
            val replacement = if base < 0x24002000 then base + 0x2000 else base - 0x2000
            assert(h.write(&bus,completed,4,replacement,h.at),"the inactive base can be replaced while DPSM is running")
            val active = if completed == 88 then 92u32 else 88
            assert(!h.write(&bus,active,4,0,h.at))
        assert(h.write(&bus,56,4,IDMABTC,h.at))
        assert(!h.irq())
    assert(t.count == 1536 && h.stats.buffer_completions == 6 && h.stats.blocks == 3)
    for i in 0usize..<1536 do assert(t.output[i] == u8((i + 1536) % 251))
    assert(h.remaining == 0 && h.flags & 256 != 0 && h.idma & 4 == 0)
    assert(c.pending == card.ReadMultiple && c.state == card.Data,"a finite host length does not silently stop the card's multiblock command")
    assert(h.write(&bus,8,4,0,h.at) && h.write(&bus,12,4,12 | 128 | 256 | 4096,h.at))
    h.advance(&bus,h.due())
    assert(c.pending == card.NoTransfer && c.state == card.Tran)

@test("SDMMC double buffer: transmit refill while the other buffer is active, sector order and per-block programming busy")
double_transmit()
    val t = trace()
    val c = native_ready(card.Media((sector,out) -> false,(sector,bytes) ->
        assert(sector == 3 + t.writes)
        for i in 0..<bytes.len do assert(bytes[i] == u8(t.writes + 11))
        t.writes += 1
        true,() -> true,() -> true))
    val h: &Host[Bus] = host()
    configure_double(h,512,2048,true)
    for i in 0usize..<512
        t.memory[i] = 11
        t.memory[4096 + i] = 12
    wire(h,c,read_ram = (ctx,address,out) ->
        val at = usize(address - 0x24000000)
        for i in 0..<out.len do out[i] = t.memory[at + i]
        true)
    h.advance(&bus,h.due())
    var next: u8 = 13
    while h.data_due != NEVER
        val before = t.writes
        h.advance(&bus,h.data_due)
        if t.writes != before
            if before > 0 then assert(h.at >= t.last_write + c.card.program_ticks)
            t.last_write = h.at
        if h.flags & IDMABTC != 0
            val base = if h.idma & 4 != 0 then h.base else h.base1
            for i in 0usize..<512 do t.memory[usize(base - 0x24000000) + i] = next
            next += 1
            assert(h.write(&bus,56,4,IDMABTC,h.at))
    assert(t.writes == 4 && h.stats.buffer_completions == 4 && h.flags & 256 != 0)
    assert(c.pending == card.WriteMultiple && card.native_busy(c,h.at))
    assert(h.write(&bus,56,4,BUSYEND,h.at) && h.write(&bus,60,4,BUSYEND,h.at))
    assert(h.write(&bus,8,4,0,h.at) && h.write(&bus,12,4,12 | 128 | 256 | 4096,h.at))
    h.advance(&bus,h.command_due)
    while h.busy_due != NEVER do h.advance(&bus,h.busy_due)
    assert(c.state == card.Tran && c.pending == card.NoTransfer && h.irq() && h.flags & BUSYEND != 0)

@test("SDMMC double buffer: initial buffer 1, partial final buffer, CMD12 abort and payload prefixes")
partial_and_abort()
    val t = trace()
    val c = native_ready(card.Media((sector,out) ->
        for i in 0..<out.len do out[i] = u8(sector)
        true,(sector,bytes) -> false,() -> true,() -> true))
    val h: &Host[Bus] = host()
    wire(h,c,write_ram = (ctx,address,bytes) ->
        val at = usize(address - 0x24000000)
        for i in 0..<bytes.len do t.memory[at + i] = bytes[i]
        t.count += bytes.len
        true)
    configure_double(h,1024,1549,false,true)
    h.advance(&bus,h.due())
    while h.data_due != NEVER do h.advance(&bus,h.data_due)
    assert(h.stats.buffer_completions == 1 && h.idma & 4 == 0 && h.remaining == 0)
    assert(t.count == 1536 && h.transferred == 1536,"DLEN is truncated at a whole SD block")
    assert(t.memory[4096] == 3 && t.memory[4608] == 4 && t.memory[0] == 5)
    card.reset_native(c)
    c.state = card.Tran
    c.width = 4
    h.reset()
    t.count = 0
    configure_double(h,512,2048,false)
    h.advance(&bus,h.due())
    h.advance(&bus,h.data_due)
    assert(t.count == 32, "a reset keeps the IDMA's RAM")
    assert(h.write(&bus,8,4,0,h.at) && h.write(&bus,12,4,12 | 128 | 256 | 4096,h.at))
    while h.command_due != NEVER do h.advance(&bus,h.due())
    assert(h.data_due == NEVER && h.remaining > 0 && h.flags & (1 << 11) != 0 && h.flags & 256 == 0)
    assert(t.count >= 32 && t.count < 512 && c.pending == card.NoTransfer && c.state == card.Tran)
    val stopped = t.count
    h.advance(&bus,h.at + 1000000)
    assert(t.count == stopped,"stop must not continue DMA into a recycled buffer")

@test("SDMMC multiblock failure: completed prefix survives a later media error; errors never generate DATAEND")
block_error()
    val t = trace()
    val c = native_ready(card.Media((sector,out) ->
        if sector == 4 then return false
        for i in 0..<out.len do out[i] = 91
        true,(sector,bytes) -> false,() -> true,() -> true))
    val h: &Host[Bus] = host()
    wire(h,c,write_ram = (ctx,address,bytes) ->
        t.count += bytes.len
        true)
    configure_double(h,512,1024,false)
    assert(h.write(&bus,60,4,2,0))
    h.advance(&bus,h.due())
    while h.data_due != NEVER do h.advance(&bus,h.data_due)
    assert(t.count == 512 && h.remaining == 512 && h.flags & 2 != 0 && h.flags & 256 == 0 && h.irq())
    assert(c.pending == card.NoTransfer)
    h.reset()
    assert(!h.write(&bus,84,4,1,0) && !h.write(&bus,84,4,8192,0))

@test("SDMMC native range: a multiblock read at the final 2TiB sector cannot wrap to sector zero")
last_native_sector()
    val t = trace()
    val c = native_ready(card.Media((sector,out) ->
        assert(sector == 0xffffffff)
        for i in 0..<out.len do out[i] = 7
        true,(sector,bytes) -> false,() -> true,() -> true))
    c.card.sectors = 4294967296
    val h: &Host[Bus] = host()
    configure_double(h,512,1024,false,false,0xffffffff)
    wire(h,c,write_ram = (ctx,address,bytes) ->
        t.count += bytes.len
        true)
    h.advance(&bus,h.due())
    while h.data_due != NEVER do h.advance(&bus,h.data_due)
    assert(t.count == 512 && c.sector == 4294967296 && c.card.stats.reads == 1)
    assert(h.flags & 2 != 0 && h.flags & 256 == 0)
