module sh.sysl.benchtop.peripheral.sdmmc
@tests
import sh.sysl.benchtop.parts.sd_card as card

private struct Seen
    copied: bool
    accepted: bool
    bytes: usize

private model(media: card.Media) -> &card.Native
    val n = card.native(card.card(media,32768))
    n.state = 4
    n.width = 4
    n
private val empty_media = card.Media((sector,out) -> true,(sector,bytes) -> true,() -> true,() -> true)
private setup(h: &Host, reading: bool)
    assert(write(h,0,3,0))
    assert(write(h,4,0x4002,0))
    assert(write(h,36,1000000,0))
    assert(write(h,40,512,0))
    assert(write(h,44,0x90 | (if reading then 2u32 else 0),0))
    assert(write(h,88,0x24001000,0))
    assert(write(h,80,1,0))
    assert(write(h,8,3,0))
private val no_read: &Fn(u32,[]u8) -> bool = (address,bytes) -> false
private val no_write: &Fn(u32,[]const u8) -> bool = (address,bytes) -> false

@test("STM32 SDMMC: timed command/data completion, four-bit IDMA receive, register flags and W1C interrupts")
receive()
    val media = card.Media((sector,out) ->
        assert(sector == 3)
        for i in 0..<out.len do out[i] = u8(i * 13)
        true,
        (sector,bytes) -> false,() -> true,() -> true)
    val n = model(media)
    val h = host()
    setup(h,true)
    assert(clock_hz(h) == 15000000)
    assert(write(h,60,256,0))
    assert(write(h,12,17 | 64 | 256 | 4096,0))
    val command_end = due(h)
    val seen: &Seen = Seen(false,false,0)
    val copy: &Fn(u32,[]const u8) -> bool = (address,bytes) ->
        assert(address >= 0x24001000 && u64(address) + u64(bytes.len) <= 0x24001200)
        for i in 0..<bytes.len do assert(bytes[i] == u8((usize(address - 0x24001000) + i) * 13))
        seen.bytes += bytes.len
        seen.copied = true
        true
    advance(h,command_end - 1,Some(n),true,no_read,copy)
    assert(!seen.copied && status(h,Some(n),command_end - 1) & (1 << 13) != 0)
    advance(h,command_end,Some(n),true,no_read,copy)
    assert(h.response[0] == 0x900 && h.flags & 64 != 0 && h.remaining == 512 && !seen.copied)
    val data_end = due(h)
    assert(data_end > command_end && !irq(h))
    advance(h,data_end - 1,Some(n),true,no_read,copy)
    assert(!seen.copied)
    advance(h,data_end,Some(n),true,no_read,copy)
    assert(seen.copied && h.remaining == 480 && seen.bytes == 32)
    while h.data_due != NEVER do advance(h,h.data_due,Some(n),true,no_read,copy)
    assert(seen.copied && seen.bytes == 512 && h.remaining == 0 && h.idma == 1 && irq(h) && n.card.reads == 1)
    assert(h.flags & 1280 == 1280 && due(h) == NEVER)
    assert(write(h,56,256, data_end))
    assert(!irq(h) && h.flags & 1024 != 0)
    assert(!write(h,40,0x2000000,h.at))
    assert(!write(h,4,0x8002,data_end),"eight-bit card bus is explicitly unsupported")
    assert(read(h,0x80,Some(n),data_end).is_none(),"CPU FIFO path is explicitly unsupported")
    reset(h)
    assert(h.power == 0 && h.flags == 0 && due(h) == NEVER)

@test("STM32 SDMMC: IDMA transmit, programming busy, memory failure, data timeout and absent/routing failures")
errors()
    val seen: &Seen = Seen(false,false,0)
    val media = card.Media((sector,out) -> false,(sector,bytes) ->
        assert(sector == 3 && bytes[0] == 91 && bytes[511] == 91)
        seen.accepted = true
        true,() -> true,() -> true)
    val n = model(media)
    val h = host()
    setup(h,false)
    assert(write(h,12,24 | 64 | 256 | 4096,0))
    val read: &Fn(u32,[]u8) -> bool = (address,out) ->
        for i in 0..<out.len do out[i] = 91
        true
    advance(h,due(h),Some(n),true,read,no_write)
    while h.data_due != NEVER do advance(h,h.data_due,Some(n),true,read,no_write)
    val finish = h.at
    assert(seen.accepted && n.card.writes == 1 && status(h,Some(n),finish) & (1 << 20) != 0)
    assert(!card.native_busy(n,finish + n.card.program_ticks))
    for fault in 0..<5
        reset(h)
        card.reset_native(n)
        n.state = 4
        n.width = 4
        setup(h,true)
        if fault == 0 then assert(write(h,80,0,0))
        if fault == 1 then assert(write(h,36,1,0))
        if fault == 2 then assert(write(h,88,1,0))
        if fault == 3 then n.width = 1
        assert(write(h,12,17 | 64 | 256 | 4096,0))
        advance(h,due(h),Some(n),fault != 4,no_read,no_write)
        if due(h) != NEVER then advance(h,due(h),Some(n),true,no_read,no_write)
        val expected: u32 = if fault == 0 || fault == 2 then 1u32 << 27 elif fault == 1 then 8 elif fault == 3 then 2 else 4
        assert(h.flags & expected != 0,s"fault $fault flags=${h.flags}")
    reset(h)
    assert(write(h,0,3,0))
    assert(write(h,12,8 | 256 | 4096,0))
    advance(h,due(h),None,true,no_read,no_write)
    assert(h.flags & 4 != 0)

@test("STM32 SDMMC: OCR response has no CRC, commands are latched and power-off aborts pending work")
commands()
    val n = card.native(card.card(empty_media,32768))
    val h = host()
    assert(write(h,0,3,0) && write(h,4,75,0))
    assert(write(h,8,0,0) && write(h,12,55 | 256 | 4096,0))
    advance(h,due(h),Some(n),true,no_read,no_write)
    assert(write(h,56,STATIC_FLAGS,h.at))
    assert(write(h,8,0x40ff8000,h.at) && write(h,12,41 | 256 | 4096,h.at))
    assert(write(h,8,0,h.at),"ARG writes cannot change the already latched command")
    assert(!write(h,12,0,h.at),"active CPSM cannot be replaced")
    advance(h,due(h),Some(n),true,no_read,no_write)
    assert(h.response[0] == 0xc0ff8000 && h.flags & 1 != 0 && n.state == 1)
    assert(write(h,12,8 | 256 | 4096,h.at))
    assert(write(h,0,0,h.at))
    advance(h,h.at + 1000000,Some(n),true,no_read,no_write)
    assert(h.flags == 0 && due(h) == NEVER)
