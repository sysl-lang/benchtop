module sh.sysl.benchtop.peripheral.sdmmc
@tests
import sh.sysl.benchtop.parts.sd_card as card
import sh.sysl.benchtop.peripheral.ContextModel
import sh.sysl.benchtop.timing.NEVER
import sh.sysl.stm32h747.sdmmc1 as reg
import sysl.buf.{Buf,buf}

// The registers are written by name, as a driver writes them. The FIFO register has no SVD name.
private const FIFO_OFFSET: u32 = 0x80
// DCTRL's DBLOCKSIZE is log2 of the block length: 9 for 512 bytes.
private const BLOCK_512: u32 = 9 << reg.DCTRL_DBLOCKSIZE_SHIFT
// The IDMA buffer the tests transfer through.
private const BUFFER: u32 = 0x24001000
private const SECTOR: u32 = 3

private struct Seen
    copied: bool
    accepted: bool
    bytes: usize

private val empty_media = card.Media((sector,out) -> true,(sector,bytes) -> true,() -> true,() -> true)

/** The context the tests' hosts hand the IDMA's RAM: a name that tells one apart from another. Most
 * tests reach their RAM through what their callbacks capture and hand every call `bus`.
 */
private[sdmmc] struct Bus
    name: int

private[sdmmc] var bus = Bus(0)

// The wiring of a host with card `n` on a bus that is routed, and the IDMA's RAM.
private wired(n: Option[&card.Native], read_ram: &Fn(*Bus,u32,[]u8) -> bool = (ctx,address,out) -> false,
        write_ram: &Fn(*Bus,u32,[]const u8) -> bool = (ctx,address,bytes) -> false) -> Wiring[Bus] =
    Wiring(n, lanes -> true, read_ram, write_ram)

// CMDR for command `index`: its response kind (a WAITRESP value), whether it opens a data transfer,
// and CPSMEN.
private cmdr(index: u32, response: u32 = RESPONSE_SHORT, data: bool = false) -> u32 =
    index | response << reg.CMDR_WAITRESP_SHIFT | (if data then reg.CMDR_CMDTRANS_MASK else 0) | reg.CMDR_CPSMEN_MASK

// Sends command `index` with `arg` through the host, runs it to its response, clears the static
// flags it raised, and answers the response's first word.
private command(h: &Host[Bus], index: u32, arg: u32, response: u32 = RESPONSE_SHORT) -> u32
    assert(h.write(&bus,reg.ARGR_OFFSET,4,arg,h.at))
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(index,response),h.at))
    h.advance(&bus,h.due())
    val word = h.response[0]
    assert(h.write(&bus,reg.ICR_OFFSET,4,STATIC_FLAGS,h.at))
    word

// A host and a card on `media` brought from power-on to the transfer state by the commands a driver
// sends: CMD0, CMD8, ACMD41, CMD2, CMD3, CMD7, and ACMD6 for the four-bit bus where `wide`.
private ready_card(media: card.Media, wide: bool = true) -> (&card.Native, &Host[Bus])
    val n = card.native(card.card(media,32768))
    val h: &Host[Bus] = host()
    h.connect(wired(Some(n)))
    assert(h.write(&bus,reg.POWER_OFFSET,4,POWER_ON,0))
    command(h,0,0,RESPONSE_NONE)
    assert(command(h,8,0x1aa) == 0x1aa, "CMD8 echoes the check pattern")
    command(h,55,0)
    assert(command(h,41,0x40ff8000,RESPONSE_SHORT_NO_CRC) == 0xc0ff8000, "ACMD41 reports power-up done")
    command(h,2,0,RESPONSE_LONG)
    val rca = command(h,3,0) & 0xffff0000
    assert(rca != 0, "CMD3 publishes a relative address")
    command(h,7,rca)
    if wide
        command(h,55,rca)
        command(h,6,2)
    assert(n.state == card.Tran)
    assert(n.width == (if wide then 4 else 1))
    (n,h)

// The data path for one 512-byte block of sector SECTOR through IDMA at BUFFER, on a four-bit bus
// at the kernel clock over four.
private setup(h: &Host[Bus], reading: bool)
    assert(h.write(&bus,reg.CLKCR_OFFSET,4,1 << reg.CLKCR_WIDBUS_SHIFT | 2,h.at))
    assert(h.write(&bus,reg.DTIMER_OFFSET,4,1000000,h.at))
    assert(h.write(&bus,reg.DLENR_OFFSET,4,512,h.at))
    assert(h.write(&bus,reg.DCTRL_OFFSET,4,BLOCK_512 | (if reading then reg.DCTRL_DTDIR_MASK else 0),h.at))
    assert(h.write(&bus,reg.IDMABASE0R_OFFSET,4,BUFFER,h.at))
    assert(h.write(&bus,reg.IDMACTRLR_OFFSET,4,reg.IDMACTRLR_IDMAEN_MASK,h.at))
    assert(h.write(&bus,reg.ARGR_OFFSET,4,SECTOR,h.at))

@test("SDMMC bring-up: the host walks a card from power-on to the transfer state on a four-bit bus")
bring_up()
    val (n,h) = ready_card(empty_media)
    assert(n.rca != 0)
    assert(h.flags == 0, "every response was clean and its flags cleared")
    val (narrow,_) = ready_card(empty_media,wide = false)
    assert(narrow.width == 1, "without ACMD6 the card stays on one bit")

@test("STM32 SDMMC: timed command/data completion, four-bit IDMA receive, register flags and W1C interrupts")
receive()
    val media = card.Media((sector,out) ->
        assert(sector == SECTOR)
        for i in 0..<out.len do out[i] = u8.wrap(i * 13)
        true,
        (sector,bytes) -> false,() -> true,() -> true)
    val (n,h) = ready_card(media)
    val start = h.at
    setup(h,true)
    assert(h.clock_hz() == 15000000)
    assert(h.write(&bus,reg.MASKR_OFFSET,4,reg.MASKR_DATAENDIE_MASK,start))
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(17,data = true),start))
    val command_end = h.due()
    val seen: &Seen = Seen(false,false,0)
    h.connect(wired(Some(n),write_ram = (ctx,address,bytes) ->
        assert(address >= BUFFER && u64(address) + u64(bytes.len) <= u64(BUFFER) + 512)
        for i in 0..<bytes.len do assert(bytes[i] == u8.wrap((usize(address - BUFFER) + i) * 13))
        seen.bytes += bytes.len
        seen.copied = true
        true))
    h.advance(&bus,command_end - 1)
    assert(!seen.copied)
    assert(h.status(command_end - 1) & reg.STAR_CPSMACT_MASK != 0, "the command is still on the line")
    h.advance(&bus,command_end)
    assert(h.response[0] == 0x900, "R1: READY_FOR_DATA in Tran")
    assert(h.flags & reg.STAR_CMDREND_MASK != 0)
    assert(h.remaining == 512)
    assert(!seen.copied)
    val data_end = h.due()
    assert(data_end > command_end)
    assert(!h.irq())
    h.advance(&bus,data_end - 1)
    assert(!seen.copied)
    h.advance(&bus,data_end)
    assert(seen.copied)
    assert(h.remaining == 480, "one 32-byte IDMA beat")
    assert(seen.bytes == 32)
    while h.data_due != NEVER do h.advance(&bus,h.data_due)
    assert(seen.bytes == 512)
    assert(h.remaining == 0)
    assert(h.idma == reg.IDMACTRLR_IDMAEN_MASK)
    assert(h.irq(), "DATAEND is unmasked")
    assert(n.card.stats.reads == 1)
    assert(h.flags & reg.STAR_DATAEND_MASK != 0)
    assert(h.flags & reg.STAR_DBCKEND_MASK != 0)
    assert(h.due() == NEVER)
    assert(h.write(&bus,reg.ICR_OFFSET,4,reg.ICR_DATAENDC_MASK,data_end))
    assert(!h.irq(), "clearing DATAEND drops the interrupt")
    assert(h.flags & reg.STAR_DBCKEND_MASK != 0, "and only DATAEND")
    assert(!h.write(&bus,reg.DLENR_OFFSET,4,0x2000000,h.at), "DATALENGTH is 25 bits")
    assert(!h.write(&bus,reg.CLKCR_OFFSET,4,2 << reg.CLKCR_WIDBUS_SHIFT | 2,data_end),"eight-bit card bus is explicitly unsupported")
    assert(h.read(FIFO_OFFSET,4,data_end).is_none(),"CPU FIFO path is explicitly unsupported")
    h.reset()
    assert(h.power == 0)
    assert(h.flags == 0)
    assert(h.due() == NEVER)

@test("STM32 SDMMC: IDMA transmit, programming busy, memory failure, data timeout and absent/routing failures")
errors()
    val seen: &Seen = Seen(false,false,0)
    val media = card.Media((sector,out) -> false,(sector,bytes) ->
        assert(sector == SECTOR && bytes[0] == 91 && bytes[511] == 91)
        seen.accepted = true
        true,() -> true,() -> true)
    val (n,h) = ready_card(media)
    setup(h,false)
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(24,data = true),h.at))
    h.connect(wired(Some(n),read_ram = (ctx,address,out) ->
        for i in 0..<out.len do out[i] = 91
        true))
    h.advance(&bus,h.due())
    while h.data_due != NEVER do h.advance(&bus,h.data_due)
    val finish = h.at
    assert(seen.accepted)
    assert(n.card.stats.writes == 1)
    assert(h.status(finish) & reg.STAR_BUSYD0_MASK != 0, "the card holds D0 while it programs")
    assert(!card.native_busy(n,finish + n.card.program_ticks))
    // Each fault and the flag it raises: no IDMA, a one-tick data timer, an IDMA base outside RAM,
    // a card left on a one-bit bus, and a card not routed to the host.
    val faults = [("no IDMA",reg.STAR_IDMATE_MASK),("data timeout",reg.STAR_DTIMEOUT_MASK),
                  ("bad IDMA base",reg.STAR_IDMATE_MASK),("bus width",reg.STAR_DCRCFAIL_MASK),
                  ("unrouted",reg.STAR_CTIMEOUT_MASK)]
    for fault in 0..<5
        val (c,f) = ready_card(media,wide = fault != 3)
        setup(f,true)
        if fault == 0 then assert(f.write(&bus,reg.IDMACTRLR_OFFSET,4,0,f.at))
        if fault == 1 then assert(f.write(&bus,reg.DTIMER_OFFSET,4,1,f.at))
        if fault == 2 then assert(f.write(&bus,reg.IDMABASE0R_OFFSET,4,1,f.at))
        assert(f.write(&bus,reg.CMDR_OFFSET,4,cmdr(17,data = true),f.at))
        if fault == 4 then f.wiring.routed = lanes -> false
        f.advance(&bus,f.due())
        f.wiring.routed = lanes -> true
        if f.due() != NEVER then f.advance(&bus,f.due())
        val (name,expected) = faults[fault]
        assert(f.flags & expected != 0,s"$name: flags=${f.flags}")
    h.reset()
    h.connect(wired(None))
    assert(h.write(&bus,reg.POWER_OFFSET,4,POWER_ON,0))
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(8),0))
    h.advance(&bus,h.due())
    assert(h.flags & reg.STAR_CTIMEOUT_MASK != 0, "no card answers")

@test("STM32 SDMMC: OCR response has no CRC, commands are latched and power-off aborts pending work")
commands()
    val n = card.native(card.card(empty_media,32768))
    val h: &Host[Bus] = host()
    h.connect(wired(Some(n)))
    assert(h.write(&bus,reg.POWER_OFFSET,4,POWER_ON,0))
    assert(h.write(&bus,reg.CLKCR_OFFSET,4,75,0))
    assert(h.write(&bus,reg.ARGR_OFFSET,4,0,0))
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(55),0))
    h.advance(&bus,h.due())
    assert(h.write(&bus,reg.ICR_OFFSET,4,STATIC_FLAGS,h.at))
    assert(h.write(&bus,reg.ARGR_OFFSET,4,0x40ff8000,h.at))
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(41),h.at))
    assert(h.write(&bus,reg.ARGR_OFFSET,4,0,h.at),"ARG writes cannot change the already latched command")
    assert(!h.write(&bus,reg.CMDR_OFFSET,4,0,h.at),"active CPSM cannot be replaced")
    h.advance(&bus,h.due())
    assert(h.response[0] == 0xc0ff8000, "the latched argument reached the card")
    assert(h.flags & reg.STAR_CCRCFAIL_MASK != 0, "R3 has no CRC, so a short-with-CRC wait flags it")
    assert(n.state == card.Ready)
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(8),h.at))
    assert(h.write(&bus,reg.POWER_OFFSET,4,0,h.at))
    h.advance(&bus,h.at + 1000000)
    assert(h.flags == 0)
    assert(h.due() == NEVER)

@test("STM32 SDMMC: the host's wiring is set once, kept by a reset, and asked for the lanes the bus uses")
wiring()
    val n = card.native(card.card(empty_media,32768))
    val h: &Host[Bus] = host()
    assert(h.wiring.card.is_none(), "a new host has no card")
    val asked: Buf[u32] = buf()
    h.connect(Wiring(Some(n),lanes ->
        asked.push(lanes)
        true,(ctx,address,out) -> false,(ctx,address,bytes) -> false))
    assert(h.write(&bus,reg.POWER_OFFSET,4,POWER_ON,0))
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(0,RESPONSE_NONE),0))
    h.advance(&bus,h.due())
    assert(asked.len() == 1 && asked[0] == 1, "a one-bit bus asks for one lane")
    h.reset()
    assert(h.wiring.card.is_some(), "a reset keeps the card")
    assert(h.write(&bus,reg.POWER_OFFSET,4,POWER_ON,0))
    assert(h.write(&bus,reg.CLKCR_OFFSET,4,1 << reg.CLKCR_WIDBUS_SHIFT | 2,0))
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(0,RESPONSE_NONE),0))
    h.advance(&bus,h.due())
    assert(asked.len() == 2 && asked[1] == 4, "a reset keeps the routing, asked for a four-bit bus")
    assert(h.flags & reg.STAR_CMDSENT_MASK != 0, "the routed card took the command")
    // A host reached through the trait, as a board's glue may hold it.
    val model: &ContextModel[Bus] = h
    assert(model.due() == NEVER && !model.irq())
    assert(model.read(reg.CLKCR_OFFSET,4,0).unwrap() == 1 << reg.CLKCR_WIDBUS_SHIFT | 2)
    assert(!model.write(&bus,reg.CLKCR_OFFSET,4,2 << reg.CLKCR_WIDBUS_SHIFT | 2,0))

@test("STM32 SDMMC: the IDMA's RAM answers from the context each advance hands it, not from one it kept")
context_per_call()
    val (n,h) = ready_card(empty_media)
    setup(h,true)
    assert(h.write(&bus,reg.CMDR_OFFSET,4,cmdr(17,data = true),h.at))
    val names: Buf[int] = buf()
    h.connect(wired(Some(n),write_ram = (ctx,address,bytes) ->
        names.push(ctx.name)
        true))
    var first = Bus(1)
    var second = Bus(2)
    h.advance(&second,h.due())
    assert(names.len() == 0, "the command's response moves no data")
    h.advance(&first,h.due())
    h.advance(&second,h.due())
    while h.data_due != NEVER do h.advance(&first,h.data_due)
    assert(names.len() == 16, "sixteen 32-byte beats")
    assert(names[0] == 1 && names[1] == 2, "each beat reached the context its advance was handed")
    for i in 2..<16 do assert(names[i] == 1)
