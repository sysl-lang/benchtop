module sh.sysl.benchtop.peripheral.pwm
@tests

import sh.sysl.benchtop.peripheral.Model

@test("PWM: phase, duty boundaries, enable, wrap and register semantics are deterministic")
pwm_edges()
    var p = pwm()
    assert(!level(p, 0))
    assert(p.write(4, 4, 10, 100))
    assert(p.write(8, 4, 4, 100))
    assert(p.write(0, 4, 1, 100))
    assert(level(p, 100) && level(p, 103) && !level(p, 104) && !level(p, 109) && level(p, 110))
    assert(counter(p, 123) == 3 && p.read(12, 4, 123) == Some(3u32))
    p.write(0, 4, 1, 123)
    assert(p.origin == 100, "an unchanged enable does not retrigger phase")
    p.write(0, 4, 3, 123)
    assert(p.origin == 123 && counter(p, 123) == 0)
    p.write(8, 4, 1000, 124)
    assert(p.high == 10 && level(p, 999))
    p.write(8, 4, 0, 124)
    assert(!level(p, 125))
    p.write(4, 4, 0, 126)
    assert(p.period == 1)
    p.write(0, 4, 0, 127)
    assert(!level(p, 127) && counter(p, 200) == 0)
    assert(p.read(16, 4, 0) == Some(5u32) && p.read(20, 4, 0) == Some(12000000u32))
    assert(p.read(24, 4, 0).is_none() && !p.write(24, 4, 1, 0))
    p.reset()
    assert(!p.enabled && p.period == 12000 && p.high == 6000)
    assert(p.hz == 12000000 && p.pin == 5, "a reset keeps the clock and the pad")
