module sh.sysl.benchtop.peripheral.pwm

import sh.sysl.benchtop.peripheral.Model

/** One reusable PWM channel. Period/high time are guest cycles; enable selects its output pad. */
struct Pwm
    hz: u64
    pin: int
    enabled: bool
    period: u32
    high: u32
    origin: u64

pwm(hz: u64 = 12000000, pin: int = 5) -> Pwm
    require hz >= 48000 && hz <= 1000000000 && pin >= 0 && pin < 32, "valid PWM clock and output"
    Pwm(hz, pin, false, 12000, 6000, 0)

counter(p: Pwm, time: u64) -> u32 = if !p.enabled || time < p.origin then 0 else u32((time - p.origin) % u64(p.period))
level(p: Pwm, time: u64) -> bool = p.enabled && counter(p, time) < p.high

// The output is a function of time, read off at an access or by whoever samples the pad; the channel
// has no events of its own. Every register is a word, which the bus checks.
impl Model for Pwm
    read(*self, offset: u32, width: u32, time: u64) -> Option[u32] = offset match
        0 -> Some(if self.enabled then 1 else 0)
        4 -> Some(self.period)
        8 -> Some(self.high)
        12 -> Some(counter(*self, time))
        16 -> Some(u32(self.pin))
        20 -> Some(u32(self.hz))
        _ -> None

    write(*self, offset: u32, width: u32, value: u32, time: u64) -> bool
        offset match
            0 ->
                val enabled = value & 1 != 0
                if (enabled && !self.enabled) || value & 2 != 0 then self.origin = time
                self.enabled = enabled
            4 ->
                self.period = if value == 0 then 1 else value
                if self.high > self.period then self.high = self.period
                self.origin = time
            8 -> self.high = if value > self.period then self.period else value
            12 | 16 | 20 -> ()
            _ -> return false
        true

    reset(*self) = *self = pwm(self.hz, self.pin)
