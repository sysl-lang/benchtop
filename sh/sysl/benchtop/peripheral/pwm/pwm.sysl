module sh.sysl.benchtop.peripheral.pwm

/** One reusable PWM channel. Period/high time are guest cycles; enable selects its output pad. */
struct Pwm
    hz: u64
    pin: int
    enabled: bool
    period: u32
    high: u32
    origin: u64

pwm(hz: u64 = 12000000, pin: int = 5) -> Pwm
    require hz >= 48000 && hz <= 1000000000 && pin >= 0 && pin < 32, "valid PWM clock and output"
    Pwm(hz, pin, false, 12000, 6000, 0)

reset(p: *Pwm)
    *p = pwm(p.hz, p.pin)

counter(p: Pwm, time: u64) -> u32 = if !p.enabled || time < p.origin then 0 else u32((time - p.origin) % u64(p.period))
level(p: Pwm, time: u64) -> bool = p.enabled && counter(p, time) < p.high

read(p: Pwm, offset: u32, time: u64) -> Option[u32] = offset match
    0 -> Some(if p.enabled then 1 else 0)
    4 -> Some(p.period)
    8 -> Some(p.high)
    12 -> Some(counter(p, time))
    16 -> Some(u32(p.pin))
    20 -> Some(u32(p.hz))
    _ -> None

write(p: *Pwm, offset: u32, value: u32, time: u64) -> bool
    offset match
        0 ->
            val enabled = (value & 1) != 0
            if (enabled && !p.enabled) || (value & 2) != 0 then p.origin = time
            p.enabled = enabled
        4 ->
            p.period = if value == 0 then 1 else value
            if p.high > p.period then p.high = p.period
            p.origin = time
        8 -> p.high = if value > p.period then p.period else value
        12 | 16 | 20 -> ()
        _ -> return false
    true
