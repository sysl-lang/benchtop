module sh.sysl.benchtop.peripheral.rp2040
@tests

import sh.sysl.rp2040.{timer as tm, resets as rs, sio, watchdog as wd}

@test("RP2040 resets power up held, await completion, mask reserved bits and clear handshakes on reassertion")
resets_handshake()
    var r = resets()
    assert(r.read(rs.RESET_OFFSET, 4).unwrap() == 0x01FFFFFF)
    assert(r.read(rs.WDSEL_OFFSET, 4).unwrap() == 0 && r.read(rs.RESET_DONE_OFFSET, 4).unwrap() == 0)
    r.complete(0xFFFFFFFF)
    assert(r.done == 0, "held devices cannot complete")
    r.write(0x3000 + rs.RESET_OFFSET, 4, rs.RESET_TIMER_MASK).unwrap()
    assert(r.held == 0x01DFFFFF && r.done == 0, "release awaits device handshake")
    r.complete(rs.RESET_TIMER_MASK | rs.RESET_UART0_MASK)
    assert(r.done == rs.RESET_TIMER_MASK, "only released device reports ready")
    r.write(0x2000 + rs.RESET_OFFSET, 4, rs.RESET_TIMER_MASK).unwrap()
    assert(r.done == 0 && r.held == 0x01FFFFFF, "reset assertion clears readiness")
    r.write(rs.RESET_DONE_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(r.done == 0, "RESET_DONE is read-only")
    r.write(rs.WDSEL_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(r.watchdog == 0x01FFFFFF, "reserved bits masked")
    r.reset()
    assert(r.held == 0x01FFFFFF && r.watchdog == 0 && r.done == 0, "repeat reset restores everything")
end resets_handshake

@test("RP2040 atomic aliases and narrow bus access operate on the whole word without partial writes")
rp_bus_access()
    var r = resets()
    r.write(rs.WDSEL_OFFSET, 4, 0x12345678).unwrap()
    assert(r.read(rs.WDSEL_OFFSET, 4).unwrap() == 0x00345678)
    for lane in 0u32..<4
        assert(r.read(rs.WDSEL_OFFSET + lane, 1).unwrap() == (0x00345678 >> (8 * lane)) & 255)
        assert(r.read(0x1000 + rs.WDSEL_OFFSET + lane, 1).unwrap() == (0x00345678 >> (8 * lane)) & 255, "read aliases are mirrors")
    r.write(rs.WDSEL_OFFSET + 3, 1, 0xA5).unwrap()
    assert(r.watchdog == 0x01A5A5A5, "byte repeated on all four lanes")
    r.write(rs.WDSEL_OFFSET + 2, 2, 0x1234).unwrap()
    assert(r.watchdog == 0x00341234, "halfword repeated")
    r.write(0x1000 + rs.WDSEL_OFFSET, 4, 0xFF).unwrap()
    assert(r.watchdog == 0x003412CB)
    r.write(0x2000 + rs.WDSEL_OFFSET, 4, 0xF000).unwrap()
    assert(r.watchdog == 0x0034F2CB)
    r.write(0x3000 + rs.WDSEL_OFFSET, 4, 0xFF00).unwrap()
    assert(r.watchdog == 0x003400CB)
end rp_bus_access

@test("RP2040 timer low/high writes commit together and a shared read latch survives raw reads and counter rollover")
timer_latches()
    var t = timer()
    assert(t.read(tm.DBGPAUSE_OFFSET, 4).unwrap() == 6 && t.read(tm.PAUSE_OFFSET, 4).unwrap() == 0)
    t.write(tm.TIMELW_OFFSET, 4, 0xFFFFFFFE).unwrap()
    assert(t.value == 0 && t.read(tm.TIMELW_OFFSET, 4).unwrap() == 0, "low write stages; write-only reads zero")
    t.write(tm.TIMEHW_OFFSET, 4, 7).unwrap()
    assert(t.value == 0x00000007FFFFFFFE)
    assert(t.read(tm.TIMELR_OFFSET, 4).unwrap() == 0xFFFFFFFE)
    t.advance(3, 0)
    assert(t.read(tm.TIMERAWH_OFFSET, 4).unwrap() == 8 && t.read(tm.TIMERAWL_OFFSET, 4).unwrap() == 1)
    assert(t.read(tm.TIMEHR_OFFSET, 4).unwrap() == 7, "high word remains latched")
    assert(t.read(tm.TIMELR_OFFSET, 4).unwrap() == 1 && t.read(tm.TIMEHR_OFFSET, 4).unwrap() == 8, "any core's low read replaces the one hardware latch")
    t.write(tm.TIMEHR_OFFSET, 4, 99).unwrap()
    t.write(tm.TIMERAWL_OFFSET, 4, 99).unwrap()
    assert(t.value == 0x0000000800000001 && t.high_read == 8, "read-only writes ignored")
end timer_latches

@test("RP2040 timer alarms disarm on match, retain raw status while masked, and expose independent force and enable masks")
timer_alarm_irqs()
    var t = timer()
    for i in 0u32..<4 do t.write(tm.ALARM0_OFFSET + 4 * i, 4, i + 1).unwrap()
    assert(t.armed == 15 && t.next_alarm(0).unwrap() == 1)
    t.advance(3, 0)
    assert(t.value == 3 && t.raw == 7 && t.armed == 8 && t.irqs() == 0)
    t.write(tm.INTE_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(t.irqs() == 7 && t.enable == 15)
    t.write(tm.INTR_OFFSET, 4, 2).unwrap()
    assert(t.raw == 5 && t.irqs() == 5, "raw status is write-one-to-clear")
    t.write(tm.INTF_OFFSET, 4, 0xFFFFFFFA).unwrap()
    t.write(tm.INTE_OFFSET, 4, 0).unwrap()
    assert(t.force == 10 && t.irqs() == 10, "forced IRQ bypasses enable")
    t.write(tm.INTR_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(t.irqs() == 10, "clearing raw cannot clear force")
    t.write(0x3000 + tm.INTF_OFFSET, 4, 10).unwrap()
    t.write(tm.INTS_OFFSET, 4, 15).unwrap()
    assert(t.irqs() == 0, "INTS is read-only")
    t.advance(1, 0)
    assert(t.raw == 8 && t.armed == 0 && t.next_alarm(0).is_none())
    t.write(0x2000 + tm.INTE_OFFSET, 4, 8).unwrap()
    assert(t.irqs() == 8 && t.read(tm.INTS_OFFSET, 4).unwrap() == 8)
end timer_alarm_irqs

@test("RP2040 alarms handle equality, past deadlines, rearming, cancellation, long skips and 64-bit wrap")
timer_alarm_wrap()
    var t = timer()
    t.write(tm.TIMELW_OFFSET, 4, 0xFFFFFFFE).unwrap()
    t.write(tm.TIMEHW_OFFSET, 4, 0xFFFFFFFF).unwrap()
    t.write(tm.ALARM0_OFFSET, 4, 1).unwrap()
    assert(t.next_alarm(0).unwrap() == 3)
    t.advance(2, 0)
    assert(t.value == 0 && t.raw == 0 && t.armed == 1)
    t.advance(1, 0)
    assert(t.value == 1 && t.raw == 1 && t.armed == 0)
    t.write(tm.INTR_OFFSET, 4, 1).unwrap()
    t.write(tm.ALARM0_OFFSET, 4, 1).unwrap()
    assert(t.raw == 1 && t.armed == 0, "equal comparator matches immediately")
    t.write(tm.ALARM0_OFFSET, 4, 0).unwrap()
    assert(t.next_alarm(0).unwrap() == 0xFFFFFFFF, "past alarm waits for low word to wrap")
    t.write(tm.ALARM0_OFFSET + 4, 4, 9).unwrap()
    t.write(tm.ARMED_OFFSET, 4, 2).unwrap()
    assert(t.armed == 1, "cancel only selected alarm")
    t.advance(0x200000000, 0)
    assert(t.armed == 0 && t.raw == 1, "large skip still finds match")
    t.write(tm.ALARM0_OFFSET, 4, 100).unwrap()
    t.write(tm.ALARM0_OFFSET, 4, 50).unwrap()
    assert(t.next_alarm(0).unwrap() == 49, "rewrite replaces armed deadline")
end timer_alarm_wrap

@test("RP2040 timer pauses on software or selected debug ports, with no progress from an absent watchdog tick")
timer_pause()
    var t = timer()
    t.write(tm.ALARM0_OFFSET, 4, 5).unwrap()
    t.advance(0, 0)
    assert(t.value == 0 && t.raw == 0)
    for halted in [u32(1), u32(2), u32(3)]
        t.advance(1000, halted)
        assert(t.value == 0 && t.next_alarm(halted).is_none())
    t.write(0x3000 + tm.DBGPAUSE_OFFSET, 4, 2).unwrap()
    t.advance(1, 1)
    assert(t.value == 1, "unselected debug port does not pause")
    t.advance(100, 2)
    assert(t.value == 1)
    t.write(0x2000 + tm.PAUSE_OFFSET, 4, 1).unwrap()
    t.advance(1000, 0)
    assert(t.value == 1 && t.next_alarm(0).is_none())
    t.write(tm.PAUSE_OFFSET, 4, 0).unwrap()
    t.advance(4, 0)
    assert(t.value == 5 && t.raw == 1)
    t.reset()
    assert(t.value == 0 && t.low_write == 0 && t.high_read == 0 && t.armed == 0 && t.raw == 0 && t.enable == 0 && t.force == 0 && t.debug_pause == 6 && !t.pause)
    for alarm in t.alarms do assert(alarm == 0)
end timer_pause

@test("RP2040 time writes compare at the new value without treating a discontinuous write as elapsed ticks")
timer_time_jump()
    var t = timer()
    t.write(tm.ALARM0_OFFSET, 4, 5).unwrap()
    t.write(tm.TIMELW_OFFSET, 4, 10).unwrap()
    t.write(tm.TIMEHW_OFFSET, 4, 0).unwrap()
    assert(t.raw == 0 && t.armed == 1)
    t.write(tm.TIMELW_OFFSET, 4, 5).unwrap()
    t.write(tm.TIMEHW_OFFSET, 4, 0).unwrap()
    assert(t.raw == 1 && t.armed == 0)
end timer_time_jump

@test("RP2040 divider finishes at exactly eight input clocks, restarts on either operand and shares signed/unsigned operands")
divider_timing()
    var d = divider()
    assert(d.read(sio.DIV_CSR_OFFSET, 4).unwrap() == 1)
    d.write(sio.DIV_UDIVIDEND_OFFSET, 4, 23).unwrap()
    d.write(sio.DIV_UDIVISOR_OFFSET, 4, 5).unwrap()
    d.advance(7)
    assert(d.read(sio.DIV_CSR_OFFSET, 4).unwrap() == 2, "dirty and busy")
    d.advance(1)
    assert(d.read(sio.DIV_CSR_OFFSET, 4).unwrap() == 3)
    assert(d.read(sio.DIV_REMAINDER_OFFSET, 4).unwrap() == 3 && d.dirty)
    assert(d.read(sio.DIV_QUOTIENT_OFFSET, 4).unwrap() == 4 && !d.dirty)
    d.write(sio.DIV_SDIVIDEND_OFFSET, 4, 0xFFFFFFE9).unwrap()
    d.advance(7)
    d.write(sio.DIV_UDIVISOR_OFFSET, 4, 2).unwrap()
    d.advance(1)
    assert(d.remaining == 7 && !d.signed, "last operand alias chooses signedness and restarts timing")
    d.advance(7)
    assert(d.quotient == 0x7FFFFFF4 && d.remainder == 1)
    d.write(sio.DIV_SDIVISOR_OFFSET, 4, 5).unwrap()
    d.advance(8)
    assert(d.quotient == 0xFFFFFFFC && d.remainder == 0xFFFFFFFD)
    assert(d.read(sio.DIV_UDIVIDEND_OFFSET, 4).unwrap() == d.read(sio.DIV_SDIVIDEND_OFFSET, 4).unwrap())
end divider_timing

@test("RP2040 divider preserves result writes, clears DIRTY only on quotient reads, ignores CSR writes and keeps instances separate")
divider_context()
    var a = divider()
    var b = divider()
    a.write(sio.DIV_UDIVIDEND_OFFSET, 4, 1).unwrap()
    a.write(sio.DIV_QUOTIENT_OFFSET, 4, 0x12345678).unwrap()
    a.advance(100)
    assert(a.quotient == 0x12345678 && a.remaining == 0 && a.dirty)
    a.write(sio.DIV_REMAINDER_OFFSET, 4, 0x87654321).unwrap()
    a.write(sio.DIV_CSR_OFFSET, 4, 0).unwrap()
    assert(a.dirty && a.remaining == 0 && a.remainder == 0x87654321)
    assert(a.read(sio.DIV_QUOTIENT_OFFSET + 1, 1).unwrap() == 0x56 && !a.dirty, "even narrow quotient reads have the read side effect")
    assert(b.quotient == 0 && b.remainder == 0 && !b.dirty, "core-local state")
    a.reset()
    assert(a.dividend == 0 && a.divisor == 0 && a.quotient == 0 && a.remainder == 0 && a.remaining == 0 && !a.dirty && !a.signed)
end divider_context

@test("RP2040 divider arithmetic covers both signs, zero divisors, INT_MIN overflow and unsigned limits")
divider_arithmetic()
    val cases: [12][5]u32 = [[0, 1, 0, 0, 0], [0xFFFFFFFF, 1, 0xFFFFFFFF, 0, 0],
        [0xFFFFFFFF, 0x80000000, 1, 0x7FFFFFFF, 0], [7, 0xFFFFFFFD, 0xFFFFFFFE, 1, 1],
        [0xFFFFFFF9, 3, 0xFFFFFFFE, 0xFFFFFFFF, 1], [0xFFFFFFF9, 0xFFFFFFFD, 2, 0xFFFFFFFF, 1],
        [0x80000000, 0xFFFFFFFF, 0x80000000, 0, 1], [7, 0, 0xFFFFFFFF, 7, 0],
        [7, 0, 0xFFFFFFFF, 7, 1], [0xFFFFFFF9, 0, 1, 0xFFFFFFF9, 1], [0, 0, 0xFFFFFFFF, 0, 0], [0, 0, 0, 0, 1]]
    for c in cases
        var d = divider()
        d.write(if c[4] == 1 then sio.DIV_SDIVIDEND_OFFSET else sio.DIV_UDIVIDEND_OFFSET, 4, c[0]).unwrap()
        d.write(if c[4] == 1 then sio.DIV_SDIVISOR_OFFSET else sio.DIV_UDIVISOR_OFFSET, 4, c[1]).unwrap()
        d.advance(8)
        assert(d.quotient == c[2] && d.remainder == c[3], "quotient and signed remainder")
end divider_arithmetic

@test("RP2040 peripheral access rejects unmapped registers, invalid widths, unaligned accesses and unsupported side-effect aliases")
peripheral_access_errors()
    var t = timer()
    var r = resets()
    var d = divider()
    for width in [u32(0), u32(3), u32(8)]
        assert(t.read(0, width).is_err() && r.read(0, width).is_err() && d.read(sio.DIV_CSR_OFFSET, width).is_err())
        assert(t.write(0, width, 1).is_err() && r.write(0, width, 1).is_err() && d.write(sio.DIV_CSR_OFFSET, width, 1).is_err())
    for offset in [u32(1), u32(2), u32(3)]
        assert(t.read(offset, 4).is_err() && r.write(offset, 4, 0).is_err())
    for offset in [u32(0x44), u32(0xFFC), u32(0x4000), u32(0xFFFFFFFF)]
        assert(t.read(offset, 4).is_err() && t.write(offset, 4, 0).is_err())
    assert(r.read(12, 4).is_err() && r.write(12, 4, 0).is_err())
    assert(d.read(0x1078, 4).is_err() && d.write(0x1070, 4, 0).is_err(), "SIO has no bus atomic aliases")
    assert(d.read(0x7C, 4).is_err() && d.write(0x7C, 4, 0).is_err())
    for offset in [tm.TIMEHW_OFFSET, tm.TIMELW_OFFSET, tm.ARMED_OFFSET, tm.INTR_OFFSET]
        assert(t.write(offset + 0x2000, 4, 1).is_err(), "side-effect alias must not silently simulate a normal RW register")
    assert(t.value == 0 && t.armed == 0 && t.raw == 0 && r.held == RESET_BITS && !d.dirty, "failed accesses leave state unchanged")
end peripheral_access_errors

@test("the watchdog's tick powers up enabled with CYCLES 0, so stopped, and makes no tick until CYCLES is set")
watchdog_tick_reset()
    var w = watchdog()
    assert(w.read(wd.TICK_OFFSET, 4).unwrap() == wd.TICK_ENABLE_MASK, "reset value 0x200")
    assert(!w.running() && w.advance(1000000) == 0 && w.cycles_to(1).is_none())
    w.write(wd.TICK_OFFSET, 4, 12).unwrap()
    assert(!w.running() && w.advance(1000) == 0, "CYCLES without ENABLE stays stopped")
    w.write(0x2000 + wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK).unwrap()
    assert(w.running() && w.tick.cycles == 12, "the SET alias keeps CYCLES")
    w.write(0x3000 + wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK).unwrap()
    assert(!w.running() && w.tick.cycles == 12, "the CLR alias stops it")
end watchdog_tick_reset

@test("a tick too far off to count in 64 bits is never, not a wrapped-round near one")
watchdog_tick_far_off()
    var w = watchdog()
    w.write(wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK | 12).unwrap()
    val never: u64 = 0xffffffffffffffff
    // An mtimecmp left at all ones is about 2^64 ticks off: 12 cycles a tick does not fit.
    assert(w.cycles_to(never).unwrap() == never && w.cycles_to(never / 12 + 2).unwrap() == never)
    // The last count that fits is still exact.
    assert(w.cycles_to(never / 12).unwrap() == 12 + (never / 12 - 1) * 12)

@test("the watchdog's tick divides any run of cycles exactly, across every boundary, and says when the nth tick comes")
watchdog_tick_division()
    var w = watchdog()
    w.write(wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK | 12).unwrap()
    assert(w.cycles_to(1).unwrap() == 12 && w.cycles_to(3).unwrap() == 36)
    assert(w.advance(11) == 0 && w.tick.count == 1 && w.cycles_to(1).unwrap() == 1, "one short of the first tick")
    assert(w.advance(1) == 1 && w.tick.count == 12, "the tick, and COUNT reloaded")
    assert(w.advance(25) == 2 && w.tick.count == 11, "two whole periods and one cycle")
    assert(w.advance(0) == 0 && w.tick.count == 11)
    // A long skip is the same as the cycles one at a time.
    var v = watchdog()
    v.write(wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK | 7).unwrap()
    var one_by_one: u64 = 0
    for i in 0..<10000 do one_by_one += v.advance(1)
    var u = watchdog()
    u.write(wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK | 7).unwrap()
    assert(u.advance(10000) == one_by_one && one_by_one == 1428 && u.tick.count == v.tick.count)
    // CYCLES 1 ticks every cycle, the largest is 511.
    var f = watchdog()
    f.write(wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK | 1).unwrap()
    assert(f.advance(5) == 5 && f.tick.count == 1)
    f.write(wd.TICK_OFFSET, 4, 0xFFFFFFFF).unwrap()
    assert(f.tick.cycles == 511 && f.running() && f.advance(511) == 1, "COUNT and RUNNING are read-only")
end watchdog_tick_division

@test("a TICK write restarts the count, and TICK reads COUNT, RUNNING, ENABLE and CYCLES")
watchdog_tick_read()
    var w = watchdog()
    w.write(wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK | 12).unwrap()
    w.advance(5)
    assert(w.read(wd.TICK_OFFSET, 4).unwrap() == (7 << wd.TICK_COUNT_SHIFT) | wd.TICK_RUNNING_MASK | wd.TICK_ENABLE_MASK | 12)
    assert(w.read(wd.TICK_OFFSET + 1, 1).unwrap() == ((7 << 3) | 6), "byte lane 1")
    w.write(wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK | 12).unwrap()
    assert(w.tick.count == 12, "restarted")
end watchdog_tick_read

@test("the watchdog's scratch registers hold what is written, aliases apply, and nothing is past TICK")
watchdog_scratch()
    var w = watchdog()
    for i in 0u32..<8
        w.write(wd.SCRATCH0_OFFSET + 4 * i, 4, 0x1000 + i).unwrap()
    for i in 0u32..<8
        assert(w.read(wd.SCRATCH0_OFFSET + 4 * i, 4).unwrap() == 0x1000 + i)
    w.write(0x1000 + wd.SCRATCH3_OFFSET, 4, 0xFF).unwrap()
    assert(w.counter.scratch[3] == 0x10FC, "XOR alias")
    assert(w.read(0x30, 4).is_err() && w.read(wd.TICK_OFFSET + 2, 4).is_err(), "past TICK, and unaligned")
    w.reset()
    assert(w.counter.scratch[3] == 0 && w.tick.enable && w.tick.cycles == 0, "power-on clears SCRATCH")
end watchdog_scratch

@test("the RP2040's counter counts the watchdog's own tick twice (erratum RP2040-E1), so LOAD 2000 at TICK 12 fires after 1000 ticks")
watchdog_counts_its_tick()
    var w = watchdog()
    w.write(wd.TICK_OFFSET, 4, wd.TICK_ENABLE_MASK | 12).unwrap()
    w.write(wd.LOAD_OFFSET, 4, 2000).unwrap()
    w.write(wd.CTRL_OFFSET, 4, wd.CTRL_ENABLE_MASK).unwrap()
    assert(w.cycles_to_fire(0).unwrap() == 12000, "1000 ticks of 12 cycles")
    assert(w.advance(11999) == 999 && w.read(wd.CTRL_OFFSET, 4).unwrap() & wd.CTRL_TIME_MASK == 2)
    assert(w.counter.take_fired() == 0)
    assert(w.advance(1) == 1 && w.counter.take_fired() == wd.REASON_TIMER_MASK)
    assert(w.read(wd.REASON_OFFSET, 4).unwrap() == wd.REASON_TIMER_MASK && w.read(wd.CTRL_OFFSET, 4).unwrap() == 0x07000000)
    // The tick keeps running for the timer; the counter, reset, has stopped.
    assert(w.running() && w.cycles_to_fire(0).is_none() && w.advance(1200) == 100)
    // A stopped tick stops the counter too.
    w.write(wd.CTRL_OFFSET, 4, wd.CTRL_ENABLE_MASK | wd.CTRL_PAUSE_DBG0_MASK).unwrap()
    w.write(wd.TICK_OFFSET + 0x3000, 4, wd.TICK_ENABLE_MASK).unwrap()
    assert(w.cycles_to_fire(0).is_none() && w.advance(100000) == 0 && w.counter.take_fired() == 0)
    // A paused counter (core 0 halted, PAUSE_DBG0 set) lets the tick run; unpaused, it fires on the
    // first tick, from TIME 0.
    w.write(wd.TICK_OFFSET + 0x2000, 4, wd.TICK_ENABLE_MASK).unwrap()
    assert(w.cycles_to_fire(HALTED_CORE0).is_none() && w.advance_while(120000, HALTED_CORE0) == 10000 && w.counter.take_fired() == 0)
    assert(w.cycles_to_fire(HALTED_CORE1).unwrap() == 12 && w.advance_while(12, HALTED_CORE1) == 1 && w.counter.take_fired() == wd.REASON_TIMER_MASK)
end watchdog_counts_its_tick
