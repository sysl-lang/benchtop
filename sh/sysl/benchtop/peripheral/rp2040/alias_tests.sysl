module sh.sysl.benchtop.peripheral.rp2040
@tests

import sh.sysl.rp2040.timer as tm

// The atomic aliases on the fields a write acts on rather than stores (`access.sysl`): a
// write-1-to-clear flag clears on a 1 through the plain address and every alias, and a self-clearing
// control fires on a 1 through any alias but CLR.

private val ALIASES: [4]u32 = [0, 0x1000, 0x2000, 0x3000]

@test("w1c: each 1 in the data clears its flag and a 0 leaves it; triggered: a 1 plainly, through XOR or SET, and nothing through CLR")
alias_rules()
    assert(w1c(0b1010, 0) == 0b1010 && w1c(0b1010, 0b0010) == 0b1000 && w1c(0b1010, 0b0101) == 0b1010 && w1c(0b1010, 0xFFFFFFFF) == 0)
    for alias in ALIASES
        val fires = triggered(alias, 0b0110)
        assert(fires == (if alias == 0x3000 then 0 else 0b0110), f"alias 0x${alias}%x fires 0x${fires}%x")
    assert(triggered(0x3000, 0xFFFFFFFF) == 0 && triggered(0, 0) == 0 && triggered(0x1000, 0) == 0)

@test("TIMER's ARMED and INTR are write-1-to-clear through the plain address and every alias: a 1 clears only its own flag, a 0 none")
timer_w1c_aliases()
    for alias in ALIASES
        var t = timer()
        t.raw = 0b1010
        t.armed = 0b0101
        t.write(tm.INTR_OFFSET + alias, 4, 0).unwrap()
        t.write(tm.ARMED_OFFSET + alias, 4, 0).unwrap()
        assert(t.raw == 0b1010 && t.armed == 0b0101, f"alias 0x${alias}%x: a 0 clears nothing")
        t.write(tm.INTR_OFFSET + alias, 4, 0b0010).unwrap()
        t.write(tm.ARMED_OFFSET + alias, 4, 0b0100).unwrap()
        assert(t.raw == 0b1000 && t.armed == 0b0001, f"alias 0x${alias}%x: raw 0x${t.raw}%x armed 0x${t.armed}%x")
        assert(t.read(tm.INTR_OFFSET, 4).unwrap() == 0b1000 && t.read(tm.ARMED_OFFSET, 4).unwrap() == 0b0001)
        // A 1 on a flag that is already clear leaves it clear: XOR does not set it.
        t.write(tm.INTR_OFFSET + alias, 4, 0b0111).unwrap()
        t.write(tm.ARMED_OFFSET + alias, 4, 0b1110).unwrap()
        assert(t.raw == 0b1000 && t.armed == 0b0001, f"alias 0x${alias}%x: cleared flags stay clear")

@test("TIMER: a CLR-alias write to INTR drops the alarm's interrupt, as hw_clear_bits would")
timer_clr_alias_drops_irq()
    var t = timer()
    t.write(tm.INTE_OFFSET, 4, 15).unwrap()
    t.write(tm.ALARM1_OFFSET, 4, 1).unwrap()
    t.advance(1, 0)
    assert(t.irqs() == 0b0010 && t.armed == 0)
    t.write(tm.INTR_OFFSET + 0x3000, 4, 0b0010).unwrap()
    assert(t.irqs() == 0 && t.read(tm.INTS_OFFSET, 4).unwrap() == 0)
    // Disarming through the SET alias.
    t.write(tm.ALARM2_OFFSET, 4, 100).unwrap()
    t.write(tm.ARMED_OFFSET + 0x2000, 4, 0b0100).unwrap()
    assert(t.armed == 0 && t.next_alarm(0).is_none())
