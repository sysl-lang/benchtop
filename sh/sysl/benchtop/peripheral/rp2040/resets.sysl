module sh.sysl.benchtop.peripheral.rp2040

import sh.sysl.rp2040.resets as reg

const RESET_BITS: u32 = 0x01FFFFFF

// RESET_DONE is a handshake, not merely the complement of RESET. The chip resets connected
// instances when held changes and calls complete() after each released device is ready. `bits` is
// the chip's reset outputs: the RP2040's 25 (`RESET_BITS`), the RP2350's 29. Both chips put RESET,
// WDSEL and RESET_DONE at the same offsets.
struct Resets
    held: u32
    watchdog: u32
    done: u32
    bits: u32

    reset(*self) = self.reset_outputs(RESET_BITS)

    /** Power-on for a chip with the reset outputs `bits`: every one of them held. */
    reset_outputs(*self, bits: u32)
        self.bits = bits
        self.held = bits
        self.watchdog = 0
        self.done = 0

    complete(*self, bits: u32) = self.done |= bits & ~self.held & self.bits

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val value = (offset & 0xFFC) match
            reg.RESET_OFFSET -> self.held
            reg.WDSEL_OFFSET -> self.watchdog
            reg.RESET_DONE_OFFSET -> self.done
            _ -> return Err(AccessError.Unmapped)
        Ok(read_lane(value, offset, width))
    end read

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val data = replicated(value, width)
        (offset & 0xFFC) match
            reg.RESET_OFFSET ->
                self.held = written(self.held, offset, data) & self.bits
                self.done &= ~self.held
            reg.WDSEL_OFFSET -> self.watchdog = written(self.watchdog, offset, data) & self.bits
            reg.RESET_DONE_OFFSET -> ()
            _ -> return Err(AccessError.Unmapped)
        Ok(())
    end write
end Resets

resets() -> Resets
    var state: Resets
    state.reset()
    state
