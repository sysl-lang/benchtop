module sh.sysl.benchtop.peripheral.rp2040

import sh.sysl.rp2040.timer as reg

// The chip supplies actual watchdog-generated ticks, not retired instructions or wall time.
// All four alarm IRQs are level outputs in irqs(); the chip maps each bit to its IRQ line.
struct Timer
    value: u64
    low_write: u32
    high_read: u32
    alarms: [4]u32
    armed: u32
    raw: u32
    enable: u32
    force: u32
    debug_pause: u32
    pause: bool

    reset(*self)
        self.value = 0
        self.low_write = 0
        self.high_read = 0
        for i in 0u32..<4 do self.alarms[i] = 0
        self.armed = 0
        self.raw = 0
        self.enable = 0
        self.force = 0
        self.debug_pause = 6
        self.pause = false
    end reset

    irqs(*self) -> u32 =(self.raw & self.enable) | self.force

    private paused(self, halted: u32) -> bool = self.pause || self.debug_pause & ((halted & 3) << 1) != 0

    // A scheduler may skip to this many input ticks ahead. None means no armed alarm can progress.
    next_alarm(self, halted: u32) -> Option[u64]
        if self.paused(halted) then return None
        var next: u64 = 0x100000000
        for i in 0u32..<4
            if self.armed & (1 << i) == 0 then continue
            val distance = u64(self.alarms[i] -% u32.wrap(self.value))
            if distance < next then next = distance
        if next == 0x100000000 then None else Some(next)
    end next_alarm

    // Large advances catch every crossed comparator value, including low-word and u64 wraparound.
    advance(*self, ticks: u64, halted: u32)
        if self.paused(halted) || ticks == 0 then return
        for i in 0u32..<4
            if self.armed & (1 << i) == 0 then continue
            if u64(self.alarms[i] -% u32.wrap(self.value)) <= ticks then self.fire(i)
        self.value +%= ticks
    end advance

    private fire(*self, i: u32)
        self.armed &= ~(1 << i)
        self.raw |= 1 << i

    private compare(*self)
        for i in 0u32..<4
            if self.armed & (1 << i) != 0 && self.alarms[i] == u32.wrap(self.value) then self.fire(i)

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        if address >= reg.ALARM0_OFFSET && address <= reg.ALARM3_OFFSET
            return Ok(read_lane(self.alarms[(address - reg.ALARM0_OFFSET) >> 2], offset, width))
        val value = address match
            reg.TIMEHW_OFFSET | reg.TIMELW_OFFSET -> 0
            reg.TIMEHR_OFFSET -> self.high_read
            reg.TIMELR_OFFSET ->
                self.high_read = u32(self.value >> 32)
                u32.wrap(self.value)
            reg.ARMED_OFFSET -> self.armed
            reg.TIMERAWH_OFFSET -> u32(self.value >> 32)
            reg.TIMERAWL_OFFSET -> u32.wrap(self.value)
            reg.DBGPAUSE_OFFSET -> self.debug_pause
            reg.PAUSE_OFFSET -> if self.pause then u32(1) else u32(0)
            reg.INTR_OFFSET -> self.raw
            reg.INTE_OFFSET -> self.enable
            reg.INTF_OFFSET -> self.force
            reg.INTS_OFFSET -> self.irqs()
            _ -> return Err(AccessError.Unmapped)
        Ok(read_lane(value, offset, width))
    end read

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        val data = replicated(value, width)
        if address >= reg.ALARM0_OFFSET && address <= reg.ALARM3_OFFSET
            val i = (address - reg.ALARM0_OFFSET) >> 2
            self.alarms[i] = written(self.alarms[i], offset, data)
            self.armed |= 1 << i
            self.compare()
            return Ok(())
        if offset & 0x3000 != 0 && (address == reg.TIMEHW_OFFSET || address == reg.TIMELW_OFFSET) then return Err(AccessError.UnsupportedAlias)
        address match
            reg.TIMELW_OFFSET -> self.low_write = data
            reg.TIMEHW_OFFSET ->
                self.value = (u64(data) << 32) | u64(self.low_write)
                self.compare()
            reg.TIMEHR_OFFSET | reg.TIMELR_OFFSET | reg.TIMERAWH_OFFSET | reg.TIMERAWL_OFFSET | reg.INTS_OFFSET -> ()
            // ARMED and INTR are write-1-to-clear, through any alias (`access.sysl`).
            reg.ARMED_OFFSET -> self.armed = w1c(self.armed, data)
            reg.DBGPAUSE_OFFSET -> self.debug_pause = written(self.debug_pause, offset, data) & 6
            reg.PAUSE_OFFSET -> self.pause = written(if self.pause then 1 else 0, offset, data) & 1 != 0
            reg.INTR_OFFSET -> self.raw = w1c(self.raw, data)
            reg.INTE_OFFSET -> self.enable = written(self.enable, offset, data) & 15
            reg.INTF_OFFSET -> self.force = written(self.force, offset, data) & 15
            _ -> return Err(AccessError.Unmapped)
        Ok(())
    end write
end Timer

timer() -> Timer
    var state: Timer
    state.reset()
    state
