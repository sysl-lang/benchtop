module sh.sysl.benchtop.peripheral.rp2040
@tests

import sh.sysl.rp2040.sio as r

// The interpolator against the register descriptions in the SDK's `hardware/regs/sio.h` (RP2040 and
// RP2350 alike) and the datasheets' interpolator sections, on both chips' shift: `false` is the RP2040's
// logical shift, `true` the RP2350's rotate.

private const ACCUM0: u32 = 0x00
private const ACCUM1: u32 = r.INTERP0_ACCUM1_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const BASE0: u32 = r.INTERP0_BASE0_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const BASE1: u32 = r.INTERP0_BASE1_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const BASE2: u32 = r.INTERP0_BASE2_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const POP0: u32 = r.INTERP0_POP_LANE0_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const POP1: u32 = r.INTERP0_POP_LANE1_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const POP_FULL: u32 = r.INTERP0_POP_FULL_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const PEEK0: u32 = r.INTERP0_PEEK_LANE0_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const PEEK1: u32 = r.INTERP0_PEEK_LANE1_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const PEEK_FULL: u32 = r.INTERP0_PEEK_FULL_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const CTRL0: u32 = r.INTERP0_CTRL_LANE0_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const CTRL1: u32 = r.INTERP0_CTRL_LANE1_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const ADD0: u32 = r.INTERP0_ACCUM0_ADD_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const ADD1: u32 = r.INTERP0_ACCUM1_ADD_OFFSET - r.INTERP0_ACCUM0_OFFSET
private const BASE_1AND0: u32 = r.INTERP0_BASE_1AND0_OFFSET - r.INTERP0_ACCUM0_OFFSET

private const SIGNED: u32 = r.INTERP0_CTRL_LANE0_SIGNED_MASK
private const CROSS_INPUT: u32 = r.INTERP0_CTRL_LANE0_CROSS_INPUT_MASK
private const CROSS_RESULT: u32 = r.INTERP0_CTRL_LANE0_CROSS_RESULT_MASK
private const ADD_RAW: u32 = r.INTERP0_CTRL_LANE0_ADD_RAW_MASK
private const BLEND: u32 = r.INTERP0_CTRL_LANE0_BLEND_MASK
private const CLAMP: u32 = r.INTERP1_CTRL_LANE0_CLAMP_MASK
private const OVERF0: u32 = r.INTERP0_CTRL_LANE0_OVERF0_MASK
private const OVERF1: u32 = r.INTERP0_CTRL_LANE0_OVERF1_MASK
private const OVERF: u32 = r.INTERP0_CTRL_LANE0_OVERF_MASK

// A lane's CTRL: SHIFT, MASK_LSB and MASK_MSB.
private lane(shift: u32, lsb: u32, msb: u32) -> u32 =
    shift | (lsb << r.INTERP0_CTRL_LANE0_MASK_LSB_SHIFT) | (msb << r.INTERP0_CTRL_LANE0_MASK_MSB_SHIFT)

private force(bits: u32) -> u32 = bits << r.INTERP0_CTRL_LANE0_FORCE_MSB_SHIFT

// The whole accumulator, unshifted.
private const WHOLE: u32 = (31 << r.INTERP0_CTRL_LANE0_MASK_MSB_SHIFT)

@test("an interpolator resets to zero; CTRL stores only its lane bits, BLEND only on INTERP0 and CLAMP only on INTERP1; outside its 16 words is refused")
interp_reset_and_ctrl_bits()
    for index in 0u32..<2
        for rotate in [false, true]
            var i = interp(index, rotate)
            for o in 0u32..<16 do assert(i.read(4 * o).unwrap() == 0, s"word $o at reset")
            i.write(CTRL0, 0xFFFFFFFF).unwrap()
            i.write(CTRL1, 0xFFFFFFFF).unwrap()
            val want = if index == 0 then 0x003FFFFFu32 else 0x005FFFFF
            assert(i.read(CTRL0).unwrap() == want, s"INTERP$index lane 0: BITS of sio.h without OVERF")
            assert(i.read(CTRL1).unwrap() == 0x001FFFFF, "lane 1 has neither mode bit")
            i.write(ACCUM0, 9).unwrap()
            i.write(BASE2, 9).unwrap()
            i.reset()
            for o in 0u32..<16 do assert(i.read(4 * o).unwrap() == 0, s"word $o after reset")
            assert(i.read(0x40).is_err() && i.write(0x40, 0).is_err())

@test("a lane shifts (RP2040) or rotates (RP2350) by 0 to 31, keeps MASK_LSB..MASK_MSB and adds its BASE; FULL is BASE2 plus both lanes' values")
interp_shift_mask_base()
    for rotate in [false, true]
        var i = interp(0, rotate)
        i.write(ACCUM0, 0x12345678).unwrap()
        i.write(BASE0, 0x100).unwrap()
        i.write(CTRL0, lane(4, 0, 7)).unwrap()
        assert(i.read(PEEK0).unwrap() == 0x167 && i.read(ADD0).unwrap() == 0x67, "the same either way below the top")
        i.write(CTRL0, lane(4, 28, 31)).unwrap()
        assert(i.read(PEEK0).unwrap() == (if rotate then 0x80000100u32 else 0x100), "bits 3:0 come round to 31:28 only when rotating")
        i.write(ACCUM0, 0x80000003).unwrap()
        i.write(CTRL0, lane(31, 0, 31)).unwrap()
        assert(i.read(ADD0).unwrap() == (if rotate then 7u32 else 1), "a shift of 31")
        i.write(CTRL0, lane(0, 0, 31)).unwrap()
        assert(i.read(ADD0).unwrap() == 0x80000003, "a shift of 0 is the accumulator")

        i.write(ACCUM0, 0xF3).unwrap()
        i.write(CTRL0, lane(0, 0, 3)).unwrap()
        i.write(ACCUM1, 0xAB00).unwrap()
        i.write(CTRL1, lane(8, 0, 7)).unwrap()
        i.write(BASE1, 0x10).unwrap()
        i.write(BASE2, 0x1000).unwrap()
        assert(i.read(PEEK0).unwrap() == 0x103 && i.read(PEEK1).unwrap() == 0xBB && i.read(ADD1).unwrap() == 0xAB)
        assert(i.read(PEEK_FULL).unwrap() == 0x10AE, "BASE2 + 3 + 0xAB; BASE0 and BASE1 are not in FULL")
        // Each sum wraps.
        i.write(BASE2, 0xFFFFFFFF).unwrap()
        i.write(BASE0, 0xFFFFFFFE).unwrap()
        assert(i.read(PEEK_FULL).unwrap() == 0xAD && i.read(PEEK0).unwrap() == 1)

@test("MASK_LSB above MASK_MSB passes nothing, signed or not; a one-bit mask; the top bit alone")
interp_mask_edges()
    for rotate in [false, true]
        var i = interp(1, rotate)
        i.write(ACCUM0, 0xFFFFFFFF).unwrap()
        i.write(BASE0, 0x40).unwrap()
        i.write(CTRL0, lane(0, 8, 3)).unwrap()
        assert(i.read(ADD0).unwrap() == 0 && i.read(PEEK0).unwrap() == 0x40, "an empty mask leaves BASE0")
        i.write(CTRL0, lane(0, 8, 3) | SIGNED).unwrap()
        assert(i.read(ADD0).unwrap() == 0, "nothing to sign-extend")
        i.write(CTRL0, lane(0, 31, 0)).unwrap()
        assert(i.read(ADD0).unwrap() == 0)
        i.write(CTRL0, lane(0, 5, 5)).unwrap()
        assert(i.read(ADD0).unwrap() == 0x20)
        i.write(CTRL0, lane(0, 5, 5) | SIGNED).unwrap()
        assert(i.read(ADD0).unwrap() == 0xFFFFFFE0, "a one-bit field that is set is negative")
        i.write(CTRL0, lane(0, 31, 31)).unwrap()
        assert(i.read(ADD0).unwrap() == 0x80000000)
        i.write(CTRL0, lane(0, 0, 0)).unwrap()
        assert(i.read(ADD0).unwrap() == 1)

@test("SIGNED sign-extends the masked value from MASK_MSB before BASE is added; bits below MASK_LSB stay 0; MASK_MSB 31 is the word")
interp_signed()
    var i = interp(0, true)
    i.write(BASE0, 0x100).unwrap()
    i.write(ACCUM0, 0x80).unwrap()
    i.write(CTRL0, lane(0, 0, 7)).unwrap()
    assert(i.read(PEEK0).unwrap() == 0x180, "unsigned")
    i.write(CTRL0, lane(0, 0, 7) | SIGNED).unwrap()
    assert(i.read(PEEK0).unwrap() == 0x80 && i.read(ADD0).unwrap() == 0xFFFFFF80, "0x100 + -128")
    i.write(ACCUM0, 0x7F).unwrap()
    assert(i.read(PEEK0).unwrap() == 0x17F, "a positive value is unchanged")
    i.write(ACCUM0, 0x8F).unwrap()
    i.write(CTRL0, lane(0, 4, 7) | SIGNED).unwrap()
    assert(i.read(ADD0).unwrap() == 0xFFFFFF80)
    i.write(ACCUM0, 0x80000000).unwrap()
    i.write(CTRL0, WHOLE | SIGNED).unwrap()
    assert(i.read(ADD0).unwrap() == 0x80000000)
    // Lane 1 the same, by its own SIGNED.
    i.write(ACCUM1, 0x0800).unwrap()
    i.write(CTRL1, lane(8, 0, 3) | SIGNED).unwrap()
    assert(i.read(PEEK1).unwrap() == 0xFFFFFFF8 && i.read(PEEK_FULL).unwrap() == 0x7FFFFFF8, "FULL takes both signed values")

@test("ADD_RAW adds the unshifted input to the lane result and leaves FULL alone; CROSS_INPUT feeds the other accumulator, ahead of the bypass, one way or both")
interp_add_raw_and_cross_input()
    for rotate in [false, true]
        var i = interp(0, rotate)
        i.write(ACCUM0, 0x123).unwrap()
        i.write(BASE0, 0x1000).unwrap()
        i.write(CTRL0, lane(4, 0, 3) | ADD_RAW).unwrap()
        assert(i.read(PEEK0).unwrap() == 0x1123 && i.read(ADD0).unwrap() == 2 && i.read(PEEK_FULL).unwrap() == 2)
        i.write(ACCUM1, 5).unwrap()
        i.write(BASE1, 0x2000).unwrap()
        i.write(CTRL1, WHOLE | CROSS_INPUT).unwrap()
        assert(i.read(PEEK1).unwrap() == 0x2123 && i.read(ADD1).unwrap() == 0x123, "lane 1 reads ACCUM0")
        i.write(CTRL0, lane(4, 0, 3) | ADD_RAW | CROSS_INPUT).unwrap()
        assert(i.read(PEEK0).unwrap() == 0x1005, "ADD_RAW adds ACCUM1: the cross is before the bypass")
        assert(i.read(PEEK_FULL).unwrap() == 0x123, "FULL: lane 0's value of ACCUM1 (0) and lane 1's of ACCUM0")
        i.write(CTRL1, WHOLE).unwrap()
        assert(i.read(PEEK1).unwrap() == 0x2005)

@test("POP writes each lane's result back and PEEK does not; CROSS_RESULT swaps them, both ways or one; POP_FULL writes the lane results, not FULL")
interp_pop_and_cross_result()
    var i = interp(1, true)
    i.write(BASE0, 3).unwrap()
    i.write(CTRL0, WHOLE).unwrap()
    i.write(CTRL1, WHOLE).unwrap()
    for _ in 0..<3 do assert(i.read(PEEK0).unwrap() == 3)
    assert(i.read(ACCUM0).unwrap() == 0)
    for k in 1u32..<4 do assert(i.read(POP0).unwrap() == 3 * k, "a counter")
    assert(i.read(ACCUM0).unwrap() == 9 && i.read(ACCUM1).unwrap() == 0, "lane 1 popped its own result, BASE1 + 0")
    i.write(POP0, 77).unwrap()
    i.write(PEEK0, 77).unwrap()
    assert(i.read(ACCUM0).unwrap() == 9, "a write to PEEK or POP does nothing")

    i.write(BASE0, 10).unwrap()
    i.write(BASE1, 20).unwrap()
    i.write(BASE2, 0x77).unwrap()
    i.write(ACCUM0, 1).unwrap()
    i.write(ACCUM1, 2).unwrap()
    i.write(CTRL0, WHOLE | CROSS_RESULT).unwrap()
    i.write(CTRL1, WHOLE | CROSS_RESULT).unwrap()
    assert(i.read(POP_FULL).unwrap() == 0x7A)
    assert(i.read(ACCUM0).unwrap() == 22 && i.read(ACCUM1).unwrap() == 11, "each took the other's result")
    i.write(CTRL1, WHOLE).unwrap()
    assert(i.read(POP1).unwrap() == 31)
    assert(i.read(ACCUM0).unwrap() == 31 && i.read(ACCUM1).unwrap() == 31, "lane 0 crosses, lane 1 keeps its own: both take lane 1's")
    i.write(CTRL0, WHOLE).unwrap()
    i.write(CTRL1, WHOLE | CROSS_RESULT).unwrap()
    assert(i.read(POP0).unwrap() == 41 && i.read(ACCUM0).unwrap() == 41 && i.read(ACCUM1).unwrap() == 41)

@test("FORCE_MSB ORs into bits 29:28 of a lane as the bus reads it, not into what POP writes back nor into FULL")
interp_force_msb()
    var i = interp(0, true)
    i.write(BASE0, 0x10000001).unwrap()
    i.write(CTRL0, WHOLE | force(2)).unwrap()
    assert(i.read(PEEK0).unwrap() == 0x30000001, "ORed over the 1 already in bit 28")
    assert(i.read(POP0).unwrap() == 0x30000001 && i.read(ACCUM0).unwrap() == 0x10000001, "the write-back has no FORCE_MSB")
    assert(i.read(PEEK_FULL).unwrap() == 0x10000001 && i.read(ADD0).unwrap() == 0x10000001)
    i.write(CTRL1, WHOLE | force(3)).unwrap()
    assert(i.read(PEEK1).unwrap() == 0x30000000)
    assert(i.read(CTRL1).unwrap() & r.INTERP0_CTRL_LANE1_FORCE_MSB_MASK == force(3))

@test("BLEND on INTERP0: lane 1 is BASE0 + alpha/256 of the way to BASE1, unsigned or signed by lane 1's SIGNED; lane 0 is alpha; FULL leaves lane 1 out")
interp_blend()
    for rotate in [false, true]
        var i = interp(0, rotate)
        i.write(CTRL0, WHOLE | BLEND).unwrap()
        i.write(CTRL1, lane(0, 0, 7)).unwrap()
        i.write(BASE0, 500).unwrap()
        i.write(BASE1, 1000).unwrap()
        i.write(BASE2, 100).unwrap()
        i.write(ACCUM0, 5).unwrap()
        for (alpha, want) in [(0u32, 500u32), (64, 625), (128, 750), (192, 875), (255, 998)]
            i.write(ACCUM1, alpha).unwrap()
            assert(i.read(PEEK1).unwrap() == want, s"alpha $alpha")
            assert(i.read(PEEK0).unwrap() == alpha, "lane 0 is alpha, with no BASE0")
        assert(i.read(PEEK_FULL).unwrap() == 105, "BASE2 + lane 0's value only")
        // Alpha is the 8 low bits of lane 1's shift-and-mask value.
        i.write(ACCUM1, 0x1800).unwrap()
        i.write(CTRL1, lane(4, 0, 11)).unwrap()
        assert(i.read(PEEK0).unwrap() == 0x80 && i.read(PEEK1).unwrap() == 750)
        i.write(CTRL1, lane(0, 0, 7)).unwrap()
        // Descending, unsigned.
        i.write(BASE0, 1000).unwrap()
        i.write(BASE1, 500).unwrap()
        i.write(ACCUM1, 1).unwrap()
        assert(i.read(PEEK1).unwrap() == 998)
        // The full unsigned range, and the same words signed: 0 to -1.
        i.write(BASE0, 0).unwrap()
        i.write(BASE1, 0xFFFFFFFF).unwrap()
        i.write(ACCUM1, 128).unwrap()
        assert(i.read(PEEK1).unwrap() == 0x7FFFFFFF, "unsigned")
        i.write(CTRL1, lane(0, 0, 7) | SIGNED).unwrap()
        assert(i.read(PEEK1).unwrap() == 0xFFFFFFFF, "signed: half of -1 rounds down")
        // Signed, -1000 to 1000; a signed alpha's 8 low bits are still alpha.
        i.write(BASE0, u32.wrap(-1000)).unwrap()
        i.write(BASE1, 1000).unwrap()
        for (alpha, want) in [(0u32, -1000i32), (1, -993), (64, -500), (128, 0), (192, 500), (255, 992)]
            i.write(ACCUM1, alpha).unwrap()
            assert(i32.wrap(i.read(PEEK1).unwrap()) == want, s"signed alpha $alpha")
            assert(i.read(PEEK0).unwrap() == alpha)
        // POP: ACCUM0 takes alpha and ACCUM1 the blend.
        i.write(ACCUM1, 64).unwrap()
        assert(i32.wrap(i.read(POP1).unwrap()) == -500 && i.read(ACCUM0).unwrap() == 64 && i32.wrap(i.read(ACCUM1).unwrap()) == -500)

    // INTERP1 does not store BLEND: its lanes stay ordinary.
    var j = interp(1, true)
    j.write(CTRL0, WHOLE | BLEND).unwrap()
    j.write(CTRL1, lane(0, 0, 7)).unwrap()
    j.write(BASE0, 500).unwrap()
    j.write(BASE1, 1000).unwrap()
    j.write(ACCUM1, 128).unwrap()
    assert(j.read(PEEK1).unwrap() == 1128 && j.read(PEEK0).unwrap() == 500 && j.read(CTRL0).unwrap() & BLEND == 0)

@test("CLAMP on INTERP1: lane 0's value held to BASE0..BASE1 inclusive with nothing added, signed or unsigned; BASE0 wins where the bounds cross; FULL is unchanged")
interp_clamp()
    for rotate in [false, true]
        var i = interp(1, rotate)
        i.write(CTRL0, WHOLE | CLAMP).unwrap()
        i.write(BASE0, 10).unwrap()
        i.write(BASE1, 20).unwrap()
        for (v, want) in [(0u32, 10u32), (9, 10), (10, 10), (15, 15), (20, 20), (21, 20), (0xFFFFFFFF, 20)]
            i.write(ACCUM0, v).unwrap()
            assert(i.read(PEEK0).unwrap() == want, s"unsigned $v")
        // Shifted and masked before the clamp.
        i.write(ACCUM0, 0x500).unwrap()
        i.write(CTRL0, lane(8, 0, 7) | CLAMP).unwrap()
        assert(i.read(PEEK0).unwrap() == 10 && i.read(ADD0).unwrap() == 5)
        // Signed against the same words unsigned.
        i.write(BASE0, u32.wrap(-5)).unwrap()
        i.write(BASE1, 5).unwrap()
        i.write(CTRL0, WHOLE | CLAMP | SIGNED).unwrap()
        for (v, want) in [(3i32, 3i32), (-16, -5), (-5, -5), (5, 5), (6, 5), (-2147483647 - 1, -5), (2147483647, 5)]
            i.write(ACCUM0, u32.wrap(v)).unwrap()
            assert(i32.wrap(i.read(PEEK0).unwrap()) == want, s"signed $v")
        i.write(CTRL0, WHOLE | CLAMP).unwrap()
        i.write(ACCUM0, 3).unwrap()
        assert(i.read(PEEK0).unwrap() == u32.wrap(-5), "unsigned, 3 is below 0xFFFFFFFB")
        // Crossed bounds.
        i.write(BASE0, 20).unwrap()
        i.write(BASE1, 10).unwrap()
        i.write(ACCUM0, 15).unwrap()
        assert(i.read(PEEK0).unwrap() == 20)
        i.write(ACCUM0, 25).unwrap()
        assert(i.read(PEEK0).unwrap() == 10, "not below BASE0, so above BASE1")
        // FULL and lane 1 are untouched by CLAMP; POP writes the clamped value back.
        i.write(ACCUM0, 4).unwrap()
        i.write(ACCUM1, 6).unwrap()
        i.write(CTRL1, WHOLE).unwrap()
        i.write(BASE2, 100).unwrap()
        assert(i.read(PEEK_FULL).unwrap() == 110 && i.read(PEEK1).unwrap() == 16)
        assert(i.read(POP0).unwrap() == 20 && i.read(ACCUM0).unwrap() == 20)

    // INTERP0 does not store CLAMP.
    var j = interp(0, true)
    j.write(CTRL0, WHOLE | CLAMP).unwrap()
    j.write(BASE0, 10).unwrap()
    j.write(BASE1, 20).unwrap()
    j.write(ACCUM0, 50).unwrap()
    assert(j.read(PEEK0).unwrap() == 60 && j.read(CTRL0).unwrap() & CLAMP == 0)

@test("BASE_1AND0 writes BASE0 from the low half and BASE1 from the high, each sign-extended where its lane is SIGNED, and reads 0")
interp_base_1and0()
    var i = interp(0, true)
    i.write(BASE_1AND0, 0x80017FFF).unwrap()
    assert(i.read(BASE0).unwrap() == 0x7FFF && i.read(BASE1).unwrap() == 0x8001 && i.read(BASE_1AND0).unwrap() == 0)
    i.write(CTRL1, SIGNED).unwrap()
    i.write(BASE_1AND0, 0x80017FFF).unwrap()
    assert(i.read(BASE0).unwrap() == 0x7FFF && i.read(BASE1).unwrap() == 0xFFFF8001)
    i.write(CTRL0, SIGNED).unwrap()
    i.write(CTRL1, 0).unwrap()
    i.write(BASE_1AND0, 0x7FFF8000).unwrap()
    assert(i.read(BASE0).unwrap() == 0xFFFF8000 && i.read(BASE1).unwrap() == 0x7FFF)
    i.write(BASE2, 5).unwrap()
    i.write(BASE_1AND0, 0).unwrap()
    assert(i.read(BASE2).unwrap() == 5, "BASE2 is not part of it")

@test("ACCUMx_ADD adds its 24-bit field to the whole accumulator, wrapping, and reads the lane's shift-and-mask value")
interp_accum_add()
    var i = interp(1, false)
    i.write(ACCUM0, 0xFFFFFFF0).unwrap()
    i.write(ADD0, 0x20).unwrap()
    assert(i.read(ACCUM0).unwrap() == 0x10, "wraps")
    i.write(ADD0, 0xFF000001).unwrap()
    assert(i.read(ACCUM0).unwrap() == 0x11, "bits 31:24 are not part of the field")
    i.write(ADD1, 0x00FFFFFF).unwrap()
    i.write(ADD1, 0x00FFFFFF).unwrap()
    assert(i.read(ACCUM1).unwrap() == 0x01FFFFFE, "carries past bit 23 into the accumulator")
    i.write(CTRL1, lane(4, 0, 7)).unwrap()
    i.write(BASE1, 0x1000).unwrap()
    assert(i.read(ADD1).unwrap() == 0xFF && i.read(ACCUM1).unwrap() == 0x01FFFFFE, "reading has no side effect")

@test("OVERF0 and OVERF1 flag bits above a lane's MASK_MSB after its shift or rotate; OVERF is either; a write does not set them")
interp_overflow()
    for rotate in [false, true]
        var i = interp(0, rotate)
        i.write(CTRL0, lane(0, 0, 7)).unwrap()
        i.write(CTRL1, lane(0, 0, 3)).unwrap()
        i.write(ACCUM0, 0xFF).unwrap()
        i.write(ACCUM1, 0x0F).unwrap()
        assert(i.read(CTRL0).unwrap() & (OVERF | OVERF0 | OVERF1) == 0, "everything fits")
        i.write(ACCUM0, 0x100).unwrap()
        assert(i.read(CTRL0).unwrap() & (OVERF | OVERF0 | OVERF1) == OVERF | OVERF0)
        i.write(ACCUM0, 0).unwrap()
        i.write(ACCUM1, 0x10).unwrap()
        assert(i.read(CTRL0).unwrap() & (OVERF | OVERF0 | OVERF1) == OVERF | OVERF1)
        assert(i.read(CTRL1).unwrap() & (OVERF | OVERF0 | OVERF1) == 0, "the flags are in lane 0's CTRL only")
        i.write(ACCUM0, 0x100).unwrap()
        assert(i.read(CTRL0).unwrap() & (OVERF | OVERF0 | OVERF1) == OVERF | OVERF0 | OVERF1)
        // Bits below MASK_LSB are not overflow, nor anything at MASK_MSB 31.
        i.write(CTRL0, lane(0, 4, 31)).unwrap()
        i.write(ACCUM0, 0xFFFFFFFF).unwrap()
        i.write(ACCUM1, 0).unwrap()
        assert(i.read(CTRL0).unwrap() & (OVERF | OVERF0 | OVERF1) == 0)
        // A rotate brings bit 0 round to the top; a shift drops it.
        i.write(CTRL0, lane(1, 0, 7)).unwrap()
        i.write(ACCUM0, 1).unwrap()
        assert(i.read(CTRL0).unwrap() & OVERF0 == (if rotate then OVERF0 else 0))
        i.write(ACCUM0, 0).unwrap()
        i.write(CTRL0, OVERF | OVERF0 | OVERF1).unwrap()
        assert(i.read(CTRL0).unwrap() == 0, "read-only")
