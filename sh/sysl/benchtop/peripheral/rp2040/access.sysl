module sh.sysl.benchtop.peripheral.rp2040

// Peripheral offsets are relative to the instance's base. Chip bus code owns mapping, clock
// delivery, reset fanout, IRQ routing and serialization between cores. No CPU or host-time state
// lives here. An unsupported access is explicit so the chip can report the offending device.
enum AccessError
    Unmapped
    InvalidWidth
    Unaligned
    UnsupportedAlias
end AccessError

// The RP2040's and RP2350's register access rules, which the RP2350's models share
// (`peripheral/rp2350`): a width of 1, 2 or 4, aligned to it, inside the window and, where the
// device has them, its three atomic aliases.
access(offset: u32, width: u32, aliases: bool) -> Result[unit, AccessError]
    if width != 1 && width != 2 && width != 4 then return Err(AccessError.InvalidWidth)
    if offset & (width - 1) != 0 then return Err(AccessError.Unaligned)
    if offset >= (if aliases then u32(0x4000) else u32(0x1000)) then return Err(AccessError.Unmapped)
    Ok(())

// RP2040 and RP2350 bus masters replicate narrow writes over the entire 32-bit data bus.
replicated(value: u32, width: u32) -> u32 = width match
    1 -> (value & 255) * 0x01010101
    2 -> (value & 65535) * 0x00010001
    _ -> value

read_lane(value: u32, offset: u32, width: u32) -> u32
    val shifted = value >> ((offset & 3) * 8)
    if width == 1 then shifted & 255 elif width == 2 then shifted & 65535 else shifted

// Native SET/CLR/XOR operations on ordinary RW registers, without invoking a read side effect.
written(old: u32, offset: u32, value: u32) -> u32 = (offset >> 12) & 3 match
    1 -> old ^ value
    2 -> old | value
    3 -> old & ~value
    _ -> value

// The two kinds of field a write acts on rather than stores, one rule each for every model on both
// chips. An alias write reaches the peripheral as the bus data and the operation, which the peripheral
// performs in place (datasheet, "Atomic register access"); the data arrives unchanged, which is why an
// alias write to POWMAN or ACCESSCTRL must carry the password in its top half.
//
// A write-1-to-clear (WC) flag is not storage the operation can modify: each 1 in the data clears its
// flag, through the plain address and the XOR, SET and CLR aliases alike. The CLR alias is the case
// software depends on: TinyUSB clears USB's SIE_STATUS and BUF_STATUS flags with `usb_hw_clear`, and
// the SDK clears POWMAN's TIMER.ALARM and STATE.REQ_IGNORED with `powman_clear_bits` and SHA-256's
// CSR.ERR_WDATA_NOT_RDY with `hw_clear_bits`. Were the write CLR's result, `flags & ~data`, each of
// those would clear every other pending flag and never the one it names.
//
// A self-clearing (SC) control is a stored bit that falls back to 0 on its own, so the operation
// applies to it as to any stored bit holding 0: a 1 written plainly or through SET or XOR fires it,
// and the CLR alias fires nothing.

/** What a write of `value` leaves of the write-1-to-clear flags `flags`, through any alias. */
w1c(flags: u32, value: u32) -> u32 = flags & ~value

/** The self-clearing controls a write of `value` at `offset` triggers: none through the CLR alias. */
triggered(offset: u32, value: u32) -> u32 = written(0, offset, value)
