module sh.sysl.benchtop.peripheral.rp2040

// Peripheral offsets are relative to the instance's base. Chip bus code owns mapping, clock
// delivery, reset fanout, IRQ routing and serialization between cores. No CPU or host-time state
// lives here. An unsupported access is explicit so the chip can report the offending device.
enum AccessError
    Unmapped
    InvalidWidth
    Unaligned
    UnsupportedAlias
end AccessError

// The RP2040's and RP2350's register access rules, which the RP2350's models share
// (`peripheral/rp2350`): a width of 1, 2 or 4, aligned to it, inside the window and, where the
// device has them, its three atomic aliases.
access(offset: u32, width: u32, aliases: bool) -> Result[unit, AccessError]
    if width != 1 && width != 2 && width != 4 then return Err(AccessError.InvalidWidth)
    if offset & (width - 1) != 0 then return Err(AccessError.Unaligned)
    if offset >= (if aliases then u32(0x4000) else u32(0x1000)) then return Err(AccessError.Unmapped)
    Ok(())

// RP2040 and RP2350 bus masters replicate narrow writes over the entire 32-bit data bus.
replicated(value: u32, width: u32) -> u32 = width match
    1 -> (value & 255) * 0x01010101
    2 -> (value & 65535) * 0x00010001
    _ -> value

read_lane(value: u32, offset: u32, width: u32) -> u32
    val shifted = value >> ((offset & 3) * 8)
    if width == 1 then shifted & 255 elif width == 2 then shifted & 65535 else shifted

// Native SET/CLR/XOR operations on ordinary RW registers, without invoking a read side effect.
written(old: u32, offset: u32, value: u32) -> u32 = (offset >> 12) & 3 match
    1 -> old ^ value
    2 -> old | value
    3 -> old & ~value
    _ -> value
