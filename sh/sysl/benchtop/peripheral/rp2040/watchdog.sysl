module sh.sysl.benchtop.peripheral.rp2040

import sh.sysl.rp2040.watchdog as reg

/** A tick generator: it divides clk_ref by CYCLES into the 1 µs tick a timer counts. COUNT runs down
 * from CYCLES once per clk_ref cycle, and a tick is made as it passes 0. It runs while ENABLE is set
 * and CYCLES is not 0. The RP2040 has one, in its watchdog; the RP2350 has six, in TICKS.
 */
struct TickGenerator
    cycles: u32
    enable: bool
    // clk_ref cycles until the next tick, 1 to CYCLES while running.
    count: u32

    /** Power-on: CYCLES 0, so stopped, with ENABLE as the chip resets it. */
    reset(*self, enable: bool)
        self.cycles = 0
        self.enable = enable
        self.count = 0

    running(self) -> bool = self.enable && self.cycles != 0

    /** The ticks made over `cycles` clk_ref cycles. */
    advance(*self, cycles: u64) -> u64
        if !self.running() || cycles == 0 then return 0
        if cycles < u64(self.count)
            self.count -= u32(cycles)
            return 0
        val past = cycles - u64(self.count)
        val period = u64(self.cycles)
        self.count = u32(period - past % period)
        1 + past / period
    end advance

    /** The clk_ref cycles until the `n`th tick from now, n at least 1; None while stopped. */
    cycles_to(self, n: u64) -> Option[u64]
        if !self.running() then return None
        Some(u64(self.count) + (n - 1) * u64(self.cycles))

    /** Set CYCLES and ENABLE; the count restarts from CYCLES, as a write to either register does. */
    set(*self, cycles: u32, enable: bool)
        self.cycles = cycles
        self.enable = enable
        self.count = cycles
end TickGenerator

// The watchdog's tick generator and its scratch registers. The watchdog counter itself (CTRL, LOAD,
// REASON) is not modelled, and an access to it is refused as unmapped.
struct Watchdog
    tick: TickGenerator
    scratch: [8]u32

    reset(*self)
        self.tick.reset(true)
        for i in 0u32..<8 do self.scratch[i] = 0

    running(self) -> bool = self.tick.running()

    // The ticks made over `cycles` clk_ref cycles.
    advance(*self, cycles: u64) -> u64 = self.tick.advance(cycles)

    // The clk_ref cycles until the `n`th tick from now, n at least 1; None while stopped.
    cycles_to(self, n: u64) -> Option[u64] = self.tick.cycles_to(n)

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        if address >= reg.SCRATCH0_OFFSET && address <= reg.SCRATCH7_OFFSET
            return Ok(read_lane(self.scratch[(address - reg.SCRATCH0_OFFSET) >> 2], offset, width))
        if address != reg.TICK_OFFSET then return Err(AccessError.Unmapped)
        Ok(read_lane(self.tick_value(), offset, width))
    end read

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        val data = replicated(value, width)
        if address >= reg.SCRATCH0_OFFSET && address <= reg.SCRATCH7_OFFSET
            val i = (address - reg.SCRATCH0_OFFSET) >> 2
            self.scratch[i] = written(self.scratch[i], offset, data)
            return Ok(())
        if address != reg.TICK_OFFSET then return Err(AccessError.Unmapped)
        val t = &self.tick
        val now = written(t.cycles | (if t.enable then reg.TICK_ENABLE_MASK else 0), offset, data)
        t.set(now & reg.TICK_CYCLES_MASK, now & reg.TICK_ENABLE_MASK != 0)
        Ok(())
    end write

    private tick_value(self) -> u32
        val t = self.tick
        val run = if t.running() then reg.TICK_RUNNING_MASK else 0
        val enable = if t.enable then reg.TICK_ENABLE_MASK else 0
        ((t.count << reg.TICK_COUNT_SHIFT) & reg.TICK_COUNT_MASK) | run | enable | t.cycles
end Watchdog

watchdog() -> Watchdog
    var state: Watchdog
    state.reset()
    state
