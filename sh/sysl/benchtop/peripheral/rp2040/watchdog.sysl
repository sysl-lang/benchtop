module sh.sysl.benchtop.peripheral.rp2040

import sh.sysl.rp2040.watchdog as reg

// The watchdog's tick generator and its scratch registers. The generator divides clk_ref by CYCLES
// into the 1 µs tick the TIMER counts: COUNT runs down from CYCLES once per clk_ref cycle, and a tick
// is made as it passes 0. It runs while ENABLE is set and CYCLES is not 0. The watchdog counter
// itself (CTRL, LOAD, REASON) is not modelled, and an access to it is refused as unmapped.
struct Watchdog
    cycles: u32
    enable: bool
    // clk_ref cycles until the next tick, 1 to CYCLES while running.
    count: u32
    scratch: [8]u32

    reset(*self)
        self.cycles = 0
        self.enable = true
        self.count = 0
        for i in 0u32..<8 do self.scratch[i] = 0
    end reset

    running(self) -> bool = self.enable && self.cycles != 0

    // The ticks made over `cycles` clk_ref cycles.
    advance(*self, cycles: u64) -> u64
        if !self.running() || cycles == 0 then return 0
        if cycles < u64(self.count)
            self.count -= u32(cycles)
            return 0
        val past = cycles - u64(self.count)
        val period = u64(self.cycles)
        self.count = u32(period - past % period)
        1 + past / period
    end advance

    // The clk_ref cycles until the `n`th tick from now, n at least 1; None while stopped.
    cycles_to(self, n: u64) -> Option[u64]
        if !self.running() then return None
        Some(u64(self.count) + (n - 1) * u64(self.cycles))

    read(*self, offset: u32, width: u32) -> Result[u32, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        if address >= reg.SCRATCH0_OFFSET && address <= reg.SCRATCH7_OFFSET
            return Ok(read_lane(self.scratch[(address - reg.SCRATCH0_OFFSET) >> 2], offset, width))
        if address != reg.TICK_OFFSET then return Err(AccessError.Unmapped)
        Ok(read_lane(self.tick_value(), offset, width))
    end read

    write(*self, offset: u32, width: u32, value: u32) -> Result[unit, AccessError]
        access(offset, width, true)?
        val address = offset & 0xFFC
        val data = replicated(value, width)
        if address >= reg.SCRATCH0_OFFSET && address <= reg.SCRATCH7_OFFSET
            val i = (address - reg.SCRATCH0_OFFSET) >> 2
            self.scratch[i] = written(self.scratch[i], offset, data)
            return Ok(())
        if address != reg.TICK_OFFSET then return Err(AccessError.Unmapped)
        val old = self.cycles | (if self.enable then reg.TICK_ENABLE_MASK else 0)
        val now = written(old, offset, data)
        self.cycles = now & reg.TICK_CYCLES_MASK
        self.enable = now & reg.TICK_ENABLE_MASK != 0
        // A write restarts the count from CYCLES.
        self.count = self.cycles
        Ok(())
    end write

    private tick_value(self) -> u32
        val run = if self.running() then reg.TICK_RUNNING_MASK else 0
        val enable = if self.enable then reg.TICK_ENABLE_MASK else 0
        ((self.count << reg.TICK_COUNT_SHIFT) & reg.TICK_COUNT_MASK) | run | enable | self.cycles
end Watchdog

watchdog() -> Watchdog
    var state: Watchdog
    state.reset()
    state
