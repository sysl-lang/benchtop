// The STMicroelectronics STM32H747XIH6: a Cortex-M7 with the double-precision FPU at 480 MHz and a
// Cortex-M4 with the single-precision FPU at 240 MHz; 2 MB of flash, the 512 KB AXI SRAM and SRAM1;
// GPIO A to K; and the peripherals benchtop emulates, with the pins each signal can be routed to (the
// alternate-function table of the datasheet, DS12930). The bases, IRQ numbers and reset values are
// the reference manual's (RM0399). A board says which of those pins each signal it uses is on, under
// `buses`, and nowhere else.

mcu {
  name     = STM32H747XIH6
  summary  = "STMicroelectronics STM32H747XIH6: Cortex-M7 at 480 MHz and Cortex-M4 at 240 MHz"
  clock-hz = 480000000
  cores    = [{ core = cortex-m7, instruction-timing = estimated, fpu = dp },
              { core = cortex-m4, instruction-timing = estimated, fpu = sp, clock-hz = 240000000 }]
  pins     { PA = 16, PB = 16, PC = 16, PD = 16, PE = 16, PF = 16, PG = 16, PH = 16, PI = 16, PJ = 16, PK = 8 }

  peripherals {
    axi-sram { peripheral = ram, at = 0x24000000, size = 512K }
    sram1    { peripheral = ram, at = 0x30000000, size = 128K }
    flash0   { peripheral = flash, at = 0x08000000, size = 2M }
    rcc      { peripheral = stm32h7-rcc, at = 0x58024400 }
    sai1     { peripheral = stm32-sai, at = 0x40015800, irq = 87, kernel-clock-hz = 12288000 }
    dma2     { peripheral = stm32-dma, controller = 2, at = 0x40020400, irq = [56, 57, 58, 59, 60, 68, 69, 70] }
    dmamux1  { peripheral = stm32-dmamux, at = 0x40020800 }
    dsi      { peripheral = stm32-dsi, at = 0x50000000, reference-clock-hz = 25000000 }

    i2c4 {
      peripheral = stm32-i2c, at = 0x58001c00
      signals { sda = [PD13, PF15, PH12, PB7, PB9], scl = [PD12, PF14, PH11, PB6, PB8] }
    }
    sdmmc1 {
      peripheral = stm32-sdmmc, at = 0x52007000, irq = 49, kernel-clock-hz = 60000000
      signals { ck = [PC12], cmd = [PD2], d0 = [PC8], d1 = [PC9], d2 = [PC10], d3 = [PC11] }
    }
    spi1 {
      peripheral = stm32-spi, at = 0x40013000, kernel-clock-hz = 60000000
      signals { sck = [PA5, PB3, PG11], tx = [PA7, PB5, PD7], rx = [PA6, PB4, PG9] }
    }

    // GPIOA and GPIOB leave reset with their debug pins (JTAG/SWD) in alternate-function mode; every
    // other pin of every bank is analogue.
    gpioa { peripheral = stm32-gpio, at = 0x58020000, bank = PA, reset-mode = 0xabffffff }
    gpiob { peripheral = stm32-gpio, at = 0x58020400, bank = PB, reset-mode = 0xfffffebf }
    gpioc { peripheral = stm32-gpio, at = 0x58020800, bank = PC }
    gpiod { peripheral = stm32-gpio, at = 0x58020c00, bank = PD }
    gpioe { peripheral = stm32-gpio, at = 0x58021000, bank = PE }
    gpiof { peripheral = stm32-gpio, at = 0x58021400, bank = PF }
    gpiog { peripheral = stm32-gpio, at = 0x58021800, bank = PG }
    gpioh { peripheral = stm32-gpio, at = 0x58021c00, bank = PH }
    gpioi { peripheral = stm32-gpio, at = 0x58022000, bank = PI }
    gpioj { peripheral = stm32-gpio, at = 0x58022400, bank = PJ }
    gpiok { peripheral = stm32-gpio, at = 0x58022800, bank = PK }
  }
}
