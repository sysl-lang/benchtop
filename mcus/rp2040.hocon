// The Raspberry Pi RP2040: two Cortex-M0+ cores, 264 KB of SRAM, and the peripherals the Pico's
// boards wire to, with the pins each signal can be routed to (the SPI, UART and I2C columns, F1 to
// F3, of the datasheet's GPIO function table). The bases and IRQ numbers are the datasheet's.
// benchtop checks boards against this mcu; it does not run it yet.

mcu {
  name    = "rp2040"
  summary = "Raspberry Pi RP2040: two Cortex-M0+ at 133 MHz"
  cores   = [{ core = cortex-m0plus, mpu-regions = 8 }, { core = cortex-m0plus, mpu-regions = 8 }]
  pins    { GP = 30 }

  peripherals {
    rom  { peripheral = rom, at = 0x00000000, size = 16K }
    sram { peripheral = ram, at = 0x20000000, size = 264K }
    sio  { peripheral = rp-sio, at = 0xD0000000, irq = [15, 16] }

    resets   { peripheral = rp-resets, at = 0x4000C000 }
    watchdog { peripheral = rp-watchdog, at = 0x40058000 }
    timer    { peripheral = rp-timer, at = 0x40054000, irq = [0, 1, 2, 3] }

    spi0 {
      peripheral = pl022, at = 0x4003C000, irq = 18
      signals { rx = [GP0, GP4, GP16, GP20], cs = [GP1, GP5, GP17, GP21], sck = [GP2, GP6, GP18, GP22], tx = [GP3, GP7, GP19, GP23] }
    }
    spi1 {
      peripheral = pl022, at = 0x40040000, irq = 19
      signals { rx = [GP8, GP12, GP24, GP28], cs = [GP9, GP13, GP25, GP29], sck = [GP10, GP14, GP26], tx = [GP11, GP15, GP27] }
    }
    uart0 {
      peripheral = pl011, at = 0x40034000, irq = 20
      signals { tx = [GP0, GP12, GP16, GP28], rx = [GP1, GP13, GP17, GP29] }
    }
    uart1 {
      peripheral = pl011, at = 0x40038000, irq = 21
      signals { tx = [GP4, GP8, GP20, GP24], rx = [GP5, GP9, GP21, GP25] }
    }
    adc { peripheral = rp-adc, at = 0x4004C000, irq = 22, channels = [GP26, GP27, GP28, GP29] }
    i2c0 {
      peripheral = dw-i2c, at = 0x40044000, irq = 23
      signals { sda = [GP0, GP4, GP8, GP12, GP16, GP20, GP24, GP28], scl = [GP1, GP5, GP9, GP13, GP17, GP21, GP25, GP29] }
    }
    i2c1 {
      peripheral = dw-i2c, at = 0x40048000, irq = 24
      signals { sda = [GP2, GP6, GP10, GP14, GP18, GP22, GP26], scl = [GP3, GP7, GP11, GP15, GP19, GP23, GP27] }
    }
  }
}
