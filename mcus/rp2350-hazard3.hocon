// The Raspberry Pi RP2350A booted on its other pair of cores: two Hazard3 RISC-V cores, each with the
// RP2350's standard extensions and its core-local interrupt controller, in place of the two Cortex-M33s
// of `rp2350`. The memory is the same silicon's; the peripherals are not described here.

mcu {
  name    = "rp2350-hazard3"
  summary = "Raspberry Pi RP2350A: two Hazard3 RISC-V cores at 150 MHz"
  cores   = [hazard3, hazard3]

  peripherals {
    rom  { peripheral = rom, at = 0x00000000, size = 32K }
    sram { peripheral = ram, at = 0x20000000, size = 520K }
  }
}
