// `virt`'s RAM, console and SIO with two Cortex-M52s, their scalar subset; optional extensions
// benchtop does not implement stay off.

mcu {
  name    = "virt52"
  summary = "two Cortex-M52 cores, 1 MB of RAM, a console and an SIO"
  cores   = [cortex-m52, cortex-m52]

  peripherals {
    ram     { peripheral = ram, at = 0x00000000, size = 1M }
    console { peripheral = debug-console, at = 0x40000000, irq = 0 }
    sio     { peripheral = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
