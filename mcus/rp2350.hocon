// The Raspberry Pi RP2350A: two Cortex-M33 cores, each with the single-precision FPU, the DSP
// extension, the Security Extension and an eight-region MPU; 520 KB of SRAM; and the peripherals the
// Pico 2's boards wire to, with the pins each signal can be routed to on GPIO 0 to 29 (the SPI, UART
// and I2C columns of the datasheet's GPIO function table, as on the RP2040). The bases and IRQ
// numbers are the datasheet's. The same silicon booted on its two Hazard3 RISC-V cores is
// `rp2350-hazard3`. benchtop checks boards against this mcu; it does not run its peripherals yet.

mcu {
  name    = "rp2350"
  summary = "Raspberry Pi RP2350A: two Cortex-M33 at 150 MHz"
  cores   = [
    { core = cortex-m33, fpu = sp, dsp = true, security = trustzone, mpu-regions = 8 }
    { core = cortex-m33, fpu = sp, dsp = true, security = trustzone, mpu-regions = 8 }
  ]
  pins    { GP = 30 }

  peripherals {
    rom  { peripheral = rom, at = 0x00000000, size = 32K }
    sram { peripheral = ram, at = 0x20000000, size = 520K }
    sio  { peripheral = rp-sio, at = 0xD0000000, irq = [25, 26] }

    spi0 {
      peripheral = pl022, at = 0x40080000, irq = 31
      signals { rx = [GP0, GP4, GP16, GP20], cs = [GP1, GP5, GP17, GP21], sck = [GP2, GP6, GP18, GP22], tx = [GP3, GP7, GP19, GP23] }
    }
    spi1 {
      peripheral = pl022, at = 0x40088000, irq = 32
      signals { rx = [GP8, GP12, GP24, GP28], cs = [GP9, GP13, GP25, GP29], sck = [GP10, GP14, GP26], tx = [GP11, GP15, GP27] }
    }
    uart0 {
      peripheral = pl011, at = 0x40070000, irq = 33
      signals { tx = [GP0, GP12, GP16, GP28], rx = [GP1, GP13, GP17, GP29] }
    }
    uart1 {
      peripheral = pl011, at = 0x40078000, irq = 34
      signals { tx = [GP4, GP8, GP20, GP24], rx = [GP5, GP9, GP21, GP25] }
    }
    adc { peripheral = rp-adc, at = 0x400A0000, irq = 35, channels = [GP26, GP27, GP28, GP29] }
    i2c0 {
      peripheral = dw-i2c, at = 0x40090000, irq = 36
      signals { sda = [GP0, GP4, GP8, GP12, GP16, GP20, GP24, GP28], scl = [GP1, GP5, GP9, GP13, GP17, GP21, GP25, GP29] }
    }
    i2c1 {
      peripheral = dw-i2c, at = 0x40098000, irq = 37
      signals { sda = [GP2, GP6, GP10, GP14, GP18, GP22, GP26], scl = [GP3, GP7, GP11, GP15, GP19, GP23, GP27] }
    }
  }
}
