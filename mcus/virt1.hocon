// `virt`'s RAM, console and SIO with two Cortex-M1s, their scalar subset; optional extensions benchtop
// does not implement stay off.

mcu {
  name    = "virt1"
  summary = "two Cortex-M1 cores, 1 MB of RAM, a console and an SIO"
  cores   = [cortex-m1, cortex-m1]

  peripherals {
    ram     { peripheral = ram, at = 0x00000000, size = 1M }
    console { peripheral = debug-console, at = 0x40000000, irq = 0 }
    sio     { peripheral = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
