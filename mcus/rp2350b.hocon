// The Raspberry Pi RP2350B: the RP2350A's silicon in the QFN-80 package, which bonds out GPIO 30 to 47 as
// well. It differs from `rp2350` in three things a description says: 48 GPIOs (`pins`), each
// peripheral's signals also routable to GPIO 30 to 47 (the SPI, UART and I2C columns of the datasheet's
// GPIO function table, which continue the pattern of GPIO 0 to 29), and an ADC whose eight inputs are
// GPIO 40 to 47 rather than GPIO 26 to 29. The chip layer reads SYSINFO.PACKAGE_SEL as 0 (QFN-80) and
// puts the temperature sensor on ADC input 8 for it (`chip.rp2350b`). Everything else, the cores, the
// SRAM, the bases and the IRQ numbers, is the RP2350A's.

mcu {
  name    = "rp2350b"
  summary = "Raspberry Pi RP2350B: two Cortex-M33 at 150 MHz, 48 GPIOs"
  cores   = [
    { core = cortex-m33, fpu = sp, dsp = true, security = trustzone, mpu-regions = 8 }
    { core = cortex-m33, fpu = sp, dsp = true, security = trustzone, mpu-regions = 8 }
  ]
  pins    { GP = 48 }

  peripherals {
    rom  { peripheral = rom, at = 0x00000000, size = 32K }
    sram { peripheral = ram, at = 0x20000000, size = 520K }
    sio  { peripheral = rp-sio, at = 0xD0000000, irq = [25, 26] }

    spi0 {
      peripheral = pl022, at = 0x40080000, irq = 31
      signals { rx = [GP0, GP4, GP16, GP20, GP32, GP36], cs = [GP1, GP5, GP17, GP21, GP33, GP37], sck = [GP2, GP6, GP18, GP22, GP34, GP38], tx = [GP3, GP7, GP19, GP23, GP35, GP39] }
    }
    spi1 {
      peripheral = pl022, at = 0x40088000, irq = 32
      signals { rx = [GP8, GP12, GP24, GP28, GP40, GP44], cs = [GP9, GP13, GP25, GP29, GP41, GP45], sck = [GP10, GP14, GP26, GP30, GP42, GP46], tx = [GP11, GP15, GP27, GP31, GP43, GP47] }
    }
    uart0 {
      peripheral = pl011, at = 0x40070000, irq = 33
      signals { tx = [GP0, GP12, GP16, GP28, GP32, GP44], rx = [GP1, GP13, GP17, GP29, GP33, GP45] }
    }
    uart1 {
      peripheral = pl011, at = 0x40078000, irq = 34
      signals { tx = [GP4, GP8, GP20, GP24, GP36, GP40], rx = [GP5, GP9, GP21, GP25, GP37, GP41] }
    }
    adc { peripheral = rp-adc, at = 0x400A0000, irq = 35, channels = [GP40, GP41, GP42, GP43, GP44, GP45, GP46, GP47] }
    i2c0 {
      peripheral = dw-i2c, at = 0x40090000, irq = 36
      signals { sda = [GP0, GP4, GP8, GP12, GP16, GP20, GP24, GP28, GP32, GP36, GP40, GP44], scl = [GP1, GP5, GP9, GP13, GP17, GP21, GP25, GP29, GP33, GP37, GP41, GP45] }
    }
    i2c1 {
      peripheral = dw-i2c, at = 0x40098000, irq = 37
      signals { sda = [GP2, GP6, GP10, GP14, GP18, GP22, GP26, GP30, GP34, GP38, GP42, GP46], scl = [GP3, GP7, GP11, GP15, GP19, GP23, GP27, GP31, GP35, GP39, GP43, GP47] }
    }
  }
}
