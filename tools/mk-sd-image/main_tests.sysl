// The card image, built in the debug mode `sysl run` uses, so arithmetic that overflows in the FAT
// layer stops the test the way it stopped the tool.

import sh.sysl.fat as fat

@test
card_image_holds_hello_txt()
    val card = card_image()
    assert(card.len() == 32768 * 512)
    assert(card[510] == 0x55 && card[511] == 0xaa, "the boot sector is signed")
    var dev = fat.ram_device(card.view())
    var scratch: [512]u8 = [0;512]
    var volume = fat.mount(&dev, scratch[..]).unwrap()
    var entry: fat.Entry
    volume.find("HELLO.TXT", &entry).unwrap()
    assert(entry.size == 21)
