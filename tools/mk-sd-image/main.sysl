import sh.sysl.fat as fat
import sysl.fs
import sysl.buf.{Buf, buf_filled}

// The card the storage examples boot against: a 16 MiB FAT16 volume labelled BENCHTOP holding HELLO.TXT.
card_image() -> Buf[u8]
    val storage = buf_filled(32768 * 512, u8(0))
    var dev = fat.ram_device(storage.view())
    fat.format(&dev,Some(fat.FatType.Fat16),label = "BENCHTOP").unwrap()
    var scratch: [512]u8 = [0;512]
    var volume = fat.mount(&dev,scratch[..]).unwrap()
    var file = volume.create("HELLO.TXT").unwrap()
    volume.write(&file,"Hello from Benchtop!\n".bytes).unwrap()
    volume.flush().unwrap()
    storage

main()
    val path = "target/disco-sd.img"
    if fs.exists(path)
        print(s"Keeping existing SD image: $path")
        return
    val storage = card_image()
    fs.make_dir_all("target").unwrap()
    var image = fs.create_update(path).unwrap()
    image.write(storage.view())
    image.flush().unwrap()
    assert(!image.failed())
    image.close().unwrap()
    print(s"Created 16 MiB FAT16 SD image: $path")
