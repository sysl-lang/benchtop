// The Raspberry Pi Pico 2 W: an RP2350 with a CYW43439 for Wi-Fi and Bluetooth, whose GPIO 0 drives
// the green LED. Its header brings out GP0 to GP22 and GP26 to GP28, as the Pico's does; the radio
// has GP23, GP24, GP25 and GP29. The view is the board, 21 x 51 mm at 8 px/mm; positions are from
// the Pico's mechanical drawing.

board {
  name = "Raspberry Pi Pico 2 W"
  mcu = rp2350

  parts {
    wifi { part = cyw43439, wire { wl-on = GP23, data = GP24, cs = GP25, clock = GP29 } }
    led  { part = led, color = green, wire { anode = wifi.gpio0 } }
  }

  exposes {
    pins = [GP0, GP1, GP2, GP3, GP4, GP5, GP6, GP7, GP8, GP9, GP10, GP11, GP12, GP13, GP14, GP15,
            GP16, GP17, GP18, GP19, GP20, GP21, GP22, GP26, GP27, GP28]
    buses = [spi0, spi1, i2c0, i2c1, uart0, uart1]
  }

  view {
    size = [168, 408]
    background = "#1b5e20"

    elements {
      usb     { box = "#c0c0c0", at = [52, 0], size = [64, 40] }
      led     { show = led, at = [28, 16], size = [16, 10] }
      bootsel { box = "#f0f0f0", at = [32, 88], size = [24, 24], label = "BOOTSEL" }
      mcu    { box = "#202020", at = [56, 168], size = [56, 56], label = "RP2350" }
      wifi    { show = wifi, at = [28, 296], size = [112, 88] }
    }
  }
}
