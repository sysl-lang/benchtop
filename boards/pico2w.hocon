// The Raspberry Pi Pico 2 W: an RP2350 with a CYW43439 for Wi-Fi and Bluetooth, whose GPIO 0 drives
// the green LED. Its header brings out GP0 to GP22 and GP26 to GP28, as the Pico's does; the radio
// has GP23, GP24, GP25 and GP29.

board {
  name = "Raspberry Pi Pico 2 W"
  mcu = rp2350

  parts {
    wifi { part = cyw43439, wire { wl-on = GP23, data = GP24, cs = GP25, clock = GP29 } }
    led  { part = led, color = green, package = 0603, wire { anode = wifi.gpio0 } }
  }

  exposes {
    pins = [GP0, GP1, GP2, GP3, GP4, GP5, GP6, GP7, GP8, GP9, GP10, GP11, GP12, GP13, GP14, GP15,
            GP16, GP17, GP18, GP19, GP20, GP21, GP22, GP26, GP27, GP28]
    buses = [spi0, spi1, i2c0, i2c1, uart0, uart1]
  }

  // The board drawn from Raspberry Pi's mechanical drawing at 5 px/mm (`pcb = pico2w`), 105 x 255 px,
  // with its pads' names in a gutter either side; the radio is drawn under its shield can, with the
  // antenna at the far end. The LED, an 0603 left of the USB connector, is centred 4.75 mm in and
  // 4.7 mm down from the board's corner.
  view {
    size = [185, 262]
    background = "#2f7a45"
    pcb = pico2w

    elements {
      led { show = led, at = [60, 29] }
    }
  }
}
