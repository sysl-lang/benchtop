// The Raspberry Pi Pico 2 W: an RP2350 with a CYW43439 for Wi-Fi and Bluetooth, whose GPIO 0 drives
// the green LED. The panel is the board, 21 x 51 mm at 8 px/mm; positions are from the Pico's
// mechanical drawing.

board { name = "Raspberry Pi Pico 2 W", chip = rp2350 }

parts {
  wifi    { part = cyw43439, wire { wl_on = GP23, data = GP24, cs = GP25, clock = GP29 } }
  led     { part = led, color = green, wire { anode = wifi.gpio0 } }
  console { part = terminal, wire { uart = uart0 } }
}

buses {
  uart0 { tx = GP0, rx = GP1 }
}

panel {
  size = [168, 408]
  background = "#1b5e20"

  elements {
    usb     { box = "#c0c0c0", at = [52, 0], size = [64, 40] }
    led     { show = led, at = [28, 16], size = [16, 10] }
    bootsel { box = "#f0f0f0", at = [32, 88], size = [24, 24], label = "BOOTSEL" }
    chip    { box = "#202020", at = [56, 168], size = [56, 56], label = "RP2350" }
    wifi    { show = wifi, at = [28, 296], size = [112, 88] }
  }
}
