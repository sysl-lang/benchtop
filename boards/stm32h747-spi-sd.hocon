// Initial runnable Discovery subset: M7/M4, internal flash, AXI SRAM, DSI
// command-mode display and FT6206 polling over I2C4. LTDC video streaming,
// external memories and complete physical-board startup remain to be implemented.
board {
  name = stm32h747-spi-sd
  mcu {
    name = STM32H747XIH6
    clock-hz = 480000000
    cores = [{ core = cortex-m7, instruction-timing = estimated, fpu = dp },
             { core = cortex-m4, instruction-timing = estimated, fpu = sp, clock-hz = 240000000 }]
    pins { PD = 16, PA = 16 }
    peripherals {
      axi-sram { peripheral = ram, at = 0x24000000, size = 512K }
      sram1 { peripheral = ram, at = 0x30000000, size = 128K }
      flash0 { peripheral = flash, at = 0x08000000, size = 2M }
      gpioa { peripheral = stm32-gpio, at = 0x58020000, bank = PA, reset-mode = 0xabffffff }
      spi1 { peripheral = stm32-spi, at = 0x40013000, kernel-clock-hz = 60000000,
        signals { sck = [PA5], tx = [PA7], rx = [PA6] } }
      rcc { peripheral = stm32h7-rcc, at = 0x58024400 }
      sai1 { peripheral = stm32-sai, at = 0x40015800, irq = 87, kernel-clock-hz = 12288000 }
      dma2 { peripheral = stm32-dma, controller = 2, at = 0x40020400, irq = [56,57,58,59,60,68,69,70] }
      dmamux1 { peripheral = stm32-dmamux, at = 0x40020800 }
      dsi { peripheral = stm32-dsi, at = 0x50000000, reference-clock-hz = 25000000 }
      i2c4 { peripheral = stm32-i2c, at = 0x58001c00,
        signals { sda = [PD13], scl = [PD12] } }
    }
  }
  parts {
    card { part = sd-card, ref = J2, spi = spi1, cs = STM32H747XIH6.PA4, sectors = 32768, image = "target/disco-sd.img" }
    screen { part = mipi-dcs-display, ref = LCD1, width = 800, height = 480, dsi = dsi }
    codec { part = WM8994, ref = U2, address = 0x1a, i2c = i2c4, sai = sai1, dmic1 = microphone.out }
    microphone { part = pdm-microphone, ref = MIC1 }
    headphones { part = headphones, ref = J1, input = codec.headphones, gain = 12 }
    speaker { part = speaker, ref = SPK1, input = codec.out, gain = 12 }
    touch { part = FT6206, ref = U1, width = 800, height = 480, address = 0x2a, i2c = i2c4 }
  }
  buses { spi1 { sck = PA5, tx = PA7, rx = PA6 }, i2c4 { sda = PD13, scl = PD12 } }
  input { pointer { display = touch } }
  view {
    size = [1100, 800]
    background = "#163d32"
    elements {
      title { text = "STM32H747 DISCOVERY", at = [40, 24], size = [1020, 32] }
      subtitle { text = "M4: TOUCH UI / EXTERNAL SPI SD CARD / FAT16", at = [40, 72], size = [1020, 24] }
      display { show = screen, at = [140, 135], size = [812, 506] }
      touch { show = touch, at = [40, 700], size = [190, 52] }
      footer { text = "M7: SAI / DMA AUDIO / NATIVE 800 x 480 PIXELS", at = [260, 710], size = [780, 24] }
    }
  }
}
