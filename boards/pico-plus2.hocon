// The Pimoroni Pico Plus 2: an RP2350B (the QFN-80 package, 48 GPIOs) on the Raspberry Pi Pico's 21 x 51 mm
// footprint, with 16 MB of flash and 8 MB of PSRAM. It is the board here because the Pico SDK carries its
// board header (`pimoroni_pico_plus2_rp2350.h`), which is where each pin below is cited from, and because
// it is a Pico 2 with the larger chip: the 26 header GPIOs are the Pico 2's, so a program for one runs on
// the other, and the extra bank shows only where the board uses it. The green LED is GPIO 25
// (PICO_DEFAULT_LED_PIN) and the user switch is GPIO 45 (PIMORONI_PICO_PLUS2_USER_SW_PIN, not a part here: a button is a part of a
// product, which wires it to the board's pin); the PSRAM's chip
// select (GPIO 47) and the VSYS sense (GPIO 43, ADC input 3) are on the board and not brought out. The SP/CE
// pads carry SPI0 on GPIO 32 to 35 (SPCE_*_PIN) and GPIO 36. The view is drawn as the Pico 2's is.

board {
  name = "Pimoroni Pico Plus 2"
  mcu = rp2350b

  parts {
    led { part = led, color = green, package = 0603, wire { anode = GP25 } }
  }

  exposes {
    pins = [GP0, GP1, GP2, GP3, GP4, GP5, GP6, GP7, GP8, GP9, GP10, GP11, GP12, GP13, GP14, GP15,
            GP16, GP17, GP18, GP19, GP20, GP21, GP22, GP26, GP27, GP28, GP32, GP33, GP34, GP35, GP36]
    buses = [spi0, spi1, i2c0, i2c1, uart0, uart1]
  }

  view {
    size = [168, 408]
    background = "#1a1a2e"

    elements {
      usb     { box = "#c0c0c0", at = [52, 0], size = [64, 40] }
      led     { show = led, at = [32, 19] }
      bootsel { box = "#f0f0f0", at = [32, 88], size = [24, 24], label = "BOOTSEL" }
      mcu     { box = "#202020", at = [52, 168], size = [64, 64], label = "RP2350B" }
    }
  }
}
