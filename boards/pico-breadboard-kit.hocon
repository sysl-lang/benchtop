// 52Pi's Pico Breadboard Kit with a Raspberry Pi Pico (RP2040) in its socket: a 3.5" ST7796 screen
// with a GT911 touch panel, a joystick, two buttons, two LEDs, an RGB LED and a buzzer. Pins and
// layout are from 52Pi's "Board Definitions" and "Dimension" drawings; the board is 144 x 78 mm, and
// the panel is drawn at 6.4 px/mm, so the 75 x 50 mm glass is exactly 480 x 320.

board { name = "Pico Breadboard Kit", chip = rp2040 }

parts {
  lcd {
    part = st7796, width = 320, height = 480, invert = true
    wire { spi = spi0, cs = GP5, dc = GP6, reset = GP7 }
  }
  touch    { part = gt911, address = 0x5d, wire { i2c = i2c0 } }
  joystick { part = joystick, wire { x = GP26, y = GP27 } }
  btn1     { part = button, active = low, wire { pin = GP15 } }
  btn2     { part = button, active = low, wire { pin = GP14 } }
  d1       { part = led, color = red, wire { anode = GP16 } }
  d2       { part = led, color = red, wire { anode = GP17 } }
  rgb      { part = ws2812, wire { din = GP12 } }
  buzzer   { part = buzzer, kind = active, wire { pin = GP13 } }
  console  { part = terminal, wire { uart = uart0 } }
}

buses {
  spi0  { sck = GP2, tx = GP3 }
  i2c0  { sda = GP8, scl = GP9 }
  uart0 { tx = GP0, rx = GP1 }
}

panel {
  size = [922, 499]
  background = black

  elements {
    title  { text = "Pico Breadboard Kit", at = [58, 6], size = [262, 23] }
    socket { box = "#1b5e20", at = [124, 54], size = [134, 326], label = "Pico" }
    bezel  { box = "#202020", at = [364, 44], size = [540, 351] }
    // The glass is mounted landscape; its size is the part's own.
    screen { show = lcd, at = [379, 58], look { rotate = 90 } }
    buzzer { show = buzzer, at = [28, 407], size = [77, 77], label = "Beeper", look { shape = round } }
    d1     { show = d1, at = [175, 425], size = [16, 10], label = "D1" }
    d2     { show = d2, at = [175, 445], size = [16, 10], label = "D2" }
    stick  { show = joystick, at = [259, 387], size = [102, 102] }
    rgb    { show = rgb, at = [431, 405], size = [32, 32], label = "RGB Led" }
    btn1   { show = btn1, at = [516, 416], size = [38, 38], label = "BTN1" }
    btn2   { show = btn2, at = [604, 416], size = [38, 38], label = "BTN2" }
  }
}

input {
  keys {
    up = joystick.up, down = joystick.down, left = joystick.left, right = joystick.right
    "1" = btn1, "2" = btn2
  }
  pointer { screen = touch }
}
