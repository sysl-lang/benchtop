// Standalone matrix prototype using a virtual MCU, not a complete micro:bit board.
board {
  name = "5x5 LED Matrix"
  mcu {
    name = controller
    cores = [cortex-m0plus, cortex-m0plus]
    pins { GP = 32 }
    peripherals {
      ram { peripheral = ram, at = 0x20000000, size = 1M }
      flash0 { peripheral = flash, at = 0x10000000, size = 4M }
      gpio { peripheral = panel-gpio, at = 0x50000000, irq = 2 }
    }
  }
  parts {
    matrix { part = microbit-v2-led-matrix, ref = DS1, persistence-cycles = 50000,
      wire {
        row0 = GP0, row1 = GP1, row2 = GP2, row3 = GP3, row4 = GP4,
        col0 = GP5, col1 = GP6, col2 = GP7, col3 = GP8, col4 = GP9
      } }
  }
  view {
    size = [720, 690]
    background = "#163d32"
    elements {
      title { text = "GPIO SCANNED LED MATRIX", at = [40, 30], size = [640, 30] }
      subtitle { text = "5 ROWS / 5 COLUMNS / FIRMWARE MULTIPLEXING", at = [40, 72], size = [640, 22] }
      matrix { show = matrix, at = [260, 235], size = [200, 200] }
      footer { text = "MICRO:BIT V2 DISPLAY WIRING / VIRTUAL MCU", at = [40, 600], size = [640, 22] }
    }
  }
}
