board {
  name = "Analog joystick"
  mcu {
    name = controller
    clock-hz = 150000000
    cores = [{ core = cortex-m33, instruction-timing = estimated, fpu = sp }, { core = cortex-m33, instruction-timing = estimated, fpu = sp }]
    pins { GP = 32 }
    peripherals {
      ram { peripheral = ram, at = 0x20000000, size = 520K }
      flash0 { peripheral = flash, at = 0x10000000, size = 4M }
      spi0 { peripheral = pl022, at = 0x50001000, irq = 3, signals { sck = [GP0], tx = [GP1] } }
      adc { peripheral = virt-adc, at = 0x50000100, channels = [GP26, GP27] }
      gpio { peripheral = panel-gpio, at = 0x50000000, irq = 2 }
      i2c0 { peripheral = virt-i2c, at = 0x50000300,
        signals { sda = [GP6], scl = [GP7] } }
    }
  }
  parts {
    screen { part = ST7789VW, ref = DS1, width = 240, height = 240,
      wire { sck = GP0, mosi = GP1, cs = GP2, dc = GP3, reset = GP4 } }
    stick { part = joystick, ref = JS1, wire { x = GP26, y = GP27 } }
    mode { part = switch, ref = SW1, active = low, closed = false, wire { pin = GP8 } }
    power { part = led, ref = D1, color = green, wire { anode = GP5 } }
  }
  buses { i2c0 { sda = GP6, scl = GP7 } }
  view {
    size = [720, 490]
    background = "#163d32"
    elements {
      title { text = "ANALOG JOYSTICK", at = [32, 24], size = [650, 30] }
      subtitle { text = "TWO ADC CHANNELS / SPI DISPLAY", at = [32, 64], size = [650, 20] }
      display { show = screen, at = [70, 105], size = [252, 266] }
      power { show = power, at = [620, 325], size = [24, 24], label = "POWER" }
      stick { show = stick, at = [440, 160], size = [150, 150] }
      mode { show = mode, at = [440, 335], size = [80, 36], label = "OUTLINE" }
      footer { text = "DRAG / RELEASE TO CENTRE", at = [380, 420], size = [325, 24] }
    }
  }
}
