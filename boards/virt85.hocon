// Virtual cortex-m85 scalar subset; optional unimplemented extensions remain disabled.
board {
  name  = "virt85"
  cores = [cortex-m85, cortex-m85]

  parts {
    ram     { part = ram, at = 0x00000000, size = 1M }
    console { part = debug-console, at = 0x40000000, irq = 0 }
    sio     { part = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
