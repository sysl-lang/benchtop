// Virtual cortex-m55 scalar subset; optional unimplemented extensions remain disabled.
board {
  name  = "virt55"
  cores = [cortex-m55, cortex-m55]

  parts {
    ram     { part = ram, at = 0x00000000, size = 1M }
    console { part = debug-console, at = 0x40000000, irq = 0 }
    sio     { part = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
