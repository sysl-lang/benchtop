// The Raspberry Pi Pico: an RP2040 whose GPIO 25 drives the green LED. Its header brings out GP0 to
// GP22 and GP26 to GP28; GP23, GP24, GP25 and GP29 stay on the board (the regulator's mode, VBUS
// sense, the LED and VSYS sense). The view is the board drawn from the Pico's mechanical drawing at
// 5 px/mm (`pcb = pico`), 105 x 255 px, its pads' names in a gutter either side and the debug pads'
// under it; the LED, an 0603 left of the USB connector, is centred 4.75 mm in and 4.8 mm down from
// the board's corner. benchtop runs it (`benchtop run --board pico image.elf`, an SDK
// `no_flash` build for SRAM): the RP2040's chip layer on its two Cortex-M0+s, with a stand-in boot ROM
// that carries only core 1's launch wait (`chip.Rp2040`), in this terminal or in the window
// (`--window`, `chip.rp_guest`).

board {
  name = "Raspberry Pi Pico"
  mcu = rp2040

  parts {
    led { part = led, color = green, package = 0603, wire { anode = GP25 } }
  }

  exposes {
    pins = [GP0, GP1, GP2, GP3, GP4, GP5, GP6, GP7, GP8, GP9, GP10, GP11, GP12, GP13, GP14, GP15,
            GP16, GP17, GP18, GP19, GP20, GP21, GP22, GP26, GP27, GP28]
    buses = [spi0, spi1, i2c0, i2c1, uart0, uart1]
  }

  view {
    size = [185, 284]
    background = "#2f7a45"
    pcb = pico

    elements {
      led { show = led, at = [60, 29] }
    }
  }
}
