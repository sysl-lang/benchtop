// The Raspberry Pi Pico 2 (non-wireless): an RP2350 on its two Cortex-M33s, whose GPIO 25 drives the
// green LED. benchtop runs it (`benchtop run --board pico2 image.elf`, or a `.uf2`, an SDK build for
// SRAM, flash or the XIP cache): the RP2350's chip layer as `pico2-riscv` has it, with the M33s'
// coprocessors, Raspberry Pi's own A4 boot ROM and the board's 4 MB QSPI flash (`chip.ArmBoard`). In
// the window (`--window`) the view below is drawn and the LED lights from GPIO 25 (`chip.rp_guest`).

board {
  name = "Raspberry Pi Pico 2"
  mcu = rp2350

  parts {
    led { part = led, color = green, package = 0603, wire { anode = GP25 } }
  }

  exposes {
    pins = [GP0, GP1, GP2, GP3, GP4, GP5, GP6, GP7, GP8, GP9, GP10, GP11, GP12, GP13, GP14, GP15,
            GP16, GP17, GP18, GP19, GP20, GP21, GP22, GP26, GP27, GP28]
    buses = [spi0, spi1, i2c0, i2c1, uart0, uart1]
  }

  // The board drawn from Raspberry Pi's mechanical drawing at 5 px/mm (`pcb = pico2`): 105 x 255 px,
  // with its pads' names in a gutter either side and the debug pads' under it. The LED, an 0603 left
  // of the USB connector, is centred 4.75 mm in and 4.8 mm down from the board's corner.
  view {
    size = [185, 284]
    background = "#2f7a45"
    pcb = pico2

    elements {
      led { show = led, at = [60, 29] }
    }
  }
}
