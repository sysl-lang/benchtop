// The Raspberry Pi Pico 2 (non-wireless): an RP2350 on its two Cortex-M33s, whose GPIO 25 drives the
// green LED. benchtop runs it (`benchtop run --board pico2 image.elf`, an SDK `no_flash` build): the
// RP2350's chip layer as `pico2-riscv` has it, with the M33s' coprocessors and a boot ROM of
// benchtop's own (`chip.ArmBoard`); flash is not on its bus yet.

board {
  name = "Raspberry Pi Pico 2"
  mcu = rp2350

  parts {
    led { part = led, color = green, wire { anode = GP25 } }
  }

  exposes {
    pins = [GP0, GP1, GP2, GP3, GP4, GP5, GP6, GP7, GP8, GP9, GP10, GP11, GP12, GP13, GP14, GP15,
            GP16, GP17, GP18, GP19, GP20, GP21, GP22, GP26, GP27, GP28]
    buses = [spi0, spi1, i2c0, i2c1, uart0, uart1]
  }

  view {
    size = [168, 408]
    background = "#1b5e20"

    elements {
      usb     { box = "#c0c0c0", at = [52, 0], size = [64, 40] }
      led     { show = led, at = [28, 16], size = [16, 10] }
      bootsel { box = "#f0f0f0", at = [32, 88], size = [24, 24], label = "BOOTSEL" }
      mcu     { box = "#202020", at = [56, 168], size = [56, 56], label = "RP2350" }
    }
  }
}
