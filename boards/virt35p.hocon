// Virtual cortex-m35p scalar subset; optional unimplemented extensions remain disabled.
board {
  name  = "virt35p"
  cores = [cortex-m35p, cortex-m35p]

  parts {
    ram     { part = ram, at = 0x00000000, size = 1M }
    console { part = debug-console, at = 0x40000000, irq = 0 }
    sio     { part = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
