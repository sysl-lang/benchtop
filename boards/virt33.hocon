// The virtual board with two Cortex-M33s: `virt`'s RAM, console and SIO, the cores ARMv8-M Mainline
// (the integer Thumb-2 instruction set, IT blocks, exclusives, the stack limits, BASEPRI and
// FAULTMASK; no FPU, DSP, Security Extension or MPU). `cortical run --board virt33 <image>` runs it.

board {
  name  = "virt33"
  cores = [cortex-m33, cortex-m33]

  parts {
    ram     { part = ram, at = 0x00000000, size = 1M }
    console { part = debug-console, at = 0x40000000, irq = 0 }
    sio     { part = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
