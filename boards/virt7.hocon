// Two Cortex-M7s: the integer Thumb-2 instruction set with the DSP extension; no floating point,
// MPU or optional caches.
board {
  name  = "virt7"
  cores = [cortex-m7, cortex-m7]

  parts {
    ram     { part = ram, at = 0x00000000, size = 1M }
    console { part = debug-console, at = 0x40000000, irq = 0 }
    sio     { part = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
