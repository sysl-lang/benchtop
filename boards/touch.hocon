board {
  name = "Touch UI / imui"
  mcu {
    name = controller
    clock-hz = 150000000
    cores = [{ core = cortex-m33, fpu = sp }, { core = cortex-m33, fpu = sp }]
    pins { GP = 32 }
    peripherals {
      ram { peripheral = ram, at = 0x20000000, size = 520K }
      flash0 { peripheral = flash, at = 0x10000000, size = 4M }
      gpio { peripheral = panel-gpio, at = 0x50000000, irq = 2 }
      i2c0 { peripheral = virt-i2c, at = 0x50000300,
        signals { sda = [GP6], scl = [GP7] } }
    }
  }
  parts {
    screen { part = ST7789V, ref = DS1, width = 240, height = 240,
      sck = controller.GP0, mosi = controller.GP1, cs = controller.GP2,
      dc = controller.GP3, reset = controller.GP4 }
    touch { part = GT911, ref = U1, width = 240, height = 240, i2c = i2c0 }
    power { part = led, ref = D1, color = green, anode = controller.GP5 }
  }
  buses { i2c0 { sda = GP6, scl = GP7 } }
  input { pointer { display = touch } }
  view {
    size = [720, 690]
    background = "#163d32"
    elements {
      title { text = "TOUCH UI / imui", at = [32, 24], size = [650, 30] }
      subtitle { text = "FLASH-LINKED SYSL / ST7789 + GT911", at = [32, 64], size = [650, 20] }
      display { show = screen, at = [160, 105], size = [400, 430] }
      power { show = power, at = [620, 325], size = [24, 24], label = "POWER" }
      touch { show = touch, at = [40, 580], size = [180, 52] }
      footer { text = "CLICK BUTTONS / DRAG THE BRIGHTNESS SLIDER", at = [260, 593], size = [430, 24] }
    }
  }
}
