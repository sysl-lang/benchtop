// Virtual cortex-m1 scalar subset; optional unimplemented extensions remain disabled.
board {
  name  = "virt1"
  cores = [cortex-m1, cortex-m1]

  parts {
    ram     { part = ram, at = 0x00000000, size = 1M }
    console { part = debug-console, at = 0x40000000, irq = 0 }
    sio     { part = virt-sio, at = 0xD0000000, irq = 1 }
  }
}
