board {
  name = "PCM Speaker + MEMS Microphone"
  mcu {
    name = controller
    cores = [cortex-m0plus, cortex-m0plus]
    pins { GP = 32 }
    peripherals {
      ram { peripheral = ram, at = 0x20000000, size = 1M }
      flash0 { peripheral = flash, at = 0x10000000, size = 4M }
      gpio { peripheral = panel-gpio, at = 0x50000000, irq = 2 }
      audio0 { peripheral = virt-i2s, at = 0x50000400, clock-hz = 12000000,
        signals { bclk = [GP6], ws = [GP7], tx = [GP8], rx = [GP9] } }
    }
  }
  buses { audio0 { bclk = GP6, ws = GP7, tx = GP8, rx = GP9 } }
  parts {
    amplifier { part = MAX98357A, ref = U1, wire { i2s = audio0 } }
    speaker { part = speaker, ref = LS1, gain = 40, wire { input = amplifier.out } }
    microphone { part = INMP441, ref = MK1, wire { i2s = audio0 } }
    play { part = button, ref = SW1, active = low, wire { pin = GP1 } }
    meter0 { part = led, ref = D1, color = green, wire { anode = GP0 } }
    meter1 { part = led, ref = D2, color = green, wire { anode = GP2 } }
    meter2 { part = led, ref = D3, color = yellow, wire { anode = GP3 } }
    meter3 { part = led, ref = D4, color = orange, wire { anode = GP4 } }
    meter4 { part = led, ref = D5, color = red, wire { anode = GP5 } }
  }
  input { keys { "1" = play } }
  view {
    size = [720, 690]
    background = "#163d32"
    elements {
      title { text = "DIGITAL AUDIO WORKBENCH", at = [32, 24], size = [660, 30] }
      subtitle { text = "48 KHZ PCM / FLASH-LINKED SYSL FIRMWARE", at = [32, 64], size = [660, 22] }
      amplifier { show = amplifier, at = [65, 160], size = [190, 70] }
      speaker { show = speaker, at = [360, 135], size = [190, 190] }
      play { show = play, at = [120, 280], size = [58, 58], label = "HOLD 1 TO PLAY" }
      microphone { show = microphone, at = [65, 440], size = [190, 70] }
      miclabel { text = "MAC MICROPHONE → FIRMWARE LEVEL METER", at = [65, 395], size = [600, 22] }
      meter0 { show = meter0, at = [330, 455], size = [24, 24] }
      meter1 { show = meter1, at = [380, 455], size = [24, 24] }
      meter2 { show = meter2, at = [430, 455], size = [24, 24] }
      meter3 { show = meter3, at = [480, 455], size = [24, 24] }
      meter4 { show = meter4, at = [530, 455], size = [24, 24] }
      footer { text = "I2S LEFT CHANNEL / MAX98357A + INMP441", at = [32, 625], size = [660, 22] }
    }
  }
}
