// The STM32H747I-DISCO's runnable subset: the M7 and M4, internal flash, AXI SRAM, the DSI display in
// command mode, the WM8994 codec on SAI1 and I2C4, the FT6206 touch controller polled over I2C4, and
// the four user LEDs on PI12 to PI15, the wake-up button on PC13 and the reset button.
// LTDC video streaming, the external memories and the board's full startup are not modelled.
board {
  name = stm32h747-disco
  mcu = stm32h747
  parts {
    screen { part = mipi-dcs-display, ref = LCD1, width = 800, height = 480, wire { dsi = dsi } }
    codec { part = WM8994, ref = U2, address = 0x1a, wire { i2c = i2c4, sai = sai1, dmic1 = microphone.out } }
    microphone { part = pdm-microphone, ref = MIC1 }
    headphones { part = headphones, ref = J1, gain = 12, wire { input = codec.headphones } }
    // An external speaker on the codec's speaker output (JP2/JP5).
    speaker { part = CMS-151103-088SP, ref = SPK1, gain = 12, wire { input = codec.out } }
    touch { part = FT6206, ref = U1, width = 800, height = 480, address = 0x2a, wire { i2c = i2c4 } }
    // The four user LEDs light while their pin is low (UM2411 §6.11).
    led1 { part = led, ref = LD1, color = green, active = low, wire { anode = PI12 } }
    led2 { part = led, ref = LD2, color = orange, active = low, wire { anode = PI13 } }
    led3 { part = led, ref = LD3, color = red, active = low, wire { anode = PI14 } }
    led4 { part = led, ref = LD4, color = blue, active = low, wire { anode = PI15 } }
    wakeup { part = button, ref = B2, active = high, wire { pin = PC13 } }
    reset { part = reset-button, ref = B1 }
  }
  buses { i2c4 { sda = PD13, scl = PD12 } }
  input {
    keys { "1" = wakeup, "2" = reset }
    pointer { display = touch }
  }
  view {
    size = [1100, 800]
    background = "#163d32"
    elements {
      title { text = "STM32H747 DISCOVERY", at = [40, 24], size = [1020, 32] }
      subtitle { text = "M4: DSI COMMAND-MODE UI / FT6206 TOUCH", at = [40, 72], size = [1020, 24] }
      display { show = screen, at = [140, 135], size = [812, 506] }
      touch { show = touch, at = [40, 700], size = [190, 52] }
      led1 { show = led1, at = [55, 150], size = [24, 24], label = "LD1" }
      led2 { show = led2, at = [55, 210], size = [24, 24], label = "LD2" }
      led3 { show = led3, at = [55, 270], size = [24, 24], label = "LD3" }
      led4 { show = led4, at = [55, 330], size = [24, 24], label = "LD4" }
      reset { show = reset, at = [40, 410], size = [54, 54], label = "RESET" }
      wakeup { show = wakeup, at = [40, 520], size = [54, 54], label = "WAKE-UP" }
      footer { text = "M7: SAI / DMA AUDIO / NATIVE 800 x 480 PIXELS", at = [260, 710], size = [780, 24] }
    }
  }
}
