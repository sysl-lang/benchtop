// Initial runnable Discovery subset: M7/M4, internal flash, AXI SRAM, DSI
// command-mode display and FT6206 polling over I2C4. LTDC video streaming,
// external memories and SAI/DMA audio are not implemented by this description.
board {
  name = stm32h747-disco
  mcu {
    name = STM32H747XIH6
    clock-hz = 480000000
    cores = [{ core = cortex-m7, fpu = dp },
             { core = cortex-m4, fpu = sp, clock-hz = 240000000 }]
    pins { PD = 16 }
    peripherals {
      axi-sram { peripheral = ram, at = 0x24000000, size = 512K }
      flash0 { peripheral = flash, at = 0x08000000, size = 2M }
      rcc { peripheral = stm32h7-rcc, at = 0x58024400 }
      dsi { peripheral = stm32-dsi, at = 0x50000000, reference-clock-hz = 25000000 }
      i2c4 { peripheral = stm32-i2c, at = 0x58001c00,
        signals { sda = [PD13], scl = [PD12] } }
    }
  }
  parts {
    screen { part = mipi-dcs-display, ref = LCD1, width = 800, height = 480, dsi = dsi }
    touch { part = FT6206, ref = U1, width = 800, height = 480, address = 0x2a, i2c = i2c4 }
  }
  buses { i2c4 { sda = PD13, scl = PD12 } }
  input { pointer { display = touch } }
  view {
    size = [1100, 800]
    background = "#163d32"
    elements {
      title { text = "STM32H747 DISCOVERY", at = [40, 24], size = [1020, 32] }
      subtitle { text = "M4: DSI COMMAND-MODE UI / FT6206 TOUCH", at = [40, 72], size = [1020, 24] }
      display { show = screen, at = [140, 135], size = [812, 506] }
      touch { show = touch, at = [40, 700], size = [190, 52] }
      footer { text = "M7 RESERVED FOR AUDIO / NATIVE 800 x 480 PIXELS", at = [260, 710], size = [780, 24] }
    }
  }
}
