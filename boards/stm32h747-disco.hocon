// The STM32H747I-DISCO's runnable subset: the M7 and M4, internal flash, AXI SRAM, the DSI display in
// command mode, the WM8994 codec on SAI1 and I2C4, and the FT6206 touch controller polled over I2C4.
// LTDC video streaming, the external memories and the board's full startup are not modelled.
board {
  name = stm32h747-disco
  mcu = stm32h747
  parts {
    screen { part = mipi-dcs-display, ref = LCD1, width = 800, height = 480, wire { dsi = dsi } }
    codec { part = WM8994, ref = U2, address = 0x1a, wire { i2c = i2c4, sai = sai1, dmic1 = microphone.out } }
    microphone { part = pdm-microphone, ref = MIC1 }
    headphones { part = headphones, ref = J1, gain = 12, wire { input = codec.headphones } }
    speaker { part = speaker, ref = SPK1, gain = 12, wire { input = codec.out } }
    touch { part = FT6206, ref = U1, width = 800, height = 480, address = 0x2a, wire { i2c = i2c4 } }
  }
  buses { i2c4 { sda = PD13, scl = PD12 } }
  input { pointer { display = touch } }
  view {
    size = [1100, 800]
    background = "#163d32"
    elements {
      title { text = "STM32H747 DISCOVERY", at = [40, 24], size = [1020, 32] }
      subtitle { text = "M4: DSI COMMAND-MODE UI / FT6206 TOUCH", at = [40, 72], size = [1020, 24] }
      display { show = screen, at = [140, 135], size = [812, 506] }
      touch { show = touch, at = [40, 700], size = [190, 52] }
      footer { text = "M7: SAI / DMA AUDIO / NATIVE 800 x 480 PIXELS", at = [260, 710], size = [780, 24] }
    }
  }
}
