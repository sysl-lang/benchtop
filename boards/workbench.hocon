// A runnable virtual prototype: real firmware, virtual GPIO, visible LED/button wiring.
board {
  name = "Benchtop Workbench"
  chip {
    name = controller
    cores = [cortex-m0plus, cortex-m0plus]
    pins { GP = 32 }
    peripherals {
      ram { peripheral = ram, at = 0, size = 1M }
      console { peripheral = debug-console, at = 0x40000000, irq = 0 }
      sio { peripheral = virt-sio, at = 0xD0000000, irq = 1 }
      gpio { peripheral = panel-gpio, at = 0x50000000, irq = 2 }
      adc { peripheral = virt-adc, at = 0x50000100, irq = 3,
        channels = [GP26], reference-uv = 3300000, conversion-cycles = 32 }
    }
  }
  parts {
    heartbeat { part = led, color = green, ref = D1, anode = controller.GP0 }
    led1 { part = led, color = blue, ref = D2, anode = controller.GP1 }
    led2 { part = led, color = orange, ref = D3, anode = controller.GP2 }
    button1 { part = button, active = low, ref = SW1, pin = controller.GP8 }
    button2 { part = button, active = low, ref = SW2, pin = controller.GP9 }
    volume { part = potentiometer, ref = RV1, position = 50,
      low-uv = 0, high-uv = 3300000, taper = linear, wiper = controller.GP26 }
  }
  input { keys { "1" = button1, "2" = button2 } }
  view {
    size = [720, 430]
    background = "#163d32"
    elements {
      title { text = "BENCHTOP VIRTUAL BOARD", at = [28, 24], size = [650, 28] }
      subtitle { text = "FIRMWARE + GPIO + ADC", at = [28, 57], size = [650, 18] }
      usb { box = "#63778a", at = [28, 91], size = [100, 30], label = "CONSOLE" }
      trace0 { box = "#337057", at = [112, 155], size = [160, 3] }
      trace1 { box = "#337057", at = [112, 225], size = [160, 3] }
      trace2 { box = "#337057", at = [112, 295], size = [160, 3] }
      trace3 { box = "#337057", at = [444, 190], size = [98, 3] }
      trace4 { box = "#337057", at = [444, 290], size = [98, 3] }
      chip { box = "#19242e", at = [266, 146], size = [180, 136], label = "CORTEX-M0+" }
      core { text = "TWO CORES / 1 MB RAM", at = [278, 294], size = [180, 18] }
      heartbeat { show = heartbeat, at = [84, 145], size = [24, 24] }
      heartlabel { text = "HEARTBEAT", at = [40, 182], size = [150, 18] }
      led1 { show = led1, at = [84, 215], size = [24, 24] }
      led1label { text = "BUTTON 1", at = [40, 252], size = [150, 18] }
      led2 { show = led2, at = [84, 285], size = [24, 24] }
      led2label { text = "BUTTON 2", at = [40, 322], size = [150, 18] }
      button1 { show = button1, at = [540, 165], size = [54, 54], label = "HOLD 1" }
      button2 { show = button2, at = [540, 265], size = [54, 54], label = "HOLD 2" }
      volume { show = volume, at = [337, 325], size = [64, 64] }
      potlabel { text = "TURN RV1 / ADC0", at = [420, 347], size = [240, 20] }
      footer { text = "GP0..2 OUTPUT / GP8..9 INPUT / GP26 ANALOG", at = [28, 412], size = [650, 16] }
      padtop0 { box = "#a9ad77", at = [276, 137], size = [8, 9] }
      padbottom0 { box = "#a9ad77", at = [276, 282], size = [8, 9] }
      padtop1 { box = "#a9ad77", at = [294, 137], size = [8, 9] }
      padbottom1 { box = "#a9ad77", at = [294, 282], size = [8, 9] }
      padtop2 { box = "#a9ad77", at = [312, 137], size = [8, 9] }
      padbottom2 { box = "#a9ad77", at = [312, 282], size = [8, 9] }
      padtop3 { box = "#a9ad77", at = [330, 137], size = [8, 9] }
      padbottom3 { box = "#a9ad77", at = [330, 282], size = [8, 9] }
      padtop4 { box = "#a9ad77", at = [348, 137], size = [8, 9] }
      padbottom4 { box = "#a9ad77", at = [348, 282], size = [8, 9] }
      padtop5 { box = "#a9ad77", at = [366, 137], size = [8, 9] }
      padbottom5 { box = "#a9ad77", at = [366, 282], size = [8, 9] }
      padtop6 { box = "#a9ad77", at = [384, 137], size = [8, 9] }
      padbottom6 { box = "#a9ad77", at = [384, 282], size = [8, 9] }
      padtop7 { box = "#a9ad77", at = [402, 137], size = [8, 9] }
      padbottom7 { box = "#a9ad77", at = [402, 282], size = [8, 9] }
      padtop8 { box = "#a9ad77", at = [420, 137], size = [8, 9] }
      padbottom8 { box = "#a9ad77", at = [420, 282], size = [8, 9] }
    }
  }
}
