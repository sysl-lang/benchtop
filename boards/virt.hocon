// The virtual board: a machine that exists only in cortical. Two M0+ cores share 1 MB of RAM from
// address 0, a debug console on the host's terminal, and a small SIO after the RP2040's for talking
// to each other. `cortical run <image>` runs this board unless `--board` names another.

board { name = "virt", cores = [cortex-m0plus, cortex-m0plus] }

parts {
  ram     { part = ram, at = 0x00000000, size = 1M }
  console { part = debug-console, at = 0x40000000, irq = 0 }
  sio     { part = virt-sio, at = 0xD0000000, irq = 1 }
}
