// The Raspberry Pi Pico 2 (non-wireless) booted on its Hazard3 RISC-V cores: the same board as
// `pico2`, around the same silicon described as `rp2350-hazard3`. GPIO 25 drives the green LED.
// benchtop runs it (`benchtop run --board pico2-riscv image.elf`): the RP2350's resets, clocks,
// ticks, timers, watchdog, SIO, GPIO and UARTs, with core 1 in the boot ROM until core 0 launches it.
// `--window` runs it in the window as it runs the Arm Pico 2 (`chip.rp_guest`).

board {
  name = "Raspberry Pi Pico 2 (RISC-V)"
  mcu = rp2350-hazard3

  parts {
    led { part = led, color = green, package = 0603, wire { anode = GP25 } }
  }

  exposes {
    pins = [GP0, GP1, GP2, GP3, GP4, GP5, GP6, GP7, GP8, GP9, GP10, GP11, GP12, GP13, GP14, GP15,
            GP16, GP17, GP18, GP19, GP20, GP21, GP22, GP26, GP27, GP28]
  }

  // The Pico 2's own board (`pcb = pico2`), its LED where the Pico 2's is.
  view {
    size = [185, 284]
    background = "#2f7a45"
    pcb = pico2

    elements {
      led { show = led, at = [60, 29] }
    }
  }
}
