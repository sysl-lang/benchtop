// A virtual board of benchtop's machine with a chain of three WS2812s on GP0, which examples/pixel
// bit-banges from the panel GPIO: the chain decoded on the machine is the one an RP board's PIO drives
// (`chip/board_iface_tests.sysl`).
board {
  name = "WS2812 chain"
  mcu {
    name = controller
    clock-hz = 12000000
    cores = [cortex-m0plus, cortex-m0plus]
    pins { GP = 32 }
    peripherals {
      ram { peripheral = ram, at = 0x20000000, size = 1M }
      flash0 { peripheral = flash, at = 0x10000000, size = 4M }
      gpio { peripheral = panel-gpio, at = 0x50000000, irq = 2 }
    }
  }
  parts {
    strip { part = ws2812, count = 3, wire { din = GP0 } }
  }
}
