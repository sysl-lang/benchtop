// An SD card on the Pico 2's SPI0: a part benchtop does not run on an RP board, refused by name.
product {
  name = "Bus part"
  boards {
    pico { board = pico2 }
  }
  parts {
    card { part = sd-card, sectors = 2048, wire { spi = pico.spi0, cs = pico.GP5 } }
  }
  buses {
    pico.spi0 { sck = GP2, tx = GP3, rx = GP4 }
  }
}
