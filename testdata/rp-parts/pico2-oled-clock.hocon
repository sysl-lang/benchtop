// A Pico 2 with a 0.96" SSD1306 on SPI0's pins and a DS3231 on I2C0, as examples/pico2/oled_clock.c wires
// them; the clock starts from 1 January 2026, so what the program prints is the same on every run
// (`chip/bus_parts_tests.sysl`, `chip/board_iface_tests.sysl`).
product {
  name = "Pico 2 OLED clock"
  boards {
    pico { board = pico2 }
  }
  parts {
    oled {
      part = ssd1306
      wire { sck = pico.GP18, mosi = pico.GP19, cs = pico.GP17, dc = pico.GP20, reset = pico.GP21 }
    }
    rtc     { part = ds3231, initial-time = fixed, wire { i2c = pico.i2c0 } }
    console { part = terminal, wire { uart = pico.uart0 } }
  }
  buses {
    pico.i2c0  { sda = GP4, scl = GP5 }
    pico.uart0 { tx = GP0, rx = GP1 }
  }
  view {
    size = [520, 350]
    background = "#163d32"
    elements {
      title { text = "PICO 2 / SSD1306 + DS3231", at = [24, 16], size = [400, 24] }
      socket { box = "#1b5e20", at = [24, 56], size = [104, 270], label = "Pico 2" }
      oled  { show = oled, at = [176, 56] }
      rtc   { show = rtc, at = [176, 216] }
    }
  }
}
