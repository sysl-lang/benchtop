// The Pico Breadboard Kit's screen and touch panel with a Pico 2 in the socket, wired as the kit wires
// them (`boards/pico-breadboard-kit.hocon`) on glass that does not invert: an ST7796 on SPI0 and a GT911
// on I2C0 (`chip/bus_parts_tests.sysl`, `chip/board_iface_tests.sysl`).
product {
  name = "Pico 2 screen and touch"
  boards {
    pico { board = pico2 }
  }
  parts {
    lcd {
      part = st7796, width = 320, height = 480
      wire { spi = pico.spi0, cs = pico.GP5, dc = pico.GP6, reset = pico.GP7 }
    }
    touch   { part = gt911, address = 0x5d, width = 320, height = 480, wire { i2c = pico.i2c0 } }
    console { part = terminal, wire { uart = pico.uart0 } }
  }
  buses {
    pico.spi0  { sck = GP2, tx = GP3 }
    pico.i2c0  { sda = GP8, scl = GP9 }
    pico.uart0 { tx = GP0, rx = GP1 }
  }
}
