// A board of its own around the RP2040, with the parts `examples/pico/parts.elf` drives wired to the
// chip's GPIOs (`chip/parts_tests.sysl`, `script/tests.sysl`), laid out for the window
// (`ui/rp_window_tests.sysl`).
board {
  name = "RP2040 and parts"
  mcu = rp2040
  parts {
    btn   { part = button, active = low, wire { pin = GP14 } }
    bz    { part = buzzer, kind = passive, wire { pin = GP15 } }
    digit {
      part = seven-segment, digits = 1, common = cathode
      wire { a = GP2, b = GP3, c = GP4, d = GP5, e = GP6, f = GP7, g = GP8, dp = GP9, digit0 = GP10 }
    }
    pot   { part = potentiometer, position = 25, wire { wiper = GP26 } }
  }
  view {
    size = [420, 260]
    background = "#1b5e20"
    elements {
      mcu   { box = "#202020", at = [24, 24], size = [96, 96], label = "RP2040" }
      digit { show = digit, at = [160, 24], label = "DIGIT" }
      btn   { show = btn, at = [273, 57], label = "BTN" }
      bz    { show = bz, at = [338, 42], label = "BZ", look { shape = round } }
      pot   { show = pot, at = [160, 150] }
    }
  }
  input {
    keys { "1" = btn }
  }
}
