// A Pico 2 on a breadboard with the pin-level parts `examples/pico2/parts.c` drives, on its header, and a
// potentiometer and a joystick on the ADC pins (`chip/parts_tests.sysl`, `script/tests.sysl`), laid out
// for the window (`ui/rp_window_tests.sysl`).
product {
  name = "Pico 2 and parts"
  boards {
    pico { board = pico2 }
  }
  parts {
    btn   { part = button, active = low, wire { pin = pico.GP14 } }
    bz    { part = buzzer, kind = passive, wire { pin = pico.GP15 } }
    digit {
      part = seven-segment, digits = 1, common = cathode
      wire { a = pico.GP2, b = pico.GP3, c = pico.GP4, d = pico.GP5, e = pico.GP6, f = pico.GP7, g = pico.GP8, dp = pico.GP9, digit0 = pico.GP10 }
    }
    lcd   { part = hd44780, write-only = true, columns = 16, rows = 2, wire { rs = pico.GP16, e = pico.GP17, d4 = pico.GP18, d5 = pico.GP19, d6 = pico.GP20, d7 = pico.GP21 } }
    pot   { part = potentiometer, position = 25, wire { wiper = pico.GP26 } }
    stick { part = joystick, wire { x = pico.GP27, y = pico.GP28 } }
    flip  { part = switch, active = high, wire { pin = pico.GP22 } }
  }
  view {
    size = [600, 456]
    background = "#20262e"
    elements {
      pico  { show = pico, at = [24, 24] }
      digit { show = digit, at = [232, 32], size = [64, 96], label = "DIGIT" }
      lcd   { show = lcd, at = [328, 40], size = [240, 72] }
      btn   { show = btn, at = [232, 176], size = [48, 48], label = "BTN" }
      flip  { show = flip, at = [312, 182], size = [80, 36], label = "FLIP" }
      bz    { show = bz, at = [432, 168], size = [64, 64], label = "BZ", look { shape = round } }
      pot   { show = pot, at = [240, 280], size = [96, 96] }
      stick { show = stick, at = [400, 270], size = [120, 120] }
    }
  }
  input {
    keys { "1" = btn, up = stick.up, down = stick.down, left = stick.left, right = stick.right }
  }
}
