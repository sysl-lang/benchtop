// The touch board (`boards/touch.hocon`) with an ST7796 on its SPI bus in place of the ST7789 on GPIO
// terminals: the same firmware drives it, so the panel on benchtop's machine is the one an RP board's
// SPI drives (`chip/board_iface_tests.sysl`).
board {
  name = "Touch UI on an ST7796"
  mcu {
    name = controller
    clock-hz = 150000000
    cores = [{ core = cortex-m33, fpu = sp }, { core = cortex-m33, fpu = sp }]
    pins { GP = 32 }
    peripherals {
      ram { peripheral = ram, at = 0x20000000, size = 520K }
      flash0 { peripheral = flash, at = 0x10000000, size = 4M }
      spi0 { peripheral = pl022, at = 0x50001000, irq = 3, signals { sck = [GP0], tx = [GP1] } }
      gpio { peripheral = panel-gpio, at = 0x50000000, irq = 2 }
      i2c0 { peripheral = virt-i2c, at = 0x50000300,
        signals { sda = [GP6], scl = [GP7] } }
    }
  }
  parts {
    screen { part = st7796, width = 320, height = 480, wire { spi = spi0, cs = GP2, dc = GP3, reset = GP4 } }
    touch { part = GT911, ref = U1, width = 240, height = 240, wire { i2c = i2c0 } }
  }
  buses { spi0 { sck = GP0, tx = GP1 }, i2c0 { sda = GP6, scl = GP7 } }
}
