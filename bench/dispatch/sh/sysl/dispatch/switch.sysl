module sh.sysl.dispatch

// The `match` executor: one loop, one `match` over the record's case. It reads the same records and
// runs the same semantics as the threaded executor, so it is both the other half of the measurement
// and the reference the threaded chain is checked against.

run_match(cpu: *Cpu)
    var ip = insn_at(cpu, cpu.pc)
    var n = cpu.retired
    var target: u32 = 0

    loop
        // A taken branch sets `target` and falls to the bottom; everything else continues.
        ip.op match
            Undecoded ->
                decode(cpu, addr_of(cpu, ip), ip)
                continue
            Undefined ->
                stop_here(cpu, ip, n, Stop.Undefined)
                return
            Bkpt ->
                stop_here(cpu, ip, n, Stop.Breakpoint)
                return
            Nop -> ()
            Nop32 ->
                ip = &ip[1]
            LslImm -> x_lsl_imm(cpu, ip)
            LsrImm -> x_lsr_imm(cpu, ip)
            AsrImm -> x_asr_imm(cpu, ip)
            AddsReg -> x_adds_reg(cpu, ip)
            SubsReg -> x_subs_reg(cpu, ip)
            AddsImm -> x_adds_imm(cpu, ip)
            SubsImm -> x_subs_imm(cpu, ip)
            MovsReg -> x_movs_reg(cpu, ip)
            MovsImm -> x_movs_imm(cpu, ip)
            CmpImm -> x_cmp_imm(cpu, ip)
            Ands -> x_ands(cpu, ip)
            Eors -> x_eors(cpu, ip)
            LslsReg -> x_lsls_reg(cpu, ip)
            LsrsReg -> x_lsrs_reg(cpu, ip)
            AsrsReg -> x_asrs_reg(cpu, ip)
            Adcs -> x_adcs(cpu, ip)
            Sbcs -> x_sbcs(cpu, ip)
            Rors -> x_rors(cpu, ip)
            Tst -> x_tst(cpu, ip)
            Negs -> x_negs(cpu, ip)
            CmpReg -> x_cmp_reg(cpu, ip)
            Cmn -> x_cmn(cpu, ip)
            Orrs -> x_orrs(cpu, ip)
            Muls -> x_muls(cpu, ip)
            Bics -> x_bics(cpu, ip)
            Mvns -> x_mvns(cpu, ip)
            AddHi -> x_add_hi(cpu, ip)
            MovHi -> x_mov_hi(cpu, ip)
            AddImm -> x_add_imm(cpu, ip)
            LoadConst -> x_load_const(cpu, ip)
            LdrLit -> x_ldr_lit(cpu, ip)
            StrReg -> x_str_reg(cpu, ip)
            StrhReg -> x_strh_reg(cpu, ip)
            StrbReg -> x_strb_reg(cpu, ip)
            LdrsbReg -> x_ldrsb_reg(cpu, ip)
            LdrReg -> x_ldr_reg(cpu, ip)
            LdrhReg -> x_ldrh_reg(cpu, ip)
            LdrbReg -> x_ldrb_reg(cpu, ip)
            LdrshReg -> x_ldrsh_reg(cpu, ip)
            StrImm -> x_str_imm(cpu, ip)
            LdrImm -> x_ldr_imm(cpu, ip)
            StrbImm -> x_strb_imm(cpu, ip)
            LdrbImm -> x_ldrb_imm(cpu, ip)
            StrhImm -> x_strh_imm(cpu, ip)
            LdrhImm -> x_ldrh_imm(cpu, ip)
            Sxth -> x_sxth(cpu, ip)
            Sxtb -> x_sxtb(cpu, ip)
            Uxth -> x_uxth(cpu, ip)
            Uxtb -> x_uxtb(cpu, ip)
            Rev -> x_rev(cpu, ip)
            Rev16 -> x_rev16(cpu, ip)
            Revsh -> x_revsh(cpu, ip)
            Push -> x_push(cpu, ip)
            Pop -> x_pop(cpu, ip)
            Stm -> x_stm(cpu, ip)
            Ldm -> x_ldm(cpu, ip)
            PopPc ->
                x_pop(cpu, ip)
                target = load32(cpu, cpu.r[13]) & ~1
                cpu.r[13] += 4
                n += 1
                if taken(cpu, n, target) then return
                ip = insn_at(cpu, target)
                continue
            MovPc | Bx ->
                target = cpu.r[ip.b] & ~1
                n += 1
                if taken(cpu, n, target) then return
                ip = insn_at(cpu, target)
                continue
            Blx ->
                target = cpu.r[ip.b] & ~1
                cpu.r[14] = (addr_of(cpu, ip) + 2) | 1
                n += 1
                if taken(cpu, n, target) then return
                ip = insn_at(cpu, target)
                continue
            Bl ->
                cpu.r[14] = (addr_of(cpu, ip) + 4) | 1
                n += 1
                if taken(cpu, n, ip.imm) then return
                ip = insn_at(cpu, ip.imm)
                continue
            B ->
                n += 1
                if taken(cpu, n, ip.imm) then return
                ip = insn_at(cpu, ip.imm)
                continue
            Beq | Bne | Bcs | Bcc | Bmi | Bpl | Bvs | Bvc | Bhi | Bls | Bge | Blt | Bgt | Ble ->
                if holds(cpu, u32(ip.op) - u32(Op.Beq))
                    n += 1
                    if taken(cpu, n, ip.imm) then return
                    ip = insn_at(cpu, ip.imm)
                    continue

        n += 1
        ip = &ip[1]

// A taken branch: whether the budget is spent, saving where to resume if it is.
@inline
taken(cpu: *Cpu, n: u64, target: u32) -> bool
    if n < cpu.limit then return false

    cpu.pc = target
    cpu.retired = n
    true

stop_here(cpu: *Cpu, ip: *Insn, n: u64, why: Stop)
    cpu.stop = why
    cpu.stop_at = addr_of(cpu, ip)
    cpu.pc = cpu.stop_at
    cpu.retired = n
