// ---------------------------------------------------------------------------------------------------
// Branches.

h_pop_pc(cpu: *Cpu, ip: *Insn, n: u64)
    x_pop(cpu, ip)

    val target = load32(cpu, cpu.r[13]) & ~1

    cpu.r[13] += 4

    become jump(cpu, insn_at(cpu, target), n + 1)

h_mov_pc(cpu: *Cpu, ip: *Insn, n: u64)
    become jump(cpu, insn_at(cpu, cpu.r[ip.b] & ~1), n + 1)

h_bx(cpu: *Cpu, ip: *Insn, n: u64)
    become jump(cpu, insn_at(cpu, cpu.r[ip.b] & ~1), n + 1)

h_blx(cpu: *Cpu, ip: *Insn, n: u64)
    val to = insn_at(cpu, cpu.r[ip.b] & ~1)

    cpu.r[14] = (addr_of(cpu, ip) + 2) | 1

    become jump(cpu, to, n + 1)

h_b(cpu: *Cpu, ip: *Insn, n: u64)
    become jump(cpu, insn_at(cpu, ip.imm), n + 1)

h_bl(cpu: *Cpu, ip: *Insn, n: u64)
    cpu.r[14] = (addr_of(cpu, ip) + 4) | 1

    become jump(cpu, insn_at(cpu, ip.imm), n + 1)

// The conditional branches, each with its condition a constant of the handler.
h_beq(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 0) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bne(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 1) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bcs(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 2) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bcc(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 3) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bmi(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 4) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bpl(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 5) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bvs(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 6) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bvc(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 7) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bhi(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 8) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bls(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 9) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bge(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 10) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_blt(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 11) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_bgt(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 12) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

h_ble(cpu: *Cpu, ip: *Insn, n: u64)
    if holds(cpu, 13) then become jump(cpu, insn_at(cpu, ip.imm), n + 1)
    become next(cpu, &ip[1], n + 1)

// The handler for each case.
handler_of(op: Op) -> Handler = op match
    Undecoded -> &h_decode
    Undefined -> &h_undefined
    Bkpt -> &h_bkpt
    Nop -> &h_nop
    Nop32 -> &h_nop32
    LslImm -> &h_lsl_imm
    LsrImm -> &h_lsr_imm
    AsrImm -> &h_asr_imm
    AddsReg -> &h_adds_reg
    SubsReg -> &h_subs_reg
    AddsImm -> &h_adds_imm
    SubsImm -> &h_subs_imm
    MovsReg -> &h_movs_reg
    MovsImm -> &h_movs_imm
    CmpImm -> &h_cmp_imm
    Ands -> &h_ands
    Eors -> &h_eors
    LslsReg -> &h_lsls_reg
    LsrsReg -> &h_lsrs_reg
    AsrsReg -> &h_asrs_reg
    Adcs -> &h_adcs
    Sbcs -> &h_sbcs
    Rors -> &h_rors
    Tst -> &h_tst
    Negs -> &h_negs
    CmpReg -> &h_cmp_reg
    Cmn -> &h_cmn
    Orrs -> &h_orrs
    Muls -> &h_muls
    Bics -> &h_bics
    Mvns -> &h_mvns
    AddHi -> &h_add_hi
    MovHi -> &h_mov_hi
    AddImm -> &h_add_imm
    LoadConst -> &h_load_const
    LdrLit -> &h_ldr_lit
    MovPc -> &h_mov_pc
    Bx -> &h_bx
    Blx -> &h_blx
    B -> &h_b
    Bl -> &h_bl
    Beq -> &h_beq
    Bne -> &h_bne
    Bcs -> &h_bcs
    Bcc -> &h_bcc
    Bmi -> &h_bmi
    Bpl -> &h_bpl
    Bvs -> &h_bvs
    Bvc -> &h_bvc
    Bhi -> &h_bhi
    Bls -> &h_bls
    Bge -> &h_bge
    Blt -> &h_blt
    Bgt -> &h_bgt
    Ble -> &h_ble
    StrReg -> &h_str_reg
    StrhReg -> &h_strh_reg
    StrbReg -> &h_strb_reg
    LdrsbReg -> &h_ldrsb_reg
    LdrReg -> &h_ldr_reg
    LdrhReg -> &h_ldrh_reg
    LdrbReg -> &h_ldrb_reg
    LdrshReg -> &h_ldrsh_reg
    StrImm -> &h_str_imm
    LdrImm -> &h_ldr_imm
    StrbImm -> &h_strb_imm
    LdrbImm -> &h_ldrb_imm
    StrhImm -> &h_strh_imm
    LdrhImm -> &h_ldrh_imm
    Sxth -> &h_sxth
    Sxtb -> &h_sxtb
    Uxth -> &h_uxth
    Uxtb -> &h_uxtb
    Rev -> &h_rev
    Rev16 -> &h_rev16
    Revsh -> &h_revsh
    Push -> &h_push
    Pop -> &h_pop
    PopPc -> &h_pop_pc
    Stm -> &h_stm
    Ldm -> &h_ldm
