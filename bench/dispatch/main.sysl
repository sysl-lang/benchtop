// dispatch: run a guest image under both executors and report each one's speed.
//
//     dispatch <image.bin> [expected r0]
//
// The image is loaded at address 0 and started there, with the stack at the top of RAM. Each run
// goes in quanta of a million instructions, the way the emulator's core threads will, until the
// guest's `BKPT`.

import sh.sysl.dispatch.{Cpu, Stop, reset, run_match, run_threaded}
import sysl.fs.read_bytes
import sysl.text.parse_int
import sysl.time.monotonic

const QUANTUM: u64 = 1000000

var cpu: Cpu

// Run the guest to its breakpoint with `exec`, and answer the microseconds it took.
measure(image: []u8, exec: *extern(*Cpu) -> unit) -> long
    reset(&cpu, image, 0)

    val start = monotonic()

    while cpu.stop == Stop.Budget
        cpu.limit = cpu.retired + QUANTUM
        exec(&cpu)

    (monotonic() - start).us

report(name: string, us: long, expected: u32) -> bool
    val mips = real(cpu.retired) / real(us)
    val ok = cpu.stop == Stop.Breakpoint && cpu.r[0] == expected

    print(s"$name: ${cpu.retired} instructions in $us us, $mips MIPS, r0 = ${cpu.r[0]}, ${cpu.stop}")

    if !ok then print(s"  FAILED: expected r0 = $expected at a breakpoint, stopped at ${cpu.stop_at}")

    ok

main(args: []string)
    if args.len < 2
        print("usage: dispatch <image.bin> [expected r0]")
        exit(2)

    val image = read_bytes(args[1]) match
        Ok(b) -> b
        Err(e) ->
            print(s"cannot read ${args[1]}: $e")
            exit(1)

    val expected: u32 = if args.len > 2 then u32(parse_int(args[2]).unwrap_or(0)) else 0

    var good = true

    for round in 0..<3
        good = report("match   ", measure(image, &run_match), expected) && good
        good = report("threaded", measure(image, &run_threaded), expected) && good

    if !good then exit(1)
