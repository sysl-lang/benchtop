// benchtop: a microcontroller board emulator. `sysl build .` builds the `benchtop` command; `sysl test .`
// runs every test.

package {
  name    = "benchtop"
  version = "0.0.0"
  sysl    = "0.6.0"
}

optimization = "2"

exclude = ["bench/guest", "examples/visual"]

// Guest images are ELF-32 little-endian ARM, placed at their load addresses as a debug probe places
// them.
dependencies {
  // Native window/event loop; PNG export shares the same framebuffer as the window.
  sdl3 { git = "github.com/sysl-lang/sdl3", version = "0.3.11" }
  png { git = "github.com/sysl-lang/png", version = "0.2.1" }
  // SVD-generated register offsets and masks for peripheral emulation.
  rp2040 { git = "github.com/sysl-lang/rp2040", version = "0.1.1" }
  elf {
    git = "github.com/sysl-lang/elf", version = "0.1.2"
    options = { elf64 = false, big_endian = false, place_by = "physical" }
  }
  // Board descriptions are HOCON files.
  hocon { git = "github.com/sysl-lang/hocon", version = "0.2.2" }
}
