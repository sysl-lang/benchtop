// cortical: a Cortex-M board emulator. `sysl build .` builds the `cortical` command; `sysl test .`
// runs every test.

package {
  name    = "cortical"
  version = "0.0.0"
  sysl    = "0.5.5"
}

optimization = "2"

// Guest images are ELF-32 little-endian ARM, placed at their load addresses as a debug probe places
// them.
dependencies {
  elf {
    git = "github.com/sysl-lang/elf", version = "0.1.0"
    options = { elf64 = false, big_endian = false, place_by = "physical" }
  }
}
