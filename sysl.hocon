// benchtop: a microcontroller board emulator. `sysl build .` builds the `benchtop` command; `sysl test .`
// runs every test.

package {
  name    = "benchtop"
  version = "0.0.0"
  sysl    = "0.7.5"
}

optimization = "2"

exclude = ["target","tools/mk-sd-image", "bench/guest", "examples/visual", "examples/matrix", "examples/embedded", "examples/audio", "examples/touch", "examples/sai-dma"]

// Guest images are ELF-32 little-endian ARM, placed at their load addresses as a debug probe places
// them.
dependencies {
  wav { git = "github.com/sysl-lang/wav", rev = "fd4a8daf904e0ead0fc5a540a7ce836a7805f8f2" }
  fat { git = "github.com/sysl-lang/fat", version = "0.2.0" }
  // Host file notifications, async reads and child build processes.
  kairos { git = "github.com/sysl-lang/kairos", version = "0.1.14", features = [uv] }
  // Desktop widgets, vector/text rendering, and the shared SDL3 driver.
  syslui { git = "github.com/sysl-lang/syslui", version = "0.1.9" }
  syslui-sdl { git = "github.com/sysl-lang/syslui-sdl", version = "0.2.7" }
  png { git = "github.com/sysl-lang/png", version = "0.2.1" }
  // SVD-generated register offsets and masks for peripheral emulation.
  rp2040 { git = "github.com/sysl-lang/rp2040", version = "0.1.1" }
  elf {
    git = "github.com/sysl-lang/elf", version = "0.1.2"
    options = { elf64 = false, big_endian = false, place_by = "physical" }
  }
  // Board descriptions are HOCON files.
  hocon { git = "github.com/sysl-lang/hocon", version = "0.2.2" }
}
