// benchtop: a microcontroller board emulator. `sysl build .` builds the `benchtop` command; `sysl test .`
// runs every test.

package {
  name    = "benchtop"
  version = "0.0.0"
  sysl    = "0.6.0"
}

optimization = "2"

exclude = ["bench/guest"]

// Guest images are ELF-32 little-endian ARM, placed at their load addresses as a debug probe places
// them.
dependencies {
  elf {
    git = "github.com/sysl-lang/elf", version = "0.1.1"
    options = { elf64 = false, big_endian = false, place_by = "physical" }
  }
  // Board descriptions are HOCON files.
  hocon { git = "github.com/sysl-lang/hocon", version = "0.2.1" }
}
