// Debugging instruments are separate from the physical board description.
instruments {
  knob {
    instrument = plot
    title = "RV1 · ADC result"
    source = controller.adc.RESULT
    part = volume
    units = counts
    min = 0
    max = 4095
    window-cycles = 20000000
    sample-cycles = 20000
    capacity = 1024
  }
}
